+		error = css_stylesheet_style_unset(result,
+				CSS_PROP_BACKGROUND_ORIGIN);
+	} else if (lwc_string_caseless_isequal(token->idata,
+			c->strings[PADDING_BOX], &match) == lwc_error_ok && match) {
