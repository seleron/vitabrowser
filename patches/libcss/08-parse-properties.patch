+	/** Legacy system colour mapping */
+	static const int deprecatedmap[LAST_DEPRECATEDCOLOUR + 1 - FIRST_DEPRECATEDCOLOUR] = {
+		BUTTONBORDER, /* ACTIVEBORDER */
+		CANVAS, /* ACTIVECAPTION */
+		CANVAS, /* APPWORKSPACE */
+		CANVAS, /* BACKGROUND */
+		BUTTONFACE, /* BUTTONHIGHLIGHT */
