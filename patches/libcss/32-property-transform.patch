--- upstream/libcss/src/select/properties/s_macsurf_transform.c	1970-01-01 01:00:00.000000000 +0100
+++ browser/libcss/src/select/properties/s_macsurf_transform.c	2026-09-20 23:19:17.249958004 +0100
