+
+	if (a->inherit_flags != b->inherit_flags ||
+		a->prop_count != b->prop_count ||
+		a->duration_count != b->duration_count ||
+		a->timing_count != b->timing_count ||
+		a->delay_count != b->delay_count)
+		return false;
