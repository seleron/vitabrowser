+uint32_t css_computed_transition_descriptor_count(
+		const css_computed_style *style)
+{
+	if (style == NULL || style->transition_data == NULL) return 0;
+	if (style->transition_data->prop_count == 1 &&
+		style->transition_data->props[0].kind == CSS_TRANS_PROP_NONE) {
+		return 0;
+	}
+	return style->transition_data->prop_count;
