+
+bool css_computed_transition_descriptor(
+		const css_computed_style *style,
+		uint32_t index,
+		css_effective_transition_descriptor *out)
+{
+	const css_computed_transition_data *d;
+	if (style == NULL || out == NULL) return false;
+	d = style->transition_data;
+
+	if (d == NULL) {
+		/* Default: transition-property: all, duration: 0s, timing: ease, delay: 0s */
+		if (index != 0) return false;
+		out->prop.kind = CSS_TRANS_PROP_ALL;
+		out->prop.prop_id = 0;
+		out->prop.custom_name = NULL;
+		out->duration = 0;
+		out->timing.type = CSS_TIMING_EASE;
+		out->timing.x1 = (int32_t)(0.25 * 65536.0);
+		out->timing.y1 = (int32_t)(0.1 * 65536.0);
+		out->timing.x2 = (int32_t)(0.25 * 65536.0);
+		out->timing.y2 = (int32_t)(1.0 * 65536.0);
+		out->timing.step_count = 0;
+		out->timing.step_pos = 0;
+		out->delay = 0;
+		return true;
+	}
+
+	if (d->prop_count == 1 && d->props[0].kind == CSS_TRANS_PROP_NONE) {
+		return false;
+	}
+
+	if (index >= d->prop_count) return false;
+
+	/* Property: exactly index */
+	out->prop = d->props[index];
+
+	/* Duration: modulo repetition */
+	if (d->duration_count > 0) {
+		out->duration = d->durations[index % d->duration_count];
+	} else {
+		out->duration = 0;
+	}
+
+	/* Timing: modulo repetition */
+	if (d->timing_count > 0) {
+		out->timing = d->timings[index % d->timing_count];
+	} else {
+		out->timing.type = CSS_TIMING_EASE;
+		out->timing.x1 = (int32_t)(0.25 * 65536.0);
+		out->timing.y1 = (int32_t)(0.1 * 65536.0);
+		out->timing.x2 = (int32_t)(0.25 * 65536.0);
+		out->timing.y2 = (int32_t)(1.0 * 65536.0);
+		out->timing.step_count = 0;
+		out->timing.step_pos = 0;
+	}
+
+	/* Delay: modulo repetition */
+	if (d->delay_count > 0) {
+		out->delay = d->delays[index % d->delay_count];
+	} else {
+		out->delay = 0;
+	}
+
+	return true;
+}
+
+bool css_computed_transition_data_equal(
+		const css_computed_style *a,
+		const css_computed_style *b)
+{
+	const css_computed_transition_data *da = (a != NULL) ? a->transition_data : NULL;
+	const css_computed_transition_data *db = (b != NULL) ? b->transition_data : NULL;
+	uint8_t i;
+
+	if (da == db) return true;
+	if (css__is_default_transition_data(da) && css__is_default_transition_data(db))
+		return true;
+	if (da == NULL || db == NULL) return false;
+
+	if (da->inherit_flags != db->inherit_flags ||
+		da->prop_count != db->prop_count ||
+		da->duration_count != db->duration_count ||
+		da->timing_count != db->timing_count ||
+		da->delay_count != db->delay_count)
+		return false;
+
+	for (i = 0; i < da->prop_count; i++) {
+		if (da->props[i].kind != db->props[i].kind) return false;
+		if (da->props[i].kind == CSS_TRANS_PROP_KNOWN &&
+			da->props[i].prop_id != db->props[i].prop_id) return false;
+		if (da->props[i].kind == CSS_TRANS_PROP_CUSTOM_IDENT) {
+			bool match = false;
+			if (da->props[i].custom_name == db->props[i].custom_name) match = true;
+			else if (da->props[i].custom_name != NULL && db->props[i].custom_name != NULL) {
+				if (lwc_string_isequal(da->props[i].custom_name,
+					db->props[i].custom_name, &match) != lwc_error_ok || !match)
+					return false;
+			} else return false;
+		}
+	}
+
+	for (i = 0; i < da->duration_count; i++) {
+		if (da->durations[i] != db->durations[i]) return false;
+	}
+
+	for (i = 0; i < da->timing_count; i++) {
+		if (da->timings[i].type != db->timings[i].type) return false;
+		if (da->timings[i].type == CSS_TIMING_CUBIC_BEZIER) {
+			if (da->timings[i].x1 != db->timings[i].x1 ||
+				da->timings[i].y1 != db->timings[i].y1 ||
+				da->timings[i].x2 != db->timings[i].x2 ||
+				da->timings[i].y2 != db->timings[i].y2) return false;
+		} else if (da->timings[i].type == CSS_TIMING_STEPS) {
+			if (da->timings[i].step_count != db->timings[i].step_count ||
+				da->timings[i].step_pos != db->timings[i].step_pos) return false;
+		}
+	}
+
+	for (i = 0; i < da->delay_count; i++) {
+		if (da->delays[i] != db->delays[i]) return false;
+	}
+
+	return true;
+}
