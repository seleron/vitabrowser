 			GROW_MATCHED_COOKIES;
@@ -4372,6 +4395,12 @@
 				/* secure cookie for insecure host. ignore */
 				continue;
 
+			/* fixes879 - HttpOnly gate; this loop was missing it.
+			 * Domain cookies are where session tokens usually live,
