 nserror
 scrollbar_create(bool horizontal,
 		 int length,
@@ -106,6 +174,7 @@
 		*s = NULL;
 		return NSERROR_NOMEM;
 	}
+	scrollbar_live_add(scrollbar);   /* fixes890 */
 
 	scrollbar->horizontal = horizontal;
 	scrollbar->length = length;
@@ -137,6 +206,30 @@
  */
