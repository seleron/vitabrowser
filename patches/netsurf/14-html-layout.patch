+		return "auto";
+	case CSS_JUSTIFY_SELF_STRETCH:
+		return "stretch";
+	case CSS_JUSTIFY_SELF_START:
+		return "start";
+	case CSS_JUSTIFY_SELF_CENTER:
+		return "center";
+	default:
+		return "other";
+	}
+}
