+				if (has_tracks) {
+					x_pos = track_x[slot_col];
+				} else {
+					x_pos = slot_col * (col_width + col_gap);
+				}
+				child->x = x_pos;
+
+				/* #279 justify-items: position the item on the
+				 * inline (horizontal) axis within its cell.
+				 * center offsets by half the slack; start leaves
