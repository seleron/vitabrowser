+	 * max-height / min-height from CSS. */
+	grid->height = row_y;
+	if (grid->height < 0) grid->height = 0;
+	if (max_height >= 0 && grid->height > max_height) {
+		grid->height = max_height;
+	}
+	if (min_height > 0 && grid->height < min_height) {
+		grid->height = min_height;
+	}
+
+	return true;
+}
