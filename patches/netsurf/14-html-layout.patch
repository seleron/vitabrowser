+	dom_node_get_first_child(node, &child);
+	while (child != NULL) {
+		pinned += html_reconvert_pin_dom_node(child, depth + 1);
+		dom_node_get_next_sibling(child, &next);
+		dom_node_unref(child);
+		child = next;
+	}
+	return pinned;
+}
