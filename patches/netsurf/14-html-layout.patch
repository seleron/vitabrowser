+		if (normal_y > max_y) {
+			sy -= (normal_y - max_y);
+		}
+	}
+	off_type = css_computed_left(box->style, &off_v, &off_u);
+	if (off_type == CSS_LEFT_SET) {
+		int left_px = (off_u == CSS_UNIT_PCT) ? 0 :
+			FIXTOINT(css_unit_len2device_px(box->style,
+				&html->unit_len_ctx, off_v, off_u));
