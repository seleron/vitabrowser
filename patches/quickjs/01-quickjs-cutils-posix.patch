# quickjs (MacSurf quickjs-macos9 @ 55e64fa): cutils.h on non-glibc POSIX
#
# Two MacSurf edits for Mac OS 9 break other POSIX targets whose libc does
# not pull the headers in by itself -- here vitaSDK's newlib:
# - `#include <sys/time.h>` was commented out for every compiler; restored
#   except under MAC_OS_9 (gettimeofday() is used by js__gettimeofday_us).
# - JS_ONCE_INIT was 0 for pthreads; upstream QuickJS-ng uses
#   PTHREAD_ONCE_INIT, which is a struct initialiser in vitaSDK's
#   pthread (0 is "invalid initializer" there, fine only on glibc).
# Applied by tools/fetch-quickjs.sh.

--- a/cutils.h	2026-09-23 05:32:59.093849067 +0100
+++ b/cutils.h	2026-09-23 05:32:59.105648125 +0100
@@ -29,8 +29,8 @@
 #include <stdio.h>
 #include <stdarg.h>
 #include <time.h>
-#if !defined(_MSC_VER)
-/* #include <sys/time.h> */
+#if !defined(_MSC_VER) && !defined(MAC_OS_9)
+#include <sys/time.h>
 #endif
 #if defined(__APPLE__)
 #include <mach-o/dyld.h>
@@ -691,7 +691,7 @@
 typedef pthread_mutex_t js_mutex_t;
 typedef pthread_cond_t js_cond_t;
 typedef pthread_t js_thread_t;
-#define JS_ONCE_INIT 0
+#define JS_ONCE_INIT PTHREAD_ONCE_INIT
 #endif
 
 static inline void js_once(js_once_t *guard, void (*callback)(void));
