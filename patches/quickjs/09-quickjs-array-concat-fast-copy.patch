+    /* VitaBrowser: the constructor is this realm's own Array and its
+       [Symbol.species] is still the built-in getter (which returns Array):
+       the result is a plain array, so skip the getter call and the generic
+       constructor call (concat and map on plain arrays -- styled-components'
+       flatten, 23% of bbc.com's JS). Array.prototype is non-writable, so
+       new Array via new.target Array and via no new.target are the same. */
+    if (JS_VALUE_GET_TAG(ctor) == JS_TAG_OBJECT &&
+        JS_VALUE_GET_TAG(ctx->array_ctor) == JS_TAG_OBJECT &&
+        JS_VALUE_GET_OBJ(ctor) == JS_VALUE_GET_OBJ(ctx->array_ctor)) {
+        JSProperty *spr;
+        JSShapeProperty *sprs = find_own_property(&spr, JS_VALUE_GET_OBJ(ctor),
