# quickjs: Array.prototype.concat copies plain dense arrays directly;
# ArraySpeciesCreate skips the species getter for this realm's own Array;
# plain arrays known spreadable until a page defines isConcatSpreadable
#
# VitaBrowser patch 494: patch 492's per-function sampling found 23% of
# bbc.com's JS in styled-components' flatten(),
#   Array.prototype.concat.apply(Z, e.map(function (x) { return tt(x); }))
#
# 1. The generic concat does a JS_TryGetPropertyInt64 and a
#    JS_DefinePropertyValueInt64 per element. When the result is still a
#    fast array without holes (its count equals the elements written so
#    far), a spreadable argument that is a fast array whose length equals
#    its count (no holes, no length past the elements) is copied value by
#    value with add_fast_array_element, and a non-spreadable argument is
#    appended the same way. Array-likes, holed arrays, a result that went
#    slow, and species results that are not plain arrays take the generic
#    path.
# 2. JS_ArraySpeciesCreate (concat AND map): when the constructor is this
#    realm's own Array and its [Symbol.species] is still the built-in getter
#    (js_get_this), the plain-array constructor is called directly instead
#    of the getter call plus the generic constructor call. Same object:
#    Array.prototype is non-writable. A replaced species or constructor
#    takes the generic path.
# 3. JS_isConcatSpreadable: a runtime flag (vb_spreadable_seen) is set the
#    first time any object gets a [Symbol.isConcatSpreadable] property (the
#    only two places shape properties are created: add_shape_property and
#    JS_NewObjectFrom). Until then a plain Array whose prototype chain is
#    exactly this realm's Array.prototype -> Object.prototype is spreadable
#    without the three failing lookups. Proxies, other realms and swapped
#    prototypes take the generic path. One runtime per page (js_newheap),
#    so a page that defines the symbol only turns this off for itself.
# 4. The fast copy pre-sizes the result once per argument.
# Applied by tools/fetch-quickjs.sh.

--- a/quickjs.c
+++ b/quickjs.c
@@ -286,6 +286,11 @@
 } JSValueLink;
 
 struct JSRuntime {
+    /* VitaBrowser: set once any object ever gets a [Symbol.isConcatSpreadable]
+       property (add_shape_property, JS_NewObjectFrom); until then a plain
+       array with the realm's own prototype chain is spreadable without the
+       three-object lookup (JS_isConcatSpreadable). */
+    bool vb_spreadable_seen;
     JSMallocFunctions mf;
     JSMallocState malloc_state;
     const char *rt_info;
@@ -5695,6 +5700,8 @@
        The object property at p->prop[sh->prop_count] is uninitialized */
     prop = sh->prop;
     pr = &prop[sh->prop_count++];
+    if (unlikely(atom == JS_ATOM_Symbol_isConcatSpreadable))
+        rt->vb_spreadable_seen = true;
     pr->atom = JS_DupAtom(ctx, atom);
     pr->flags = prop_flags;
     /* add in hash table */
@@ -6037,6 +6044,8 @@
             hash = &prop_hash_end(sh)[-h - 1];
             pr->hash_next = *hash;
             *hash = i + 1;
+            if (unlikely(atom == JS_ATOM_Symbol_isConcatSpreadable))
+                rt->vb_spreadable_seen = true;
             pr->atom = JS_DupAtom(ctx, atom);
             pr->flags = JS_PROP_C_W_E;
             p->prop[i].u.value = values[i];
@@ -42670,6 +42679,26 @@
             ctor = JS_UNDEFINED;
         }
