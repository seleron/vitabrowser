+static int js_parse_skip_parens_token1(JSParseState *s, int *pbits, bool no_line_terminator);
+
 static int js_parse_skip_parens_token(JSParseState *s, int *pbits, bool no_line_terminator)
 {
+    int v = s->token.val;
+
+    if (v == '(' || v == '[' || v == '{') {
+        const JSSkipMemo *e = js_skip_memo_find(s, s->token.ptr);
+        if (e) {
+            int tok = (no_line_terminator && e->lf) ? '\n' : e->tok;
+#ifdef VITA_SKIP_CHECK
+            int bits2 = 0, tok2;
+            tok2 = js_parse_skip_parens_token1(s, &bits2, no_line_terminator);
+            if (skip_checked++ == 0)
+                atexit(skip_check_report);
+            if (tok2 != tok || (pbits && bits2 != e->bits)) {
+                skip_mismatch++;
+                fprintf(stderr, "SKIPCHECK mismatch #%lu: tok %d vs %d, "
+                        "bits %d vs %d\n", skip_mismatch, tok, tok2,
+                        e->bits, bits2);
+            }
+#endif
+            if (pbits)
+                *pbits = e->bits;
+            return tok;
+        }
+    }
+    return js_parse_skip_parens_token1(s, pbits, no_line_terminator);
+}
