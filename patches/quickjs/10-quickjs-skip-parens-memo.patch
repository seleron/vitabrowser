+/* VitaBrowser: js_parse_skip_parens_token, memoised within one parse.
+ *
+ * An expression that starts with '(' (and a few '[' / '{' cases) is
+ * scanned ahead to its matching close to see what follows (an arrow, an
+ * assignment, a comma), then the parser rewinds and parses those tokens
+ * for real. Every inner opener met later asks the same question about its
+ * own contents, so nested minified code was tokenised once per nesting
+ * level: github.com's bundles spent ~10% of the page load's main-thread
+ * time in this function in the simulator. A scan passes over every inner
+ * opener, its matching close and the token after it, which is all an
+ * inner scan computes; those results are recorded by the opener's source
+ * position and answered from here. Only an opener whose close the scan
+ * reached cleanly is recorded (never one cut off by an error, the end of
+ * input or the 256-level limit), with the bits its own scan would report:
+ * ';' and '...' directly inside it, '=' anywhere inside it. The token
+ * after the close is stored with the 'of' mapping and whether a line
+ * break preceded it, so both no_line_terminator modes are answered. A hit
+ * leaves the parse state as the full scan does (it rewinds to the start).
+ *
+ * Lexing depends on the function being parsed in two ways, so a record
+ * made while scanning across a nested function's text is only reused in
+ * the same lexing context: (1) strict mode (legacy octal escapes are an
+ * error there) -- every record keeps is_strict_mode and must match it;
+ * (2) whether yield, await and the strict-mode reserved words are
+ * identifiers or keywords (update_token_ident) -- a record whose region,
+ * or the token after its close, holds one of those keeps the function
+ * and its in_function_body as well and is reused only under both.
+ * VITA_SKIP_CHECK builds also run the scan on every hit and compare. */
+#define SKIP_CTX 0x40   /* internal: region lexes differently by context */
+typedef struct JSSkipMemo {
+    const uint8_t *key;
+    JSFunctionDef *fd;      /* recording function (SKIP_CTX records) */
+    int tok;
+    uint8_t bits, lf, strict, infb, ctx;
+} JSSkipMemo;
+
+/* the current token is an identifier or keyword that lexes differently
+   by function context (update_token_ident) */
+static bool js_skip_tok_ctx(JSParseState *s)
+{
+    JSAtom a;
+
+    if (s->token.val == TOK_IDENT)
+        a = s->token.u.ident.atom;
+    else if (s->token.val >= TOK_FIRST_KEYWORD &&
+             s->token.val <= TOK_LAST_KEYWORD)
+        a = s->token.u.ident.atom;
+    else
+        return false;
+    return (a > JS_ATOM_LAST_KEYWORD && a <= JS_ATOM_LAST_STRICT_KEYWORD) ||
+           a == JS_ATOM_yield || a == JS_ATOM_await;
+}
+
+static const JSSkipMemo *js_skip_memo_find(JSParseState *s, const uint8_t *key)
+{
+    uint32_t mask, k;
+
+    if (!s->skip_memo)
+        return NULL;
+    mask = s->skip_memo_cap - 1;
+    k = (uint32_t)(((uintptr_t)key * 2654435761u) >> 7) & mask;
+    while (s->skip_memo[k].key) {
+        const JSSkipMemo *e = &s->skip_memo[k];
+        if (e->key == key) {
+            JSFunctionDef *fd = s->cur_func;
+            if (e->strict != fd->is_strict_mode)
+                return NULL;
+            if (e->ctx && (e->fd != fd || e->infb != fd->in_function_body))
+                return NULL;
+            return e;
+        }
+        k = (k + 1) & mask;
+    }
+    return NULL;
+}
+
+static void js_skip_memo_put(JSParseState *s, const uint8_t *key, int tok,
+                             int bits, bool lf)
+{
+    JSFunctionDef *fd = s->cur_func;
+    uint32_t mask, k;
+
+    if (s->skip_memo_n * 2 >= s->skip_memo_cap) {
+        uint32_t ncap = s->skip_memo_cap ? s->skip_memo_cap * 2 : 1024, i;
+        JSSkipMemo *nm = js_malloc_rt(s->ctx->rt, ncap * sizeof(*nm));
+        if (!nm)
+            return;     /* no memory: record no more */
+        memset(nm, 0, ncap * sizeof(*nm));
+        for (i = 0; i < s->skip_memo_cap; i++) {
+            const JSSkipMemo *e = &s->skip_memo[i];
+            if (e->key) {
+                k = (uint32_t)(((uintptr_t)e->key * 2654435761u) >> 7) & (ncap - 1);
+                while (nm[k].key)
+                    k = (k + 1) & (ncap - 1);
+                nm[k] = *e;
+            }
+        }
+        js_free_rt(s->ctx->rt, s->skip_memo);
+        s->skip_memo = nm;
+        s->skip_memo_cap = ncap;
+    }
+    mask = s->skip_memo_cap - 1;
+    k = (uint32_t)(((uintptr_t)key * 2654435761u) >> 7) & mask;
+    while (s->skip_memo[k].key && s->skip_memo[k].key != key)
+        k = (k + 1) & mask;
+    if (!s->skip_memo[k].key)
+        s->skip_memo_n++;
+    s->skip_memo[k].key = key;
+    s->skip_memo[k].tok = tok;
+    s->skip_memo[k].bits = (uint8_t)(bits & 7);
+    s->skip_memo[k].lf = lf;
+    s->skip_memo[k].fd = fd;
+    s->skip_memo[k].strict = fd->is_strict_mode;
+    s->skip_memo[k].infb = fd->in_function_body;
+    s->skip_memo[k].ctx = (bits & SKIP_CTX) != 0;
+}
+
+static void js_skip_memo_free(JSParseState *s)
+{
+    js_free_rt(s->ctx->rt, s->skip_memo);
+    s->skip_memo = NULL;
+    s->skip_memo_cap = s->skip_memo_n = 0;
+}
