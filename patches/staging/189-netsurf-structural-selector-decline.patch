+/* ---- structural selector gate for block insert/remove (patch 189) ----
+ *
+ * True if the local insert/remove path must decline because a used
+ * stylesheet could restyle an EXISTING box whose style this path never
+ * reselects: the parent (:empty), a sibling (:first-child, :nth-child(),
+ * ...), or an ancestor (:has()). Only the static parts of each cached
+ * structural compound are tested; the structural pseudo-class itself is
+ * the dependency being gated, so any static match is a decline. Sibling
+ * combinators ('+'/'~', patch-186 state 1/2) also decline: a following
+ * sibling's style may depend on the changed sibling structure, and the
+ * precise per-rule analysis would need full selector matching.
+ *
+ * pnode is the parent DOM element, pbox its box. Returns true on any
+ * DOM error too (cannot prove safety).
+ */
+static bool html_rl_block_structural_risk(html_content *c, dom_node *pnode,
+		struct box *pbox)
+{
+	unsigned int i;
+	int k;
+	for (i = STYLESHEET_START; i < c->stylesheet_count; i++) {
+		struct html_rl_sib_sheet *e;
+		if (c->stylesheets[i].sheet == NULL ||
+		    c->stylesheets[i].unused)
+			continue;
+		e = html_rl_sib_sheet_for(c->stylesheets[i].sheet);
+		if (e == NULL)
+			continue;
+		if (e->state == 2) {
+			macsurf_debug_log_writef("LIFE rebuild local: declined "
+					"(page CSS needs conservative check)");
+			return true;
+		}
+		if (e->state == 1) {
+			macsurf_debug_log_writef("LIFE rebuild local: declined "
+					"(sibling combinators in page CSS)");
+			return true;
+		}
+		for (k = 0; k < e->nstructs; k++) {
+			struct html_rl_sib_compound *cp = &e->structs[k];
+			if ((cp->structural & HTML_RL_STRUCT_POSITIONAL) != 0) {
+				/* Positional pseudo-classes are evaluated
+				 * against the siblings; any sibling the
+				 * static parts could match makes the local
+				 * path unsafe. */
+				dom_node *n = NULL, *next;
+				if (dom_node_get_first_child(pnode, &n) !=
+				    DOM_NO_ERR)
+					return true;
+				while (n != NULL) {
+					dom_node_type type;
+					bool match = false;
+					if (dom_node_get_node_type(n, &type) ==
+					    DOM_NO_ERR &&
+					    type == DOM_ELEMENT_NODE)
+						match =
+						    html_rl_sib_compound_matches_static(
+							(dom_element *)n, cp,
+							NULL);
+					next = NULL;
+					if (dom_node_get_next_sibling(n,
+					    &next) != DOM_NO_ERR)
+						next = NULL;
