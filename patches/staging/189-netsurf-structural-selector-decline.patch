+/* Classify a lowercased pseudo-class name by the structural dependency
+ * its match state has on child insertion/removal (patch 189). 0 means
+ * the pseudo-class cannot change state when a block is inserted or
+ * removed (dynamic pseudos like :hover, :target, :root, ...). */
+static int html_rl_structural_kind(const char *name)
+{
