+	    strcmp(name, "only-child") == 0 ||
+	    strcmp(name, "only-of-type") == 0)
+		return HTML_RL_STRUCT_POSITIONAL;
+	if (strcmp(name, "empty") == 0)
+		return HTML_RL_STRUCT_EMPTY;
+	if (strcmp(name, "has") == 0)
