+/* ---- Patch 310 (doc 20 stage 2): the non-class attribute gate ----
+ *
+ * A SETATTRIBUTE / REMOVEATTRIBUTE mark names an attribute the local
+ * machinery never answered. The local path (html_reconvert_local_change)
+ * rebuilds the containing block's children from the DOM with fresh box
+ * construction and style selection, then re-lays out -- exactly what the
+ * full reconvert does to that subtree. So a non-class attribute change
+ * is answered locally iff NOTHING outside the rebuilt block can observe
+ * it. That is two checks:
+ *
+ * 1. No stylesheet can match on the attribute. Attribute selectors
+ *    ([name...], in any compound position, behind any namespace prefix,
+ *    inside :not()/:has()/:is()) and the attribute-reading pseudo-classes
+ *    this engine implements (:link/:visited read href, :enabled/:disabled
+ *    read disabled, :checked reads checked/selected; :lang() is stubbed
+ *    and never matches, scanned defensively anyway) are found by a
+ *    conservative textual scan in the html_rl_css_has_list_style_risk
+ *    idiom: comments and strings are skipped, and a backslash anywhere
+ *    else declines (it could be an escape hiding the name). The base,
+ *    quirks, adblock and user sheets are scanned too -- unlike the 186
+ *    cache, which starts at STYLESHEET_START: the base sheet carries
+ *    input[disabled], input[type=...], table[border] and a:link/:visited.
+ *    A sheet whose source cannot be read declines. `id` always declines:
+ *    `#` selectors are textually ambiguous with hex colours.
+ *    Anything the scan cannot prove absent is a decline, never a guess
+ *    (doc 20 constraint 1); over-declining only costs a full reconvert.
+ *
+ * 2. The element's own box, when it IS the rebuilt block, keeps its old
+ *    style: the rebuild re-cascades the block's children, not the block
+ *    itself. Presentational hints (hints.c -- keep the list below in sync
+ *    with it) map attributes onto the element's own style, and box->href
+ *    feeds the hover cursor, so a hinted attribute -- or href -- on a
+ *    block-level element declines. (Inline elements are rebuilt wholesale
+ *    as children of their block, so hints re-apply there.)
+ *
+ * Everything else an attribute change can do is reproduced by the local
+ * path by construction: box-construction reads (colspan/rowspan/src/
+ * value/...) are re-read from the DOM, paint-time reads (form control
+ * type, patch-218 numeric attributes) read the live DOM at repaint,
+ * interaction reads href/download live at click time, and custom
+ * elements' attributeChangedCallback runs synchronously inside
+ * setAttribute with its own marks (constraint 2: the DOM has committed).
+ */
+
+/* Presentational-hint attributes, from content/handlers/css/hints.c.
+ * Keep in sync with it: a new hinted attribute must be added here or a
+ * block-level change to it would keep a stale own-box style. */
+static const char *const html_rl_hint_attrs[] = {
+	"align", "background", "bgcolor", "border", "bordercolor",
+	"cellpadding", "cellspacing", "color", "cols", "height",
+	"hspace", "link", "nowrap", "rows", "size", "text", "type",
+	"valign", "vlink", "vspace", "width", NULL
+};
+
+/* Attribute-reading pseudo-classes, without the leading ':', per
+ * attribute name (see select.c node_is_link/node_is_disabled/
+ * node_is_checked; node_is_lang is stubbed). */
+static const char *const html_rl_pseudo_disabled[] =
+	{ "disabled", "enabled", NULL };
+static const char *const html_rl_pseudo_checked[] = { "checked", NULL };
+static const char *const html_rl_pseudo_href[] = { "link", "visited", NULL };
+static const char *const html_rl_pseudo_lang[] = { "lang(", NULL };
+static const char *const html_rl_pseudo_none[] = { NULL };
+
+static const char *const *html_rl_pseudos_for(const char *name)
+{
+	if (strcasecmp(name, "disabled") == 0)
+		return html_rl_pseudo_disabled;
+	if (strcasecmp(name, "checked") == 0 ||
+	    strcasecmp(name, "selected") == 0)
+		return html_rl_pseudo_checked;
+	if (strcasecmp(name, "href") == 0)
+		return html_rl_pseudo_href;
+	if (strcasecmp(name, "lang") == 0)
+		return html_rl_pseudo_lang;
+	return html_rl_pseudo_none;
+}
+
+static int html_rl310_cieq(const uint8_t *a, const char *b, size_t n)
+{
+	size_t k;
+	for (k = 0; k < n; k++) {
+		uint8_t ca = a[k], cb = (uint8_t)b[k];
+		if (ca >= 'A' && ca <= 'Z')
+			ca += (uint8_t)('a' - 'A');
+		if (cb >= 'A' && cb <= 'Z')
+			cb += (uint8_t)('a' - 'A');
+		if (ca != cb)
+			return 0;
+	}
+	return 1;
+}
+
+static int html_rl310_is_namech(uint8_t ch)
+{
+	return (ch >= 'a' && ch <= 'z') || (ch >= 'A' && ch <= 'Z') ||
+	    (ch >= '0' && ch <= '9') || ch == '_' || ch == '-' ||
+	    ch >= 0x80;
+}
+
+static int html_rl310_is_ws(uint8_t ch)
+{
+	return ch == ' ' || ch == '\t' || ch == '\n' || ch == '\r' ||
+	    ch == '\f';
+}
+
+/* True if one stylesheet's source can match on `name`. */
+static int html_rl_sheet_scan_attr(const uint8_t *st, size_t len,
+		const char *name, size_t namelen,
+		const char *const *pseudos)
+{
+	size_t i = 0;
+	int incomment = 0;
+	uint8_t quote = 0;
+	while (i < len) {
+		uint8_t ch = st[i];
+		if (incomment) {
+			if (ch == '*' && i + 1 < len && st[i + 1] == '/') {
+				incomment = 0;
+				i += 2;
+				continue;
+			}
+			i++;
+			continue;
+		}
+		if (quote != 0) {
+			if (ch == '\\' && i + 1 < len) {
+				i += 2;
+				continue;
+			}
+			if (ch == quote)
+				quote = 0;
+			i++;
+			continue;
+		}
+		if (ch == '/' && i + 1 < len && st[i + 1] == '*') {
+			incomment = 1;
+			i += 2;
+			continue;
+		}
+		if (ch == '"' || ch == '\'') {
+			quote = ch;
+			i++;
+			continue;
+		}
+		/* An escape outside a string could hide the name inside
+		 * an identifier ([data-\78 ]): decline, don't guess. */
+		if (ch == '\\')
+			return 1;
+		if (ch == '[') {
+			size_t j = i + 1;
+			while (j < len && html_rl310_is_ws(st[j]))
+				j++;
+			/* namespace prefix: `*|` or `ident|` */
+			if (j < len && st[j] == '*') {
+				if (j + 1 < len && st[j + 1] == '|')
+					j += 2;
+			} else {
+				size_t k = j;
+				while (k < len && html_rl310_is_namech(st[k]))
+					k++;
+				if (k > j && k < len && st[k] == '|')
+					j = k + 1;
+			}
+			while (j < len && html_rl310_is_ws(st[j]))
+				j++;
+			if (j + namelen <= len &&
+			    html_rl310_cieq(st + j, name, namelen) &&
+			    (j + namelen == len ||
+			     !html_rl310_is_namech(st[j + namelen])))
+				return 1;
+			i++;
+			continue;
+		}
+		if (ch == ':') {
+			int p;
+			for (p = 0; pseudos[p] != NULL; p++) {
+				size_t tl = strlen(pseudos[p]);
+				if (i + 1 + tl <= len &&
+				    html_rl310_cieq(st + i + 1, pseudos[p],
+					    tl) &&
+				    (i + 1 + tl == len ||
+				     !html_rl310_is_namech(st[i + 1 + tl])))
+					return 1;
+			}
+			i++;
+			continue;
+		}
+		i++;
+	}
+	return 0;
+}
+
+/* True if any used stylesheet can match on attribute `name`. */
+static int html_rl_sheet_refs_attr(html_content *c, const char *name)
+{
+	unsigned int i;
+	size_t namelen = strlen(name);
+	const char *const *pseudos = html_rl_pseudos_for(name);
+	for (i = 0; i < c->stylesheet_count; i++) {
+		const uint8_t *data;
+		size_t size = 0;
+		if (c->stylesheets[i].sheet == NULL ||
+		    c->stylesheets[i].unused)
+			continue;
+		data = content_get_source_data(c->stylesheets[i].sheet,
+				&size);
+		/* A sheet we cannot read might reference it. */
+		if (data == NULL || size == 0)
+			return 1;
+		if (html_rl_sheet_scan_attr(data, size, name, namelen,
+				pseudos))
+			return 1;
+	}
+	return 0;
+}
+
+static int html_rl_attr_is_hinted(const char *name)
+{
+	const char *const *hp;
+	for (hp = html_rl_hint_attrs; *hp != NULL; hp++)
+		if (strcasecmp(name, *hp) == 0)
+			return 1;
+	return 0;
+}
+
+/* Patch 310 - may a SETATTRIBUTE / REMOVEATTRIBUTE mark for `attr_name`
+ * on `vnode` be answered by html_reconvert_local? 1 yes, 0 decline (the
+ * caller takes the full reconvert, exactly as before this patch). See
+ * the block comment above for the equivalence argument. */
+int html_rl_attr_local_ok(struct content *base_c, void *vnode,
+		const char *attr_name)
+{
+	html_content *c = (html_content *)base_c;
+	struct box *b;
+	if (c == NULL || vnode == NULL || attr_name == NULL ||
+	    attr_name[0] == '\0')
+		return 0;
+	/* `#` selectors are textually ambiguous with hex colours. */
+	if (strcasecmp(attr_name, "id") == 0)
+		return 0;
+	/* The element's own box is the rebuilt block: its own style is
+	 * not re-selected, so a hinted attribute -- or href, which feeds
+	 * the hover cursor via box->href -- would go stale. */
+	b = box_for_node((dom_node *)vnode);
+	if (b != NULL && b->type == BOX_BLOCK &&
+	    (html_rl_attr_is_hinted(attr_name) ||
+	     strcasecmp(attr_name, "href") == 0))
+		return 0;
+	return !html_rl_sheet_refs_attr(c, attr_name);
+}
