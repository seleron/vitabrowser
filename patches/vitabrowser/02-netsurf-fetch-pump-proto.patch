# vitabrowser: netsurf -- declare fetch_pump()
#
# Hand-maintained, not generated. MacSurf added fetch_pump() to content/fetch.c
# -- it drives the fetch state machine every event-loop iteration so queued
# jobs start and per-scheme polls run -- but declared it only in their Mac OS 9
# frontend, which we do not port. Upstream builds with
# -Werror=missing-prototypes, so a definition with no visible prototype is an
# error.
#
# We want this function: brief §4 commits us to a single-threaded event loop
# pumping non-blocking curl_multi, which is exactly the shape fetch_pump
# exists to serve.
#
# Applies to: netsurf (after the generated stack)
--- a/content/fetch.h
+++ b/content/fetch.h
@@ -175,4 +175,12 @@
  * Abort a fetch.
  */
 void fetch_abort(struct fetch *f);
+
+/**
+ * Drive the fetch state machine once.
+ *
+ * Call every event-loop iteration: without it the fetch chain can go
+ * dormant and a queued fetch is stranded. Added by MacSurf; see fetch.c.
+ */
+void fetch_pump(void);
 
