# vitabrowser: netsurf -- handle MacSurf's new CSS units in the debug dumper
#
# Hand-maintained, not generated. MacSurf's libcss adds CSS_UNIT_MIN,
# CSS_UNIT_MAX and CSS_UNIT_CLAMP -- the min(), max() and clamp() value
# functions -- but never taught content/handlers/css/dump.c about them. They do
# not hit it because their CodeWarrior project does not build with
# -Werror=switch; upstream NetSurf does, so the core fails to compile against
# patched libcss.
#
# This was recorded in 06-engine-comparison.md §6 as something the netsurf-side
# port would unblock. It does not: MacSurf never fixed it, so the fix is ours.
#
# dump.c is a debug dumper, so printing the function name is the whole job.
#
# Applies to: netsurf (after the generated stack)
--- a/content/handlers/css/dump.c
+++ b/content/handlers/css/dump.c
@@ -148,6 +148,15 @@
 	case CSS_UNIT_CALC:
 		fprintf(stream, "calc()");
 		break;
+	case CSS_UNIT_MIN:
+		fprintf(stream, "min()");
+		break;
+	case CSS_UNIT_MAX:
+		fprintf(stream, "max()");
+		break;
+	case CSS_UNIT_CLAMP:
+		fprintf(stream, "clamp()");
+		break;
 	}
 }
 
