+static void form__clear_formless_radio_group(struct html_content *html,
+		struct box *b, struct form_control *radio, int depth)
+{
+	struct box *c;
+
+	if (b == NULL || depth > 256)
+		return;
+
+	if (b->gadget != NULL &&
+			b->gadget != radio &&
+			b->gadget->type == GADGET_RADIO &&
+			b->gadget->form == NULL &&
+			b->gadget->selected &&
