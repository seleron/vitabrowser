# libcss: calc() in row-gap and the gap shorthand
#
# property_unit_mask[] had no entry for MacSurf's CSS_PROP_ROW_GAP, so
# css__parse_calc rejected every unit for it. The gap shorthand parses
# row-gap first, so "gap: calc(...)" (Tailwind's gap-N:
# calc(var(--spacing) * N)) was dropped whole and flex items touched.
# column-gap: calc() already worked. Every other property that reaches
# css__parse_calc has a mask entry.
diff --git a/src/parse/properties/properties.c b/src/parse/properties/properties.c
index 06be01a..1e334c5 100644
--- a/src/parse/properties/properties.c
+++ b/src/parse/properties/properties.c
@@ -354,6 +354,11 @@ const uint32_t property_unit_mask[CSS_N_PROPERTIES] = {
 	[CSS_PROP_COLUMN_COUNT]          = UNIT_MASK_COLUMN_COUNT,
 	[CSS_PROP_COLUMN_FILL]           = UNIT_MASK_COLUMN_FILL,
 	[CSS_PROP_COLUMN_GAP]            = UNIT_MASK_COLUMN_GAP,
+	/* VitaBrowser (patch 101): MacSurf's row-gap had no entry, so every
+	 * unit inside a calc() was rejected -- and with it the whole "gap"
+	 * shorthand, which parses row-gap first (Tailwind's gap-N is
+	 * "gap: calc(var(--spacing) * N)"). */
+	[CSS_PROP_ROW_GAP]               = UNIT_MASK_COLUMN_GAP,
 	[CSS_PROP_COLUMN_RULE_COLOR]     = UNIT_MASK_COLUMN_RULE_COLOR,
 	[CSS_PROP_COLUMN_RULE_STYLE]     = UNIT_MASK_COLUMN_RULE_STYLE,
 	[CSS_PROP_COLUMN_RULE_WIDTH]     = UNIT_MASK_COLUMN_RULE_WIDTH,
