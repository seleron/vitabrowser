+	SMAP("host-context"),	/* VitaBrowser: never matches */
 	SMAP("is"),
 	SMAP("where"),
 	SMAP("has"),
diff --git a/src/parse/propstrings.h b/src/parse/propstrings.h
index 655a3c1..7b79b5b 100644
--- a/src/parse/propstrings.h
+++ b/src/parse/propstrings.h
@@ -164,7 +164,7 @@ enum {
 	SLICE, CLONE,
 	SMOOTH, HIGH_QUALITY, CRISP_EDGES, PIXELATED,
 	WAVY, FROM_FONT,
-	MARKER, PLACEHOLDER, FILE_SELECTOR_BUTTON, BACKDROP,
