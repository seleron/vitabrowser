@@ -571,6 +571,8 @@ const stringmap_entry stringmap[LAST_KNOWN] = {
 	SMAP("placeholder"),
 	SMAP("file-selector-button"),
 	SMAP("backdrop"),	/* VitaBrowser: never matches */
