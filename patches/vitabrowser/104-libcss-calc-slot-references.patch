# libcss: computed styles hold references to their calc() expressions
#
# fixes1159b keeps each calc() expression in a per-property side slot of
# the computed style as a bare lwc_string pointer, "owned by the sheet's
# string vector". NetSurf destroys an element's inline style sheet right
# after selecting its style, so every inline style="...: calc(...)" -- and
# every calc() produced by a var() substitution in one -- pointed at freed
# memory: sizes came out as other elements' expressions or 0 (20 inline
# calc heights in a test page: 18 14 0 16 14 0 ...), and on the Vita a
# read of freed memory.
#
# css__calc_slot_set() takes a reference to the new expression and drops
# the old one; the cascade helpers, font-size, clone and compose use it,
# and css_computed_style_destroy releases the slots when the style is
# really freed. The arena's comparison copies are untouched.
diff --git a/src/select/computed.c b/src/select/computed.c
index de3a40f..3e4dfe8 100644
--- a/src/select/computed.c
+++ b/src/select/computed.c
@@ -115,6 +115,13 @@ css_error css_computed_style_destroy(css_computed_style *style)
 		css__arena_remove_style(style);
 	}
 
+	/* VitaBrowser (patch 104): the calc slots hold references. */
+	{
+		unsigned int slot;
+		for (slot = 0; slot < MACSURF_CALC_SLOT_COUNT; slot++)
+			css__calc_slot_set(style, slot, NULL);
+	}
+
 	if (style->counter_increment != NULL) {
 		css_computed_counter *c;
 
@@ -320,7 +327,7 @@ css_error css__computed_style_clone(
 	 * slot numbers. */
 	{ size_t i;
 	for (i = 0; i < MACSURF_CALC_SLOT_COUNT; i++) {
-		clone->macsurf_calc_expr[i] = orig->macsurf_calc_expr[i];
+		css__calc_slot_set(clone, i, orig->macsurf_calc_expr[i]);
 	} }
 
 	if (orig->transition_data != NULL) {
@@ -379,10 +386,10 @@ css_error css_computed_style_compose(
 	 * index in the copied css_fixed length field stays valid. */
 	{ uint32_t s2;
 	for (s2 = 0; s2 < MACSURF_CALC_SLOT_COUNT; s2++) {
-		composed->macsurf_calc_expr[s2] =
+		css__calc_slot_set(composed, s2,
 				child->macsurf_calc_expr[s2] != NULL
 				? child->macsurf_calc_expr[s2]
-				: parent->macsurf_calc_expr[s2];
+				: parent->macsurf_calc_expr[s2]);
 	} }
 
 	/* Group 2 (#322): transition longhands are non-inherited by default.
diff --git a/src/select/computed.h b/src/select/computed.h
index 19d6566..e20e778 100644
--- a/src/select/computed.h
+++ b/src/select/computed.h
@@ -20,6 +20,28 @@
 #include "autogenerated_computed.h"
 #include "calc.h"
 
+/**
+ * VitaBrowser (patch 104): store a calc expression in a style's calc slot,
+ * holding a reference of its own. MacSurf stored the sheet's pointer
+ * unreferenced ("owned by the sheet's string vector"), but NetSurf destroys
+ * an element's inline style sheet right after selection, so every inline
+ * style="...: calc(...)" -- and every calc() a var() substitution produced
+ * from one -- read freed memory, usually another element's expression.
+ */
+static inline void css__calc_slot_set(css_computed_style *style,
+		unsigned int slot, lwc_string *expr)
+{
+	lwc_string *old = style->macsurf_calc_expr[slot];
+
+	if (old == expr)
+		return;
+	if (expr != NULL)
+		lwc_string_ref(expr);
+	style->macsurf_calc_expr[slot] = expr;
+	if (old != NULL)
+		lwc_string_unref(old);
+}
+
