# netsurf: <button> keeps a block, flex or grid display
#
# box_button() forced every button to BOX_INLINE_BLOCK after box
# construction had mapped its display (and blockified it inside flex or
# grid containers). Tailwind buttons are "display: inline-flex;
# align-items: center; justify-content: center", so their icon and label
# were laid out as inline flow at the top left instead of centred, and a
# display: block button stayed inline-level. A block, flex or grid box
# type is now kept; other displays still become inline-block.
diff --git a/content/handlers/html/box_special.c b/content/handlers/html/box_special.c
index 571a4d8..6ea8a68 100644
--- a/content/handlers/html/box_special.c
+++ b/content/handlers/html/box_special.c
@@ -907,7 +907,16 @@ box_button(dom_node *n,
 	box->flags |= IS_REPLACED;
 	gadget->box = box;
 
-	box->type = BOX_INLINE_BLOCK;
+	/* VitaBrowser (patch 105): a button keeps a block, flex or grid
+	 * display (box_construct already mapped it, blockified inside a flex
+	 * or grid container); anything else is an inline-block as before.
+	 * Forcing INLINE_BLOCK laid "display: inline-flex; align-items:
+	 * center; justify-content: center" buttons out as inline flow, so
+	 * every Tailwind button's icon and label sat at the top left. */
+	if (box->type != BOX_BLOCK && box->type != BOX_FLEX &&
+			box->type != BOX_INLINE_FLEX && box->type != BOX_GRID &&
+			box->type != BOX_INLINE_GRID)
+		box->type = BOX_INLINE_BLOCK;
 
 	/* Just render the contents */
 
