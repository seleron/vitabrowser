# netsurf: absolutely positioned children of flex/grid containers use the
# padding box
#
# layout_absolute() widens the containing block to its padding box (and
# restores it after) only for BLOCK, INLINE_BLOCK and TABLE_CELL; anything
# else fell into the "\todo inline ancestors" branch and resolved against
# the content box. Flex and grid containers are block containers, so
# every "position: absolute; inset: 0" child of one came out the size of
# the content box. With buttons now flex containers (patch 105), Tailwind's
# button fills (an absolute inset-0 span) stopped short of the padding.
# One helper, used at all three places, adds FLEX, INLINE_FLEX, GRID and
# INLINE_GRID.
diff --git a/content/handlers/html/layout.c b/content/handlers/html/layout.c
index 6a12d60..0c7dec4 100644
--- a/content/handlers/html/layout.c
+++ b/content/handlers/html/layout.c
@@ -6472,6 +6472,23 @@ layout_compute_offsets(const css_unit_ctx *unit_len_ctx,
 }
 
 
+/**
+ * VitaBrowser (patch 106): does an absolutely positioned box resolve
+ * against this containing block's padding box (block-level containers),
+ * or its content box (the "\todo inline ancestors" case)? Flex and grid
+ * containers are block containers too; leaving them out sized every
+ * absolutely positioned child of a flex container -- Tailwind's
+ * "absolute inset-0" button fills -- to the content box.
+ */
+static bool layout_absolute_cb_is_block(const struct box *cb)
+{
+	return cb->type == BOX_BLOCK || cb->type == BOX_INLINE_BLOCK ||
+			cb->type == BOX_TABLE_CELL || cb->type == BOX_FLEX ||
+			cb->type == BOX_INLINE_FLEX || cb->type == BOX_GRID ||
+			cb->type == BOX_INLINE_GRID;
+}
+
+
 /**
  * Layout and position an absolutely positioned box.
  *
@@ -6510,9 +6527,7 @@ layout_absolute(struct box *box,
 	static_left = cx + box->x;
 	static_top = cy + box->y;
 
-	if (containing_block->type == BOX_BLOCK ||
-			containing_block->type == BOX_INLINE_BLOCK ||
-			containing_block->type == BOX_TABLE_CELL) {
+	if (layout_absolute_cb_is_block(containing_block)) {
 		/* Block level container => temporarily increase containing
 		 * block dimensions to include padding (we restore this
 		 * again at the end) */
@@ -6711,9 +6726,7 @@ layout_absolute(struct box *box,
 	      containing_block->width);
 
 	box->x = left + margin[LEFT] + border[LEFT].width - cx;
-	if (containing_block->type == BOX_BLOCK ||
-			containing_block->type == BOX_INLINE_BLOCK ||
-			containing_block->type == BOX_TABLE_CELL) {
+	if (layout_absolute_cb_is_block(containing_block)) {
 		/* Block-level ancestor => reset container's width */
 		containing_block->width -= containing_block->padding[LEFT] +
 				containing_block->padding[RIGHT];
@@ -6851,9 +6864,7 @@ layout_absolute(struct box *box,
 	      containing_block->height);
 
 	box->y = top + margin[TOP] + border[TOP].width - cy;
-	if (containing_block->type == BOX_BLOCK ||
-			containing_block->type == BOX_INLINE_BLOCK ||
-			containing_block->type == BOX_TABLE_CELL) {
+	if (layout_absolute_cb_is_block(containing_block)) {
 		/* Block-level ancestor => reset container's height */
 		containing_block->height -= containing_block->padding[TOP] +
 				containing_block->padding[BOTTOM];
