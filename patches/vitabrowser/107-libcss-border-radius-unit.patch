# libcss: border-radius cascade converts its unit (it corrupted "bottom")
#
# css__cascade_border_radius (MacSurf) passed the raw bytecode unit
# (UNIT_PX is 0x100) to set_border_radius(), whose 5-bit unit field it
# overflowed into the neighbouring "bottom" field of i.bits[7]: any element
# with a border-radius had bottom's unit ORed with em (0.5px became
# 0.5em). Tailwind button fills are "absolute inset-[0.5px]
# rounded-[inherit]" spans, so they stopped 7px short of the button's
# bottom. The unit now goes through css__to_css_unit() like every other
# length cascade (the only one that did not). Nothing reads the
# border-radius unit, so its own value is unaffected.
diff --git a/src/select/properties/s_border_radius.c b/src/select/properties/s_border_radius.c
index 0c04127..fa1057c 100644
--- a/src/select/properties/s_border_radius.c
+++ b/src/select/properties/s_border_radius.c
@@ -33,6 +33,15 @@ css_error css__cascade_border_radius(uint32_t opv, css_style *style,
 		}
 	}
 
+	/* VitaBrowser (patch 107): convert the bytecode unit (UNIT_PX is
+	 * 0x100) to a css_unit as every other length cascade does. The raw
+	 * value overflowed set_border_radius()'s 5-bit unit field into the
+	 * neighbouring "bottom" bits of i.bits[7], so every element with a
+	 * border-radius had its bottom offset's unit ORed with em: an
+	 * absolute "inset: .5px" child of a rounded Tailwind button came out
+	 * 7px short. */
+	unit = css__to_css_unit(unit);
+
 	if (css__outranks_existing(getOpcode(opv), isImportant(opv), state,
 			getFlagValue(opv))) {
 		return set_border_radius(state->computed, value, length, unit);
