+static int layout_multicol_default_gap(
+		const struct box *block,
+		const css_unit_ctx *unit_len_ctx)
+{
+	css_fixed one_em;
+	int gap;
+
+	one_em = INTTOFIX(1);
+	gap = FIXTOINT(css_unit_len2device_px(block->style,
+			unit_len_ctx, one_em, CSS_UNIT_EM));
+	if (gap < 0)
+		gap = 0;
+	return gap;
