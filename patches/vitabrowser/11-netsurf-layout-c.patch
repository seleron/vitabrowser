+static bool layout_multicol_child_supported(const struct box *child)
+{
+	if (child == NULL)
+		return false;
+
+	if (child->type == BOX_BLOCK ||
+			child->type == BOX_FLEX ||
+			child->type == BOX_GRID ||
+			child->type == BOX_INLINE_CONTAINER) {
+		return true;
+	}
+
+	return false;
+}
+
+static bool layout_multicol_child_spans_all(const struct box *child)
+{
+	if (child == NULL || child->style == NULL)
+		return false;
+
+	return css_computed_column_span(child->style) == CSS_COLUMN_SPAN_ALL;
+}
