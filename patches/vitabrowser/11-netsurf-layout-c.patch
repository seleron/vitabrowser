+static bool layout_multicol_layout_child(
+		struct box *child,
+		int available_width,
+		int viewport_height,
+		struct box *cont,
+		html_content *content)
+{
+	if (child->type == BOX_INLINE_CONTAINER) {
+		child->width = available_width;
+		if (!layout_inline_container(child, available_width,
+				cont, 0, 0, content))
+			return false;
+		if (child->height == AUTO)
+			child->height = 0;
+		return true;
+	}
