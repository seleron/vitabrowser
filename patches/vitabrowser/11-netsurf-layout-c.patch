+/* Extern wrapper so html.c (html_reformat) can drive the invalidation without
+ * the file-static in scope. Prototype in layout.h. */
+void html_minmax_invalidate_tree(struct box *box)
+{
+	box_minmax_invalidate_tree(box);
+}
