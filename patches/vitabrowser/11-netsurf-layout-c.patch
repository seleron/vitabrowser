+	if (preferred_width > 0) {
+		fit_count = (available_width + gap) / (preferred_width + gap);
+		if (fit_count < 1)
+			fit_count = 1;
+		if (count > 0) {
+			if (fit_count < count)
+				count = fit_count;
+		} else {
+			count = fit_count;
+		}
+	}
