+/* exported interface documented in html/box_inspect.h */
+bool box_is_hoisted(const struct box *b)
+{
+	int32_t z;
+	uint8_t pos;
+
+	if (b->style == NULL)
+		return false;
+	pos = css_computed_position(b->style);
