+		if (c->children != NULL && c->gadget == NULL) {
+			int32_t nz = INT32_MIN;
+			int nx, ny;
+			struct box *n = box_hoist_search(c,
+				cx - scrollbar_get_offset(c->scroll_x),
+				cy - scrollbar_get_offset(c->scroll_y),
+				x, y, depth + 1, &nz, &nx, &ny);
+			if (n != NULL && (best == NULL || nz >= *best_z)) {
+				best = n;
+				*best_z = nz;
+				*hx = nx;
+				*hy = ny;
+			}
+		}
+	}
+	return best;
+}
