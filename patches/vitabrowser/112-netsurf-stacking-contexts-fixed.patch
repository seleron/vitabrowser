+/* The topmost hit among the hoisted boxes below box, whose children sit
+ * at x_off / y_off: painted last = highest z, then last in tree order.
+ * Stacking contexts that are not hoisted (opacity, transform) are walked
+ * through; close enough for hit testing. */
+static struct box *box_hoist_search(struct box *box, int x_off, int y_off,
+		int x, int y, int depth, int32_t *best_z, int *hx, int *hy)
+{
+	struct box *c, *best = NULL;
+
+	if (depth > 200)
+		return NULL;
+	for (c = box->children; c; c = c->next) {
+		int cx = x_off + c->x, cy = y_off + c->y;
+
+		if (box_is_hoisted(c)) {
+			int32_t z = box_hoist_z(c);
+			if (css_computed_position(c->style) ==
+					CSS_POSITION_FIXED) {
+				cx += vb_fixed_scroll_x;
+				cy += vb_fixed_scroll_y;
+			}
+			if (css_computed_visibility(c->style) !=
+					CSS_VISIBILITY_HIDDEN &&
+			    (best == NULL || z >= *best_z) &&
+			    box_hoist_hit(c, x - cx, y - cy)) {
+				int32_t nz = INT32_MIN;
+				int nx, ny;
+				struct box *n;
+
+				best = c;
+				*best_z = z;
+				*hx = cx;
+				*hy = cy;
+				/* something hoisted inside it paints above */
+				n = box_hoist_search(c,
+					cx - scrollbar_get_offset(c->scroll_x),
+					cy - scrollbar_get_offset(c->scroll_y),
+					x, y, depth + 1, &nz, &nx, &ny);
+				if (n != NULL) {
