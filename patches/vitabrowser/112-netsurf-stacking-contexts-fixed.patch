+/*
+ * VitaBrowser: stacking contexts across levels.
+ *
+ * MacSurf's sibling-level bucketing (above) left "positioned descendants of
+ * a non-SC parent" painting in their parent's flow: a fixed or z-indexed
+ * element inside a plain wrapper painted in DOM order, under every later
+ * sibling of the wrapper. That is the usual shape of a modal (Google's
+ * consent dialog: div[role=dialog] > div.scrim{position:fixed;z-index:9997}
+ * + div{position:fixed;z-index:9998}) and of most dropdowns, so dialogs
+ * drew UNDER the page they cover.
+ *
+ * Now a positioned box with an explicit z-index, or any fixed box, is
+ * "hoisted": painted by its nearest ancestor stacking context (the root, or
+ * a box html_redraw_box_classify() calls a stacking context) in that
+ * context's z phases, with the coordinates its own parent would have given
+ * it. Its parent, not being a stacking context, skips it. Clipping by
+ * intermediate overflow boxes is not applied to hoisted boxes (a real
+ * browser clips them only when the overflow box is also their containing
+ * block). Opacity and transform stacking contexts stay in flow.
+ */
+struct hrb_entry {
+	struct box *b;
+	int x, y;		/* the x_parent / y_parent to draw it with */
+	int32_t z;
+	int cls;		/* html_redraw_sc_class */
+};
+
+static bool html_redraw_box_hoisted(const struct box *c)
+{
+	int32_t z;
+	uint8_t pos;
+
+	if (c->style == NULL)
+		return false;
+	pos = css_computed_position(c->style);
+	if (pos == CSS_POSITION_STATIC)
+		return false;
+	return pos == CSS_POSITION_FIXED ||
+		css_computed_z_index(c->style, &z) == CSS_Z_INDEX_SET;
+}
+
+static bool html_redraw_box_is_sc_root(const struct box *box)
+{
+	int32_t z;
+
+	return box->parent == NULL ||
+		html_redraw_box_classify(box, &z) != HRBSC_NONE;
+}
+
+struct hrb_buckets {
+	struct hrb_entry *e;
+	int n, size;
+};
+
+/* Note c (drawn with x_parent/y_parent = x, y) for its z phase. */
+static void hrb_add(struct hrb_buckets *bk, struct box *c, int x, int y,
+		html_redraw_sc_class cls, int32_t z)
+{
+	if (bk->n == bk->size) {
+		int size = bk->size ? bk->size * 2 : 16;
+		struct hrb_entry *e = realloc(bk->e, size * sizeof(*e));
+		if (e == NULL)
+			return;	/* out of memory: this box goes unpainted */
+		bk->e = e;
+		bk->size = size;
+	}
+	bk->e[bk->n].b = c;
+	bk->e[bk->n].x = x;
+	bk->e[bk->n].y = y;
+	bk->e[bk->n].z = (cls == HRBSC_ZERO || cls == HRBSC_NONE) ? 0 : z;
+	bk->e[bk->n].cls = cls;
+	bk->n++;
+}
+
+/* Collect the hoisted boxes below box (whose children are drawn with
+ * x_off / y_off), not descending into stacking contexts. */
+static void hrb_collect(struct hrb_buckets *bk, struct box *box,
+		int x_off, int y_off, int depth)
+{
+	struct box *c;
+	int32_t z;
+	html_redraw_sc_class cls;
+
+	if (depth > 200)
+		return;
+	for (c = box->children; c; c = c->next) {
+		cls = html_redraw_box_classify(c, &z);
+		if (html_redraw_box_hoisted(c)) {
+			hrb_add(bk, c, x_off, y_off, cls, z);
+			continue;
+		}
+		if (cls != HRBSC_NONE)
+			continue;	/* its own stacking context */
+		if (c->children == NULL || c->gadget != NULL ||
+		    (c->flags & SVG_INLINE))
+			continue;
+		hrb_collect(bk, c,
+			x_off + c->x - scrollbar_get_offset(c->scroll_x),
+			y_off + c->y - scrollbar_get_offset(c->scroll_y),
+			depth + 1);
+	}
+}
+
+/* position: fixed stays put while the page scrolls (box_inspect.h) */
+static inline int hrb_fixed_dx(const struct box *b)
+{
+	return (b->style != NULL && css_computed_position(b->style) ==
+			CSS_POSITION_FIXED) ? vb_fixed_scroll_x : 0;
+}
+
+static inline int hrb_fixed_dy(const struct box *b)
+{
+	return (b->style != NULL && css_computed_position(b->style) ==
+			CSS_POSITION_FIXED) ? vb_fixed_scroll_y : 0;
+}
+
+static void hrb_sort(struct hrb_entry *e, int n)
+{
+	int i, j;
+
+	/* stable insertion sort by z ascending: negative z first, then z 0
+	 * and z:auto in tree order, then positive z */
+	for (i = 1; i < n; i++) {
+		struct hrb_entry t = e[i];
+		for (j = i - 1; j >= 0 && e[j].z > t.z; j--)
+			e[j + 1] = e[j];
+		e[j + 1] = t;
+	}
+}
