+/* Does the point (relative to b's border-box origin) hit b's area? */
+static bool box_hoist_hit(const struct box *b, int x, int y)
+{
+	int w = b->padding[LEFT] + b->width + b->padding[RIGHT] +
+			b->border[RIGHT].width;
+	int h = b->padding[TOP] + b->height + b->padding[BOTTOM] +
+			b->border[BOTTOM].width;
+
+	if (x >= -b->border[LEFT].width && x < w &&
+	    y >= -b->border[TOP].width && y < h)
+		return true;
+	/* overflow visible: descendants poking out count too */
+	if (box_overflow_x(b) == CSS_OVERFLOW_VISIBLE &&
+	    box_overflow_y(b) == CSS_OVERFLOW_VISIBLE &&
+	    x >= b->descendant_x0 && x < b->descendant_x1 &&
+	    y >= b->descendant_y0 && y < b->descendant_y1)
+		return true;
+	return false;
+}
