# netsurf (vita frontend): drag and scroll what is under the finger or pointer
#
# Touch drags, the right stick and the D-pad scrolled only the page, so a
# dialog's scrolling middle (Google's and YouTube's consent text, with Accept
# all at its end) could not be scrolled at all. They now go through
# browser_window_scroll_at_point at the finger's start point or the pointer,
# which scrolls the innermost scrollable box there and falls back to the page
# when that box is at its end or there is none.
diff --git a/frontends/vita/input.c b/frontends/vita/input.c
index 89582b88d..b0020fddd 100644
--- a/frontends/vita/input.c
+++ b/frontends/vita/input.c
@@ -129,6 +129,21 @@ static void window_xy(struct gui_window *gw, int sx, int sy, int *x, int *y)
 	*y = sy + scy;
 }
 
+/**
+ * Scroll what is under a screen position: the innermost scrollable box
+ * there (a dialog's scrolling middle, a code block), or the page when
+ * that box is at its end or there is none.
+ */
+static void scroll_at(struct gui_window *gw, int sx, int sy, int dx, int dy)
+{
+	struct browser_window *bw = vita_window_browser(gw);
+	int x, y;
+
+	window_xy(gw, sx, sy, &x, &y);
+	if (bw == NULL || !browser_window_scroll_at_point(bw, x, y, dx, dy))
+		vita_window_scroll_by(gw, dx, dy);
+}
+
 /** A click at a screen position: press and release in one go. */
 static void click_at(struct gui_window *gw, int sx, int sy)
 {
@@ -164,8 +179,8 @@ static void touch_step(struct gui_window *gw, const struct vita_input *in)
 			vita_input_stats.drags++;
 		}
 		if (st.dragging)
-			vita_window_scroll_by(gw, st.touch_x - in->tx,
-					      st.touch_y - in->ty);
+			scroll_at(gw, st.touch_x0, st.touch_y0,
+				  st.touch_x - in->tx, st.touch_y - in->ty);
 		st.touch_x = in->tx;
 		st.touch_y = in->ty;
 		return;
@@ -266,7 +281,7 @@ enum vita_browse_action vita_input_browse(struct gui_window *gw,
 	dx += (int)(stick(in->rx) * 32.0f);
 	dy += (int)(stick(in->ry) * 32.0f);
 	if (dx != 0 || dy != 0)
-		vita_window_scroll_by(gw, dx, dy);
+		scroll_at(gw, (int)st.x, (int)st.y, dx, dy);
 
 	if ((pressed & SCE_CTRL_LTRIGGER) &&
 	    browser_window_history_back_available(bw)) {
