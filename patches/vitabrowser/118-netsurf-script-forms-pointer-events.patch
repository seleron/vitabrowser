# netsurf: clicks and taps reach script-built forms and pointer-event buttons; key events from the IME
#
# - A submit control that script inserted into a <form> (React renders the
#   whole claude.ai login form) was never associated with it: "form can not
#   be submitted" and no submit event. The click now finds the control's
#   <form> ancestor and, for a form created after parsing, makes its
#   struct form on demand (html_forms_form_for_node), so the submit event
#   fires and a page can cancel it.
# - A tap dispatches pointerdown / pointerup around the mouse events, with
#   the pointer fields (pointerId, pointerType, isPrimary, pressure): mobile
#   sites (YouTube) listen for pointer events, not click.
diff --git a/content/handlers/html/forms.c b/content/handlers/html/forms.c
index 4669154e9..b8a65b378 100644
--- a/content/handlers/html/forms.c
+++ b/content/handlers/html/forms.c
@@ -122,6 +122,24 @@ out:
 	return ret;
 }
 
+/* documented in private.h */
+struct form *html_forms_form_for_node(struct form **forms,
+		const char *docenc, dom_node *node)
+{
+	struct form *f;
+
+	for (f = *forms; f != NULL; f = f->prev)
+		if (f->node == (void *)node)
+			return f;
+	/* A form script created after the document was parsed. */
+	f = parse_form_element(docenc, node);
+	if (f == NULL)
+		return NULL;
+	f->prev = *forms;
+	*forms = f;
+	return f;
+}
+
 /* documented in html_internal.h */
 struct form *html_forms_get_forms(const char *docenc, dom_html_document *doc)
 {
