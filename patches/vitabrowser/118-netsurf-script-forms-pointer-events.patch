@@ -1134,6 +1135,45 @@ get_mouse_action_node(html_content *html,
 /**
  * process mouse activity on a form gadget
  */
+/**
+ * VitaBrowser: the form a control's DOM node sits in (its form="" owner or
+ * nearest <form> ancestor), as NetSurf knows it, or NULL.
+ */
+static struct form *vb_form_for_node(html_content *html, void *node)
+{
+	dom_node *n = node, *next;
+	struct form *f;
+	dom_exception exc;
+
+	if (n == NULL)
+		return NULL;
+	dom_node_ref(n);
+	while (n != NULL) {
+		dom_string *name = NULL;
+		bool is_form = false;
+
+		if (dom_node_get_node_name(n, &name) == DOM_NO_ERR &&
+		    name != NULL) {
+			is_form = dom_string_length(name) == 4 &&
+				strncasecmp(dom_string_data(name), "form",
+					4) == 0;
+			dom_string_unref(name);
+		}
+		if (is_form) {
+			f = html_forms_form_for_node(&html->forms,
+					html->encoding, n);
+			dom_node_unref(n);
+			return f;
+		}
+		exc = dom_node_get_parent_node(n, &next);
+		dom_node_unref(n);
+		if (exc != DOM_NO_ERR)
+			return NULL;
+		n = next;
+	}
+	return NULL;
+}
