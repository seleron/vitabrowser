# netsurf: rem is relative to the root element's font size during the cascade
#
# The cascade ran with the unit context's root_style NULL (html_reformat sets
# it only after layout), so every "font-size: 2rem" was 32px whatever the
# root said: YouTube (html { font-size: 10px }) drew its text 1.6x too big.
# box_get_style lends the root style to each selection.
diff --git a/content/handlers/html/box_construct.c b/content/handlers/html/box_construct.c
index 0eec16a60..c635a272a 100644
--- a/content/handlers/html/box_construct.c
+++ b/content/handlers/html/box_construct.c
@@ -456,9 +456,19 @@ box_get_style_with_select_ctx(html_content *c, css_select_ctx *select_ctx,
 	ctx.dyn_active_node = c->dyn_active_node;
 	ctx.dyn_focus_node = c->dyn_focus_node;
 
-	/* Select style for element */
-	styles = nscss_get_style(&ctx, n, &c->media, &c->unit_len_ctx,
-			inline_style);
+	/* Select style for element. VitaBrowser: rem is relative to the
+	 * root element's font size, but the cascade ran with the unit
+	 * context's root_style NULL (html_reformat sets it only after
+	 * layout), so every "font-size: 2rem" came out 32px whatever the
+	 * root said (YouTube: html { font-size: 10px }, text 1.6x too big).
+	 * Lend the root style to this selection. */
+	{
+		css_unit_ctx ulc = c->unit_len_ctx;
+		if (root_style != NULL)
+			ulc.root_style = root_style;
+		styles = nscss_get_style(&ctx, n, &c->media, &ulc,
+				inline_style);
+	}
 
 	/* Transfer the element's environment to the caller, which stores it
 	 * on the box so this element's children can inherit it. */
