+/**
+ * \file
+ * VitaBrowser: inline <svg> painting (vb_inline_svg.c).
+ */
+
+#ifndef NETSURF_HTML_VB_INLINE_SVG_H
+#define NETSURF_HTML_VB_INLINE_SVG_H
+
+struct box;
+struct redraw_context;
+struct html_content;
+
+/**
+ * Paint an SVG_INLINE box's <svg> into its content rectangle.
+ *
+ * \param box     the box (box->node is the <svg> element)
+ * \param x, y    top left of the content area, in redraw coordinates
+ * \param width, height  the content area's size, in redraw coordinates
+ * \return false only if a plotter failed
+ */
+bool vb_inline_svg_paint(struct box *box, int x, int y, int width,
+		int height, const struct redraw_context *ctx,
+		const struct html_content *html);
+
+/** Drop every cached diagram (memory pressure, content teardown). */
+void vb_inline_svg_flush(void);
+
+#endif
