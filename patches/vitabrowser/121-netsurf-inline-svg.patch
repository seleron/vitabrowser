+
+/**
+ * \file
+ * VitaBrowser: inline <svg> elements, painted with libsvgtiny.
+ *
+ * MacSurf builds a box for an inline <svg> (SVG_INLINE) but painted it only
+ * on Mac OS 9 (macos9_svg_paint_inline), so every inline icon and logo --
+ * Google's logo, YouTube's icons, most sites' buttons -- was blank here.
+ *
+ * The element's DOM subtree is serialised back to SVG markup and parsed by
+ * libsvgtiny (the same library that renders SVG images) at the box's size;
+ * the shapes are plotted as svg.c does. Page CSS does not reach the SVG
+ * children, so two things are carried over from the <svg> box's style:
+ * "currentColor" becomes the CSS colour, and a root with no fill of its own
+ * fills with it (icon sets rely on "fill: currentColor" in CSS). Elements a
+ * <use href="#id"> refers to are copied into a <defs> (sprite sheets).
+ *
+ * Parsed diagrams are cached by box, node, size and the reconvert sequence
+ * (a DOM change rebuilds the boxes, so stale entries are never hit).
+ */
+
+#include <stdbool.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include <dom/dom.h>
+#include <svgtiny.h>
+
+#include "utils/utils.h"
+#include "utils/nsurl.h"
+#include "netsurf/plotters.h"
+#include "netsurf/types.h"
+#include "css/utils.h"
+
+#include "html/private.h"
+#include "html/box.h"
+#include "html/vb_inline_svg.h"
+
+extern unsigned long macsurf_reconvert_seq;
+
+/* ---- a growable string ------------------------------------------------ */
+
+struct sbuf {
+	char *s;
+	size_t n, size;
+	bool oom;
+};
+
+static void sb_add(struct sbuf *b, const char *p, size_t n)
+{
+	if (b->oom)
+		return;
+	if (b->n + n + 1 > b->size) {
+		size_t size = b->size ? b->size * 2 : 1024;
+		char *s;
+		while (size < b->n + n + 1)
+			size *= 2;
+		s = realloc(b->s, size);
+		if (s == NULL) {
+			b->oom = true;
+			return;
+		}
+		b->s = s;
+		b->size = size;
+	}
+	memcpy(b->s + b->n, p, n);
+	b->n += n;
+	b->s[b->n] = '\0';
+}
+
+static void sb_str(struct sbuf *b, const char *p)
+{
+	sb_add(b, p, strlen(p));
+}
+
+/* XML-escape text or an attribute value. */
+static void sb_esc(struct sbuf *b, const char *p, size_t n)
+{
+	size_t i, run = 0;
+
+	for (i = 0; i < n; i++) {
+		const char *rep = NULL;
+		switch (p[i]) {
+		case '&': rep = "&amp;"; break;
+		case '<': rep = "&lt;"; break;
+		case '>': rep = "&gt;"; break;
+		case '"': rep = "&quot;"; break;
+		default: break;
+		}
+		if (rep != NULL) {
+			sb_add(b, p + run, i - run);
+			sb_str(b, rep);
+			run = i + 1;
+		}
+	}
+	sb_add(b, p + run, n - run);
+}
+
+/* ---- serialising the subtree ------------------------------------------ */
+
+struct ser {
+	struct sbuf out;
+	char color[8];		/* "#rrggbb": what currentColor means */
+	char *refs[16];		/* ids that <use> elements point at */
+	int nrefs;
+	int nodes;
+};
+
+static bool dstr_eq(dom_string *s, const char *lit)
+{
+	size_t n = strlen(lit);
+	return s != NULL && dom_string_byte_length(s) == n &&
+		strncasecmp(dom_string_data(s), lit, n) == 0;
+}
+
+static void note_ref(struct ser *z, dom_string *v)
+{
+	const char *p;
+	size_t n;
+	int i;
+
+	if (v == NULL)
+		return;
+	p = dom_string_data(v);
+	n = dom_string_byte_length(v);
+	if (n < 2 || p[0] != '#' || z->nrefs >= 16)
+		return;
+	for (i = 0; i < z->nrefs; i++)
+		if (strlen(z->refs[i]) == n - 1 &&
+		    strncmp(z->refs[i], p + 1, n - 1) == 0)
+			return;
+	z->refs[z->nrefs] = strndup(p + 1, n - 1);
+	if (z->refs[z->nrefs] != NULL)
+		z->nrefs++;
+}
+
+static void ser_node(struct ser *z, dom_node *n, int depth, bool root);
+
+static void ser_children(struct ser *z, dom_node *n, int depth)
+{
+	dom_node *c = NULL, *next;
+
+	if (dom_node_get_first_child(n, &c) != DOM_NO_ERR)
+		return;
+	while (c != NULL) {
+		ser_node(z, c, depth + 1, false);
+		if (dom_node_get_next_sibling(c, &next) != DOM_NO_ERR)
+			next = NULL;
+		dom_node_unref(c);
+		c = next;
+	}
+}
+
+static void ser_node(struct ser *z, dom_node *n, int depth, bool root)
+{
+	dom_node_type type;
+	dom_string *name = NULL;
+	dom_namednodemap *attrs = NULL;
+	uint32_t i, na = 0;
+	bool has_fill = false, has_xmlns = false;
+
+	if (depth > 64 || ++z->nodes > 20000 || z->out.oom)
+		return;
+	if (dom_node_get_node_type(n, &type) != DOM_NO_ERR)
+		return;
+	if (type == DOM_TEXT_NODE || type == DOM_CDATA_SECTION_NODE) {
+		dom_string *t = NULL;
+		if (dom_characterdata_get_data((dom_characterdata *)n, &t) ==
+				DOM_NO_ERR && t != NULL) {
+			sb_esc(&z->out, dom_string_data(t),
+			       dom_string_byte_length(t));
+			dom_string_unref(t);
+		}
+		return;
+	}
+	if (type != DOM_ELEMENT_NODE)
+		return;
+	if (dom_node_get_node_name(n, &name) != DOM_NO_ERR || name == NULL)
+		return;
+	if (dstr_eq(name, "script") || dstr_eq(name, "foreignObject")) {
+		dom_string_unref(name);
+		return;
+	}
+	sb_str(&z->out, "<");
+	sb_add(&z->out, dom_string_data(name), dom_string_byte_length(name));
+
+	if (dom_node_get_attributes(n, &attrs) == DOM_NO_ERR && attrs != NULL)
+		dom_namednodemap_get_length(attrs, &na);
+	for (i = 0; i < na; i++) {
+		dom_attr *a = NULL;
+		dom_string *an = NULL, *av = NULL;
+
+		if (dom_namednodemap_item(attrs, i, (void *)&a) != DOM_NO_ERR ||
+		    a == NULL)
+			continue;
+		if (dom_attr_get_name(a, &an) == DOM_NO_ERR && an != NULL &&
+		    dom_attr_get_value(a, &av) == DOM_NO_ERR) {
+			const char *vp = av ? dom_string_data(av) : "";
+			size_t vn = av ? dom_string_byte_length(av) : 0;
+
+			if (dstr_eq(an, "fill"))
+				has_fill = true;
+			if (dstr_eq(an, "xmlns"))
+				has_xmlns = true;
+			if (dstr_eq(an, "href") || dstr_eq(an, "xlink:href"))
+				note_ref(z, av);
+			sb_str(&z->out, " ");
+			sb_add(&z->out, dom_string_data(an),
+			       dom_string_byte_length(an));
+			sb_str(&z->out, "=\"");
+			if (vn == 12 && strncasecmp(vp, "currentColor", 12) == 0)
+				sb_str(&z->out, z->color);
+			else
+				sb_esc(&z->out, vp, vn);
+			sb_str(&z->out, "\"");
+		}
+		if (an != NULL)
+			dom_string_unref(an);
+		if (av != NULL)
+			dom_string_unref(av);
+		dom_node_unref(a);
+	}
+	if (attrs != NULL)
+		dom_namednodemap_unref(attrs);
+	if (root) {
+		if (!has_xmlns)
+			sb_str(&z->out, " xmlns=\"http://www.w3.org/2000/svg\""
+			       " xmlns:xlink=\"http://www.w3.org/1999/xlink\"");
+		if (!has_fill) {
+			sb_str(&z->out, " fill=\"");
+			sb_str(&z->out, z->color);
+			sb_str(&z->out, "\"");
+		}
+	}
+	sb_str(&z->out, ">");
+	ser_children(z, n, depth);
+	if (root && z->nrefs > 0) {
+		/* the <use> targets, which may live anywhere in the page */
+		dom_document *doc = NULL;
+		int r;
+		if (dom_node_get_owner_document(n, &doc) == DOM_NO_ERR &&
+		    doc != NULL) {
+			sb_str(&z->out, "<defs>");
+			for (r = 0; r < z->nrefs; r++) {
+				dom_string *id = NULL;
+				dom_element *e = NULL;
+				if (dom_string_create((const uint8_t *)z->refs[r],
+						strlen(z->refs[r]), &id) !=
+						DOM_NO_ERR)
+					continue;
+				if (dom_document_get_element_by_id(doc, id,
+						&e) == DOM_NO_ERR && e != NULL) {
+					ser_node(z, (dom_node *)e, depth + 1,
+						 false);
+					dom_node_unref(e);
+				}
+				dom_string_unref(id);
+			}
+			sb_str(&z->out, "</defs>");
+			dom_node_unref(doc);
+		}
+	}
+	sb_str(&z->out, "</");
+	sb_add(&z->out, dom_string_data(name), dom_string_byte_length(name));
+	sb_str(&z->out, ">");
+	dom_string_unref(name);
+}
+
+/* ---- the cache ---------------------------------------------------------- */
+
+#define VB_SVG_CACHE 48
+
+static struct vb_svg_entry {
+	const struct box *box;
+	const void *node;
+	int w, h;
+	unsigned long seq;
+	unsigned long used;
+	struct svgtiny_diagram *d;	/* NULL: parse failed, don't retry */
+} cache[VB_SVG_CACHE];
+static unsigned long cache_clock;
+
+static struct svgtiny_diagram *diagram_for(struct box *box, int w, int h,
+		const html_content *html)
+{
+	struct vb_svg_entry *e, *victim = &cache[0];
+	struct ser z;
+	css_color col = 0xff000000;
+	int i;
+
+	for (i = 0; i < VB_SVG_CACHE; i++) {
+		e = &cache[i];
+		if (e->box == box && e->node == box->node && e->w == w &&
+		    e->h == h && e->seq == macsurf_reconvert_seq &&
+		    e->used != 0) {
+			e->used = ++cache_clock;
+			return e->d;
+		}
+		if (e->used < victim->used)
+			victim = e;
+	}
+
+	memset(&z, 0, sizeof(z));
+	if (box->style != NULL)
+		css_computed_color(box->style, &col);
+	snprintf(z.color, sizeof(z.color), "#%02x%02x%02x",
+		 (unsigned int)((col >> 16) & 0xff),
+		 (unsigned int)((col >> 8) & 0xff),
+		 (unsigned int)(col & 0xff));
+	ser_node(&z, box->node, 0, true);
+	for (i = 0; i < z.nrefs; i++)
+		free(z.refs[i]);
+
+	if (victim->d != NULL)
+		svgtiny_free(victim->d);
+	victim->box = box;
+	victim->node = box->node;
+	victim->w = w;
+	victim->h = h;
+	victim->seq = macsurf_reconvert_seq;
+	victim->used = ++cache_clock;
+	victim->d = NULL;
+
+	if (!z.out.oom && z.out.s != NULL) {
+		struct svgtiny_diagram *d = svgtiny_create();
+		if (d != NULL) {
+			svgtiny_code code = svgtiny_parse(d, z.out.s, z.out.n,
+				nsurl_access(html->base_url), w, h);
+			if (code == svgtiny_OK)
+				victim->d = d;
+			else
+				svgtiny_free(d);
+		}
+	}
+	free(z.out.s);
+	return victim->d;
+}
+
+/* exported interface documented in html/vb_inline_svg.h */
+bool vb_inline_svg_paint(struct box *box, int x, int y, int width,
+		int height, const struct redraw_context *ctx,
+		const html_content *html)
+{
+	struct svgtiny_diagram *d;
+	float transform[6];
+	unsigned int i;
+
+	if (box == NULL || box->node == NULL || width <= 0 || height <= 0 ||
+	    width > 4096 || height > 4096)
+		return true;
+	d = diagram_for(box, width, height, html);
+	if (d == NULL || d->width <= 0 || d->height <= 0)
+		return true;
+
+	transform[0] = (float)width / (float)d->width;
+	transform[1] = 0;
+	transform[2] = 0;
+	transform[3] = (float)height / (float)d->height;
+	transform[4] = x;
+	transform[5] = y;
+
+#define BGR(c) (((svgtiny_RED((c))) | (svgtiny_GREEN((c)) << 8) | \
+		 (svgtiny_BLUE((c)) << 16)))
+	for (i = 0; i != d->shape_count; i++) {
+		plot_style_t ps;
+
+		if (d->shape[i].path == NULL)
+			continue;	/* text: not drawn */
+		memset(&ps, 0, sizeof(ps));
+		if (d->shape[i].stroke == svgtiny_TRANSPARENT) {
+			ps.stroke_type = PLOT_OP_TYPE_NONE;
+			ps.stroke_colour = NS_TRANSPARENT;
+		} else {
+			ps.stroke_type = PLOT_OP_TYPE_SOLID;
+			ps.stroke_colour = BGR(d->shape[i].stroke);
+		}
+		ps.stroke_width = plot_style_int_to_fixed(
+				d->shape[i].stroke_width);
+		if (d->shape[i].fill == svgtiny_TRANSPARENT) {
+			ps.fill_type = PLOT_OP_TYPE_NONE;
+			ps.fill_colour = NS_TRANSPARENT;
+		} else {
+			ps.fill_type = PLOT_OP_TYPE_SOLID;
+			ps.fill_colour = BGR(d->shape[i].fill);
+		}
+		if (ctx->plot->path(ctx, &ps, d->shape[i].path,
+				d->shape[i].path_length, transform) !=
+				NSERROR_OK)
+			return false;
+	}
+#undef BGR
+	return true;
+}
+
+/* exported interface documented in html/vb_inline_svg.h */
+void vb_inline_svg_flush(void)
+{
+	int i;
+
+	for (i = 0; i < VB_SVG_CACHE; i++) {
+		if (cache[i].d != NULL)
+			svgtiny_free(cache[i].d);
+		memset(&cache[i], 0, sizeof(cache[i]));
+	}
+}
