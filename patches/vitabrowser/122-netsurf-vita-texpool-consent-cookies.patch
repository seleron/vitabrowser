+	(void)ctx;
+	for (k = 0; k < sizeof(kinds) / sizeof(kinds[0]); k++) {
+		size_t sz = (size + kinds[k].gran - 1) & ~(kinds[k].gran - 1);
+		void *base = NULL;
+		SceUID uid = sceKernelAllocMemBlock("vbtex", kinds[k].type,
+						    sz, NULL);
