+
+#ifndef TEXPOOL_H
+#define TEXPOOL_H
+
+#include <stddef.h>
+
+struct texpool_arena_ops {
+    /* Obtain a block of at least size bytes whose base is aligned to
+     * the pool's alignment. Returns the base or NULL. *cookie is
+     * passed back to put(). */
+    void *(*get)(void *ctx, size_t size, void **cookie);
+    /* Release a block obtained from get(). */
+    void (*put)(void *ctx, void *base, size_t size, void *cookie);
+    void *ctx;
+};
+
+struct texpool_stats {
+    unsigned arenas;          /* arenas currently held */
+    size_t arena_bytes;       /* total bytes of those arenas */
+    size_t used_bytes;        /* bytes in live allocations (rounded) */
+    size_t pending_bytes;     /* freed but not yet retired */
+    unsigned live_blocks;     /* live allocations */
+    unsigned pending_blocks;  /* freed, waiting for texpool_retire */
+    size_t largest_free;      /* largest free extent in any arena */
+};
+
+struct texpool;
+
+/* arena_size: size of a normal arena (e.g. 8 MiB).
+ * align: power of two; every returned pointer and every size is
+ * rounded to it (the Vita uses 1024 here).
+ * keep: how many completely empty normal arenas to keep instead of
+ * returning them with put() (the Vita uses 1).
+ * Returns NULL on bad arguments or out of memory. */
+struct texpool *texpool_create(const struct texpool_arena_ops *ops,
+                               size_t arena_size, size_t align,
+                               unsigned keep);
+
+/* Returns align-aligned memory of at least size bytes, or NULL.
+ * size 0 returns NULL. A request larger than arena_size / 2 gets a
+ * dedicated arena of exactly its rounded size, which is returned
+ * with put() as soon as that allocation is retired. Otherwise:
+ * first fit over the existing arenas in creation order; if none
+ * fits, get() a new normal arena; if get() fails, retire nothing
+ * and return NULL. */
+void *texpool_alloc(struct texpool *p, size_t size);
+
+/* Deferred free: the GPU may still read the memory, so it becomes
+ * reusable only after the next texpool_retire(). ptr NULL is a
+ * no-op. Freeing a pointer the pool did not return, or freeing
+ * twice, must be detected: do nothing and increment a counter
+ * readable with texpool_bad_frees(). */
+void texpool_free(struct texpool *p, void *ptr);
+
+/* The GPU has finished with everything submitted so far: every
+ * pending free becomes free space (coalesced with free neighbours).
+ * Dedicated arenas whose allocation was retired are put() back.
+ * Normal arenas that are now completely empty are put() back,
+ * except that up to keep of them stay. */
+void texpool_retire(struct texpool *p);
+
+void texpool_stats(const struct texpool *p, struct texpool_stats *s);
+unsigned long texpool_bad_frees(const struct texpool *p);
+
+/* Retires everything pending, then puts back every arena, live
+ * allocations or not, and frees the pool. */
+void texpool_destroy(struct texpool *p);
+
+#endif /* TEXPOOL_H */
