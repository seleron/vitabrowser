+static struct texpool *get_pool(void)
+{
+	static const struct texpool_arena_ops ops = {
+		arena_get, arena_put, NULL
+	};
+
+	if (pool == NULL)
+		pool = texpool_create(&ops, ARENA_SIZE, POOL_ALIGN, 1);
+	return pool;
+}
