+
+/**
+ * \file
+ * Vita frontend: a sub-allocator for GPU texture memory (vita/texpool.h).
+ * Written by the local pi agent from work order T1 (host-tested: 10
+ * checks incl. a 200000-operation soak under ASan/UBSan).
+ */
+
+#include "vita/texpool.h"
+
+#include <stdlib.h>
+#include <string.h>
+
+enum {
+    ST_FREE = 0,
+    ST_LIVE = 1,
+    ST_PENDING = 2
+};
+
+struct tpool_extent {
+    size_t off;
+    size_t size;
+    int state;
+};
+
+struct tpool_arena {
+    void *base;
+    size_t size;
+    void *cookie;
+    int dedicated;
+    size_t n;
+    struct tpool_extent *ex;
+};
+
+struct texpool {
+    struct texpool_arena_ops ops;
+    size_t arena_size;
+    size_t align;
+    unsigned keep;
+    size_t narenas;
+    struct tpool_arena *arenas;
+    unsigned long bad_frees;
+};
+
+static size_t round_up(size_t v, size_t a)
+{
+    return (v + a - 1) & ~(a - 1);
+}
+
+static int is_pow2(size_t v)
+{
+    return v != 0 && (v & (v - 1)) == 0;
+}
+
+static struct tpool_arena *arena_push(struct texpool *p,
+                                      void *base, size_t size,
+                                      void *cookie, int dedicated)
+{
+    struct tpool_arena *a;
+    struct tpool_arena *na =
+        (struct tpool_arena *)realloc(p->arenas,
+                                      (p->narenas + 1) *
+                                          sizeof(*p->arenas));
+    if (!na)
+        return NULL;
+    p->arenas = na;
+    a = &p->arenas[p->narenas];
+    a->base = base;
+    a->size = size;
+    a->cookie = cookie;
+    a->dedicated = dedicated;
+    a->n = 1;
+    a->ex = (struct tpool_extent *)malloc(sizeof(*a->ex));
+    if (!a->ex)
+        return NULL;	/* narenas was not incremented yet */
+    a->ex[0].off = 0;
+    a->ex[0].size = size;
+    a->ex[0].state = ST_FREE;
+    p->narenas++;
+    return a;
+}
+
+/* Remove arena i and release its bookkeeping. */
+static void arena_drop(struct texpool *p, size_t i)
+{
+    free(p->arenas[i].ex);
+    memmove(&p->arenas[i], &p->arenas[i + 1],
+            (p->narenas - i - 1) * sizeof(p->arenas[0]));
+    p->narenas--;
+}
+
+static void arena_return(struct texpool *p, size_t i)
+{
+    struct tpool_arena *a = &p->arenas[i];
+    p->ops.put(p->ops.ctx, a->base, a->size, a->cookie);
+    arena_drop(p, i);
+}
+
+/* Merge adjacent free extents in place. */
+static void coalesce(struct tpool_arena *a)
+{
+    size_t i, w = 0;
+    for (i = 0; i < a->n; i++) {
+        if (a->ex[i].state == ST_FREE && w > 0 &&
+            a->ex[w - 1].state == ST_FREE) {
+            a->ex[w - 1].size += a->ex[i].size;
+        } else {
+            a->ex[w++] = a->ex[i];
+        }
+    }
+    a->n = w;
+}
+
+static int arena_empty(const struct tpool_arena *a)
+{
+    return a->n == 1 && a->ex[0].state == ST_FREE &&
+           a->ex[0].off == 0 && a->ex[0].size == a->size;
+}
+
+struct texpool *texpool_create(const struct texpool_arena_ops *ops,
+                               size_t arena_size, size_t align,
+                               unsigned keep)
+{
+    struct texpool *p;
+    if (!ops || !ops->get || !ops->put || !is_pow2(align) ||
+        arena_size < align)
+        return NULL;
+    p = (struct texpool *)calloc(1, sizeof(*p));
+    if (!p)
+        return NULL;
+    p->ops = *ops;
+    p->arena_size = arena_size;
+    p->align = align;
+    p->keep = keep;
+    return p;
+}
+
+void *texpool_alloc(struct texpool *p, size_t size)
+{
+    size_t r;
+    size_t i;
+
+    if (!p || size == 0)
+        return NULL;
+    r = round_up(size, p->align);
+
+    if (r > p->arena_size / 2) {
+        /* Dedicated arena of exactly the rounded size. */
+        void *cookie = NULL;
+        void *base = p->ops.get(p->ops.ctx, r, &cookie);
+        struct tpool_arena *a;
+        if (!base)
+            return NULL;
+        a = arena_push(p, base, r, cookie, 1);
+        if (!a) {
+            p->ops.put(p->ops.ctx, base, r, cookie);
+            return NULL;
+        }
+        a->ex[0].state = ST_LIVE;
+        return base;
+    }
+
+    /* First fit over existing arenas in creation order. */
+    for (i = 0; i < p->narenas; i++) {
+        struct tpool_arena *a = &p->arenas[i];
+        size_t j;
+        for (j = 0; j < a->n; j++) {
+            if (a->ex[j].state == ST_FREE && a->ex[j].size >= r) {
+                size_t off = a->ex[j].off;
+                size_t rem = a->ex[j].size - r;
+                a->ex[j].size = r;
+                a->ex[j].state = ST_LIVE;
+                if (rem) {
+                    struct tpool_extent *nx =
+                        (struct tpool_extent *)realloc(
+                            a->ex, (a->n + 1) * sizeof(*a->ex));
+                    if (!nx) {
+                        /* Undo the split. */
+                        a->ex[j].size = r + rem;
+                        a->ex[j].state = ST_FREE;
+                        return NULL;
+                    }
+                    a->ex = nx;
+                    /* Shift the trailing extents down to make room. */
+                    memmove(&a->ex[j + 2], &a->ex[j + 1],
+                            (a->n - j - 1) * sizeof(*a->ex));
+                    a->ex[j + 1].off = off + r;
+                    a->ex[j + 1].size = rem;
+                    a->ex[j + 1].state = ST_FREE;
+                    a->n++;
+                }
+                return (char *)a->base + off;
+            }
+        }
+    }
+
+    {
+        void *cookie = NULL;
+        void *base = p->ops.get(p->ops.ctx, p->arena_size, &cookie);
+        struct tpool_arena *a;
+        if (!base)
+            return NULL;
+        a = arena_push(p, base, p->arena_size, cookie, 0);
+        if (!a) {
+            p->ops.put(p->ops.ctx, base, p->arena_size, cookie);
+            return NULL;
+        }
+        return texpool_alloc(p, size);
+    }
+}
+
+void texpool_free(struct texpool *p, void *ptr)
+{
+    size_t i, j;
+    if (!p || !ptr)
+        return;
+    for (i = 0; i < p->narenas; i++) {
+        struct tpool_arena *a = &p->arenas[i];
+        for (j = 0; j < a->n; j++) {
+            /* Allocations always start at an extent's start, so a
+             * pointer strictly inside an extent is foreign. */
+            if (a->ex[j].state == ST_LIVE &&
+                ptr == (char *)a->base + a->ex[j].off) {
+                a->ex[j].state = ST_PENDING;
+                return;
+            }
+        }
+    }
+    p->bad_frees++;
+}
+
+void texpool_retire(struct texpool *p)
+{
+    size_t i, j;
+    unsigned kept;
+
+    if (!p)
+        return;
+
+    /* Pending becomes free, then coalesce. */
+    for (i = 0; i < p->narenas; i++) {
+        struct tpool_arena *a = &p->arenas[i];
+        for (j = 0; j < a->n; j++)
+            if (a->ex[j].state == ST_PENDING)
+                a->ex[j].state = ST_FREE;
+        coalesce(a);
+    }
+
+    /* Dedicated arenas whose allocation was retired go back. */
+    for (i = 0; i < p->narenas; i++)
+        if (p->arenas[i].dedicated && arena_empty(&p->arenas[i]))
+            arena_return(p, i--);
+
+    /* Normal arenas that are completely empty go back, keeping the
+     * newest up to keep. */
+    for (kept = 0, i = 0; i < p->narenas; i++)
+        if (!p->arenas[i].dedicated && arena_empty(&p->arenas[i]))
+            kept++;
+    for (i = 0; i < p->narenas && kept > p->keep; i++)
+        if (!p->arenas[i].dedicated && arena_empty(&p->arenas[i])) {
+            arena_return(p, i--);
+            kept--;
+        }
+}
+
+void texpool_stats(const struct texpool *p, struct texpool_stats *s)
+{
+    size_t i, j;
+    if (!p || !s)
+        return;
+    memset(s, 0, sizeof(*s));
+    for (i = 0; i < p->narenas; i++) {
+        struct tpool_arena *a = &p->arenas[i];
+        s->arena_bytes += a->size;
+        for (j = 0; j < a->n; j++) {
+            struct tpool_extent *e = &a->ex[j];
+            switch (e->state) {
+            case ST_LIVE:
+                s->used_bytes += e->size;
+                s->live_blocks++;
+                break;
+            case ST_PENDING:
+                s->pending_bytes += e->size;
+                s->pending_blocks++;
+                break;
+            case ST_FREE:
+                if (e->size > s->largest_free)
+                    s->largest_free = e->size;
+                break;
+            }
+        }
+    }
+    s->arenas = (unsigned)p->narenas;
+}
+
+unsigned long texpool_bad_frees(const struct texpool *p)
+{
+    return p ? p->bad_frees : 0;
+}
+
+void texpool_destroy(struct texpool *p)
+{
+    size_t i;
+    if (!p)
+        return;
+    texpool_retire(p);
+    for (i = 0; i < p->narenas; i++) {
+        struct tpool_arena *a = &p->arenas[i];
+        p->ops.put(p->ops.ctx, a->base, a->size, a->cookie);
+        free(a->ex);
+    }
+    free(p->arenas);
+    free(p);
+}
