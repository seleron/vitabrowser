+	t->w = (unsigned int)w;
+	t->h = (unsigned int)h;
+	t->stride = (((unsigned int)w + 7) & ~7u) * 4;
+	t->data = px;
+#else
+	if (sceGxmTextureInitLinear(&t->gxm_tex, px,
+			SCE_GXM_TEXTURE_FORMAT_A8B8G8R8,
+			(unsigned int)w, (unsigned int)h, 0) < 0) {
+		free(t);
+		return NULL;
+	}
+	t->data_UID = -1;
+	t->palette_UID = -1;
+	t->depth_UID = -1;
+#endif
+	return t;
+}
