+static void *arena_get(void *ctx, size_t size, void **cookie)
+{
+	static const struct { SceKernelMemBlockType type; size_t gran; } kinds[] = {
+		{ SCE_KERNEL_MEMBLOCK_TYPE_USER_CDRAM_RW, 256 * 1024 },
+		{ SCE_KERNEL_MEMBLOCK_TYPE_USER_RW_UNCACHE, 4 * 1024 },
+	};
+	size_t k;
