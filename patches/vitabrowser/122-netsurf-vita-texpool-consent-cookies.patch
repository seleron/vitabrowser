+		    sceGxmMapMemory(base, sz, SCE_GXM_MEMORY_ATTRIB_READ |
+				    SCE_GXM_MEMORY_ATTRIB_WRITE) < 0) {
+			sceKernelFreeMemBlock(uid);
+			continue;
+		}
+		*cookie = (void *)(intptr_t)uid;
+		vita_diag_log("bitmap: arena %u KB (%s), uid 0x%x",
+			      (unsigned)(sz / 1024), k == 0 ? "cdram" : "main",
+			      (unsigned)uid);
+		return base;
+	}
+	return NULL;
+}
+
+static void arena_put(void *ctx, void *base, size_t size, void *cookie)
+{
+	(void)ctx; (void)size;
+	sceGxmUnmapMemory(base);
+	sceKernelFreeMemBlock((SceUID)(intptr_t)cookie);
+}
+#endif
