+/**
+ * Google's and YouTube's cookie-consent walls are full-screen dialogs
+ * driven by their largest scripts; on a Vita they cost a minute before the
+ * page is usable, when they work at all. Their answer is a cookie, SOCS:
+ * "CAI" is "Reject all" (only the essential cookies). Seed it once per
+ * site, unless the jar already has an answer (a choice made on the page
+ * replaces it).
+ */
+static void seed_consent_cookies(void)
+{
+	static const char *const sites[][2] = {
+		{ "https://www.google.com/", ".google.com" },
+		{ "https://www.youtube.com/", ".youtube.com" },
+		{ "https://www.google.ie/", ".google.ie" },
+		{ "https://www.google.co.uk/", ".google.co.uk" },
+	};
+	size_t i;
+
+	for (i = 0; i < sizeof(sites) / sizeof(sites[0]); i++) {
+		nsurl *url;
+		char *have, hdr[160];
+
+		if (nsurl_create(sites[i][0], &url) != NSERROR_OK)
+			continue;
+		have = urldb_get_cookie(url, true);
+		if (have == NULL || strstr(have, "SOCS=") == NULL) {
+			snprintf(hdr, sizeof(hdr), "SOCS=CAI; Domain=%s; "
+				 "Path=/; Expires=Fri, 01 Jan 2038 00:00:00 GMT;"
+				 " Secure", sites[i][1]);
+			urldb_set_cookie(hdr, url, NULL);
+			vita_diag_log("cookies: consent answer seeded for %s",
+				      sites[i][1]);
+		}
+		free(have);
+		nsurl_unref(url);
+	}
+}
