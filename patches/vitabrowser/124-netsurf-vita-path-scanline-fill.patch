@@ -578,18 +580,99 @@ static void path_xform(const float t[6], float x, float y, float *ox,
 	*oy = t[1] * x + t[3] * y + t[5];
 }
 
-/** Paint one flattened path segment list (fill then stroke). */
-static void path_flush(const plot_style_t *style, float *xy, unsigned int n,
-		       bool closed)
+/* SVG paths: a fill covers the WHOLE path (every subpath together, so a
+ * hole wound the other way stays empty: the inside of an "o", a ring),
+ * by the nonzero rule, through the scanline filler (vita/pathfill.c).
+ * The old fan per subpath was exact only for convex shapes: concave icons
+ * came out as blobs. Spans that repeat on the next row merge into one
+ * rectangle, so an icon costs a few draws, not one per pixel row. */
+
+#define PATH_PENDING 16
+
+struct span_merge {
+	int x0[PATH_PENDING], x1[PATH_PENDING], y0[PATH_PENDING],
+		y1[PATH_PENDING];
+	int n;
+	colour c;
+};
+
+static void span_flush_one(struct span_merge *m, int i)
 {
-	if (n < 2)
-		return;
-	if (style->fill_type != PLOT_OP_TYPE_NONE && n >= 3)
-		vita_plot_fan(xy, n, vita_plot_rgba(style->fill_colour,
-						    VITA_BUCKET_SOLID));
-	if (style->stroke_type != PLOT_OP_TYPE_NONE)
-		stroke_polyline(xy, n, closed, stroke_px(style),
-				style->stroke_colour);
+	vita_plot_fill_rect(m->x0[i], m->y0[i], m->x1[i], m->y1[i], m->c,
+			    VITA_BUCKET_SOLID);
+	m->n--;
+	m->x0[i] = m->x0[m->n]; m->x1[i] = m->x1[m->n];
+	m->y0[i] = m->y0[m->n]; m->y1[i] = m->y1[m->n];
+}
+
+static void span_cb(void *ctx, int y, int x0, int x1)
+{
+	struct span_merge *m = ctx;
+	int i;
+
+	for (i = 0; i < m->n; i++) {
+		if (m->y1[i] < y) {		/* a row was skipped: done */
+			span_flush_one(m, i--);
+			continue;
+		}
+		if (m->x0[i] == x0 && m->x1[i] == x1 && m->y1[i] == y) {
+			m->y1[i] = y + 1;
+			return;
+		}
+	}
+	if (m->n == PATH_PENDING)
+		span_flush_one(m, 0);
+	m->x0[m->n] = x0; m->x1[m->n] = x1;
+	m->y0[m->n] = y; m->y1[m->n] = y + 1;
+	m->n++;
+}
+
+struct path_pts {
+	float *xy;		/* all subpaths' points */
+	int *counts;		/* points per subpath */
+	bool *closed;
+	unsigned int n, size;	/* points */
+	int nsub, subsize;
+};
+
+static bool pts_point(struct path_pts *pp, float x, float y)
+{
+	if (pp->nsub == 0 || pp->n >= 65536)
+		return false;
+	if (pp->n == pp->size) {
+		unsigned int size = pp->size ? pp->size * 2 : 256;
+		float *xy = realloc(pp->xy, size * 2 * sizeof(float));
+		if (xy == NULL)
+			return false;
+		pp->xy = xy;
+		pp->size = size;
+	}
+	pp->xy[pp->n * 2] = x;
+	pp->xy[pp->n * 2 + 1] = y;
+	pp->n++;
+	pp->counts[pp->nsub - 1]++;
+	return true;
+}
+
+static bool pts_subpath(struct path_pts *pp)
+{
+	if (pp->nsub == pp->subsize) {
+		int size = pp->subsize ? pp->subsize * 2 : 16;
+		int *c = realloc(pp->counts, size * sizeof(int));
+		bool *cl;
+		if (c == NULL)
+			return false;
+		pp->counts = c;
+		cl = realloc(pp->closed, size * sizeof(bool));
+		if (cl == NULL)
+			return false;
+		pp->closed = cl;
+		pp->subsize = size;
+	}
+	pp->counts[pp->nsub] = 0;
+	pp->closed[pp->nsub] = false;
+	pp->nsub++;
+	return true;
 }
 
