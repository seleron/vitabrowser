+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+ * GNU General Public License for more details.
+ *
+ * You should have received a copy of the GNU General Public License
+ * along with this program.  If not, see <http://www.gnu.org/licenses/>.
+ */
+
+#ifndef POLYFILL_H
+#define POLYFILL_H
+
+#include <stddef.h>
+
+enum polyfill_rule { POLYFILL_NONZERO = 0, POLYFILL_EVENODD = 1 };
+
+/* Receives one span: pixels x0 .. x1-1 on row y (x0 < x1). */
+typedef void (*polyfill_span_fn)(void *ctx, int y, int x0, int x1);
+
+/*
+ * Fill a shape made of nsub closed polygons ("subpaths").
+ * xy holds every point, x then y, subpath after subpath; counts[i]
+ * is the number of points in subpath i (each subpath is implicitly
+ * closed: its last point joins its first). A subpath with fewer than
+ * 3 points contributes nothing. Coordinates are floats in pixels.
+ *
+ * A pixel (px, py) is inside when its CENTRE (px + 0.5, py + 0.5) is
+ * inside the shape under the fill rule. Edges are treated half-open
+ * so that a centre lying exactly on an edge belongs to exactly one of
+ * two shapes sharing that edge: a point is inside if the ray to the
+ * right crosses edges with winding != 0 (nonzero) / odd count
+ * (evenodd), counting an edge from (x0,y0) to (x1,y1) when
+ * min(y0,y1) <= cy < max(y0,y1).
+ *
+ * Only pixels inside the clip rectangle [cx0, cx1) x [cy0, cy1) are
+ * reported. Spans on a row are reported left to right, never
+ * overlapping, adjacent spans merged. Rows are reported top to
+ * bottom.
+ *
+ * Returns 0 on success, -1 if memory ran out (nothing more is
+ * reported after that).
+ */
+int polyfill(const float *xy, const int *counts, int nsub,
+             enum polyfill_rule rule,
+             int cx0, int cy0, int cx1, int cy1,
+             polyfill_span_fn fn, void *ctx);
+
+#endif /* POLYFILL_H */
