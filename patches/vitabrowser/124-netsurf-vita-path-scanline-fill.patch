# netsurf (vita frontend): SVG path fills by scanline with the nonzero rule (pathfill.c)
#
# The path plotter filled each subpath as a triangle fan from its first
# point, exact only for convex shapes: concave icons were blobs and holes
# (the inside of an "o", a ring) were filled in -- visible now that inline
# SVG paints (patch 121; Google's logo). vita_plot_path now flattens every
# subpath first, fills the whole path once through a scanline filler with
# the nonzero rule (so a hole wound the other way stays empty), merges spans
# that repeat on the next row into rectangles, and strokes each subpath as
# before.
#
# pathfill.c was written by the local pi agent (work order T3; host-tested
# against a brute-force winding-number reference: 18 checks incl. 2000
# fuzzed shapes, under ASan/UBSan; a winding disarm fails 3 of them) and
# reviewed; the crossing x is clamped before its int conversion. The file
# list in frontends/vita/Makefile is in patch 122.
diff --git a/frontends/vita/pathfill.c b/frontends/vita/pathfill.c
new file mode 100644
index 000000000..6b342cbe8
--- /dev/null
+++ b/frontends/vita/pathfill.c
@@ -0,0 +1,171 @@
+/*
