+ * along with this program.  If not, see <http://www.gnu.org/licenses/>.
+ */
+
+/**
+ * \file
+ * Vita frontend: scanline polygon filler for SVG paths (vita/pathfill.h).
+ * Written by the local pi agent from work order T3 (host-tested against a
+ * brute-force winding reference: 18 checks incl. 2000 fuzzed shapes, under
+ * ASan/UBSan) and reviewed.
+ */
+
+#include "vita/pathfill.h"
+#include <stdlib.h>
+#include <math.h>
+
+#define MAX_POINTS 1000000
+
+typedef struct {
+    float ax, ay, bx, by;   /* original endpoints (non-horizontal edge) */
+    float ymin, ymax;       /* min / max y, half-open interval for cy */
+    int   delta;            /* winding contribution: +1 up, -1 down */
+} Edge;
+
+typedef struct {
+    int px;      /* pixel index of the crossing: ceil(x - 0.5) */
+    int delta;   /* winding delta of the edge that made it */
+} Cross;
+
+static int cmp_cross(const void *a, const void *b)
+{
+    const Cross *ca = (const Cross *)a;
+    const Cross *cb = (const Cross *)b;
+    if (ca->px < cb->px) return -1;
+    if (ca->px > cb->px) return 1;
+    return 0;
+}
+
+static int is_finite(float v)
+{
+    return !(v != v || v == INFINITY || v == -INFINITY);
+}
+
+int polyfill(const float *xy, const int *counts, int nsub,
+             enum polyfill_rule rule,
+             int cx0, int cy0, int cx1, int cy1,
+             polyfill_span_fn fn, void *ctx)
+{
+    if (nsub <= 0 || cx0 >= cx1 || cy0 >= cy1)
+        return 0;
+
+    /* Total point count guard: beyond the cap report memory failure. */
+    long total = 0;
+    for (int i = 0; i < nsub; i++) {
+        if (counts[i] < 0) return 0; /* defensive: never index past xy */
+        total += counts[i];
+    }
+    if (total > MAX_POINTS)
+        return -1;
+
+    size_t cap = (size_t)(total > 0 ? total : 1);
+    Edge  *edges = malloc(cap * sizeof(Edge));
+    Cross *cross = malloc(cap * sizeof(Cross));
+    if (!edges || !cross) {
+        free(edges);
+        free(cross);
+        return -1;
+    }
+
+    int nedges = 0;
+    float gmin = 1e30f, gmax = -1e30f;
+
+    const float *p = xy;
+    for (int i = 0; i < nsub; i++) {
+        int n = counts[i];
+        if (n < 3) { p += n * 2; continue; }
+
+        /* Ignore the whole subpath if any coordinate is NaN/inf. */
+        int ok = 1;
+        for (int k = 0; k < n; k++) {
+            if (!is_finite(p[k*2]) || !is_finite(p[k*2+1])) { ok = 0; break; }
+        }
+        if (!ok) { p += n * 2; continue; }
+
+        for (int k = 0; k < n; k++) {
+            const float *a = p + k * 2;
+            const float *b = p + ((k + 1) % n) * 2;
+            if (a[1] == b[1]) continue; /* skip horizontal edges */
+
+            Edge e;
+            e.ax = a[0]; e.ay = a[1];
+            e.bx = b[0]; e.by = b[1];
+            if (e.by < e.ay) { e.ymin = e.by; e.ymax = e.ay; e.delta = +1; }
+            else             { e.ymin = e.ay; e.ymax = e.by; e.delta = -1; }
+            edges[nedges++] = e;
+            if (e.ymin < gmin) gmin = e.ymin;
+            if (e.ymax > gmax) gmax = e.ymax;
+        }
+        p += n * 2;
+    }
+
+    if (nedges == 0) { free(edges); free(cross); return 0; }
+
+    /* Rows whose centre cy = py+0.5 falls inside [gmin, gmax). */
+    int row_lo = (int)ceilf(gmin - 0.5f);
+    int row_hi = (int)floorf(gmax - 0.5f);
+    if (row_lo < cy0) row_lo = cy0;
+    if (row_hi >= cy1) row_hi = cy1 - 1;
+
+    for (int py = row_lo; py <= row_hi; py++) {
+        float cy = (float)py + 0.5f;
+        int nc = 0;
+
+        for (int i = 0; i < nedges; i++) {
+            Edge *e = &edges[i];
+            if (e->ymin <= cy && cy < e->ymax) {
+                float x = e->ax + (e->bx - e->ax) * (cy - e->ay) / (e->by - e->ay);
+                if (x < -1e6f) x = -1e6f;   /* keep the int conversion defined */
+                if (x > 1e6f) x = 1e6f;
+                int px = (int)ceilf(x - 0.5f);
+                cross[nc].px = px;
+                cross[nc].delta = e->delta;
+                nc++;
+            }
+        }
+
+        if (nc == 0)
+            continue;
+
+        qsort(cross, (size_t)nc, sizeof(Cross), cmp_cross);
+
+        int w = 0;
+        int span_start = -1;
+
+        for (int i = 0; i < nc; i++) {
+            int neww = w + cross[i].delta;
+            int was_in = (rule == POLYFILL_NONZERO) ? (w != 0) : (w & 1);
+            int is_in  = (rule == POLYFILL_NONZERO) ? (neww != 0) : (neww & 1);
+
+            if (was_in && !is_in) {
+                int x0 = span_start, x1 = cross[i].px;
+                if (x0 < cx0) x0 = cx0;
+                if (x1 > cx1) x1 = cx1;
+                if (x0 < x1)
+                    fn(ctx, py, x0, x1);
+                span_start = -1;
+            } else if (!was_in && is_in) {
+                span_start = cross[i].px;
+            }
+            w = neww;
+        }
+    }
+
+    free(edges);
+    free(cross);
+    return 0;
+}
