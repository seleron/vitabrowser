+ * postMessage): struct browser_window's jsheap/name/parent fields for
+ * resolving an iframe realm's parent and child windows from the box tree.
+ * frontends/vita/js_platform.c already pulls browser_private.h in from a
+ * non-desktop directory, so the include path is established.  The browser_
+ * window enums/typedefs it uses come from netsurf/browser_window.h, which
+ * must be included first (frontends/vita/js_platform.c does the same). */
+#include "netsurf/browser_window.h"
+#include "desktop/browser_private.h"
 /* fixes1013 - corestring_dom_scroll / _resize for the scroll/resize fan-out. */
 #include "utils/corestrings.h"
 #include "utils/libdom.h"
@@ -105,6 +114,20 @@ struct jsheap {
 	 * imports. The module loader callback checks this list before trying the
 	 * disk cache.  Populated by js_exec_module for inline scripts. */
 	struct module_registry *module_reg;
+	/* VitaBrowser: the parent browsing context's heap, for an iframe
+	 * realm (set from frames.c when the iframe browser window is created,
+	 * where both the child and parent heaps already exist).  Enables the
+	 * cross-realm window.parent / iframe.contentWindow postMessage bridge:
+	 * only C char* JSON ever crosses the runtime boundary here -- never a
+	 * QuickJS JSValue, which is runtime-specific and would be exactly the
+	 * cross-RT free the fixes861/875/888/1070/1117b post-mortems forbid. */
+	struct jsheap *parent_heap;
+	/* The iframe name (empty for the top-level realm, NULL until the name is
+	 * known).  frames.c sets it when the iframe browser window is created;
+	 * __vitaFrameRealmName() exposes it to the polyfill so a frame realm can
+	 * tell it IS a frame (and to what name) and the parent realm's
