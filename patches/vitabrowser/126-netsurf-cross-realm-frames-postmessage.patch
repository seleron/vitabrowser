 struct jsthread {
@@ -2610,6 +2633,506 @@ static void qjs_set_content(struct jsheap *heap, struct content *c)
 	}
 }
 
+/* =========================================================================
+ * VitaBrowser: cross-realm postMessage (iframe <-> parent).
+ *
+ * Every browsing context owns its OWN QuickJS JSRuntime (js_newheap runs per
+ * browser_window AND per iframe), so a parent window object cannot be handed
+ * to an iframe realm: a QuickJS JSValue is runtime-specific, and crossing
+ * one is the exact class of bug the fixes861/875/888/1070/1117b crash
+ * post-mortems document (a rt_OLD value freed against rt_NEW walks rt_NEW's
+ * shape table into unmapped memory).  The only safe currency across runtimes
+ * is a C char*.
+ *
+ * So: the JS side serializes the message (JSON) and hands it to a native
+ * function invoked with the SENDER'S ctx (which owns the payload JSValue).
+ * C copies it to a heap char* -- the sole cross-realm transfer -- and
+ * enqueues.  macsurf_qjs_pump_all() drains the queue and, in the TARGET
+ * realm, evaluates a dispatch built entirely inside that realm (fresh
+ * string, fresh MessageEvent, dispatch; every value freed against the
+ * target runtime).  The MessageEvent's `source` is the target realm's OWN
+ * shim window for the peer frame, fetched from its globals by name.
+ *
+ * This is what Google Sign-In / hCaptcha / OAuth flows need: a real
+ * postMessage round-trip between the top document and an iframe.
+ * Deliberately minimal: JSON-serializable data, one hop, parent<->child.
+ * ====================================================================== */
+/* Forward: defined further down (element wrapper section); the xrealm
+ * natives below read the DOM node from their `this` through it. */
+static dom_node *qjs_get_node(JSValueConst val);
+struct qjs_xrealm_msg {
+	struct jsheap *dest;		/* realm to deliver into (validated at drain) */
+	char *payload;			/* JSON text, C-owned */
+	char *origin;			/* sender document URL (MessageEvent.origin) */
+	char *source_label;		/* name of the peer shim window for .source */
+	struct qjs_xrealm_msg *next;
+};
+#define QJS_XREALM_QUEUE_MAX 32
+static struct qjs_xrealm_msg *g_qjs_xrealm_head = NULL;
+static struct qjs_xrealm_msg **g_qjs_xrealm_tail = &g_qjs_xrealm_head;
+static int g_qjs_xrealm_count = 0;
+
+static void qjs_xrealm_enqueue(struct jsheap *dest, const char *payload,
+		const char *origin, const char *source_label)
+{
+	struct qjs_xrealm_msg *m;
+	if (payload == NULL || dest == NULL) return;
+	if (g_qjs_xrealm_count >= QJS_XREALM_QUEUE_MAX) {
+		macsurf_debug_log_writef("WORK xrealm: queue full, drop");
+		return;
+	}
+	m = calloc(1, sizeof(*m));
+	if (m == NULL) return;
+	m->dest = dest;
+	m->payload = strdup(payload);
+	m->origin = origin != NULL ? strdup(origin) : NULL;
+	m->source_label = source_label != NULL ? strdup(source_label) : NULL;
+	if (m->payload == NULL) {
+		free(m->origin); free(m->source_label); free(m); return;
+	}
+	*g_qjs_xrealm_tail = m;
+	g_qjs_xrealm_tail = &m->next;
+	g_qjs_xrealm_count++;
+	macsurf_debug_log_writef("WORK xrealm: queue +1 (count=%d)",
+			g_qjs_xrealm_count);
+}
+
+/* A realm is going away: drop the messages addressed to it, before its
+ * jsheap is freed (the queue holds raw pointers). */
+static void qjs_xrealm_purge(struct jsheap *heap)
+{
+	struct qjs_xrealm_msg **pp = &g_qjs_xrealm_head, *m;
+
+	g_qjs_xrealm_tail = &g_qjs_xrealm_head;
+	while ((m = *pp) != NULL) {
+		if (m->dest == heap) {
+			*pp = m->next;
+			g_qjs_xrealm_count--;
+			free(m->payload); free(m->origin);
+			free(m->source_label); free(m);
+			continue;
+		}
+		g_qjs_xrealm_tail = &m->next;
+		pp = &m->next;
+	}
+}
+
+/* --- MessageEvent helpers (all run in the TARGET realm) ------------------ */
+
+/* No-op method: postMessage/close/stopPropagation on the event.source
+ * stand-in.  Never throws. */
+static JSValue
+qjs_xrealm_noop_fn(JSContext *ctx, JSValueConst this_val,
+		int argc, JSValueConst *argv)
+{
+	(void)ctx; (void)this_val; (void)argc; (void)argv;
+	return JS_UNDEFINED;
+}
+
+/* preventDefault() on the C-built MessageEvent: flips defaultPrevented. */
+static JSValue
+qjs_xrealm_preventdefault_fn(JSContext *ctx, JSValueConst this_val,
+		int argc, JSValueConst *argv)
+{
+	(void)argc; (void)argv;
+	if (JS_IsObject(this_val)) {
+		JS_SetPropertyStr(ctx, this_val, "defaultPrevented", JS_TRUE);
+	}
+	return JS_UNDEFINED;
+}
+
+/* toString() on the event.source stand-in: returns __vitaSourceLabel. */
+static JSValue
+qjs_xrealm_label_tostring_fn(JSContext *ctx, JSValueConst this_val,
+		int argc, JSValueConst *argv)
+{
+	(void)argc; (void)argv;
+	if (JS_IsObject(this_val)) {
+		JSValue l = JS_GetPropertyStr(ctx, this_val, "__vitaSourceLabel");
+		if (!JS_IsException(l) && JS_IsString(l)) {
+			return l; /* caller owns the reference */
+		}
+		if (!JS_IsException(l)) JS_FreeValue(ctx, l);
+	}
+	return JS_NewString(ctx, "");
+}
+
+/* Deliver queued messages into their target realms.  Called from
+ * macsurf_qjs_pump_all().  The event object is built entirely in C inside
+ * the TARGET runtime (a JSValue never crosses a runtime boundary); the
+ * page-controlled payload arrives as a JS_NewString argument, never
+ * spliced into source text.  Trust level of a timer callback: pump_all
+ * runs on the event loop, between page tasks. */
+static void qjs_xrealm_drain(void)
+{
+	struct qjs_xrealm_msg *m;
+	while ((m = g_qjs_xrealm_head) != NULL) {
+		struct jsheap *dest = m->dest;
+		g_qjs_xrealm_head = m->next;
+		g_qjs_xrealm_count--;
+		/* the tail moves only when the queue empties (a listener
+		 * below may enqueue a reply onto the live tail) */
+		if (g_qjs_xrealm_head == NULL)
+			g_qjs_xrealm_tail = &g_qjs_xrealm_head;
+		if (dest == NULL || dest->ctx == NULL) {
+			/* destination realm gone (navigation/teardown) */
+			free(m->payload); free(m->origin);
+			free(m->source_label); free(m);
+			continue;
+		}
+		{
+			JSContext *tctx = dest->ctx;
+			JSValue ev, w, s, arg, res, exc;
+			int delivered = 0;
+			/* Build the MessageEvent in the target runtime. */
+			ev = JS_NewObject(tctx);
+			if (JS_IsException(ev)) {
+				JS_FreeValue(tctx, JS_GetException(tctx));
+				free(m->payload); free(m->origin);
+				free(m->source_label); free(m);
+				continue;
+			}
+			w = JS_GetGlobalObject(tctx);
+			JS_SetPropertyStr(tctx, ev, "type", JS_NewString(tctx, "message"));
+			/* JS_SetPropertyStr takes a reference: w is still ours */
+			JS_SetPropertyStr(tctx, ev, "target", JS_DupValue(tctx, w));
+			JS_SetPropertyStr(tctx, ev, "currentTarget",
+					JS_DupValue(tctx, w));
+			JS_SetPropertyStr(tctx, ev, "bubbles", JS_FALSE);
+			JS_SetPropertyStr(tctx, ev, "cancelable", JS_FALSE);
+			JS_SetPropertyStr(tctx, ev, "composed", JS_FALSE);
+			JS_SetPropertyStr(tctx, ev, "defaultPrevented", JS_FALSE);
+			/* The payload: JSON text (the sender's shim always
+			 * stringifies), parsed into a fresh value IN the target
+			 * runtime -- the structured-clone result the page expects.
+			 * Unparseable text arrives as a string. */
+			{
+				const char *pl = m->payload != NULL ? m->payload : "null";
+				arg = JS_ParseJSON(tctx, pl, strlen(pl), "<xrealm>");
+				if (JS_IsException(arg)) {
+					JS_FreeValue(tctx, JS_GetException(tctx));
+					arg = JS_NewString(tctx, pl);
+				}
+			}
+			JS_SetPropertyStr(tctx, ev, "data", arg);
+			{
+				JSValue o = JS_NewString(tctx,
+						m->origin != NULL ? m->origin : "");
+				JS_SetPropertyStr(tctx, ev, "origin", o);
+			}
+			/* event.source: a window-like stand-in.  A real cross-realm
+			 * window object is unhandable (a JSValue is runtime-specific);
+			 * GSI/hCaptcha only use source.toString() / postMessage(). */
+			{
+				JSValue src = JS_NewObject(tctx);
+				JSValue f = JS_NewCFunction(tctx,
+						qjs_xrealm_noop_fn, "postMessage", 1);
+				JS_SetPropertyStr(tctx, src, "postMessage", f);
+				f = JS_NewCFunction(tctx, qjs_xrealm_noop_fn, "close", 0);
+				JS_SetPropertyStr(tctx, src, "close", f);
+				JS_SetPropertyStr(tctx, src, "toString",
+						JS_NewCFunction(tctx,
+							qjs_xrealm_label_tostring_fn, "toString", 0));
+				JS_SetPropertyStr(tctx, src, "__vitaSourceLabel",
+						JS_NewString(tctx,
+							m->source_label != NULL
+								? m->source_label : ""));
+				JS_SetPropertyStr(tctx, ev, "source", src);
+			}
+			arg = JS_NewArray(tctx);
+			JS_SetPropertyStr(tctx, ev, "ports", arg);
+			{
+				JSValue f = JS_NewCFunction(tctx, qjs_xrealm_noop_fn,
+						"stopPropagation", 0);
+				JS_SetPropertyStr(tctx, ev, "stopPropagation", f);
+			}
+			{
+				JSValue f = JS_NewCFunction(tctx,
+						qjs_xrealm_preventdefault_fn, "preventDefault", 0);
+				JS_SetPropertyStr(tctx, ev, "preventDefault", f);
+			}
+			/* dispatch: the target realm's own window.dispatchEvent. */
+			{
+				JSValue d = JS_GetPropertyStr(tctx, w, "dispatchEvent");
+				if (!JS_IsException(d) && JS_IsFunction(tctx, d)) {
+					res = JS_Call(tctx, d, w, 1, &ev);
+					if (JS_IsException(res)) {
+						exc = JS_GetException(tctx);
+						qjs_log_exc(tctx, exc, "xrealm", "<xrealm-dispatch>");
+						JS_FreeValue(tctx, exc);
+					}
+					JS_FreeValue(tctx, res);
+					delivered = 1;
+				}
+				JS_FreeValue(tctx, d);
+			}
+			JS_FreeValue(tctx, ev);
+			JS_FreeValue(tctx, w);
+			if (!delivered) {
+				macsurf_debug_log_writef("WORK xrealm: no dispatchEvent, drop");
+			}
+		}
+		free(m->payload); free(m->origin); free(m->source_label); free(m);
+	}
+}
+
+/* --- native senders ------------------------------------------------------
+ * Invoked from the polyfill's shim windows.  Each runs in the SENDER'S
+ * runtime (the JSValue payload is freed here, against that runtime -- never
+ * in the destination), and only the C char* payload crosses realms. */
+
+/* Walk a realm's layout box tree collecting every box with a live iframe
+ * window (capped).  Layout is only rebuilt during the reconvert window,
+ * which pump_all's freeze gate keeps clear of JS execution, so the tree is
+ * stable for the duration of a page task. */
+#define QJS_XREALM_MAX_IFRAMES 16
+struct qjs_xrealm_iframes {
+	struct box *boxes[QJS_XREALM_MAX_IFRAMES];
+	int n;
+};
+static void qjs_xrealm_layout_walk(struct box *root, int depth,
+		struct qjs_xrealm_iframes *out)
+{
+	struct box *b;
+	if (root == NULL || depth > 512) return;
+	b = root;
+	while (b != NULL) {
+		if (b->iframe != NULL && out->n < QJS_XREALM_MAX_IFRAMES)
+			out->boxes[out->n++] = b;
+		qjs_xrealm_layout_walk(b->children, depth + 1, out);
+		b = b->next;
+	}
+}
+
+static const char *qjs_xrealm_origin(JSContext *ctx)
+{
+	struct content *c = qjs_get_content_for_ctx(ctx);
+	struct nsurl *u = c != NULL ? content_get_url(c) : NULL;
+	const char *s = u != NULL ? nsurl_access(u) : NULL;
+	return (s != NULL) ? s : "";
+}
+
+/* __vitaPostMessageToParent(jsonPayload) -- an iframe realm handing a
+ * message to its parent browsing context. */
+static JSValue
+qjs_xrealm_post_to_parent(JSContext *ctx, JSValueConst this_val,
+		int argc, JSValueConst *argv)
+{
+	const char *payload = NULL;
+	struct jsheap *heap;
+	struct qjs_realm_owner *owner;
+	JSValue ret = JS_UNDEFINED;
+	(void)this_val; (void)argc;
+	if (argc >= 1 && JS_IsString(argv[0])) {
+		payload = JS_ToCString(ctx, argv[0]);
+		if (payload == NULL) return JS_FALSE;
+		if (strlen(payload) > 262144) {
+			/* oversized: drop (a real browser would queue it; a
+			 * 256 KiB postMessage is not a sign-in flow) */
+			JS_FreeCString(ctx, payload);
+			return JS_FALSE;
+		}
+	}
+	owner = qjs_owner_for_ctx(ctx);
+	heap = owner != NULL ? owner->heap : NULL;
+	if (heap != NULL && heap->parent_heap != NULL) {
+		qjs_xrealm_enqueue(heap->parent_heap, payload,
+				qjs_xrealm_origin(ctx),
+				qjs_xrealm_origin(ctx));
+		ret = JS_TRUE;
+	}
+	if (payload != NULL) JS_FreeCString(ctx, payload);
+	return ret;
+}
+
+/* __vitaPostMessageToIframe(frameLabel, jsonPayload) -- the parent realm
+ * delivering into a named child frame (frameLabel === "" targets the first
+ * iframe, matching the Phase-0 single-frame surface).  frameLabel is the
+ * label the CHILD realm's __vitaShimWindow() will resolve the .source of
+ * the incoming MessageEvent to: the parent realm's name for itself, so the
+ * iframe's `event.source` is a window-like object, per spec. */
+static JSValue
+qjs_xrealm_post_to_iframe(JSContext *ctx, JSValueConst this_val,
+		int argc, JSValueConst *argv)
+{
+	const char *label = NULL, *payload = NULL;
+	struct jsheap *heap;
+	struct qjs_realm_owner *owner;
+	struct content *c;
+	JSValue ret = JS_FALSE;
+	int sent = 0;
+	(void)this_val;
+	if (argc >= 2 && JS_IsString(argv[0]) && JS_IsString(argv[1])) {
+		label = JS_ToCString(ctx, argv[0]);
+		payload = JS_ToCString(ctx, argv[1]);
+		if (label == NULL || payload == NULL) {
+			if (label) JS_FreeCString(ctx, label);
+			if (payload) JS_FreeCString(ctx, payload);
+			return JS_FALSE;
+		}
+		if (strlen(payload) > 262144) {
+			JS_FreeCString(ctx, label);
+			JS_FreeCString(ctx, payload);
+			return JS_FALSE;
+		}
+	}
+	if (label == NULL || payload == NULL) return JS_FALSE;
+	owner = qjs_owner_for_ctx(ctx);
+	heap = owner != NULL ? owner->heap : NULL;
+	c = owner != NULL ? owner->content : NULL;
+	/* The child realms this heap parents, by the frame name frames.c
+	 * linked them with (js_link_frame_heaps); for an unnamed frame the
+	 * label is its index among them. Independent of layout, which may
+	 * not have built the iframe boxes yet when the first message goes. */
+	if (heap != NULL) {
+		struct jsheap *o;
+		int idx = 0, want = -1;
+		const char *q;
+		for (q = label; *q >= '0' && *q <= '9'; q++)
+			;
+		if (*label != '\0' && *q == '\0')
+			want = atoi(label);
+		for (o = g_heap_list; o != NULL; o = o->next) {
+			if (o->parent_heap != heap)
+				continue;
+			if ((o->frame_key != NULL && *o->frame_key != '\0' &&
+			     strcmp(o->frame_key, label) == 0) ||
+			    (want >= 0 && idx == want) || *label == '\0') {
+				qjs_xrealm_enqueue(o, payload,
+						qjs_xrealm_origin(ctx),
+						qjs_xrealm_origin(ctx));
+				ret = JS_TRUE;
+				sent = 1;
+				break;
+			}
+			idx++;
+		}
+	}
+	if (!sent && heap != NULL && c != NULL &&
+			content_get_type(c) == CONTENT_HTML) {
+		struct html_content *htmlc = (struct html_content *)c;
+		struct qjs_xrealm_iframes ifr;
+		int i;
+		memset(&ifr, 0, sizeof(ifr));
+		qjs_xrealm_layout_walk(htmlc->layout, 0, &ifr);
+		for (i = 0; i < ifr.n; i++) {
+			const char *ifname = ifr.boxes[i]->iframe->name != NULL
+				? ifr.boxes[i]->iframe->name : "";
+			if (ifr.boxes[i]->iframe->jsheap == NULL ||
+					strcmp(ifname, label) != 0)
+				continue;
+			qjs_xrealm_enqueue(ifr.boxes[i]->iframe->jsheap, payload,
+					qjs_xrealm_origin(ctx),
+					qjs_xrealm_origin(ctx));
+			ret = JS_TRUE;
+			break;
+		}
+	}
+	JS_FreeCString(ctx, (char *)label);
+	JS_FreeCString(ctx, (char *)payload);
+	return ret;
+}
+
+/* __vitaIframeContentDocKey(iframeElement) -> a stable per-iframe key
+ * ("" if the element is not an iframe with a live window).  The polyfill
+ * pairs the key with the child realm's document at load time (the realm
+ * installs itself in __vitaDocByIframe) so contentDocument can return the
+ * child document object of the CHILD realm -- built there, used here, no
+ * value crosses. */
+static JSValue
+qjs_xrealm_iframe_doc_key(JSContext *ctx, JSValueConst this_val,
+		int argc, JSValueConst *argv)
+{
+	dom_node *node;
+	struct qjs_realm_owner *owner;
+	struct content *c;
+	struct qjs_xrealm_iframes ifr;
+	int i;
+	JSValue ret = JS_NewString(ctx, "");
+	(void)this_val; (void)argc; (void)argv;
+	node = qjs_get_node(this_val);
+	if (node == NULL) return ret;
+	owner = qjs_owner_for_ctx(ctx);
+	c = owner != NULL ? owner->content : NULL;
+	if (owner == NULL || c == NULL ||
+			content_get_type(c) != CONTENT_HTML)
+		return ret;
+	memset(&ifr, 0, sizeof(ifr));
+	qjs_xrealm_layout_walk(((struct html_content *)c)->layout, 0, &ifr);
+	for (i = 0; i < ifr.n; i++) {
+		if (ifr.boxes[i]->node != node) continue;
+		JS_FreeValue(ctx, ret);
