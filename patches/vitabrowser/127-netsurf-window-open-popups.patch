+/* ---- window.open: real popup windows -----------------------------------
+ *
+ * window.open(url) opens a second top-level browser window, shown in place
+ * of its opener until it closes (vita/window.c keeps the stack). Sign-in
+ * flows -- Google's for claude.ai -- load the provider in the popup, which
+ * posts the result to window.opener and closes itself; the two realms talk
+ * through the JSON bridge in macsurf_qjs.c (js_link_opener).
+ *
+ * Opening and closing run from the scheduler, never inside the script
+ * that asked: a window (and its JS heap) must not be created or destroyed
+ * while another runtime is executing, nor mid-way through a main-loop
+ * pass that still holds the old window.
+ */
+#define VITA_POPUPS 64
+
+static enum { POPUP_NONE, POPUP_PENDING, POPUP_OPEN, POPUP_CLOSED }
+	popup_state[VITA_POPUPS];
+static int popup_next = 1;
+
+struct popup_req {
+	int id;
+	struct content *opener;
+	nsurl *url;
+	nsurl *referer;
+};
+
+static void popup_open_run(void *p)
+{
+	struct popup_req *req = p;
+	struct browser_window *opener = window_for(req->opener);
+	struct browser_window *nbw = NULL;
+	nserror err;
+
+	err = browser_window_create(BW_CREATE_HISTORY, req->url,
+			req->referer, NULL, &nbw);
+	if (err != NSERROR_OK || nbw == NULL) {
+		vita_diag_log("window.open %d: failed (%d)", req->id, err);
+		popup_state[req->id] = POPUP_CLOSED;
+	} else {
+		vita_window_set_popup(nbw->window, req->id);
+		js_link_opener(nbw->jsheap,
+			       opener != NULL ? opener->jsheap : NULL, req->id);
+		popup_state[req->id] = POPUP_OPEN;
+		vita_diag_log("window.open %d: %s", req->id,
+			      nsurl_access(req->url));
+	}
+	nsurl_unref(req->url);
+	if (req->referer != NULL)
+		nsurl_unref(req->referer);
+	free(req);
+}
+
+/* exported interface documented in quickjs/macos9.h */
+int macsurf_window_open(struct content *c, const char *url)
+{
+	nsurl *base = (c != NULL && c->llcache != NULL) ?
+		content_get_url(c) : NULL;
+	struct popup_req *req;
+	nsurl *joined = NULL;
+	nserror err;
+
+	if (popup_next >= VITA_POPUPS)
+		return 0;
+	if (url == NULL || *url == '\0')
+		url = "about:blank";
+	err = (base != NULL) ? nsurl_join(base, url, &joined) :
+		nsurl_create(url, &joined);
+	if (err != NSERROR_OK)
+		return 0;
+	req = calloc(1, sizeof(*req));
+	if (req == NULL) {
+		nsurl_unref(joined);
+		return 0;
+	}
+	req->id = popup_next++;
+	req->opener = c;
+	req->url = joined;
+	req->referer = base != NULL ? nsurl_ref(base) : NULL;
+	popup_state[req->id] = POPUP_PENDING;
+	vita_schedule(0, popup_open_run, req);
+	return req->id;
+}
+
+/* exported interface documented in quickjs/macos9.h */
+int macsurf_window_popup_closed(int id)
+{
+	if (id <= 0 || id >= VITA_POPUPS)
+		return 1;
+	if (popup_state[id] == POPUP_OPEN && vita_window_for_popup(id) == NULL)
+		popup_state[id] = POPUP_CLOSED;
+	return popup_state[id] == POPUP_CLOSED || popup_state[id] == POPUP_NONE;
+}
+
+static void close_run(void *p)
+{
+	int id = (int)(intptr_t)p;
+	struct gui_window *gw = vita_window_for_popup(id);
+
+	if (gw == NULL)
+		return;
+	vita_diag_log("window %d: closed", id);
+	popup_state[id] = POPUP_CLOSED;
+	browser_window_destroy(vita_window_browser(gw));
+}
+
+/* exported interface documented in vita/js_platform.h */
+void vita_popup_close_later(int id)
+{
+	if (id > 0 && id < VITA_POPUPS)
+		vita_schedule(0, close_run, (void *)(intptr_t)id);
+}
+
+/* exported interface documented in quickjs/macos9.h */
+void macsurf_window_close_popup(int id)
+{
+	vita_popup_close_later(id);
+}
+
+/* exported interface documented in quickjs/macos9.h */
+void macsurf_window_close_self(struct content *c)
+{
+	struct browser_window *bw = window_for(c);
+
+	if (bw == NULL)
+		return;
+	bw = browser_window_get_root(bw);
+	/* Only a popup closes itself (a script may not close the window the
+	 * user opened, as in browsers). */
+	if (bw->window != NULL && vita_window_popup_id(bw->window) != 0)
+		vita_popup_close_later(vita_window_popup_id(bw->window));
+}
