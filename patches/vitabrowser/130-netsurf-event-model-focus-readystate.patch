+/* VitaBrowser: focus follows a tap. A browser moves focus to the
+ * focusable element under the pointer on mousedown (and blurs the old one),
+ * firing blur/focusout/focus/focusin; frameworks read document.activeElement
+ * and bind to those events (Google's text fields and buttons, React forms).
+ * The focus model lives in vita_polyfill.js (__vbTapFocus); this hands it
+ * the tapped node. */
+void macsurf_qjs_tap_focus(dom_node *node);
+void macsurf_qjs_tap_focus(dom_node *node)
+{
+	JSContext *ctx;
+	JSValue global, fnv, arg, ret;
+
+	if (node == NULL) return;
+	ctx = qjs_ctx_for_dom_node(node);
+	if (ctx == NULL) return;
+	global = JS_GetGlobalObject(ctx);
+	fnv = JS_GetPropertyStr(ctx, global, "__vbTapFocus");
+	if (JS_IsFunction(ctx, fnv)) {
+		qjs_geom_settle_begin();
+		macsurf_dom_node_ref(node);   /* qjs_wrap_any_node consumes one */
+		arg = qjs_wrap_any_node(ctx, node);
+		ret = JS_Call(ctx, fnv, global, 1, (JSValueConst *)&arg);
+		if (JS_IsException(ret))
+			JS_FreeValue(ctx, JS_GetException(ctx));
+		JS_FreeValue(ctx, ret);
+		JS_FreeValue(ctx, arg);
+	}
+	JS_FreeValue(ctx, fnv);
+	JS_FreeValue(ctx, global);
+}
