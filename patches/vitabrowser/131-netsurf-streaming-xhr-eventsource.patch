+/* ---- streaming progress (Patch 131) ----
+ *
+ * XHR readyState 2/3 + progress events and EventSource both need the body
+ * while it arrives. FETCH_DATA schedules one progress tick per scheduler
+ * pass (de-duplicated: a pass can carry many curl writes), which sets
+ * status and headers and calls the object's __onNativeProgress(received).
+ * The JS side pulls the new bytes itself with __xhrNativeTake, so nothing
+ * is copied for a page that never looks at a partial body, and a
+ * long-lived stream (EventSource) can discard what it has consumed
+ * instead of growing towards the byte cap.
+ *
+ * Same rule as xhr_deliver: never called from inside xhr_fetch_cb. */
+static void
+xhr_progress_run(struct qjs_xhr_slot *s)
+{
+	JSContext *ctx = s->ctx;
+	JSValue fn, ret;
+	double prevdl;
+
+	/* Always from the live fetch: after a redirect, status still holds
+	 * the 3xx that was followed. */
+	if (s->fetch != NULL) {
+		long code = fetch_http_code(s->fetch);
+		if (code > 0) s->status = (int) code;
+	}
+	JS_SetPropertyStr(ctx, s->xhr_obj, "status", JS_NewInt32(ctx, s->status));
+	JS_SetPropertyStr(ctx, s->xhr_obj, "__responseHeadersRaw",
+			JS_NewString(ctx, s->hdr_buf != NULL ? s->hdr_buf : ""));
+	if (s->url != NULL)
+		JS_SetPropertyStr(ctx, s->xhr_obj, "responseURL",
+				JS_NewString(ctx, nsurl_access(s->url)));
+
+	fn = JS_GetPropertyStr(ctx, s->xhr_obj, "__onNativeProgress");
+	if (JS_IsFunction(ctx, fn)) {
+		JSValue arg = JS_NewFloat64(ctx, (double) s->received);
+		prevdl = macsurf_qjs_deadline_push_ms(
+				macsurf_qjs_default_timeout_ms());
+		ret = JS_Call(ctx, fn, s->xhr_obj, 1, &arg);
+		macsurf_qjs_deadline_pop(prevdl);
+		if (JS_IsException(ret)) {
+			JSValue exc = JS_GetException(ctx);
+			const char *m = JS_ToCString(ctx, exc);
+			macsurf_debug_log_writef("LIFE qjs xhr progress threw: %s",
+					m ? m : "?");
+			if (m) JS_FreeCString(ctx, m);
+			JS_FreeValue(ctx, exc);
+		}
+		JS_FreeValue(ctx, ret);
+		JS_FreeValue(ctx, arg);
+	}
+	JS_FreeValue(ctx, fn);
+}
+
+static void
+xhr_progress(void *p)
+{
+	struct qjs_xhr_slot *s = (struct qjs_xhr_slot *) p;
+
+	if (s == NULL || !s->used || s->beacon || s->ctx == NULL) return;
+	/* A slot released and reused between schedule and run is a
+	 * different request: release cancels its owner's callbacks, so
+	 * this is belt and braces. */
+	xhr_progress_run(s);
+}
+
+/* Length of the longest prefix of b[0..len) that does not end inside a
+ * UTF-8 sequence, so a take never splits a character across two JS
+ * strings (each half would decode to U+FFFD). */
+static long
+xhr_utf8_safe_len(const char *b, long len)
+{
+	long i = len, back = 0;
+	unsigned char c;
+
+	while (i > 0 && back < 4) {
+		c = (unsigned char) b[i - 1];
+		if ((c & 0xC0) != 0x80) {
+			long need = (c >= 0xF0) ? 4 : (c >= 0xE0) ? 3 :
+					(c >= 0xC0) ? 2 : 1;
+			/* back continuation bytes follow the lead at i-1 */
+			return (back + 1 >= need) ? len : i - 1;
+		}
+		i--; back++;
+	}
+	return len;
+}
+
+/* __xhrNativeTake(id, discard): the body bytes received since the last
+ * take, as a string ('' when none, null for an unknown slot). discard=1
+ * drops them from the buffer afterwards (streams that never need the
+ * whole body); otherwise the buffer keeps everything for the final
+ * responseText. */
+static JSValue
+qjs_xhr_native_take(JSContext *ctx, JSValueConst this_val,
+		int argc, JSValueConst *argv)
+{
+	struct qjs_xhr_slot *s;
+	int32_t id = 0, discard = 0;
+	long avail, n;
+	JSValue str;
+
+	(void) this_val;
+	if (argc < 1) return JS_NULL;
+	JS_ToInt32(ctx, &id, argv[0]);
+	if (argc > 1) discard = JS_ToBool(ctx, argv[1]);
+	s = xhr_slot_find(id);
+	if (s == NULL || s->beacon) return JS_NULL;
+	avail = s->resp_len - s->taken;
+	if (avail <= 0 || s->resp_buf == NULL) return JS_NewString(ctx, "");
+	/* A finished fetch has no more bytes coming: hand over the tail even
+	 * if it is a broken sequence. */
+	n = (s->fetch_live) ?
+		xhr_utf8_safe_len(s->resp_buf + s->taken, avail) : avail;
+	if (n <= 0) return JS_NewString(ctx, "");
+	str = JS_NewStringLen(ctx, s->resp_buf + s->taken, (size_t) n);
+	s->taken += n;
+	if (discard) {
+		memmove(s->resp_buf, s->resp_buf + s->taken,
+				(size_t) (s->resp_len - s->taken));
+		s->resp_len -= s->taken;
+		s->taken = 0;
+		s->resp_buf[s->resp_len] = '\0';
+	}
+	return str;
+}
