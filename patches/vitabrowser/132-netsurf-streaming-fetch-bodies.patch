+/* __xhrNativeTakeBytes(id, discard) (Patch 132): as __xhrNativeTake, but
+ * the exact bytes as an ArrayBuffer -- no UTF-8 decode, so no boundary
+ * cut and binary bodies survive. Streaming fetch() feeds Response.body
+ * (a stream of Uint8Array) from this. null for an unknown slot. */
+static JSValue
+qjs_xhr_native_take_bytes(JSContext *ctx, JSValueConst this_val,
+		int argc, JSValueConst *argv)
+{
+	struct qjs_xhr_slot *s;
+	int32_t id = 0, discard = 0;
+	long n;
+	JSValue ab;
