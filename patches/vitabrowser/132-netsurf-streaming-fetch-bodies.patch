+	JS_SetPropertyStr(ctx, s->xhr_obj, "__redirects",
+			JS_NewInt32(ctx, s->redirect_hops));
 
 	fn = JS_GetPropertyStr(ctx, s->xhr_obj, "__onNativeProgress");
 	if (JS_IsFunction(ctx, fn)) {
@@ -508,6 +514,39 @@ qjs_xhr_native_take(JSContext *ctx, JSValueConst this_val,
