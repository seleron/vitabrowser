+	(void) this_val;
+	if (argc < 1) return JS_NULL;
+	JS_ToInt32(ctx, &id, argv[0]);
+	if (argc > 1) discard = JS_ToBool(ctx, argv[1]);
+	s = xhr_slot_find(id);
+	if (s == NULL || s->beacon) return JS_NULL;
+	n = s->resp_len - s->taken;
+	if (n <= 0 || s->resp_buf == NULL)
+		return JS_NewArrayBufferCopy(ctx, NULL, 0);
+	ab = JS_NewArrayBufferCopy(ctx, (const uint8_t *) s->resp_buf + s->taken,
+			(size_t) n);
+	s->taken += n;
+	if (discard) {
+		s->resp_len = 0;
+		s->taken = 0;
+		s->resp_buf[0] = '\0';
+	}
+	return ab;
+}
