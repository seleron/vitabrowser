# netsurf: nsmonkey links again -- QuickJS-only hooks guarded, SVG on for monkey
#
# tools/build-patched.sh's last step (the headless nsmonkey the golden
# plot streams are captured with, doc 03) had not linked since the QuickJS
# bridge work: monkey builds NetSurf's default Duktape backend, and
#   - html.c calls js_fire_window_load (MACSURF_JS_FIRE_LOAD, patch 130)
#   - desktop/frames.c calls js_link_frame_heaps (patch 126)
# which exist only in the QuickJS bridge, and patch 121's inline <svg>
# (vb_inline_svg.c) calls libsvgtiny, which monkey's defaults leave out.
# Nobody saw it because run-vita-sim.sh does not need nsmonkey. So
# check-patched-streams.sh and test-vita-renderer.sh had not run against
# the live engine since patch 32.
#
# The two calls are now under WITH_QUICKJS (the other backends have no
# realms to link and no load hook), and monkey builds with
# NETSURF_USE_NSSVG, as the Vita does. The Vita and simulator builds
# define WITH_QUICKJS, so they are unchanged.
diff --git a/content/handlers/html/html.c b/content/handlers/html/html.c
index 9033f24d5..58376a7f4 100644
--- a/content/handlers/html/html.c
+++ b/content/handlers/html/html.c
@@ -1398,7 +1398,9 @@ html_proceed_to_done(html_content *html)
 			 * degrade the page (truncated articles, collapsed
 			 * slider, a 1s re-truncation ticker). Re-enable in the
 			 * round that ships forced layout. */
-#if MACSURF_JS_FIRE_LOAD
+#if MACSURF_JS_FIRE_LOAD && defined(WITH_QUICKJS)
+			/* (QuickJS only: the other backends have no such hook, and
+			 * nsmonkey builds with Duktape.) */
 			if (html->js_thread != NULL) {
 				js_fire_window_load(html->js_thread,
 						html->document);
diff --git a/desktop/frames.c b/desktop/frames.c
index 53a11ea44..1c0c63dac 100644
--- a/desktop/frames.c
+++ b/desktop/frames.c
@@ -270,8 +270,10 @@ nserror browser_window_create_iframes(struct browser_window *bw)
 		/* Cross-realm frame bridge: link this iframe realm to its
 		 * parent's realm (window.parent / postMessage).  Degrades
 		 * gracefully if the parent has no JS heap. */
+#ifdef WITH_QUICKJS
 		js_link_frame_heaps(window->jsheap, bw->jsheap,
 				window->name != NULL ? window->name : "");
+#endif
 
 		/* iframe dimensions */
 		box_bounds(window->box, &rect);
@@ -682,8 +684,10 @@ browser_window_create_frameset_internal(struct browser_window *bw,
 
 			/* Cross-realm frame bridge (frameset frame): link this
 			 * frame's realm to its parent's realm. */
+#ifdef WITH_QUICKJS
 			js_link_frame_heaps(window->jsheap, bw->jsheap,
 					window->name != NULL ? window->name : "");
+#endif
 
 			if (window->name)
 				NSLOG(netsurf, INFO, "Created frame '%s'",
diff --git a/frontends/monkey/Makefile.defaults b/frontends/monkey/Makefile.defaults
index 87b6f3ac4..7f3f86aa8 100644
--- a/frontends/monkey/Makefile.defaults
+++ b/frontends/monkey/Makefile.defaults
@@ -6,7 +6,10 @@
 NETSURF_MONKEY_RESOURCES := $(PREFIX)/share/netsurf/
 NETSURF_MONKEY_BIN := $(PREFIX)/bin/
 NETSURF_USE_RSVG := NO
-NETSURF_USE_NSSVG := NO
+# VitaBrowser: inline <svg> (content/handlers/html/vb_inline_svg.c, patch
+# 121) draws with libsvgtiny whatever this says, and the Vita builds it in;
+# monkey matches the device.
+NETSURF_USE_NSSVG := YES
 NETSURF_USE_ROSPRITE := NO
 NETSURF_USE_HARU_PDF := NO
 NETSURF_FS_BACKING_STORE := YES
