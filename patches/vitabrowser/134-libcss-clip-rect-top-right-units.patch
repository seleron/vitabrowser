# libcss: clip: rect() top/right units read with the wrong precedence (upstream bug)
#
# get_clip() (the override in src/select/overrides.py, and the committed
# autogenerated_propget.h generated from it) unpacked the top and right
# units as
#     rect->tunit = bits & 0x3e00000 >> 21;
#     rect->runit = bits & 0x1f0000 >> 16;
# which C parses as bits & (0x3e00000 >> 21), i.e. bits & 0x1f: the low
# bits holding the clip type and the auto flags. For a plain rect those
# are 2, CSS_UNIT_EM. So `clip: rect(0px, 200px, 60px, 0px)` clipped its
# right edge at 200em (3200px) and effectively never. Top was hit the same
# way, and invisible because it is usually 0. Bottom and left were already
# parenthesised.
#
# Found through PM-shadow-clip's negative control (the clip in force ran to
# the viewport's x 951, not the box's 500): doc 13. Present in pristine
# upstream libcss (499f1c4); worth sending upstream.
diff --git a/src/select/overrides.py b/src/select/overrides.py
--- a/src/select/overrides.py
+++ b/src/select/overrides.py
@@ -31,10 +31,10 @@
 		rect->top_auto = (bits & 0x20);
 
 		rect->top = style->i.clip_a;
-		rect->tunit = bits & 0x3e00000 >> 21;
+		rect->tunit = (bits & 0x3e00000) >> 21;
 
 		rect->right = style->i.clip_b;
-		rect->runit = bits & 0x1f0000 >> 16;
+		rect->runit = (bits & 0x1f0000) >> 16;
 
 		rect->bottom = style->i.clip_c;
 		rect->bunit = (bits & 0xf800) >> 11;
diff --git a/src/select/autogenerated_propget.h b/src/select/autogenerated_propget.h
--- a/src/select/autogenerated_propget.h
+++ b/src/select/autogenerated_propget.h
@@ -923,10 +923,10 @@
 		rect->top_auto = (bits & 0x20);
 
 		rect->top = style->i.clip_a;
-		rect->tunit = bits & 0x3e00000 >> 21;
+		rect->tunit = (bits & 0x3e00000) >> 21;
 
 		rect->right = style->i.clip_b;
-		rect->runit = bits & 0x1f0000 >> 16;
+		rect->runit = (bits & 0x1f0000) >> 16;
 
 		rect->bottom = style->i.clip_c;
 		rect->bunit = (bits & 0xf800) >> 11;
