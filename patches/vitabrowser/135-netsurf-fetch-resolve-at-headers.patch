+	int headers_tick;		/* Patch 135: the header-block-end progress
+					 * tick has fired for the current response
+					 * (xhr_follow_redirect resets it for the
+					 * next hop) */
 
 	/* VitaBrowser (Patch 131, streaming): the body reaches JS while it
 	 * arrives, not only on completion. taken = resp_buf bytes already
@@ -639,6 +643,7 @@
 	s->resp_len = 0; s->resp_poisoned = 0;
 	s->hdr_len = 0; s->hdr_poisoned = 0;
 	s->taken = 0; s->received = 0;
+	s->headers_tick = 0;	/* Patch 135: a new response is coming */
 
 	if (xhr_start_fetch(s) != 0) {
 		s->is_error = 1;
@@ -646,6 +651,134 @@
