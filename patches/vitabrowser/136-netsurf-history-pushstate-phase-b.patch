 	return JS_UNDEFINED;
 }
 
+/* History API Phase B (Patch 136): evaluate history.__traverse(delta) in
+ * ctx. The JS shim keeps the pushState session entries; this returns true
+ * when one was shown (popstate already fired), false when the step leaves
+ * the JS stack and the caller must navigate natively. Never throws: any
+ * failure means "not consumed". */
+static bool qjs_history_traverse_step(JSContext *ctx, int delta)
+{
+	char src[48];
+	JSValue v;
+	int n = 0;
+
+	if (ctx == NULL || (delta != -1 && delta != 1))
+		return false;
+	snprintf(src, sizeof(src), "history.__traverse(%d)", delta);
+	v = JS_Eval(ctx, src, strlen(src), "<history>", JS_EVAL_TYPE_GLOBAL);
+	if (JS_IsException(v)) {
+		JS_FreeValue(ctx, v);
+		return false;
+	}
+	if (JS_ToInt32(ctx, &n, v) != 0)
+		n = 0;
+	JS_FreeValue(ctx, v);
+	return n != 0;
+}
+
+/* Query a boolean from the history shim. Used to decide whether a
+ * forward step past the JS stack is a no-op (pushState cleared forward
+ * entries) or a native navigation. */
+static bool qjs_history_js_bool(JSContext *ctx, const char *expr)
+{
+	JSValue v;
+	bool r = false;
+	if (ctx == NULL || expr == NULL)
+		return false;
+	v = JS_Eval(ctx, expr, strlen(expr), "<history>", JS_EVAL_TYPE_GLOBAL);
+	if (!JS_IsException(v))
+		r = JS_ToBool(ctx, v);
+	JS_FreeValue(ctx, v);
+	return r;
+}
+
+/* Physical back/forward buttons (frontends/vita/input.c) reach the JS
+ * stack through the realm owner list: content -> ctx. */
+bool macsurf_qjs_history_traverse(struct content *c, int delta)
+{
+	struct qjs_realm_owner *o;
+
+	if (c == NULL || (delta != -1 && delta != 1))
+		return false;
+	for (o = g_qjs_realm_owners; o != NULL; o = o->next) {
+		if (o->content == c && o->ctx != NULL)
+			return qjs_history_traverse_step(o->ctx, delta);
+	}
+	return false;
+}
