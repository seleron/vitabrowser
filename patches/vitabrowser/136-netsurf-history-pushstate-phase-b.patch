+		{
+			int delta = (int)d;
+			if (delta == 0) {
+				/* go(), go(0): reload, per the HTML standard. */
+				macsurf_window_history(
+					qjs_get_content_for_ctx(ctx), 0);
+			} else {
+				int step = (delta < 0) ? -1 : 1;
+				while (delta != 0 &&
+				       qjs_history_traverse_step(ctx, step))
+					delta -= step;
+				if (delta != 0) {
