+			}
+		}
 	}
 #else
 	(void)argc; (void)argv;
@@ -1474,6 +1571,20 @@ static JSValue qjs_history_set_url_display(JSContext *ctx, JSValueConst this_val
 	return JS_UNDEFINED;
 }
 
+/* Phase B: native session-history entry count for the history.length
+ * getter (which adds the JS pushState entries to this). */
+static JSValue qjs_history_native_length(JSContext *ctx, JSValueConst this_val,
+		int argc, JSValueConst *argv)
+{
