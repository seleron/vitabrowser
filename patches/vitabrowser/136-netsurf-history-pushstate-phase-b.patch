+					bool atEnd = qjs_history_js_bool(ctx,
+					    "history.__atForwardEnd?history.__atForwardEnd():false");
+					bool hasPS = qjs_history_js_bool(ctx,
+					    "history.__hasPushState?history.__hasPushState():false");
+					if (!(delta > 0 && atEnd && hasPS))
