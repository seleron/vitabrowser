+static bool history_length_cb(const struct browser_window *bw,
+		int x0, int y0, int x1, int y1,
+		const struct history_entry *entry, void *user_data)
+{
+	(void)bw; (void)x0; (void)y0; (void)x1; (void)y1; (void)entry;
+	(*(int *)user_data)++;
+	return true;
+}
+
+/* exported interface documented in quickjs/macos9.h: native session-history
+ * entry count for the JS history.length getter (Patch 136). */
+int macsurf_window_history_length(struct content *c)
+{
+	struct browser_window *bw = window_for(c);
+	struct browser_window *root;
+	int n = 0;
+
+	if (bw == NULL)
+		return 1;
+	root = browser_window_get_root(bw);
+	if (root == NULL)
+		return 1;
+	browser_window_history_enumerate(root, history_length_cb, &n);
+	return (n > 0) ? n : 1;
+}
+
+/* exported interface documented in vita/js_platform.h: the physical L/R
+ * history buttons traverse the JS pushState stack first (Patch 136). */
+bool vita_history_traverse_js(struct browser_window *bw, int delta)
+{
+	struct content *c = NULL;
+
+	if (bw != NULL && bw->current_content != NULL)
+		c = hlcache_handle_get_content(bw->current_content);
+	if (c == NULL)
+		return false;
+	return macsurf_qjs_history_traverse(c, delta);
+}
