# netsurf: History Phase B -- define the step target in _step()
#
# Patch 136's JS shim lost a line: _step(d) reads `j` but never declares
# it (`var j=_idx+d;`). Calling history.__traverse() therefore throws
# ReferenceError, qjs_history_traverse_step() reports "not consumed", and
# every back()/forward()/go() falls through to the native history walk --
# which queues an async native navigation instead of walking the pushState
# stack (and on the last queued step navigates the page away entirely, so
# the autotest dumps the previous page into the history slot).
#
# One line restores the intended behaviour: back()/forward()/go() walk the
# JS pushState stack first (popstate fired per step), native traversal only
# past the stack's ends.
#
# Test: testpages/pages/JS-history.html, 30/30 over HTTP and HTTPS, gated in
# tools/run-vita-sim.sh.
diff --git a/content/handlers/javascript/quickjs/macsurf_qjs.c b/content/handlers/javascript/quickjs/macsurf_qjs.c
--- a/content/handlers/javascript/quickjs/macsurf_qjs.c
+++ b/content/handlers/javascript/quickjs/macsurf_qjs.c
@@ -13948,5 +13948,6 @@ static JSValue qjs_location_reload(JSContext *ctx, JSValueConst this_val,
 		"  }"
 		"  function _step(d){"
+				"    var j=_idx+d;"
 				"    if(j<0||j>=_entries.length)return 0;"
 		"    _idx=j;"
 		"    _show(_entries[_idx]);"
