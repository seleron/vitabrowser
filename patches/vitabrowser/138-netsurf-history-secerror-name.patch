# netsurf: History Phase B -- _secErr must not trust the DOMException stub
#
# Patch 136's _secErr() does `new DOMException(msg,'SecurityError')` in a
# try, falling back to an Error with name='SecurityError' only if the
# constructor throws. But the bridge stubs DOMException as an empty function
# (`g[names[i]]=function(){}`, fixes1243 list), so `new DOMException(...)`
# SUCCEEDS and returns an object whose .name is undefined -- the fallback
# never runs. Cross-origin pushState/replaceState then throws an error
# whose name is undefined instead of 'SecurityError', failing the
# JS-history assertion 25 (state correctly unchanged, so assertion 26
# still passes -- the throw happens, just with the wrong name).
#
# Fix: check that the constructed DOMException actually carries
# name='SecurityError'; otherwise fall back to the named Error. This keeps
# working if the bridge ever ships a real DOMException.
#
# Test: testpages/pages/JS-history.html assertion 25, 30/30 over HTTP and
# HTTPS, gated in tools/run-vita-sim.sh.
diff --git a/content/handlers/javascript/quickjs/macsurf_qjs.c b/content/handlers/javascript/quickjs/macsurf_qjs.c
--- a/content/handlers/javascript/quickjs/macsurf_qjs.c
+++ b/content/handlers/javascript/quickjs/macsurf_qjs.c
@@ -13917,4 +13917,8 @@ static JSValue qjs_location_reload(JSContext *ctx, JSValueConst this_val,
 		"  function _secErr(msg){"
-		"    try{return new DOMException(msg,'SecurityError');}"
-		"    catch(e){var x=new Error(msg);x.name='SecurityError';return x;}"
+		"    var e=null;"
+		"    try{e=new DOMException(msg,'SecurityError');}catch(_){}"
+		"    if(!e||e.name!=='SecurityError'){"
+		"      e=new Error(msg);e.name='SecurityError';"
+		"    }"
+		"    return e;"
 		"  }"
