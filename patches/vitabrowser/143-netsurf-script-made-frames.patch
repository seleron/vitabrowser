# netsurf: script-made same-origin frames fire load and get a same-realm contentWindow
#
# Hardware run 22: Google sign-in "Next" did nothing. Google's page makes a
# hidden same-origin iframe (/_/bscframe), waits for its load event, and
# runs its BotGuard VM with iframe.contentWindow.eval. The engine loads only
# the frames it parses: a script-made frame was never fetched, never fired
# load, and its contentWindow (the cross-realm shim) had no eval. BotGuard
# retried 4 x 6.2 s and the email lookup went out with "FNL..." instead of a
# token; Google answered [9] and the page stayed greyed out.
#
# document.createElement('iframe') marks its element (macsurf_qjs.c
# qjs_create_element); the parser never goes through it, so parsed frames
# are unchanged. When a marked frame whose src is blank or same-origin enters
# the document, the engine's node-inserted handler (dom_event.c ->
# js_frame_inserted) asks vita_polyfill.js to fire its load event
# (dispatchEvent: listeners and onload once each), and its contentWindow is a
# window in THIS realm with its own eval (indirect, global scope), parent,
# frameElement and a detached document, so writing into the frame cannot
# touch the page. Cross-origin script-made frames are unchanged (no load).
# The window is kept on the element, not in a WeakMap: it points back at
# the element, and a WeakMap value holding its own key is never collected
# (QuickJS asserted at exit).
#
# Simulator result: BotGuard produces its token and Next now reaches
# Google's verdict, "Couldn't sign you in -- this browser or app may not be
# secure" (/v3/signin/rejected; headless Chrome gets the same).
# Test: JS-frame-local.html cases 1-5 (over http).
diff --git a/content/handlers/html/dom_event.c b/content/handlers/html/dom_event.c
index 034b82807..ee864a139 100644
--- a/content/handlers/html/dom_event.c
+++ b/content/handlers/html/dom_event.c
@@ -687,6 +687,19 @@ dom_default_action_DOMNodeInserted_cb(struct dom_event *evt, void *pw)
 			html_process_inserted_title(htmlc, (dom_node *)node);
 			break;
 
+#ifdef WITH_QUICKJS
+		case DOM_HTML_ELEMENT_TYPE_IFRAME:
+			/* VitaBrowser: script-made frames get their load event
+			 * from the polyfill (macsurf_qjs.c js_frame_inserted) */
+			if (htmlc->js_thread != NULL) {
+				extern void js_frame_inserted(jsthread *thread,
+						struct dom_node *node);
+				js_frame_inserted(htmlc->js_thread,
+						(struct dom_node *)node);
+			}
+			break;
+#endif
+
 		default:
 			break;
 		}
diff --git a/content/handlers/javascript/quickjs/macsurf_qjs.c b/content/handlers/javascript/quickjs/macsurf_qjs.c
index bdb79a5cd..e339c60ff 100644
--- a/content/handlers/javascript/quickjs/macsurf_qjs.c
+++ b/content/handlers/javascript/quickjs/macsurf_qjs.c
@@ -19,6 +19,7 @@
 #include <stdio.h>
 #include <stdlib.h>
 #include <string.h>
+#include <strings.h>
 #include <ctype.h>
 #include <sys/stat.h>
 #include <dirent.h>
@@ -10676,8 +10677,17 @@ static JSValue qjs_create_element(JSContext *ctx, JSValueConst this_val,
 		JS_FreeCString(ctx, tag);
 		return JS_NULL;
 	}
-	JS_FreeCString(ctx, tag);
-	obj = qjs_wrap_element_full(ctx, el);
+	/* VitaBrowser: mark a script-made iframe. The engine loads only
+	 * the frames the parser makes; vita_polyfill.js gives a script-made
+	 * same-origin one a load event and a same-realm window. */
+	{
+		int is_iframe = strcasecmp(tag, "iframe") == 0;
+		JS_FreeCString(ctx, tag);
+		obj = qjs_wrap_element_full(ctx, el);
+		if (is_iframe && JS_IsObject(obj))
+			JS_DefinePropertyValueStr(ctx, obj, "__vitaMadeFrame",
+					JS_TRUE, JS_PROP_CONFIGURABLE);
+	}
 	qjs_dom_make_trace("elem", ctx, doc, qjs_get_node(obj), obj);
 	return obj;
 }
@@ -18773,6 +18783,43 @@ void js_set_current_script(struct jsthread *thread, struct dom_node *node)
 	JS_FreeValue(ctx, global);
 }
 
+/* VitaBrowser: an <iframe> entered the document (dom_event.c). The engine
+ * loads only the frames the parser makes; vita_polyfill.js's
+ * __vitaFrameInserted gives a script-made same-origin one its load event. */
+void js_frame_inserted(struct jsthread *thread, struct dom_node *node)
+{
+	JSContext *ctx;
+	JSValue g, hook;
+
+	if (thread == NULL || thread->ctx == NULL || node == NULL) return;
+	{
+		struct content *c = (struct content *)thread->doc_priv;
+		dom_document *doc = NULL;
+		bool live;
+		macsurf_dom_node_get_owner_document(node, &doc);
+		live = qjs_thread_is_live_for_dispatch(thread, c, doc);
+		if (doc) macsurf_dom_node_unref((dom_node *)doc);
+		if (!live) return;
+	}
+	ctx = thread->ctx;
+	g = JS_GetGlobalObject(ctx);
+	hook = JS_GetPropertyStr(ctx, g, "__vitaFrameInserted");
+	if (JS_IsFunction(ctx, hook)) {
+		JSValue el, r;
+		macsurf_dom_node_ref(node);	/* the wrap consumes this one */
+		el = qjs_wrap_element(ctx, (dom_element *)node);
+		if (!JS_IsNull(el) && !JS_IsUndefined(el)) {
+			r = JS_Call(ctx, hook, g, 1, (JSValueConst *)&el);
+			if (JS_IsException(r))
+				JS_FreeValue(ctx, JS_GetException(ctx));
+			JS_FreeValue(ctx, r);
+		}
+		JS_FreeValue(ctx, el);
+	}
+	JS_FreeValue(ctx, hook);
+	JS_FreeValue(ctx, g);
+}
+
 unsigned char js_fire_script_load(struct jsthread *thread,
 		struct dom_node *node, int ok)
 {
