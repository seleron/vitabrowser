# libdom: run the bubble phase only for events that bubble
#
# _dom_node_dispatch_event ran the bubbling loop for every event,
# ignoring evt->bubble (DOM "dispatch" step 5.13: only "if event's
# bubbles attribute is true"). Every non-bubbling event bubbled: the
# engine's own `load` at an image or script reached the document's and
# window's load listeners, and `new Event(t)` bubbled like
# `{bubbles: true}`.
# Test: JS-event-order.html case 4 (roadmap WS-B1).
diff --git a/src/core/node.c b/src/core/node.c
--- a/src/core/node.c
+++ b/src/core/node.c
@@ -2627,10 +2627,14 @@
 	if (evt->stop_now == true || evt->stop == true)
 		goto cleanup;
 
-	/* Bubbling phase */
+	/* Bubbling phase -- only for an event that bubbles (DOM
+	 * "dispatch", step 5.13: "if event's bubbles attribute is true").
+	 * VitaBrowser: every event bubbled, so a non-bubbling `load` at an
+	 * image or script reached the document's and window's `load`
+	 * listeners, and `new Event(t)` bubbled like `{bubbles: true}`. */
 	evt->phase = DOM_BUBBLING_PHASE;
 
-	for (targetnr = 0; targetnr < ntargets; ++targetnr) {
+	for (targetnr = 0; evt->bubble && targetnr < ntargets; ++targetnr) {
 		dom_node_internal *node =
 			(dom_node_internal *) targets[targetnr];
 		err = _dom_event_target_dispatch(targets[targetnr],
