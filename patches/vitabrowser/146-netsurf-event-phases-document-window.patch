 					"try{document.__msRegDocEvent(t,opt);}catch(e){}}};"
 			"document.addEventListener=document.addEventListener||"
 				"function(t,fn,opt){"
 					"if(!document._listeners)document._listeners={};"
 					"if(!document._listeners[t])document._listeners[t]=[];"
+					"if(!document._listenersC)document._listenersC={};"
+					"if(!document._listenersC[t])document._listenersC[t]=[];"
 					"document._listeners[t].push(fn);"
+					"document._listenersC[t].push(document.__msCap(opt));"
 					/* fixes1249 (#167) - the real Facebook bundle has
 					 * AT LEAST 5-6 distinct DOMContentLoaded listener
 					 * registration sites (a messenger health tracker, a
@@ -12698,9 +12721,12 @@ static void register_browser_globals(JSContext *ctx)
 					"}catch(e){}}"
 					"document.__msRegOnce(t,opt);};"
 			"document.removeEventListener=document.removeEventListener||"
-				"function(t,fn){"
+				"function(t,fn,opt){"
 					"var L=document._listeners&&document._listeners[t];if(!L)return;"
-					"for(var i=0;i<L.length;i++)if(L[i]===fn){L.splice(i,1);return;}};"
+					"var C=(document._listenersC&&document._listenersC[t])||[];"
+					"var cap=document.__msCap(opt);"
+					"for(var i=0;i<L.length;i++)if(L[i]===fn&&!!C[i]===cap){"
+						"L.splice(i,1);C.splice(i,1);return;}};"
 			/* fixes1236 (#167) - had ZERO diagnostics and a fully silent
 			 * catch(e){} -- a document-level listener that threw left no
 			 * trace anywhere. window.dispatchEvent (below, same fix round)
@@ -12723,7 +12749,15 @@ static void register_browser_globals(JSContext *ctx)
 					 * for readystatechange that way, several at once). */
 					"if(ev&&ev.target==null){try{ev.target=document;}catch(_){}}"
 					"try{if(ev)ev.currentTarget=document;}catch(_){}"
-					"if(L)L.slice().forEach(function(f){try{f.call(document,ev);}catch(e){"
+					/* VitaBrowser: the phase libdom is in (the native
+					 * listener callback sets it): capture listeners while
+					 * capturing, the others while bubbling, all at the
+					 * target or for a direct call. */
+					"var ph=(ev&&ev.eventPhase)|0;"
+					"var C=(document._listenersC&&document._listenersC[t])||[];"
+					"if(L)L.slice().forEach(function(f,i){"
+					"if((ph===1&&!C[i])||(ph===3&&C[i]))return;"
+					"try{f.call(document,ev);}catch(e){"
 						"try{if(typeof __msLife==='function')"
 							"__msLife('docevt THREW type='+t+': '+"
 								"((e&&e.name)?(e.name+': '):'')+((e&&e.message)||e)+(e&&e.stack?(' STACK: '+e.stack):''));}catch(_){}"
@@ -12986,7 +13020,10 @@ static void register_browser_globals(JSContext *ctx)
 		 * input at all. */
 		"this.addEventListener=function(t,fn,opt){"
 			"if(!this._winListeners[t])this._winListeners[t]=[];"
+			"if(!this._winListenersC)this._winListenersC={};"
+			"if(!this._winListenersC[t])this._winListenersC[t]=[];"
 			"this._winListeners[t].push(fn);"
+			"this._winListenersC[t].push(opt===true||!!(opt&&typeof opt==='object'&&opt.capture));"
 			/* fixes1249 (#167) - same fingerprint as document's
 			 * addEventListener (see its comment); window is the OTHER
 			 * side of the exact same "which of 5-6 candidate
@@ -12999,9 +13036,12 @@ static void register_browser_globals(JSContext *ctx)
 			"if(typeof document!=='undefined'&&"
 			   "typeof document.__msRegOnce==='function'){"
 				"try{document.__msRegOnce(t,opt);}catch(e){}}};"
-		"this.removeEventListener=function(t,fn){"
+		"this.removeEventListener=function(t,fn,opt){"
 			"var arr=this._winListeners[t];if(!arr)return;"
-			"for(var i=0;i<arr.length;i++)if(arr[i]===fn){arr.splice(i,1);return;}};"
+			"var C=(this._winListenersC&&this._winListenersC[t])||[];"
+			"var cap=opt===true||!!(opt&&typeof opt==='object'&&opt.capture);"
+			"for(var i=0;i<arr.length;i++)if(arr[i]===fn&&!!C[i]===cap){"
+				"arr.splice(i,1);C.splice(i,1);return;}};"
 		/* fixes863 (#289 probe) - this used to be a bare
 		 *     if(arr)arr.forEach(function(f){try{f(ev);}catch(e){}});
 		 * so a window listener that THREW was swallowed in total silence,
@@ -13041,7 +13081,13 @@ static void register_browser_globals(JSContext *ctx)
 			/* VitaBrowser: snapshot + this=window (see document's). */
 			"var W=this;"
 			"if(ev&&ev.target==null){try{ev.target=W;}catch(_){}}"
-			"if(arr)arr.slice().forEach(function(f){try{f.call(W,ev);}catch(e){"
+			/* VitaBrowser: phase-filtered, as document's */
+			"var ph=(ev&&ev.eventPhase)|0;"
+			"var C=(W._winListenersC&&W._winListenersC[t])||[];"
+			"try{if(ev)ev.currentTarget=W;}catch(_){}"
+			"if(arr)arr.slice().forEach(function(f,i){"
+			"if((ph===1&&!C[i])||(ph===3&&C[i]))return;"
+			"try{f.call(W,ev);}catch(e){"
 				"try{if(typeof __msLife==='function')"
