# netsurf: DOM event phases for document and window; one defaultPrevented; spec defaults
#
# Found replaying claude.ai's email form and pinned by JS-event-order.html
# (roadmap WS-B1). Elements dispatched correctly through libdom, but:
#
# - document and window keep their listeners in JS shims that registered
#   with libdom once per TYPE (not per capture flag) and fired ALL their
#   listeners on every visit: a listener added without capture ran while
#   capturing, before the target, and never while bubbling. They now keep
#   each listener's capture flag, register per (type, capture), and fire
#   only the listeners of the phase libdom is in (all at the target).
#   removeEventListener matches the capture flag.
# - the native listener callback set defaultPrevented = false on every
#   node the event visited, so a later listener never saw an earlier
#   preventDefault. It now reads libdom's flag.
# - el.dispatchEvent defaulted bubbles and cancelable to TRUE; the spec
#   (and `new Event(t)`) says false. el.click() now asks for
#   {bubbles: true, cancelable: true} explicitly.
# Order now: window capture, document capture, ancestors, target,
# ancestors bubbling, document bubbling, window bubbling.
# Test: JS-event-order.html 5/5.
diff --git a/content/handlers/javascript/quickjs/macsurf_qjs.c b/content/handlers/javascript/quickjs/macsurf_qjs.c
index e339c60ff..1bfb79a27 100644
--- a/content/handlers/javascript/quickjs/macsurf_qjs.c
+++ b/content/handlers/javascript/quickjs/macsurf_qjs.c
@@ -6759,7 +6759,10 @@ static void qjs_el_install_js_helpers(JSContext *ctx, JSValue proto)
 		 * synthetic click on a link navigating would be a surprising
 		 * side effect to introduce here, and no page tested needs it. */
 		"P.click=function(){"
+		/* VitaBrowser: a click bubbles and can be cancelled (it
+		 * relied on dispatchEvent's old always-bubble default) */
 		"if(this.dispatchEvent)this.dispatchEvent({type:'click',"
+		"bubbles:true,cancelable:true,"
 		"target:this,currentTarget:this,"
 		"preventDefault:function(){},stopPropagation:function(){}});};"
 		/* fixes878 - the node-oriented traversal surface used to be hardcoded
@@ -8175,8 +8178,14 @@ static void qjs_dom_listener_cb(dom_event *evt, void *pw)
 		if (dom_event_get_event_phase(evt, &ph) == DOM_NO_ERR)
 			JS_SetPropertyStr(ctx, evobj, "eventPhase",
 					JS_NewInt32(ctx, (int)ph));
+		/* VitaBrowser: libdom's flag, not false on every node the
+		 * event visits -- a listener further along must see an
+		 * earlier preventDefault (claude.ai's form: the target
+		 * cancelled, the root saw defaultPrevented false). */
+		b = false;
+		(void)dom_event_is_default_prevented(evt, &b);
 		JS_SetPropertyStr(ctx, evobj, "defaultPrevented",
-				JS_NewBool(ctx, 0));
+				JS_NewBool(ctx, b));
 		JS_SetPropertyStr(ctx, evobj, "timeStamp",
 				JS_NewFloat64(ctx, macsurf_qjs_get_now()));
 		/* isTrusted is TRUE only here -- this is the native UI path.
@@ -8724,7 +8733,9 @@ static JSValue qjs_el_dispatch_event_data(JSContext *ctx,
 	dom_string *tds;
 	dom_event *evt = NULL;
 	bool ok_flag = true;
-	bool bubbles = true, cancelable = true;
+	/* VitaBrowser: the spec's defaults (new Event(t) neither bubbles
+	 * nor cancels); true here made every non-bubbling event bubble. */
+	bool bubbles = false, cancelable = false;
 	struct qjs_synth_ev_slot slot;
 	(void)this_val; (void)magic;
 
@@ -12660,17 +12671,29 @@ static void register_browser_globals(JSContext *ctx)
 			 * handler 4 times. Elements already guard this with
 			 * `fresh` in qjs_el_add_event_listener_data; document and
 			 * window share the document node, so they share one gate. */
+			/* VitaBrowser: per (type, capture), as elements do:
+			 * registered once per type, libdom knew the document
+			 * under whichever phase came first, so its (and window's)
+			 * listeners ran in that phase only -- document and window
+			 * bubble listeners fired while CAPTURING, before the
+			 * target, and never while bubbling. */
 			"document._reg={};"
+			"document.__msCap=function(opt){"
+				"return opt===true||!!(opt&&typeof opt==='object'&&opt.capture);};"
 			"document.__msRegOnce=function(t,opt){"
-				"if(document._reg[t])return;"
-				"document._reg[t]=1;"
+				"var k=t+(document.__msCap(opt)?'\001C':'\001B');"
