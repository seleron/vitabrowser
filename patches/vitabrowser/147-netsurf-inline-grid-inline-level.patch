@@ -1581,6 +1583,82 @@ static void layout_minmax_block_inner(
 		}
 	}
 
+	/* VitaBrowser: a grid's intrinsic width is a ROW of its items side
+	 * by side (plus the column gaps), not its widest item. Block
+	 * treatment made a shrink-to-fit grid (inline-grid, a floated grid:
+	 * GitHub's buttons) one column wide. Approximated from the first
+	 * row's in-flow items. */
+	if ((block->type == BOX_GRID || block->type == BOX_INLINE_GRID) &&
+			block->style != NULL) {
+		int32_t packed = 0;
+		int cols = 1;
+		if (css_computed_macsurf_grid(block->style, &packed) ==
+				CSS_MACSURF_GRID_SET)
+			cols = (int)(((uint32_t)packed >> 16) & 0xffff);
+		if (cols > 1) {
+			int n = 0, rmin = 0, rmax = 0, gap = 0;
+			css_fixed gl = 0;
+			css_unit gu = CSS_UNIT_PX;
+			const int32_t *tracks =
+				css_computed_macsurf_grid_tracks(block->style);
+			struct box *c = block->children;
+			/* per column: a px track is its size (layout_grid.c
+			 * packing: unit in bits 31..28, 2 = px, 5 = minmax
+			 * px floor), any other track its first-row item */
+			for (n = 0; n < cols && n < 8; n++) {
+				int tmin = 0, tmax = 0, unit = -1, val = 0;
+				while (c != NULL && c->style != NULL &&
+				       (css_computed_position(c->style) ==
+						CSS_POSITION_ABSOLUTE ||
+					css_computed_position(c->style) ==
+						CSS_POSITION_FIXED))
+					c = c->next;
+				if (c != NULL) {
+					if (c->min_width > 0)
+						tmin = c->min_width;
+					if (c->max_width > 0 && c->max_width !=
+							UNKNOWN_MAX_WIDTH)
+						tmax = c->max_width;
+					c = c->next;
+				}
+				if (tracks != NULL && tracks[n] != 0) {
+					unit = (int)(((uint32_t)tracks[n] >> 28)
+							& 0xF);
+					val = (int)((uint32_t)tracks[n] &
+							0x0FFFFFFFU);
+					if (val & 0x08000000)
+						val |= (int)0xF0000000;
+				}
+				if (unit == 2) {
+					tmin = tmax = val;
+				} else if (unit == 5 && val > 0) {
+					if (tmin < val)
+						tmin = val;
+					if (tmax < val)
+						tmax = val;
+				}
+				rmin += tmin;
+				rmax += tmax;
+			}
+			if (n > 1 && css_computed_column_gap(block->style,
+					&gl, &gu) == CSS_COLUMN_GAP_SET) {
+				gap = FIXTOINT(css_unit_len2device_px(
+						block->style,
+						&content->unit_len_ctx, gl, gu));
+				if (gap < 0)
+					gap = 0;
+				rmin += gap * (n - 1);
+				rmax += gap * (n - 1);
+			}
+			if (rmin > min)
+				min = rmin;
+			if (rmax > max)
+				max = rmax;
+			if (max < min)
+				max = min;
+		}
+	}
+
 	if (max < min) {
 		box_dump(stderr, block, 0, true);
 		assert(0);
