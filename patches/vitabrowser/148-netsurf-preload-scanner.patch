+	/** VitaBrowser preload scanner (html.c): fetches started, and the
+	 * unscanned tail of the previous chunk (a tag split across two) */
+	unsigned int preload_n;
+	unsigned int preload_tail_len;
+	char preload_tail[384];
 	bool parse_completed; /**< Whether the parse has been completed */
 	bool conversion_begun; /**< Whether or not the conversion has begun */
 	bool stylesheets_discovered; /**< Whether explicit <style>/<link> walker has run */
