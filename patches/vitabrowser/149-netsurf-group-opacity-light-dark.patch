 	                if (css_computed_macsurf_animation_opacity(
@@ -2613,6 +2621,9 @@ static bool html_redraw_inline_background(int x, int y, struct box *box,
 	        } else {
 	                pstyle_fill_bg.opacity = (plot_style_fixed)PLOT_STYLE_SCALE;
