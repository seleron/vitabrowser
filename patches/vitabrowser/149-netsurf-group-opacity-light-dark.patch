@@ -4538,11 +4549,71 @@ static bool macsurf_box_node_is_canvas(struct box *box)
 
 
 
+/* VitaBrowser: group opacity. CSS opacity applies to an element and
+ * everything it paints, and multiplies down the tree; the redraw applied
+ * it to background fills only, so opacity:0 (how most sites hide menus,
+ * tooltips and inactive slides -- example.com hides five of its six
+ * languages with it) hid nothing. html_redraw_box composes each box's
+ * opacity into g_group_opacity for its subtree and skips a subtree whose
+ * composed opacity is 0; fills take the ancestors' factor
+ * (g_group_parent) times their own. A box sharing its style with the box
+ * that last composed (a block's own text) is not counted twice. Text,
+ * borders and images at partial opacity still paint opaque. */
+static plot_style_fixed g_group_opacity = (plot_style_fixed)PLOT_STYLE_SCALE;
+static plot_style_fixed g_group_parent = (plot_style_fixed)PLOT_STYLE_SCALE;
+static const css_computed_style *g_group_style = NULL;
+
+static bool html_redraw_box_inner(const html_content *html, struct box *box,
+		int x_parent, int y_parent,
+		const struct rect *clip, const float scale,
+		colour current_background_color,
+		const struct redraw_context *ctx);
+
 bool html_redraw_box(const html_content *html, struct box *box,
 		int x_parent, int y_parent,
 		const struct rect *clip, const float scale,
 		colour current_background_color,
 		const struct redraw_context *ctx)
+{
+	plot_style_fixed saved = g_group_opacity, saved_parent = g_group_parent;
+	const css_computed_style *saved_style = g_group_style;
+	bool ok;
+
+	if (box->style != NULL && box->style != g_group_style) {
+		css_fixed op = 0;
+		int32_t anim = 0;
+		plot_style_fixed own = (plot_style_fixed)PLOT_STYLE_SCALE;
+		if (css_computed_opacity(box->style, &op) == CSS_OPACITY_SET)
+			own = (plot_style_fixed)op;
+		if (css_computed_macsurf_animation_opacity(box->style, &anim) ==
+				CSS_MACSURF_ANIMATION_OPACITY_SET)
+			own = (plot_style_fixed)
+				macsurf_anim_opacity_resolve_plot_fixed(anim);
+		g_group_parent = saved;
+		if (own < (plot_style_fixed)PLOT_STYLE_SCALE)
+			g_group_opacity = (plot_style_fixed)(((int64_t)saved *
+					own) / PLOT_STYLE_SCALE);
+		g_group_style = box->style;
+		if (g_group_opacity <= 0) {
+			g_group_opacity = saved;
+			g_group_parent = saved_parent;
+			g_group_style = saved_style;
+			return true;	/* fully transparent: paints nothing */
+		}
+	}
+	ok = html_redraw_box_inner(html, box, x_parent, y_parent, clip, scale,
+			current_background_color, ctx);
+	g_group_opacity = saved;
+	g_group_parent = saved_parent;
+	g_group_style = saved_style;
+	return ok;
+}
