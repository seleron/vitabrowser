# netsurf: group opacity (opacity:0 hides what it covers) and light-dark()
#
# - CSS opacity applies to an element and everything it paints, and
#   multiplies down the tree; the redraw applied it to background fills
#   only, so opacity:0 -- how most sites hide menus, tooltips, inactive
#   slides, and example.com five of its six languages -- hid nothing.
#   html_redraw_box now composes each box's opacity (incl. the animation
#   override) for its subtree, skips a subtree whose composed opacity is 0,
#   and background fills take their ancestors' factor times their own. A
#   box sharing its style with the one that last composed (a block's own
#   text) is not counted twice. Partial opacity on text, borders and images
#   still paints opaque.
# - light-dark(A, B) -> A in the CSS rewrite pass (the page renders in the
#   light scheme); libcss dropped the whole declaration (example.com's grey
#   background, Tailwind v4 themes).
# - redraw.c: inline grids clip like other containers (patch 147's area).
# Test: CSS-opacity-group.html (hidden text absent from the plot, the
# light-dark box filled).
diff --git a/content/handlers/css/css_rewrite.c b/content/handlers/css/css_rewrite.c
index 94389730b..7c36f4e74 100644
--- a/content/handlers/css/css_rewrite.c
+++ b/content/handlers/css/css_rewrite.c
@@ -5992,6 +5992,77 @@ static char *vita_rewrite_media_calc(const char *data, size_t len,
 	return out;
 }
 
+/* VitaBrowser: light-dark(A, B) -> A. The page renders in the light
+ * scheme (no prefers-color-scheme: dark), so the first colour is the
+ * one a browser shows; libcss does not know the function and dropped
+ * the whole declaration (example.com's grey background, Tailwind v4
+ * themes). NULL when the sheet has none. */
+static char *vita_rewrite_light_dark(const char *d, size_t n, size_t *out_len)
+{
+	static const char key[] = "light-dark(";
+	const size_t kl = sizeof(key) - 1;
+	char *out = NULL;
+	size_t i = 0, o = 0;
+	bool any = false;
+
+	for (i = 0; i + kl <= n; i++) {
+		if ((d[i] == 'l' || d[i] == 'L') &&
+		    strncasecmp(d + i, key, kl) == 0 &&
+		    (i == 0 || !(isalnum((unsigned char)d[i - 1]) ||
+				 d[i - 1] == '-' || d[i - 1] == '_'))) {
+			any = true;
+			break;
+		}
+	}
+	if (!any)
+		return NULL;
+	out = malloc(n + 1);
+	if (out == NULL)
+		return NULL;
+	i = 0;
+	while (i < n) {
+		if (i + kl <= n && (d[i] == 'l' || d[i] == 'L') &&
+		    strncasecmp(d + i, key, kl) == 0 &&
+		    (i == 0 || !(isalnum((unsigned char)d[i - 1]) ||
+				 d[i - 1] == '-' || d[i - 1] == '_'))) {
+			size_t a = i + kl, j = a, comma = 0, close = 0;
+			int depth = 0;
+			char q = 0;
+			for (; j < n; j++) {
+				char c = d[j];
+				if (q) {
+					if (c == '\\' && j + 1 < n)
+						j++;
+					else if (c == q)
+						q = 0;
+					continue;
+				}
+				if (c == '"' || c == '\'') q = c;
+				else if (c == '(') depth++;
+				else if (c == ')') {
+					if (depth == 0) { close = j; break; }
+					depth--;
+				} else if (c == ',' && depth == 0 && !comma)
+					comma = j;
+			}
+			if (close == 0 || comma == 0) {
+				/* malformed: copy verbatim */
+				out[o++] = d[i++];
+				continue;
+			}
+			while (a < comma && isspace((unsigned char)d[a])) a++;
+			memcpy(out + o, d + a, comma - a);
+			o += comma - a;
+			i = close + 1;
+			continue;
+		}
+		out[o++] = d[i++];
+	}
+	out[o] = '\0';
+	*out_len = o;
+	return out;
+}
