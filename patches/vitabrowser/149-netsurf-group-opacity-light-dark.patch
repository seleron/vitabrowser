 {
@@ -6030,6 +6101,21 @@ char *macsurf_css_rewrite(const char *data, size_t in_size, size_t *out_size)
 	if (in_size > (size_t)0x7fffffff)
 		return NULL;
 
+	/* VitaBrowser: light-dark() resolves to its light colour */
+	{
+		size_t ld_len = 0;
+		char *ld = vita_rewrite_light_dark(data, in_size, &ld_len);
+		if (ld != NULL) {
+			char *r = macsurf_css_rewrite(ld, ld_len, out_size);
+			if (r == NULL) {
+				*out_size = ld_len;
+				return ld;
+			}
+			free(ld);
+			return r;
+		}
+	}
+
 	/* VitaBrowser: calc() in @media preludes, before anything else. */
 	{
 		size_t mq_len = 0;
