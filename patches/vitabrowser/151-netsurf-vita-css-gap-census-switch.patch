# netsurf: the simulator's switch for the CSS gap census (VITA_CSSGAP=1)
#
# Sets libcss's css_gap_census when the environment asks (host simulator
# only; never compiled into the Vita build). tools/scorecard sets it.
diff --git a/frontends/vita/main.c b/frontends/vita/main.c
index 7d4ab70a5..8f7ccb9c4 100644
--- a/frontends/vita/main.c
+++ b/frontends/vita/main.c
@@ -1328,6 +1328,14 @@ int main(int argc, char **argv)
 	vita_diag_log("init: messages -> %d", ret);
 
 	vita_chrome_load_useragent();
+#ifdef VITA_HOST_SIM
+	/* tools/scorecard: log each distinct CSS declaration libcss drops */
+	{
+		extern int css_gap_census;
+		if (getenv("VITA_CSSGAP") != NULL)
+			css_gap_census = 1;
+	}
+#endif
 	ret = netsurf_init(NULL);
 	vita_diag_log("init: netsurf_init -> %d", ret);
 	if (ret != NSERROR_OK) {
