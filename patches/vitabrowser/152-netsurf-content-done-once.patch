# netsurf: a content set done twice keeps its load time
#
# content_set_done stored `now - start` in c->time; a second call (it
# happens) computed `now - elapsed`, i.e. the clock: the status bar read
# "Done (118833.1s)" (make.wordpress.org). Only the first call measures.
diff --git a/content/content.c b/content/content.c
index 097548c77..513a516d4 100644
--- a/content/content.c
+++ b/content/content.c
@@ -385,8 +385,11 @@ void content_set_done(struct content *c)
 
 	nsu_getmonotonic_ms(&now_ms);
 
+	/* VitaBrowser: done twice (it happens) turned the elapsed time back
+	 * into a clock reading: "Done (118833.1s)". Only the first counts. */
+	if (c->status != CONTENT_STATUS_DONE)
+		c->time = now_ms - c->time;
 	c->status = CONTENT_STATUS_DONE;
-	c->time = now_ms - c->time;
 	content_update_status(c);
 	content_broadcast(c, CONTENT_MSG_DONE, NULL);
 }
