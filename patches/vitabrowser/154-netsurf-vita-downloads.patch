+static bool download_ok(const char *name, char *detail, size_t max)
+{
+	/* vita/download.c saves to ux0:download/ (cwd-relative, as the
+	 * WIP's VITA_DOWNLOAD_DIR). The gate in tools/run-vita-sim.sh
+	 * re-checks the whole file byte for byte against the bundled
+	 * testpages target; here only the shape is checked. */
+	char path[256];
+	FILE *fp;
+	char buf[32];
+	long sz = 0;
+
+	snprintf(path, sizeof path, "ux0:download/%s", name);
+	fp = fopen(path, "rb");
+	if (fp == NULL) {
+		snprintf(detail, max, "%s missing (card: errno %d)",
+			 path, errno);
+		return false;
+	}
+	if (fseek(fp, 0, SEEK_END) != 0 || (sz = ftell(fp)) < 0)
+		sz = 0;
+	rewind(fp);
+	if (fread(buf, 1, sizeof buf - 1, fp) == 0)
+		buf[0] = '\0';
+	buf[sizeof buf - 1] = '\0';
+	fclose(fp);
+	snprintf(detail, max, "%s: %ld bytes, starts \"%s\"",
+		 name, sz, buf);
+	return sz == 1024 && strncmp(buf, "VitaBrowser-download-ok ",
+					  24) == 0;
+}
+
 /** Check the step just settled; log it. */
 static void check(struct gui_window *gw, const struct step *s)
 {
@@ -274,7 +311,10 @@ static void check(struct gui_window *gw, const struct step *s)
 		ok = cookie_ok(detail, sizeof(detail));
 		break;
 	case C_TYPED:
-		ok = typed_ok(detail, sizeof(detail));
+		ok = typed_ok(detail, sizeof detail);
+		break;
+	case C_DOWNLOAD:
+		ok = download_ok(s->expect, detail, sizeof detail);
 		break;
 	case C_NONE:
 		ok = true;
