+
+/**
+ * \file
+ * Downloads to the memory card (brief Phase 1 item 9).
+ *
+ * A response the engine does not display (a VPK, a zip, <a download>) is
+ * saved to ux0:download/ -- the folder VitaShell and other file managers
+ * show -- under its Content-Disposition or URL name, made safe for the
+ * card and unique ("name (2).ext"). Progress and the result go to the
+ * on-screen message line and log.txt; a failed download removes its
+ * partial file. The list of saved files is on the home page.
+ */
+
+#include <errno.h>
+#include <stdbool.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/stat.h>
+#include <sys/types.h>
+
+#include "utils/errors.h"
+#include "utils/nsurl.h"
+#include "netsurf/download.h"
+#include "desktop/download.h"
+
+#include "vita/diag.h"
+#include "vita/download.h"
+
+#ifndef VITA_DOWNLOAD_DIR
+#define VITA_DOWNLOAD_DIR "ux0:download/"
+#endif
+
+struct gui_download_window {
+	download_context *ctx;
+	FILE *fp;
+	char name[128];
+	char path[256];
+	unsigned long long got, total;
+	unsigned int last_ms;
+};
+
+unsigned int vita_downloads_done;	/**< completed this session */
+char vita_download_last[256];		/**< path of the last one saved */
+
+/* one file name, safe on the card: no path separators, no drive colon, no
+ * control characters, not empty */
+static void safe_name(const char *in, char *out, size_t max)
+{
+	size_t o = 0;
+	const char *p;
+
+	if (in == NULL)
+		in = "";
+	/* last path component only */
+	for (p = in; *p != '\0'; p++)
+		if (*p == '/' || *p == '\\')
+			in = p + 1;
+	for (p = in; *p != '\0' && o + 1 < max; p++) {
+		unsigned char c = (unsigned char)*p;
+		if (c < 0x20 || c == ':' || c == '*' || c == '?' ||
+		    c == '"' || c == '<' || c == '>' || c == '|')
+			c = '_';
+		out[o++] = (char)c;
+	}
+	while (o > 0 && (out[o - 1] == '.' || out[o - 1] == ' '))
+		o--;
+	out[o] = '\0';
+	if (o == 0)
+		snprintf(out, max, "download");
+}
+
+/* VITA_DOWNLOAD_DIR + name, "name (2).ext" if taken */
+static void unique_path(const char *name, char *path, size_t max)
+{
+	const char *dot = strrchr(name, '.');
+	size_t stem = dot != NULL && dot != name ? (size_t)(dot - name)
+						  : strlen(name);
+	struct stat st;
+	int n;
+
+	snprintf(path, max, "%s%s", VITA_DOWNLOAD_DIR, name);
+	for (n = 2; stat(path, &st) == 0 && n < 1000; n++)
+		snprintf(path, max, "%s%.*s (%d)%s", VITA_DOWNLOAD_DIR,
+			 (int)stem, name, n, dot != NULL && dot != name ?
+			 dot : "");
+}
+
+static struct gui_download_window *
+vita_download_create(download_context *ctx, struct gui_window *parent)
+{
+	struct gui_download_window *dw;
+	nsurl *url = download_context_get_url(ctx);
+
+	(void)parent;
+	dw = calloc(1, sizeof(*dw));
+	if (dw == NULL)
+		return NULL;
+	dw->ctx = ctx;
+	dw->total = download_context_get_total_length(ctx);
+	safe_name(download_context_get_filename(ctx), dw->name,
+		  sizeof(dw->name));
+	mkdir(VITA_DOWNLOAD_DIR, 0777);
+	unique_path(dw->name, dw->path, sizeof(dw->path));
+	dw->fp = fopen(dw->path, "wb");
+	if (dw->fp == NULL) {
+		vita_diag_log("download: cannot create %s (errno %d)",
+			      dw->path, errno);
+		vita_show_message(4000, "download failed: cannot write %s",
+			     dw->path);
+		free(dw);
+		return NULL;
+	}
+	vita_diag_log("download: %s -> %s (%llu bytes, %s)",
+		      url != NULL ? nsurl_access(url) : "?", dw->path,
+		      dw->total, download_context_get_mime_type(ctx));
+	vita_show_message(0, "downloading %s...", dw->name);
+	dw->last_ms = vita_diag_ms();
+	return dw;
+}
+
+static nserror vita_download_data(struct gui_download_window *dw,
+		const char *data, unsigned int size)
+{
+	unsigned int now;
+
+	if (dw == NULL || dw->fp == NULL)
+		return NSERROR_SAVE_FAILED;
+	if (size > 0 && fwrite(data, 1, size, dw->fp) != size) {
+		vita_diag_log("download: write failed on %s (errno %d)",
+			      dw->path, errno);
+		return NSERROR_SAVE_FAILED;
+	}
+	dw->got += size;
+	now = vita_diag_ms();
+	if (now - dw->last_ms >= 500) {
+		dw->last_ms = now;
+		if (dw->total > 0)
+			vita_show_message(0, "downloading %s: %llu%% (%llu KiB)",
+				     dw->name, dw->got * 100 / dw->total,
+				     dw->got / 1024);
+		else
+			vita_show_message(0, "downloading %s: %llu KiB", dw->name,
+				     dw->got / 1024);
+	}
+	return NSERROR_OK;
+}
+
+static void vita_download_error(struct gui_download_window *dw,
+		const char *msg)
+{
+	if (dw == NULL)
+		return;
+	if (dw->fp != NULL) {
+		fclose(dw->fp);
+		dw->fp = NULL;
+		remove(dw->path);
+	}
+	vita_diag_log("download: %s failed: %s", dw->path,
+		      msg != NULL ? msg : "?");
+	vita_show_message(5000, "download failed: %s", msg != NULL ? msg : "?");
+	free(dw);
+}
+
+static void vita_download_done(struct gui_download_window *dw)
+{
+	if (dw == NULL)
+		return;
+	if (dw->fp != NULL)
+		fclose(dw->fp);
+	vita_downloads_done++;
+	snprintf(vita_download_last, sizeof(vita_download_last), "%s",
+		 dw->path);
+	vita_diag_log("download: saved %s (%llu bytes)", dw->path, dw->got);
+	vita_show_message(5000, "saved %s", dw->path);
+	free(dw);
+}
+
+static struct gui_download_table download_table = {
+	.create = vita_download_create,
+	.data = vita_download_data,
+	.error = vita_download_error,
+	.done = vita_download_done,
+};
+
+struct gui_download_table *vita_download_table = &download_table;
