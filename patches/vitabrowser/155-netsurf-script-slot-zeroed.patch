# netsurf: a new script slot starts zeroed (garbage handle released at close)
#
# html_process_new_script set the new slot field by field and never its
# data union, so a script whose fetch could not start (old.reddit.com: a
# blob: URL script, rc=3) kept realloc's garbage in data.handle, and
# html_close released it: segfault leaving old.reddit.com once its
# web-components polyfill got far enough to insert that script (patch 153).
# The slot is zeroed first.
diff --git a/content/handlers/html/script.c b/content/handlers/html/script.c
index f12bc6b4e..f7d507f23 100644
--- a/content/handlers/html/script.c
+++ b/content/handlers/html/script.c
@@ -398,6 +398,12 @@ html_process_new_script(html_content *c,
 	nscript = &c->scripts[c->scripts_count];
 	c->scripts_count++;
 
+	/* VitaBrowser: the whole slot, not field by field -- data.handle was
+	 * never set, so a script whose fetch could not start kept realloc's
+	 * garbage there and html_close released it (old.reddit.com segfault
+	 * once its web-components polyfill ran, patch 153) */
+	memset(nscript, 0, sizeof(*nscript));
+
 	nscript->already_started = false;
 	nscript->parser_inserted = false;
 	nscript->force_async = true;
