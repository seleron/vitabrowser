# netsurf: .text on <script>, <title>, <a> and <option>
#
# HTMLScriptElement.text (and title/a/option .text) is the element's text;
# it was undefined, so wordpress.org's emoji module ran
# JSON.parse(script.text) and threw "SyntaxError: unexpected token
# 'undefined'" -- the only JS error shared by both WordPress sites in the
# scorecard's census (jsgaps.md).
# Test: JS-interfaces.html case 9.
diff --git a/content/handlers/javascript/quickjs/vita_polyfill.inc b/content/handlers/javascript/quickjs/vita_polyfill.inc
index f1cca9c1c..c7792f6f1 100644
--- a/content/handlers/javascript/quickjs/vita_polyfill.inc
+++ b/content/handlers/javascript/quickjs/vita_polyfill.inc
@@ -4434,5 +4434,24 @@
 "\t\t\t} });\n"
 "\t\t} catch (e) { /* */ }\n"
 "})();\n"
+"\n"
+"/* ---- .text on script, title, a, option ---------------------------------\n"
+" * HTMLScriptElement.text (and title/a/option .text) is the element's text;\n"
+" * it was undefined, so wordpress.org's emoji module ran\n"
+" * JSON.parse(script.text) -> \"SyntaxError: unexpected token 'undefined'\"\n"
+" * (both WordPress sites in the scorecard). */\n"
+"(function () {\n"
+"\tvar d = g.document;\n"
+"\tif (!d || typeof d.createElement !== 'function') return;\n"
+"\t['script', 'title', 'a', 'option'].forEach(function (tag) {\n"
+"\t\ttry {\n"
+"\t\t\tvar el = d.createElement(tag), P = Object.getPrototypeOf(el);\n"
+"\t\t\tif (!P || P === Object.prototype || 'text' in el) return;\n"
+"\t\t\tObject.defineProperty(P, 'text', { configurable: true, enumerable: true,\n"
+"\t\t\t\tget: function () { return this.textContent; },\n"
+"\t\t\t\tset: function (v) { this.textContent = String(v); } });\n"
+"\t\t} catch (e) { /* */ }\n"
+"\t});\n"
+"})();\n"
 "})(this);\n"
 "\n"
diff --git a/content/handlers/javascript/quickjs/vita_polyfill.js b/content/handlers/javascript/quickjs/vita_polyfill.js
index 4fd4f3651..862067c6c 100644
--- a/content/handlers/javascript/quickjs/vita_polyfill.js
+++ b/content/handlers/javascript/quickjs/vita_polyfill.js
@@ -4433,4 +4433,23 @@ if (typeof g.PerformanceObserver === 'function' && !Array.isArray(g.PerformanceO
 			} });
 		} catch (e) { /* */ }
 })();
+
+/* ---- .text on script, title, a, option ---------------------------------
+ * HTMLScriptElement.text (and title/a/option .text) is the element's text;
+ * it was undefined, so wordpress.org's emoji module ran
+ * JSON.parse(script.text) -> "SyntaxError: unexpected token 'undefined'"
+ * (both WordPress sites in the scorecard). */
+(function () {
+	var d = g.document;
+	if (!d || typeof d.createElement !== 'function') return;
+	['script', 'title', 'a', 'option'].forEach(function (tag) {
+		try {
+			var el = d.createElement(tag), P = Object.getPrototypeOf(el);
+			if (!P || P === Object.prototype || 'text' in el) return;
+			Object.defineProperty(P, 'text', { configurable: true, enumerable: true,
+				get: function () { return this.textContent; },
+				set: function (v) { this.textContent = String(v); } });
+		} catch (e) { /* */ }
+	});
+})();
 })(this);
