+/* 3. The next level: the imports of every module of urls[0..n) (saved
+ *    ones for card entries, scanned text for the rest), into next (up to
+ *    QJS_MODULE_MAX_COUNT). Frees urls' strings. */
+static unsigned int qjs_crawl_level_next(struct module_registry *reg,
+	char **urls, unsigned int n, char **next)
+{
+	unsigned int i, nn = 0;
+	for (i = 0; i < n; i++) {
+		struct module_entry *e = qjs_module_find(reg, urls[i]);
+		if (e != NULL && e->imports != NULL) {
+			/* from the cache: its saved imports */
+			const char *u = e->imports;
+			while (u < e->imports + e->imports_len) {
+				nn = qjs_module_add_next(reg, u, next, nn,
+					QJS_MODULE_MAX_COUNT);
+				u += strlen(u) + 1;
+			}
+		} else if (e != NULL && e->source != NULL &&
+				reg->count < QJS_MODULE_MAX_COUNT &&
+				reg->bytes < QJS_MODULE_MAX_BYTES)
+			nn = qjs_module_scan(reg, e->name, e->source,
+				e->srclen, next, nn, QJS_MODULE_MAX_COUNT);
+		free(urls[i]);
+	}
+	return nn;
+}
