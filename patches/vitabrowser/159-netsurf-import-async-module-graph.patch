+/* Loader: compile a module given its normalized name, from the registry
+ * (qjs_module_crawl put the graph there), else -- a dynamic import(), or
+ * anything the scan missed -- fetch it and its static graph now. */
+static JSModuleDef *qjs_module_loader(JSContext *ctx,
+	const char *module_name, void *opaque)
+{
+	struct module_registry *reg = (struct module_registry *)opaque;
+	struct module_entry *e;
+
+	if (reg == NULL || module_name == NULL)
+		return NULL;
+	qjs_module_registry_for_nav(reg);
+	e = qjs_module_find(reg, module_name);
+	if (e != NULL && e->compiled) {
+		/* Compiled in an earlier realm: fetch it again. */
+		struct module_entry **pp = &reg->head;
+		while (*pp != e) pp = &(*pp)->next;
+		*pp = e->next;
+		reg->count--;
+		free(e->name);
+		free(e);
+		e = NULL;
+	}
