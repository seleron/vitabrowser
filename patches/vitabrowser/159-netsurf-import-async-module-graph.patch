+/* One level of a module graph, in three steps shared by the blocking
+ * crawl below and the non-blocking one (qjs_modload, dynamic import()).
+ *
+ * 1. Of urls[0..n), register the hash-named ones the card has (neither
+ *    fetched nor parsed) and list the rest, not registered yet, in want. */
+static unsigned int qjs_crawl_level_want(struct module_registry *reg,
+	char **urls, unsigned int n, const char **want, unsigned int *cached)
+{
+	unsigned int i, nw = 0;
+	for (i = 0; i < n; i++) {
+		if (qjs_module_find(reg, urls[i]) != NULL)
+			continue;
+#ifdef MACSURF_JSCACHE_DIR
+		/* Hash-named and cached: neither fetched nor parsed. */
+		if (qjs_url_immutable(urls[i])) {
+			struct module_entry tmp;
+			uint32_t sl, sh;
+			memset(&tmp, 0, sizeof(tmp));
+			if (qjs_jscache_load(urls[i], &tmp, &sl, &sh)) {
+				struct module_entry *ce =
+					qjs_module_register(reg,
+						urls[i], NULL, 0);
+				if (ce != NULL) {
+					ce->bc = tmp.bc;
+					ce->bc_len = tmp.bc_len;
+					ce->imports = tmp.imports;
+					ce->imports_len = tmp.imports_len;
+					(*cached)++;
+					continue;
+				}
+				free(tmp.bc);
+				free(tmp.imports);
+			}
+		}
+#endif
+		want[nw++] = urls[i];
+	}
+	return nw;
+}
+
+/* 2. Register what was fetched for want[0..nw) (res[i]; each data is
+ *    freed), reusing card bytecode where the text is unchanged. */
+static void qjs_crawl_level_take(struct module_registry *reg,
+	const char **want, unsigned int nw, struct fetch_blocking_body *res,
+	unsigned int *fetched, unsigned int *failed, size_t *bytes)
+{
+	unsigned int i;
+	for (i = 0; i < nw; i++) {
+		int good = res[i].data != NULL &&
+			res[i].status >= 200 && res[i].status < 300;
+		struct module_entry *fe = qjs_module_register(reg,
+			want[i], good ? res[i].data : NULL, res[i].len);
+		if (good) {
+			(*fetched)++;
+			*bytes += res[i].len;
+#ifdef MACSURF_JSCACHE_DIR
+			/* The same text compiled before: reuse it. */
+			if (fe != NULL && fe->source != NULL) {
+				uint32_t sl, sh;
+				struct module_entry tmp;
+				memset(&tmp, 0, sizeof(tmp));
+				if (qjs_jscache_load(want[i], &tmp, &sl, &sh) &&
+				    sl == fe->srclen &&
+				    sh == qjs_fnv32(fe->source, fe->srclen)) {
+					fe->bc = tmp.bc;
+					fe->bc_len = tmp.bc_len;
+					fe->imports = tmp.imports;
+					fe->imports_len = tmp.imports_len;
+				} else {
+					free(tmp.bc);
+					free(tmp.imports);
+				}
+			}
+#else
+			(void)fe;
+#endif
+		} else {
+			(*failed)++;
+			macsurf_debug_log_writef(
+				"LIFE module fetch FAILED status=%ld %s",
+				res[i].status, want[i]);
+		}
+		free(res[i].data);
+		res[i].data = NULL;
+	}
+}
