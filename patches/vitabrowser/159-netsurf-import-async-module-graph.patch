+/* Run every pipeline one step; called once per event-loop pass from
+ * macsurf_qjs_pump_all. A finished one re-queues its import() jobs. */
+static void qjs_modload_pump(void)
+{
+	struct qjs_modload **pp = &g_modloads;
+	while (*pp != NULL) {
+		struct qjs_modload *m = *pp;
+		int live = qjs_ctx_live_rt(m->ctx) != NULL;
+		int done;
+		if (!live || m->nav_seq != g_qjs_nav_seq) {
+			*pp = m->next;
+			/* a dead realm's values went with it */
+			qjs_modload_free(m, live);
+			continue;
+		}
+		{
+			/* a finished level starts the next at once: a few
+			 * steps while QJS_MODLOAD_STEP_MS lasts */
+			extern double macos9_micros(void);
+			double t0 = macos9_micros();
+			int k;
+			done = 0;
+			for (k = 0; k < 8 && !done; k++) {
+				done = qjs_modload_step(m);
+				if ((macos9_micros() - t0) / 1000.0 >=
+						QJS_MODLOAD_STEP_MS)
+					break;
+			}
+		}
+		if (done) {
+			int j;
+			*pp = m->next;
+			for (j = 0; j < m->njobs; j++)
+				JS_EnqueueJob(m->ctx, m->jobs[j].job,
+					m->jobs[j].argc,
+					(JSValueConst *)m->jobs[j].argv);
+			qjs_modload_free(m, 1);
+			continue;
+		}
+		pp = &m->next;
+	}
+}
