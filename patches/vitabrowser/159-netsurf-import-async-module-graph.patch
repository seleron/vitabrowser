+/* JSModuleDeferFunc (patches/quickjs/03): keep an import() job whose graph
+ * is not loaded yet. */
+static int qjs_module_defer(JSContext *ctx, const char *basename,
+	const char *filename, int argc, JSValueConst *argv, JSJobFunc *job,
+	void *opaque)
+{
+	struct module_registry *reg = (struct module_registry *)opaque;
+	struct module_entry *e;
+	struct qjs_modload *m;
+	char *url;
+	int k, count = 0;
+
+	if (reg == NULL || argc > 6 || filename == NULL)
+		return 0;
+	qjs_module_registry_for_nav(reg);
+	url = qjs_module_resolve(qjs_module_base(ctx, basename), filename,
+		strlen(filename));
+	if (url == NULL)
+		return 0;		/* bare specifier: fails as before */
+	e = qjs_module_find(reg, url);
+	if (e != NULL && (e->compiled ||
+			  (e->source == NULL && e->bc == NULL))) {
+		/* loaded -- or its fetch failed: import it now (the
+		 * loader reports the failure as before) */
+		free(url);
+		return 0;
+	}
+	for (m = g_modloads; m != NULL; m = m->next, count++)
+		if (m->ctx == ctx && strcmp(m->root, url) == 0)
+			break;
+	if (m == NULL) {
+		if (count >= QJS_MODLOAD_MAX) {
+			free(url);
+			return 0;	/* too many at once: load inline */
+		}
+		m = (struct qjs_modload *)calloc(1, sizeof(*m));
+		if (m == NULL) {
+			free(url);
+			return 0;
+		}
+		m->urls = (char **)calloc(QJS_MODULE_MAX_COUNT,
+			sizeof(*m->urls));
+		m->carry = (char **)calloc(QJS_MODULE_MAX_COUNT,
+			sizeof(*m->carry));
+		m->root = strdup(url);
+		if (m->urls == NULL || m->root == NULL || m->carry == NULL) {
+			free(m->carry);
+			free(m->urls);
+			free(m->root);
+			free(m);
+			free(url);
+			return 0;
+		}
+		m->urls[0] = strdup(url);
+		m->n = m->urls[0] != NULL ? 1 : 0;
+		m->ctx = ctx;
+		m->reg = reg;
+		m->nav_seq = g_qjs_nav_seq;
+		{
+			extern double macos9_micros(void);
+			m->t0 = macos9_micros();
+		}
+		m->next = g_modloads;
+		g_modloads = m;
+	}
+	free(url);
+	if (m->njobs >= QJS_MODLOAD_JOBS)
+		return 0;
+	m->jobs[m->njobs].job = job;
+	m->jobs[m->njobs].argc = argc;
+	for (k = 0; k < argc; k++)
+		m->jobs[m->njobs].argv[k] = JS_DupValue(ctx, argv[k]);
+	m->njobs++;
+	return 1;
+}
+
+/* One step of pipeline m; returns 1 when it is finished. */
+static int qjs_modload_step(struct qjs_modload *m)
+{
+	extern double macos9_micros(void);
+	if (m->phase == 0) {
+		if (m->set == NULL) {
+			if (m->n == 0) {
+				m->phase = 1;
+				macsurf_debug_log_writef(
+					"LIFE module graph (async): %u fetched "
+					"(%lu KiB), %u from the card, %u failed, "
+					"%u levels, %ld ms; registry %u modules",
+					m->fetched,
+					(unsigned long)(m->bytes / 1024),
+					m->cached, m->failed, m->levels,
+					(long)((macos9_micros() - m->t0) / 1000),
+					m->reg->count);
+				return 0;
+			}
+			free(m->want);
+			m->want = (const char **)calloc(m->n, sizeof(*m->want));
+			if (m->want == NULL)
+				return 1;
+			m->nw = qjs_crawl_level_want(m->reg, m->urls, m->n,
+				m->want, &m->cached);
+			/* one fetch per module: a URL another pipeline is
+			 * fetching now is not fetched again here; it is
+			 * carried to this pipeline's next level, where it is
+			 * registered and gets scanned (claude.ai's import()
+			 * graphs share most of their modules) */
+			{
+				unsigned int i, w = 0;
+				m->ncarry = 0;
+				for (i = 0; i < m->nw; i++) {
+					if (qjs_modload_in_flight(m, m->want[i]) &&
+					    m->ncarry < QJS_MODULE_MAX_COUNT) {
+						char *c = strdup(m->want[i]);
+						if (c != NULL)
+							m->carry[m->ncarry++] = c;
+						continue;
+					}
+					m->want[w++] = m->want[i];
+				}
+				m->nw = w;
+			}
+			if (m->nw > 0) {
+				m->set = fetch_get_set_start(m->want, m->nw,
+					NULL);
+				if (m->set == NULL)
+					return 1;
+				return 0;
+			}
+		} else {
+			unsigned int i;
+			struct fetch_blocking_body *res;
+			if (!fetch_get_set_step(m->set))
+				return 0;
+			res = (struct fetch_blocking_body *)calloc(m->nw,
+				sizeof(*res));
+			if (res == NULL)
+				return 1;
+			for (i = 0; i < m->nw; i++) {
+				struct fetch_blocking_body *b =
+					fetch_get_set_body(m->set, i);
+				if (b != NULL) {
+					res[i] = *b;
+					b->data = NULL;	/* now ours */
+				}
+			}
+			qjs_crawl_level_take(m->reg, m->want, m->nw, res,
+				&m->fetched, &m->failed, &m->bytes);
+			free(res);
+			fetch_get_set_free(m->set);
+			m->set = NULL;
+		}
+		/* this level is in: on to the next */
+		{
+			char **next = (char **)calloc(QJS_MODULE_MAX_COUNT,
+				sizeof(*next));
+			unsigned int nn;
+			if (next == NULL)
+				return 1;
+			nn = qjs_crawl_level_next(m->reg, m->urls, m->n, next);
+			{
+				unsigned int i;
+				/* carried URLs: look again next level
+				 * (registered by then, or still in flight) */
+				for (i = 0; i < m->ncarry; i++) {
+					unsigned int k;
+					int dup = 0;
+					for (k = 0; k < nn; k++)
+						if (strcmp(next[k],
+							   m->carry[i]) == 0)
+							dup = 1;
+					if (!dup && nn < QJS_MODULE_MAX_COUNT)
+						next[nn++] = m->carry[i];
+					else
+						free(m->carry[i]);
+				}
+				m->ncarry = 0;
+			}
+			free(m->urls);
+			m->urls = next;
+			m->n = nn;
+			m->levels++;
+		}
+		return 0;
+	}
+	/* compile: whatever the registry has fetched and not compiled, one
+	 * after another while the slice lasts -- but not while another
+	 * pipeline on this registry still fetches: compiling frees a
+	 * module's text, which that one may not have scanned for its next
+	 * level yet */
+	{
+		double t0 = macos9_micros();
+		struct qjs_modload *o;
+		for (o = g_modloads; o != NULL; o = o->next)
+			if (o != m && o->reg == m->reg && o->phase == 0)
+				return 0;
+		for (;;) {
+			struct module_entry *e;
+			JSModuleDef *def;
+			double t1;
+			for (e = m->reg->head; e != NULL; e = e->next)
+				if (!e->compiled &&
+				    (e->source != NULL || e->bc != NULL))
+					break;
+			if (e == NULL) {
+				macsurf_debug_log_writef(
+					"LIFE module compile (async): %u in %u "
+					"steps, longest %ld ms; import() of %s "
+					"ready after %ld ms",
+					m->compiled, m->steps,
+					(long)m->longest_ms, m->root,
+					(long)((macos9_micros() - m->t0) / 1000));
+				return 1;
+			}
+			t1 = macos9_micros();
+			def = qjs_module_compile_entry(m->ctx, m->reg, e,
+				e->name);
+			if (def == NULL)
+				/* stays pending in ctx; the import() that
+				 * links it will report it */
+				JS_FreeValue(m->ctx, JS_GetException(m->ctx));
+			m->compiled++;
+			t1 = (macos9_micros() - t1) / 1000.0;
+			if (t1 > m->longest_ms)
+				m->longest_ms = t1;
+			if ((macos9_micros() - t0) / 1000.0 >=
+					QJS_MODLOAD_SLICE_MS)
+				break;
+		}
+		m->steps++;
+		return 0;
+	}
+}
