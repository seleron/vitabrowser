+/* ---- fetch_get_set: the same, without blocking ----------------------- */
+
+/** Transfers one set runs at once (several sets may run together). */
+#define SET_PARALLEL 8
+
+struct fetch_get_set {
+	CURLM *multi;
+	unsigned int n, active, left;
+	char **urls;
+	char *referer;
+	struct curl_slist **resolve;
+	CURL **handle;
+	unsigned char *state;	/* 0 waiting, 1 running, 2 done */
+	struct fetch_blocking_body *res;
+	uint64_t t0;
+};
+
+/* exported interface documented in content/fetch.h */
+void fetch_get_set_free(struct fetch_get_set *set)
+{
+	unsigned int i;
+
+	if (set == NULL)
+		return;
+	for (i = 0; i < set->n; i++) {
+		if (set->handle != NULL && set->handle[i] != NULL) {
+			curl_multi_remove_handle(set->multi, set->handle[i]);
+			curl_easy_cleanup(set->handle[i]);
+		}
+		if (set->resolve != NULL && set->resolve[i] != NULL)
+			curl_slist_free_all(set->resolve[i]);
+		if (set->res != NULL)
+			free(set->res[i].data);
+		if (set->urls != NULL)
+			free(set->urls[i]);
+	}
+	if (set->multi != NULL)
+		curl_multi_cleanup(set->multi);
+	free(set->urls);
+	free(set->referer);
+	free(set->resolve);
+	free(set->handle);
+	free(set->state);
+	free(set->res);
+	free(set);
+}
+
+/* exported interface documented in content/fetch.h */
+struct fetch_get_set *fetch_get_set_start(const char *const *urls,
+		unsigned int n, const char *referer)
+{
+	struct fetch_get_set *set = calloc(1, sizeof(*set));
+	unsigned int i;
+
+	if (set == NULL)
+		return NULL;
+	set->n = n;
+	set->left = n;
+	set->multi = curl_multi_init();
+	set->urls = calloc(n + 1, sizeof(*set->urls));
+	set->resolve = calloc(n + 1, sizeof(*set->resolve));
+	set->handle = calloc(n + 1, sizeof(*set->handle));
+	set->state = calloc(n + 1, 1);
+	set->res = calloc(n + 1, sizeof(*set->res));
+	set->referer = referer != NULL ? strdup(referer) : NULL;
+	if (set->multi == NULL || set->urls == NULL || set->resolve == NULL ||
+	    set->handle == NULL || set->state == NULL || set->res == NULL) {
+		fetch_get_set_free(set);
+		return NULL;
+	}
+	for (i = 0; i < n; i++) {
+		set->urls[i] = strdup(urls[i]);
+		if (set->urls[i] == NULL) {
+			set->state[i] = 2;	/* counts as failed */
+			set->left--;
+		}
+	}
+	nsu_getmonotonic_ms(&set->t0);
+	return set;
+}
+
+/* exported interface documented in content/fetch.h */
+bool fetch_get_set_step(struct fetch_get_set *set)
+{
+	unsigned int i;
+	int running, queued;
+	CURLMsg *msg;
+	uint64_t now;
+
+	if (set == NULL || set->left == 0)
+		return true;
+	for (i = 0; i < set->n && set->active < SET_PARALLEL; i++) {
+		int r;
+		if (set->state[i] != 0)
+			continue;
+		if (fetch_blocking_file(set->urls[i], &set->res[i])) {
+			set->state[i] = 2;
+			set->left--;
+			continue;
+		}
+		r = fetch_blocking_start(set->multi, set->urls[i],
+				set->referer, set->res, i, &set->resolve[i],
+				&set->handle[i]);
+		if (r == 1) {
+			set->state[i] = 1;
+			set->active++;
+		} else if (r < 0) {
+			set->state[i] = 2;
+			set->left--;
+		}
+	}
+	curl_multi_perform(set->multi, &running);
+	while ((msg = curl_multi_info_read(set->multi, &queued)) != NULL) {
+		void *priv = NULL;
+		if (msg->msg != CURLMSG_DONE)
+			continue;
+		curl_easy_getinfo(msg->easy_handle, CURLINFO_PRIVATE, &priv);
+		i = (unsigned int)(uintptr_t)priv;
+		if (msg->data.result == CURLE_OK)
+			curl_easy_getinfo(msg->easy_handle,
+					CURLINFO_RESPONSE_CODE,
+					&set->res[i].status);
+		else
+			NSLOG(netsurf, INFO, "%s: %s", set->urls[i],
+			      curl_easy_strerror(msg->data.result));
+		curl_multi_remove_handle(set->multi, msg->easy_handle);
+		curl_easy_cleanup(msg->easy_handle);
+		set->handle[i] = NULL;
+		set->state[i] = 2;
+		set->active--;
+		set->left--;
+	}
+	nsu_getmonotonic_ms(&now);
+	if (set->left > 0 && now - set->t0 > BLOCKING_TIMEOUT_S * 1000) {
+		NSLOG(netsurf, WARNING, "gave up on %u of %u", set->left,
+		      set->n);
+		for (i = 0; i < set->n; i++) {
+			if (set->handle[i] != NULL) {
+				curl_multi_remove_handle(set->multi,
+						set->handle[i]);
+				curl_easy_cleanup(set->handle[i]);
+				set->handle[i] = NULL;
+			}
+			if (set->state[i] != 2) {
+				free(set->res[i].data);
+				set->res[i].data = NULL;
+				set->res[i].len = 0;
+				set->res[i].status = 0;
+				set->state[i] = 2;
+			}
+		}
+		set->left = 0;
+	}
+	return set->left == 0;
+}
+
+/* exported interface documented in content/fetch.h */
+struct fetch_blocking_body *fetch_get_set_body(struct fetch_get_set *set,
+		unsigned int i)
+{
+	return (set != NULL && i < set->n) ? &set->res[i] : NULL;
+}
