+/* A realm is going away (navigation, teardown): drop its pipelines,
+ * releasing their import() jobs against the still-live ctx -- kept, they
+ * held the promise functions past JS_FreeRuntime (a leak assert at exit). */
+static void qjs_modload_drop_ctx(JSContext *ctx)
+{
+	struct qjs_modload **pp = &g_modloads;
+	while (*pp != NULL) {
+		struct qjs_modload *m = *pp;
+		if (m->ctx == ctx) {
+			*pp = m->next;
+			qjs_modload_free(m, 1);
+			continue;
+		}
+		pp = &m->next;
+	}
+}
