+/* ---- VitaBrowser: import() without freezing the browser ---------------
+ *
+ * QuickJS loads an import()'s graph synchronously inside the job the call
+ * queues, and the loader above fetched and compiled all of it there:
+ * claude.ai's 91 dynamic modules froze the Vita for ~54 s (hardware run
+ * 22), no frames, no input. patches/quickjs/03 lets the host keep the job
+ * instead (qjs_module_defer). A pipeline per import root then, one step
+ * per event-loop pass (qjs_modload_pump):
+ *   FETCH    the graph level by level with fetch_get_set (non-blocking;
+ *            card hits registered at once, as the blocking crawl does),
+ *   COMPILE  the fetched modules one after another while the pass's
+ *            QJS_MODLOAD_SLICE_MS lasts (each lands in the realm's loaded
+ *            list, so QuickJS will not ask the loader for it again),
+ *   READY    re-queue the kept jobs; they now find the graph loaded.
+ * The import()'s promise stays pending meanwhile; the page keeps painting
+ * and taking input between steps. */
+#define QJS_MODLOAD_MAX 16
+#define QJS_MODLOAD_JOBS 8
+#define QJS_MODLOAD_SLICE_MS 12.0
+#define QJS_MODLOAD_STEP_MS 4.0
+
+struct qjs_modload {
+	struct qjs_modload *next;
+	JSContext *ctx;
+	struct module_registry *reg;
+	int nav_seq;
+	char *root;
+	int phase;			/* 0 fetch, 1 compile */
+	char **urls;			/* this level (QJS_MODULE_MAX_COUNT) */
+	unsigned int n;
+	char **carry;			/* in flight elsewhere: next level */
+	unsigned int ncarry;
+	const char **want;		/* its fetches */
+	unsigned int nw;
+	struct fetch_get_set *set;
+	unsigned int fetched, failed, cached, compiled, levels, steps;
+	size_t bytes;
+	double t0, longest_ms;
+	int njobs;
+	struct {
+		JSJobFunc *job;
+		int argc;
+		JSValue argv[6];
+	} jobs[QJS_MODLOAD_JOBS];
+};
+static struct qjs_modload *g_modloads = NULL;
+
+static void qjs_modload_free(struct qjs_modload *m, int free_values)
+{
+	unsigned int i;
+	int j, k;
+	if (m->set != NULL)
+		fetch_get_set_free(m->set);
+	if (m->urls != NULL) {
+		for (i = 0; i < m->n; i++) free(m->urls[i]);
+		free(m->urls);
+	}
+	free(m->want);
+	if (m->carry != NULL) {
+		for (i = 0; i < m->ncarry; i++) free(m->carry[i]);
+		free(m->carry);
+	}
+	if (free_values)
+		for (j = 0; j < m->njobs; j++)
+			for (k = 0; k < m->jobs[j].argc; k++)
+				JS_FreeValue(m->ctx, m->jobs[j].argv[k]);
+	free(m->root);
+	free(m);
+}
+
+/* Is url being fetched right now by a pipeline other than m on its
+ * registry? */
+static int qjs_modload_in_flight(struct qjs_modload *m, const char *url)
+{
+	struct qjs_modload *o;
+	unsigned int i;
+	for (o = g_modloads; o != NULL; o = o->next) {
+		if (o == m || o->reg != m->reg || o->set == NULL)
+			continue;
+		for (i = 0; i < o->nw; i++)
+			if (strcmp(o->want[i], url) == 0)
+				return 1;
+	}
+	return 0;
+}
