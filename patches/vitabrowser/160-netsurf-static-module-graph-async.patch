 {
@@ -2568,6 +2585,16 @@ bool html_can_begin_conversion(html_content *htmlc)
 	if (htmlc->base.active != 0)
 		return false;
 
+#ifdef WITH_QUICKJS
+	/* a module script's graph still loading: its script cannot run yet,
+	 * and the scripts and DOMContentLoaded after it wait with it */
+	if (htmlc->js_thread != NULL &&
+	    js_module_prefetch_pending(htmlc->js_thread)) {
+		guit->misc->schedule(30, html_module_prefetch_poll, htmlc);
+		return false;
+	}
+#endif
+
 	for (i = 0; i != htmlc->stylesheet_count; i++) {
 		/* Cannot begin conversion if the stylesheets are modified */
 		if (htmlc->stylesheets[i].modified)
@@ -6067,6 +6094,10 @@ static void html_destroy(struct content *c)
 	html_content *html = (html_content *) c;
 	struct form *f, *g;
 
+#ifdef WITH_QUICKJS
+	guit->misc->schedule(-1, html_module_prefetch_poll, c);
+#endif
+
 #ifdef __MACOS9__
 	if (html->ms_diag_doc_id != 0) {
 		ms_diag_document_close(html->ms_diag_doc_id);
