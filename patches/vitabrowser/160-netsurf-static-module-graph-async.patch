 	return true;
 }
 
+#ifdef WITH_QUICKJS
+extern bool js_module_prefetch_pending(struct jsthread *thread);
+
+/* VitaBrowser: re-drive the conversion while a module script's static
+ * graph loads between frames (js_module_prefetch): nothing else calls it
+ * back when that finishes. Cancelled in html_destroy. */
+static void html_module_prefetch_poll(void *p)
+{
+	html_content *htmlc = p;
+
+	if (macos9_content_is_live(&htmlc->base) == 0 || htmlc->aborted ||
+	    htmlc->conversion_begun)
+		return;
+	html_begin_conversion(htmlc);
+}
+#endif
+
