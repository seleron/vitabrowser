+/* VitaBrowser: a static module graph (<script type=module>) loads the
+ * same way, ahead of its script. The page's conversion (which runs the
+ * deferred and module scripts, then fires DOMContentLoaded) waits while
+ * js_module_prefetch_pending() -- html.c polls it -- so the order of
+ * scripts and events is unchanged; js_exec_module then finds the graph
+ * fetched and compiled and only links and runs it. The root itself is
+ * compiled by js_exec_module (it is marked compiled here, as there). */
+void js_module_prefetch(struct jsthread *thread, const char *name,
+	const char *src, size_t len);
+void js_module_prefetch(struct jsthread *thread, const char *name,
+	const char *src, size_t len)
+{
+	struct module_registry *reg;
+	struct module_entry *me;
+	struct qjs_modload *m;
+	char **urls;
+	unsigned int n, count = 0;
+
+	if (!qjs_thread_ctx_live(thread) || thread->heap == NULL ||
+	    thread->heap->module_reg == NULL || name == NULL ||
+	    src == NULL || len == 0)
+		return;
+	reg = thread->heap->module_reg;
+	qjs_module_registry_for_nav(reg);
+	for (m = g_modloads; m != NULL; m = m->next, count++)
+		if (m->ctx == thread->ctx && strcmp(m->root, name) == 0)
+			return;		/* already on its way */
+	if (count >= QJS_MODLOAD_MAX)
+		return;
+	me = qjs_module_register(reg, name, NULL, 0);
+	if (me != NULL)
+		me->compiled = 1;
+	urls = (char **)calloc(QJS_MODULE_MAX_COUNT, sizeof(*urls));
+	if (urls == NULL)
+		return;
+	n = qjs_module_scan(reg, name, src, len, urls, 0,
+		QJS_MODULE_MAX_COUNT);
+	if (n == 0) {
+		free(urls);
+		return;
+	}
+	m = qjs_modload_new(thread->ctx, reg, name, urls, n);
+	if (m != NULL) {
+		m->prefetch = 1;
+		macsurf_debug_log_writef("LIFE module prefetch: %u imports "
+			"of %s", n, name);
+	}
+}
+
+/* Is a static module graph of this realm still loading? */
+bool js_module_prefetch_pending(struct jsthread *thread);
+bool js_module_prefetch_pending(struct jsthread *thread)
+{
+	struct qjs_modload *m;
+	if (thread == NULL || thread->ctx == NULL)
+		return false;
+	for (m = g_modloads; m != NULL; m = m->next)
+		if (m->ctx == thread->ctx && m->prefetch)
+			return true;
+	return false;
+}
+
