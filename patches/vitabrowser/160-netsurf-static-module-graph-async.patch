+static struct qjs_modload *qjs_modload_new(JSContext *ctx,
+	struct module_registry *reg, const char *root, char **urls,
+	unsigned int n)
+{
+	struct qjs_modload *m = (struct qjs_modload *)calloc(1, sizeof(*m));
