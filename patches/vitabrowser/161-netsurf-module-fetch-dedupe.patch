+void js_module_page_fetch(struct jsthread *thread, const char *url, int on)
+{
+	struct module_registry *reg;
+	struct module_entry *e;
+	if (!qjs_thread_ctx_live(thread) || thread->heap == NULL ||
+	    thread->heap->module_reg == NULL || url == NULL)
+		return;
+	reg = thread->heap->module_reg;
+	qjs_module_registry_for_nav(reg);
+	e = qjs_module_find(reg, url);
