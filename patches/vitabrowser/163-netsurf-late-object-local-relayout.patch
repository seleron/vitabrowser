 }
 
 
+/* VitaBrowser: tell the page's users its layout changed. From the
+ * scheduler: html_relayout_object_local runs inside an object's broadcast,
+ * where content_broadcast drops a nested REFORMAT (not replay-safe), so
+ * the window would neither repaint nor learn the new size. One per burst
+ * (a new schedule replaces the pending one); cancelled in html_destroy. */
+static void html_relayout_notify(void *p)
+{
+	html_content *htmlc = p;
+	union content_msg_data data;
+
+	if (macos9_content_is_live(&htmlc->base) == 0 || htmlc->aborted)
+		return;
+	data.background = false;
+	content_broadcast(&htmlc->base, CONTENT_MSG_REFORMAT, &data);
+}
+
+/* VitaBrowser (roadmap WS-C item 2 part B): an object that arrived after
+ * the page was laid out (a lazy image, a slow server) changes only its own
+ * lines and moves what follows: lay out just that (layout_relayout_object)
+ * instead of the whole page. The page's size and the frontend follow as
+ * after html_reformat. False: the caller does the full reflow. */
+bool html_relayout_object_local(html_content *htmlc, struct box *box)
+{
+	extern const char *layout_relayout_why;
+	extern double macos9_micros(void);
+	struct content *c = &htmlc->base;
+	struct box *layout;
+	double t0, t1;
+	int delta = 0;
+	static unsigned long done_n, no_n;
+
+	if (htmlc->layout == NULL || htmlc->reflowing ||
+	    !htmlc->had_initial_layout || htmlc->aborted ||
+	    c->status != CONTENT_STATUS_DONE || c->locked ||
+	    htmlc->iframe != NULL || htmlc->late_reflow_pending)
+		return false;
+	t0 = macos9_micros();
+	if (!layout_relayout_object(htmlc, box, &delta)) {
+		no_n++;
+		macsurf_debug_log_writef("LIFE relayout local: full reflow "
+			"instead (%s; box type %d in %d; %lu local, %lu full "
+			"so far)", layout_relayout_why, (int)box->type,
+			box->parent != NULL ? (int)box->parent->type : -1,
+			done_n, no_n);
+		return false;
+	}
+	t1 = macos9_micros();
+	done_n++;
+
+	layout = htmlc->layout;
+	c->width = layout->x + layout->padding[LEFT] + layout->width +
+		layout->padding[RIGHT] + layout->border[RIGHT].width +
+		layout->margin[RIGHT];
+	c->height = layout->y + layout->padding[TOP] + layout->height +
+		layout->padding[BOTTOM] + layout->border[BOTTOM].width +
+		layout->margin[BOTTOM];
+	if (layout->descendant_x1 > 1000000)
+		layout->descendant_x1 = 1000000;
+	if (layout->descendant_y1 > 1000000)
+		layout->descendant_y1 = 1000000;
+	if (c->width < layout->x + layout->descendant_x1)
+		c->width = layout->x + layout->descendant_x1;
+	if (c->height < layout->y + layout->descendant_y1)
+		c->height = layout->y + layout->descendant_y1;
+	selection_reinit(htmlc->sel);
+
+	macsurf_debug_log_writef("LIFE relayout local: %+d px in %ld us, "
+		"page %dx%d (%lu local, %lu full so far)", delta,
+		(long)(t1 - t0), c->width, c->height, done_n, no_n);
+
+	guit->misc->schedule(0, html_relayout_notify, htmlc);
+	return true;
+}
