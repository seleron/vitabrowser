 }
+
+
+/* ---- VitaBrowser: local relayout for a late replaced element ----------
+ *
+ * Roadmap WS-C item 2 part B. An image that arrives after the page is laid
+ * out (patch 162's lazy drain, a slow server) used to cost a full
+ * layout_document of the whole page -- one synchronous burst, hundreds of
+ * ms on the Vita for a long page, every time a batch of images landed.
+ * Most such images sit in plain block flow: then only the line boxes of
+ * their inline container change, and everything after them just moves
+ * down by the change in height. layout_relayout_object() does exactly that
+ * and nothing more, and says no (the caller does the full reflow) as soon
+ * as anything could make the result differ from a full layout: floats in
+ * the block formatting context, a non-block or shrink-to-fit ancestor
+ * (inline-block, table, flex, grid, float, abs, multicol), a fixed or
+ * min/max height, a list marker, collapsing through a zero-height box,
+ * positioned boxes that a height change would move, iframes. */
+
+static bool lr_position_offset(const struct box *b)
+{
+	css_fixed len = 0;
+	css_unit unit = CSS_UNIT_PX;
+	return css_computed_top(b->style, &len, &unit) != CSS_TOP_AUTO ||
+		css_computed_bottom(b->style, &len, &unit) != CSS_BOTTOM_AUTO;
+}
+
+/* Would moving subtree s down move something full layout would have left
+ * in place? An absolutely positioned box offset (top/bottom) from a
+ * containing block outside s, any fixed box so offset, or an iframe
+ * (positioned by the frontend from the layout). */
+static bool lr_subtree_unsafe(struct box *s)
+{
+	struct box *b = s;
+
+	while (b != NULL) {
+		if (b->iframe != NULL)
+			return true;
+		if (b->style != NULL) {
+			uint8_t pos = css_computed_position(b->style);
+			if (pos == CSS_POSITION_FIXED && lr_position_offset(b))
+				return true;
+			if (pos == CSS_POSITION_ABSOLUTE && lr_position_offset(b)) {
+				struct box *cb = NULL, *u;
+				for (u = b->parent; u != NULL; u = u->parent)
+					if (u->style != NULL &&
+					    css_computed_position(u->style) !=
+						CSS_POSITION_STATIC) {
+						cb = u;
+						break;
+					}
+				/* safe only if cb is s or inside it */
+				for (u = cb; u != NULL && u != s; u = u->parent)
+					;
+				if (cb == NULL || u == NULL)
+					return true;
+			}
+		}
+		/* next in document order, without leaving s */
+		if (b->children != NULL) {
+			b = b->children;
+			continue;
+		}
+		while (b != s && b->next == NULL)
+			b = b->parent;
+		if (b == s)
+			break;
+		b = b->next;
+	}
+	return false;
+}
+
+/* Is b a plain in-flow block whose height is its content's? */
+static bool lr_plain_block(const struct box *b)
+{
+	css_fixed len = 0;
+	css_unit unit = CSS_UNIT_PX;
+	int32_t count = 0;
+
+	if (b->type != BOX_BLOCK || b->object != NULL || b->style == NULL ||
+	    b->float_children != NULL || b->list_marker != NULL ||
+	    b->iframe != NULL)
+		return false;
+	switch (css_computed_position(b->style)) {
+	case CSS_POSITION_ABSOLUTE:
+	case CSS_POSITION_FIXED:
+		return false;
+	default:
+		break;
+	}
+	if (css_computed_height(b->style, &len, &unit) != CSS_HEIGHT_AUTO)
+		return false;
+	if (css_computed_min_height(b->style, &len, &unit) ==
+			CSS_MIN_HEIGHT_SET && len != 0)
+		return false;
+	if (css_computed_max_height(b->style, &len, &unit) !=
+			CSS_MAX_HEIGHT_NONE)
+		return false;
+	if (css_computed_column_count(b->style, &count) ==
+			CSS_COLUMN_COUNT_SET && count > 1)
+		return false;
+	return true;
+}
+
+/* A box's descendant bbox from its children's (already correct) ones:
+ * layout_calculate_descendant_bboxes for one box, without descending. */
+static void lr_descendant_bbox_shallow(const css_unit_ctx *unit_len_ctx,
+		struct box *box)
+{
+	struct box *child;
+
+	layout_get_box_bbox(unit_len_ctx, box,
+			&box->descendant_x0, &box->descendant_y0,
+			&box->descendant_x1, &box->descendant_y1);
+	for (child = box->children; child; child = child->next) {
+		bool ox_hidden, oy_hidden;
+		int sx0, sx1, sy0, sy1;
+		if (child->type == BOX_FLOAT_LEFT ||
+				child->type == BOX_FLOAT_RIGHT)
+			continue;
+		ox_hidden = box->style != NULL &&
+				(box_overflow_x(box) == CSS_OVERFLOW_HIDDEN ||
+				 box_overflow_x(box) == CSS_OVERFLOW_CLIP);
+		oy_hidden = box->style != NULL &&
+				(box_overflow_y(box) == CSS_OVERFLOW_HIDDEN ||
+				 box_overflow_y(box) == CSS_OVERFLOW_CLIP);
+		if (ox_hidden && oy_hidden)
+			continue;
+		sx0 = box->descendant_x0; sx1 = box->descendant_x1;
+		sy0 = box->descendant_y0; sy1 = box->descendant_y1;
+		layout_update_descendant_bbox(unit_len_ctx, box, child, 0, 0);
+		if (ox_hidden) {
+			box->descendant_x0 = sx0;
+			box->descendant_x1 = sx1;
+		}
+		if (oy_hidden) {
+			box->descendant_y0 = sy0;
+			box->descendant_y1 = sy1;
+		}
+	}
+}
+
+#define LR_MAX_DEPTH 256
+
+/* why the last layout_relayout_object() said no (for the log) */
+const char *layout_relayout_why = "";
+#define LR_NO(why) do { layout_relayout_why = (why); return false; } while (0)
+
+/* exported function documented in html/layout.h */
+bool layout_relayout_object(html_content *content, struct box *box,
+		int *delta_out)
+{
+	struct box *chain[LR_MAX_DEPTH];
+	unsigned int fl[LR_MAX_DEPTH];
+	bool block_mode = false;
+	struct box *ic, *b, *c, *doc = content->layout;
+	unsigned int n = 0, i;
+	int old_h, delta;
+
+	if (delta_out != NULL)
+		*delta_out = 0;
+	if (doc == NULL || box == NULL || box->parent == NULL)
+		LR_NO("no layout");
+	if (box->type == BOX_BLOCK && box->object != NULL) {
+		/* an image that is a block (display: block): its own box is
+		 * what changes size */
+		css_fixed len = 0;
+		css_unit unit = CSS_UNIT_PX;
+		if (content_get_type(box->object) != CONTENT_IMAGE)
+			LR_NO("block object is not an image");
+		if (box->style == NULL ||
+		    css_computed_position(box->style) != CSS_POSITION_STATIC ||
+		    (css_computed_min_height(box->style, &len, &unit) ==
+				CSS_MIN_HEIGHT_SET && len != 0) ||
+		    css_computed_max_height(box->style, &len, &unit) !=
+				CSS_MAX_HEIGHT_NONE)
+			LR_NO("block image with position or min/max height");
+		block_mode = true;
+		ic = box;
+	} else {
+		ic = box->parent;
+		if (ic->type != BOX_INLINE_CONTAINER)
+			LR_NO("not inline or block");
+	}
+
+	/* 1. the inline container: nothing in it that full layout places
+	 * from outside the line boxes */
+	for (c = block_mode ? NULL : ic->children; c != NULL; c = c->next) {
+		switch (c->type) {
+		case BOX_INLINE:
+		case BOX_TEXT:
+		case BOX_INLINE_END:
+		case BOX_BR:
+			break;
+		default:
+			LR_NO("line has a float or inline-block");
+		}
+		if (c->style != NULL &&
+		    css_computed_position(c->style) != CSS_POSITION_STATIC)
+			LR_NO("positioned inline");
+		if (c->iframe != NULL || c->children != NULL)
+			LR_NO("inline with children");
+	}
+
+	/* 2. the ancestors: plain blocks up to the root */
+	chain[n++] = ic;
+	for (b = ic->parent; b != NULL; b = b->parent) {
+		if (n == LR_MAX_DEPTH || !lr_plain_block(b))
+			LR_NO("ancestor not a plain block");
+		chain[n++] = b;
+	}
+	if (chain[n - 1] != doc)
+		LR_NO("not in the document");
+
+	/* 3. what moves: every later sibling of every chain box */
+	for (i = 0; i + 1 < n; i++)
+		for (c = chain[i]->next; c != NULL; c = c->next)
+			if (lr_subtree_unsafe(c))
+				LR_NO("positioned box or iframe after it");
+
+	/* the page must stay taller than the viewport (html/body fill it
+	 * otherwise, layout_document) */
+	if (doc->height < vb_viewport_h)
+		LR_NO("page shorter than the screen");
+
+	/* 4. min/max widths again (html_object_done invalidated the chain's),
+	 * as layout_document would. They also decide margin collapsing
+	 * (HAS_HEIGHT / MAKE_HEIGHT: an empty line that now has an image
+	 * stops margins collapsing through its block): if that changed
+	 * anywhere on the chain, only a full layout gets it right. */
+	for (i = 0; i < n; i++)
+		fl[i] = chain[i]->flags & (HAS_HEIGHT | MAKE_HEIGHT);
+	macsurf_layout_watchdog_reset();
+	layout_minmax_block(doc, content->font_func, content);
+	for (i = 0; i < n; i++)
+		if ((chain[i]->flags & (HAS_HEIGHT | MAKE_HEIGHT)) != fl[i])
+			LR_NO("margin collapsing changes");
+
+	/* 5. lay out the inline container (or the image block) again */
+	if (block_mode) {
+		/* as layout_block_context does for a block: its size from the
+		 * object, its margins, then x from them; y is unchanged */
+		old_h = ic->height + ic->padding[TOP] + ic->padding[BOTTOM] +
+			ic->border[TOP].width + ic->border[BOTTOM].width;
+		layout_block_find_dimensions(&content->unit_len_ctx,
+				ic->parent->width, vb_viewport_h, 0, 0, ic);
+		ic->x = ic->parent->padding[LEFT] + ic->margin[LEFT] +
+			ic->border[LEFT].width;
+		if (!layout_block_object(ic))
+			LR_NO("block object layout failed");
+		delta = ic->height + ic->padding[TOP] + ic->padding[BOTTOM] +
+			ic->border[TOP].width + ic->border[BOTTOM].width - old_h;
+	} else {
+		old_h = ic->height;
+		ic->width = ic->parent->width;
+		if (!layout_inline_container(ic, ic->width, ic->parent, 0, 0,
+				content))
+			LR_NO("line layout failed");
+		delta = ic->height - old_h;
+	}
+	layout_calculate_descendant_bboxes(&content->unit_len_ctx, ic);
+
+	/* 6. move the rest down, grow the ancestors, refresh their bboxes */
+	if (delta != 0) {
+		for (i = 0; i + 1 < n; i++)
+			for (c = chain[i]->next; c != NULL; c = c->next)
+				c->y += delta;
+		for (i = 1; i < n; i++)
+			chain[i]->height += delta;
+	}
+	for (i = 1; i < n; i++)
+		lr_descendant_bbox_shallow(&content->unit_len_ctx, chain[i]);
+
+	if (delta_out != NULL)
+		*delta_out = delta;
+	return true;
+}
