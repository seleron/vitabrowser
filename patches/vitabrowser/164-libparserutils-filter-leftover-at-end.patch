# libparserutils: the input filter's leftover is written out at the end
#
# Without iconv (-DWITHOUT_ICONV_FILTER: the Vita's build, and the
# simulator's), the input filter decodes raw bytes into a 64-character
# pivot buffer and then encodes them to UTF-8. When the UTF-8 buffer fills
# up partway through a pivot, the rest is kept as "leftover" for the next
# call -- but its raw bytes are already consumed. The input stream only
# refilled when its raw buffer had bytes, so when those were the last raw
# bytes (the end of a document or stylesheet that arrived in one piece of
# 4097-4160 bytes, or the end of any stream in the same position), up to
# 64 characters were dropped at the end of the data: a page's last
# <script> never ran (the tokeniser hit EOF inside it), a stylesheet lost
# its last rule. Found while writing JS-reflow-stall.html (patch 163).
#
# - filter.[ch]: parserutils__filter_has_leftover(); a flush-only call
#   (no raw data left, *data may be NULL) is no longer a bad parameter.
# - inputstream.c: peek_slow refills while the filter has leftover, even
#   with the raw buffer empty; refill_buffer discards consumed raw bytes
#   only when there were some (discarding 0 bytes of an empty buffer is
#   refused as a bad parameter, which failed the whole page).
# Test: JS-parse-tail.html and parse-tail.css, both 4130 bytes, the page's
# only script and the stylesheet's last rule in their last 64 bytes: 2/2;
# before, the script never ran and the rule did not apply.
diff --git a/src/input/filter.c b/src/input/filter.c
index 00ee7eb..aa6d9a0 100644
--- a/src/input/filter.c
+++ b/src/input/filter.c
@@ -180,7 +180,10 @@ parserutils_error parserutils__filter_process_chunk(parserutils_filter *input,
 		const uint8_t **data, size_t *len,
 		uint8_t **output, size_t *outlen)
 {
-	if (input == NULL || data == NULL || *data == NULL || len == NULL ||
+	/* *data may be NULL with *len 0: an empty raw buffer, when the call
+	 * only flushes what is left from the last one (has_leftover) */
+	if (input == NULL || data == NULL || len == NULL ||
+			(*data == NULL && *len != 0) ||
 			output == NULL || *output == NULL || outlen == NULL)
 		return PARSERUTILS_BADPARM;
 
@@ -292,6 +295,28 @@ parserutils_error parserutils__filter_process_chunk(parserutils_filter *input,
 #endif
 }
 
+/**
+ * Is there converted data the filter could not write out yet?
+ *
+ * Without iconv, a chunk is decoded into the pivot buffer before it is
+ * encoded, so its input is consumed even when the output fills up; the
+ * rest waits in the pivot buffer ("leftover") for the next call. The
+ * input stream must then call again even though its raw buffer is empty.
+ *
+ * \param input  The input filter to query
+ * 
+eturn true if data is waiting to be written
+ */
+bool parserutils__filter_has_leftover(const parserutils_filter *input)
+{
+#ifndef WITHOUT_ICONV_FILTER
+	(void) input;
+	return false;
+#else
+	return input != NULL && input->leftover;
+#endif
+}
+
 /**
  * Reset an input filter's state
  *
diff --git a/src/input/filter.h b/src/input/filter.h
index 7f4c309..0fc924b 100644
--- a/src/input/filter.h
+++ b/src/input/filter.h
@@ -9,6 +9,7 @@
 #define parserutils_input_filter_h_
 
 #include <inttypes.h>
+#include <stdbool.h>
 
 #include <parserutils/errors.h>
 #include <parserutils/functypes.h>
@@ -53,5 +54,8 @@ parserutils_error parserutils__filter_process_chunk(parserutils_filter *input,
 /* Reset an input filter's state */
 parserutils_error parserutils__filter_reset(parserutils_filter *input);
 
+/* Is converted data still held back (output was full)? */
+bool parserutils__filter_has_leftover(const parserutils_filter *input);
+
 #endif
 
diff --git a/src/input/inputstream.c b/src/input/inputstream.c
index 120ae88..56cd1cd 100644
--- a/src/input/inputstream.c
+++ b/src/input/inputstream.c
@@ -241,8 +241,14 @@ parserutils_error parserutils_inputstream_peek_slow(
 	if (stream == NULL || ptr == NULL || length == NULL)
 		return PARSERUTILS_BADPARM;
 
-	/* There's insufficient data in the buffer, so read some more */
-	if (s->raw->length == 0) {
+	/* There's insufficient data in the buffer, so read some more --
+	 * from the raw buffer, or what the filter decoded from it but had no
+	 * room to write last time (without it, the end of a document whose
+	 * last raw bytes were decoded in the same pass that filled the utf8
+	 * buffer was silently dropped: VitaBrowser, a page's last <script>
+	 * never ran) */
+	if (s->raw->length == 0 &&
+			!parserutils__filter_has_leftover(s->input)) {
 		/* No more data to be had */
 		return s->public.had_eof ? PARSERUTILS_EOF
 					 : PARSERUTILS_NEEDDATA;
@@ -471,11 +477,15 @@ parserutils_error parserutils_inputstream_refill_buffer(
 	if (error != PARSERUTILS_OK && error != PARSERUTILS_NOMEM)
 		return error;
 
-	/* Remove the raw data we've processed from the raw buffer */
-	error = parserutils_buffer_discard(stream->raw, 0, 
-			stream->raw->length - raw_length);
-	if (error != PARSERUTILS_OK)
-		return error;
+	/* Remove the raw data we've processed from the raw buffer (none, when
+	 * this call only flushed the filter's leftover: discarding 0 bytes of
+	 * an empty buffer is refused as a bad parameter) */
+	if (stream->raw->length - raw_length > 0) {
+		error = parserutils_buffer_discard(stream->raw, 0,
+				stream->raw->length - raw_length);
+		if (error != PARSERUTILS_OK)
+			return error;
+	}
 
 	/* Fix up the utf8 buffer information */
 	stream->public.utf8->length = 
