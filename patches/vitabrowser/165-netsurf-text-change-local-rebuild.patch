+/* ---- VitaBrowser: a script's text change, rebuilt locally ---------------
+ *
+ * Roadmap WS-C, script-driven DOM changes. A script that changes the text
+ * of a paragraph (textContent, innerHTML with inline markup, a text node's
+ * data, a child appended or removed) queued a rebuild of the whole box tree
+ * and a full layout (macos9_reconvert_cb): ~0.26 s on the host for a page
+ * of 5000 paragraphs, seconds on the Vita, for one changed line.
+ * html_reconvert_local rebuilds only the boxes of the block that holds the
+ * change -- a block whose content is inline (one inline container of text
+ * and inline elements) -- and lays out just its lines (layout_relayout_line,
+ * the late-image path), moving what follows. Anything else declines (-1)
+ * and the full reconvert runs as before. */
+
+/* tags whose boxes are plain inline boxes: no objects, controls, quotes */
+static bool html_rl_inline_tag(dom_node *n)
+{
+	static const char *const ok[] = {
+		"a", "abbr", "b", "bdi", "bdo", "br", "cite", "code", "data",
+		"del", "dfn", "em", "font", "i", "ins", "kbd", "mark", "s",
+		"samp", "small", "span", "strong", "sub", "sup", "time", "u",
+		"var", "wbr", NULL
+	};
+	dom_string *name = NULL;
+	bool found = false;
+	int i;
+
+	if (dom_node_get_node_name(n, &name) != DOM_NO_ERR || name == NULL)
+		return false;
+	for (i = 0; ok[i] != NULL; i++)
+		if (dom_string_byte_length(name) == strlen(ok[i]) &&
+		    strncasecmp(dom_string_data(name), ok[i],
+				strlen(ok[i])) == 0) {
+			found = true;
+			break;
+		}
+	dom_string_unref(name);
+	return found;
+}
+
+/* are all of element's descendant elements plain inline ones? */
+static bool html_rl_inline_subtree(dom_node *element)
+{
+	dom_node *n = NULL, *next;
+	unsigned int count = 0;
+
+	if (dom_node_get_first_child(element, &n) != DOM_NO_ERR)
+		return false;
+	while (n != NULL) {
+		dom_node_type type;
+		bool down = false;
+		if (++count > 2000 ||
+		    dom_node_get_node_type(n, &type) != DOM_NO_ERR) {
+			dom_node_unref(n);
+			return false;
+		}
+		if (type == DOM_ELEMENT_NODE) {
+			if (!html_rl_inline_tag(n)) {
+				dom_node_unref(n);
+				return false;
+			}
+			down = true;
+		}
+		next = NULL;
+		if (down && dom_node_get_first_child(n, &next) == DOM_NO_ERR &&
+		    next != NULL) {
+			dom_node_unref(n);
+			n = next;
+			continue;
+		}
+		/* next sibling, or the next of an ancestor below element */
+		while (n != NULL) {
+			dom_node *parent = NULL;
+			next = NULL;
+			if (dom_node_get_next_sibling(n, &next) == DOM_NO_ERR &&
+			    next != NULL) {
+				dom_node_unref(n);
+				n = next;
+				break;
+			}
+			if (dom_node_get_parent_node(n, &parent) != DOM_NO_ERR ||
+			    parent == NULL) {
+				dom_node_unref(n);
+				return false;
+			}
+			dom_node_unref(n);
+			if (parent == element) {
+				dom_node_unref(parent);
+				n = NULL;
+				break;
+			}
+			n = parent;
+		}
+	}
+	return true;
+}
+
+/* point every node of a box subtree back at its box (a rollback) */
+static void html_rl_relink(struct box *b)
+{
+	for (; b != NULL; b = b->next) {
+		if (b->node != NULL) {
+			void *old = NULL;
+			(void) dom_node_set_user_data(b->node,
+					corestring_dom___ns_key_box_node_data,
+					b, NULL, &old);
+		}
+		html_rl_relink(b->children);
+	}
+}
+
+int html_reconvert_local(struct content *base_c, void *vnode);
+int html_reconvert_local(struct content *base_c, void *vnode)
+{
+	extern double macos9_micros(void);
+	extern const char *layout_relayout_why;
+	html_content *c = (html_content *) base_c;
+	dom_node *element = NULL, *n;
+	struct box *block, *old_ic, *new_ic, *b, *next, *layout;
+	unsigned int objects_before, old_flags;
+	int old_x, old_y, old_h, delta = 0;
+	bool local;
+	double t0, t1;
+	static unsigned long done_n, relaid_n;
+
+#define RL_NO(why) do { macsurf_debug_log_writef( \
+		"LIFE rebuild local: declined (%s)", (why)); return -1; } while (0)
+	if (c == NULL || vnode == NULL || c->layout == NULL ||
+	    c->document == NULL || c->aborted)
+		return -1;
+	if (c->reflowing || c->box_conversion_context != NULL ||
+	    macsurf_reconvert_in_progress != 0 || macos9_paint_gw != NULL ||
+	    base_c->locked)
+		RL_NO("busy");
+	if (base_c->status != CONTENT_STATUS_READY &&
+	    base_c->status != CONTENT_STATUS_DONE)
+		RL_NO("not loaded");
+	if (base_c->textsearch.context != NULL)
+		RL_NO("find in page is open");
+	if (c->iframe != NULL)
+		RL_NO("page has frames");
+	t0 = macos9_micros();
+
+	/* the nearest element with a block box: the one to rebuild */
+	n = vnode;
+	dom_node_ref(n);
+	while (n != NULL) {
+		dom_node_type type;
+		dom_node *parent = NULL;
+		if (dom_node_get_node_type(n, &type) == DOM_NO_ERR &&
+		    type == DOM_ELEMENT_NODE) {
+			b = box_for_node(n);
+			if (b != NULL && b->type == BOX_BLOCK) {
+				element = n;
+				break;
+			}
+			if (b != NULL && b->type != BOX_INLINE) {
+				dom_node_unref(n);	/* a table cell, ... */
+				RL_NO("nearest box is not a block");
+			}
+		}
+		if (dom_node_get_parent_node(n, &parent) != DOM_NO_ERR) {
+			dom_node_unref(n);
+			RL_NO("dom error");
+		}
+		dom_node_unref(n);
+		n = parent;
+	}
+	if (element == NULL)
+		RL_NO("no block box above the change");
+	block = box_for_node(element);
+	old_ic = block->children;
+
+	/* a block of inline content: one inline container, nothing generated,
+	 * no objects or controls, now or after the change */
+	if (block->object != NULL || block->gadget != NULL ||
+	    block->list_marker != NULL || block->float_children != NULL ||
+	    block->iframe != NULL || block->styles == NULL ||
+	    block->styles->styles[CSS_PSEUDO_ELEMENT_BEFORE] != NULL ||
+	    block->styles->styles[CSS_PSEUDO_ELEMENT_AFTER] != NULL ||
+	    old_ic == NULL || old_ic->next != NULL ||
+	    old_ic->type != BOX_INLINE_CONTAINER) {
+		dom_node_unref(element);
+		RL_NO("block is not one line container of plain content");
+	}
+	if (!html_rl_inline_subtree(element)) {
+		dom_node_unref(element);
+		RL_NO("new content is not plain inline elements");
+	}
+	for (b = old_ic->children; b != NULL; b = b->next)
+		if (b->object != NULL || b->gadget != NULL || b->iframe != NULL) {
+			dom_node_unref(element);
+			RL_NO("old content has an object or control");
+		}
+
+	/* build the block's children again */
+	old_x = old_ic->x;
+	old_y = old_ic->y;
+	old_h = old_ic->height;
+	old_flags = old_ic->flags;
+	objects_before = c->num_objects;
+	/* as html_reconvert_reset_css_state does for the whole tree: the
+	 * rebuilt elements' cached libcss node data holds styles owned by
+	 * the old boxes, which style sharing would hand to the new ones */
+	{
+		dom_node *ch = NULL, *nx = NULL;
+		if (dom_node_get_first_child(element, &ch) == DOM_NO_ERR)
+			while (ch != NULL) {
+				(void) html_reconvert_reset_node_data_walk(ch, 1);
+				nx = NULL;
+				dom_node_get_next_sibling(ch, &nx);
+				dom_node_unref(ch);
+				ch = nx;
+			}
+	}
+	block->children = block->last = NULL;
+	old_ic->parent = NULL;
+	if (!box_rebuild_children(c, element) ||
+	    !box_normalise_block(block, c->layout, c) ||
+	    c->num_objects != objects_before) {
+		/* back to the old boxes; the full reconvert takes it from
+		 * here */
+		for (b = block->children; b != NULL; b = next) {
+			next = b->next;
+			box_free(b);
+		}
+		block->children = block->last = old_ic;
+		old_ic->parent = block;
+		html_rl_relink(old_ic);
+		dom_node_unref(element);
+		macsurf_debug_log_writef("LIFE rebuild local: rebuild "
+			"declined, full reconvert");
+		return -1;
+	}
+	dom_node_unref(element);
+	box_free(old_ic);	/* backlinks only where they are still its */
+
+	/* lay out just the new lines if we can, else the page (the tree is
+	 * whole again either way: no full rebuild) */
+	for (b = block; b != NULL; b = b->parent)
+		b->max_width = UNKNOWN_MAX_WIDTH;
+	new_ic = block->children;
+	local = false;
+	if (new_ic != NULL && new_ic->next == NULL &&
+	    new_ic->type == BOX_INLINE_CONTAINER) {
+		new_ic->x = old_x;
+		new_ic->y = old_y;
+		local = layout_relayout_line(c, new_ic, old_h, old_flags,
+				&delta);
+	}
+	if (!local) {
+		macsurf_debug_log_writef("LIFE rebuild local: rebuilt, full "
+			"layout (%s)", new_ic == NULL ? "empty now" :
+			layout_relayout_why);
+		content__reformat(base_c, false, base_c->available_width,
+				base_c->available_height);
+		done_n++;
+		return 0;
+	}
+	t1 = macos9_micros();
+	done_n++;
+	relaid_n++;
+
+	layout = c->layout;
+	base_c->width = layout->x + layout->padding[LEFT] + layout->width +
+		layout->padding[RIGHT] + layout->border[RIGHT].width +
+		layout->margin[RIGHT];
+	base_c->height = layout->y + layout->padding[TOP] + layout->height +
+		layout->padding[BOTTOM] + layout->border[BOTTOM].width +
+		layout->margin[BOTTOM];
+	if (base_c->width < layout->x + layout->descendant_x1)
+		base_c->width = layout->x + layout->descendant_x1;
+	if (base_c->height < layout->y + layout->descendant_y1)
+		base_c->height = layout->y + layout->descendant_y1;
+	selection_reinit(c->sel);
+	macsurf_debug_log_writef("LIFE rebuild local: rebuilt and laid out "
+		"%+d px in %ld us, page %dx%d (%lu local, %lu relaid)", delta,
+		(long)(t1 - t0), base_c->width, base_c->height, done_n,
+		relaid_n);
+	guit->misc->schedule(0, html_relayout_notify, c);
+	return 0;
+#undef RL_NO
+}
