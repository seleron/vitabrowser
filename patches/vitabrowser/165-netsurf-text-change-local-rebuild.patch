# netsurf: a script's text change rebuilds and lays out only its block
#
# Roadmap WS-C, script-driven DOM changes (first part). Measured on a page
# of 5000 paragraphs (JS-dom-stall.html): every script change to one
# paragraph's text queued a rebuild of the whole box tree plus a full
# layout (macos9_reconvert_cb -> html_reconvert) -- 257-1496 ms of stall on
# the host, seconds on the Vita.
#
# - html.c: html_reconvert_local(). For a change inside a block whose
#   content is inline (one inline container; textContent, innerHTML with
#   plain inline markup, a text node's data, an inline child added or
#   removed) it takes the block's old boxes out, releases the rebuilt
#   elements' libcss node data (as html_reconvert_reset_css_state does for
#   the whole tree), builds the block's children again and normalises
#   them, frees the old boxes, and lays out just the new lines
#   (layout_relayout_line), moving what follows; if that declines, the
#   whole page is laid out -- but its boxes are not rebuilt. It declines
#   (logged, "LIFE rebuild local: declined (...)") for anything else: a
#   block that is not one inline container, generated content, objects,
#   form controls, non-inline tags in the new content (allow-list), find
#   in page, frames; on a build failure it restores the old boxes and
#   their DOM backlinks. (Its log lines avoid the "LIFE reconvert" prefix,
#   which the Vita frontend drops as noise.)
# - box_construct.c: box_rebuild_children() -- the full build's element /
#   text construction in document order, bounded to one element's
#   children (next_node_within).
# - layout.c: layout_relayout_core() shared by layout_relayout_object
#   (patch 163) and the new layout_relayout_line (a rebuilt inline
#   container with its predecessor's height and flags).
# - macos9_reconvert.c: macos9_reconvert_try_local() -- a batch that is
#   one text edit (one element, one kind) is offered to
#   html_reconvert_local first, in the debounced callback and in the
#   synchronous flush a geometry read triggers.
# - box_manipulate.c: box_free_box no longer frees a box's styles and
#   scroll bars itself; box_talloc_destructor (run by its talloc_free)
#   frees them and clears the pointers. Freed in both, they were
#   destroyed twice -- box_free crashed on any box with styles (found by
#   the first local rebuild). A clone's shared styles are unhooked first.
# - frontends/vita/main.c: VITA_NET_PAGES_MAX 52 -> 64 (the suite's list
#   reached 52).
# Sim: the three text changes stall ~23 ms (was 257-1496 ms; the local
# work is ~2.7 ms, mostly checking what follows); positions identical to
# the full path (checked element by element with the local path off).
# A new block (a paragraph inserted) is still the full rebuild (255 ms).
diff --git a/content/handlers/html/box_construct.c b/content/handlers/html/box_construct.c
index 4866d44..e807ce2 100644
--- a/content/handlers/html/box_construct.c
+++ b/content/handlers/html/box_construct.c
@@ -3289,3 +3289,113 @@ box_construct_sched_pins(void (*cb)(void *), void *p, struct content *target)
 	ctx = (struct box_construct_ctx *) p;
 	return (struct content *) ctx->content == target;
 }
+
+
+/* ---- VitaBrowser: rebuild one element's children ----------------------
+ *
+ * Roadmap WS-C, script-driven DOM changes. A script that changes a
+ * paragraph's text used to cost a rebuild of the whole box tree and a full
+ * layout (~0.26 s on the host for 5000 paragraphs, seconds on the Vita).
+ * html_reconvert_local takes the old children out of the element's box and
+ * calls this to build them again from the DOM, the way the full build
+ * does (box_construct_element / box_construct_text in document order), but
+ * without leaving the element: next_node_within is next_node that stops
+ * when it climbs back to it. */
+
+static dom_node *
+next_node_within(struct box_construct_ctx *ctx, dom_node *n,
+		html_content *content, bool convert_children, dom_node *stop)
+{
+	dom_node *next = NULL;
+	bool has_children = false;
+	dom_exception err;
+
+	err = dom_node_has_child_nodes(n, &has_children);
+	if (err != DOM_NO_ERR) {
+		dom_node_unref(n);
+		return NULL;
+	}
+	if (convert_children && has_children) {
+		err = dom_node_get_first_child(n, &next);
+		dom_node_unref(n);
+		return err == DOM_NO_ERR ? next : NULL;
+	}
+	err = dom_node_get_next_sibling(n, &next);
+	if (err != DOM_NO_ERR) {
+		dom_node_unref(n);
+		return NULL;
+	}
+	if (box_for_node(n) != NULL)
+		box_construct_element_after(ctx, n, content);
+	if (next != NULL) {
+		dom_node_unref(n);
+		return next;
+	}
+	/* last child: climb, finishing each element left, up to stop */
+	while (true) {
+		dom_node *parent = NULL;
+		err = dom_node_get_parent_node(n, &parent);
+		dom_node_unref(n);
+		if (err != DOM_NO_ERR || parent == NULL)
+			return NULL;
+		if (parent == stop) {
+			dom_node_unref(parent);
+			return NULL;
+		}
+		if (box_for_node(parent) != NULL)
+			box_construct_element_after(ctx, parent, content);
+		err = dom_node_get_next_sibling(parent, &next);
+		if (err != DOM_NO_ERR) {
+			dom_node_unref(parent);
+			return NULL;
+		}
+		if (next != NULL) {
+			dom_node_unref(parent);
+			return next;
+		}
+		n = parent;
+	}
+}
+
+/* exported function documented in html/box_construct.h */
+bool box_rebuild_children(html_content *c, dom_node *element)
+{
+	struct box_construct_ctx ctx;
+	dom_node *n = NULL;
+	dom_exception err;
+
+	memset(&ctx, 0, sizeof(ctx));
+	ctx.content = c;
+	ctx.root_box = c->layout;
+	ctx.bctx = c->bctx;
+
+	err = dom_node_get_first_child(element, &n);
+	if (err != DOM_NO_ERR)
+		return false;
+	while (n != NULL) {
+		dom_node_type type;
+		bool convert_children = true;
+
+		if (dom_node_get_node_type(n, &type) != DOM_NO_ERR) {
+			dom_node_unref(n);
+			return false;
+		}
+		ctx.n = n;
+		if (type == DOM_ELEMENT_NODE) {
+			if (!box_construct_element(&ctx, &convert_children)) {
+				dom_node_unref(n);
+				return false;
+			}
+		} else if (type == DOM_TEXT_NODE) {
+			if (!box_construct_text(&ctx)) {
+				dom_node_unref(n);
+				return false;
+			}
+			convert_children = false;
+		} else {
+			convert_children = false;
+		}
+		n = next_node_within(&ctx, n, c, convert_children, element);
+	}
+	return true;
+}
