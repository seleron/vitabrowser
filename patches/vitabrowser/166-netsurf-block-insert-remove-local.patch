+/* ---- VitaBrowser: a block inserted or removed by a script -------------
+ *
+ * Roadmap WS-C, script-driven DOM changes, second part. A paragraph a
+ * script inserts or removes among other blocks cost a rebuild of the whole
+ * box tree and a full layout (~0.25 s on the host for 5000 paragraphs).
+ * html_reconvert_local builds just the new block's boxes (or unlinks the
+ * removed one) and calls this to place it exactly as layout_block_context
+ * would -- a block's y is the bottom of the one before, plus its top
+ * border, plus the collapsed margin (the previous block's bottom margin
+ * accumulated before its own top margin: lr_collapse) -- and to move what
+ * follows. Only for blocks the arithmetic stands on (lr_margin_block):
+ * plain, static, unfloated, uncleared, overflow visible, whose first line
+ * has height (MAKE_HEIGHT: margins do not collapse through them). At the
+ * parent's first or last place the margins shared with the parent must be
+ * unchanged. */
+
+static void lr_acc(int *pos, int *neg, int m)
+{
+	if (*pos < m)
+		*pos = m;
+	else if (*neg < -m)
+		*neg = -m;
+}
+
+static int lr_collapse(int above, int below)
+{
+	int pos = 0, neg = 0;
+	lr_acc(&pos, &neg, above);
+	lr_acc(&pos, &neg, below);
+	return pos - neg;
+}
+
+static int lr_bottom(const struct box *b)
+{
+	return b->y + b->padding[TOP] + b->height + b->padding[BOTTOM] +
+		b->border[BOTTOM].width;
+}
+
+static bool lr_margin_block(const struct box *b)
+{
+	if (!lr_plain_block(b) || !(b->flags & MAKE_HEIGHT) ||
+	    !(b->flags & HAS_HEIGHT))
+		return false;
+	if (css_computed_position(b->style) != CSS_POSITION_STATIC ||
+	    css_computed_clear(b->style) != CSS_CLEAR_NONE ||
+	    css_computed_float(b->style) != CSS_FLOAT_NONE ||
+	    box_overflow_x(b) != CSS_OVERFLOW_VISIBLE ||
+	    box_overflow_y(b) != CSS_OVERFLOW_VISIBLE)
+		return false;
+	return true;
+}
