+	unsigned int fl[LR_MAX_DEPTH];
+	struct box *b, *c, *ic = NULL, *doc = content->layout;
+	unsigned int n = 0, i;
+	int delta;
+
+	if (delta_out != NULL)
+		*delta_out = 0;
+	if (doc == NULL || parent == NULL)
+		LR_NO("no layout");
+	if ((nb == NULL) == (removed == NULL))
+		LR_NO("bad call");
+	if (prev == NULL && next == NULL)
+		LR_NO("parent had no other block");
+
+	/* the parent and its ancestors: plain blocks up to the root */
+	for (b = parent; b != NULL; b = b->parent) {
+		if (n == LR_MAX_DEPTH || !lr_plain_block(b))
+			LR_NO("ancestor not a plain block");
+		chain[n++] = b;
+	}
+	if (chain[n - 1] != doc)
+		LR_NO("not in the document");
+
+	/* what moves */
+	for (c = next; c != NULL; c = c->next)
+		if (lr_subtree_unsafe(c))
+			LR_NO("positioned box or iframe after it");
