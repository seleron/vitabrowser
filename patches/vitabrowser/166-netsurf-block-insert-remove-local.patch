+		for (c = chain[i]->next; c != NULL; c = c->next)
+			if (lr_subtree_unsafe(c))
+				LR_NO("positioned box or iframe after it");
+	if (doc->height < vb_viewport_h)
+		LR_NO("page shorter than the screen");
+
+	/* min/max widths (and so MAKE_HEIGHT / HAS_HEIGHT) again, as
+	 * layout_document would; the new block gets its flags here */
+	for (i = 0; i < n; i++)
+		fl[i] = chain[i]->flags & (HAS_HEIGHT | MAKE_HEIGHT);
+	macsurf_layout_watchdog_reset();
+	layout_minmax_block(doc, content->font_func, content);
+	for (i = 0; i < n; i++)
+		if ((chain[i]->flags & (HAS_HEIGHT | MAKE_HEIGHT)) != fl[i])
+			LR_NO("margin collapsing changes");
+
+	if ((prev != NULL && !lr_margin_block(prev)) ||
+	    (next != NULL && !lr_margin_block(next)))
+		LR_NO("neighbouring block not plain");
+
+	if (nb != NULL) {
+		if (!lr_margin_block(nb))
+			LR_NO("new block not plain");
+		ic = nb->children;
+		if (ic == NULL || ic->next != NULL ||
+		    ic->type != BOX_INLINE_CONTAINER)
+			LR_NO("new block is not one line container");
+		for (c = ic->children; c != NULL; c = c->next) {
+			switch (c->type) {
+			case BOX_INLINE:
+			case BOX_TEXT:
+			case BOX_INLINE_END:
+			case BOX_BR:
+				break;
+			default:
+				LR_NO("new block's line has more than text");
+			}
+			if ((c->style != NULL &&
+			     css_computed_position(c->style) !=
+					CSS_POSITION_STATIC) ||
+			    c->iframe != NULL || c->children != NULL ||
+			    c->object != NULL)
+				LR_NO("new block's line has more than text");
+		}
+	}
+
+	/* where it goes, and how far what follows moves */
+	if (nb != NULL) {
+		/* its own layout, as layout_block_context does for a block
+		 * holding one inline container */
+		layout_block_find_dimensions(&content->unit_len_ctx,
+				parent->width, vb_viewport_h, 0, 0, nb);
+		if (nb->height != AUTO)
+			LR_NO("new block has a height");
+		nb->x = parent->padding[LEFT] + nb->margin[LEFT] +
+			nb->border[LEFT].width;
+		ic->x = nb->padding[LEFT];
+		ic->y = nb->padding[TOP];
+		ic->width = nb->width;
+		if (!layout_inline_container(ic, nb->width, nb, 0, 0, content))
+			LR_NO("line layout failed");
+		nb->height = ic->height;
+		if (prev != NULL) {
+			nb->y = lr_bottom(prev) + nb->border[TOP].width +
+				lr_collapse(prev->margin[BOTTOM],
+					nb->margin[TOP]);
+		} else {
+			/* first: the margin it shares with the parent is the
+			 * old first block's */
+			if (nb->margin[TOP] != next->margin[TOP])
+				LR_NO("new first block's top margin differs");
+			nb->y = next->y - next->border[TOP].width +
+				nb->border[TOP].width;
+		}
+		layout_calculate_descendant_bboxes(&content->unit_len_ctx, nb);
+		if (next != NULL) {
+			delta = lr_bottom(nb) + next->border[TOP].width +
+				lr_collapse(nb->margin[BOTTOM],
+					next->margin[TOP]) - next->y;
+		} else {
+			if (nb->margin[BOTTOM] != prev->margin[BOTTOM])
+				LR_NO("new last block's bottom margin differs");
+			delta = lr_bottom(nb) - lr_bottom(prev);
+		}
+	} else if (next != NULL) {
+		int y;
+		if (prev != NULL) {
+			y = lr_bottom(prev) + next->border[TOP].width +
+				lr_collapse(prev->margin[BOTTOM],
+					next->margin[TOP]);
+		} else {
+			if (next->margin[TOP] != removed->margin_top)
+				LR_NO("removed first block's top margin differs");
+			y = removed->y - removed->border_top +
+				next->border[TOP].width;
+		}
+		delta = y - next->y;
+	} else {
+		if (removed->margin_bottom != prev->margin[BOTTOM])
+			LR_NO("removed last block's bottom margin differs");
+		delta = lr_bottom(prev) - removed->bottom;
+	}
+
+	/* move what follows, grow the parent and its ancestors */
+	for (c = next; c != NULL; c = c->next)
+		c->y += delta;
+	for (i = 0; i + 1 < n; i++)
+		for (c = chain[i]->next; c != NULL; c = c->next)
+			c->y += delta;
+	for (i = 0; i < n; i++)
+		chain[i]->height += delta;
+	for (i = 0; i < n; i++)
+		lr_descendant_bbox_shallow(&content->unit_len_ctx, chain[i]);
+
+	if (delta_out != NULL)
+		*delta_out = delta;
+	return true;
+}
