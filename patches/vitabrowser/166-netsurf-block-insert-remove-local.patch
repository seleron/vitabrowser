+/** Where a block a script removed sat (layout_relayout_block). */
+struct layout_removed_block {
+	int y;			/**< its y */
+	int border_top;		/**< its top border */
+	int bottom;		/**< the bottom of its border box */
+	int margin_top;
+	int margin_bottom;
+};
+
+/**
+ * VitaBrowser: place a block a script inserted (nb, already linked into
+ * parent's children between prev and next) or account for one it
+ * removed (removed; prev and next are its old neighbours), exactly as a
+ * full layout would, and move what follows.
+ *
+ * \param content   the page (laid out)
+ * \param parent    the parent block
+ * \param prev      the block before the change, or NULL
+ * \param nb        the new block, or NULL
+ * \param next      the block after the change, or NULL
+ * \param removed   the removed block's geometry, or NULL
+ * \param delta_out how far what follows moved, or NULL
+ * \return true if done; false if the page needs a full layout
+ */
+bool layout_relayout_block(struct html_content *content, struct box *parent,
+		struct box *prev, struct box *nb, struct box *next,
+		const struct layout_removed_block *removed, int *delta_out);
