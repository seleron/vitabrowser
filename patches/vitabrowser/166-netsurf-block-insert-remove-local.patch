+/* block elements a script commonly adds as one paragraph of text */
+static bool html_rl_block_tag(dom_node *n)
+{
+	static const char *const ok[] = {
+		"p", "div", "h1", "h2", "h3", "h4", "h5", "h6", "section",
+		"article", "header", "footer", "aside", "nav", "main",
+		"address", "blockquote", NULL
+	};
+	dom_string *name = NULL;
+	bool found = false;
+	int i;
+
+	if (dom_node_get_node_name(n, &name) != DOM_NO_ERR || name == NULL)
+		return false;
+	for (i = 0; ok[i] != NULL; i++)
+		if (dom_string_byte_length(name) == strlen(ok[i]) &&
+		    strncasecmp(dom_string_data(name), ok[i],
+				strlen(ok[i])) == 0) {
+			found = true;
+			break;
+		}
+	dom_string_unref(name);
+	return found;
+}
+
+/* does a box subtree hold anything that others point at (an object's
+ * entry, a form control, a frame)? */
+static bool html_rl_subtree_referenced(struct box *b)
+{
+	for (; b != NULL; b = b->next) {
+		if (b->object != NULL || b->gadget != NULL ||
+		    b->iframe != NULL || b->list_marker != NULL)
+			return true;
+		if (html_rl_subtree_referenced(b->children))
+			return true;
+	}
+	return false;
+}
+
+static bool html_rl_text_is_space(dom_node *n)
+{
+	dom_string *data = NULL;
+	const char *d;
+	size_t i, len;
+	bool space = true;
+
+	if (dom_characterdata_get_data(n, &data) != DOM_NO_ERR)
+		return false;
+	if (data == NULL)
+		return true;
+	d = dom_string_data(data);
+	len = dom_string_byte_length(data);
+	for (i = 0; i < len; i++)
+		if (d[i] != ' ' && d[i] != '\t' && d[i] != '\n' &&
+		    d[i] != '\r' && d[i] != '\f') {
+			space = false;
+			break;
+		}
+	dom_string_unref(data);
+	return space;
+}
+
+static void html_rl_unlink(struct box *b)
+{
+	struct box *parent = b->parent;
+
+	if (parent != NULL) {
+		if (parent->children == b)
+			parent->children = b->next;
+		if (parent->last == b)
+			parent->last = b->prev;
+	}
+	if (b->prev != NULL)
+		b->prev->next = b->next;
+	if (b->next != NULL)
+		b->next->prev = b->prev;
+	b->prev = b->next = NULL;
+	b->parent = NULL;
+}
+
+static void html_rl_link_after(struct box *parent, struct box *after,
+		struct box *b)
+{
+	if (after != NULL) {
+		box_insert_sibling(after, b);
+		return;
+	}
+	b->parent = parent;
+	b->prev = NULL;
+	b->next = parent->children;
+	if (parent->children != NULL)
+		parent->children->prev = b;
+	else
+		parent->last = b;
+	parent->children = b;
+}
+
+static void html_rl_invalidate(struct box *b)
+{
+	for (; b != NULL; b = b->parent)
+		b->max_width = UNKNOWN_MAX_WIDTH;
+}
