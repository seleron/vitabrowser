+/* A script inserted and/or removed blocks among parent's block children:
+ * build (or unlink) just those and place them (layout_relayout_block).
+ * 0 done, -1 declined (nothing changed). */
+static int html_rl_block_change(html_content *c, dom_node *pnode,
+		struct box *pbox, double t0)
+{
+	extern double macos9_micros(void);
+	extern const char *layout_relayout_why;
+	struct content *base_c = &c->base;
+	struct box *removed[HTML_RL_MAX_CHANGES];
+	dom_node *added[HTML_RL_MAX_CHANGES];
+	unsigned int nrem = 0, nadd = 0, i, local_n = 0;
+	struct box *b, *layout;
+	dom_node *n = NULL, *next;
+	bool full = false;
+	int delta, total = 0;
+	const char *why = NULL;
+	static unsigned long block_n;
+
+#define RL_BNO(w) do { macsurf_debug_log_writef( \
+		"LIFE rebuild local: declined (%s)", (w)); goto decline; } while (0)
+
+	/* the boxes: blocks only; which ones lost their element */
+	for (b = pbox->children; b != NULL; b = b->next) {
+		dom_node *parent = NULL;
+		if (b->type != BOX_BLOCK || b->node == NULL)
+			RL_BNO("parent holds more than blocks");
+		if (dom_node_get_parent_node(b->node, &parent) != DOM_NO_ERR)
+			RL_BNO("dom error");
+		if (parent != NULL)
+			dom_node_unref(parent);
+		if (parent != pnode) {
+			if (nrem == HTML_RL_MAX_CHANGES ||
+			    html_rl_subtree_referenced(b->children) ||
+			    b->object != NULL || b->gadget != NULL ||
+			    b->iframe != NULL || b->list_marker != NULL)
+				RL_BNO("removed block holds objects or controls");
+			removed[nrem++] = b;
+		}
+	}
+	/* the elements: new ones have no box yet */
+	if (dom_node_get_first_child(pnode, &n) != DOM_NO_ERR)
+		RL_BNO("dom error");
+	while (n != NULL) {
+		dom_node_type type;
+		if (dom_node_get_node_type(n, &type) != DOM_NO_ERR) {
+			dom_node_unref(n);
+			RL_BNO("dom error");
+		}
+		if (type == DOM_TEXT_NODE && !html_rl_text_is_space(n)) {
+			dom_node_unref(n);
+			RL_BNO("text among the blocks");
+		}
+		if (type == DOM_ELEMENT_NODE) {
+			b = box_for_node(n);
+			if (b == NULL) {
+				if (nadd == HTML_RL_MAX_CHANGES ||
+				    !html_rl_block_tag(n) ||
+				    !html_rl_inline_subtree(n)) {
+					dom_node_unref(n);
+					RL_BNO("new element is not a plain "
+						"block of text");
+				}
+				added[nadd++] = n;
+				dom_node_ref(n);
+			} else if (b->parent != pbox) {
+				dom_node_unref(n);
+				RL_BNO("an element moved in from elsewhere");
+			}
+		}
+		next = NULL;
+		if (dom_node_get_next_sibling(n, &next) != DOM_NO_ERR)
+			next = NULL;
+		dom_node_unref(n);
+		n = next;
+	}
+	if (nadd == 0 && nrem == 0)
+		RL_BNO("no inserted or removed block found");
+
+	/* removals first */
+	for (i = 0; i < nrem; i++) {
+		struct layout_removed_block rb;
+		struct box *prev = removed[i]->prev, *nx = removed[i]->next;
+		rb.y = removed[i]->y;
+		rb.border_top = removed[i]->border[TOP].width;
+		rb.bottom = removed[i]->y + removed[i]->padding[TOP] +
+			removed[i]->height + removed[i]->padding[BOTTOM] +
+			removed[i]->border[BOTTOM].width;
+		rb.margin_top = removed[i]->margin[TOP];
+		rb.margin_bottom = removed[i]->margin[BOTTOM];
+		html_rl_unlink(removed[i]);
+		box_free(removed[i]);
+		html_rl_invalidate(pbox);
+		if (!full && layout_relayout_block(c, pbox, prev, NULL, nx,
+				&rb, &delta)) {
+			total += delta;
+			local_n++;
+		} else if (!full) {
+			full = true;
+			why = layout_relayout_why;
+		}
+	}
+
+	/* then the new blocks, in document order */
+	for (i = 0; i < nadd; i++) {
+		struct box *nb, *after = NULL;
+		dom_node *sib = NULL, *prevsib = NULL;
+		unsigned int objects_before = c->num_objects;
+
+		(void) html_reconvert_reset_node_data_walk(added[i], 0);
+		if (!box_build_element(c, added[i])) {
+			nb = box_for_node(added[i]);
+			if (nb != NULL) {
+				html_rl_unlink(nb);
+				box_free(nb);
+			}
+			for (; i < nadd; i++)
+				dom_node_unref(added[i]);
+			macsurf_debug_log_writef("LIFE rebuild local: "
+				"building a new block failed, full reconvert");
+			return -1;	/* the full rebuild starts from the DOM */
+		}
+		nb = box_for_node(added[i]);
+		if (nb == NULL) {		/* display: none */
+			dom_node_unref(added[i]);
+			continue;
+		}
+		/* after the box of the nearest earlier element with one */
+		sib = added[i];
+		dom_node_ref(sib);
+		while (after == NULL) {
+			prevsib = NULL;
+			if (dom_node_get_previous_sibling(sib, &prevsib) !=
+					DOM_NO_ERR || prevsib == NULL)
+				break;
+			dom_node_unref(sib);
+			sib = prevsib;
+			b = box_for_node(sib);
+			if (b != NULL && b->parent == pbox && b != nb)
+				after = b;
+		}
+		dom_node_unref(sib);
+		dom_node_unref(added[i]);
+		if (nb->parent != pbox) {
+			full = true;		/* built somewhere unexpected */
+			why = why != NULL ? why : "new block not in its parent";
+			continue;
+		}
+		html_rl_unlink(nb);
+		html_rl_link_after(pbox, after, nb);
+		if (!box_normalise_block(nb, c->layout, c)) {
+			full = true;
+			why = why != NULL ? why : "normalise failed";
+			continue;
+		}
+		if (c->num_objects != objects_before) {
+			full = true;
+			why = why != NULL ? why : "new block fetches objects";
+		}
+		html_rl_invalidate(nb);
+		if (!full && layout_relayout_block(c, pbox, nb->prev, nb,
+				nb->next, NULL, &delta)) {
+			total += delta;
+			local_n++;
+		} else if (!full) {
+			full = true;
+			why = layout_relayout_why;
+		}
+	}
+
+	block_n++;
+	if (full) {
+		macsurf_debug_log_writef("LIFE rebuild local: blocks rebuilt "
+			"(%u added, %u removed), full layout (%s)", nadd, nrem,
+			why != NULL ? why : "?");
+		content__reformat(base_c, false, base_c->available_width,
+				base_c->available_height);
+		return 0;
+	}
+	layout = c->layout;
+	base_c->width = layout->x + layout->padding[LEFT] + layout->width +
+		layout->padding[RIGHT] + layout->border[RIGHT].width +
+		layout->margin[RIGHT];
+	base_c->height = layout->y + layout->padding[TOP] + layout->height +
+		layout->padding[BOTTOM] + layout->border[BOTTOM].width +
+		layout->margin[BOTTOM];
+	if (base_c->width < layout->x + layout->descendant_x1)
+		base_c->width = layout->x + layout->descendant_x1;
+	if (base_c->height < layout->y + layout->descendant_y1)
+		base_c->height = layout->y + layout->descendant_y1;
