# netsurf: turn on configurable bootstrap declarations around the realm build
#
# The glue half of patches/quickjs/04 (the engine half: the
# JS_SetGlobalDeclsConfigurable() flag). The VitaBrowser bridge declares most
# of the web platform as top-level functions and vars in its bootstrap
# scripts -- requestAnimationFrame, cancelAnimationFrame, Event and friends,
# MutationObserver / ResizeObserver / IntersectionObserver, DOMParser,
# FormData, XMLHttpRequest -- so with the standard script rule those globals
# are NON-configurable, while every conforming browser exposes them as
# configurable (WebIDL). A page that wraps one with
# Object.defineProperty throws "property is not configurable":
# google.com's main script does so for requestAnimationFrame (its
# AsyncContext instrumentation), and that throw -- inside a try whose catch
# is not wired up in the bundle -- stopped the whole script (no "Trending
# searches", scorecard text recall 0.18).
#
# The flag is read at run time, so it wraps the bootstrap calls: on before
# setup_globals / browser_globals / xrealm_register / dom_install /
# vita_polyfill, off after. Page scripts keep the standard behaviour.
diff --git a/content/handlers/javascript/quickjs/macsurf_qjs.c b/content/handlers/javascript/quickjs/macsurf_qjs.c
index 8e1c2ab..f4a7d90 100644
--- a/content/handlers/javascript/quickjs/macsurf_qjs.c
+++ b/content/handlers/javascript/quickjs/macsurf_qjs.c
@@ -16257,11 +16257,19 @@
 	JS_SetHostPromiseRejectionTracker(heap->rt,
 			qjs_promise_rejection_tracker, NULL);
 
+	/* VitaBrowser: the platform the bootstrap scripts declare
+	 * (requestAnimationFrame, XMLHttpRequest, Event, MutationObserver...)
+	 * is configurable in browsers, and pages wrap it with defineProperty
+	 * (google.com: requestAnimationFrame) -- declared as a script's
+	 * top-level functions it was not (patches/quickjs/04). Page scripts
+	 * keep the standard behaviour. */
+	JS_SetGlobalDeclsConfigurable(ctx, true);
 	MS_LOG("qjs: setup_globals");   macsurf_qjs_setup_globals(ctx);
 	MS_LOG("qjs: browser_globals"); register_browser_globals(ctx);
 	MS_LOG("qjs: xrealm_register"); macsurf_qjs_xrealm_register(ctx);
 	MS_LOG("qjs: dom_install");     qjs_dom_install(ctx);
 	MS_LOG("qjs: vita_polyfill");   qjs_vita_polyfill(ctx);
+	JS_SetGlobalDeclsConfigurable(ctx, false);
 	macsurf_debug_log_writef("LIFE realm built: %ld us",
 			(long)(macos9_micros() - t_build));
 	return ctx;
