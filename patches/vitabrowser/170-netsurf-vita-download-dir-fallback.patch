+/* Where a download may go, in order. Every VitaBrowser VPK is a safe
+ * eboot (vita-make-fself -s), and a safe app is kept out of most of ux0::
+ * sceIoMkdir("ux0:download") fails and the fopen gets ENOENT (hardware
+ * run 27, the first run of the download test on a Vita). ux0:data/ is
+ * inside that sandbox (it holds log.txt), so a download falls back to it;
+ * an unsafe build still saves to ux0:download/. */
+const char *const vita_download_dirs[VITA_DOWNLOAD_DIRS] = {
+	VITA_DOWNLOAD_DIR, VITA_DIAG_DIR "downloads/"
+};
+
 unsigned int vita_downloads_done;	/**< completed this session */
 char vita_download_last[256];		/**< path of the last one saved */
 
@@ -87,8 +98,9 @@ static void safe_name(const char *in, char *out, size_t max)
 		snprintf(out, max, "download");
 }
 
-/* VITA_DOWNLOAD_DIR + name, "name (2).ext" if taken */
-static void unique_path(const char *name, char *path, size_t max)
+/* dir + name, "name (2).ext" if taken */
+static void unique_path(const char *dir, const char *name, char *path,
+			size_t max)
 {
 	const char *dot = strrchr(name, '.');
 	size_t stem = dot != NULL && dot != name ? (size_t)(dot - name)
@@ -96,18 +108,44 @@ static void unique_path(const char *name, char *path, size_t max)
 	struct stat st;
 	int n;
 
-	snprintf(path, max, "%s%s", VITA_DOWNLOAD_DIR, name);
+	snprintf(path, max, "%s%s", dir, name);
 	for (n = 2; stat(path, &st) == 0 && n < 1000; n++)
-		snprintf(path, max, "%s%.*s (%d)%s", VITA_DOWNLOAD_DIR,
+		snprintf(path, max, "%s%.*s (%d)%s", dir,
 			 (int)stem, name, n, dot != NULL && dot != name ?
 			 dot : "");
 }
 
+/* dir (with its trailing slash) exists as a directory, made if need be */
+static bool dir_ready(const char *dir)
+{
+	char d[128];
+	size_t n = strlen(dir);
+	struct stat st;
+
+	if (n < 2 || n >= sizeof(d))
+		return false;
+	memcpy(d, dir, n - 1);
+	d[n - 1] = '\0';
+	if (stat(d, &st) == 0) {
+		if (S_ISDIR(st.st_mode))
+			return true;
+		vita_diag_log("download: cannot make %s (a file has the name)",
+			      d);
+		return false;
+	}
+	if (mkdir(d, 0777) != 0 && errno != EEXIST) {
+		vita_diag_log("download: cannot make %s (errno %d)", d, errno);
+		return false;
+	}
+	return stat(d, &st) == 0 && S_ISDIR(st.st_mode);
+}
