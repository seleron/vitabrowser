+	for (i = 0; i < VITA_DOWNLOAD_DIRS && dw->fp == NULL; i++) {
+		if (!dir_ready(vita_download_dirs[i]))
+			continue;
+		unique_path(vita_download_dirs[i], dw->name, dw->path,
+			    sizeof(dw->path));
+		dw->fp = fopen(dw->path, "wb");
+		if (dw->fp == NULL)
+			vita_diag_log("download: cannot create %s (errno %d)",
+				      dw->path, errno);
+	}
 	if (dw->fp == NULL) {
-		vita_diag_log("download: cannot create %s (errno %d)",
-			      dw->path, errno);
-		vita_show_message(4000, "download failed: cannot write %s",
-			     dw->path);
+		vita_diag_log("download: FAILED %s: no folder could take it",
+			      dw->name);
+		vita_show_message(4000, "download failed: cannot save %s",
+			     dw->name);
 		free(dw);
 		return NULL;
 	}
