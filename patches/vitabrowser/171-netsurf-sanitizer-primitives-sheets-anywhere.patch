 	return r;
 }
 
+/* VitaBrowser: every attribute name of an element, from its real
+ * namednodemap (as qjs_ih_serialize_attrs walks it). The JS side built
+ * `attributes` / getAttributeNames() from a fixed list of ~23 common names,
+ * so jsname, jsaction, aria-*, data-* and every other attribute could not
+ * be enumerated: google's HTML sanitizer copies an element by iterating
+ * its attributes, and its trending-search rows lost them. */
+static JSValue qjs_attr_names_native(JSContext *ctx, JSValueConst this_val,
+		int argc, JSValueConst *argv)
+{
+	dom_node *n;
+	dom_namednodemap *map = NULL;
+	dom_ulong len = 0, i;
+	uint32_t k = 0;
+	JSValue arr = JS_NewArray(ctx);
+
+	(void)this_val;
+	if (JS_IsException(arr) || argc < 1)
+		return arr;
+	n = qjs_get_node(argv[0]);
+	if (n == NULL)
+		return arr;
+	if (macsurf_dom_node_get_attributes(n, &map) != DOM_NO_ERR ||
+			map == NULL)
+		return arr;
+	if (dom_namednodemap_get_length(map, &len) != DOM_NO_ERR)
+		len = 0;
+	for (i = 0; i < len; i++) {
+		dom_node *an = NULL;
+		dom_string *aname = NULL;
+		if (dom_namednodemap_item(map, i, &an) != DOM_NO_ERR ||
+				an == NULL)
+			continue;
+		if (macsurf_dom_attr_get_name(an, &aname) == DOM_NO_ERR &&
+				aname != NULL) {
+			JS_SetPropertyUint32(ctx, arr, k++,
+				JS_NewStringLen(ctx, dom_string_data(aname),
+					dom_string_byte_length(aname)));
+			macsurf_dom_string_unref(aname);
+		}
+		macsurf_dom_node_unref(an);
+	}
+	dom_namednodemap_unref(map);
+	return arr;
+}
