 			removed[nrem++] = b;
 		}
 	}
@@ -6418,12 +6474,23 @@ static int html_rl_block_change(html_content *c, dom_node *pnode,
 		if (type == DOM_ELEMENT_NODE) {
 			b = box_for_node(n);
 			if (b == NULL) {
+				bool plain = html_rl_block_tag(n) &&
+					html_rl_inline_subtree(n);
 				if (nadd == HTML_RL_MAX_CHANGES ||
-				    !html_rl_block_tag(n) ||
-				    !html_rl_inline_subtree(n)) {
+				    (!plain &&
+				     !((html_rl_block_tag(n) ||
+					html_rl_list_tag(n)) &&
+				       html_rl_subtree_tags(n, true)))) {
 					dom_node_unref(n);
 					RL_BNO("new element is not a plain "
-						"block of text");
+						"block, list item or block of "
+						"blocks");
+				}
+				if (!plain) {
+					/* built alone, laid out whole */
+					full = true;
+					why = why != NULL ? why :
+						"a list item or nested blocks";
 				}
 				added[nadd++] = n;
 				dom_node_ref(n);
