+			if (b->list_marker != NULL ||
+			    html_rl_subtree_referenced(b->children) ||
+			    (b->children != NULL &&
+			     b->children->type == BOX_BLOCK)) {
+				full = true;
+				why = why != NULL ? why :
+					"a list item or nested blocks";
