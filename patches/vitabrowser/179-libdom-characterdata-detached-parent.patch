 	return _dom_dispatch_subtree_modified_event(doc, c->parent, &success);
 }
 
@@ -455,6 +475,11 @@ dom_exception _dom_characterdata_replace_data(struct dom_characterdata *cdata,
 	c->value = temp;
 
 	success = true;
+	/* VitaBrowser: a detached node (no parent -- the text node a
+	 * microtask shim toggles, core-js / Vue 2 nextTick) has no subtree
+	 * to tell; dispatching at a NULL target crashed (SIGSEGV) */
+	if (c->parent == NULL)
+		return DOM_NO_ERR;
 	return _dom_dispatch_subtree_modified_event(doc, c->parent, &success);
