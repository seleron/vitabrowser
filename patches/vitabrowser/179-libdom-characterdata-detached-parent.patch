# libdom: setting a detached text node's data does not crash
# Generated 2026-09-30
#
# src/core/characterdata.c: set_data, appendData, insertData, deleteData
# and replaceData each end by dispatching DOMSubtreeModified at c->parent
# -- NULL for a node with no parent, and dispatching at a NULL target
# segfaulted in __dom_dispatch_subtree_modified_event. A detached text
# node whose data changes is ordinary: the microtask shim of core-js and
# Vue 2's nextTick toggles exactly such a node. rte.ie crashed 4 s into its
# load once its scripts took that path (scorecard r11: SIGSEGV, found by
# gdb). A node without a parent has no subtree to tell: return DOM_NO_ERR.
# Test: JS-chardata.html case 1 (a detached text node's data set twice).
diff --git a/src/core/characterdata.c b/src/core/characterdata.c
index e6f5dbe..72d4b61 100644
--- a/src/core/characterdata.c
+++ b/src/core/characterdata.c
@@ -148,6 +148,11 @@ dom_exception _dom_characterdata_set_data(struct dom_characterdata *cdata,
 	c->value = data;
 
 	success = true;
+	/* VitaBrowser: a detached node (no parent -- the text node a
+	 * microtask shim toggles, core-js / Vue 2 nextTick) has no subtree
+	 * to tell; dispatching at a NULL target crashed (SIGSEGV) */
+	if (c->parent == NULL)
+		return DOM_NO_ERR;
 	return _dom_dispatch_subtree_modified_event(doc, c->parent, &success);
 }
 
@@ -259,6 +264,11 @@ dom_exception _dom_characterdata_append_data(struct dom_characterdata *cdata,
 	c->value = temp;
 
 	success = true;
+	/* VitaBrowser: a detached node (no parent -- the text node a
+	 * microtask shim toggles, core-js / Vue 2 nextTick) has no subtree
+	 * to tell; dispatching at a NULL target crashed (SIGSEGV) */
+	if (c->parent == NULL)
+		return DOM_NO_ERR;
 	return _dom_dispatch_subtree_modified_event(doc, c->parent, &success);
 }
 
@@ -321,6 +331,11 @@ dom_exception _dom_characterdata_insert_data(struct dom_characterdata *cdata,
 	c->value = temp;
 
 	success = true;
+	/* VitaBrowser: a detached node (no parent -- the text node a
+	 * microtask shim toggles, core-js / Vue 2 nextTick) has no subtree
+	 * to tell; dispatching at a NULL target crashed (SIGSEGV) */
+	if (c->parent == NULL)
+		return DOM_NO_ERR;
 	return _dom_dispatch_subtree_modified_event(doc, c->parent, &success);
 }
 
@@ -389,6 +404,11 @@ dom_exception _dom_characterdata_delete_data(struct dom_characterdata *cdata,
 	c->value = temp;
 
 	success = true;
+	/* VitaBrowser: a detached node (no parent -- the text node a
+	 * microtask shim toggles, core-js / Vue 2 nextTick) has no subtree
+	 * to tell; dispatching at a NULL target crashed (SIGSEGV) */
+	if (c->parent == NULL)
