# libdom: an innerHTML (fragment) parse must not switch the document's
# mode
# Generated 2026-09-30
#
# bindings/hubbub/parser.c: dom_hubbub_fragment_parser_create reuses the
# same binding and the live page's document. A fragment parse starts in
# the treebuilder's "initial" insertion mode, sees no doctype, and asks
# for quirks mode -- via set_quirks_mode() -- on the document that owns
# the fragment, i.e. the LIVE page. One innerHTML on a standards-mode
# page then turned the whole page into quirks mode, and class selectors
# started matching case-insensitively (google.com: .gb_E {position:
# absolute} took its account bar, whose class is gb_e -- a sign-in
# button that should sit top-right in the header was pulled out of flow
# and rendered over the logo).
#
# A fragment is parsed in its context document's mode: the treebuilder's
# mode request for a fragment is meaningless. The binding now carries a
# `fragment` flag (set in the two create paths) and set_quirks_mode()
# returns HUBBUB_OK without touching the document for a fragment.
#
# Test: CSS-account-bar.html, cases 1-3 (the account bar stays
# top-right; the live document keeps its standards-mode case-sensitive
# class matching).
diff --git a/bindings/hubbub/parser.c b/bindings/hubbub/parser.c
--- a/bindings/hubbub/parser.c
+++ b/bindings/hubbub/parser.c
@@ -52,6 +52,9 @@
 
 	bool complete;			/**< Indicate stream completion */
 
+	bool fragment;			/**< Parsing a fragment (innerHTML):
+					 * the document's mode is not ours */
+
 	dom_msg msg;		/**< Informational messaging function */
 
 	dom_script script;      /**< Script callback function */
@@ -628,6 +631,16 @@
 {
 	dom_hubbub_parser *dom_parser = (dom_hubbub_parser *) parser;
 
+	/* A fragment parse (innerHTML) starts in the "initial" insertion
+	 * mode and, seeing no doctype, asks for quirks mode -- on the
+	 * document that owns the fragment, the live page. One innerHTML
+	 * on a standards-mode page then turned the page quirks, and class
+	 * selectors started matching case-insensitively (google.com:
+	 * .gb_E {position: absolute} took its account bar, class gb_e).
+	 * A fragment is parsed in its context document's mode: leave it. */
+	if (dom_parser->fragment)
+		return HUBBUB_OK;
+
 	switch (mode) {
 	case HUBBUB_QUIRKS_MODE_NONE:
 		dom_document_set_quirks_mode(dom_parser->doc,
@@ -790,6 +803,7 @@
 	}
 
 	binding->complete = false;
+	binding->fragment = false;
 
 	if (params->msg == NULL) {
 		binding->msg = dom_hubbub_parser_default_msg;
@@ -921,6 +935,7 @@
 	}
 
 	binding->complete = false;
+	binding->fragment = true;
 
 	if (params->msg == NULL) {
 		binding->msg = dom_hubbub_parser_default_msg;
