# netsurf: align-items: center must not grow the line past a definite
# container height
# Generated 2026-09-30
#
# content/handlers/html/layout_flex.c: the line's used cross size was
# max(item cross) = 64 for an item taller than its fixed-height
# container (google's 64px apps/Sign-in group in the 48px header row),
# so cross_free_space was 0 and CSS_ALIGN_SELF_CENTER degenerated to
# flex-start -- the item pinned to the container top (md.top -
# row.top == 0, Sign-in 12-52 in the row, its bottom 16px past the
# row's bottom edge). CSS Flexbox 9.4.5: with a definite container
# cross size, an oversized item does not grow the line; centering must
# use the USED cross size, giving negative free space and equal
# overflow above and below (md at -8, Sign-in 4-44), as in Chromium.
#
# Gate: CSS-account-bar.html ACCTBAR 5/5 (was 3/5, cases 4-5 fail).
# CSS-flex-header 6/6 unchanged; full gate clean.
--- a/content/handlers/html/layout_flex.c
+++ b/content/handlers/html/layout_flex.c
@@ -1891,6 +1891,28 @@
 		cross_free_space = line->cross_size + extra - *box_size_cross -
 				lh__delta_outer_cross(ctx->flex, b);
 
+		/* fixes183 - CSS Flexbox 9.4.5: an item TALLER than its
+		 * fixed-height container (google's 64px apps/Sign-in group in
+		 * the 48px header row) must not GROW the line's cross size.
+		 * The line above is max(item cross) = 64, so the free space
+		 * computed from it is zero and align-items: center degenerates
+		 * to flex-start, pinning the item to the container's top
+		 * (md.top - row.top == 0; the Sign-in button lands at the row
+		 * top, 12px from the header top, and its 40px height + 12px
+		 * margin runs to 64px, 16px PAST the 48px row bottom). With the
+		 * flex container's USED cross size (available_cross = 48) the
+		 * free space is 48-64 = -16, /2 = -8: the item overflows
+		 * equally above and below the row, exactly as Chromium does
+		 * (md at -8, Sign-in at -8+12 = 4px from the row top). When the
+		 * line fits within the container, the test is false, so
+		 * nothing changes for the 18 passing pages. */
+		if (ctx->available_cross != AUTO &&
+		    line->cross_size > ctx->available_cross) {
+			cross_free_space = ctx->available_cross + extra -
+					*box_size_cross -
+					lh__delta_outer_cross(ctx->flex, b);
+		}
+
 		switch (lh__box_align_self(ctx->flex, b)) {
 		default:
 		case CSS_ALIGN_SELF_STRETCH:
