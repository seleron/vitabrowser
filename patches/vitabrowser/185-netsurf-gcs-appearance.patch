# netsurf: getComputedStyle answers appearance (auto/none)
# Generated 2026-09-30
#
# Chromium's getComputedStyle(el).appearance returns the computed value
# (auto/none) and pages branch on it; with the property unreadable from JS
# there was no way to verify the cascade value at all. The native
# computed-style builder (qjs_get_computed_style) now sets it, through
# css_computed_appearance so the answer carries the same clamping as the
# C-level getter (anything out of range -- inherit included -- is auto).
#
# Test: CSS-appearance.html, the six cases read the value through
# getComputedStyle.
--- a/content/handlers/javascript/quickjs/macsurf_qjs.c
+++ b/content/handlers/javascript/quickjs/macsurf_qjs.c
@@ -8027,6 +8027,15 @@
 					JS_NewString(ctx, "1"));
 			}
 		}
+		/* fixes1184 - Chromium's getComputedStyle answers appearance
+		 * (auto/none); a page can branch on it, and the scorecard's
+		 * dropped-property census needs the cascade value to be readable.
+		 * The getter clamps anything out of range (inherit included) to
+		 * auto -- match the clamping, not the raw enum. */
+		JS_SetPropertyStr(ctx, out, "appearance",
+			JS_NewString(ctx,
+				css_computed_appearance(s) == CSS_APPEARANCE_NONE ?
+					"none" : "auto"));
 		/* Used width/height come from the BOX, not the cascade -- the
 		 * cascade may say `auto` while the box knows the resolved pixels,
 		 * and "used value" is what getComputedStyle is specified to give. */
