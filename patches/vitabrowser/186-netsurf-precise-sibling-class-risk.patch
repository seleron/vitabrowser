+/* Parse a selector prelude [p->i, end). 0 = no sibling combinator,
+ * 1 = found (lefts filled), 2 = conservative decline. */
+static int html_rl_parse_prelude(struct html_rl_sel_parser *p, size_t end,
+		struct html_rl_sib_compound **lefts, int *nlefts)
+{
+	int found = 0, r = 0, k;
+	*lefts = NULL;
+	*nlefts = 0;
+	for (;;) {
+		struct html_rl_sib_compound cp;
+		uint8_t c;
+		html_rl_skip_ws(p);
+		if (p->i >= end)
+			break;
+		c = p->s[p->i];
+		if (c == ',') {
+			p->i++;
+			continue;
+		}
+		if (c == '+' || c == '~' || c == '>') {
+			r = 2;
+			goto decline;
+		}
+		memset(&cp, 0, sizeof(cp));
+		r = html_rl_parse_compound(p, &cp);
+		if (r != 0) {
+			html_rl_sib_compound_free(&cp);
+			if (r == 2)
+				goto decline;
+			r = 2;
+			goto decline;
+		}
+		html_rl_skip_ws(p);
+		if (p->i >= end) {
+			html_rl_sib_compound_free(&cp);
+			break;
+		}
+		c = p->s[p->i];
+		if (c == '+' || c == '~') {
+			if (cp.has_pseudo) {
+				html_rl_sib_compound_free(&cp);
+				r = 2;
+				goto decline;
+			}
+			/* A pseudo-element never matches an element, so it
+			 * cannot make a sibling's style depend on this class
+			 * change; keep it (the matcher returns false). */
+			*lefts = realloc(*lefts,
+				(*nlefts + 1) *
+				sizeof(struct html_rl_sib_compound));
+			if (*lefts == NULL) {
+				html_rl_sib_compound_free(&cp);
+				r = 2;
+				goto decline;
+			}
+			(*lefts)[(*nlefts)++] = cp;
+			found = 1;
+			p->i++;
+		} else {
+			/* '>', ',' or a descendant combinator: not our risk */
+			html_rl_sib_compound_free(&cp);
+			if (c == '>' || c == ',')
+				p->i++;
+		}
+	}
+	return found;
+decline:
+	for (k = 0; k < *nlefts; k++)
+		html_rl_sib_compound_free(&(*lefts)[k]);
+	free(*lefts);
+	*lefts = NULL;
+	*nlefts = 0;
+	return r;
+}
