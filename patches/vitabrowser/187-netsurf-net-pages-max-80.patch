# netsurf: raise VITA_NET_PAGES_MAX 64 -> 80 (sim/Vita network page list)
# Generated 2026-10-01
#
# The simulator's network page list (nettest.txt, one "name url" per line)
# is capped by VITA_NET_PAGES_MAX in frontends/vita/main.c. Patch 186 added
# the NET-css-sibling-class gate page as the 65th network page, so the gate
# failed loudly by design ("nettest.txt: 1 pages ignored (max 64)",
# "FAILED: network page list longer than VITA_NET_PAGES_MAX") and the new
# page never ran -- patch 186's gate verdict was never actually produced.
#
# This raises the cap to 80, leaving headroom for future gate pages.
# History of this constant: 32 (patch 93) -> 48 (patch 139) -> 52 ->
# 64 (patch 165) -> 80 (this patch). Each bump was forced the same way:
# the page list outgrew the cap and the harness refused to silently test
# fewer pages.
#
# Measurements: patch-level verification (git apply --check -p1 clean;
# scratch restage byte-identical). Sim gate: page-list capacity fixed --
# all 65 network pages loaded, 0 dropped; CSS-sibling-class summary produced
# (SIB186 6/6, patch 186's gate verdict). Full-gate exit 1 for environmental
# reasons only (see docs/build-loop-state.md): this VM blocks UDP sendto
# (netlog EPERM, proven with a plain socket test) and the 5000-paragraph
# stall pages exceed the autotest page budget here.
#
# No behavior change on the Vita itself beyond accepting longer
# nettest.txt lists; the two static arrays grow by 16 entries each
# (16*48 + 16*256 = 4864 bytes of BSS).
--- a/frontends/vita/main.c
+++ b/frontends/vita/main.c
@@ -135,7 +135,7 @@
  * reach them too. The defaults, or ux0:data/VitaBrowser/nettest.txt with
  * one "name url" per line (the simulator points them at a local server).
  */
-#define VITA_NET_PAGES_MAX 64
+#define VITA_NET_PAGES_MAX 80
 static const char *const vita_net_defaults[][2] = {
 	{ "NET-http-example", "http://example.com/" },
 	{ "NET-https-example", "https://example.com/" },
