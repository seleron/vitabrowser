# netsurf: fix :has() selector gaps — sibling-lead multi-part descendants and :scope (WS-C)
# Generated 2026-10-01
#
# Roadmap WS-C, follow-up to patch 178. Two gaps in patch 178's selector
# engine (content/handlers/javascript/quickjs/vita_polyfill.js):
#
# 1. :has() with a sibling-lead multi-part relative selector misses.
#    hasMatch() enumerated candidates for '+'/'~' leads as the following
#    siblings *themselves*; for :has(+ .foo .bar) the rightmost compound
#    (.bar) can match a *descendant* of a following sibling, which was never
#    tried. Single-part (:has(+ .foo)) was correct; multi-part was not.
#    Fix: for multi-part relative selectors, also walk each following
#    sibling's subtree when testing candidates.
#
# 2. Element-scoped :scope-only queries returned empty. each() walks
#    root.firstChild... for element roots, so el.querySelectorAll(':scope')
#    was [] (Chromium: [el]). Fix: jsQuery() now tests the root element
#    itself when the selector uses :scope (via a usesScope() helper that
#    recurses into :has()/:is()/:not()/etc. argument lists). The root
#    precedes all descendants in document order, so it is tested first.
#
# Decline conditions: none — these are pure selector-engine correctness
# fixes with no fallback paths. The :scope fix only activates when the
# parsed selector actually contains :scope, so non-:scope queries are
# unaffected.
#
# Gate: testpages/pages/JS-has193.html (HAS193 6/6): :has(+ .foo .bar) and
# :has(~ .foo .bar) with .bar as a descendant of the sibling;
# querySelectorAll(':scope') includes the element; single-part :has(+ .foo)
# still works; nested :has(div:has(span)); :has(span:first-child).
#
diff --git a/content/handlers/javascript/quickjs/vita_polyfill.js b/content/handlers/javascript/quickjs/vita_polyfill.js
--- a/content/handlers/javascript/quickjs/vita_polyfill.js
+++ b/content/handlers/javascript/quickjs/vita_polyfill.js
@@ -3152,6 +3152,13 @@
 			if (rel.lead === '+' || rel.lead === '~') {
 				for (var s = nextEl(n); s && !found; s = nextEl(s)) {
 					found = anchored(s);
+					/* 193: multi-part relative selectors can match a
+					 * descendant of the sibling, not just the sibling
+					 * itself (e.g. :has(+ .foo .bar) where .bar is
+					 * inside the .foo sibling). Walk the subtree. */
+					if (!found && parts.length > 1) {
+						walk(s, function (m) { if (!found && anchored(m)) found = true; return found; });
+					}
 					if (rel.lead === '+' && parts.length === 1) break;
 				}
 			} else {
@@ -3237,6 +3244,26 @@
 		try { Object.defineProperty(a, 'item', { value: function (i) { return this[i] || null; }, configurable: true }); } catch (e) { /* */ }
 		return a;
 	}
+	/* 193: does any compound in the selector list use :scope (including
+	 * nested inside :has()/:is()/:not()/etc.)? */
+	function usesScope(list) {
+		if (!list) return false;
+		for (var i = 0; i < list.length; i++) {
+			var parts = list[i].parts;
+			if (!parts) continue;
+			for (var j = 0; j < parts.length; j += 2) {
+				var cp = parts[j];
+				if (!cp || !cp.pseudo) continue;
+				for (var k = 0; k < cp.pseudo.length; k++) {
+					var ps = cp.pseudo[k];
+					if (ps.name === 'scope') return true;
+					if (ps.list && usesScope(ps.list)) return true;
+					if (ps.of && usesScope(ps.of)) return true;
+				}
+			}
+		}
+		return false;
+	}
 	function inOrder(root, set) {
 		/* several seeds: merge in document order */
 		var out = [];
@@ -3246,6 +3273,14 @@
 	function jsQuery(root, sel, first, nat) {
 		var list = parse(sel), seeds = seed(list), ctx = { scope: root.nodeType === 1 ? root : null }, out = [], all = [], seen = new Set(), i, k;
 		if (!seeds.length) return first ? null : listOf([]);
+		/* 193: :scope matches the scoping element itself, but each()
+		 * never yields the root for element roots. Test it explicitly;
+		 * it precedes all descendants in document order. */
+		if (root.nodeType === 1 && usesScope(list) && matchList(root, list, ctx)) {
+			if (first) return root;
+			all.push(root);
+			seen.add(root);
+		}
 		for (i = 0; i < seeds.length; i++) {
 			var cand = null;
 			try { cand = nat ? nat.call(root, seeds[i]) : null; } catch (e) { cand = null; }

