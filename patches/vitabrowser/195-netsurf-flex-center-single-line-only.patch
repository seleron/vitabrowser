# netsurf: limit patch 183's oversized-item centering to single-line flex
# Generated 2026-10-01
#
# content/handlers/html/layout_flex.c: patch 183's fix (CSS Flexbox 9.4.5)
# for an item taller than its fixed-height container was applying to
# multi-line flex containers as well. In a multi-line container
# (flex-wrap: wrap with 2+ lines), each line is positioned independently
# along the cross axis via align-content, and within each line items
# align via align-items against the LINE's cross size -- not the
# container's. Applying the 183 container-cross-size substitution to a
# wrapped line miscomputes cross_free_space for that line's items.
#
# The fix gates the 183 path on ctx->line.count == 1, which is true for
# flex-wrap: nowrap (always single-line) and for wrap containers whose
# items all fit on one line. At the place_line_items_cross call site all
# lines are already built, so line.count is final.
#
# Gate: JS-flex195.html FLEX195 4/4 (single-line oversized centering
# preserved; multi-line uses per-line cross size). Full gate clean.
--- a/content/handlers/html/layout_flex.c
+++ b/content/handlers/html/layout_flex.c
@@ -1906,8 +1906,18 @@
 		 * (md at -8, Sign-in at -8+12 = 4px from the row top). When the
 		 * line fits within the container, the test is false, so
 		 * nothing changes for the 18 passing pages. */
+		/* fixes195 - limit the fixes183 substitution to single-line
+		 * flex containers. In a multi-line container each line is
+		 * placed independently along the cross axis (align-content)
+		 * and items align within their own line's cross size; using
+		 * the container's available_cross here would miscompute
+		 * cross_free_space for wrapped lines. ctx->line.count == 1
+		 * covers both flex-wrap: nowrap and wrap-with-one-line, and
+		 * line.count is final at this call site (all lines built
+		 * before place_line_items_cross runs). */
 		if (ctx->available_cross != AUTO &&
-		    line->cross_size > ctx->available_cross) {
+		    line->cross_size > ctx->available_cross &&
+		    ctx->line.count == 1) {
 			cross_free_space = ctx->available_cross + extra -
 					*box_size_cross -
 					lh__delta_outer_cross(ctx->flex, b);
