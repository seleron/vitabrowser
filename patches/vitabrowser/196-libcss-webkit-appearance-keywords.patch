+	"square-button", "checkbox", "radio", "listbox", "listitem",
+	"menulist", "menulist-button", "menulist-text", "menulist-textfield",
+	"textfield", "textarea", "searchfield", "searchfield-decoration",
+	"searchfield-results-decoration", "searchfield-results-button",
+	"searchfield-cancel-button", "slider-horizontal", "slider-vertical",
+	"sliderthumb-horizontal", "sliderthumb-vertical",
+	"scrollbarbutton-up", "scrollbarbutton-down",
+	"scrollbarbutton-left", "scrollbarbutton-right",
+	"scrollbartrack-horizontal", "scrollbartrack-vertical",
+	"scrollbarthumb-horizontal", "scrollbarthumb-vertical",
+	"scrollbargripper-horizontal", "scrollbargripper-vertical",
+	"inner-spin-button", "caret", "caps-lock-indicator",
+	"relevancy-level-indicator", "continuous-capacity-level-indicator",
