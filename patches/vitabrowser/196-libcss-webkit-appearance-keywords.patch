# libcss: canonical WebKit legacy appearance keywords (184 follow-up)
# Generated 2026-10-01
#
# Patch 184's legacy value set had wrong spellings vs WebKit's canonical
# keyword set (Source/WebCore/css/CSSValueKeywords.in):
#   slider-horizontal-thumb / slider-vertical-thumb are really
#   sliderthumb-horizontal / sliderthumb-vertical;
#   searchfield-decorator is really searchfield-decoration.
# It was also missing real keywords: textarea, inner-spin-button,
# searchfield-cancel-button, searchfield-results-button,
# searchfield-results-decoration, menulist-text, menulist-textfield,
# the scrollbarbutton/scrollbartrack/scrollbarthumb/scrollbargripper
# families, caret, listitem, button-bevel, default-button,
# caps-lock-indicator, the *-level-indicator family, and the media-*
# controls. Declarations using the true keywords dropped; now they parse.
#
# All values still read as APPEARANCE_AUTO (the engine paints one built-in
# widget either way), so no rendering changes. Unrecognised values still
# invalidate. The non-WebKit aliases 184 accepted (progress-bar,
# scrollbar-button, win-button) are kept: accepting them is harmless.
#
# Measurements: 47 legacy keywords accepted (was 20, 3 misspelled).
# Decline conditions: none -- this is a pure parser value-set extension;
# an unrecognised value still returns CSS_INVALID as before.
--- a/src/parse/properties/p_appearance.c	2026-10-01 14:54:12.682995814 +0000
+++ b/src/parse/properties/p_appearance.c	2026-10-01 14:53:50.565052681 +0000
@@ -34,13 +34,38 @@
 #include "parse/properties/properties.h"
 #include "parse/properties/utils.h"
 
-/* fixes1184 - the webkit legacy value set, all read as auto (see header). */
+/* fixes1184 - the webkit legacy value set, all read as auto (see header).
+ * fixes1196 - spellings cross-checked against WebKit's canonical keyword
+ * set (Source/WebCore/css/CSSValueKeywords.in): slider-horizontal-thumb /
+ * slider-vertical-thumb are really sliderthumb-horizontal /
+ * sliderthumb-vertical, searchfield-decorator is searchfield-decoration,
+ * and the set was missing textarea, inner-spin-button,
+ * searchfield-cancel-button, menulist-text(-field), the scrollbarbutton /
+ * scrollbartrack / scrollbarthumb / scrollbargripper families, caret,
+ * listitem, button-bevel, default-button, caps-lock-indicator, the
+ * *-level-indicator family and the media-* controls. The non-WebKit
+ * aliases (progress-bar, scrollbar-button, win-button) are kept: accepting
+ * them as auto is harmless. */
 static const char *const appearance_auto_values[] = {
-	"auto", "button", "textfield", "menulist", "menulist-button",
-	"push-button", "radio", "checkbox", "listbox", "progress-bar",
-	"progress-bar-value", "scrollbar-button", "searchfield",
