+/* Match a cached compound against a live element (using its own class
+ * set). */
+static bool html_rl_sib_match_live(dom_node *el,
+		struct html_rl_sib_compound *cp)
+{
+	char *cls = html_rl_sib_attr_value((dom_element *)el, "class",
+			NULL);
+	bool m = html_rl_sib_compound_matches((dom_element *)el, cp,
+			cls);
+	free(cls);
+	return m;
+}
+
+/* Match the static parts (tag/id/class/attrs) of a compound, ignoring any
+ * pseudo-class. Used for :empty / :has compounds, which the 186 matcher
+ * refuses outright. Cannot prove safety on allocation failure: returns
+ * true (decline). */
+static bool html_rl_sib_match_static(dom_node *el,
+		struct html_rl_sib_compound *cp)
+{
+	struct html_rl_sib_compound tmp;
+	bool m;
+	if (!html_rl_sib_compound_dup(&tmp, cp))
+		return true;
+	tmp.has_pseudo = false;
+	tmp.has_pel = false;
+	m = html_rl_sib_match_live(el, &tmp);
+	html_rl_sib_compound_free(&tmp);
+	return m;
+}
+
+/* One sheet's sibling rules against one inserted element (between its
+ * element siblings prev and next, either of which may be NULL). */
+static bool html_rl_sib_insert_risky(dom_node *e, dom_node *prev,
+		dom_node *next, struct html_rl_sib_sheet *sh)
+{
+	int k;
+	for (k = 0; k < sh->nrules; k++) {
+		struct html_rl_sib_rule *rule = &sh->rules[k];
+		if (rule->kind == '+') {
+			/* Only the next sibling's predecessor changed. */
+			if (next != NULL &&
+			    html_rl_sib_match_live(next, &rule->r)) {
+				bool m_prev = prev != NULL &&
+					html_rl_sib_match_live(prev,
+							&rule->l);
+				bool m_e = html_rl_sib_match_live(e,
+						&rule->l);
+				if (m_prev != m_e)
+					return true;
+			}
+		} else {
+			/* '~': e is a new preceding sibling for everything
+			 * after it. */
+			if (html_rl_sib_match_live(e, &rule->l)) {
+				dom_node *s = next;
+				/* next is the caller's reference; take our
+				 * own before walking (each step unrefs). */
+				if (s != NULL)
+					dom_node_ref(s);
+				while (s != NULL) {
+					dom_node *nx;
+					if (html_rl_sib_match_live(s,
+							&rule->r)) {
+						dom_node_unref(s);
+						return true;
+					}
+					nx = html_rl_next_el_sibling(s);
+					dom_node_unref(s);
+					s = nx;
+				}
+			}
+		}
+	}
+	return false;
+}
+
+/* One sheet's sibling rules against one removed element: before removal
+ * it sat between element nodes prev and next (from the box chain). */
+static bool html_rl_sib_remove_risky(dom_node *e, dom_node *prev,
+		dom_node *next, struct html_rl_sib_sheet *sh)
+{
+	int k;
+	for (k = 0; k < sh->nrules; k++) {
+		struct html_rl_sib_rule *rule = &sh->rules[k];
+		if (rule->kind == '+') {
+			if (next != NULL &&
+			    html_rl_sib_match_live(next, &rule->r)) {
+				bool m_e = html_rl_sib_match_live(e,
+						&rule->l);
+				bool m_prev = prev != NULL &&
+					html_rl_sib_match_live(prev,
+							&rule->l);
+				if (m_e != m_prev)
+					return true;
+			}
+		} else {
+			if (html_rl_sib_match_live(e, &rule->l)) {
+				dom_node *s = next;
+				/* next is borrowed (box chain); take a
+				 * reference for the walk. */
+				if (s != NULL)
+					dom_node_ref(s);
+				while (s != NULL) {
+					dom_node *nx;
+					if (html_rl_sib_match_live(s,
+							&rule->r)) {
+						dom_node_unref(s);
+						return true;
+					}
+					nx = html_rl_next_el_sibling(s);
+					dom_node_unref(s);
+					s = nx;
+				}
+			}
+		}
+	}
+	return false;
+}
