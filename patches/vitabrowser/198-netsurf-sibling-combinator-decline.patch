+/* Patch 198: deep-copy a compound. On failure, dst is zeroed and false is
+ * returned; src is untouched. */
+static bool html_rl_sib_compound_dup(struct html_rl_sib_compound *dst,
+		const struct html_rl_sib_compound *src)
+{
+	int i;
+	memset(dst, 0, sizeof(*dst));
+	dst->has_pel = src->has_pel;
+	dst->has_pseudo = src->has_pseudo;
+	dst->has_empty = src->has_empty;
+	dst->has_has = src->has_has;
+	if (src->tag != NULL) {
+		dst->tag = strdup(src->tag);
+		if (dst->tag == NULL)
+			return false;
+	}
+	if (src->id != NULL) {
+		dst->id = strdup(src->id);
+		if (dst->id == NULL) {
+			html_rl_sib_compound_free(dst);
+			return false;
+		}
+	}
+	for (i = 0; i < src->nclasses; i++) {
+		char **nc = realloc(dst->classes,
+				(dst->nclasses + 1) * sizeof(char *));
+		if (nc == NULL) {
+			html_rl_sib_compound_free(dst);
+			return false;
+		}
+		dst->classes = nc;
+		dst->classes[dst->nclasses] = strdup(src->classes[i]);
+		if (dst->classes[dst->nclasses] == NULL) {
+			html_rl_sib_compound_free(dst);
+			return false;
+		}
+		dst->nclasses++;
+	}
+	for (i = 0; i < src->nattrs; i++) {
+		struct html_rl_sib_attr *na = realloc(dst->attrs,
+				(dst->nattrs + 1) *
+				sizeof(struct html_rl_sib_attr));
+		if (na == NULL) {
+			html_rl_sib_compound_free(dst);
+			return false;
+		}
+		dst->attrs = na;
+		dst->attrs[dst->nattrs].name = strdup(src->attrs[i].name);
+		dst->attrs[dst->nattrs].val = src->attrs[i].val != NULL ?
+				strdup(src->attrs[i].val) : NULL;
+		dst->attrs[dst->nattrs].op = src->attrs[i].op;
+		dst->attrs[dst->nattrs].ci = src->attrs[i].ci;
+		if (dst->attrs[dst->nattrs].name == NULL ||
+		    (src->attrs[i].val != NULL &&
+		     dst->attrs[dst->nattrs].val == NULL)) {
+			free(dst->attrs[dst->nattrs].name);
+			free(dst->attrs[dst->nattrs].val);
+			html_rl_sib_compound_free(dst);
+			return false;
+		}
+		dst->nattrs++;
+	}
+	return true;
+}
+
+/* Patch 198: append a deep copy of cp to a compound array. */
+static bool html_rl_sib_compound_append(struct html_rl_sib_compound **arr,
+		int *narr, const struct html_rl_sib_compound *cp)
+{
+	struct html_rl_sib_compound *na = realloc(*arr,
+			(*narr + 1) * sizeof(struct html_rl_sib_compound));
+	if (na == NULL)
+		return false;
+	*arr = na;
+	if (!html_rl_sib_compound_dup(&(*arr)[*narr], cp))
+		return false;
+	(*narr)++;
+	return true;
+}
+
+/* Patch 198: append a rule, moving l and r into it (their contents are now
+ * owned by the rule; l and r are NOT freed on success). */
+static bool html_rl_sib_rule_append(struct html_rl_sib_rule **rules,
+		int *nrules, char kind, struct html_rl_sib_compound *l,
+		struct html_rl_sib_compound *r)
+{
+	struct html_rl_sib_rule *nr = realloc(*rules,
+			(*nrules + 1) * sizeof(struct html_rl_sib_rule));
+	if (nr == NULL)
+		return false;
+	*rules = nr;
+	(*rules)[*nrules].kind = kind;
+	(*rules)[*nrules].l = *l;
+	(*rules)[*nrules].r = *r;
+	memset(l, 0, sizeof(*l));
+	memset(r, 0, sizeof(*r));
+	(*nrules)++;
+	return true;
+}
