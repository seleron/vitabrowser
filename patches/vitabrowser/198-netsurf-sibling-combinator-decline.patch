+/* ---- Patch 198: precise sibling-combinator / :empty / :has decline ---- */
+
+/* Previous element sibling, or NULL. Caller unrefs. */
+static dom_node *html_rl_prev_el_sibling(dom_node *el)
+{
+	dom_node *sib = NULL;
+	if (dom_node_get_previous_sibling(el, &sib) != DOM_NO_ERR)
+		return NULL;
+	while (sib != NULL) {
+		dom_node_type type;
+		dom_node *prev = NULL;
+		if (dom_node_get_node_type(sib, &type) == DOM_NO_ERR &&
+		    type == DOM_ELEMENT_NODE)
+			return sib;
+		dom_node_get_previous_sibling(sib, &prev);
+		dom_node_unref(sib);
+		sib = prev;
+	}
+	return NULL;
+}
+
+/* Next element sibling, or NULL. Caller unrefs. */
+static dom_node *html_rl_next_el_sibling(dom_node *el)
+{
+	dom_node *sib = NULL;
+	if (dom_node_get_next_sibling(el, &sib) != DOM_NO_ERR)
+		return NULL;
+	while (sib != NULL) {
+		dom_node_type type;
+		dom_node *next = NULL;
+		if (dom_node_get_node_type(sib, &type) == DOM_NO_ERR &&
+		    type == DOM_ELEMENT_NODE)
+			return sib;
+		dom_node_get_next_sibling(sib, &next);
+		dom_node_unref(sib);
+		sib = next;
+	}
+	return NULL;
+}
