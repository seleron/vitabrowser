+/* True if the block insert/remove could restyle a sibling, the parent or
+ * an ancestor through a sibling combinator, :empty or :has() rule -- the
+ * part of the patch-166 stale-styles issue patches 192 and 197 do not
+ * cover. Unlike shelved patch 189's blanket decline, each candidate is
+ * matched per element: an insert whose element does not move any sibling's
+ * match stays on the local path (so the 5000-paragraph insert pages keep
+ * their local rebuilds). Conservative on any doubt. */
+static bool html_rl_block_sibling_risk(html_content *c, dom_node *pnode,
+		dom_node **added, unsigned int nadd,
+		struct box **removed, unsigned int nrem)
+{
+	unsigned int i, si;
+	int k;
+	bool risk = false;
+
+	for (si = STYLESHEET_START; si < c->stylesheet_count && !risk; si++) {
+		struct html_rl_sib_sheet *sh;
+		if (c->stylesheets[si].sheet == NULL ||
+		    c->stylesheets[si].unused)
+			continue;
+		sh = html_rl_sib_sheet_for(c->stylesheets[si].sheet);
+		if (sh == NULL)
+			continue;
+		if (sh->state == 2)
+			/* Patch 186 conservative sheet: cannot prove
+			 * safety. */
+			return true;
+		/* Sibling combinators per element. */
+		for (i = 0; i < nadd && !risk; i++) {
+			dom_node *prev = html_rl_prev_el_sibling(added[i]);
+			dom_node *next = html_rl_next_el_sibling(added[i]);
+			risk = html_rl_sib_insert_risky(added[i], prev, next,
+					sh);
+			if (prev != NULL)
+				dom_node_unref(prev);
+			if (next != NULL)
+				dom_node_unref(next);
+		}
+		for (i = 0; i < nrem && !risk; i++) {
+			dom_node *e = removed[i]->node;
+			dom_node *prev = removed[i]->prev != NULL ?
+					removed[i]->prev->node : NULL;
+			dom_node *next = removed[i]->next != NULL ?
+					removed[i]->next->node : NULL;
+			if (e == NULL)
+				return true;
+			risk = html_rl_sib_remove_risky(e, prev, next, sh);
+		}
+		if (risk)
+			break;
+		/* :empty on the parent: did the mutation flip the parent's
+		 * element-childlessness? */
+		if (sh->nempty > 0 && (nadd > 0 || nrem > 0)) {
+			unsigned int nel = 0;
+			dom_node *ch = NULL;
+			bool flipped;
+			if (dom_node_get_first_child(pnode, &ch) ==
+					DOM_NO_ERR) {
+				while (ch != NULL) {
+					dom_node_type type;
+					dom_node *nx = NULL;
+					if (dom_node_get_node_type(ch,
+							&type) == DOM_NO_ERR &&
+					    type == DOM_ELEMENT_NODE)
+						nel++;
+					dom_node_get_next_sibling(ch, &nx);
+					dom_node_unref(ch);
+					ch = nx;
+				}
+			}
+			/* Element children before the mutation:
+			 * nel + nrem - nadd. */
+			flipped = ((nel == 0) !=
+					(nel + nrem - nadd == 0));
+			if (flipped) {
+				for (k = 0; k < sh->nempty; k++) {
+					if (html_rl_sib_match_static(pnode,
+							&sh->empty_cp[k]))
+						return true;
+				}
+			}
+		}
+		/* :has on the parent or an ancestor: an insert/remove
+		 * anywhere below changes the answer. */
+		for (k = 0; k < sh->nhas && !risk; k++) {
+			dom_node *anc = NULL;
+			/* Parent itself. */
+			if (html_rl_sib_match_static(pnode, &sh->has_cp[k]))
+				return true;
+			if (dom_node_get_parent_node(pnode, &anc) !=
+					DOM_NO_ERR)
+				return true;
+			while (anc != NULL && !risk) {
+				dom_node *up = NULL;
+				if (html_rl_sib_match_static(anc,
+						&sh->has_cp[k])) {
+					dom_node_unref(anc);
+					return true;
+				}
+				dom_node_get_parent_node(anc, &up);
+				dom_node_unref(anc);
+				anc = up;
+			}
+		}
+	}
+	return risk;
+}
