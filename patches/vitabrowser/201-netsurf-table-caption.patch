+/**
+ * VitaBrowser (patch 201): is this box a table caption?
+ *
+ * A display: table-caption element is a BOX_BLOCK child of its table.
+ * box_normalise_table moves the captions ahead of the row groups and
+ * leaves them unwrapped; every other block child of a table is wrapped
+ * in an implied row group, so after normalisation a block child of a
+ * table is a caption.
+ */
+static inline bool box_is_table_caption(const struct box *b)
+{
+	return b->type == BOX_BLOCK && b->parent != NULL &&
+			b->parent->type == BOX_TABLE && b->style != NULL &&
+			css_computed_display(b->style, false) ==
+				CSS_DISPLAY_TABLE_CAPTION;
+}
+
+/**
+ * VitaBrowser (patch 201): a table's first row group -- its first child
+ * after the captions, which normalisation keeps at the front.
+ */
+static inline struct box *box_table_row_groups(const struct box *table)
+{
+	struct box *c = table->children;
+
+	while (c != NULL && box_is_table_caption(c))
+		c = c->next;
+	return c;
+}
