+/**
+ * VitaBrowser (patch 201): the vertical space a table's captions take
+ * above (caption-side: top) and below (bottom) its border box. Valid
+ * after layout_table.
+ */
+static void layout_table_caption_extent(const struct box *table,
+		int *above, int *below)
+{
+	const struct box *cap;
+
+	*above = *below = 0;
+	for (cap = table->children; cap != NULL &&
+			box_is_table_caption(cap); cap = cap->next) {
+		int h = cap->margin[TOP] + cap->border[TOP].width +
+				cap->padding[TOP] + cap->height +
+				cap->padding[BOTTOM] +
+				cap->border[BOTTOM].width + cap->margin[BOTTOM];
+
+		if (css_computed_caption_side(cap->style) ==
+				CSS_CAPTION_SIDE_BOTTOM)
+			*below += h;
+		else
+			*above += h;
+	}
+}
