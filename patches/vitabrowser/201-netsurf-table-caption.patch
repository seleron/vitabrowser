+/**
+ * VitaBrowser (patch 201): lay out a table's captions once its grid is
+ * laid out. Each caption is a block as wide as the table's border box,
+ * stacked above it (caption-side: top, in source order) or below it
+ * (bottom). They stay children of the table, positioned outside its
+ * border box, the way the CSS table wrapper box holds them; the callers
+ * make room for them with layout_table_caption_extent. Child positions
+ * are relative to the table's padding box, hence the border offsets.
+ */
+static bool layout_table_captions(struct box *table, html_content *content)
+{
+	struct box *cap;
+	int above, below, top_y, bottom_y;
+	int outer = table->border[LEFT].width + table->padding[LEFT] +
+			table->width + table->padding[RIGHT] +
+			table->border[RIGHT].width;
+
+	if (table->children == NULL || !box_is_table_caption(table->children))
+		return true;
+
+	for (cap = table->children; cap != NULL &&
+			box_is_table_caption(cap); cap = cap->next) {
+		int w;
+
+		layout_find_dimensions(&content->unit_len_ctx, outer, -1, cap,
+				cap->style, NULL, NULL, NULL, NULL, NULL, NULL,
+				cap->margin, cap->padding, cap->border);
+		if (cap->margin[LEFT] == AUTO)
+			cap->margin[LEFT] = 0;
+		if (cap->margin[RIGHT] == AUTO)
+			cap->margin[RIGHT] = 0;
+		if (cap->margin[TOP] == AUTO)
+			cap->margin[TOP] = 0;
+		if (cap->margin[BOTTOM] == AUTO)
+			cap->margin[BOTTOM] = 0;
+		w = outer - cap->margin[LEFT] - cap->border[LEFT].width -
+				cap->padding[LEFT] - cap->padding[RIGHT] -
+				cap->border[RIGHT].width - cap->margin[RIGHT];
+		cap->width = w < 0 ? 0 : w;
+		cap->height = AUTO;
+		cap->float_children = 0;
+		cap->cached_place_below_level = 0;
+		if (!layout_block_context(cap, -1, content))
+			return false;
+		cap->x = -table->border[LEFT].width + cap->margin[LEFT] +
+				cap->border[LEFT].width;
+	}
+
+	layout_table_caption_extent(table, &above, &below);
+	top_y = -table->border[TOP].width - above;
+	bottom_y = table->padding[TOP] + table->height +
+			table->padding[BOTTOM] + table->border[BOTTOM].width;
+	for (cap = table->children; cap != NULL &&
+			box_is_table_caption(cap); cap = cap->next) {
+		int *yp = (css_computed_caption_side(cap->style) ==
+				CSS_CAPTION_SIDE_BOTTOM) ? &bottom_y : &top_y;
+
+		cap->y = *yp + cap->margin[TOP] + cap->border[TOP].width;
+		*yp += cap->margin[TOP] + cap->border[TOP].width +
+				cap->padding[TOP] + cap->height +
+				cap->padding[BOTTOM] +
+				cap->border[BOTTOM].width + cap->margin[BOTTOM];
+	}
+	return true;
+}
