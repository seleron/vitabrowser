diff --git a/resources/default.css b/resources/default.css
--- a/resources/default.css
+++ b/resources/default.css
@@ -152,3 +152,15 @@
 	background: yellow;
 	color: black;
 }
+
+/* VitaBrowser (patch 203): the HTML rendering section's hiding rules.
+ * Without them every [hidden] element, closed <dialog>, <template> and
+ * closed <details> body was shown. */
+[hidden], template, datalist, dialog, source, track, param, area { display: none; }
+dialog[open] { display: block; position: absolute; left: 0; right: 0;
+	width: fit-content; height: fit-content; margin: auto; border: solid;
+	padding: 1em; background-color: white; color: black; }
+details, summary { display: block; }
+details:not([open]) > :not(summary) { display: none; }
+details > summary:first-of-type::before { content: "\25B8  "; }
+details[open] > summary:first-of-type::before { content: "\25BE  "; }
