# libcss: display: flow-root (patch 204, with 204-netsurf)
# Generated 2026-10-07
# Base: seleron/vitabrowser 55361f5 (patch stack through 203)
#
# `display: flow-root` -- the modern clearfix, a block box that
# establishes a block formatting context -- was not a keyword, so the
# whole declaration was dropped and the element stayed whatever display
# it had (usually block, now without its float containment). Adds the
# keyword (propstrings FLOW_ROOT, after CONTENTS in both the enum and the
# SMAP table), opcode DISPLAY_FLOW_ROOT 0x0015, computed value
# CSS_DISPLAY_FLOW_ROOT 0x16 (fits the 5-bit display field) and the
# cascade mapping; properties.gen and its generated parser
# (autogenerated_display.c, rebuilt from it) gain FLOW_ROOT. Computed
# display is unchanged by position/float (flow-root is already
# block-level). Layout is 204-netsurf.
diff --git a/include/libcss/properties.h b/include/libcss/properties.h
--- a/include/libcss/properties.h
+++ b/include/libcss/properties.h
@@ -766,7 +766,8 @@
 	CSS_DISPLAY_INLINE_FLEX			= 0x12,
 	CSS_DISPLAY_GRID			= 0x13,
 	CSS_DISPLAY_INLINE_GRID			= 0x14,
-	CSS_DISPLAY_CONTENTS			= 0x15
+	CSS_DISPLAY_CONTENTS			= 0x15,
+	CSS_DISPLAY_FLOW_ROOT			= 0x16
 };
 
