+/* VitaBrowser patch 208: `-webkit-line-clamp: N` / `line-clamp: N` ->
+ * `max-height: Nlh`. Card titles and summaries everywhere clamp to N
+ * lines with display: -webkit-box + -webkit-box-orient: vertical +
+ * overflow: hidden; the declaration used to be dropped (modern_compat),
+ * so every clamped block showed its whole text. The legacy WebKit clamp
+ * sizes the box to N lines and leaves the rest to overflow, which is
+ * what max-height: Nlh does (patch 207 resolves lh); the page's own
+ * overflow: hidden then cuts the text. No ellipsis is drawn. Only an
+ * integer value is rewritten; `none` etc. are still dropped. Returns NULL
+ * when nothing matched. */
+static char *
+macsurf__rewrite_line_clamp(const char *data, size_t in_size,
+		size_t *out_size_p)
+{
+	static const char *const keys[] = { "line-clamp", NULL };
+	static const char *const names[] = { "-webkit-line-clamp", "line-clamp" };
+	char *out;
+	size_t cap, pos = 0, i = 0;
+	int changed = 0;
+
+	if (!macsurf__has_any_ci(data, in_size, keys))
+		return NULL;
+	cap = in_size + 64;
+	out = (char *)malloc(cap);
+	if (out == NULL)
+		return NULL;
+	while (i < in_size) {
+		size_t k;
+		int matched = 0;
+
+		for (k = 0; k < 2 && !matched; k++) {
+			size_t nl = strlen(names[k]), j, v, ve;
+			int n = 0, digits = 0;
+			char tmp[40];
+			int tl;
+
+			if (!macsurf__match_prop_name(data, in_size, i,
+					names[k], nl))
+				continue;
+			j = i + nl;
+			while (j < in_size && (data[j] == ' ' || data[j] == '\t'))
+				j++;
+			if (j >= in_size || data[j] != ':')
+				continue;
+			v = j + 1;
+			while (v < in_size && (data[v] == ' ' || data[v] == '\t'))
+				v++;
+			ve = v;
+			while (ve < in_size && data[ve] >= '0' && data[ve] <= '9' &&
+					digits < 3) {
+				n = n * 10 + (data[ve] - '0');
+				ve++;
+				digits++;
+			}
+			if (digits == 0 || n < 1)
+				continue;
+			/* the value must end here (spaces, !important ok) */
+			{
+				size_t e = ve;
+				while (e < in_size && (data[e] == ' ' ||
+						data[e] == '\t'))
+					e++;
+				if (e < in_size && data[e] != ';' &&
+						data[e] != '}' && data[e] != '!')
+					continue;
+			}
+			tl = snprintf(tmp, sizeof(tmp), "max-height: %dlh", n);
+			if (tl <= 0)
+				continue;
+			if (pos + (size_t)tl + 1 >= cap) {
+				char *neu;
+				cap = (pos + (size_t)tl + 1) * 2;
+				neu = (char *)realloc(out, cap);
+				if (neu == NULL) {
+					free(out);
+					return NULL;
+				}
+				out = neu;
+			}
+			memcpy(out + pos, tmp, (size_t)tl);
+			pos += (size_t)tl;
+			i = ve;
+			matched = 1;
+			changed = 1;
+		}
+		if (matched)
+			continue;
+		if (pos + 2 >= cap) {
+			char *neu;
+			cap = cap * 2;
+			neu = (char *)realloc(out, cap);
+			if (neu == NULL) {
+				free(out);
+				return NULL;
+			}
+			out = neu;
+		}
+		out[pos++] = data[i++];
+	}
+	if (!changed) {
+		free(out);
+		return NULL;
+	}
+	out[pos] = '\0';
+	*out_size_p = pos;
+	return out;
+}
