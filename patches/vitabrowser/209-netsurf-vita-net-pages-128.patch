# netsurf (vita frontend): room for 128 network test pages (was 80)
# Generated 2026-10-07
# Base: seleron/vitabrowser f352150 (patch stack through 205)
#
# The autotest's network pass reads its page list from
# ux0:data/VitaBrowser/nettest.txt into static tables of
# VITA_NET_PAGES_MAX entries; past that, pages are dropped with one log
# line and tools/run-vita-sim.sh fails the run. The gate's list reached
# 79 of 80 with patch 208. 128 entries cost 128 x (48 + 256) bytes of
# static data.
diff --git a/frontends/vita/main.c b/frontends/vita/main.c
--- a/frontends/vita/main.c
+++ b/frontends/vita/main.c
@@ -135,7 +135,10 @@
  * reach them too. The defaults, or ux0:data/VitaBrowser/nettest.txt with
  * one "name url" per line (the simulator points them at a local server).
  */
-#define VITA_NET_PAGES_MAX 80
+/* 128 (patch 209): the simulator gate's list reached 79 of 80 with patch
+ * 208; past the limit pages are dropped and their gates read "no
+ * summary". 128 x (48 + 256) bytes of static tables. */
+#define VITA_NET_PAGES_MAX 128
 static const char *const vita_net_defaults[][2] = {
 	{ "NET-http-example", "http://example.com/" },
 	{ "NET-https-example", "https://example.com/" },
