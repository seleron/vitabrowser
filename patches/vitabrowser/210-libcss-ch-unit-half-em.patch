# libcss: 1ch falls back to 0.5em, not 0.4em (patch 210)
# Generated 2026-10-07
# Base: seleron/vitabrowser f352150 (patch stack through 205, plus 207)
#
# NetSurf sets no measure callback in its css_unit_ctx, so libcss never
# measures the "0" glyph and uses a fallback for ch: 0.4em, in both the
# length conversion and font-size resolution. CSS Values 4 (6.1.1) says
# to assume 0.5em when the glyph is not measured; browsers measure it
# (~0.55em for Chromium's sans). At 0.4em, `max-width: 65ch` -- the usual
# article measure on blogs and docs -- was 416px where browsers give
# ~580px. ex keeps its 0.6em fallback (HTML size hints are in ex).
#
# Test: testpages/pages/CSS-ch-unit.html (CHUNIT210, 2 checks, Chromium
# 2/2): 10ch at 16px within 75..95px, a 65ch column within 500..620px.
diff --git a/src/select/unit.c b/src/select/unit.c
--- a/src/select/unit.c
+++ b/src/select/unit.c
@@ -282,13 +282,17 @@
 		if (measure != NULL) {
 			return measure(pw, ref_style, CSS_UNIT_CH);
 		}
+		/* VitaBrowser patch 210: 0.5em, the width CSS Values 4 (6.1.1)
+		 * says to assume when the "0" glyph is not measured (NetSurf
+		 * sets no measure callback). 0.4em made `max-width: 65ch`, the
+		 * usual article measure, 416px where browsers give ~580px. */
 		return FMUL(css_unit__font_size_px(
 				ref_style,
 				font_size_default,
 				font_size_minimum,
 				viewport_height,
 				viewport_width,
-				ctx), FLTTOFIX(0.4));
+				ctx), FLTTOFIX(0.5));
 
 	case CSS_UNIT_PX:
 		return F_1;
@@ -680,10 +684,10 @@
 						FLTTOFIX(0.6));
 				break;
 
-			case CSS_UNIT_CH:
+			case CSS_UNIT_CH:	/* 0.5em: patch 210 */
 				size->data.length.value = FMUL(
 						size->data.length.value,
-						FLTTOFIX(0.4));
+						FLTTOFIX(0.5));
 				break;
 
 			default:
