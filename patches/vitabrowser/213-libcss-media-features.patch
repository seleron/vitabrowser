# libcss: the common discrete media features answer for the Vita (patch 213)
# Generated 2026-10-07
# Base: seleron/vitabrowser 4e1cfd0 (patch stack through 212)
#
# mq_match_feature knew width, height, prefers-color-scheme and (fixes273)
# orientation; every other feature evaluated false. So
# `@media (prefers-reduced-motion: no-preference)` -- where many sites put
# their entrance and transition styles, sometimes the final state of an
# element -- never applied, nor did (scripting: enabled),
# (display-mode: browser), (prefers-contrast: no-preference),
# (forced-colors: none), and touch layouts keyed on (hover: none) /
# (pointer: coarse) on what is a touchscreen.
#
# A table of discrete features with the values that hold here:
# prefers-reduced-motion / -transparency / -data / prefers-contrast:
# no-preference; forced-colors, inverted-colors: none; scripting: enabled;
# display-mode: browser; color-gamut: srgb; dynamic-range: standard;
# update: fast; hover, any-hover: none; pointer, any-pointer: coarse. The
# boolean form `(feature)` holds unless the value is the feature's "none"
# value (MQ4 2.4.2). Unlisted features stay false, as before.
#
# Test: testpages/pages/CSS-media-features.html (MQFEAT213, 4 checks;
# Chromium passes 1-3 and differs on 4, the touchscreen answer, as a
# desktop browser should).
diff --git a/src/select/mq.h b/src/select/mq.h
--- a/src/select/mq.h
+++ b/src/select/mq.h
@@ -9,6 +9,9 @@
 #ifndef css_select_mq_h_
 #define css_select_mq_h_
 
+#include <string.h>
+#include <strings.h>
+
 #include "select/helpers.h"
 #include "select/strings.h"
 #include "select/unit.h"
@@ -186,7 +189,63 @@
 		}
 	}
 
-	/* TODO: Look at other feature names. */
+	/* VitaBrowser patch 213: the discrete media features pages test
+	 * most, answered for the Vita (a touchscreen, no user preferences
+	 * to report). Each lists the values that hold; the boolean form
+	 * `(feature)` holds unless the feature's value is its "none"
+	 * value (MQ4 2.4.2). They were unknown, so every query using them
+	 * was false -- `@media (prefers-reduced-motion: no-preference)`
+	 * blocks, the usual home of entrance styles, never applied. */
+	{
+		const struct {
+			const char *name;
+			const char *const *holds;
+			bool boolean;
+		} *f, vb_features[] = {
+			{ "prefers-reduced-motion", (const char *const[]){ "no-preference", NULL }, false },
+			{ "prefers-reduced-transparency", (const char *const[]){ "no-preference", NULL }, false },
+			{ "prefers-reduced-data", (const char *const[]){ "no-preference", NULL }, false },
+			{ "prefers-contrast", (const char *const[]){ "no-preference", NULL }, false },
+			{ "forced-colors", (const char *const[]){ "none", NULL }, false },
+			{ "inverted-colors", (const char *const[]){ "none", NULL }, false },
+			{ "scripting", (const char *const[]){ "enabled", NULL }, true },
+			{ "display-mode", (const char *const[]){ "browser", NULL }, true },
+			{ "color-gamut", (const char *const[]){ "srgb", NULL }, true },
+			{ "dynamic-range", (const char *const[]){ "standard", NULL }, true },
+			{ "update", (const char *const[]){ "fast", NULL }, true },
+			{ "hover", (const char *const[]){ "none", NULL }, false },
+			{ "any-hover", (const char *const[]){ "none", NULL }, false },
+			{ "pointer", (const char *const[]){ "coarse", NULL }, true },
+			{ "any-pointer", (const char *const[]){ "coarse", NULL }, true },
+			{ NULL, NULL, false }
+		};
+		const char *nd = lwc_string_data(feat->name);
+		size_t nl = lwc_string_length(feat->name);
+
+		for (f = vb_features; f->name != NULL; f++) {
+			const char *const *h;
+			const char *vd;
+			size_t vl;
+
+			if (strlen(f->name) != nl ||
+					strncasecmp(nd, f->name, nl) != 0)
+				continue;
+			if (feat->op == CSS_MQ_FEATURE_OP_BOOL)
+				return f->boolean;
+			if (feat->op != CSS_MQ_FEATURE_OP_EQ ||
+					feat->value.type !=
+						CSS_MQ_VALUE_TYPE_IDENT ||
+					feat->value.data.ident == NULL)
+				return false;
+			vd = lwc_string_data(feat->value.data.ident);
+			vl = lwc_string_length(feat->value.data.ident);
+			for (h = f->holds; *h != NULL; h++)
+				if (strlen(*h) == vl &&
+						strncasecmp(vd, *h, vl) == 0)
+					return true;
+			return false;
+		}
+	}
 
 	return false;
 }
