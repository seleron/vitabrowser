# netsurf: line-height: normal is the font's own; no forced body line-height (patch 214)
# Generated 2026-10-07
# Base: seleron/vitabrowser 6446903 (patch stack through 213)
#
# NetSurf resolves line-height: normal as a flat 1.3 x font-size, and its
# UA sheet sets body { line-height: 1.33 } and input/button
# { line-height: 1.33 }. Browsers compute normal from the font's metrics:
# for the DejaVu faces every page renders with here, (ascent + descent)
# / em = 1.164; Chromium's sans is ~1.15. So text here was 12-15% taller
# than in a browser: pages ran longer, and fixed-height bars, buttons and
# badges sized for browser line boxes clipped or overflowed their labels.
#
# layout.c's line_height() now uses 1.164 for normal, and the three
# forced 1.33 values are gone from default.css (body and form controls
# get normal, as in browsers). Patch 207's lh unit still takes normal as
# 1.2em (libcss cannot see this constant).
#
# Test: testpages/pages/CSS-line-height-normal.html (LINEH214, 3 checks,
# Chromium 3/3): one 16px line 17.5-19.5px, three lines 52-58px, a label
# with 10px vertical padding fitting a 40px bar.
diff --git a/content/handlers/html/layout.c b/content/handlers/html/layout.c
--- a/content/handlers/html/layout.c
+++ b/content/handlers/html/layout.c
@@ -4327,8 +4327,12 @@
 
 	lhtype = css_computed_line_height(style, &lhvalue, &lhunit);
 	if (lhtype == CSS_LINE_HEIGHT_NORMAL) {
-		/* Normal => use a constant of 1.3 * font-size */
-		lhvalue = FLTTOFIX(1.3);
+		/* Normal => a constant times font-size. VitaBrowser patch
+		 * 214: 1.164, DejaVu's own normal line height ((ascent +
+		 * descent) / em, the fonts every page renders with here) and
+		 * what a browser computes for them; NetSurf's 1.3 made every
+		 * page ~12% taller than in browsers. */
+		lhvalue = FLTTOFIX(1.164);
 		lhtype = CSS_LINE_HEIGHT_NUMBER;
 	}
 
diff --git a/resources/default.css b/resources/default.css
--- a/resources/default.css
+++ b/resources/default.css
@@ -8,7 +8,7 @@
 
 head { display: none; }
 
-body { display: block; margin: 8px; line-height: 1.33; }
+body { display: block; margin: 8px; }
 
 div { display: block; }
 
@@ -113,7 +113,7 @@
 
 input, button { display: inline-block; background-color: #fff; color: #000; text-align: left;
 	font-family: sans-serif; width: auto; height: auto; overflow: hidden;
-	border: 1px solid #444; padding: 2px 3px; line-height: 1.33;
+	border: 1px solid #444; padding: 2px 3px;
 	margin: 1px; box-sizing: border-box; }
 input[disabled] { background-color: #ddd; color: #333; }
 input[type=button], input[type=reset], input[type=submit], button {
