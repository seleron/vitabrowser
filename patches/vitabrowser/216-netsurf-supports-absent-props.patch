# netsurf: @supports knows the properties this engine lacks (patch 216)
# Generated 2026-10-07
# Base: seleron/vitabrowser 92dfbf1 (patch stack through 215)
#
# Patch 103's three-valued @supports evaluator answers FALSE only for a
# couple of iOS-only features; everything else is UNKNOWN, which keeps
# `@supports (...)` blocks and drops `@supports not (...)` ones. Pages put
# their fallbacks in the latter -- an opaque background where
# backdrop-filter would blur, a plain box where clip-path would cut a
# shape -- so here the fallback was dropped and, where the positive block
# was used, its effect never rendered either: glass panels came out
# transparent over busy content.
#
# sv_decl's absent list now names the properties this engine does not
# implement (no libcss property, or dropped by the rewrite):
# backdrop-filter (and -webkit-), filter, clip-path (and -webkit-),
# mix-blend-mode, background-blend-mode, isolation, container,
# container-type, container-name, content-visibility, contain,
# contain-intrinsic-size, text-wrap(-mode/-style), anchor-name,
# position-anchor, position-area, view-transition-name,
# animation-timeline, scroll-timeline, view-timeline, field-sizing,
# interpolate-size, offset-path, scroll-snap-type, overscroll-behavior,
# hyphenate-character. A feature naming one is FALSE, so `not (...)`
# keeps its block and `(...)` drops its own.
#
# Test: testpages/pages/CSS-supports-absent.html (SUPABS216, 3 checks;
# Vita-specific -- Chromium implements these properties and answers
# checks 1-2 the other way, 3 matches): backdrop-filter / clip-path
# fallbacks apply, a block requiring backdrop-filter does not, supported
# features (display: grid) unchanged.
diff --git a/content/handlers/css/css_rewrite.c b/content/handlers/css/css_rewrite.c
--- a/content/handlers/css/css_rewrite.c
+++ b/content/handlers/css/css_rewrite.c
@@ -4449,6 +4449,23 @@
 {
 	static const char *const absent_props[] = {
 		"-webkit-touch-callout",	/* iOS only */
+		/* patch 216: properties this engine does not implement (no
+		 * libcss property, or dropped by the rewrite). Pages put the
+		 * fallback for them in `@supports not (...)` -- opaque
+		 * backgrounds instead of backdrop blur, plain boxes instead of
+		 * clip-path shapes -- and that block was dropped, while
+		 * `@supports (...)` blocks needing them were kept. */
+		"backdrop-filter", "-webkit-backdrop-filter", "filter",
+		"clip-path", "-webkit-clip-path", "mix-blend-mode",
+		"background-blend-mode", "isolation",
+		"container", "container-type", "container-name",
+		"content-visibility", "contain", "contain-intrinsic-size",
+		"text-wrap", "text-wrap-mode", "text-wrap-style",
+		"anchor-name", "position-anchor", "position-area",
+		"view-transition-name", "animation-timeline",
+		"scroll-timeline", "view-timeline", "field-sizing",
+		"interpolate-size", "offset-path", "scroll-snap-type",
+		"overscroll-behavior", "hyphenate-character",
 		NULL
 	};
 	const char *colon = memchr(s, ':', (size_t)(e - s));
