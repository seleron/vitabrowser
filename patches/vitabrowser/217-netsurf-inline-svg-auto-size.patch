@@ -1060,6 +1061,11 @@
 						&width, &temp_height,
 						INT_MIN, INT_MAX,
 						INT_MIN, INT_MAX);
+			} else if ((b->flags & SVG_INLINE) && width == AUTO) {
+				/* patch 217: as layout_line will size it */
+				int temp_height = height;
+				vb_inline_svg_resolve_size(b, -1, AUTO,
+						&width, &temp_height);
 			}
 
 			fixed = frac = 0;
@@ -4649,6 +4655,19 @@
 
 			/* We reformat the iframe browser window to new
 			 * dimensions in pass 2 */
+		} else if (b->flags & SVG_INLINE) {
+			/* patch 217: inline <svg>, sized from its viewBox
+			 * ratio or the default 300 x 150 */
+			vb_inline_svg_resolve_size(b, *width, AUTO,
+					&b->width, &b->height);
+			if (min_width > 0 && b->width < min_width)
+				b->width = min_width;
+			if (max_width >= 0 && b->width > max_width)
+				b->width = max_width;
+			if (min_height > 0 && b->height < min_height)
+				b->height = min_height;
+			if (max_height >= 0 && b->height > max_height)
+				b->height = max_height;
 		} else if (b->gadget != NULL) {
 			/* form control with no object */
 			if (b->width == AUTO)
@@ -5602,6 +5621,10 @@
 			if (block->obj_w > 0 && block->obj_h > 0)
 				block->height = block->width * block->obj_h /
 						block->obj_w;
+			else if (block->flags & SVG_INLINE)
+				/* patch 217: the viewBox ratio, else 150 */
+				vb_inline_svg_resolve_size(block, -1, AUTO,
