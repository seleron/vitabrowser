 /* exported interface documented in html/vb_inline_svg.h */
+/* patch 217: the root's viewBox width and height, from the DOM */
+static bool vb_svg_viewbox(const struct box *box, float *vw, float *vh)
+{
+	dom_string *name = NULL, *val = NULL;
+	bool ok = false;
+
+	if (box == NULL || box->node == NULL)
+		return false;
+	if (dom_string_create((const uint8_t *)"viewBox", 7, &name) !=
+			DOM_NO_ERR)
+		return false;
+	if (dom_element_get_attribute((dom_element *)box->node, name,
+			&val) == DOM_NO_ERR && val != NULL) {
+		char tmp[80];
+		size_t n = dom_string_byte_length(val), q;
+		float a0, a1, a2, a3;
+
+		if (n > sizeof(tmp) - 1)
+			n = sizeof(tmp) - 1;
+		memcpy(tmp, dom_string_data(val), n);
+		tmp[n] = '\0';
+		for (q = 0; q < n; q++)
+			if (tmp[q] == ',')
+				tmp[q] = ' ';
+		if (sscanf(tmp, "%f %f %f %f", &a0, &a1, &a2, &a3) == 4 &&
+				a2 > 0 && a3 > 0) {
+			*vw = a2;
+			*vh = a3;
+			ok = true;
+		}
+		dom_string_unref(val);
+	}
+	dom_string_unref(name);
+	return ok;
+}
+
+/* exported interface documented in html/vb_inline_svg.h */
+void vb_inline_svg_resolve_size(const struct box *box, int avail,
+		int autov, int *width, int *height)
+{
+	float vw = 0, vh = 0;
+	bool r = vb_svg_viewbox(box, &vw, &vh);
+
+	if (*width == autov && *height == autov) {
+		if (r) {
+			*width = avail >= 0 ? avail : 0;
+			*height = (int)(*width * vh / vw + 0.5f);
+		} else {
+			*width = 300;
+			*height = 150;
+		}
+	} else if (*width == autov) {
+		*width = r ? (int)(*height * vw / vh + 0.5f) : 300;
+	} else if (*height == autov) {
+		*height = r ? (int)(*width * vh / vw + 0.5f) : 150;
+	}
+}
+
 bool vb_inline_svg_paint(struct box *box, int x, int y, int width,
 		int height, const struct redraw_context *ctx,
 		const html_content *html)
