+/**
+ * VitaBrowser patch 217: the size of an inline <svg> whose width or height
+ * (or both) is auto, as browsers size it (CSS 2.1 10.3.2 / 10.6.2 with
+ * SVG's intrinsic ratio): one given dimension and the root's viewBox ratio
+ * give the other; neither given, with a viewBox, is avail wide (pass a
+ * negative avail for the min/max-width pass: 0 wide then); without a
+ * viewBox the default object size, 300 x 150. AUTO inputs only are
+ * changed; layout's AUTO sentinel is passed in as `autov`.
+ */
+void vb_inline_svg_resolve_size(const struct box *box, int avail,
+		int autov, int *width, int *height);
+
 /** Drop every cached diagram (memory pressure, content teardown). */
 void vb_inline_svg_flush(void);
 
