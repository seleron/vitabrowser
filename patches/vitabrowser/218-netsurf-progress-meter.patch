+/* patch 218: a numeric attribute of the box's element, or dflt */
+static double vb_attr_num(const struct box *box, const char *name, double dflt)
+{
+	dom_string *n = NULL, *v = NULL;
+	double r = dflt;
+
+	if (box->node == NULL || dom_string_create((const uint8_t *)name,
+			strlen(name), &n) != DOM_NO_ERR)
+		return dflt;
+	if (dom_element_get_attribute((dom_element *)box->node, n, &v) ==
+			DOM_NO_ERR && v != NULL) {
+		char tmp[40];
+		size_t l = dom_string_byte_length(v);
+		char *end;
+		if (l > sizeof(tmp) - 1)
+			l = sizeof(tmp) - 1;
+		memcpy(tmp, dom_string_data(v), l);
+		tmp[l] = '\0';
+		r = strtod(tmp, &end);
+		if (end == tmp)
+			r = dflt;
+		dom_string_unref(v);
+	}
+	dom_string_unref(n);
+	return r;
+}
+
+/**
+ * patch 218: paint a <progress> / <meter> bar's fill into its content
+ * box (the track is the box's own background, from default.css).
+ * progress: value / max (max default 1); no value attribute is the
+ * indeterminate state, painted as a third of the track. meter: (value -
+ * min) / (max - min), defaults 0..1. Colour: accent-color when set, else
+ * the platform blue (progress) or green (meter).
+ */
+static bool vb_redraw_progress(struct box *box, int x, int y, int width,
+		int height, const struct redraw_context *ctx)
+{
+	plot_style_t fill = *plot_style_fill_wbasec;
+	struct rect rect;
+	colour accent = 0;
+	bool meter = false;
+	double ratio;
+	dom_string *tag = NULL;
+
+	if (width <= 0 || height <= 0)
+		return true;
+	if (box->node != NULL && dom_element_get_tag_name(box->node, &tag) ==
+			DOM_NO_ERR && tag != NULL) {
+		meter = dom_string_byte_length(tag) == 5;
+		dom_string_unref(tag);
+	}
+	if (meter) {
+		double mn = vb_attr_num(box, "min", 0);
+		double mx = vb_attr_num(box, "max", 1);
+		double v = vb_attr_num(box, "value", 0);
+		ratio = mx > mn ? (v - mn) / (mx - mn) : 0;
+	} else {
+		double mx = vb_attr_num(box, "max", 1);
+		double v = vb_attr_num(box, "value", -1);
+		if (mx <= 0)
+			mx = 1;
+		ratio = v < 0 ? 1.0 / 3 : v / mx;
+	}
+	if (ratio < 0)
+		ratio = 0;
+	if (ratio > 1)
+		ratio = 1;
+	if (html_redraw_accent_colour(box, &accent))
+		fill.fill_colour = accent;
+	else
+		fill.fill_colour = meter ? 0x00107c10 : 0x00ff7500;
+	fill.fill_type = PLOT_OP_TYPE_SOLID;
+	fill.stroke_type = PLOT_OP_TYPE_NONE;
+	rect.x0 = x;
+	rect.y0 = y;
+	rect.x1 = x + (int)(width * ratio + 0.5);
+	rect.y1 = y + height;
+	if (rect.x1 <= rect.x0)
+		return true;
+	return ctx->plot->rectangle(ctx, &fill, &rect) == NSERROR_OK;
+}
