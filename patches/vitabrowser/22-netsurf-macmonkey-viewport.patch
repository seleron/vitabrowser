# vitabrowser: set the monkey frontend viewport to the Vita front screen (960x544)
#
# frontends/monkey/browser.c hardcodes 800x600 and ignores the core's
# window_width / window_height options. The golden plotstreams and the
# pristine baseline were captured at 960x544 (Vita front screen), so without
# this patch every engine-comparison diff is dominated by window-size reflow
# rather than engine behaviour.
#
# This is a TOOLING patch (doc 03-golden-plotstream sec.5), kept separate
# from the engine patches and the MIT/GPL boundary.
#
# Changes:
#   frontends/monkey/browser.c
#       800x600 -> 960x544
#
# Applies to: netsurf (after the generated stack)
--- a/frontends/monkey/browser.c
+++ b/frontends/monkey/browser.c
@@ -83,6 +83,6 @@
 	ret->bw = bw;
 
-	ret->width = 800;
-	ret->height = 600;
+	ret->width = 960;   /* VitaBrowser: match Vita front screen */
+	ret->height = 544;  /* VitaBrowser: match Vita front screen */
 
 	moutf(MOUT_WINDOW,
