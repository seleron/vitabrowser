diff --git a/content/handlers/html/redraw.c b/content/handlers/html/redraw.c
--- a/content/handlers/html/redraw.c
+++ b/content/handlers/html/redraw.c
@@ -3449,6 +3449,88 @@
 
 
 /**
+ * patch 222: the <legend> whose fieldset's top border runs through it --
+ * a block child flagged VB_LEGEND that sits at the top of the box (the
+ * first in-flow block; whitespace-only containers before it are skipped).
+ */
+static struct box *vb_fieldset_legend(struct box *box)
+{
+	struct box *c;
+
+	if (box->type != BOX_BLOCK || box->border[TOP].width <= 0)
+		return NULL;
+	for (c = box->children; c != NULL; c = c->next) {
+		if (c->flags & VB_LEGEND)
+			return c->type == BOX_BLOCK ? c : NULL;
+		if (c->type == BOX_INLINE_CONTAINER && c->height == 0)
+			continue;
+		if (c->type == BOX_FLOAT_LEFT || c->type == BOX_FLOAT_RIGHT)
+			continue;
+		return NULL;
+	}
+	return NULL;
+}
+
+/**
+ * patch 222: a fieldset's borders as browsers draw them: the top border
+ * through the middle of the legend (default.css lifts the legend onto
+ * it), left out behind the legend. The border is drawn d lower and d
+ * shorter, in three clipped passes around the gap.
+ */
+static bool vb_redraw_fieldset_borders(struct box *box, struct box *lg,
+		int x_parent, int y_parent, int padding_width,
+		int padding_height, const struct rect *r, float scale,
+		const struct redraw_context *ctx)
+{
+	int bt = box->border[TOP].width;
+	int lh = lg->border[TOP].width + lg->padding[TOP] + lg->height +
+			lg->padding[BOTTOM] + lg->border[BOTTOM].width;
+	/* lg->y is its padding box, relative to box's padding box */
+	int d = lg->y - lg->border[TOP].width + (lh - bt) / 2 + bt;
+	int gx0 = x_parent + box->x + lg->x - lg->border[LEFT].width;
+	int gx1 = x_parent + box->x + lg->x + lg->padding[LEFT] +
+			lg->width + lg->padding[RIGHT] +
+			lg->border[RIGHT].width;
+	int ytop = y_parent + box->y + d;	/* below the moved border */
+	struct rect part[3];
+	int i;
+
+	if (d < 0 || d >= padding_height || gx1 <= gx0) {
+		return html_redraw_borders(box, x_parent, y_parent,
+				padding_width, padding_height, r, scale, ctx);
+	}
+	if (scale != 1.0) {
+		gx0 *= scale;
+		gx1 *= scale;
+		ytop *= scale;
+	}
+	part[0] = *r;
+	if (part[0].x1 > gx0)
+		part[0].x1 = gx0;
+	part[1] = *r;
+	if (part[1].x0 < gx1)
+		part[1].x0 = gx1;
+	part[2] = *r;
+	if (part[2].x0 < gx0)
+		part[2].x0 = gx0;
+	if (part[2].x1 > gx1)
+		part[2].x1 = gx1;
+	if (part[2].y0 < ytop)
+		part[2].y0 = ytop;
+	for (i = 0; i != 3; i++) {
+		if (part[i].x0 >= part[i].x1 || part[i].y0 >= part[i].y1)
+			continue;
+		if (ctx->plot->clip(ctx, &part[i]) != NSERROR_OK)
+			return false;
+		if (!html_redraw_borders(box, x_parent, y_parent + d,
+				padding_width, padding_height - d, &part[i],
+				scale, ctx))
+			return false;
+	}
+	return ctx->plot->clip(ctx, r) == NSERROR_OK;
+}
