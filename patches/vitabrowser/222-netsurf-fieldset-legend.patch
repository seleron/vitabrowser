-fieldset { display: block; border: thin solid #888; margin: 1.12em 0; }
+/* patch 222: browsers' fieldset box; the legend is a shrink-to-fit
+ * block lifted onto the top border (margin-top undoes the border and
+ * padding; margin-bottom restores the padding below it), and redraw
+ * runs the top border through the legend's middle with a gap for it. */
+fieldset { display: block; margin: 0 2px; border: 2px groove #c0c0c0;
+	padding: 0.35em 0.75em 0.625em; min-width: min-content; }
+legend { display: block; width: fit-content; padding: 0 2px;
+	margin: calc(-0.35em - 2px) 0 0.35em; }
 
 noembed, script, style, title { display: none; }
 
