+/**
+ * patch 223: <input type=range> as a browser draws it -- a 4px track,
+ * filled in the accent colour up to the value, and a round thumb -- and
+ * <input type=color> as a swatch of its value inside the button box.
+ */
+static bool vb_redraw_input_widget(struct box *box, int x, int y,
+		int width, int height, const struct redraw_context *ctx)
+{
+	plot_style_t st = *plot_style_fill_wbasec;
+	struct rect rect;
+	const char *v = box->gadget != NULL ? box->gadget->value : NULL;
+	colour accent = 0x00ff7500;	/* #0075ff, as BGR */
+
+	if (width <= 0 || height <= 0)
+		return true;
+	st.fill_type = PLOT_OP_TYPE_SOLID;
+	st.stroke_type = PLOT_OP_TYPE_NONE;
+	dom_string *type = NULL;
+	bool colour_well = false;
+
+	if (box->node != NULL && dom_element_get_attribute(
+			(dom_element *)box->node, corestring_dom_type,
+			&type) == DOM_NO_ERR && type != NULL) {
+		colour_well = dom_string_byte_length(type) == 5 &&
+				strncasecmp(dom_string_data(type), "color",
+						5) == 0;
+		dom_string_unref(type);
+	}
+	if (colour_well) {
+		/* color: a swatch inset 4px, framed in grey */
+		unsigned int rgb = 0;
+		if (v != NULL && v[0] == '#' && strlen(v) == 7)
+			rgb = (unsigned int)strtoul(v + 1, NULL, 16);
+		rect.x0 = x + 4;
+		rect.y0 = y + 4;
+		rect.x1 = x + width - 4;
+		rect.y1 = y + height - 4;
+		if (rect.x1 <= rect.x0 || rect.y1 <= rect.y0)
+			return true;
+		st.fill_colour = 0x00777777;
+		if (ctx->plot->rectangle(ctx, &st, &rect) != NSERROR_OK)
+			return false;
+		rect.x0++;
+		rect.y0++;
+		rect.x1--;
+		rect.y1--;
+		st.fill_colour = ((rgb >> 16) & 0xff) | (rgb & 0xff00) |
+				((rgb & 0xff) << 16);
+		return ctx->plot->rectangle(ctx, &st, &rect) == NSERROR_OK;
+	} else {
+		double mn = vb_attr_num(box, "min", 0);
+		double mx = vb_attr_num(box, "max", 100);
+		double val = (mx > mn) ? mn + (mx - mn) / 2 : mn;
+		double ratio;
+		int r = height < 16 ? height / 2 : 8;
+		int cx, cy = y + height / 2, i;
+		char *end;
+
+		if (v != NULL && v[0] != '\0') {
+			double t = strtod(v, &end);
+			if (end != v)
+				val = t;
+		}
+		ratio = mx > mn ? (val - mn) / (mx - mn) : 0;
+		if (ratio < 0)
+			ratio = 0;
+		if (ratio > 1)
+			ratio = 1;
+		if (html_redraw_accent_colour(box, &accent) == false)
+			accent = 0x00ff7500;
+		cx = x + r + (int)((width - 2 * r) * ratio + 0.5);
+		/* the track: grey, then the filled part */
+		rect.x0 = x + 1;
+		rect.x1 = x + width - 1;
+		rect.y0 = cy - 2;
+		rect.y1 = cy + 2;
+		st.fill_colour = 0x00b2b2b2;
+		if (ctx->plot->rectangle(ctx, &st, &rect) != NSERROR_OK)
+			return false;
+		rect.x1 = cx;
+		st.fill_colour = accent;
+		if (rect.x1 > rect.x0 &&
+				ctx->plot->rectangle(ctx, &st, &rect) != NSERROR_OK)
+			return false;
+		/* the thumb: a disc of horizontal spans */
+		for (i = -r; i < r; i++) {
+			double h = (double)r * r - (i + 0.5) * (i + 0.5);
+			int w = h > 0 ? (int)(sqrt(h) + 0.5) : 0;
+			if (w <= 0)
+				continue;
+			rect.x0 = cx - w;
+			rect.x1 = cx + w;
+			rect.y0 = cy + i;
+			rect.y1 = cy + i + 1;
+			if (ctx->plot->rectangle(ctx, &st, &rect) != NSERROR_OK)
+				return false;
+		}
+		return true;
+	}
+}
