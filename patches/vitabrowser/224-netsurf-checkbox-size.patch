# netsurf: checkboxes and radio buttons at browsers' size (patch 224)
# Generated 2026-10-07
# Base: seleron/vitabrowser 299da34 (patch stack through 223)
#
# A checkbox or radio button with an auto size was 1em square (layout.c)
# plus 0.1em side padding and the 1px margin every input gets: 18 x 16
# at 16px, where browsers draw 13 x 13 with margins 3 3 3 4 (checkbox)
# and 3 3 0 5 (radio). Option lists and consent rows sat wider and taller
# than in a browser.
#
#  - default.css: 13 x 13, no padding, browsers' margins. A CSS width or
#    height still wins (the 1em fallback in layout.c only applies to
#    auto).
#
# Test: testpages/pages/HTML-checkbox-size.html (CHECKBOX224, 4 checks,
# Chromium 4/4; before, 2/4): sizes, margins, a CSS size, and a row of
# labelled options one text line high.
diff --git a/resources/default.css b/resources/default.css
--- a/resources/default.css
+++ b/resources/default.css
@@ -128,7 +128,10 @@
 input[type=image] { background-color: transparent; color: #000;
 	border: none; padding: 0 2px; box-sizing: content-box; }
 input[type=checkbox], input[type=radio] { background-color: transparent;
-	border: none; padding: 0 0.1em; }
+	border: none; padding: 0; width: 13px; height: 13px; }
+/* patch 224: browsers' 13 x 13 boxes and margins (were 1em + padding) */
+input[type=checkbox] { margin: 3px 3px 3px 4px; }
+input[type=radio] { margin: 3px 3px 0 5px; }
 input[type=file] { background-color: #d9d9d9; color: #000; font-style: italic;
 	border: 2px inset #d9d9d9; padding: 1px 2px; }
 /* patch 223: browsers' slider and colour well sizes */
