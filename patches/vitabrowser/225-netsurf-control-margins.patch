# netsurf: no margin on form controls, as in browsers (patch 225)
# Generated 2026-10-07
# Base: seleron/vitabrowser 18bbe95 (patch stack through 224)
#
# default.css gave text inputs, buttons, selects and textareas a 1px
# margin. Browsers give them none (Chromium's UA sheet: input, textarea,
# select, button { margin: 0 }), so every control sat 1px in from its
# container, a block of one button was 2px taller than the button, and
# rows of controls drifted by 2px per control.
#
#  - default.css: margin 0 for input / button, select and textarea
#    (checkbox, radio, range and color keep their own, patches 223-224).
#
# Test: testpages/pages/HTML-control-margins.html (CTLMARGIN225, 3
# checks, Chromium 3/3; before, 0/3): computed margins, controls at the
# container edge, a block holding one button is the button's height.
diff --git a/resources/default.css b/resources/default.css
--- a/resources/default.css
+++ b/resources/default.css
@@ -117,10 +117,11 @@
 
 form { display: block; }
 
+/* patch 225: no margin on form controls, as in browsers (was 1px) */
 input, button { display: inline-block; background-color: #fff; color: #000; text-align: left;
 	font-family: sans-serif; width: auto; height: auto; overflow: hidden;
 	border: 1px solid #444; padding: 2px 3px;
-	margin: 1px; box-sizing: border-box; }
+	margin: 0; box-sizing: border-box; }
 input[disabled] { background-color: #ddd; color: #333; }
 input[type=button], input[type=reset], input[type=submit], button {
 	background-color: #d9d9d9; color: #000; text-align: center;
@@ -146,12 +147,12 @@
 select { background-color: #d9d9d9; color: #000; text-align: left;
 	font-family: sans-serif; width: auto; height: auto; overflow: hidden;
 	border: medium inset #d9d9d9; padding: 1px 3px 1px 2px;
-	white-space: nowrap; margin: 1px; }
+	white-space: nowrap; margin: 0; }
 select:after { content: "\25bc"; border-left: 2px ridge #d9d9d9; }
 
 textarea { background-color: #fff; color: #000; text-align: left;
 	font-family: monospace; width: auto; height: auto; overflow: scroll;
-	margin: 1px; border: 1px solid #333; padding: 1px 3px; }
+	margin: 0; border: 1px solid #333; padding: 1px 3px; }
 textarea[disabled] { background-color: #ddd; color: #333; }
 
 /* patch 222: browsers' fieldset box; the legend is a shrink-to-fit
