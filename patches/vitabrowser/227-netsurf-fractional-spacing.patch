-	 * callers' stack garbage reached the font functions. */
+	/* patch 220: letter-spacing and word-spacing (normal is 0). These
+	 * and the fields after them were left unset, so the callers' stack
+	 * garbage reached the font functions. patch 227: in
+	 * 1/PLOT_SPACING_SCALE px, not truncated to whole pixels (0.1em at
+	 * 16px was 1px a character instead of 1.6). css_fixed has 10
+	 * fraction bits; PLOT_SPACING_SCALE is 1 << 8. */
 	length = 0;
 	unit = CSS_UNIT_PX;
 	fstyle->letter_spacing = (css_computed_letter_spacing(css,
 			&length, &unit) == CSS_LETTER_SPACING_SET) ?
-		FIXTOINT(css_unit_len2device_px(css, unit_len_ctx,
-				length, unit)) : 0;
+		css_unit_len2device_px(css, unit_len_ctx,
+				length, unit) / (1024 / PLOT_SPACING_SCALE) : 0;
 	length = 0;
 	unit = CSS_UNIT_PX;
 	fstyle->word_spacing = (css_computed_word_spacing(css,
 			&length, &unit) == CSS_WORD_SPACING_SET) ?
-		FIXTOINT(css_unit_len2device_px(css, unit_len_ctx,
-				length, unit)) : 0;
+		css_unit_len2device_px(css, unit_len_ctx,
+				length, unit) / (1024 / PLOT_SPACING_SCALE) : 0;
 	fstyle->shadow_x = 0;
 	fstyle->shadow_y = 0;
 	fstyle->shadow_blur = 0;
