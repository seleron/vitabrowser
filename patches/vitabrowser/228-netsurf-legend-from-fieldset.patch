@@ -2302,6 +2305,41 @@
 
 
 /**
+ * patch 228: a fieldset's rendered legend -- its first <legend> child, in
+ * flow (not floated or absolutely positioned) -- sits on the fieldset's
+ * top border, as in browsers: its margin box starts at the fieldset's
+ * border-box top, and the content after it starts the fieldset's top
+ * padding below it. Done here from the fieldset's own border and padding
+ * (patch 222 did it in default.css with the default ones, so a fieldset
+ * reset to no border and padding, as Bootstrap's is, pulled its legend up
+ * over the content above, and so did any legend outside a fieldset).
+ */
+static void vb_legend_margins(struct box *box)
+{
+	struct box *fs = box->parent, *c;
+	int lift;
+
+	if (!(box->flags & VB_LEGEND) || box->type != BOX_BLOCK ||
+			fs == NULL || !(fs->flags & VB_FIELDSET) ||
+			box->style == NULL ||
+			css_computed_position(box->style) ==
+				CSS_POSITION_ABSOLUTE ||
+			css_computed_position(box->style) ==
+				CSS_POSITION_FIXED)
+		return;
+	for (c = fs->children; c != NULL && !(c->flags & VB_LEGEND);
+			c = c->next)
+		;
+	if (c != box)
+		return;
+	lift = fs->border[TOP].width + fs->padding[TOP];
+	if (lift <= 0)
+		return;
+	box->margin[TOP] -= lift;
+	box->margin[BOTTOM] += fs->padding[TOP];
+}
+
+/**
  * Compute dimensions of box, margins, paddings, and borders for a block-level
  * element.
  *
@@ -2394,6 +2432,8 @@
 		margin[TOP] = 0;
 	if (margin[BOTTOM] == AUTO)
 		margin[BOTTOM] = 0;
+
+	vb_legend_margins(box);
 }
 
 
