 				 * border runs through the first one */
 	VB_INPUT_WIDGET = 1 << 20,	/* patch 223: <input type=range /
 					 * color>: redraw paints the widget */
+	VB_FIELDSET = 1 << 21,	/* patch 228: <fieldset>: its first legend
+				 * is lifted onto the top border */
 	VB_DEFINITE_HEIGHT = 1 << 17,	/* VitaBrowser: an absolutely
 					 * positioned box whose height comes
 					 * from top + bottom: percentage
