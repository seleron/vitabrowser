 static struct box*
 layout_next_margin_block(const css_unit_ctx *unit_len_ctx,
 			 struct box *box,
@@ -1991,6 +1993,7 @@
 						NULL, NULL, NULL, NULL,
 						NULL, NULL, box->margin,
 						box->padding, box->border);
+				vb_legend_margins(box);	/* patch 228 */
 
