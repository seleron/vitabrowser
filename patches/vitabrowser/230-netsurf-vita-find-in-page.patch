+
+/**
+ * \file
+ * Find in page (roadmap WS-E, Phase 1 exit).
+ *
+ * The core's text search does the work (content/textsearch.c: the matches,
+ * the highlight, a CONTENT_MSG_SCROLL to the current one, which
+ * vita/window.c centres on screen). The Vita has no find bar, so the
+ * entry is the URL keyboard: text typed there that starts with '/' is a
+ * term to find (no URL starts with one). SELECT + DOWN / UP step to the
+ * next / previous match, and typing the same term again steps forwards
+ * too. The message line shows where the find is ("2 of 5").
+ */
+
+#include <stdbool.h>
+#include <stdio.h>
+#include <string.h>
+
+#include "utils/errors.h"
+#include "desktop/search.h"
+
+#include "vita/diag.h"
+#include "vita/download.h"
+#include "vita/window.h"
+#include "vita/find.h"
+
+/** How long the position stays on the message line, ms. */
+#define FIND_MESSAGE_MS 4000
+
+static struct {
+	char term[128];
+	unsigned int index, count;
+} find;
+
+/** Read the position back from the core and put it on screen. */
+static void report(struct gui_window *gw)
+{
+	struct browser_window *bw = vita_window_browser(gw);
+
+	find.index = find.count = 0;
+	if (bw != NULL)
+		browser_window_search_position(bw, &find.index, &find.count);
+	if (find.count == 0)
+		vita_show_message(FIND_MESSAGE_MS, "find \"%s\": not found",
+				  find.term);
+	else
+		vita_show_message(FIND_MESSAGE_MS, "find \"%s\": %u of %u",
+				  find.term, find.index, find.count);
+	vita_diag_log("find: \"%s\" %u/%u", find.term, find.index,
+		      find.count);
+	vita_window_force_redraw(gw);
+}
+
+/* exported interface documented in vita/find.h */
+void vita_find(struct gui_window *gw, const char *term)
+{
+	struct browser_window *bw = vita_window_browser(gw);
+
+	if (bw == NULL)
+		return;
+	if (term[0] == '\0') {
+		if (find.term[0] != '\0') {
+			browser_window_search(bw, gw, SEARCH_FLAG_FORWARDS,
+					      NULL);
+			vita_show_message(1500, "find ended");
+			vita_diag_log("find: ended");
+		}
+		find.term[0] = '\0';
+		find.index = find.count = 0;
+		vita_window_force_redraw(gw);
+		return;
+	}
+	/* The same term continues (core: same string = next match); a new
+	 * one starts over at the top of the page. */
+	snprintf(find.term, sizeof(find.term), "%s", term);
+	browser_window_search(bw, gw, SEARCH_FLAG_FORWARDS, find.term);
+	report(gw);
+}
+
+/* exported interface documented in vita/find.h */
+void vita_find_step(struct gui_window *gw, bool forwards)
+{
+	struct browser_window *bw = vita_window_browser(gw);
+
+	if (bw == NULL || find.term[0] == '\0')
+		return;
+	browser_window_search(bw, gw,
+			      forwards ? SEARCH_FLAG_FORWARDS : 0, find.term);
+	report(gw);
+}
+
+/* exported interface documented in vita/find.h */
+bool vita_find_active(void)
+{
+	return find.term[0] != '\0';
+}
+
+/* exported interface documented in vita/find.h */
+void vita_find_position(unsigned int *index, unsigned int *count)
+{
+	*index = find.index;
+	*count = find.count;
+}
+
+/* exported interface documented in vita/find.h */
+void vita_find_reset(struct gui_window *gw)
+{
+	(void)gw;
+	if (find.term[0] != '\0')
+		vita_diag_log("find: \"%s\" dropped (new page)", find.term);
+	find.term[0] = '\0';
+	find.index = find.count = 0;
+}
