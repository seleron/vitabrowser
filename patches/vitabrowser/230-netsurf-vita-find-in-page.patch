+
+/** \file Find in page (vita/find.c). */
+
+#ifndef NETSURF_VITA_FIND_H
+#define NETSURF_VITA_FIND_H
+
+#include <stdbool.h>
+
+struct gui_window;
+
+/**
+ * Find `term` in the window's page, case-insensitively: a new term starts
+ * at the first match, the term already being found moves to the next one
+ * (so typing it again steps through the page), and "" ends the find.
+ * The match is highlighted and scrolled to; the message line says
+ * "n of N".
+ */
+void vita_find(struct gui_window *gw, const char *term);
+
+/** The next (forwards) or previous match of the active find; wraps. */
+void vita_find_step(struct gui_window *gw, bool forwards);
+
+/** True while a find has a term (matches or not). */
+bool vita_find_active(void);
+
+/** The active find's position: match `*index` (1-based, 0 = none) of
+ * `*count`. */
+void vita_find_position(unsigned int *index, unsigned int *count);
+
+/** Forget the find: the window got a new page (its matches went with the
+ * old one). */
+void vita_find_reset(struct gui_window *gw);
+
+#endif
