# netsurf: find in page on the Vita (patch 230; roadmap WS-E, Phase 1 exit)
# Generated 2026-10-10
# Base: seleron/vitabrowser c1a0f0e (patch stack through 229)
#
# Find in page is on the Phase 1 exit list and the frontend had none. The
# core's text search already does the work (content/textsearch.c: the
# matches, the highlight, a CONTENT_MSG_SCROLL to the current one); the
# Vita had no way in and nowhere to show the result.
#
#  - vita/find.c (new): the URL keyboard is the find bar. Text typed into
#    it that starts with '/' is a term to find (no typed URL starts with
#    one); a new term starts at the first match, the same term again
#    moves to the next, "/" alone ends the find. Case-insensitive. The
#    message line says 'find "term": 2 of 5' or 'not found'.
#  - vita/main.c: SELECT + DOWN / UP step to the next / previous match
#    (before the autotest's early return, so the interaction pass can
#    press them; only while a find is active).
#  - content/textsearch.c: the next match after the last is the first and
#    the previous before the first is the last, as browsers' find does
#    (the core stopped at either end). content_textsearch_position() and
#    browser_window_search_position() give the current match's position
#    and the match count.
#  - vita/window.c: set_scroll with an AREA (only the text search sends
#    one; fragments, history and drags send a point and are unchanged)
#    converts the content rect to zoomed offsets, leaves the view alone
#    when the match is already on screen, else centres it, then clamps.
#    The old code put the match's top-left at the screen's corner, ignoring
#    zoom. A new page drops the find (its matches went with the old page).
#  - vita/chrome.c: the home page's controls line mentions find.
#  - vita/interact.c: C_FIND and eight steps on IN-find.html (three
#    matches, one in capitals, two far below the first screen): first on
#    screen, SELECT+DOWN scrolls to the second, retyping steps to the
#    third, wrap forwards and backwards, a missing term, "/" ends it. Each
#    checks the position, that the match is on screen, and a minimum
#    scroll offset.
#
diff --git a/content/textsearch.c b/content/textsearch.c
--- a/content/textsearch.c
+++ b/content/textsearch.c
@@ -282,13 +282,19 @@ search_text(struct textsearch_context *context,
 		context->newsearch = false;
 
 	} else if (context->current != NULL) {
-		/* continued search in the direction specified */
+		/* continued search in the direction specified; past the
+		 * last match it wraps to the first and back, as browsers'
+		 * find does (VitaBrowser patch 230) */
 		if (forwards) {
 			if (context->current->next)
 				context->current = context->current->next;
+			else
+				context->current = context->found->next;
 		} else {
 			if (context->current->prev)
 				context->current = context->current->prev;
+			else
+				context->current = context->found->prev;
 		}
 	}
 
@@ -756,6 +762,30 @@ content_textsearch(struct hlcache_handle *h,
 }
 
 
+/* exported interface, documented in content/textsearch.h */
+void content_textsearch_position(struct hlcache_handle *h,
+				 unsigned int *index, unsigned int *count)
+{
+	struct content *c = hlcache_handle_get_content(h);
+	struct textsearch_context *ctx;
+	struct list_entry *a;
+	unsigned int n = 0;
+
+	*index = *count = 0;
+	if (c == NULL || c->textsearch.context == NULL)
+		return;
+	ctx = c->textsearch.context;
+	if (ctx->found == NULL)
+		return;
+	for (a = ctx->found->next; a != NULL; a = a->next) {
+		n++;
+		if (a == ctx->current)
+			*index = n;
+	}
+	*count = n;
+}
+
+
 /* exported interface, documented in content/content.h */
 nserror content_textsearch_clear(struct hlcache_handle *h)
 {
