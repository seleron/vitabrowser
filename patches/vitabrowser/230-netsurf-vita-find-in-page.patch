+	return (int)(gw->revealed.y0 * scale) >= gw->scrolly &&
+		(int)(gw->revealed.y1 * scale) <=
+			gw->scrolly + VITA_SCREEN_HEIGHT &&
+		(int)(gw->revealed.x0 * scale) >= gw->scrollx &&
+		(int)(gw->revealed.x0 * scale) <
+			gw->scrollx + VITA_SCREEN_WIDTH;
+}
