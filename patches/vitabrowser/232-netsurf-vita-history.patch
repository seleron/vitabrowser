+/** The history page's length; the home page shows the first few. */
+#define HISTORY_MAX 200
+#define HISTORY_HOME 8
+
+/** A visited page, from the URL database. */
+struct visit {
+	char *url;
+	char *title;
+	time_t when;
+	unsigned int visits;
+};
+
+static struct {
+	struct visit *v;
+	unsigned int n, cap;
+} visits;
+
+static void visits_free(void)
+{
+	unsigned int i;
+
+	for (i = 0; i < visits.n; i++) {
+		free(visits.v[i].url);
+		free(visits.v[i].title);
+	}
+	free(visits.v);
+	memset(&visits, 0, sizeof(visits));
+}
+
+static bool visit_entry(nsurl *url, const struct url_data *d)
+{
+	const char *s = nsurl_access(url);
+	struct visit *v;
+
+	if (d->visits == 0 || d->last_visit == 0)
+		return true;
+	/* Not our own pages (home, history, downloads), nor about:. */
+	if (strncmp(s, "file:///" VITA_DIAG_DIR,
+		    sizeof("file:///" VITA_DIAG_DIR) - 1) == 0 ||
+	    strncmp(s, "about:", 6) == 0)
+		return true;
+	if (visits.n == visits.cap) {
+		unsigned int cap = visits.cap ? visits.cap * 2 : 64;
+		struct visit *nv = realloc(visits.v, cap * sizeof(*nv));
+		if (nv == NULL)
+			return false;
+		visits.v = nv;
+		visits.cap = cap;
+	}
+	v = &visits.v[visits.n];
+	v->url = strdup(s);
+	v->title = (d->title != NULL && d->title[0] != '\0') ?
+		strdup(d->title) : NULL;
+	v->when = d->last_visit;
+	v->visits = d->visits;
+	if (v->url == NULL) {
+		free(v->title);
+		return false;
+	}
+	visits.n++;
+	return true;
+}
+
+static int visit_newest_first(const void *a, const void *b)
+{
+	const struct visit *x = a, *y = b;
+
+	if (x->when != y->when)
+		return x->when < y->when ? 1 : -1;
+	return strcmp(x->url, y->url);
+}
+
+/** The URL database's visited pages, newest first, into visits. */
+static void visits_collect(void)
+{
+	visits_free();
+	urldb_iterate_entries(visit_entry);
+	if (visits.n > 1)
+		qsort(visits.v, visits.n, sizeof(visits.v[0]),
+		      visit_newest_first);
+}
+
+/** "5 min ago": the Vita's clock may be set to any zone, a difference
+ * reads right in all of them. */
+static void put_age(FILE *fp, time_t when, time_t now)
+{
+	long d = (long)(now - when);
+
+	if (d < 60)
+		fputs("just now", fp);
+	else if (d < 3600)
+		fprintf(fp, "%ld min ago", d / 60);
+	else if (d < 86400)
+		fprintf(fp, "%ld h ago", d / 3600);
+	else
+		fprintf(fp, "%ld days ago", d / 86400);
+}
+
+/** The first `max` visits as links, each with its host and age. */
+static void put_visits(FILE *fp, unsigned int max)
+{
+	time_t now = time(NULL);
+	unsigned int i;
+
+	for (i = 0; i < visits.n && i < max; i++) {
+		const struct visit *v = &visits.v[i];
+		const char *t = v->title != NULL ? v->title : v->url;
+		const char *h = strstr(v->url, "://");
+
+		h = h != NULL ? h + 3 : v->url;
+		fputs("<a href=\"", fp);
+		put_escaped(fp, v->url, strlen(v->url));
+		fputs("\">", fp);
+		put_escaped(fp, t, strlen(t) > 120 ? 120 : strlen(t));
+		fputs("<span class=\"meta\">", fp);
+		if (strcspn(h, "/?#") > 0)
+			put_escaped(fp, h, strcspn(h, "/?#"));
+		else	/* file:///...: no host */
+			fputs("file", fp);
+		fputs(" &middot; ", fp);
+		put_age(fp, v->when, now);
+		fputs("</span></a>\n", fp);
+	}
+}
+
+/** The history page: every visit the database keeps, up to HISTORY_MAX. */
+static void write_history(void)
+{
+	FILE *fp = fopen(VITA_HISTORY_FILE, "w");
+
+	if (fp == NULL)
+		return;
+	fputs("<!DOCTYPE html>\n<html><head><meta charset=\"utf-8\">"
+	      "<title>History</title><style>\n"
+	      "body { font-family: sans-serif; font-size: 18px;"
+	      " margin: 28px 12px 30px 12px; }\n"
+	      "h1 { font-size: 26px; margin: 0 0 6px 0; }\n"
+	      ".hint { color: #444; font-size: 15px; }\n"
+	      ".recent a { display: block; padding: 6px 12px; margin: 3px 0;"
+	      " background: #f0f0f0; border-radius: 6px; color: #103070;"
+	      " text-decoration: none; }\n"
+	      ".meta { display: block; color: #666; font-size: 14px; }\n"
+	      "</style></head><body>\n<h1>History</h1>\n"
+	      "<div class=\"recent\">\n", fp);
+	put_visits(fp, HISTORY_MAX);
+	fputs("</div>\n", fp);
+	if (visits.n == 0)
+		fputs("<p class=\"hint\">No pages visited yet.</p>\n", fp);
+	fprintf(fp, "<p class=\"hint\">%u pages, newest first. Kept in "
+		VITA_URLDB_FILE " (pages not visited for a month drop "
+		"out).</p>\n</body></html>\n", visits.n);
+	fclose(fp);
+}
