+/** The first href of the home page's recent list ends with `expect`,
+ * and the history page has at least `min` entries. */
+static bool history_ok(const char *expect, int min, char *detail,
+		       size_t max)
+{
+	static char buf[65536];
+	const char *r, *h, *q;
+	size_t n = 0, k = strlen(expect);
+	int entries = 0;
+	FILE *fp = fopen(VITA_HOME_FILE, "rb");
+	bool first = false;
+	char href[96] = "-";
+
+	if (fp != NULL) {
+		n = fread(buf, 1, sizeof(buf) - 1, fp);
+		fclose(fp);
+	}
+	buf[n] = '\0';
+	r = strstr(buf, "<div class=\"recent\">");
+	h = r ? strstr(r, "href=\"") : NULL;
+	q = h ? strchr(h + 6, '"') : NULL;
+	if (q != NULL) {
+		/* copied now: buf is reused for the history page below */
+		snprintf(href, sizeof href, "%.*s", (int)(q - (h + 6)), h + 6);
+		if ((size_t)(q - (h + 6)) >= k)
+			first = strncmp(q - k, expect, k) == 0;
+	}
+	n = 0;
+	fp = fopen(VITA_HISTORY_FILE, "rb");
+	if (fp != NULL) {
+		n = fread(buf, 1, sizeof(buf) - 1, fp);
+		fclose(fp);
+	}
+	buf[n] = '\0';
+	for (r = buf; (r = strstr(r, "<span class=\"meta\">")) != NULL; r++)
+		entries++;
+	snprintf(detail, max, "recent list %s, first %s; history %d pages",
+		 h ? "found" : "MISSING", href, entries);
+	return first && entries >= min;
+}
