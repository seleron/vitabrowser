# netsurf: offsetParent, offsetTop/Left and clientTop/Left per CSSOM View
# (patch 234)
# Generated 2026-10-10
# Base: seleron/vitabrowser (patch stack through 233)
#
# make.wordpress.org/core: a setTimeout callback burned the whole 8 s
# script budget ("InternalError: interrupted"; stack: jquery.sonar
# detect() -> the <el-layout> offsetParent getter). The getter was always
# document.body -- body's own included -- so the classic
#   do { top += el.offsetTop; } while (el = el.offsetParent);
# never ended. Where such a loop did end, offsetTop counted from the
# parent BOX, so the sum was not the element's position either.
#
#  - qjs_offset_parent(): CSSOM View's offsetParent -- none for body,
#    html and position:fixed; else the nearest positioned ancestor, or
#    (for a static element) a td/th/table, or body; none when no such
#    ancestor is found (detached, in head). A native getter replaces the
#    JS one in lay_src; boxless once the tree is settled = null.
#  - offsetTop/Left: the border edge from the offsetParent's padding
#    edge, or from the page when that is body; body/html answer 0.
#  - clientTop/Left: the top/left border widths (the polyfill's were
#    constant 0 stubs; its acc() leaves a native getter alone).
#
# Gate: testpages/pages/JS-offsetparent.html OFFPARENT 8/8 (Chromium
# 8/8; before 0/8, the loop capped at 50 steps). Checks compare offsets
# with the engine's own getBoundingClientRect, so they hold under any
# layout.
#
diff --git a/content/handlers/javascript/quickjs/macsurf_qjs.c b/content/handlers/javascript/quickjs/macsurf_qjs.c
--- a/content/handlers/javascript/quickjs/macsurf_qjs.c
+++ b/content/handlers/javascript/quickjs/macsurf_qjs.c
@@ -7770,6 +7770,108 @@ static void qjs_box_origin(struct box *b, int *ox, int *oy)
 	*oy = y;
 }
 
+/* VitaBrowser patch 234: is n an element named tag? */
+static int qjs_node_is_tag(dom_node *n, const char *tag)
+{
+	dom_node_type t = 0;
+	dom_string *name = NULL;
+	int r;
+
+	if (n == NULL || macsurf_dom_node_get_node_type(n, &t) != DOM_NO_ERR
+			|| t != 1)
+		return 0;
+	if (macsurf_dom_element_get_tag_name((dom_element *) n, &name)
+			!= DOM_NO_ERR || name == NULL)
+		return 0;
+	r = strcasecmp(dom_string_data(name), tag) == 0;
+	macsurf_dom_string_unref(name);
+	return r;
+}
+
+/* VitaBrowser patch 234: CSSOM View's offsetParent of element n (box b).
+ *
+ * The JS getter was always document.body -- body's own included -- so
+ *   do { top += el.offsetTop; } while (el = el.offsetParent);
+ * never ended (make.wordpress.org: jquery.sonar spun out the 8 s budget
+ * and o2 never rendered its posts). Now: none for body, html and
+ * position:fixed; else the nearest ancestor that is positioned, or -- for
+ * a static element -- a td, th or table, or body; none when no such
+ * ancestor is found (detached, in head). b NULL means the element has no
+ * box: the caller answers null once the tree is settled, and while it is
+ * not, this goes by the DOM alone (body for anything under it).
+ *
+ * Returns a REF'd node or NULL. *opbox gets the offsetParent's box, or
+ * NULL for body: offsets then count from the page. */
+static dom_node *qjs_offset_parent(dom_node *n, struct box *b,
+		struct box **opbox)
+{
+	dom_node *p = NULL, *next;
+	int static_el = 1;
+
+	*opbox = NULL;
+	if (qjs_node_is_tag(n, "body") || qjs_node_is_tag(n, "html"))
+		return NULL;
+	if (b != NULL && b->style != NULL) {
+		uint8_t pos = css_computed_position(b->style);
+		if (pos == CSS_POSITION_FIXED)
+			return NULL;
+		static_el = (pos == CSS_POSITION_STATIC);
+	}
+	macsurf_dom_node_get_parent_node(n, &p);
+	while (p != NULL) {
+		dom_node_type t = 0;
+
+		macsurf_dom_node_get_node_type(p, &t);
+		if (t != 1)
+			break;	/* the document or a fragment: not under body */
+		if (qjs_node_is_tag(p, "body"))
+			return p;
+		if (b != NULL) {
+			struct box *pb = box_for_node(p);
+			if (pb != NULL && macsurf_ptr_is_heap((const void *)pb) &&
+			    pb->style != NULL &&
+			    (css_computed_position(pb->style) !=
+					CSS_POSITION_STATIC ||
+			     (static_el && (qjs_node_is_tag(p, "td") ||
+					    qjs_node_is_tag(p, "th") ||
+					    qjs_node_is_tag(p, "table"))))) {
+				*opbox = pb;
+				return p;
+			}
+		}
+		next = NULL;
+		macsurf_dom_node_get_parent_node(p, &next);
+		macsurf_dom_node_unref(p);
+		p = next;
+	}
+	if (p != NULL)
+		macsurf_dom_node_unref(p);
+	return NULL;
+}
+
+/* VitaBrowser patch 234: the offsetParent getter (it was JS: always
+ * body). Settled and boxless = not rendered = null. */
+static JSValue qjs_el_offset_parent(JSContext *ctx, JSValueConst this_val,
+		int argc, JSValueConst *argv, int magic, JSValueConst *func_data)
+{
+	dom_node *n, *op;
+	struct box *b = NULL, *opb = NULL;
+	(void)argc; (void)argv; (void)magic; (void)func_data;
+
+	n = qjs_get_node(this_val);
+	if (n == NULL)
+		return JS_NULL;
+	qjs_geometry_flush(ctx);
+	if (qjs_geometry_settled(ctx)) {
+		struct content *c = qjs_get_content_for_ctx(ctx);
+		b = qjs_box_for(ctx, this_val);
+		if (b == NULL && c != NULL && c->status == CONTENT_STATUS_DONE)
+			return JS_NULL;
+	}
+	op = qjs_offset_parent(n, b, &opb);
+	return op != NULL ? qjs_wrap_any_node(ctx, op) : JS_NULL;
+}
