# libcss: an inline style outranks every normal author rule (patch 236)
# Generated 2026-10-10
# Base: seleron/vitabrowser (patch stack through 235)
#
# css_select_style() cascades the style attribute after all the sheets
# but did not set the state's specificity or origin for it, so it was
# ranked with whatever the LAST rule matched from the LAST sheet had
# left. With one sheet that is usually the competing rule itself and the
# tie goes to the inline value; on a real page a later sheet matches a
# less specific rule last ("div { ... }"), and "#content { display:
# none }" then beat style="display:block" -- make.wordpress.org's o2 app
# stayed hidden after jQuery's .show(). A UA or user sheet last in the
# list would have made inline style lose to every author rule. Upstream
# libcss has the same code.
#
#  - src/select/select.c: before cascading the inline style, specificity
#    CSS_SPECIFICITY_A (what the inline sheet's selector is given at
#    parse) and origin AUTHOR. Author !important still beats a normal
#    inline value; an inline !important beats an author !important.
#
# Gate: testpages/pages/CSS-inline-outranks.html INLINE236 4/4 (Chromium
# 4/4; disarmed 1/4 -- check 3, author !important over normal inline,
# passes either way). make.wordpress.org/core with 233-236: 48.6 -> 81.0,
# text recall 0.28 -> 0.998 (r24, r19's Chrome reference).
#
diff --git a/src/select/select.c b/src/select/select.c
--- a/src/select/select.c
+++ b/src/select/select.c
@@ -1622,6 +1622,18 @@ css_error css_select_style(css_select_ctx *ctx, void *node,
 			state.computed = state.results->styles[
 					CSS_PSEUDO_ELEMENT_NONE];
 
+			/* VitaBrowser patch 236: an author declaration of the
+			 * highest specificity. Both were left as whatever the
+			 * last rule matched from the last sheet had set, so a
+			 * plain "#content { display: none }" outranked an
+			 * inline display:block whenever a later sheet matched
+			 * a less specific rule (make.wordpress.org: o2's
+			 * jQuery .show() never showed the app), and a UA or
+			 * user sheet last in the list made inline style lose
+			 * to every author rule. */
+			state.current_specificity = CSS_SPECIFICITY_A;
+			state.current_origin = CSS_ORIGIN_AUTHOR;
+
 			error = cascade_style(sel->style, &state);
 			if (error != CSS_OK)
 				goto cleanup;
