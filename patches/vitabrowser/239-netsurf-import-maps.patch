+/* patch 239: resolve spec (n bytes) against base as qjs_module_resolve
+ * does, then through the page's import map: the scopes whose URL prefixes
+ * base, most specific first, then the top-level "imports". A bare
+ * specifier with no rule stays NULL (the load fails by name, as before). */
+static char *qjs_module_resolve_mapped(struct module_registry *reg,
+	const char *base, const char *spec, size_t n)
+{
+	char *url = qjs_module_resolve(base, spec, n), *key, *mapped = NULL;
+
+	if (reg == NULL || (reg->n_imports == 0 && reg->n_scopes == 0))
+		return url;
+	key = url != NULL ? strdup(url) : strndup(spec, n);
+	if (key == NULL)
+		return url;
+	/* scopes whose URL prefixes base, the longest (most specific) first */
+	if (base != NULL && reg->n_scopes > 0) {
+		const struct qjs_importmap_scope **hit;
+		unsigned int i, j, nh = 0;
+		hit = (const struct qjs_importmap_scope **)malloc(
+			reg->n_scopes * sizeof(*hit));
+		for (i = 0; hit != NULL && i < reg->n_scopes; i++)
+			if (strncmp(reg->scopes[i].prefix, base,
+				    strlen(reg->scopes[i].prefix)) == 0)
+				hit[nh++] = &reg->scopes[i];
+		for (i = 1; i < nh; i++)	/* insertion sort, longest first */
+			for (j = i; j > 0 && strlen(hit[j]->prefix) >
+					strlen(hit[j - 1]->prefix); j--) {
+				const struct qjs_importmap_scope *t = hit[j];
+				hit[j] = hit[j - 1];
+				hit[j - 1] = t;
+			}
+		for (i = 0; i < nh && mapped == NULL; i++)
+			mapped = qjs_importmap_lookup(hit[i]->e, hit[i]->n, key);
+		free(hit);
+	}
+	if (mapped == NULL)
+		mapped = qjs_importmap_lookup(reg->imports, reg->n_imports, key);
+	free(key);
+	if (mapped != NULL) {
+		free(url);
+		return mapped;
+	}
+	return url;
+}
