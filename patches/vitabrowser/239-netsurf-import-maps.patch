+/* patch 239: an import map's "imports"-shaped object into (*e, *n),
+ * appended; keys and values resolved against base. Per the HTML spec a
+ * URL-like key is normalized to its URL, a value that is not URL-like is
+ * ignored, and the first rule for a key wins when maps merge. */
+static void qjs_importmap_add(JSContext *ctx, JSValueConst obj,
+	const char *base, struct qjs_importmap_entry **e, unsigned int *n)
+{
+	JSPropertyEnum *tab = NULL;
+	uint32_t len = 0, i;
+
+	if (!JS_IsObject(obj) ||
+	    JS_GetOwnPropertyNames(ctx, &tab, &len, obj,
+			JS_GPN_STRING_MASK | JS_GPN_ENUM_ONLY) < 0)
+		return;
+	for (i = 0; i < len; i++) {
+		JSValue v = JS_GetProperty(ctx, obj, tab[i].atom);
+		const char *k = JS_AtomToCString(ctx, tab[i].atom);
+		const char *vs = JS_IsString(v) ? JS_ToCString(ctx, v) : NULL;
+		char *key = NULL, *val = NULL;
+		unsigned int d;
+
+		if (k != NULL && k[0] != '\0' && vs != NULL) {
+			key = qjs_module_resolve(base, k, strlen(k));
+			if (key == NULL)
+				key = strdup(k);
+			val = qjs_module_resolve(base, vs, strlen(vs));
+		}
+		for (d = 0; key != NULL && d < *n; d++)
+			if (strcmp((*e)[d].key, key) == 0)
+				break;
+		if (key != NULL && val != NULL && d == *n) {
+			struct qjs_importmap_entry *ne = (struct qjs_importmap_entry *)
+				realloc(*e, (*n + 1) * sizeof(**e));
+			if (ne != NULL) {
+				*e = ne;
+				ne[*n].key = key;
+				ne[*n].value = val;
+				(*n)++;
+				key = val = NULL;
+			}
+		}
+		free(key);
+		free(val);
+		if (vs != NULL) JS_FreeCString(ctx, vs);
+		if (k != NULL) JS_FreeCString(ctx, k);
+		JS_FreeValue(ctx, v);
+	}
+	JS_FreePropertyEnum(ctx, tab, len);
+}
