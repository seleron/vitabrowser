+/* patch 239: the rule of e[0..n) for spec: an exact key, else the longest
+ * key ending in '/' that spec starts with (its value must end in '/' too).
+ * Returns the malloc'd URL, or NULL. */
+static char *qjs_importmap_lookup(const struct qjs_importmap_entry *e,
+	unsigned int n, const char *spec)
+{
+	const struct qjs_importmap_entry *best = NULL;
+	size_t bestlen = 0, kl, vl, sl = strlen(spec);
+	unsigned int i;
+	char *out;
+
+	for (i = 0; i < n; i++)
+		if (strcmp(e[i].key, spec) == 0)
+			return strdup(e[i].value);
+	for (i = 0; i < n; i++) {
+		kl = strlen(e[i].key);
+		if (kl > bestlen && kl <= sl && e[i].key[kl - 1] == '/' &&
+		    strncmp(e[i].key, spec, kl) == 0) {
+			best = &e[i];
+			bestlen = kl;
+		}
+	}
+	if (best == NULL)
+		return NULL;
+	vl = strlen(best->value);
+	if (vl == 0 || best->value[vl - 1] != '/')
+		return NULL;	/* a prefix key needs a prefix value */
+	out = (char *)malloc(vl + (sl - bestlen) + 1);
+	if (out == NULL)
+		return NULL;
+	memcpy(out, best->value, vl);
+	memcpy(out + vl, spec + bestlen, sl - bestlen + 1);
+	return out;
+}
