+/* exported interface documented in js.h (patch 239) */
+bool js_set_import_map(struct jsthread *thread, const uint8_t *txt, size_t txtlen,
+		const char *base)
+{
+	struct module_registry *reg;
+	JSContext *ctx;
+	JSValue map, sub;
+	char *buf;
+
+	if (thread == NULL || thread->ctx == NULL || thread->heap == NULL ||
+	    thread->heap->module_reg == NULL || txt == NULL)
+		return false;
+	ctx = thread->ctx;
+	reg = thread->heap->module_reg;
+	qjs_module_registry_for_nav(reg);
+	buf = (char *)malloc(txtlen + 1);
+	if (buf == NULL)
+		return false;
+	memcpy(buf, txt, txtlen);
+	buf[txtlen] = '\0';
+	map = JS_ParseJSON(ctx, buf, txtlen, "importmap");
+	free(buf);
+	if (JS_IsException(map) || !JS_IsObject(map)) {
+		JSValue ex = JS_GetException(ctx);
+		qjs_log_exc(ctx, ex, "importmap", "parse");
+		JS_FreeValue(ctx, ex);
+		JS_FreeValue(ctx, map);
+		return false;
+	}
+	sub = JS_GetPropertyStr(ctx, map, "imports");
+	qjs_importmap_add(ctx, sub, base, &reg->imports, &reg->n_imports);
+	JS_FreeValue(ctx, sub);
+	sub = JS_GetPropertyStr(ctx, map, "scopes");
+	if (JS_IsObject(sub)) {
+		JSPropertyEnum *tab = NULL;
+		uint32_t len = 0, i;
+		if (JS_GetOwnPropertyNames(ctx, &tab, &len, sub,
+				JS_GPN_STRING_MASK | JS_GPN_ENUM_ONLY) == 0) {
+			for (i = 0; i < len; i++) {
+				const char *k = JS_AtomToCString(ctx, tab[i].atom);
+				char *pfx = k ? qjs_module_resolve(base, k,
+						strlen(k)) : NULL;
+				JSValue so = JS_GetProperty(ctx, sub, tab[i].atom);
+				struct qjs_importmap_scope *ns = NULL;
+				if (pfx != NULL)
+					ns = (struct qjs_importmap_scope *)realloc(
+						reg->scopes, (reg->n_scopes + 1) *
+						sizeof(*reg->scopes));
+				if (ns != NULL) {
+					struct qjs_importmap_scope *sc;
+					reg->scopes = ns;
+					sc = &ns[reg->n_scopes++];
+					sc->prefix = pfx;
+					sc->e = NULL;
+					sc->n = 0;
+					pfx = NULL;
+					qjs_importmap_add(ctx, so, base, &sc->e, &sc->n);
+				}
+				free(pfx);
+				JS_FreeValue(ctx, so);
+				if (k != NULL) JS_FreeCString(ctx, k);
+			}
+			JS_FreePropertyEnum(ctx, tab, len);
+		}
+	}
+	JS_FreeValue(ctx, sub);
+	JS_FreeValue(ctx, map);
+	macsurf_debug_log_writef("LIFE importmap: %u imports, %u scopes "
+		"(base %.200s)", reg->n_imports, reg->n_scopes,
+		base ? base : "-");
+	return true;
 }
 
