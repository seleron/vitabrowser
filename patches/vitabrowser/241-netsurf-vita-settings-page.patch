+/* ---- settings (patch 241) ----------------------------------------- */
+
+static struct {
+	unsigned int zoom;	/**< zoom step for new windows */
+	bool blocking;		/**< content blocking */
+} settings = { 0, true };
+
+static void settings_save(void)
+{
+	FILE *fp = fopen(VITA_SETTINGS_FILE, "w");
+
+	if (fp == NULL) {
+		vita_diag_log("chrome: cannot write %s", VITA_SETTINGS_FILE);
+		return;
+	}
+	fprintf(fp, "# VitaBrowser settings (the settings page writes this)\n"
+		"zoom=%u\nblocking=%s\n", settings.zoom,
+		settings.blocking ? "on" : "off");
+	fclose(fp);
+}
+
+/* exported interface documented in vita/chrome.h */
+void vita_chrome_load_settings(void)
+{
+	char line[256];
+	FILE *fp = fopen(VITA_SETTINGS_FILE, "r");
+
+	while (fp != NULL && fgets(line, sizeof(line), fp) != NULL) {
+		unsigned int z;
+		if (sscanf(line, "zoom=%u", &z) == 1 && z < VITA_ZOOM_STEPS)
+			settings.zoom = z;
+		else if (strncmp(line, "blocking=off", 12) == 0)
+			settings.blocking = false;
+		else if (strncmp(line, "blocking=on", 11) == 0)
+			settings.blocking = true;
+	}
+	if (fp != NULL)
+		fclose(fp);
+	vita_resolve_blocking = settings.blocking;
+	vita_diag_log("chrome: settings: zoom step %u, blocking %s",
+		      settings.zoom, settings.blocking ? "on" : "off");
+}
+
+/* exported interface documented in vita/chrome.h */
+unsigned int vita_chrome_setting_zoom(void)
+{
+	return settings.zoom;
+}
+
+/** The user agent preset now in VITA_USERAGENT_FILE, or "custom". */
+static const char *ua_current(void)
+{
+	char line[1024];
+	const char *l, *r = "chrome";
+	size_t n, i;
+	FILE *fp = fopen(VITA_USERAGENT_FILE, "r");
+
+	while (fp != NULL && fgets(line, sizeof(line), fp) != NULL) {
+		l = line;
+		n = strlen(line);
+		trim(&l, &n);
+		if (n == 0 || l[0] == '#')
+			continue;
+		r = "custom";
+		for (i = 0; i < sizeof(ua_presets) / sizeof(ua_presets[0]); i++)
+			if (strlen(ua_presets[i].name) == n &&
+			    strncasecmp(l, ua_presets[i].name, n) == 0)
+				r = ua_presets[i].name;
+		break;
+	}
+	if (fp != NULL)
+		fclose(fp);
+	return r;
+}
+
+/* exported interface documented in vita/chrome.h */
+bool vita_chrome_set(struct gui_window *gw, const char *key,
+		     const char *value)
+{
+	size_t i;
+
+	if (strcmp(key, "ua") == 0) {
+		for (i = 0; i < sizeof(ua_presets) / sizeof(ua_presets[0]); i++)
+			if (strcasecmp(value, ua_presets[i].name) == 0) {
+				FILE *fp = fopen(VITA_USERAGENT_FILE, "w");
+				if (fp == NULL)
+					return false;
+				fprintf(fp, "# the settings page wrote this; a "
+					"preset name or a whole user agent\n"
+					"%s\n", ua_presets[i].name);
+				fclose(fp);
+				vita_chrome_load_useragent();
+				return true;
+			}
+		return false;
+	}
+	if (strcmp(key, "zoom") == 0) {
+		char *end;
+		unsigned long z = strtoul(value, &end, 10);
+		if (*value == '\0' || *end != '\0' || z >= VITA_ZOOM_STEPS)
+			return false;
+		settings.zoom = (unsigned int)z;
+		settings_save();
+		if (gw != NULL)
+			vita_input_set_zoom(gw, settings.zoom);
+		return true;
+	}
+	if (strcmp(key, "blocking") == 0) {
+		if (strcmp(value, "on") != 0 && strcmp(value, "off") != 0)
+			return false;
+		settings.blocking = value[1] == 'n';
+		vita_resolve_blocking = settings.blocking;
+		settings_save();
+		return true;
+	}
+	return false;
+}
+
+/* exported interface documented in vita/chrome.h */
+const char *vita_chrome_setting(const char *key)
+{
+	static char buf[16];
+
+	if (strcmp(key, "ua") == 0)
+		return ua_current();
+	if (strcmp(key, "blocking") == 0)
+		return settings.blocking ? "on" : "off";
+	if (strcmp(key, "zoom") == 0) {
+		snprintf(buf, sizeof(buf), "%u", settings.zoom);
+		return buf;
+	}
+	return "";
+}
+
+/** One choice: a link that sets it, or the current value in bold. */
+static size_t settings_choice(char *out, size_t max, const char *key,
+			      const char *value, const char *label, bool on)
+{
+	if (on)
+		return (size_t)snprintf(out, max, "<b class=\"on\">%s</b> ",
+					label);
+	return (size_t)snprintf(out, max, "<a href=\"" VITA_SETTINGS_PATH
+				"?%s=%s\">%s</a> ", key, value, label);
+}
+
+/* exported interface documented in vita/chrome.h */
+void vita_chrome_settings_page(char *out, size_t max, const char *note)
+{
+	const char *ua = ua_current();
+	size_t o = 0, i;
+
+#define PUT(...) do { if (o < max) o += (size_t)snprintf(out + o, max - o, __VA_ARGS__); } while (0)
+	PUT("<!DOCTYPE html><html><head><meta charset=\"utf-8\">"
+	    "<title>Settings</title><style>body{font-family:sans-serif;"
+	    "font-size:18px;margin:28px 12px}h1{font-size:26px;margin:0 0 8px}"
+	    "h2{font-size:20px;margin:16px 0 6px}a,b.on{display:inline-block;"
+	    "padding:8px 14px;margin:3px 4px 3px 0;border-radius:6px;"
+	    "text-decoration:none}a{background:#e8eef8;color:#103070}"
+	    "b.on{background:#103070;color:#fff}.hint{color:#444;"
+	    "font-size:15px}.note{background:#dfd;padding:6px 10px}"
+	    "</style></head><body><h1>Settings</h1>");
+	if (note != NULL)
+		PUT("<p class=\"note\" id=\"note\">%s</p>", note);
+	PUT("<h2>User agent</h2><p>");
+	for (i = 0; i < sizeof(ua_presets) / sizeof(ua_presets[0]); i++)
+		if (o < max)
+			o += settings_choice(out + o, max - o, "ua",
+					     ua_presets[i].name,
+					     ua_presets[i].name,
+					     strcmp(ua, ua_presets[i].name) == 0);
+	PUT("</p><p class=\"hint\">What sites see: %s%s. Kept in "
+	    VITA_USERAGENT_FILE " (a whole user agent string works too).</p>",
+	    strcmp(ua, "custom") == 0 ? "a custom string" : ua,
+	    strcmp(ua, "vita") == 0 ? " (the Vita's own)" : "");
+	PUT("<h2>Zoom</h2><p>");
+	for (i = 0; i < VITA_ZOOM_STEPS; i++) {
+		char v[8], label[16];
+		snprintf(v, sizeof(v), "%u", (unsigned int)i);
+		snprintf(label, sizeof(label), "%d%%",
+			 (int)(vita_zoom_steps[i] * 100.0f + 0.5f));
+		if (o < max)
+			o += settings_choice(out + o, max - o, "zoom", v, label,
+					     settings.zoom == i);
+	}
+	PUT("</p><p class=\"hint\">Where pages start; &#x25a1; still steps "
+	    "through these.</p><h2>Content blocking</h2><p>");
+	if (o < max)
+		o += settings_choice(out + o, max - o, "blocking", "on", "on",
+				     settings.blocking);
+	if (o < max)
+		o += settings_choice(out + o, max - o, "blocking", "off", "off",
+				     !settings.blocking);
+	PUT("</p><p class=\"hint\">Ad and tracker hosts in the block list "
+	    "are not fetched (" VITA_BLOCKLIST_USER " adds hosts or "
+	    "@@exceptions). %u blocked so far.</p>", vita_resolve_blocked);
+	PUT("<p class=\"hint\"><a href=\"" VITA_HOME_URL "\">Home</a></p>"
+	    "</body></html>");
+#undef PUT
+}
