+/* patch 245: the downloads in progress, and the last ones that ended */
+static struct gui_download_window *active;
+static unsigned int next_id;
+#define RECENT_MAX 8
+static struct {
+	char name[128];
+	char path[256];
+	unsigned long long size;
+	char result[64];		/**< "saved", "failed: ...", "cancelled" */
+} recent[RECENT_MAX];
+static unsigned int recent_n;
+
+static void list_remove(struct gui_download_window *dw)
+{
+	struct gui_download_window **pp;
+
+	for (pp = &active; *pp != NULL; pp = &(*pp)->next)
+		if (*pp == dw) {
+			*pp = dw->next;
+			return;
+		}
+}
+
+static void remember(struct gui_download_window *dw, const char *result)
+{
+	unsigned int i;
+
+	for (i = (recent_n < RECENT_MAX ? recent_n : RECENT_MAX - 1); i > 0; i--)
+		recent[i] = recent[i - 1];
+	snprintf(recent[0].name, sizeof(recent[0].name), "%s", dw->name);
+	snprintf(recent[0].path, sizeof(recent[0].path), "%s", dw->path);
+	recent[0].size = dw->got;
+	snprintf(recent[0].result, sizeof(recent[0].result), "%s", result);
+	if (recent_n < RECENT_MAX)
+		recent_n++;
+}
+
+/* "1.2 MB/s", "340 KB/s" */
+static void fmt_rate(char *out, size_t max, unsigned long long r)
+{
+	if (r >= 1024 * 1024)
+		snprintf(out, max, "%llu.%llu MB/s", r / (1024 * 1024),
+			 (r % (1024 * 1024)) * 10 / (1024 * 1024));
+	else
+		snprintf(out, max, "%llu KB/s", r / 1024);
+}
+
+/* the time left, "0:42", or "" when it cannot be told */
+static void fmt_eta(char *out, size_t max, const struct gui_download_window *dw)
+{
+	unsigned long long s;
+
+	out[0] = '\0';
+	if (dw->total == 0 || dw->rate == 0 || dw->got >= dw->total)
+		return;
+	s = (dw->total - dw->got) / dw->rate;
+	snprintf(out, max, "%llu:%02llu", s / 60, s % 60);
+}
+
