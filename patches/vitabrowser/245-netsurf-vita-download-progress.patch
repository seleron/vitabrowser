+		unsigned long long r = (dw->got - dw->rate_got) * 1000 /
+			(now - dw->rate_ms);
+		dw->rate = dw->rate == 0 ? r : (dw->rate * 3 + r) / 4;
+		dw->rate_got = dw->got;
+		dw->rate_ms = now;
+	}
 	if (now - dw->last_ms >= 500) {
+		/* patch 245: the progress strip (vita/main.c) shows it --
