-	vita_show_message(0, "downloading %s...", dw->name);
+	vita_show_message(2000, "downloading %s...", dw->name);
 	dw->last_ms = vita_diag_ms();
+	dw->start_ms = dw->rate_ms = dw->last_ms;
+	dw->id = ++next_id;
+	dw->next = active;
+	active = dw;
 	return dw;
 }
 
@@ -195,15 +265,22 @@ static nserror vita_download_data(struct gui_download_window *dw,
 	}
 	dw->got += size;
