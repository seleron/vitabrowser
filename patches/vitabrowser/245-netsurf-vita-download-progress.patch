+/* exported interface documented in vita/download.h */
+bool vita_download_progress(char *name, size_t max, unsigned int *permille,
+			    char *detail, size_t dmax)
+{
+	struct gui_download_window *dw = active;
+	char rate[24], eta[32];
+	unsigned int n = 0;
+
+	if (dw == NULL)
+		return false;
+	for (; dw != NULL; dw = dw->next)
+		n++;
+	dw = active;
+	snprintf(name, max, "%s%s", dw->name, n > 1 ? " (+more)" : "");
+	*permille = dw->total > 0 ?
+		(unsigned int)(dw->got * 1000 / dw->total) : 0;
+	fmt_rate(rate, sizeof(rate), dw->rate);
+	fmt_eta(eta, sizeof(eta), dw);
+	if (dw->total > 0)
+		snprintf(detail, dmax, "%llu / %llu KiB  %s%s%s",
+			 dw->got / 1024, dw->total / 1024, rate,
+			 eta[0] ? "  " : "", eta);
+	else
+		snprintf(detail, dmax, "%llu KiB  %s", dw->got / 1024, rate);
+	return true;
+}
+
+/* exported interface documented in vita/download.h */
+bool vita_download_recent(unsigned int i, const char **name,
+			  const char **result)
+{
+	if (i >= recent_n)
+		return false;
+	*name = recent[i].name;
+	*result = recent[i].result;
+	return true;
+}
+
+/* exported interface documented in vita/download.h */
+bool vita_download_cancel(unsigned int id)
+{
+	struct gui_download_window *dw;
+
+	for (dw = active; dw != NULL; dw = dw->next)
+		if (dw->id == id)
+			break;
+	if (dw == NULL)
+		return false;
+	/* as the GTK frontend does: stop the fetch and let the context go;
+	 * the core calls this window no more */
+	download_context_abort(dw->ctx);
+	download_context_destroy(dw->ctx);
+	if (dw->fp != NULL) {
+		fclose(dw->fp);
+		dw->fp = NULL;
+		remove(dw->path);
+	}
+	vita_diag_log("download: %s cancelled at %llu bytes", dw->name,
+		      dw->got);
+	vita_show_message(3000, "download cancelled: %s", dw->name);
+	list_remove(dw);
+	vita_download_overlay_changed();
+	remember(dw, "cancelled");
+	free(dw);
+	return true;
+}
+
+/* exported interface documented in vita/download.h */
+void vita_download_page(char *out, size_t max, const char *note)
+{
+	struct gui_download_window *dw;
+	size_t o = 0;
+	unsigned int i;
+
+#define PUT(...) do { if (o < max) o += (size_t)snprintf(out + o, max - o, __VA_ARGS__); } while (0)
+	PUT("<!DOCTYPE html><html><head><meta charset=\"utf-8\">");
+	if (active != NULL)	/* live while something downloads */
+		PUT("<meta http-equiv=\"refresh\" content=\"1\">");
+	PUT("<title>Downloads</title><style>body{font-family:sans-serif;"
+	    "font-size:18px;margin:28px 12px}h1{font-size:26px;margin:0 0 8px}"
+	    "h2{font-size:20px;margin:16px 0 6px}.d{padding:8px 0;"
+	    "border-bottom:1px solid #ddd}progress{width:100%%;height:16px}"
+	    ".hint{color:#444;font-size:15px}a.c{display:inline-block;"
+	    "padding:6px 14px;background:#fde;color:#702;border-radius:6px;"
+	    "text-decoration:none}.note{background:#dfd;padding:6px 10px}"
+	    "</style></head><body><h1>Downloads</h1>");
+	if (note != NULL)
+		PUT("<p class=\"note\" id=\"note\">%s</p>", note);
+	PUT("<h2>In progress</h2>");
+	if (active == NULL)
+		PUT("<p class=\"hint\" id=\"idle\">Nothing downloading.</p>");
+	for (dw = active; dw != NULL; dw = dw->next) {
+		char rate[24], eta[32];
+		fmt_rate(rate, sizeof(rate), dw->rate);
+		fmt_eta(eta, sizeof(eta), dw);
+		PUT("<div class=\"d\"><b>%s</b><br>", dw->name);
+		if (dw->total > 0)
+			PUT("<progress max=\"%llu\" value=\"%llu\"></progress>"
+			    "<br>%llu%% &middot; %llu of %llu KiB &middot; %s%s%s",
+			    dw->total, dw->got, dw->got * 100 / dw->total,
+			    dw->got / 1024, dw->total / 1024, rate,
+			    eta[0] ? " &middot; " : "", eta);
+		else
+			PUT("%llu KiB &middot; %s", dw->got / 1024, rate);
+		PUT(" <a class=\"c\" href=\"" VITA_DOWNLOADS_PATH
+		    "?cancel=%u\">Cancel</a></div>", dw->id);
+	}
+	PUT("<h2>Recent</h2>");
+	if (recent_n == 0)
+		PUT("<p class=\"hint\">None this session.</p>");
+	for (i = 0; i < recent_n; i++)
+		PUT("<div class=\"d\"><b>%s</b> &middot; %s &middot; %llu KiB"
+		    "<br><span class=\"hint\">%s</span></div>",
+		    recent[i].name, recent[i].result, recent[i].size / 1024,
+		    recent[i].path);
+	PUT("<p class=\"hint\">Saved in %s or %sdownloads/. <a href=\""
+	    "file:///ux0:data/VitaBrowser/home.html\">Home</a></p>"
+	    "</body></html>", vita_download_dirs[0], VITA_DIAG_DIR);
+#undef PUT
+}
