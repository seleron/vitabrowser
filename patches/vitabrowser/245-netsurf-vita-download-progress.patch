  * sceIoMkdir("ux0:download") fails and the fopen gets ENOENT (hardware
@@ -176,8 +242,12 @@ vita_download_create(download_context *ctx, struct gui_window *parent)
 	vita_diag_log("download: %s -> %s (%llu bytes, %s)",
