# netsurf: document methods captured and called on a scratch document
# answer for it; a frame shown late takes its box's size; innerWidth /
# innerHeight inside a frame are the frame's (patch 246; roadmap WS-B2)
# Generated 2026-10-11
# Base: seleron/vitabrowser (patch stack through 245, 244 applied)
#
# With 244 loading script-made frames, the Guardian's consent frame
# (sourcepoint) loaded and the page went blank at the top, 74.1 -> 70.1:
# the frame's QuickJS heap ran out ("InternalError: out of memory" in the
# innerHTML getter). Measured: each innerHTML read in the frame was about
# twice the previous one, 265 KB to 48 MB in ten calls. The cause was not
# the serializer (a size cap had been proposed): DOMPurify captures
# document.getElementsByTagName once and calls it on its scratch document,
#     getElementsByTagName.call(parsed, 'body')[0]
# and our document methods answered for the page's document whatever
# `this` was. So sanitize() returned the frame's own body, React put it
# back in, and the next sanitize doubled it. The page was wrong long
# before it ran out of memory.
#
#  - vita_polyfill.js: document.getElementsByTagName / ByClassName /
#    getElementById / querySelector / querySelectorAll called with another
#    document as `this` run on that document. The stand-in documents
#    (DOMParser.parseFromString, implementation.createHTMLDocument: our
#    elements wearing a document's hat) find their own html / head / body
#    by tag (they found none) and answer getElementsByTagName for their
#    tree.
#  - desktop/frames.c: when recalculate_iframes links a window to a new
#    box (a frame made box-less inside a display:none container, shown
#    later), the window takes that box's position and size and is
#    reformatted, as layout does for windows it already knows; it kept
#    300x150 until the next layout -- sourcepoint's full-screen consent
#    dialog sat in the corner.
#  - quickjs/macsurf_qjs.c: innerWidth / innerHeight (and outer*) in an
#    iframe's realm are the frame window's size; they read the whole
#    screen (a 400x120 frame was told 960x544).
#
# Gate: testpages/pages/JS-scratch-doc.html SCRATCHDOC 6/6 (Chromium
# 6/6): a captured getElementsByTagName / querySelector on DOMParser and
# createHTMLDocument documents, a DOMPurify-shaped sanitize repeated five
# times stays the same length, the page's own document still answers.
# JS-xorigin-frame.html check 9: a cross-origin frame in a display:none
# container, shown after it loads, reports 400x120 (Chromium 9/9; before:
# 960x544, and 300x150 drawn).
#
# Scorecard (r19 reference): guardian 70.1 (244 alone) -> 80.1 twice
# (74.1 before 244; the consent dialog now drawn as Chromium draws it,
# visual 0.267 -> 0.536); bbc 63.5 (244 alone) -> 75.6 / 76.0.
#
# Not changed: element nodeName is still lowercase (tagName is uppercase;
# the spec makes them equal) -- a deliberate earlier choice, logged as a
# follow-up; DOMPurify lowercases names itself.
#
diff --git a/content/handlers/javascript/quickjs/macsurf_qjs.c b/content/handlers/javascript/quickjs/macsurf_qjs.c
--- a/content/handlers/javascript/quickjs/macsurf_qjs.c
+++ b/content/handlers/javascript/quickjs/macsurf_qjs.c
@@ -1232,19 +1232,27 @@ static int macsurf_qjs_scroll_x(void);
 static int macsurf_qjs_scroll_y(void);
 static int macsurf_qjs_viewport_w(void);
 static int macsurf_qjs_viewport_h(void);
+static bool qjs_frame_size(JSContext *ctx, int *w, int *h);
 
-/* fixes1011 - thin JS wrappers over the viewport/scroll accessors. */
+/* fixes1011 - thin JS wrappers over the viewport/scroll accessors.
+ * VitaBrowser patch 246: in an iframe's realm, the frame's own size. */
 static JSValue qjs_js_viewport_w(JSContext *ctx, JSValueConst this_val,
 		int argc, JSValueConst *argv)
 {
+	int w, h;
 	(void)this_val; (void)argc; (void)argv;
+	if (qjs_frame_size(ctx, &w, &h))
+		return JS_NewInt32(ctx, w);
 	return JS_NewInt32(ctx, macsurf_qjs_viewport_w());
 }
 
 static JSValue qjs_js_viewport_h(JSContext *ctx, JSValueConst this_val,
 		int argc, JSValueConst *argv)
 {
+	int w, h;
 	(void)this_val; (void)argc; (void)argv;
+	if (qjs_frame_size(ctx, &w, &h))
+		return JS_NewInt32(ctx, h);
 	return JS_NewInt32(ctx, macsurf_qjs_viewport_h());
 }
 
@@ -3153,6 +3161,27 @@ qjs_xrealm_iframe_key(JSContext *ctx, JSValueConst this_val,
 	return JS_NULL;
 }
 
+/* VitaBrowser patch 246: the size of the iframe window this realm's page is
+ * shown in -- innerWidth/innerHeight inside a frame read the whole screen,
+ * so a frame measuring itself (a consent dialog, a captcha) was told
+ * 960x544 in a 400x120 box. False outside a frame. */
+static bool qjs_frame_size(JSContext *ctx, int *w, int *h)
+{
+	struct content *c = qjs_get_content_for_ctx(ctx);
+	struct browser_window *bw;
+
+	if (c == NULL || c->handler == NULL ||
+	    c->handler->type() != CONTENT_HTML)
+		return false;
+	bw = ((struct html_content *)c)->bw;
+	if (bw == NULL || bw->browser_window_type != BROWSER_WINDOW_IFRAME ||
+	    bw->width <= 0 || bw->height <= 0)
+		return false;
+	*w = bw->width;
+	*h = bw->height;
+	return true;
+}
