# netsurf: js_set_import_map for the Duktape backend -- the nsmonkey link
# (patch 248)
# Generated 2026-10-11
# Base: seleron/vitabrowser (patch stack through 247)
#
# Patch 239 (import maps) defined js_set_import_map in the QuickJS and
# "none" backends only; html/script.c calls it whatever the backend, so
# build-patched.sh's nsmonkey (Duktape) stopped linking ("undefined
# reference to js_set_import_map"). The gate builds only the simulator
# (QuickJS), so nothing noticed until the run-30 restage. Duktape runs no
# modules: the stub accepts the map and does nothing, as "none" does.
#
diff --git a/content/handlers/javascript/duktape/dukky.c b/content/handlers/javascript/duktape/dukky.c
--- a/content/handlers/javascript/duktape/dukky.c
+++ b/content/handlers/javascript/duktape/dukky.c
@@ -923,6 +923,18 @@ void dukky_log_stack_frame(duk_context *ctx, const char * reason)
 }
 
 
+/* exported interface documented in js.h -- VitaBrowser patch 248: import
+ * maps (patch 239) are QuickJS-only; Duktape runs no modules, so there is
+ * nothing to resolve through one. The missing definition broke the
+ * nsmonkey (Duktape) link. */
+bool
+js_set_import_map(jsthread *thread, const uint8_t *txt, size_t txtlen,
+		const char *base)
+{
+	(void)thread; (void)txt; (void)txtlen; (void)base;
+	return true;
+}
+
 /* exported interface documented in js.h */
 bool
 js_exec(jsthread *thread, const uint8_t *txt, size_t txtlen, const char *name)
