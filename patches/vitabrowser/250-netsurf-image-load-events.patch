+static JSValue qjs_img_state(JSContext *ctx, JSValueConst this_val,
+		int argc, JSValueConst *argv)
+{
+	struct content *c;
+	dom_node *n;
+	dom_string *nm, *v = NULL;
+	int st = 0, w = 0, h = 0;
+	bool known;
+	JSValue a;
+	(void)this_val;
+	if (argc < 1 || (n = qjs_get_node(argv[0])) == NULL)
