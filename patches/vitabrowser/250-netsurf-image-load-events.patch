+/* ---- VitaBrowser patch 250: <img> load / error events and state ----
+ *
+ * No <img> ever fired load or error, and complete / naturalWidth /
+ * naturalHeight did not exist: scripts that wait for an image (lightboxes,
+ * masonry grids, carousels, imagesLoaded, `img.onload = ...; img.src =`)
+ * waited forever, and new Image() was a stand-in object that never loaded.
+ * Each element's last image is recorded here -- from its object fetch when
+ * it is in the document, or from a fetch of its own when it is not -- and
+ * its event fires once per URL from a scheduled callback (never inside the
+ * cache callback, where a script could rebuild the box tree under it).
+ * The table outlives box-tree rebuilds, which re-adopt the objects and
+ * report DONE again; it is freed with the content.
+ */
+
+#define IMG_DETACHED_MAX 32	/**< detached fetches in flight per page */
+
+struct html_img_state {
+	struct html_img_state *next;
+	html_content *c;
+	dom_node *node;		/**< ref'd */
+	nsurl *url;		/**< ref'd: the URL state describes */
+	hlcache_handle *h;	/**< a detached fetch in flight, or NULL */
+	int state;		/**< 0 loading, 1 loaded, 2 broken */
+	int w, ht;		/**< natural size when loaded */
+	bool queued;		/**< its event waits to be fired */
+	bool fired;		/**< the event for url has been queued */
+};
+
+static void img_fire_cb(void *p);
+
+/* A superseded fetch's handle: released from img_fire_cb, never aborted
+ * and never inside a cache callback -- aborting a handle whose content
+ * another user shares clones the content, and doing it during that
+ * content's DONE broadcast made the clone report READY while unlocked
+ * (content_set_ready's assertion, github.com). */
+struct html_img_stale {
+	struct html_img_stale *next;
+	hlcache_handle *h;
+};
+
+static void img_retire(html_content *c, hlcache_handle **h)
+{
+	struct html_img_stale *z;
+	if (*h == NULL)
+		return;
+	z = malloc(sizeof(*z));
+	if (z == NULL)
+		return;		/* leaked until the content goes */
+	z->h = *h;
+	z->next = c->img_stale;
+	c->img_stale = z;
+	*h = NULL;
+	if (!c->img_fire_scheduled) {
+		c->img_fire_scheduled = true;
+		guit->misc->schedule(0, img_fire_cb, c);
+	}
+}
+
+static void img_release_stale(html_content *c)
+{
+	while (c->img_stale != NULL) {
+		struct html_img_stale *z = c->img_stale;
+		c->img_stale = z->next;
+		safe_hlcache_handle_release(&z->h);
+		free(z);
+	}
+}
+
+static struct html_img_state *img_find(html_content *c, dom_node *node)
+{
+	struct html_img_state *s;
+	for (s = c->img_states; s != NULL; s = s->next)
+		if (s->node == node)
+			return s;
+	return NULL;
+}
+
+static struct html_img_state *img_get(html_content *c, dom_node *node)
+{
+	struct html_img_state *s = img_find(c, node);
+	if (s != NULL)
+		return s;
+	s = calloc(1, sizeof(*s));
+	if (s == NULL)
+		return NULL;
+	s->c = c;
+	s->node = dom_node_ref(node);
+	s->next = c->img_states;
+	c->img_states = s;
+	return s;
+}
+
+static void img_set_url(struct html_img_state *s, nsurl *url)
+{
+	if (s->url != NULL)
+		nsurl_unref(s->url);
+	s->url = url != NULL ? nsurl_ref(url) : NULL;
+}
+
+static bool img_is_img(dom_node *node)
+{
+	dom_string *name = NULL;
+	bool is = false;
+	if (node != NULL && dom_node_get_node_name(node, &name) == DOM_NO_ERR &&
+	    name != NULL) {
+		is = dom_string_caseless_lwc_isequal(name, corestring_lwc_img);
+		dom_string_unref(name);
+	}
+	return is;
+}
+
+static void img_resolve_pending(html_content *c, bool *waiting)
+{
+	struct content_html_object *o;
+	*waiting = false;
+	for (o = c->object_list; o != NULL; o = o->next) {
+		if (o->img_settle == 0)
+			continue;
+		if (o->box == NULL) {
+			o->img_settle = 0;
+		} else if (o->box->node != NULL) {
+			int st = o->img_settle;
+			o->img_settle = 0;
+			html_image_object_settled(c, o, st == 1);
+		} else if (c->base.status == CONTENT_STATUS_LOADING) {
+			*waiting = true;	/* boxes still being built */
+		} else {
+			/* built, and still no element: generated content
+			 * (content: url(...)), not an <img> -- polling for
+			 * it would run every 20 ms for the page's life */
+			o->img_settle = 0;
+		}
+	}
+}
+
+static void img_fire_cb(void *p)
+{
+	html_content *c = p;
+	struct html_img_state *s;
+	bool waiting;
+
+	c->img_fire_scheduled = false;
+	img_release_stale(c);
+	img_resolve_pending(c, &waiting);
+	if (waiting && !c->img_fire_scheduled) {
+		/* box construction still running: look again shortly */
+		c->img_fire_scheduled = true;
+		guit->misc->schedule(20, img_fire_cb, c);
+	}
+	/* one at a time, rescanning: a handler may set another src, which
+	 * adds to or changes the table */
+	for (;;) {
+		for (s = c->img_states; s != NULL && !s->queued; s = s->next)
+			;
+		if (s == NULL)
+			break;
+		s->queued = false;
+		if (c->js_thread != NULL && s->state != 0)
+			js_fire_script_load(c->js_thread, s->node,
+					s->state == 1 ? 1 : 0);
+	}
+}
+
+static void img_queue(struct html_img_state *s)
+{
+	s->queued = true;
+	s->fired = true;
+	if (!s->c->img_fire_scheduled) {
+		s->c->img_fire_scheduled = true;
+		guit->misc->schedule(0, img_fire_cb, s->c);
+	}
+}
+
+/* exported interface documented in html/html.h */
+void html_image_object_settled(html_content *c, struct content_html_object *o,
+		bool ok)
+{
+	struct html_img_state *s;
+	dom_node *node;
+	int st = ok ? 1 : 2;
+
+	if (o->background || o->box == NULL || o->url == NULL)
+		return;
+	node = o->box->node;
+	if (node == NULL) {
+		/* inside box construction: the box gets its element after
+		 * this; resolved by img_fire_cb */
+		o->img_settle = st;
+		if (!c->img_fire_scheduled) {
+			c->img_fire_scheduled = true;
+			guit->misc->schedule(0, img_fire_cb, c);
+		}
+		return;
+	}
+	o->img_settle = 0;
+	if (!img_is_img(node))
+		return;
+	s = img_find(c, node);
+	if (s != NULL && s->fired && s->state == st && s->url != NULL &&
+	    nsurl_compare(s->url, o->url, NSURL_COMPLETE))
+		return;		/* re-adopted after a rebuild, or loaded detached */
+	if (s == NULL && (s = img_get(c, node)) == NULL)
+		return;
+	img_retire(c, &s->h);	/* a detached fetch this one overtakes */
+	img_set_url(s, o->url);
+	s->state = st;
+	s->w = s->ht = 0;
+	if (ok && o->content != NULL) {
+		s->w = content_get_width(o->content);
+		s->ht = content_get_height(o->content);
+	}
+	img_queue(s);
+}
+
+static nserror img_detached_cb(hlcache_handle *handle,
+		const hlcache_event *event, void *pw)
+{
+	struct html_img_state *s = pw;
+
+	if (handle != s->h)
+		return NSERROR_OK;	/* superseded; released later */
+	switch (event->type) {
+	case CONTENT_MSG_DONE:
+		s->state = 1;
+		s->w = content_get_width(handle);
+		s->ht = content_get_height(handle);
+		break;
+	case CONTENT_MSG_ERROR:
+		s->state = 2;
+		break;
+	default:
+		return NSERROR_OK;
+	}
+	/* the bitmap is not kept: the cache holds the data for the <img>
+	 * that usually follows a preload (released from img_fire_cb, not
+	 * inside this callback) */
+	img_retire(s->c, &s->h);
+	img_queue(s);
+	return NSERROR_OK;
+}
+
+/* exported interface documented in html/html.h */
+bool html_image_fetch_detached(struct content *cc, dom_node *node,
+		const char *src)
+{
+	html_content *c = (html_content *) cc;
+	struct html_img_state *s, *t;
+	nsurl *url = NULL;
+	int inflight = 0;
+
+	if (c == NULL || node == NULL || src == NULL || *src == '\0' ||
+	    c->base_url == NULL)
+		return false;
+	if (nsurl_join(c->base_url, src, &url) != NSERROR_OK)
+		return false;
+	s = img_find(c, node);
+	if (s != NULL && s->url != NULL &&
+	    nsurl_compare(s->url, url, NSURL_COMPLETE)) {
+		/* the same image again: browsers fire its event again */
+		if (s->h == NULL && s->state != 0)
+			img_queue(s);
+		nsurl_unref(url);
+		return true;
+	}
+	for (t = c->img_states; t != NULL; t = t->next)
+		if (t->h != NULL)
+			inflight++;
+	if (inflight >= IMG_DETACHED_MAX) {
+		nsurl_unref(url);
+		return false;
+	}
+	if (s == NULL && (s = img_get(c, node)) == NULL) {
+		nsurl_unref(url);
+		return false;
+	}
+	img_retire(c, &s->h);
+	img_set_url(s, url);
+	s->state = 0;
+	s->w = s->ht = 0;
+	s->fired = false;
+	if (hlcache_handle_retrieve(url, HLCACHE_RETRIEVE_SNIFF_TYPE,
+			content_get_url(&c->base), NULL, img_detached_cb, s,
+			NULL, CONTENT_IMAGE, &s->h) != NSERROR_OK) {
+		s->h = NULL;
+		s->state = 2;
+		img_queue(s);
+	}
+	nsurl_unref(url);
+	return true;
+}
+
+/* exported interface documented in html/html.h */
+bool html_image_state(struct content *cc, dom_node *node, const char *src,
+		int *state, int *width, int *height)
+{
+	html_content *c = (html_content *) cc;
+	struct html_img_state *s;
+
+	if (c == NULL || node == NULL || (s = img_find(c, node)) == NULL)
+		return false;
+	*state = s->state;
+	*width = s->w;
+	*height = s->ht;
+	if (src != NULL && *src != '\0' && s->url != NULL &&
+	    c->base_url != NULL) {
+		nsurl *u = NULL;
+		if (nsurl_join(c->base_url, src, &u) == NSERROR_OK) {
+			if (!nsurl_compare(u, s->url, NSURL_COMPLETE)) {
+				*state = 0;	/* a newer src is loading */
+				*width = *height = 0;
+			}
+			nsurl_unref(u);
+		}
+	}
+	return true;
+}
+
+/* exported interface documented in html/html.h */
+void html_image_flush_events(html_content *c)
+{
+	if (c->img_fire_scheduled) {
+		guit->misc->schedule(-1, img_fire_cb, c);
+		c->img_fire_scheduled = false;
+		img_fire_cb(c);
+	}
+}
+
+/* exported interface documented in html/html.h */
+void html_image_states_free(html_content *c)
+{
+	guit->misc->schedule(-1, img_fire_cb, c);
+	c->img_fire_scheduled = false;
+	img_release_stale(c);
+	while (c->img_states != NULL) {
+		struct html_img_state *s = c->img_states;
+		c->img_states = s->next;
+		safe_hlcache_handle_release(&s->h);
+		if (s->url != NULL)
+			nsurl_unref(s->url);
+		dom_node_unref(s->node);
+		free(s);
+	}
+}
