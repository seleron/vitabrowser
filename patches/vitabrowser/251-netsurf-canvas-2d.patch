+		int stride, int x, int y, int w, int h);
+
+/** VitaBrowser patch 251: canvas text in the frontend's faces. Sets `len`
+ * bytes of UTF-8 at `px` pixels (family 0 sans-serif, 1 serif, 2
+ * monospace) with the baseline origin at (x, y), handing each glyph's ink
+ * to fn (NULL: measure only).
+ * \return the advance in pixels */
+int macsurf_canvas_glyphs(int px, int family, int bold, int italic,
+		const char *utf8, size_t len, int x, int y, macsurf_glyph_fn fn,
+		void *pw);
+
+/** VitaBrowser patch 251: the face's ascent and descent at `px` pixels. */
+void macsurf_canvas_font_extents(int px, int family, int bold, int italic,
+		int *ascent, int *descent);
+
 #endif
diff --git a/content/handlers/javascript/quickjs/macsurf_canvas.c b/content/handlers/javascript/quickjs/macsurf_canvas.c
new file mode 100644
--- /dev/null
+++ b/content/handlers/javascript/quickjs/macsurf_canvas.c
@@ -0,0 +1,1972 @@
+/*
+ * VitaBrowser patch 251: the canvas 2D raster (see macsurf_canvas.h).
+ *
+ * Every <canvas> drawing call was a no-op (fixes1245): charts, games, maps,
+ * QR codes and the image grid of a captcha were blank, and a script reading
+ * its own drawing back (getImageData, toDataURL) got zeros. This is the
+ * pixel side of a real 2D context:
+ *
+ *  - each context keeps premultiplied RGBA pixels in ordinary memory; the
+ *    changed rectangle is copied, unpremultiplied, into the element's bitmap
+ *    (texture memory on the Vita, slow to read back) from a scheduled
+ *    callback, once per batch of drawing, and the element's box redrawn;
+ *  - shapes arrive flattened to polygons in device pixels; the rasteriser
+ *    samples 4 sub-scanlines per row with exact horizontal coverage, by the
+ *    nonzero or even-odd rule;
+ *  - a stroke is the union of convex pieces (a quad per segment, a wedge,
+ *    miter or disc per join, caps), each oriented the same way so the
+ *    nonzero rule merges them: overlaps never cancel or double;
+ *  - paints: a colour, linear / radial / conic gradients (a 256-entry
+ *    table), and images (drawImage and patterns) sampled through the
+ *    inverse transform, nearest or bilinear;
+ *  - the Porter-Duff operators plus lighter, multiply, screen, darken and
+ *    lighten; the clip is a coverage mask, saved and restored with the
+ *    state;
+ *  - text comes from the frontend's own faces (macsurf_canvas_glyphs), so
+ *    it measures as it draws;
+ *  - toDataURL encodes a PNG (stored deflate: no compressor needed).
+ *
+ * Not done: shadows, filters, rotated text (glyphs stay upright; their
+ * origin and size follow the transform), text along a scaled-x transform.
+ */
+
+#ifdef WITH_QUICKJS
+
+#include <stdlib.h>
+#include <string.h>
+#include <math.h>
+
+#include <dom/dom.h>
+
+#include "utils/errors.h"
+#include "utils/corestrings.h"
+#include "netsurf/bitmap.h"
+#include "desktop/gui_internal.h"
+#include "desktop/gui_table.h"
+#include "content/handlers/html/private.h"
+
+#include "macos9.h"
+#include "macsurf_canvas.h"
+
+/** Sub-scanlines per pixel row. */
+#define CV_SS 4
+/** The largest canvas that gets pixels (a bigger one draws nothing). */
+#define CV_MAX_DIM 4096
+#define CV_MAX_AREA (2048 * 1024)
+/** Clip masks remembered by save(); deeper saves keep the current clip. */
+#define CV_STACK 32
+
+enum cv_op {
+	OP_SOURCE_OVER, OP_SOURCE_IN, OP_SOURCE_OUT, OP_SOURCE_ATOP,
+	OP_DEST_OVER, OP_DEST_IN, OP_DEST_OUT, OP_DEST_ATOP,
+	OP_LIGHTER, OP_COPY, OP_XOR, OP_MULTIPLY, OP_SCREEN, OP_DARKEN,
+	OP_LIGHTEN, OP_COUNT
+};
+
+struct cv {
+	struct dom_node *node;	/**< ref'd; NULL once released */
+	int w, h;
+	uint8_t *px;		/**< premultiplied RGBA, or NULL */
+	uint8_t *clip;		/**< coverage mask w*h, NULL = no clip */
+	bool clip_owned;
+	struct { uint8_t *clip; bool owned; } stack[CV_STACK];
+	int depth, overflow;
+	int dx0, dy0, dx1, dy1;	/**< changed since the last flush */
+	bool scheduled;
+};
+
+struct paint {
+	int type;		/**< 0 colour, 1 linear, 2 radial, 3 conic, 4 image */
+	uint8_t rgba[4];	/**< colour, premultiplied */
+	double inv[6];		/**< device -> paint space */
+	double g[6];		/**< gradient geometry */
+	uint32_t lut[256];	/**< gradient colours, premultiplied RGBA bytes */
+	const uint8_t *img;	/**< image: premultiplied pixels */
+	uint8_t *img_owned;
+	int iw, ih;		/**< its size */
+	double ix, iy;		/**< paint-space position of img's pixel 0,0 */
+	bool rep_x, rep_y, smooth;
+	bool none;		/**< paints nothing (a degenerate gradient) */
+};
+
+struct drawop {
+	struct cv *cv;
+	struct paint *paint;
+	int ga;			/**< globalAlpha, 0..255 */
+	int op;
+	uint8_t *row;		/**< paint colours for one row */
+};
+
+static JSClassID s_cv_class_id;
+static const struct macsurf_canvas_ops *s_ops;
+
+#define DIV255(x) ((((x) + 128) * 257) >> 16)
+/** Coordinates beyond this are pulled in: far outside any canvas, and
+ * float / int conversions stay defined. */
+#define CV_FAR 1e7
+
+/** A script's number as an int: NaN is 0, the rest clamped (a cast of an
+ * out-of-range double is undefined behaviour). */
+static int dtoi(double d)
+{
+	if (!(d == d))
+		return 0;
+	if (d > 1e9) return 1000000000;
+	if (d < -1e9) return -1000000000;
+	return (int)d;
+}
+
+static double clampd(double v, double lo, double hi)
+{
+	return v < lo ? lo : (v > hi ? hi : v);
+}
+
+/* ---- pixels ----------------------------------------------------------- */
+
+static void cv_free_clips(struct cv *cv)
+{
+	int i;
+	if (cv->clip_owned)
+		free(cv->clip);
+	for (i = 0; i < cv->depth; i++)
+		if (cv->stack[i].owned)
+			free(cv->stack[i].clip);
+	cv->clip = NULL;
+	cv->clip_owned = false;
+	cv->depth = cv->overflow = 0;
+}
+
+static void cv_dirty(struct cv *cv, int x0, int y0, int x1, int y1)
+{
+	if (x0 < 0) x0 = 0;
+	if (y0 < 0) y0 = 0;
+	if (x1 > cv->w) x1 = cv->w;
+	if (y1 > cv->h) y1 = cv->h;
+	if (x1 <= x0 || y1 <= y0)
+		return;
+	if (cv->dx1 <= cv->dx0 || cv->dy1 <= cv->dy0) {
+		cv->dx0 = x0; cv->dy0 = y0; cv->dx1 = x1; cv->dy1 = y1;
+	} else {
+		if (x0 < cv->dx0) cv->dx0 = x0;
+		if (y0 < cv->dy0) cv->dy0 = y0;
+		if (x1 > cv->dx1) cv->dx1 = x1;
+		if (y1 > cv->dy1) cv->dy1 = y1;
+	}
+}
+
+static void cv_redraw_node(struct dom_node *node)
+{
+	struct box *box = NULL;
+	html_content *htmlc = NULL;
+	dom_document *doc = NULL;
+
+	if (dom_node_get_user_data(node, corestring_dom___ns_key_box_node_data,
+			(void **)&box) != DOM_NO_ERR || box == NULL)
+		return;
+	if (dom_node_get_owner_document(node, &doc) != DOM_NO_ERR ||
+	    doc == NULL)
+		return;
+	if (dom_node_get_user_data(doc,
+			corestring_dom___ns_key_html_content_data,
+			(void **)&htmlc) == DOM_NO_ERR && htmlc != NULL)
+		html__redraw_a_box(htmlc, box);
+	dom_node_unref(doc);
+}
+
+/* The element's bitmap: destroyed with the element, copied with it. */
+static void cv_bitmap_handler(dom_node_operation operation, dom_string *key,
+		void *data, struct dom_node *src, struct dom_node *dst)
+{
+	struct bitmap *bm = data, *nb, *old = NULL;
+	int w, h;
+	size_t stride;
+
+	(void)src;
+	if (data == NULL || !dom_string_isequal(key,
+			corestring_dom___ns_key_canvas_node_data))
+		return;
+	switch (operation) {
+	case DOM_NODE_CLONED:
+		w = guit->bitmap->get_width(bm);
+		h = guit->bitmap->get_height(bm);
+		stride = guit->bitmap->get_rowstride(bm);
+		nb = guit->bitmap->create(w, h, BITMAP_NONE);
+		if (nb == NULL)
+			break;
+		if (guit->bitmap->get_rowstride(nb) == stride)
+			memcpy(guit->bitmap->get_buffer(nb),
+			       guit->bitmap->get_buffer(bm), stride * h);
+		guit->bitmap->modified(nb);
+		if (dom_node_set_user_data(dst,
+				corestring_dom___ns_key_canvas_node_data, nb,
+				cv_bitmap_handler, (void **)&old) == DOM_NO_ERR) {
+			if (old != NULL)
+				guit->bitmap->destroy(old);
+		} else {
+			guit->bitmap->destroy(nb);
+		}
+		break;
+	case DOM_NODE_DELETED:
+		guit->bitmap->destroy(bm);
+		break;
+	default:
+		break;
+	}
+}
+
+static void cv_set_bitmap(struct dom_node *node, struct bitmap *bm)
+{
+	struct bitmap *old = NULL;
+	if (dom_node_set_user_data(node,
+			corestring_dom___ns_key_canvas_node_data, bm,
+			bm != NULL ? cv_bitmap_handler : NULL,
+			(void **)&old) != DOM_NO_ERR) {
+		if (bm != NULL)
+			guit->bitmap->destroy(bm);
+		return;
+	}
+	if (old != NULL && old != bm)
+		guit->bitmap->destroy(old);
+}
+
+/* Copy the changed rectangle into the element's bitmap and redraw it. */
+static void cv_flush(void *p)
+{
+	struct cv *cv = p;
+	struct bitmap *bm = NULL;
+	uint8_t *buf;
+	size_t stride;
+	int x, y;
+
+	cv->scheduled = false;
+	if (cv->node == NULL)
+		return;
+	if (cv->px == NULL) {
+		dom_node_get_user_data(cv->node,
+				corestring_dom___ns_key_canvas_node_data,
+				(void **)&bm);
+		if (bm != NULL) {
+			cv_set_bitmap(cv->node, NULL);
+			cv_redraw_node(cv->node);
+		}
+		cv->dx0 = cv->dx1 = 0;
+		return;
+	}
+	if (cv->dx1 <= cv->dx0 || cv->dy1 <= cv->dy0)
+		return;
+	if (dom_node_get_user_data(cv->node,
+			corestring_dom___ns_key_canvas_node_data,
+			(void **)&bm) != DOM_NO_ERR)
+		bm = NULL;
+	if (bm == NULL || guit->bitmap->get_width(bm) != cv->w ||
+	    guit->bitmap->get_height(bm) != cv->h) {
+		bm = guit->bitmap->create(cv->w, cv->h, BITMAP_NONE);
+		if (bm == NULL)
+			return;
+		memset(guit->bitmap->get_buffer(bm), 0,
+		       guit->bitmap->get_rowstride(bm) * (size_t)cv->h);
+		cv_set_bitmap(cv->node, bm);
+		cv->dx0 = 0; cv->dy0 = 0; cv->dx1 = cv->w; cv->dy1 = cv->h;
+	}
+	buf = guit->bitmap->get_buffer(bm);
+	stride = guit->bitmap->get_rowstride(bm);
+	if (buf == NULL)
+		return;
+	for (y = cv->dy0; y < cv->dy1; y++) {
+		const uint8_t *s = cv->px + ((size_t)y * cv->w + cv->dx0) * 4;
+		uint8_t *d = buf + (size_t)y * stride + (size_t)cv->dx0 * 4;
+		for (x = cv->dx0; x < cv->dx1; x++, s += 4, d += 4) {
+			unsigned a = s[3];
+			if (a == 255 || a == 0) {
+				d[0] = s[0]; d[1] = s[1]; d[2] = s[2];
+			} else {
+				d[0] = (uint8_t)((s[0] * 255 + a / 2) / a);
+				d[1] = (uint8_t)((s[1] * 255 + a / 2) / a);
+				d[2] = (uint8_t)((s[2] * 255 + a / 2) / a);
+			}
+			d[3] = (uint8_t)a;
+		}
+	}
+	guit->bitmap->modified(bm);
+	cv->dx0 = cv->dy0 = cv->dx1 = cv->dy1 = 0;
+	cv_redraw_node(cv->node);
+}
+
+static void cv_changed(struct cv *cv)
+{
+	if (!cv->scheduled && cv->node != NULL) {
+		cv->scheduled = true;
+		macos9_schedule(0, cv_flush, cv);
+	}
+}
+
+static void cv_resize(struct cv *cv, int w, int h)
+{
+	size_t n;
+
+	cv_free_clips(cv);
+	free(cv->px);
+	cv->px = NULL;
+	if (w < 0) w = 0;
+	if (h < 0) h = 0;
+	cv->w = w;
+	cv->h = h;
+	if (w > 0 && h > 0 && w <= CV_MAX_DIM && h <= CV_MAX_DIM &&
+	    (long)w * h <= CV_MAX_AREA) {
+		n = (size_t)w * h * 4;
+		cv->px = macsurf_try_alloc(n);
+		if (cv->px != NULL)
+			memset(cv->px, 0, n);
+	}
+	cv->dx0 = 0; cv->dy0 = 0; cv->dx1 = cv->w; cv->dy1 = cv->h;
+	cv_changed(cv);
+}
+
+/* ---- the rasteriser ---------------------------------------------------- */
+
+struct edge {
+	float x0, y0, y1, dxdy;
+	int dir;
+};
+
+struct cross {
+	float x;
+	int dir;
+};
+
+typedef void (*span_fn)(void *pw, int y, int x0, int x1, const uint8_t *cov);
+
+static int edge_cmp(const void *a, const void *b)
+{
+	const struct edge *ea = a, *eb = b;
+	return (ea->y0 < eb->y0) ? -1 : (ea->y0 > eb->y0) ? 1 : 0;
+}
+
+static void acc_span(float *acc, int width, float xa, float xb, float w)
+{
+	int ia, ib, i;
+	if (xa < 0) xa = 0;
+	if (xb > (float)width) xb = (float)width;
+	if (!(xb > xa))		/* NaN too */
+		return;
+	ia = (int)xa;
+	ib = (int)xb;
+	if (ia == ib) {
+		acc[ia] += (xb - xa) * w;
+		return;
+	}
+	acc[ia] += ((float)(ia + 1) - xa) * w;
+	for (i = ia + 1; i < ib; i++)
+		acc[i] += w;
+	if (ib < width)
+		acc[ib] += (xb - (float)ib) * w;
+}
+
+/**
+ * Rasterise polygons (each subpath implicitly closed) inside the box
+ * [bx0,bx1) x [by0,by1) and hand each row's coverage to fn. With `full`,
+ * every row and column of the box is handed over, covered or not (the
+ * operators that clear what the shape does not cover).
+ */
+static bool raster(const double *pts, const int *counts, int nsub,
+		bool evenodd, int bx0, int by0, int bx1, int by1, bool full,
+		span_fn fn, void *pw)
+{
+	struct edge *e = NULL;
+	struct cross *cr = NULL;
+	int *act = NULL;
+	float *acc = NULL;
+	uint8_t *cov = NULL;
+	int ne = 0, cap = 0, i, k, s, off = 0, y, ry0, ry1, width, nact, next;
+	double minx = 1e30, maxx = -1e30, miny = 1e30, maxy = -1e30;
+	bool ok = false;
+
+	for (s = 0; s < nsub; s++) {
+		int n = counts[s];
+		const double *p = pts + 2 * off;
+		bool finite = true;
+		for (i = 0; i < n; i++)
+			if (!isfinite(p[2 * i]) || !isfinite(p[2 * i + 1]))
+				finite = false;
+		if (finite && n >= 2) {
+			for (i = 0; i < n; i++) {
+				double xa = clampd(p[2 * i], -CV_FAR, CV_FAR);
+				double ya = clampd(p[2 * i + 1], -CV_FAR, CV_FAR);
+				double xb = clampd(p[2 * ((i + 1) % n)], -CV_FAR, CV_FAR);
+				double yb = clampd(p[2 * ((i + 1) % n) + 1], -CV_FAR,
+						CV_FAR);
+				if (ya == yb)
+					continue;
+				if (ne == cap) {
+					struct edge *ne2;
+					cap = cap ? cap * 2 : 64;
+					ne2 = realloc(e, sizeof(*e) * cap);
+					if (ne2 == NULL)
+						goto out;
+					e = ne2;
+				}
+				if (ya < yb) {
+					e[ne].x0 = (float)xa; e[ne].y0 = (float)ya;
+					e[ne].y1 = (float)yb; e[ne].dir = 1;
+				} else {
+					e[ne].x0 = (float)xb; e[ne].y0 = (float)yb;
+					e[ne].y1 = (float)ya; e[ne].dir = -1;
+				}
+				e[ne].dxdy = (float)((xb - xa) / (yb - ya));
+				ne++;
+				if (xa < minx) minx = xa;
+				if (xa > maxx) maxx = xa;
+				if (ya < miny) miny = ya;
+				if (ya > maxy) maxy = ya;
+			}
+		}
+		off += n;
+	}
+	if (!full) {
+		if (ne == 0) {
+			ok = true;
+			goto out;
+		}
+		/* (all within +-CV_FAR: the conversions are defined) */
+		if (floor(minx) > bx0) bx0 = (int)floor(minx);
+		if (ceil(maxx) < bx1) bx1 = (int)ceil(maxx);
+		if (floor(miny) > by0) by0 = (int)floor(miny);
+		if (ceil(maxy) < by1) by1 = (int)ceil(maxy);
+	}
+	if (bx1 <= bx0 || by1 <= by0) {
+		ok = true;
+		goto out;
+	}
+	width = bx1 - bx0;
+	ry0 = by0;
+	ry1 = by1;
+	if (ne > 0)
+		qsort(e, (size_t)ne, sizeof(*e), edge_cmp);
+	cr = malloc(sizeof(*cr) * (ne + 1));
+	act = malloc(sizeof(*act) * (ne + 1));
+	acc = malloc(sizeof(*acc) * (width + 2));
+	cov = malloc((size_t)width + 1);
+	if (cr == NULL || act == NULL || acc == NULL || cov == NULL)
+		goto out;
+	nact = 0;
+	next = 0;
+	for (y = ry0; y < ry1; y++) {
+		int lo = width, hi = -1;
+		memset(acc, 0, sizeof(*acc) * (width + 2));
+		for (s = 0; s < CV_SS; s++) {
+			float sy = (float)y + ((float)s + 0.5f) / CV_SS;
+			int nc = 0, j, wind;
+			float start;
+			while (next < ne && e[next].y0 <= sy)
+				act[nact++] = next++;
+			for (j = 0, k = 0; j < nact; j++)
+				if (e[act[j]].y1 > sy)
+					act[k++] = act[j];
+			nact = k;
+			for (j = 0; j < nact; j++) {
+				const struct edge *ed = &e[act[j]];
+				struct cross c;
+				int m;
+				c.x = ed->x0 + (sy - ed->y0) * ed->dxdy -
+					(float)bx0;
+				c.dir = ed->dir;
+				/* insertion sort by x */
+				for (m = nc; m > 0 && cr[m - 1].x > c.x; m--)
+					cr[m] = cr[m - 1];
+				cr[m] = c;
+				nc++;
+			}
+			wind = 0;
+			start = 0;
+			for (j = 0; j < nc; j++) {
+				int before = wind;
+				bool in0, in1;
+				wind += cr[j].dir;
+				in0 = evenodd ? (before & 1) : before != 0;
+				in1 = evenodd ? (wind & 1) : wind != 0;
+				if (!in0 && in1)
+					start = cr[j].x;
+				else if (in0 && !in1)
+					acc_span(acc, width, start, cr[j].x,
+						 1.0f / CV_SS);
+			}
+		}
+		for (i = 0; i < width; i++) {
+			float a = acc[i];
+			int c = a >= 1.0f ? 255 : (a <= 0.0f ? 0 :
+					(int)(a * 255.0f + 0.5f));
+			cov[i] = (uint8_t)c;
+			if (c != 0) {
+				if (i < lo) lo = i;
+				hi = i;
+			}
+		}
+		if (full)
+			fn(pw, y, bx0, bx1, cov);
+		else if (hi >= lo)
+			fn(pw, y, bx0 + lo, bx0 + hi + 1, cov + lo);
+	}
+	ok = true;
+out:
+	free(e);
+	free(cr);
+	free(act);
+	free(acc);
+	free(cov);
+	return ok;
+}
+
+/* ---- paints ------------------------------------------------------------ */
+
+static void paint_free(struct paint *p)
+{
+	free(p->img_owned);
+	p->img_owned = NULL;
+}
+
+static inline uint32_t pack(unsigned r, unsigned g, unsigned b, unsigned a)
+{
+	uint8_t q[4];
+	uint32_t v;
+	q[0] = (uint8_t)r; q[1] = (uint8_t)g; q[2] = (uint8_t)b; q[3] = (uint8_t)a;
+	memcpy(&v, q, 4);
+	return v;
+}
+
+/** stops: offset, r, g, b, a (0..255, alpha 0..1), sorted by offset. */
+static void build_lut(struct paint *p, const double *st, int n)
+{
+	int i, k = 0;
+
+	if (n <= 0) {
+		p->none = true;
+		return;
+	}
+	for (i = 0; i < 256; i++) {
+		double t = i / 255.0, f, r, g, b, a;
+		while (k + 1 < n && st[5 * (k + 1)] <= t)
+			k++;
+		if (t <= st[0] || n == 1) {
+			r = st[1]; g = st[2]; b = st[3]; a = st[4];
+		} else if (k + 1 >= n) {
+			r = st[5 * k + 1]; g = st[5 * k + 2];
+			b = st[5 * k + 3]; a = st[5 * k + 4];
+		} else {
+			double o0 = st[5 * k], o1 = st[5 * (k + 1)];
+			f = o1 > o0 ? (t - o0) / (o1 - o0) : 1.0;
+			r = st[5 * k + 1] + (st[5 * k + 6] - st[5 * k + 1]) * f;
+			g = st[5 * k + 2] + (st[5 * k + 7] - st[5 * k + 2]) * f;
+			b = st[5 * k + 3] + (st[5 * k + 8] - st[5 * k + 3]) * f;
+			a = st[5 * k + 4] + (st[5 * k + 9] - st[5 * k + 4]) * f;
+		}
+		a = a < 0 ? 0 : (a > 1 ? 1 : a);
+		p->lut[i] = pack((unsigned)(r * a + 0.5), (unsigned)(g * a + 0.5),
+				 (unsigned)(b * a + 0.5), (unsigned)(a * 255 + 0.5));
+	}
+}
+
+static inline uint32_t lut_at(const struct paint *p, double t)
+{
+	int i;
+	if (!(t > 0)) t = 0;	/* NaN too */
+	if (t > 1) t = 1;
+	i = (int)(t * 255.0 + 0.5);
+	return p->lut[i];
+}
+
+static inline uint32_t img_px(const struct paint *p, int x, int y)
+{
+	uint32_t v;
+	if (p->rep_x) {
+		x %= p->iw;
+		if (x < 0) x += p->iw;
+	} else if (x < 0 || x >= p->iw) {
+		return 0;
+	}
+	if (p->rep_y) {
+		y %= p->ih;
+		if (y < 0) y += p->ih;
+	} else if (y < 0 || y >= p->ih) {
+		return 0;
+	}
+	memcpy(&v, p->img + ((size_t)y * p->iw + x) * 4, 4);
+	return v;
+}
+
+static inline int clampi(int v, int lo, int hi)
+{
+	return v < lo ? lo : (v > hi ? hi : v);
+}
+
+static uint32_t img_sample(const struct paint *p, double u, double v)
+{
+	if (p->rep_x && u == u)
+		u = fmod(u, (double)p->iw);
+	if (p->rep_y && v == v)
+		v = fmod(v, (double)p->ih);
+	if (!(u > -CV_FAR && u < CV_FAR && v > -CV_FAR && v < CV_FAR))
+		return 0;
+	if (!p->smooth) {
+		return img_px(p, (int)floor(u), (int)floor(v));
+	} else {
+		double fu = u - 0.5, fv = v - 0.5;
+		int x0 = (int)floor(fu), y0 = (int)floor(fv);
+		int ax = (int)((fu - x0) * 256.0), ay = (int)((fv - y0) * 256.0);
+		int x1 = x0 + 1, y1 = y0 + 1, c;
+		uint32_t q[4];
+		uint8_t out[4], *b[4];
+		uint32_t res;
+		/* clamp to the edge inside the image (drawImage's source
+		 * rectangle), so the border does not fade to transparent */
+		if (!p->rep_x) {
+			if (u < 0 || u > p->iw) return 0;
+			x0 = clampi(x0, 0, p->iw - 1);
+			x1 = clampi(x1, 0, p->iw - 1);
+		}
+		if (!p->rep_y) {
+			if (v < 0 || v > p->ih) return 0;
+			y0 = clampi(y0, 0, p->ih - 1);
+			y1 = clampi(y1, 0, p->ih - 1);
+		}
+		q[0] = img_px(p, x0, y0); q[1] = img_px(p, x1, y0);
+		q[2] = img_px(p, x0, y1); q[3] = img_px(p, x1, y1);
+		for (c = 0; c < 4; c++)
+			b[c] = (uint8_t *)&q[c];
+		for (c = 0; c < 4; c++) {
+			int top = b[0][c] * (256 - ax) + b[1][c] * ax;
+			int bot = b[2][c] * (256 - ax) + b[3][c] * ax;
+			out[c] = (uint8_t)((top * (256 - ay) + bot * ay + 32768) >> 16);
+		}
+		memcpy(&res, out, 4);
+		return res;
+	}
+}
+
+/** Paint colours for pixels x0 .. x0+n-1 of row y. */
+static void paint_row(const struct paint *p, int y, int x0, int n,
+		uint8_t *out)
+{
+	const double *m = p->inv;
+	double cx = x0 + 0.5, cy = y + 0.5;
+	double u = m[0] * cx + m[2] * cy + m[4];
+	double v = m[1] * cx + m[3] * cy + m[5];
+	int i;
+	uint32_t c;
+
+	for (i = 0; i < n; i++, u += m[0], v += m[1]) {
+		switch (p->type) {
+		case 1: {	/* linear: g = x0 y0 dx dy 1/len^2 */
+			double t = ((u - p->g[0]) * p->g[2] +
+				    (v - p->g[1]) * p->g[3]) * p->g[4];
+			c = lut_at(p, t);
+			break;
+		}
+		case 2: {	/* radial: g = x0 y0 r0 x1 y1 r1 */
+			double cdx = p->g[3] - p->g[0], cdy = p->g[4] - p->g[1];
+			double dr = p->g[5] - p->g[2];
+			double pdx = u - p->g[0], pdy = v - p->g[1];
+			double a = cdx * cdx + cdy * cdy - dr * dr;
+			double b = pdx * cdx + pdy * cdy + p->g[2] * dr;
+			double cc = pdx * pdx + pdy * pdy - p->g[2] * p->g[2];
+			double t = -1;
+			bool have = false;
+			if (fabs(a) < 1e-9) {
+				if (fabs(b) > 1e-12) {
+					t = cc / (2 * b);
+					have = p->g[2] + t * dr >= 0;
+				}
+			} else {
+				double disc = b * b - a * cc;
+				if (disc >= 0) {
+					double sq = sqrt(disc);
+					double t1 = (b + sq) / a, t2 = (b - sq) / a;
+					double hi = t1 > t2 ? t1 : t2;
+					double lo = t1 > t2 ? t2 : t1;
+					if (p->g[2] + hi * dr >= 0) {
+						t = hi; have = true;
+					} else if (p->g[2] + lo * dr >= 0) {
+						t = lo; have = true;
+					}
+				}
+			}
+			c = have ? lut_at(p, t) : 0;
+			break;
+		}
+		case 3: {	/* conic: g = start angle, cx, cy */
+			double ang = atan2(v - p->g[2], u - p->g[1]) - p->g[0];
+			double t = ang / (2 * M_PI);
+			t -= floor(t);
+			c = lut_at(p, t);
+			break;
+		}
+		case 4:
+			c = img_sample(p, u - p->ix, v - p->iy);
+			break;
+		default:
+			memcpy(&c, p->rgba, 4);
+			break;
+		}
+		memcpy(out + 4 * i, &c, 4);
+	}
+}
+
+/* ---- compositing -------------------------------------------------------- */
+
+static bool op_unbounded(int op)
+{
+	return op == OP_SOURCE_IN || op == OP_SOURCE_OUT || op == OP_DEST_IN ||
+	       op == OP_DEST_ATOP || op == OP_COPY;
+}
+
+static inline void blend(int op, const uint8_t *s, uint8_t *d)
+{
+	int sa = s[3], da = d[3], c, r[4];
+	switch (op) {
+	case OP_SOURCE_IN:
+		for (c = 0; c < 4; c++) r[c] = DIV255(s[c] * da);
+		break;
+	case OP_SOURCE_OUT:
+		for (c = 0; c < 4; c++) r[c] = DIV255(s[c] * (255 - da));
+		break;
+	case OP_SOURCE_ATOP:
+		for (c = 0; c < 4; c++)
+			r[c] = DIV255(s[c] * da + d[c] * (255 - sa));
+		break;
+	case OP_DEST_OVER:
+		for (c = 0; c < 4; c++) r[c] = d[c] + DIV255(s[c] * (255 - da));
+		break;
+	case OP_DEST_IN:
+		for (c = 0; c < 4; c++) r[c] = DIV255(d[c] * sa);
+		break;
+	case OP_DEST_OUT:
+		for (c = 0; c < 4; c++) r[c] = DIV255(d[c] * (255 - sa));
+		break;
+	case OP_DEST_ATOP:
+		for (c = 0; c < 4; c++)
+			r[c] = DIV255(d[c] * sa + s[c] * (255 - da));
+		break;
+	case OP_LIGHTER:
+		for (c = 0; c < 4; c++) {
+			r[c] = s[c] + d[c];
+			if (r[c] > 255) r[c] = 255;
+		}
+		break;
+	case OP_COPY:
+		for (c = 0; c < 4; c++) r[c] = s[c];
+		break;
+	case OP_XOR:
+		for (c = 0; c < 4; c++)
+			r[c] = DIV255(s[c] * (255 - da) + d[c] * (255 - sa));
+		break;
+	case OP_MULTIPLY:
+	case OP_SCREEN:
+	case OP_DARKEN:
+	case OP_LIGHTEN:
+		for (c = 0; c < 3; c++) {
+			/* separable blends, premultiplied: s(1-da) + d(1-sa) +
+			 * sa.da.B(s/sa, d/da) */
+			int base = DIV255(s[c] * (255 - da) + d[c] * (255 - sa));
+			int x, sd = s[c] * da, ds = d[c] * sa;
+			if (op == OP_MULTIPLY)
+				x = DIV255(s[c] * d[c]);
+			else if (op == OP_SCREEN)
+				x = DIV255(sd + ds - s[c] * d[c]);
+			else if (op == OP_DARKEN)
+				x = DIV255(sd < ds ? sd : ds);
+			else
+				x = DIV255(sd > ds ? sd : ds);
+			r[c] = base + x;
+		}
+		r[3] = sa + da - DIV255(sa * da);
+		break;
+	default:	/* source-over */
+		for (c = 0; c < 4; c++) r[c] = s[c] + DIV255(d[c] * (255 - sa));
+		break;
+	}
+	for (c = 0; c < 4; c++)
+		d[c] = (uint8_t)(r[c] > 255 ? 255 : r[c]);
+}
+
+/** Composite one row: cov (NULL = full) for pixels x0 .. x1-1. */
+static void comp_row(void *pw, int y, int x0, int x1, const uint8_t *cov)
+{
+	struct drawop *dop = pw;
+	struct cv *cv = dop->cv;
+	struct paint *p = dop->paint;
+	uint8_t *d;
+	const uint8_t *clip;
+	bool unb = op_unbounded(dop->op);
+	int i, n;
+	const uint8_t *col;
+
+	if (y < 0 || y >= cv->h || x1 <= 0 || x0 >= cv->w)
+		return;
+	if (x0 < 0) {
+		if (cov != NULL) cov += -x0;
+		x0 = 0;
+	}
+	if (x1 > cv->w) x1 = cv->w;
+	n = x1 - x0;
+	if (n <= 0)
+		return;
+	d = cv->px + ((size_t)y * cv->w + x0) * 4;
+	clip = cv->clip != NULL ? cv->clip + (size_t)y * cv->w + x0 : NULL;
+	if (p->type == 0) {
+		col = NULL;
+	} else {
+		paint_row(p, y, x0, n, dop->row);
+		col = dop->row;
+	}
+	for (i = 0; i < n; i++, d += 4) {
+		int c = cov != NULL ? cov[i] : 255;
+		int k = clip != NULL ? clip[i] : 255, f, j;
+		uint8_t s[4], old[4];
+		const uint8_t *src = col != NULL ? col + 4 * i : p->rgba;
+		if (k == 0 || (c == 0 && !unb))
+			continue;
+		f = DIV255(c * dop->ga);
+		if (f == 255) {
+			memcpy(s, src, 4);
+		} else {
+			for (j = 0; j < 4; j++)
+				s[j] = (uint8_t)DIV255(src[j] * f);
+		}
+		if (dop->op == OP_SOURCE_OVER && k == 255) {
+			int ia = 255 - s[3];
+			if (ia == 0) {
+				memcpy(d, s, 4);
+			} else if (s[3] != 0) {
+				for (j = 0; j < 4; j++)
+					d[j] = (uint8_t)(s[j] + DIV255(d[j] * ia));
+			}
+			continue;
+		}
+		memcpy(old, d, 4);
+		blend(dop->op, s, d);
+		if (k != 255)
+			for (j = 0; j < 4; j++)
+				d[j] = (uint8_t)(old[j] +
+					((d[j] - old[j]) * k + (d[j] >= old[j] ? 127 : -127)) / 255);
+	}
+	cv_dirty(cv, x0, y, x1, y + 1);
+}
+
+/* ---- strokes ----------------------------------------------------------- */
+
+struct polys {
+	double *pts;
+	int *counts;
+	int npts, nsub, cap_pts, cap_sub;
+};
+
+static bool polys_add(struct polys *pl, const double *p, int n)
+{
+	double area = 0;
+	int i;
+
+	if (pl->npts + n > pl->cap_pts) {
+		int c = pl->cap_pts ? pl->cap_pts * 2 : 256;
+		double *np;
+		while (c < pl->npts + n) c *= 2;
+		np = realloc(pl->pts, sizeof(double) * 2 * c);
+		if (np == NULL) return false;
+		pl->pts = np;
+		pl->cap_pts = c;
+	}
+	if (pl->nsub + 1 > pl->cap_sub) {
+		int c = pl->cap_sub ? pl->cap_sub * 2 : 64;
+		int *nc = realloc(pl->counts, sizeof(int) * c);
+		if (nc == NULL) return false;
+		pl->counts = nc;
+		pl->cap_sub = c;
+	}
+	for (i = 0; i < n; i++) {
+		int j = (i + 1) % n;
+		area += p[2 * i] * p[2 * j + 1] - p[2 * j] * p[2 * i + 1];
+	}
+	for (i = 0; i < n; i++) {
+		/* every piece the same way round: overlaps add, never cancel */
+		int k = area < 0 ? n - 1 - i : i;
+		pl->pts[2 * (pl->npts + i)] = p[2 * k];
+		pl->pts[2 * (pl->npts + i) + 1] = p[2 * k + 1];
+	}
+	pl->npts += n;
+	pl->counts[pl->nsub++] = n;
+	return true;
+}
+
+static int circle_steps(double r)
+{
+	double a;
+	int n;
+	if (r <= 0.25)
+		return 8;
+	a = acos(1.0 - 0.1 / r);
+	n = (a > 0) ? (int)ceil(M_PI / a) : 256;
+	return clampi(n, 8, 256);
+}
+
+static bool add_disc(struct polys *pl, double x, double y, double r)
+{
+	double buf[2 * 256];
+	int n = circle_steps(r), i;
+	for (i = 0; i < n; i++) {
+		double a = 2 * M_PI * i / n;
+		buf[2 * i] = x + r * cos(a);
+		buf[2 * i + 1] = y + r * sin(a);
+	}
+	return polys_add(pl, buf, n);
+}
+
+static bool add_quad(struct polys *pl, double ax, double ay, double bx,
+		double by, double cx, double cy, double dx, double dy)
+{
+	double q[8];
+	q[0] = ax; q[1] = ay; q[2] = bx; q[3] = by;
+	q[4] = cx; q[5] = cy; q[6] = dx; q[7] = dy;
+	return polys_add(pl, q, 4);
+}
+
+static bool add_join(struct polys *pl, double px, double py, double d0x,
+		double d0y, double d1x, double d1y, double hw, int join,
+		double miter)
+{
+	double cr = d0x * d1y - d0y * d1x, dot = d0x * d1x + d0y * d1y;
+	double o0x, o0y, o1x, o1y, t[6];
+
+	if (fabs(cr) < 1e-9 && dot > 0)
+		return true;	/* straight on */
+	if (join == 1)
+		return add_disc(pl, px, py, hw);
+	/* the outer side: away from the turn */
+	if (cr > 0) {
+		o0x = d0y * hw; o0y = -d0x * hw;
+		o1x = d1y * hw; o1y = -d1x * hw;
+	} else {
+		o0x = -d0y * hw; o0y = d0x * hw;
+		o1x = -d1y * hw; o1y = d1x * hw;
+	}
+	if (join == 0) {
+		double mx = o0x + o1x, my = o0y + o1y, ml = sqrt(mx * mx + my * my);
+		if (ml > 1e-12) {
+			double cosh = (mx * o0x + my * o0y) / (ml * hw);
+			if (cosh > 1e-9 && 1.0 / cosh <= miter) {
+				double len = hw / cosh;
+				return add_quad(pl, px, py, px + o0x, py + o0y,
+						px + mx / ml * len, py + my / ml * len,
+						px + o1x, py + o1y);
+			}
+		}
+	}
+	t[0] = px; t[1] = py;
+	t[2] = px + o0x; t[3] = py + o0y;
+	t[4] = px + o1x; t[5] = py + o1y;
+	return polys_add(pl, t, 3);
+}
+
+static bool add_cap(struct polys *pl, double px, double py, double dx,
+		double dy, double hw, int cap, bool start)
+{
+	double nx = -dy * hw, ny = dx * hw, ex, ey;
+	if (cap == 1)
+		return add_disc(pl, px, py, hw);
+	if (cap != 2)
+		return true;
+	ex = (start ? -dx : dx) * hw;
+	ey = (start ? -dy : dy) * hw;
+	return add_quad(pl, px + nx, py + ny, px - nx, py - ny,
+			px - nx + ex, py - ny + ey, px + nx + ex, py + ny + ey);
+}
+
+static bool stroke_path(struct polys *pl, const double *pts,
+		const int *counts, const uint8_t *closed, int nsub, double hw,
+		int cap, int join, double miter)
+{
+	int s, off = 0;
+	double *q = NULL;
+	int qcap = 0;
+	bool ok = true;
+
+	for (s = 0; s < nsub && ok; s++) {
+		const double *p = pts + 2 * off;
+		int n = counts[s], m = 0, i, nseg;
+		bool cl = closed != NULL && closed[s];
+
+		off += n;
+		if (n > qcap) {
+			double *nq = realloc(q, sizeof(double) * 2 * n);
+			if (nq == NULL) { ok = false; break; }
+			q = nq;
+			qcap = n;
+		}
+		/* drop repeated points and anything not finite */
+		for (i = 0; i < n; i++) {
+			if (!isfinite(p[2 * i]) || !isfinite(p[2 * i + 1]))
+				continue;
+			if (m > 0 && fabs(p[2 * i] - q[2 * (m - 1)]) < 1e-9 &&
+			    fabs(p[2 * i + 1] - q[2 * (m - 1) + 1]) < 1e-9)
+				continue;
+			q[2 * m] = p[2 * i];
+			q[2 * m + 1] = p[2 * i + 1];
+			m++;
+		}
+		if (cl && m > 1 && fabs(q[0] - q[2 * (m - 1)]) < 1e-9 &&
+		    fabs(q[1] - q[2 * (m - 1) + 1]) < 1e-9)
+			m--;
+		if (m == 0)
+			continue;
+		if (m == 1) {
+			/* a zero-length subpath: a dot for round caps, a
+			 * square for square caps (axis-aligned) */
+			if (n > 1 && cap == 1)
+				ok = add_disc(pl, q[0], q[1], hw);
+			else if (n > 1 && cap == 2)
+				ok = add_quad(pl, q[0] - hw, q[1] - hw, q[0] + hw,
+					q[1] - hw, q[0] + hw, q[1] + hw,
+					q[0] - hw, q[1] + hw);
+			continue;
+		}
+		nseg = cl ? m : m - 1;
+		for (i = 0; i < nseg && ok; i++) {
+			int j = (i + 1) % m;
+			double dx = q[2 * j] - q[2 * i], dy = q[2 * j + 1] - q[2 * i + 1];
+			double len = sqrt(dx * dx + dy * dy), nx, ny;
+			dx /= len; dy /= len;
+			nx = -dy * hw; ny = dx * hw;
+			ok = add_quad(pl, q[2 * i] + nx, q[2 * i + 1] + ny,
+				q[2 * j] + nx, q[2 * j + 1] + ny,
+				q[2 * j] - nx, q[2 * j + 1] - ny,
+				q[2 * i] - nx, q[2 * i + 1] - ny);
+		}
+		/* joins: at every inner vertex, and at all of them when closed */
+		for (i = cl ? 0 : 1; i < (cl ? m : m - 1) && ok; i++) {
+			int a = (i - 1 + m) % m, b = (i + 1) % m;
+			double d0x = q[2 * i] - q[2 * a], d0y = q[2 * i + 1] - q[2 * a + 1];
+			double d1x = q[2 * b] - q[2 * i], d1y = q[2 * b + 1] - q[2 * i + 1];
+			double l0 = sqrt(d0x * d0x + d0y * d0y);
+			double l1 = sqrt(d1x * d1x + d1y * d1y);
+			ok = add_join(pl, q[2 * i], q[2 * i + 1], d0x / l0, d0y / l0,
+				d1x / l1, d1y / l1, hw, join, miter);
+		}
+		if (!cl && ok) {
+			double dx = q[2] - q[0], dy = q[3] - q[1];
+			double l = sqrt(dx * dx + dy * dy);
+			ok = add_cap(pl, q[0], q[1], dx / l, dy / l, hw, cap, true);
+			dx = q[2 * (m - 1)] - q[2 * (m - 2)];
+			dy = q[2 * (m - 1) + 1] - q[2 * (m - 2) + 1];
+			l = sqrt(dx * dx + dy * dy);
+			if (ok)
+				ok = add_cap(pl, q[2 * (m - 1)], q[2 * (m - 1) + 1],
+					dx / l, dy / l, hw, cap, false);
+		}
+	}
+	free(q);
+	return ok;
+}
+
+/* ---- clip --------------------------------------------------------------- */
+
+struct clipjob {
+	struct cv *cv;
+	uint8_t *mask;
+};
+
+static void clip_row(void *pw, int y, int x0, int x1, const uint8_t *cov)
+{
+	struct clipjob *cj = pw;
+	uint8_t *m = cj->mask + (size_t)y * cj->cv->w;
+	const uint8_t *old = cj->cv->clip != NULL ?
+		cj->cv->clip + (size_t)y * cj->cv->w : NULL;
+	int x;
+	for (x = x0; x < x1; x++) {
+		int c = cov[x - x0];
+		m[x] = (uint8_t)(old != NULL ? DIV255(c * old[x]) : c);
+	}
+}
+
+/* ---- JS natives --------------------------------------------------------- */
+
+static struct cv *cv_of(JSValueConst v)
+{
+	return JS_GetOpaque(v, s_cv_class_id);
+}
+
+static void cv_finalizer(JSRuntime *rt, JSValue val)
+{
+	struct cv *cv = JS_GetOpaque(val, s_cv_class_id);
+	(void)rt;
+	if (cv == NULL)
+		return;
+	if (cv->scheduled)
+		macos9_schedule(-1, cv_flush, cv);
+	cv_free_clips(cv);
+	free(cv->px);
+	if (cv->node != NULL)
+		dom_node_unref(cv->node);
+	free(cv);
+}
+
+static JSClassDef s_cv_class = { "CanvasPixels", cv_finalizer, NULL, NULL, NULL };
+
+/** A typed array's elements, when it is of the expected type. */
+static void *typed(JSContext *ctx, JSValueConst v, int type, size_t *n)
+{
+	size_t off = 0, len = 0, bpe = 0, sz = 0;
+	JSValue ab;
+	uint8_t *buf;
+
+	*n = 0;
+	if (JS_GetTypedArrayType(v) != type)
+		return NULL;
+	ab = JS_GetTypedArrayBuffer(ctx, v, &off, &len, &bpe);
+	if (JS_IsException(ab))
+		return NULL;
+	buf = JS_GetArrayBuffer(ctx, &sz, ab);
+	JS_FreeValue(ctx, ab);
+	if (buf == NULL || bpe == 0)
+		return NULL;
+	*n = len / bpe;
+	return buf + off;
+}
+
+static double num_at(JSContext *ctx, JSValueConst arr, uint32_t i)
+{
+	JSValue v = JS_GetPropertyUint32(ctx, arr, i);
+	double d = 0;
+	if (JS_ToFloat64(ctx, &d, v) != 0)
+		d = 0;
+	JS_FreeValue(ctx, v);
+	return d;
+}
+
+static double num_arg(JSContext *ctx, int argc, JSValueConst *argv, int i,
+		double dflt)
+{
+	double d;
+	if (i >= argc || JS_ToFloat64(ctx, &d, argv[i]) != 0)
+		return dflt;
+	return d;
+}
+
+static int int_arg(JSContext *ctx, int argc, JSValueConst *argv, int i,
+		int dflt)
+{
+	return dtoi(num_arg(ctx, argc, argv, i, dflt));
+}
+
+/** Copy a source's pixels (premultiplied) for an image paint: a canvas
+ * handle or an <img> element; the integer rectangle covering sx..sw. */
+static bool image_source(JSContext *ctx, JSValueConst src, double sx,
+		double sy, double sw, double sh, struct paint *p)
+{
+	struct cv *scv = cv_of(src);
+	const uint8_t *buf = NULL;
+	size_t stride = 0;
+	int w = 0, h = 0, x0, y0, x1, y1, x, y;
+	bool premul = false, opaque = false;
+
+	if (scv != NULL) {
+		if (scv->px == NULL)
+			return false;
+		buf = scv->px;
+		w = scv->w;
+		h = scv->h;
+		stride = (size_t)w * 4;
+		premul = true;
+	} else if (s_ops != NULL && s_ops->get_node != NULL &&
+		   s_ops->img_bitmap != NULL) {
+		struct dom_node *n = s_ops->get_node(src);
+		struct bitmap *bm = n != NULL ? s_ops->img_bitmap(ctx, n) : NULL;
+		if (bm == NULL)
+			return false;
+		buf = guit->bitmap->get_buffer(bm);
+		w = guit->bitmap->get_width(bm);
+		h = guit->bitmap->get_height(bm);
+		stride = guit->bitmap->get_rowstride(bm);
+		opaque = guit->bitmap->get_opaque(bm);
+	}
+	if (buf == NULL || w <= 0 || h <= 0)
+		return false;
+	if (sw < 0) { sx += sw; sw = -sw; }
+	if (sh < 0) { sy += sh; sh = -sh; }
+	x0 = clampi(dtoi(floor(sx)), 0, w);
+	y0 = clampi(dtoi(floor(sy)), 0, h);
+	x1 = clampi(dtoi(ceil(sx + sw)), 0, w);
+	y1 = clampi(dtoi(ceil(sy + sh)), 0, h);
+	if (x1 <= x0 || y1 <= y0)
+		return false;
+	p->iw = x1 - x0;
+	p->ih = y1 - y0;
+	p->img_owned = malloc((size_t)p->iw * p->ih * 4);
+	if (p->img_owned == NULL)
+		return false;
+	for (y = 0; y < p->ih; y++) {
+		const uint8_t *s = buf + (size_t)(y0 + y) * stride + (size_t)x0 * 4;
+		uint8_t *d = p->img_owned + (size_t)y * p->iw * 4;
+		if (premul) {
+			memcpy(d, s, (size_t)p->iw * 4);
+			continue;
+		}
+		for (x = 0; x < p->iw; x++, s += 4, d += 4) {
+			unsigned a = opaque ? 255 : s[3];
+			d[0] = (uint8_t)DIV255(s[0] * a);
+			d[1] = (uint8_t)DIV255(s[1] * a);
+			d[2] = (uint8_t)DIV255(s[2] * a);
+			d[3] = (uint8_t)a;
+		}
+	}
+	p->img = p->img_owned;
+	p->ix = x0;
+	p->iy = y0;
+	return true;
+}
+
+/**
+ * A paint from its JS description:
+ *   [0, r, g, b, a]                                  a colour (a 0..1)
+ *   [1, inv x6, x0, y0, x1, y1, stops]               linear gradient
+ *   [2, inv x6, x0, y0, r0, x1, y1, r1, stops]       radial gradient
+ *   [3, inv x6, angle, cx, cy, stops]                conic gradient
+ *   [4, inv x6, source, sx, sy, sw, sh, repx, repy, smooth]   an image
+ * inv maps device pixels to the paint's space (user space for gradients,
+ * the source's pixels for images); stops is a Float64Array of
+ * offset, r, g, b, a.
+ */
+static bool get_paint(JSContext *ctx, JSValueConst v, struct paint *p)
+{
+	int i;
+	memset(p, 0, sizeof(*p));
+	if (!JS_IsObject(v))
+		return false;
+	p->type = dtoi(num_at(ctx, v, 0));
+	if (p->type == 0) {
+		double a = num_at(ctx, v, 4);
+		a = a < 0 ? 0 : (a > 1 ? 1 : a);
+		p->rgba[3] = (uint8_t)(a * 255 + 0.5);
+		for (i = 0; i < 3; i++)
+			p->rgba[i] = (uint8_t)DIV255(clampi(dtoi(num_at(ctx, v,
+					(uint32_t)(1 + i))), 0, 255) * p->rgba[3]);
+		return true;
+	}
+	for (i = 0; i < 6; i++)
+		p->inv[i] = num_at(ctx, v, (uint32_t)(1 + i));
+	if (p->type >= 1 && p->type <= 3) {
+		int ng = p->type == 1 ? 4 : (p->type == 2 ? 6 : 3);
+		JSValue sv;
+		size_t ns = 0;
+		const double *st;
+		for (i = 0; i < ng; i++)
+			p->g[i] = num_at(ctx, v, (uint32_t)(7 + i));
+		sv = JS_GetPropertyUint32(ctx, v, (uint32_t)(7 + ng));
+		st = typed(ctx, sv, JS_TYPED_ARRAY_FLOAT64, &ns);
+		if (st != NULL)
+			build_lut(p, st, (int)(ns / 5));
+		else
+			p->none = true;
+		JS_FreeValue(ctx, sv);
+		if (p->type == 1) {
+			double dx = p->g[2] - p->g[0], dy = p->g[3] - p->g[1];
+			double l2 = dx * dx + dy * dy;
+			if (l2 < 1e-18)
+				p->none = true;
+			p->g[2] = dx;
+			p->g[3] = dy;
+			p->g[4] = l2 > 0 ? 1.0 / l2 : 0;
+		} else if (p->type == 2) {
+			if (p->g[0] == p->g[3] && p->g[1] == p->g[4] &&
+			    p->g[2] == p->g[5])
+				p->none = true;
+		}
+		return true;
+	}
+	if (p->type == 4) {
+		JSValue src = JS_GetPropertyUint32(ctx, v, 7);
+		bool ok = image_source(ctx, src, num_at(ctx, v, 8),
+				num_at(ctx, v, 9), num_at(ctx, v, 10),
+				num_at(ctx, v, 11), p);
+		JS_FreeValue(ctx, src);
+		p->rep_x = num_at(ctx, v, 12) != 0;
+		p->rep_y = num_at(ctx, v, 13) != 0;
+		p->smooth = num_at(ctx, v, 14) != 0;
+		if (!ok)
+			p->none = true;
+		return true;
+	}
+	return false;
+}
+
+/* __cv.create(element, w, h) -> handle */
+static JSValue js_cv_create(JSContext *ctx, JSValueConst this_val, int argc,
+		JSValueConst *argv)
+{
+	struct cv *cv;
+	struct dom_node *node = NULL;
+	struct bitmap *bm = NULL;
+	JSValue obj;
+	int w = int_arg(ctx, argc, argv, 1, 300);
+	int h = int_arg(ctx, argc, argv, 2, 150);
+
+	(void)this_val;
+	if (argc >= 1 && s_ops != NULL && s_ops->get_node != NULL)
+		node = s_ops->get_node(argv[0]);
+	cv = calloc(1, sizeof(*cv));
+	if (cv == NULL)
+		return JS_ThrowOutOfMemory(ctx);
+	obj = JS_NewObjectClass(ctx, (int)s_cv_class_id);
+	if (JS_IsException(obj)) {
+		free(cv);
+		return obj;
+	}
+	if (node != NULL)
+		cv->node = dom_node_ref(node);
+	JS_SetOpaque(obj, cv);
+	cv_resize(cv, w, h);
+	/* a context made again for the same element (its first one was
+	 * collected) starts from what the element shows */
+	if (cv->node != NULL && cv->px != NULL &&
+	    dom_node_get_user_data(cv->node,
+			corestring_dom___ns_key_canvas_node_data,
+			(void **)&bm) == DOM_NO_ERR && bm != NULL &&
+	    guit->bitmap->get_width(bm) == w &&
+	    guit->bitmap->get_height(bm) == h) {
+		const uint8_t *b = guit->bitmap->get_buffer(bm);
+		size_t stride = guit->bitmap->get_rowstride(bm);
+		int x, y;
+		for (y = 0; b != NULL && y < h; y++) {
+			const uint8_t *s = b + (size_t)y * stride;
+			uint8_t *d = cv->px + (size_t)y * w * 4;
+			for (x = 0; x < w; x++, s += 4, d += 4) {
+				d[0] = (uint8_t)DIV255(s[0] * s[3]);
+				d[1] = (uint8_t)DIV255(s[1] * s[3]);
+				d[2] = (uint8_t)DIV255(s[2] * s[3]);
+				d[3] = s[3];
+			}
+		}
+	}
+	return obj;
+}
+
+/* __cv.resize(handle, w, h): clears it, as setting width/height does */
+static JSValue js_cv_resize(JSContext *ctx, JSValueConst this_val, int argc,
+		JSValueConst *argv)
+{
+	struct cv *cv = argc > 0 ? cv_of(argv[0]) : NULL;
+	(void)this_val;
+	if (cv != NULL)
+		cv_resize(cv, int_arg(ctx, argc, argv, 1, 0),
+			  int_arg(ctx, argc, argv, 2, 0));
+	return JS_UNDEFINED;
+}
+
+static void draw_polys(struct cv *cv, struct paint *p, double alpha, int op,
+		const double *pts, const int *counts, int nsub, bool evenodd)
+{
+	struct drawop dop;
+	bool unb;
+
+	if (cv->px == NULL || p->none || !(alpha > 0) || op < 0 ||
+	    op >= OP_COUNT)
+		return;
+	if (alpha > 1) alpha = 1;
+	dop.cv = cv;
+	dop.paint = p;
+	dop.ga = (int)(alpha * 255 + 0.5);
+	dop.op = op;
+	dop.row = NULL;		/* paint colours: not needed for a colour */
+	if (p->type != 0 && (dop.row = malloc((size_t)cv->w * 4)) == NULL)
+		return;
+	unb = op_unbounded(op);
+	raster(pts, counts, nsub, evenodd, 0, 0, cv->w, cv->h, unb,
+	       comp_row, &dop);
+	free(dop.row);
+	cv_changed(cv);
+}
+
+static int *get_counts(JSContext *ctx, JSValueConst v, int *nsub,
+		size_t npts)
+{
+	size_t n = 0, i, tot = 0;
+	int *c = typed(ctx, v, JS_TYPED_ARRAY_INT32, &n);
+	*nsub = 0;
+	if (c == NULL)
+		return NULL;
+	for (i = 0; i < n; i++) {
+		if (c[i] < 0)
+			return NULL;
+		tot += (size_t)c[i];
+	}
+	if (tot > npts)
+		return NULL;
+	*nsub = (int)n;
+	return c;
+}
+
+/* __cv.fill(handle, pts, counts, evenodd, paint, alpha, op) */
+static JSValue js_cv_fill(JSContext *ctx, JSValueConst this_val, int argc,
+		JSValueConst *argv)
+{
+	struct cv *cv = argc > 0 ? cv_of(argv[0]) : NULL;
+	struct paint p;
+	size_t np = 0;
+	const double *pts;
+	int *counts, nsub;
+
+	(void)this_val;
+	if (cv == NULL || argc < 7)
+		return JS_UNDEFINED;
+	pts = typed(ctx, argv[1], JS_TYPED_ARRAY_FLOAT64, &np);
+	counts = get_counts(ctx, argv[2], &nsub, np / 2);
+	if (pts == NULL || counts == NULL || !get_paint(ctx, argv[4], &p))
+		return JS_UNDEFINED;
+	draw_polys(cv, &p, num_arg(ctx, argc, argv, 5, 1),
+		   int_arg(ctx, argc, argv, 6, 0), pts, counts, nsub,
+		   JS_ToBool(ctx, argv[3]));
+	paint_free(&p);
+	return JS_UNDEFINED;
+}
+
+/* __cv.stroke(handle, pts, counts, closed, width, cap, join, miter, paint,
+ * alpha, op) */
+static JSValue js_cv_stroke(JSContext *ctx, JSValueConst this_val, int argc,
+		JSValueConst *argv)
+{
+	struct cv *cv = argc > 0 ? cv_of(argv[0]) : NULL;
+	struct paint p;
+	struct polys pl;
+	size_t np = 0, ncl = 0;
+	const double *pts;
+	const uint8_t *closed;
+	int *counts, nsub;
+	double width;
+
+	(void)this_val;
+	if (cv == NULL || argc < 11)
+		return JS_UNDEFINED;
+	pts = typed(ctx, argv[1], JS_TYPED_ARRAY_FLOAT64, &np);
+	counts = get_counts(ctx, argv[2], &nsub, np / 2);
+	closed = typed(ctx, argv[3], JS_TYPED_ARRAY_UINT8, &ncl);
+	width = num_arg(ctx, argc, argv, 4, 1);
+	if (pts == NULL || counts == NULL || (closed != NULL &&
+	    ncl < (size_t)nsub) || !(width > 0) || cv->px == NULL)
+		return JS_UNDEFINED;
+	if (!get_paint(ctx, argv[8], &p))
+		return JS_UNDEFINED;
+	memset(&pl, 0, sizeof(pl));
+	if (stroke_path(&pl, pts, counts, closed, nsub, width / 2,
+			int_arg(ctx, argc, argv, 5, 0),
+			int_arg(ctx, argc, argv, 6, 0),
+			num_arg(ctx, argc, argv, 7, 10)) && pl.nsub > 0)
+		draw_polys(cv, &p, num_arg(ctx, argc, argv, 9, 1),
+			   int_arg(ctx, argc, argv, 10, 0), pl.pts,
+			   pl.counts, pl.nsub, false);
+	free(pl.pts);
+	free(pl.counts);
+	paint_free(&p);
+	return JS_UNDEFINED;
+}
+
+/* __cv.clip(handle, pts, counts, evenodd): intersect the clip */
+static JSValue js_cv_clip(JSContext *ctx, JSValueConst this_val, int argc,
+		JSValueConst *argv)
+{
+	struct cv *cv = argc > 0 ? cv_of(argv[0]) : NULL;
+	struct clipjob cj;
+	size_t np = 0;
+	const double *pts;
+	int *counts, nsub;
+
+	(void)this_val;
+	if (cv == NULL || cv->px == NULL || argc < 4)
+		return JS_UNDEFINED;
+	pts = typed(ctx, argv[1], JS_TYPED_ARRAY_FLOAT64, &np);
+	counts = get_counts(ctx, argv[2], &nsub, np / 2);
+	if (pts == NULL || counts == NULL)
+		return JS_UNDEFINED;
+	cj.cv = cv;
+	cj.mask = calloc((size_t)cv->w, (size_t)cv->h);
+	if (cj.mask == NULL)
+		return JS_UNDEFINED;
+	raster(pts, counts, nsub, JS_ToBool(ctx, argv[3]), 0, 0, cv->w, cv->h,
+	       false, clip_row, &cj);
+	if (cv->clip_owned)
+		free(cv->clip);
+	cv->clip = cj.mask;
+	cv->clip_owned = true;
+	return JS_UNDEFINED;
+}
+
+/* __cv.save(handle) / __cv.restore(handle): the clip, with the state */
+static JSValue js_cv_save(JSContext *ctx, JSValueConst this_val, int argc,
+		JSValueConst *argv)
+{
+	struct cv *cv = argc > 0 ? cv_of(argv[0]) : NULL;
+	(void)ctx; (void)this_val;
+	if (cv == NULL)
+		return JS_UNDEFINED;
+	if (cv->depth >= CV_STACK) {
+		cv->overflow++;
+		return JS_UNDEFINED;
+	}
+	cv->stack[cv->depth].clip = cv->clip;
+	cv->stack[cv->depth].owned = cv->clip_owned;
+	cv->depth++;
+	cv->clip_owned = false;	/* the saved entry owns it now */
+	return JS_UNDEFINED;
+}
+
+static JSValue js_cv_restore(JSContext *ctx, JSValueConst this_val, int argc,
+		JSValueConst *argv)
+{
+	struct cv *cv = argc > 0 ? cv_of(argv[0]) : NULL;
+	(void)ctx; (void)this_val;
+	if (cv == NULL)
+		return JS_UNDEFINED;
+	if (cv->overflow > 0) {
+		cv->overflow--;
+		return JS_UNDEFINED;
+	}
+	if (cv->depth == 0)
+		return JS_UNDEFINED;
+	if (cv->clip_owned)
+		free(cv->clip);
+	cv->depth--;
+	cv->clip = cv->stack[cv->depth].clip;
+	cv->clip_owned = cv->stack[cv->depth].owned;
+	return JS_UNDEFINED;
+}
+
+/* __cv.reset(handle): the clip and its stack go (context.reset(), and a
+ * resize) */
+static JSValue js_cv_reset(JSContext *ctx, JSValueConst this_val, int argc,
+		JSValueConst *argv)
+{
+	struct cv *cv = argc > 0 ? cv_of(argv[0]) : NULL;
+	(void)ctx; (void)this_val;
+	if (cv != NULL)
+		cv_free_clips(cv);
+	return JS_UNDEFINED;
+}
+
+static void glyph_cb(void *pw, const unsigned char *cov, int stride, int x,
+		int y, int w, int h)
+{
+	struct drawop *dop = pw;
+	int r;
+	for (r = 0; r < h; r++)
+		comp_row(dop, y + r, x, x + w, cov + (size_t)r * stride);
+}
+
+static void font_args(JSContext *ctx, int argc, JSValueConst *argv, int at,
+		int *px, int *fam, int *bold, int *italic)
+{
+	*px = clampi(dtoi(floor(num_arg(ctx, argc, argv, at, 10) + 0.5)), 1, 512);
+	*fam = clampi(int_arg(ctx, argc, argv, at + 1, 0), 0, 2);
+	*bold = num_arg(ctx, argc, argv, at + 2, 0) != 0;
+	*italic = num_arg(ctx, argc, argv, at + 3, 0) != 0;
+}
+
+/* __cv.text(handle, string, px, family, bold, italic, x, y, paint, alpha,
+ * op) -> advance in device pixels; (x, y) is the baseline origin */
+static JSValue js_cv_text(JSContext *ctx, JSValueConst this_val, int argc,
+		JSValueConst *argv)
+{
+	struct cv *cv = argc > 0 ? cv_of(argv[0]) : NULL;
+	struct paint p;
+	struct drawop dop;
+	const char *s;
+	size_t len;
+	int px, fam, bold, italic, adv = 0;
+	double x, y, alpha;
+
+	(void)this_val;
+	if (cv == NULL || argc < 11)
+		return JS_NewInt32(ctx, 0);
+	font_args(ctx, argc, argv, 2, &px, &fam, &bold, &italic);
+	x = num_arg(ctx, argc, argv, 6, 0);
+	y = num_arg(ctx, argc, argv, 7, 0);
+	alpha = num_arg(ctx, argc, argv, 9, 1);
+	if (cv->px == NULL || !isfinite(x) || !isfinite(y) || !(alpha > 0))
+		return JS_NewInt32(ctx, 0);
+	if (!get_paint(ctx, argv[8], &p))
+		return JS_NewInt32(ctx, 0);
+	s = JS_ToCStringLen(ctx, &len, argv[1]);
+	if (s != NULL && !p.none) {
+		dop.cv = cv;
+		dop.paint = &p;
+		dop.ga = (int)((alpha > 1 ? 1 : alpha) * 255 + 0.5);
+		dop.op = int_arg(ctx, argc, argv, 10, 0);
+		if (dop.op < 0 || dop.op >= OP_COUNT || op_unbounded(dop.op))
+			dop.op = OP_SOURCE_OVER;
+		dop.row = p.type != 0 ? malloc((size_t)cv->w * 4) : NULL;
+		if (dop.row != NULL || p.type == 0) {
+			/* whole pixels: glyphs are rendered at a pixel origin */
+			adv = macsurf_canvas_glyphs(px, fam, bold, italic, s, len,
+				(int)floor(clampd(x, -1e6, 1e6) + 0.5),
+				(int)floor(clampd(y, -1e6, 1e6) + 0.5),
+				glyph_cb, &dop);
+			free(dop.row);
+			cv_changed(cv);
+		}
+	}
+	if (s != NULL)
+		JS_FreeCString(ctx, s);
+	paint_free(&p);
+	return JS_NewInt32(ctx, adv);
+}
+
+/* __cv.measure(string, px, family, bold, italic) -> [width, ascent,
+ * descent] in pixels at that size */
+static JSValue js_cv_measure(JSContext *ctx, JSValueConst this_val, int argc,
+		JSValueConst *argv)
+{
+	const char *s;
+	size_t len;
+	int px, fam, bold, italic, w = 0, asc = 0, desc = 0;
+	JSValue a;
+
+	(void)this_val;
+	font_args(ctx, argc, argv, 1, &px, &fam, &bold, &italic);
+	s = argc > 0 ? JS_ToCStringLen(ctx, &len, argv[0]) : NULL;
+	if (s != NULL) {
+		w = macsurf_canvas_glyphs(px, fam, bold, italic, s, len, 0, 0,
+				NULL, NULL);
+		JS_FreeCString(ctx, s);
+	}
+	macsurf_canvas_font_extents(px, fam, bold, italic, &asc, &desc);
+	a = JS_NewArray(ctx);
+	JS_SetPropertyUint32(ctx, a, 0, JS_NewInt32(ctx, w));
+	JS_SetPropertyUint32(ctx, a, 1, JS_NewInt32(ctx, asc));
+	JS_SetPropertyUint32(ctx, a, 2, JS_NewInt32(ctx, desc));
+	return a;
+}
+
+/* __cv.get(handle, x, y, w, h) -> ArrayBuffer of unpremultiplied RGBA */
+static JSValue js_cv_get(JSContext *ctx, JSValueConst this_val, int argc,
+		JSValueConst *argv)
+{
+	struct cv *cv = argc > 0 ? cv_of(argv[0]) : NULL;
+	int x0 = int_arg(ctx, argc, argv, 1, 0);
+	int y0 = int_arg(ctx, argc, argv, 2, 0);
+	int w = int_arg(ctx, argc, argv, 3, 0);
+	int h = int_arg(ctx, argc, argv, 4, 0);
+	uint8_t *buf;
+	size_t n;
+	int x, y;
+	JSValue ab;
+
+	(void)this_val;
+	if (w <= 0 || h <= 0 || (long)w * h > 16L * 1024 * 1024)
+		return JS_ThrowRangeError(ctx, "bad image size");
+	n = (size_t)w * h * 4;
+	buf = calloc(1, n);
+	if (buf == NULL)
+		return JS_ThrowOutOfMemory(ctx);
+	if (cv != NULL && cv->px != NULL) {
+		for (y = 0; y < h; y++) {
+			int sy = y0 + y;
+			if (sy < 0 || sy >= cv->h)
+				continue;
+			for (x = 0; x < w; x++) {
+				int sx = x0 + x;
+				const uint8_t *s;
+				uint8_t *d;
+				unsigned a;
+				if (sx < 0 || sx >= cv->w)
+					continue;
+				s = cv->px + ((size_t)sy * cv->w + sx) * 4;
+				d = buf + ((size_t)y * w + x) * 4;
+				a = s[3];
+				if (a == 0)
+					continue;
+				d[0] = (uint8_t)((s[0] * 255 + a / 2) / a);
+				d[1] = (uint8_t)((s[1] * 255 + a / 2) / a);
+				d[2] = (uint8_t)((s[2] * 255 + a / 2) / a);
+				d[3] = (uint8_t)a;
+			}
+		}
+	}
+	ab = JS_NewArrayBufferCopy(ctx, buf, n);
+	free(buf);
+	return ab;
+}
+
+/* __cv.put(handle, data, iw, ih, dx, dy, x0, y0, x1, y1): data's pixels
+ * x0..x1, y0..y1 at dx+x, dy+y, replacing what is there */
+static JSValue js_cv_put(JSContext *ctx, JSValueConst this_val, int argc,
+		JSValueConst *argv)
+{
+	struct cv *cv = argc > 0 ? cv_of(argv[0]) : NULL;
+	size_t n = 0;
+	const uint8_t *data;
+	int iw, ih, dx, dy, x0, y0, x1, y1, x, y;
+
+	(void)this_val;
+	if (cv == NULL || cv->px == NULL || argc < 10)
+		return JS_UNDEFINED;
+	data = typed(ctx, argv[1], JS_TYPED_ARRAY_UINT8C, &n);
+	if (data == NULL)
+		data = typed(ctx, argv[1], JS_TYPED_ARRAY_UINT8, &n);
+	iw = int_arg(ctx, argc, argv, 2, 0);
+	ih = int_arg(ctx, argc, argv, 3, 0);
+	if (data == NULL || iw <= 0 || ih <= 0 ||
+	    n < (size_t)iw * (size_t)ih * 4)
+		return JS_UNDEFINED;
+	dx = int_arg(ctx, argc, argv, 4, 0);
+	dy = int_arg(ctx, argc, argv, 5, 0);
+	x0 = clampi(int_arg(ctx, argc, argv, 6, 0), 0, iw);
+	y0 = clampi(int_arg(ctx, argc, argv, 7, 0), 0, ih);
+	x1 = clampi(int_arg(ctx, argc, argv, 8, iw), 0, iw);
+	y1 = clampi(int_arg(ctx, argc, argv, 9, ih), 0, ih);
+	for (y = y0; y < y1; y++) {
+		int ty = dy + y;
+		if (ty < 0 || ty >= cv->h)
+			continue;
+		for (x = x0; x < x1; x++) {
+			int tx = dx + x;
+			const uint8_t *s;
+			uint8_t *d;
+			if (tx < 0 || tx >= cv->w)
+				continue;
+			s = data + ((size_t)y * iw + x) * 4;
+			d = cv->px + ((size_t)ty * cv->w + tx) * 4;
+			d[0] = (uint8_t)DIV255(s[0] * s[3]);
+			d[1] = (uint8_t)DIV255(s[1] * s[3]);
+			d[2] = (uint8_t)DIV255(s[2] * s[3]);
+			d[3] = s[3];
+		}
+	}
+	cv_dirty(cv, dx + x0, dy + y0, dx + x1, dy + y1);
+	cv_changed(cv);
+	return JS_UNDEFINED;
+}
+
+/* ---- PNG -------------------------------------------------------------- */
+
+static uint32_t crc_table[256];
+
+static uint32_t crc32_update(uint32_t c, const uint8_t *b, size_t n)
+{
+	size_t i;
+	if (crc_table[1] == 0) {
+		uint32_t k, v;
+		int j;
+		for (k = 0; k < 256; k++) {
+			v = k;
+			for (j = 0; j < 8; j++)
+				v = (v & 1) ? 0xedb88320u ^ (v >> 1) : v >> 1;
+			crc_table[k] = v;
+		}
+	}
+	for (i = 0; i < n; i++)
+		c = crc_table[(c ^ b[i]) & 0xff] ^ (c >> 8);
+	return c;
+}
+
+static uint8_t *put32(uint8_t *p, uint32_t v)
+{
+	p[0] = (uint8_t)(v >> 24); p[1] = (uint8_t)(v >> 16);
+	p[2] = (uint8_t)(v >> 8); p[3] = (uint8_t)v;
+	return p + 4;
+}
+
+static uint8_t *png_chunk(uint8_t *p, const char *type, const uint8_t *data,
+		size_t n)
+{
+	uint8_t *start;
+	p = put32(p, (uint32_t)n);
+	start = p;
+	memcpy(p, type, 4);
+	p += 4;
+	if (n > 0)
+		memcpy(p, data, n);
+	p += n;
+	return put32(p, ~crc32_update(0xffffffffu, start, n + 4));
+}
+
+/** A PNG of the canvas (unpremultiplied RGBA, deflate stored blocks). */
+static uint8_t *png_encode(const struct cv *cv, size_t *out_len)
+{
+	int w = cv->w > 0 ? cv->w : 1, h = cv->h > 0 ? cv->h : 1;
+	size_t raw = (size_t)h * ((size_t)w * 4 + 1);
+	size_t blocks = raw / 65535 + 1;
+	size_t zlen = 2 + raw + blocks * 5 + 4;
+	size_t total = 8 + 25 + 12 + zlen + 12;
+	uint8_t *png = malloc(total), *z, *zp, *p, ihdr[13];
+	uint32_t s1 = 1, s2 = 0;
+	size_t done = 0;
+	int x, y;
+
+	if (png == NULL)
+		return NULL;
+	z = malloc(zlen);
+	if (z == NULL) {
+		free(png);
+		return NULL;
+	}
+	zp = z;
+	*zp++ = 0x78;
+	*zp++ = 0x01;
+	for (y = 0; y < h; y++) {
+		for (x = -1; x < w * 4; x++) {
+			uint8_t b = 0;
+			if (x >= 0 && cv->px != NULL && cv->w > 0 && cv->h > 0) {
+				const uint8_t *s = cv->px +
+					((size_t)y * cv->w + x / 4) * 4;
+				unsigned a = s[3];
+				if ((x & 3) == 3)
+					b = (uint8_t)a;
+				else if (a != 0)
+					b = (uint8_t)((s[x & 3] * 255 + a / 2) / a);
+			}
+			if (done % 65535 == 0) {
+				size_t left = raw - done;
+				size_t bl = left > 65535 ? 65535 : left;
+				*zp++ = left > 65535 ? 0 : 1;
+				*zp++ = (uint8_t)bl;
+				*zp++ = (uint8_t)(bl >> 8);
+				*zp++ = (uint8_t)~bl;
+				*zp++ = (uint8_t)(~bl >> 8);
+			}
+			*zp++ = b;
+			done++;
+			s1 = (s1 + b) % 65521;
+			s2 = (s2 + s1) % 65521;
+		}
+	}
+	zp = put32(zp, (s2 << 16) | s1);
+	p = png;
+	memcpy(p, "\x89PNG\r\n\x1a\n", 8);
+	p += 8;
+	put32(ihdr, (uint32_t)w);
+	put32(ihdr + 4, (uint32_t)h);
+	ihdr[8] = 8;	/* bit depth */
+	ihdr[9] = 6;	/* RGBA */
+	ihdr[10] = ihdr[11] = ihdr[12] = 0;
+	p = png_chunk(p, "IHDR", ihdr, 13);
+	p = png_chunk(p, "IDAT", z, (size_t)(zp - z));
+	p = png_chunk(p, "IEND", NULL, 0);
+	free(z);
+	*out_len = (size_t)(p - png);
+	return png;
+}
+
+/* __cv.png(handle, dataURL) -> "data:image/png;base64,..." or ArrayBuffer */
+static JSValue js_cv_png(JSContext *ctx, JSValueConst this_val, int argc,
+		JSValueConst *argv)
+{
+	static const char b64[] =
+		"ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
+	struct cv *cv = argc > 0 ? cv_of(argv[0]) : NULL;
+	uint8_t *png;
+	char *s, *q;
+	size_t n = 0, i;
+	JSValue r;
+
+	(void)this_val;
+	if (cv == NULL)
+		return JS_NULL;
+	png = png_encode(cv, &n);
+	if (png == NULL)
+		return JS_ThrowOutOfMemory(ctx);
+	if (argc < 2 || !JS_ToBool(ctx, argv[1])) {
+		r = JS_NewArrayBufferCopy(ctx, png, n);
+		free(png);
+		return r;
+	}
+	s = malloc(22 + (n + 2) / 3 * 4 + 1);
+	if (s == NULL) {
+		free(png);
+		return JS_ThrowOutOfMemory(ctx);
+	}
+	memcpy(s, "data:image/png;base64,", 22);
+	q = s + 22;
+	for (i = 0; i < n; i += 3) {
+		uint32_t v = (uint32_t)png[i] << 16;
+		if (i + 1 < n) v |= (uint32_t)png[i + 1] << 8;
+		if (i + 2 < n) v |= png[i + 2];
+		*q++ = b64[(v >> 18) & 63];
+		*q++ = b64[(v >> 12) & 63];
+		*q++ = i + 1 < n ? b64[(v >> 6) & 63] : '=';
+		*q++ = i + 2 < n ? b64[v & 63] : '=';
+	}
+	*q = '\0';
+	r = JS_NewString(ctx, s);
+	free(s);
+	free(png);
+	return r;
+}
+
+/* __cv.imgsize(source) -> [w, h] of an <img>'s decoded image or a canvas
+ * handle, or null when it has none (yet) */
+static JSValue js_cv_imgsize(JSContext *ctx, JSValueConst this_val, int argc,
+		JSValueConst *argv)
+{
+	struct cv *scv;
+	int w = 0, h = 0;
+	JSValue a;
+
+	(void)this_val;
+	if (argc < 1)
+		return JS_NULL;
+	scv = cv_of(argv[0]);
+	if (scv != NULL) {
+		w = scv->w;
+		h = scv->h;
+	} else if (s_ops != NULL && s_ops->get_node != NULL &&
+		   s_ops->img_bitmap != NULL) {
+		struct dom_node *n = s_ops->get_node(argv[0]);
+		struct bitmap *bm = n != NULL ? s_ops->img_bitmap(ctx, n) : NULL;
+		if (bm == NULL)
+			return JS_NULL;
+		w = guit->bitmap->get_width(bm);
+		h = guit->bitmap->get_height(bm);
+	}
+	a = JS_NewArray(ctx);
+	JS_SetPropertyUint32(ctx, a, 0, JS_NewInt32(ctx, w));
+	JS_SetPropertyUint32(ctx, a, 1, JS_NewInt32(ctx, h));
+	return a;
+}
+
+/* exported interface documented in macsurf_canvas.h */
+void macsurf_canvas_init_class(JSRuntime *rt)
+{
+	s_cv_class_id = 0;
+	JS_NewClassID(rt, &s_cv_class_id);
+	JS_NewClass(rt, s_cv_class_id, &s_cv_class);
+}
+
+/* exported interface documented in macsurf_canvas.h */
+void macsurf_canvas_install(JSContext *ctx, JSValueConst global,
+		const struct macsurf_canvas_ops *ops)
+{
+	static const struct {
+		const char *name;
+		JSCFunction *fn;
+		int n;
+	} fns[] = {
+		{ "create", js_cv_create, 3 },
+		{ "resize", js_cv_resize, 3 },
+		{ "fill", js_cv_fill, 7 },
+		{ "stroke", js_cv_stroke, 11 },
+		{ "clip", js_cv_clip, 4 },
+		{ "save", js_cv_save, 1 },
+		{ "restore", js_cv_restore, 1 },
+		{ "reset", js_cv_reset, 1 },
+		{ "text", js_cv_text, 11 },
+		{ "measure", js_cv_measure, 5 },
+		{ "get", js_cv_get, 5 },
+		{ "put", js_cv_put, 10 },
+		{ "png", js_cv_png, 2 },
+		{ "imgsize", js_cv_imgsize, 1 },
+	};
+	JSValue o = JS_NewObject(ctx);
+	size_t i;
+
+	s_ops = ops;
+	for (i = 0; i < sizeof(fns) / sizeof(fns[0]); i++)
+		JS_SetPropertyStr(ctx, o, fns[i].name,
+			JS_NewCFunction(ctx, fns[i].fn, fns[i].name, fns[i].n));
+	JS_SetPropertyStr(ctx, global, "__cv", o);
+}
+
+#endif
