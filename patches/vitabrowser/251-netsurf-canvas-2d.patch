+/*
+ * VitaBrowser patch 251: the canvas 2D raster.
+ *
+ * A <canvas> element's pixels, the shapes, text and images drawn into them,
+ * and the bitmap the page redraw shows (redraw.c plots the bitmap kept as
+ * the element's corestring_dom___ns_key_canvas_node_data user data). The
+ * JavaScript side -- CanvasRenderingContext2D's state, transforms, paths,
+ * colours and fonts -- is in vita_polyfill.js; it calls the natives
+ * installed here, on the hidden global `__cv`, with device coordinates.
+ */
+
+#ifndef MACSURF_CANVAS_H
+#define MACSURF_CANVAS_H
+
+#ifdef WITH_QUICKJS
+
+#include "quickjs.h"
+
+struct dom_node;
+struct bitmap;
+
+/** What the canvas needs from the bridge. */
+struct macsurf_canvas_ops {
+	/** The DOM node a JS element wrapper stands for, or NULL. */
+	struct dom_node *(*get_node)(JSValueConst val);
+	/** The decoded image an <img> element shows, or NULL. */
+	struct bitmap *(*img_bitmap)(JSContext *ctx, struct dom_node *node);
+};
+
+/** Register the handle class with a runtime (once per runtime). */
+void macsurf_canvas_init_class(JSRuntime *rt);
+
+/** Install `__cv` on a realm's global object. */
+void macsurf_canvas_install(JSContext *ctx, JSValueConst global,
+		const struct macsurf_canvas_ops *ops);
+
+#endif
+
+#endif
