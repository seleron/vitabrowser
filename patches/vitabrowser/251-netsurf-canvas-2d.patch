+int vita_text_glyphs(const struct vita_text_style *style, int x, int y,
+		     const char *utf8, size_t len, vita_glyph_fn fn, void *pw)
+{
+	size_t i = 0;
+	int pen = x, pen_q = 0;
+	unsigned char *mono = NULL;
+	size_t mono_size = 0;
+
+	while (i < len) {
+		const struct adv_entry *e =
+			resolve(style, utf8_to_ucs4(utf8 + i, len - i));
+		FT_Face f;
+
+		i = utf8_next(utf8, len, i);
+		if (fn != NULL && e->cp > 0x20 && e->cp != 0xa0 &&
+		    (f = face_at(e->face, e->px)) != NULL &&
+		    FT_Load_Glyph(f, e->gi, FT_LOAD_RENDER) == 0) {
+			FT_Bitmap *bm = &f->glyph->bitmap;
+			int w = (int)bm->width, h = (int)bm->rows, r, c;
+			if (w > 0 && h > 0 && bm->pixel_mode ==
+			    FT_PIXEL_MODE_GRAY && bm->pitch > 0) {
+				fn(pw, bm->buffer, bm->pitch,
+				   pen + f->glyph->bitmap_left,
+				   y - f->glyph->bitmap_top, w, h);
+			} else if (w > 0 && h > 0) {
+				/* mono, or bottom-up rows: as 8-bit rows */
+				if ((size_t)w * h > mono_size) {
+					unsigned char *m = realloc(mono,
+							(size_t)w * h);
+					if (m == NULL)
+						goto next;
+					mono = m;
+					mono_size = (size_t)w * h;
+				}
+				for (r = 0; r < h; r++) {
+					const unsigned char *src = bm->buffer +
+						(bm->pitch >= 0 ? r * bm->pitch :
+						 (h - 1 - r) * -bm->pitch);
+					for (c = 0; c < w; c++)
+						mono[r * w + c] =
+							bm->pixel_mode ==
+							FT_PIXEL_MODE_MONO ?
+							((src[c >> 3] & (0x80 >>
+							(c & 7))) ? 0xff : 0) :
+							src[c];
+				}
+				fn(pw, mono, w, pen + f->glyph->bitmap_left,
+				   y - f->glyph->bitmap_top, w, h);
+			}
+		}
+next:
+		pen_q += e->adv * PLOT_SPACING_SCALE + spacing(style, e->cp);
+		pen = x + vita_text_px(pen_q);
+	}
+	free(mono);
+	return pen - x;
+}
