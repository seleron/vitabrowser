+/* patch 252: callbacks are timed on the monotonic clock, as a timeval so
+ * the list keeps its arithmetic. A step of the wall clock fired every
+ * callback due in the next ~2 s at once (WSL steps it every ~32 s). */
+static void mono_tv(struct timeval *tv)
+{
+	uint64_t us = vita_mono_us();
+
+	tv->tv_sec = (long)(us / 1000000u);
+	tv->tv_usec = (long)(us % 1000000u);
+}
 
