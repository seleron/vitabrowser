 			      dump ? " (dumped)" : "");
 }
 
+/* exported interface documented in quickjs/macos9.h
+ *
+ * VitaBrowser patch 254: a long WebAssembly call (hCaptcha's proof of
+ * work: about a minute on the Vita) blocks the main loop; every 200 ms of
+ * it the page is drawn as it stands, with how long it has run, and
+ * CIRCLE stops it. Nothing else runs here -- no timers, no input to the
+ * page -- the script is still inside the call. The simulator reads no pad:
+ * its pad drives the scripted autotest. */
+int macsurf_wasm_slice(unsigned int ms)
+{
+	struct gui_window *gw = vita_window_current();
+	int stop = 0;
+
+	if (gw == NULL)
+		return 0;
+	set_message(0, "WebAssembly running: %u.%u s  (O stops)", ms / 1000,
+		    (ms % 1000) / 100);
+	draw_frame(gw, false, NULL);
+#ifndef VITA_HOST_SIM
+	{
+		SceCtrlData pad;
+		memset(&pad, 0, sizeof(pad));
+		sceCtrlPeekBufferPositive(0, &pad, 1);
+		if (pad.buttons & SCE_CTRL_CIRCLE)
+			stop = 1;
+	}
+#endif
+	if (stop)
+		vita_diag_log("wasm: stopped by the user after %u ms", ms);
+	return stop;
+}
+
+/* exported interface documented in quickjs/macos9.h */
+void macsurf_wasm_done(unsigned int ms, unsigned int slices)
+{
+	set_message(1500, "WebAssembly took %u.%u s", ms / 1000,
+		    (ms % 1000) / 100);
+	vita_diag_log("wasm: a call ran %u ms, %u frames drawn during it", ms,
+		      slices);
+}
+
 /**
  * Track whether the current page has a document yet, and log its progress
  * once a second until it does.
