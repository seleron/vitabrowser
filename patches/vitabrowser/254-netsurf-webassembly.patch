+static bool leb_u32(const uint8_t **p, const uint8_t *end, uint32_t *out)
+{
+	uint32_t v = 0;
+	int shift = 0;
+	while (*p < end && shift < 35) {
+		uint8_t b = *(*p)++;
+		v |= (uint32_t)(b & 0x7f) << shift;
+		if (!(b & 0x80)) {
+			*out = v;
+			return true;
+		}
+		shift += 7;
+	}
+	return false;
+}
+
+static char *read_name(const uint8_t **p, const uint8_t *end)
+{
+	uint32_t n;
+	char *s;
+	if (!leb_u32(p, end, &n) || n > (uint32_t)(end - *p))
+		return NULL;
+	s = malloc(n + 1);
+	if (s == NULL)
+		return NULL;
+	memcpy(s, *p, n);
+	s[n] = '\0';
+	*p += n;
+	return s;
+}
+
+static bool skip_limits(const uint8_t **p, const uint8_t *end, uint32_t *min)
+{
+	uint32_t flags, max;
+	if (!leb_u32(p, end, &flags) || !leb_u32(p, end, min))
+		return false;
+	if (flags & 1)
+		return leb_u32(p, end, &max);
+	return true;
+}
+
+static void wmod_free(struct wmod *m)
+{
+	int i;
+	if (m == NULL)
+		return;
+	for (i = 0; i < m->nimps; i++) {
+		free(m->imps[i].module);
+		free(m->imps[i].name);
+	}
+	for (i = 0; i < m->nexps; i++)
+		free(m->exps[i].name);
+	free(m->imps);
+	free(m->exps);
+	free(m->bytes);
+	free(m);
+}
+
+/** The import and export sections; NULL if they are malformed. */
+static const char *wmod_sections(struct wmod *m)
+{
+	const uint8_t *p = m->bytes + 8, *end = m->bytes + m->len;
+	uint32_t i, n;
+
+	while (p < end) {
+		uint8_t id = *p++;
+		uint32_t size;
+		const uint8_t *s, *send;
+		if (!leb_u32(&p, end, &size) || size > (uint32_t)(end - p))
+			return "section size out of bounds";
+		s = p;
+		send = p + size;
+		p = send;
+		if (id == 2) {		/* import */
+			if (!leb_u32(&s, send, &n) || n > 100000)
+				return "malformed import section";
+			m->imps = calloc(n ? n : 1, sizeof(*m->imps));
+			if (m->imps == NULL)
+				return "out of memory";
+			for (i = 0; i < n; i++) {
+				struct wimport *im = &m->imps[m->nimps];
+				uint8_t kind;
+				im->module = read_name(&s, send);
+				im->name = read_name(&s, send);
+				m->nimps++;
+				if (im->module == NULL || im->name == NULL ||
+				    s >= send)
+					return "malformed import";
+				kind = *s++;
+				im->kind = kind;
+				switch (kind) {
+				case K_FUNC:
+					if (!leb_u32(&s, send, &im->index))
+						return "malformed import";
+					break;
+				case K_TABLE:
+					if (s >= send)
+						return "malformed import";
+					s++;	/* element type */
+					if (!skip_limits(&s, send, &im->index))
+						return "malformed import";
+					break;
+				case K_MEMORY:
+					if (!skip_limits(&s, send, &im->index))
+						return "malformed import";
+					break;
+				case K_GLOBAL:
+					if (send - s < 2)
+						return "malformed import";
+					s += 2;
+					break;
+				default:
+					return "unknown import kind";
+				}
+			}
+		} else if (id == 7) {	/* export */
+			if (!leb_u32(&s, send, &n) || n > 100000)
+				return "malformed export section";
+			m->exps = calloc(n ? n : 1, sizeof(*m->exps));
+			if (m->exps == NULL)
+				return "out of memory";
+			for (i = 0; i < n; i++) {
+				struct wexport *ex = &m->exps[m->nexps];
+				ex->name = read_name(&s, send);
+				m->nexps++;
+				if (ex->name == NULL || s >= send)
+					return "malformed export";
+				ex->kind = *s++;
+				if (ex->kind > K_GLOBAL ||
+				    !leb_u32(&s, send, &ex->index))
+					return "malformed export";
+			}
+		}
+	}
+	return NULL;
+}
+
+/* ---- instances --------------------------------------------------------- */
+
+struct wslot {
+	struct winst *inst;
+	JSValue fn;
+};
+
+struct winst {
+	int refs;		/**< the JS handle + each live ArrayBuffer */
+	JSContext *ctx;
+	uint8_t *bytes;		/**< wasm3 points into these */
+	IM3Environment env;
+	IM3Runtime rt;
+	IM3Module mod;
+	struct wslot *slots;
+	int nslots;
+	JSValue pending;	/**< an import's exception, carried through */
+	bool has_pending;
+	JSValue buf;		/**< the memory's current ArrayBuffer, or undefined */
+	uint8_t *buf_ptr;
+	uint32_t buf_len;
+};
+
+static JSClassID s_mod_class, s_inst_class;
+
+static const char s_trap_js[] = "[trap] JavaScript exception in an import";
+static const char s_trap_stop[] = "[trap] interrupted: stopped by the user";
+static const char s_trap_cap[] = "[trap] interrupted: ran too long";
+
+static void inst_unref(struct winst *in)
+{
+	if (--in->refs > 0)
+		return;
+	if (in->rt != NULL)
+		m3_FreeRuntime(in->rt);	/* frees the loaded module */
+	else if (in->mod != NULL)
+		m3_FreeModule(in->mod);
+	if (in->env != NULL)
+		m3_FreeEnvironment(in->env);
+	free(in->slots);
+	free(in->bytes);
+	free(in);
+}
+
+/* QuickJS calls this when the buffer is detached, and again (with NULL)
+ * when a detached buffer is collected: one reference, released once. */
+static void buf_free_cb(JSRuntime *rt, void *opaque, void *ptr)
+{
+	(void)rt;
+	if (ptr != NULL)
+		inst_unref(opaque);
+}
+
+/** The memory's bytes (NULL, 0 when it has none: wasm3's m3_GetMemory
+ * reads the header without checking). */
+static uint8_t *mem_get(struct winst *in, uint32_t *len)
+{
+	*len = 0;
+	if (in->rt == NULL || in->rt->memory.mallocated == NULL)
+		return NULL;
+	return m3_GetMemory(in->rt, len, 0);
+}
+
+/** If the memory moved or changed size, detach the ArrayBuffer handed out. */
+static void mem_check(struct winst *in)
+{
+	uint32_t len = 0;
+	uint8_t *ptr;
+	if (JS_IsUndefined(in->buf) || in->rt == NULL)
+		return;
+	ptr = mem_get(in, &len);
+	if (ptr == in->buf_ptr && len == in->buf_len)
+		return;
+	JS_DetachArrayBuffer(in->ctx, in->buf);
+	JS_FreeValue(in->ctx, in->buf);
+	in->buf = JS_UNDEFINED;
+}
+
+static void mod_finalizer(JSRuntime *rt, JSValue val)
+{
+	(void)rt;
+	wmod_free(JS_GetOpaque(val, s_mod_class));
+}
+
+static void inst_finalizer(JSRuntime *rt, JSValue val)
+{
+	struct winst *in = JS_GetOpaque(val, s_inst_class);
+	int i;
+	if (in == NULL)
+		return;
+	for (i = 0; i < in->nslots; i++)
+		JS_FreeValueRT(rt, in->slots[i].fn);
+	in->nslots = 0;
+	if (in->has_pending)
+		JS_FreeValueRT(rt, in->pending);
+	in->has_pending = false;
+	if (!JS_IsUndefined(in->buf))
+		JS_FreeValueRT(rt, in->buf);
+	in->buf = JS_UNDEFINED;
+	inst_unref(in);
+}
+
+static void inst_mark(JSRuntime *rt, JSValueConst val, JS_MarkFunc *mark)
+{
+	struct winst *in = JS_GetOpaque(val, s_inst_class);
+	int i;
+	if (in == NULL)
+		return;
+	for (i = 0; i < in->nslots; i++)
+		JS_MarkValue(rt, in->slots[i].fn, mark);
+	if (in->has_pending)
+		JS_MarkValue(rt, in->pending, mark);
+	JS_MarkValue(rt, in->buf, mark);
+}
+
+static JSClassDef s_mod_def = { "WebAssemblyModuleBytes", mod_finalizer,
+	NULL, NULL, NULL };
+static JSClassDef s_inst_def = { "WebAssemblyInstanceHandle", inst_finalizer,
+	inst_mark, NULL, NULL };
+
+/* ---- time: slices, the cap, the script clock --------------------------- */
+
+static int s_depth;		/**< WebAssembly runs (calls in progress) */
+static double s_seg_t0;		/**< when control last entered WebAssembly */
+static double s_call_t0;	/**< when the outermost call began */
+static double s_last_slice;
+static unsigned int s_slices;
+
+/** Control leaves WebAssembly: its time is not the script's. */
+static void seg_leave(void)
+{
+	double now = macos9_micros();
+	macsurf_qjs_pause_script_clock((now - s_seg_t0) / 1000.0);
+	s_seg_t0 = now;
+}
+
+/* wasm3 calls this every WASM_YIELD_EVERY calls and loop iterations
+ * (patches/wasm3/01); it replaces wasm3's weak default. */
+M3Result m3_Yield(void)
+{
+	double now;
+
+	g_m3YieldCountdown = WASM_YIELD_EVERY;
+	if (s_depth == 0)
+		return m3Err_none;
+	now = macos9_micros();
+	if (now - s_last_slice >= WASM_SLICE_MS * 1000.0) {
+		s_slices++;
+		if (macsurf_wasm_slice((unsigned int)((now - s_call_t0) /
+				1000.0)))
+			return s_trap_stop;
+		s_last_slice = macos9_micros();
+	}
+	if (now - s_call_t0 > WASM_CALL_CAP_MS * 1000.0)
+		return s_trap_cap;
+	return m3Err_none;
+}
+
+static void run_begin(void)
+{
+	double now = macos9_micros();
+	if (s_depth == 0) {
+		s_call_t0 = now;
+		s_last_slice = now;
+		s_slices = 0;
+	}
+	s_depth++;
+	s_seg_t0 = now;
+}
+
+static void run_end(void)
+{
+	seg_leave();
+	if (--s_depth == 0) {
+		double ms = (macos9_micros() - s_call_t0) / 1000.0;
+		if (s_slices > 0) {
+			macsurf_wasm_done((unsigned int)ms, s_slices);
+			macsurf_debug_log_writef("LIFE wasm call: %u ms, %u "
+				"frames drawn during it", (unsigned int)ms,
+				s_slices);
+		}
+	}
+}
+
+/* ---- values -------------------------------------------------------------- */
+
+/* wasm3 keeps each value in a 64-bit slot, from its first byte */
+static JSValue from_slot(JSContext *ctx, uint8_t type, const uint64_t *v)
+{
+	int32_t i;
+	int64_t l;
+	float f;
+	double d;
+	switch (type) {
+	case c_m3Type_i32: memcpy(&i, v, 4); return JS_NewInt32(ctx, i);
+	case c_m3Type_i64: memcpy(&l, v, 8); return JS_NewBigInt64(ctx, l);
+	case c_m3Type_f32: memcpy(&f, v, 4); return JS_NewFloat64(ctx, f);
+	case c_m3Type_f64: memcpy(&d, v, 8); return JS_NewFloat64(ctx, d);
+	default: return JS_UNDEFINED;
+	}
+}
+
+/** JS value -> a wasm value in *out; false with a pending JS exception. */
+static bool to_slot(JSContext *ctx, uint8_t type, JSValueConst v,
+		uint64_t *out)
+{
+	*out = 0;
+	switch (type) {
+	case c_m3Type_i32: {
+		int32_t i;
+		if (JS_ToInt32(ctx, &i, v) < 0) return false;
+		memcpy(out, &i, 4);
+		return true;
+	}
+	case c_m3Type_i64: {
+		int64_t i;
+		if (JS_ToBigInt64(ctx, &i, v) < 0) return false;
+		memcpy(out, &i, 8);
+		return true;
+	}
+	case c_m3Type_f32: {
+		double d;
+		float f;
+		if (JS_ToFloat64(ctx, &d, v) < 0) return false;
+		f = (float)d;
+		memcpy(out, &f, 4);
+		return true;
+	}
+	case c_m3Type_f64: {
+		double d;
+		if (JS_ToFloat64(ctx, &d, v) < 0) return false;
+		memcpy(out, &d, 8);
+		return true;
+	}
+	default:
+		return true;
+	}
+}
+
+/** Throw WebAssembly[kind] (RuntimeError, CompileError, LinkError) with a
+ * wasm3 result's text; a plain Error if the namespace is not there. */
+static JSValue throw_result(JSContext *ctx, const char *kind, M3Result r)
+{
+	const char *msg = r;
+	JSValue g, ns, ctor, e, m;
+
+	if (strncmp(msg, "[trap] ", 7) == 0)
+		msg += 7;
+	g = JS_GetGlobalObject(ctx);
+	ns = JS_GetPropertyStr(ctx, g, "WebAssembly");
+	ctor = JS_IsObject(ns) ? JS_GetPropertyStr(ctx, ns, kind) :
+		JS_UNDEFINED;
+	JS_FreeValue(ctx, ns);
+	JS_FreeValue(ctx, g);
+	if (!JS_IsFunction(ctx, ctor)) {
+		JS_FreeValue(ctx, ctor);
+		return JS_ThrowPlainError(ctx, "%s: %s", kind, msg);
+	}
+	m = JS_NewString(ctx, msg);
+	e = JS_CallConstructor(ctx, ctor, 1, (JSValueConst *)&m);
+	JS_FreeValue(ctx, m);
+	JS_FreeValue(ctx, ctor);
+	if (JS_IsException(e))
+		return e;
+	return JS_Throw(ctx, e);
+}
+
+/** "Kind: message" for the JavaScript side to turn into an error. */
+static JSValue error_string(JSContext *ctx, const char *kind, const char *r)
+{
+	char buf[256];
+	snprintf(buf, sizeof(buf), "%s: %s", kind,
+		 strncmp(r, "[trap] ", 7) == 0 ? r + 7 : r);
+	return JS_NewString(ctx, buf);
+}
+
+/* ---- imports: JavaScript called from WebAssembly ----------------------- */
+
+static const void *trampoline(IM3Runtime rt, IM3ImportContext ictx,
+		uint64_t *sp, void *mem)
+{
+	struct wslot *sl = ictx->userdata;
+	struct winst *in = sl->inst;
+	JSContext *ctx = in->ctx;
+	IM3FuncType ft = ictx->function->funcType;
+	JSValue argv[32], r;
+	int i, n = ft->numArgs;
+	bool ok = true;
+
+	(void)rt; (void)mem;
+	if (n > 32)
+		return "[trap] import with more than 32 parameters";
+	seg_leave();
+	mem_check(in);
+	for (i = 0; i < n; i++)
+		argv[i] = from_slot(ctx, ft->types[ft->numRets + i],
+				sp + ft->numRets + i);
+	r = JS_Call(ctx, sl->fn, JS_UNDEFINED, n, (JSValueConst *)argv);
+	for (i = 0; i < n; i++)
+		JS_FreeValue(ctx, argv[i]);
+	if (JS_IsException(r)) {
+		ok = false;
+	} else {
+		if (ft->numRets == 1)
+			ok = to_slot(ctx, ft->types[0], r, sp);
+		JS_FreeValue(ctx, r);
+	}
+	/* back into WebAssembly */
+	s_seg_t0 = macos9_micros();
+	if (!ok) {
+		if (in->has_pending)
+			JS_FreeValue(ctx, in->pending);
+		in->pending = JS_GetException(ctx);
+		in->has_pending = true;
+		return s_trap_js;
+	}
+	return m3Err_none;
+}
+
+/* ---- calls: WebAssembly called from JavaScript ------------------------- */
+
+static IM3Function inst_func(struct winst *in, uint32_t index,
+		M3Result *err)
+{
+	IM3Function f;
+	*err = NULL;
+	if (in->mod == NULL || index >= in->mod->numFunctions) {
+		*err = "no such function";
+		return NULL;
+	}
+	f = &in->mod->functions[index];
+	if (!f->compiled) {
+		if (f->import.moduleUtf8 != NULL) {
+			*err = "calling an imported function directly";
+			return NULL;
+		}
+		*err = CompileFunction(f);
+		if (*err != NULL)
+			return NULL;
+	}
+	return f;
+}
+
+static JSValue func_call(JSContext *ctx, JSValueConst this_val, int argc,
+		JSValueConst *argv, int magic, JSValue *data)
+{
+	struct winst *in = JS_GetOpaque(data[0], s_inst_class);
+	IM3Function f;
+	IM3FuncType ft;
+	uint64_t args[32], rets[8];
+	const void *argp[32], *retp[8];
+	M3Result r;
+	int i;
+
+	(void)this_val;
+	if (in == NULL)
+		return JS_ThrowTypeError(ctx, "WebAssembly instance is gone");
+	f = inst_func(in, (uint32_t)magic, &r);
+	if (f == NULL)
+		return throw_result(ctx, "CompileError", r);
+	ft = f->funcType;
+	if (ft->numArgs > 32 || ft->numRets > 8)
+		return JS_ThrowRangeError(ctx, "too many parameters");
+	for (i = 0; i < ft->numArgs; i++) {
+		if (!to_slot(ctx, ft->types[ft->numRets + i],
+				i < argc ? argv[i] : JS_UNDEFINED, &args[i]))
+			return JS_EXCEPTION;
+		argp[i] = &args[i];
+	}
+	run_begin();
+	r = m3_Call(f, ft->numArgs, argp);
+	run_end();
+	mem_check(in);
+	if (r != NULL) {
+		if (r == s_trap_js && in->has_pending) {
+			JSValue e = in->pending;
+			in->has_pending = false;
+			return JS_Throw(ctx, e);
+		}
+		return throw_result(ctx, "RuntimeError", r);
+	}
+	if (ft->numRets == 0)
+		return JS_UNDEFINED;
+	for (i = 0; i < ft->numRets; i++)
+		retp[i] = &rets[i];
+	r = m3_GetResults(f, ft->numRets, retp);
+	if (r != NULL)
+		return throw_result(ctx, "RuntimeError", r);
+	if (ft->numRets == 1)
+		return from_slot(ctx, ft->types[0], &rets[0]);
+	{
+		JSValue a = JS_NewArray(ctx);
+		for (i = 0; i < ft->numRets; i++)
+			JS_SetPropertyUint32(ctx, a, (uint32_t)i,
+				from_slot(ctx, ft->types[i], &rets[i]));
+		return a;
+	}
+}
+
+/* ---- the natives --------------------------------------------------------- */
+
+static struct winst *inst_of(JSValueConst v)
+{
+	return JS_GetOpaque(v, s_inst_class);
+}
+
+static const char *kind_name(int k)
+{
+	switch (k) {
+	case K_FUNC: return "function";
+	case K_TABLE: return "table";
+	case K_MEMORY: return "memory";
+	default: return "global";
+	}
+}
+
+/* __wasm.parse(bytes) -> [module, imports, exports] or "CompileError: ..." */
+static JSValue js_parse(JSContext *ctx, JSValueConst this_val, int argc,
+		JSValueConst *argv)
+{
+	size_t len = 0, off = 0, bpe = 0;
+	uint8_t *src = NULL;
+	struct wmod *m;
+	const char *err;
+	IM3Environment env;
+	IM3Module tmp = NULL;
+	M3Result r;
+	JSValue h, res, imps, exps;
+	int i;
+
+	(void)this_val;
+	if (argc < 1)
+		return JS_NewString(ctx, "TypeError: no bytes");
+	src = JS_GetArrayBuffer(ctx, &len, argv[0]);
+	if (src == NULL) {
+		JSValue ab;
+		JS_FreeValue(ctx, JS_GetException(ctx));
+		ab = JS_GetTypedArrayBuffer(ctx, argv[0], &off, &len, &bpe);
+		if (JS_IsException(ab)) {
+			JS_FreeValue(ctx, JS_GetException(ctx));
+			return JS_NewString(ctx, "TypeError: WebAssembly needs "
+				"an ArrayBuffer or a typed array of the bytes");
+		}
+		src = JS_GetArrayBuffer(ctx, &bpe, ab);
+		JS_FreeValue(ctx, ab);
+		if (src == NULL)
+			return JS_NewString(ctx, "TypeError: detached buffer");
+		src += off;
+	}
+	if (len < 8 || memcmp(src, "\0asm", 4) != 0)
+		return JS_NewString(ctx, "CompileError: not a WebAssembly "
+			"module (no \\0asm magic)");
+	if (src[4] != 1 || src[5] || src[6] || src[7])
+		return JS_NewString(ctx, "CompileError: unsupported "
+			"WebAssembly version");
+	m = calloc(1, sizeof(*m));
+	if (m == NULL || (m->bytes = malloc(len)) == NULL) {
+		free(m);
+		return JS_ThrowOutOfMemory(ctx);
+	}
+	memcpy(m->bytes, src, len);
+	m->len = len;
+	err = wmod_sections(m);
+	/* wasm3's own parse: the structure, the function types */
+	env = m3_NewEnvironment();
+	if (env == NULL) {
+		wmod_free(m);
+		return JS_ThrowOutOfMemory(ctx);
+	}
+	r = err == NULL ? m3_ParseModule(env, &tmp, m->bytes, (uint32_t)len) :
+		NULL;
+	if (tmp != NULL)
+		m3_FreeModule(tmp);
+	m3_FreeEnvironment(env);
+	if (err != NULL || r != NULL) {
+		JSValue s = error_string(ctx, "CompileError",
+				err != NULL ? err : r);
+		wmod_free(m);
+		return s;
+	}
+	h = JS_NewObjectClass(ctx, (int)s_mod_class);
+	if (JS_IsException(h)) {
+		wmod_free(m);
+		return h;
+	}
+	JS_SetOpaque(h, m);
+	imps = JS_NewArray(ctx);
+	for (i = 0; i < m->nimps; i++) {
+		JSValue o = JS_NewObject(ctx);
+		JS_SetPropertyStr(ctx, o, "module",
+			JS_NewString(ctx, m->imps[i].module));
+		JS_SetPropertyStr(ctx, o, "name",
+			JS_NewString(ctx, m->imps[i].name));
+		JS_SetPropertyStr(ctx, o, "kind",
+			JS_NewString(ctx, kind_name(m->imps[i].kind)));
+		if (m->imps[i].kind == K_MEMORY)
+			JS_SetPropertyStr(ctx, o, "minimum",
+				JS_NewUint32(ctx, m->imps[i].index));
+		JS_SetPropertyUint32(ctx, imps, (uint32_t)i, o);
+	}
+	exps = JS_NewArray(ctx);
+	for (i = 0; i < m->nexps; i++) {
+		JSValue o = JS_NewObject(ctx);
+		JS_SetPropertyStr(ctx, o, "name",
+			JS_NewString(ctx, m->exps[i].name));
+		JS_SetPropertyStr(ctx, o, "kind",
+			JS_NewString(ctx, kind_name(m->exps[i].kind)));
+		JS_SetPropertyStr(ctx, o, "index",
+			JS_NewUint32(ctx, m->exps[i].index));
+		JS_SetPropertyUint32(ctx, exps, (uint32_t)i, o);
+	}
+	res = JS_NewArray(ctx);
+	JS_SetPropertyUint32(ctx, res, 0, h);
+	JS_SetPropertyUint32(ctx, res, 1, imps);
+	JS_SetPropertyUint32(ctx, res, 2, exps);
+	return res;
+}
+
+static char sig_char(uint8_t t)
+{
+	switch (t) {
+	case c_m3Type_i32: return 'i';
+	case c_m3Type_i64: return 'I';
+	case c_m3Type_f32: return 'f';
+	case c_m3Type_f64: return 'F';
+	default: return 'v';
+	}
+}
+
+/* a runtime of our own: environment, runtime (memory sized by the module,
+ * or by the script for newMemory) */
+static struct winst *inst_new(JSContext *ctx, JSValue *h)
+{
+	struct winst *in = calloc(1, sizeof(*in));
+	if (in == NULL)
+		return NULL;
+	in->refs = 1;
+	in->ctx = ctx;
+	in->buf = JS_UNDEFINED;
+	in->pending = JS_UNDEFINED;
+	*h = JS_NewObjectClass(ctx, (int)s_inst_class);
+	if (JS_IsException(*h)) {
+		free(in);
+		return NULL;
+	}
+	JS_SetOpaque(*h, in);	/* from here the finalizer cleans up */
+	in->env = m3_NewEnvironment();
+	if (in->env != NULL)
+		in->rt = m3_NewRuntime(in->env, WASM_STACK_BYTES, in);
+	if (in->rt == NULL) {
+		JS_FreeValue(ctx, *h);
+		return NULL;
+	}
+	return in;
+}
+
+/* __wasm.newMemory(pages, maximum) -> a memory handle (no module yet) */
+static JSValue js_new_memory(JSContext *ctx, JSValueConst this_val,
+		int argc, JSValueConst *argv)
+{
+	uint32_t pages = 0, max = 65536;
+	struct winst *in;
+	JSValue h;
+
+	(void)this_val;
+	if (argc > 0 && JS_ToUint32(ctx, &pages, argv[0]) < 0)
+		return JS_EXCEPTION;
+	if (argc > 1 && !JS_IsUndefined(argv[1]) &&
+	    JS_ToUint32(ctx, &max, argv[1]) < 0)
+		return JS_EXCEPTION;
+	in = inst_new(ctx, &h);
+	if (in == NULL)
+		return JS_ThrowOutOfMemory(ctx);
+	in->rt->memory.maxPages = max ? max : 65536;
+	if (pages > 0 && ResizeMemory(in->rt, pages) != NULL) {
+		JS_FreeValue(ctx, h);
+		return JS_ThrowRangeError(ctx, "WebAssembly.Memory(): could "
+			"not allocate memory");
+	}
+	return h;
+}
+
+/* __wasm.instantiate(module, functions[], memory)
+ *   -> instance handle, or "LinkError: ..." / a thrown RuntimeError */
+static JSValue js_instantiate(JSContext *ctx, JSValueConst this_val,
+		int argc, JSValueConst *argv)
+{
+	struct wmod *m = argc > 0 ? JS_GetOpaque(argv[0], s_mod_class) : NULL;
+	struct winst *mem = argc > 2 ? inst_of(argv[2]) : NULL;
+	struct winst *in;
+	JSValue h;
+	M3Result r;
+	uint32_t k, fi = 0;
+	int i;
+
+	(void)this_val;
+	if (m == NULL || argc < 2)
+		return JS_NewString(ctx, "TypeError: not a WebAssembly.Module");
+	if (mem != NULL) {
+		/* the imported memory's runtime: the module loads into it */
+		if (mem->mod != NULL)
+			return JS_NewString(ctx, "LinkError: a memory in use "
+				"by another instance is not supported");
+		in = mem;
+		h = JS_DupValue(ctx, argv[2]);
+	} else {
+		in = inst_new(ctx, &h);
+		if (in == NULL)
+			return JS_ThrowOutOfMemory(ctx);
+	}
+	in->bytes = malloc(m->len);
+	if (in->bytes == NULL) {
+		JS_FreeValue(ctx, h);
+		return JS_ThrowOutOfMemory(ctx);
+	}
+	memcpy(in->bytes, m->bytes, m->len);
+	r = m3_ParseModule(in->env, &in->mod, in->bytes, (uint32_t)m->len);
+	if (r == NULL) {
+		r = m3_LoadModule(in->rt, in->mod);
+		if (r != NULL)
+			m3_FreeModule(in->mod);
+	}
+	if (r != NULL) {
+		in->mod = NULL;
+		free(in->bytes);
+		in->bytes = NULL;
+		JS_FreeValue(ctx, h);
+		return error_string(ctx, "LinkError", r);
+	}
+	/* function imports -> the JavaScript functions, in import order */
+	in->slots = calloc((size_t)in->mod->numFuncImports + 1,
+			sizeof(*in->slots));
+	if (in->slots == NULL) {
+		JS_FreeValue(ctx, h);
+		return JS_ThrowOutOfMemory(ctx);
+	}
+	for (i = 0; i < m->nimps; i++) {
+		JSValue fn;
+		IM3Function f;
+		char sig[80];
+		size_t p = 0;
+		if (m->imps[i].kind != K_FUNC)
+			continue;
+		if (fi >= in->mod->numFuncImports)
+			break;
+		f = &in->mod->functions[fi];
+		fn = JS_GetPropertyUint32(ctx, argv[1], fi);
+		if (!JS_IsFunction(ctx, fn)) {
+			JS_FreeValue(ctx, fn);
+			JS_FreeValue(ctx, h);
+			return JS_NewString(ctx, "LinkError: an imported "
+				"function is not a function");
+		}
+		in->slots[fi].inst = in;
+		in->slots[fi].fn = fn;
+		in->nslots = (int)fi + 1;
+		sig[p++] = f->funcType->numRets ?
+			sig_char(f->funcType->types[0]) : 'v';
+		sig[p++] = '(';
+		for (k = 0; k < f->funcType->numArgs && p < sizeof(sig) - 2; k++)
+			sig[p++] = sig_char(f->funcType->types[
+					f->funcType->numRets + k]);
+		sig[p++] = ')';
+		sig[p] = '\0';
+		r = m3_LinkRawFunctionEx(in->mod, m->imps[i].module,
+				m->imps[i].name, sig, trampoline,
+				&in->slots[fi]);
+		if (r != NULL && r != m3Err_functionLookupFailed) {
+			JS_FreeValue(ctx, h);
+			return JS_NewString(ctx, "LinkError: an import does "
+				"not match its function type");
+		}
+		fi++;
+	}
+	/* the start function, as a call */
+	run_begin();
+	r = m3_RunStart(in->mod);
+	run_end();
+	if (r != NULL) {
+		JSValue e;
+		if (r == s_trap_js && in->has_pending) {
+			e = in->pending;
+			in->has_pending = false;
+			JS_FreeValue(ctx, h);
+			return JS_Throw(ctx, e);
+		}
+		JS_FreeValue(ctx, h);
+		return throw_result(ctx, "RuntimeError", r);
+	}
+	return h;
+}
+
+/* __wasm.func(instance, index) -> a function calling it */
+static JSValue js_func(JSContext *ctx, JSValueConst this_val, int argc,
+		JSValueConst *argv)
+{
+	struct winst *in = argc > 1 ? inst_of(argv[0]) : NULL;
+	uint32_t idx = 0;
+	IM3Function f;
+	M3Result r;
+	JSValue data[1];
+
+	(void)this_val;
+	if (in == NULL || JS_ToUint32(ctx, &idx, argv[1]) < 0)
+		return JS_NULL;
+	if (in->mod == NULL || idx >= in->mod->numFunctions)
+		return JS_NULL;
+	f = &in->mod->functions[idx];
+	if (idx < in->mod->numFuncImports) {
+		/* an imported function re-exported: the JavaScript function */
+		if ((int)idx < in->nslots)
+			return JS_DupValue(ctx, in->slots[idx].fn);
+		return JS_NULL;
+	}
+	(void)r;
+	data[0] = (JSValue)argv[0];
+	return JS_NewCFunctionData(ctx, func_call, f->funcType->numArgs,
+			(int)idx, 1, data);
+}
+
+/* __wasm.memBuffer(instance) -> ArrayBuffer over the memory */
+static JSValue js_mem_buffer(JSContext *ctx, JSValueConst this_val,
+		int argc, JSValueConst *argv)
+{
+	struct winst *in = argc > 0 ? inst_of(argv[0]) : NULL;
+	uint32_t len = 0;
+	uint8_t *ptr;
+
+	(void)this_val;
+	if (in == NULL || in->rt == NULL)
+		return JS_NULL;
+	mem_check(in);
+	if (!JS_IsUndefined(in->buf))
+		return JS_DupValue(ctx, in->buf);
+	ptr = mem_get(in, &len);
+	if (ptr == NULL) {
+		static uint8_t none[1];
+		ptr = none;
+		len = 0;
+	}
+	in->refs++;	/* released by buf_free_cb */
+	in->buf = JS_NewArrayBuffer(ctx, ptr, len, buf_free_cb, in, false);
+	if (JS_IsException(in->buf)) {
+		in->refs--;
+		in->buf = JS_UNDEFINED;
+		return JS_EXCEPTION;
+	}
+	in->buf_ptr = ptr;
+	in->buf_len = len;
+	return JS_DupValue(ctx, in->buf);
+}
+
+/* __wasm.memGrow(instance, delta) -> the old size in pages, or -1 */
+static JSValue js_mem_grow(JSContext *ctx, JSValueConst this_val, int argc,
+		JSValueConst *argv)
+{
+	struct winst *in = argc > 1 ? inst_of(argv[0]) : NULL;
+	uint32_t delta = 0, old;
+
+	(void)this_val;
+	if (in == NULL || in->rt == NULL ||
+	    JS_ToUint32(ctx, &delta, argv[1]) < 0)
+		return JS_NewInt32(ctx, -1);
+	old = in->rt->memory.numPages;
+	if (delta > 0 && (old + delta < old ||
+	    ResizeMemory(in->rt, old + delta) != NULL))
+		return JS_NewInt32(ctx, -1);
+	mem_check(in);
+	return JS_NewUint32(ctx, old);
+}
+
+static JSValue js_mem_pages(JSContext *ctx, JSValueConst this_val, int argc,
+		JSValueConst *argv)
+{
+	struct winst *in = argc > 0 ? inst_of(argv[0]) : NULL;
+	(void)this_val;
+	if (in == NULL || in->rt == NULL)
+		return JS_NewInt32(ctx, 0);
+	return JS_NewUint32(ctx, in->rt->memory.numPages);
+}
+
+static IM3Global global_at(JSValueConst h, JSContext *ctx, JSValueConst iv)
+{
+	struct winst *in = inst_of(h);
+	uint32_t idx = 0;
+	if (in == NULL || in->mod == NULL || JS_ToUint32(ctx, &idx, iv) < 0 ||
+	    idx >= in->mod->numGlobals)
+		return NULL;
+	return &in->mod->globals[idx];
+}
+
+/* __wasm.globalGet(instance, index) */
+static JSValue js_global_get(JSContext *ctx, JSValueConst this_val,
+		int argc, JSValueConst *argv)
+{
+	IM3Global g = argc > 1 ? global_at(argv[0], ctx, argv[1]) : NULL;
+	(void)this_val;
+	if (g == NULL)
+		return JS_UNDEFINED;
+	{
+		uint64_t v;
+		if (g->type == c_m3Type_f32)
+			memcpy(&v, &g->f32Value, 4);
+		else
+			memcpy(&v, &g->intValue, 8);
+		return from_slot(ctx, g->type, &v);
+	}
+}
+
+/* __wasm.globalSet(instance, index, value) */
+static JSValue js_global_set(JSContext *ctx, JSValueConst this_val,
+		int argc, JSValueConst *argv)
+{
+	IM3Global g = argc > 2 ? global_at(argv[0], ctx, argv[1]) : NULL;
+	uint64_t v;
+	(void)this_val;
+	if (g == NULL)
+		return JS_UNDEFINED;
+	if (!g->isMutable)
+		return JS_ThrowTypeError(ctx, "can't set the value of an "
+			"immutable global");
+	if (!to_slot(ctx, g->type, argv[2], &v))
+		return JS_EXCEPTION;
+	if (g->type == c_m3Type_f32)
+		memcpy(&g->f32Value, &v, 4);
+	else if (g->type == c_m3Type_i32)
+		g->intValue = (int32_t)(uint32_t)v;
+	else
+		memcpy(&g->intValue, &v, sizeof(v));
+	return JS_UNDEFINED;
+}
+
+/* __wasm.globalType(instance, index) -> "i32" / "i64" / "f32" / "f64" */
+static JSValue js_global_type(JSContext *ctx, JSValueConst this_val,
+		int argc, JSValueConst *argv)
+{
+	IM3Global g = argc > 1 ? global_at(argv[0], ctx, argv[1]) : NULL;
+	static const char *const names[] = { "", "i32", "i64", "f32", "f64" };
+	(void)this_val;
+	if (g == NULL || g->type > 4)
+		return JS_UNDEFINED;
+	return JS_NewString(ctx, names[g->type]);
+}
+
+/* __wasm.tableLength(instance), tableGet(instance, i) -> function index
+ * or -1 */
+static JSValue js_table_length(JSContext *ctx, JSValueConst this_val,
+		int argc, JSValueConst *argv)
+{
+	struct winst *in = argc > 0 ? inst_of(argv[0]) : NULL;
+	(void)this_val;
+	if (in == NULL || in->mod == NULL)
+		return JS_NewInt32(ctx, 0);
+	return JS_NewUint32(ctx, in->mod->table0Size);
+}
+
+static JSValue js_table_get(JSContext *ctx, JSValueConst this_val, int argc,
+		JSValueConst *argv)
+{
+	struct winst *in = argc > 1 ? inst_of(argv[0]) : NULL;
+	uint32_t i = 0;
+	IM3Function f;
+	(void)this_val;
+	if (in == NULL || in->mod == NULL || JS_ToUint32(ctx, &i, argv[1]) < 0)
+		return JS_NewInt32(ctx, -1);
+	if (i >= in->mod->table0Size || in->mod->table0 == NULL)
+		return JS_ThrowRangeError(ctx, "table index out of bounds");
+	f = in->mod->table0[i];
+	if (f == NULL)
+		return JS_NewInt32(ctx, -1);
+	return JS_NewUint32(ctx, (uint32_t)(f - in->mod->functions));
+}
+
+/* __wasm.detach(arrayBuffer): an imported memory's old buffer, adopted */
+static JSValue js_detach(JSContext *ctx, JSValueConst this_val, int argc,
+		JSValueConst *argv)
+{
+	(void)this_val;
+	if (argc > 0 && JS_IsArrayBuffer(argv[0]))
+		JS_DetachArrayBuffer(ctx, argv[0]);
+	return JS_UNDEFINED;
+}
+
+/* exported interface documented in macsurf_wasm.h */
+void macsurf_wasm_init_class(JSRuntime *rt)
+{
+	s_mod_class = 0;
+	JS_NewClassID(rt, &s_mod_class);
+	JS_NewClass(rt, s_mod_class, &s_mod_def);
+	s_inst_class = 0;
+	JS_NewClassID(rt, &s_inst_class);
+	JS_NewClass(rt, s_inst_class, &s_inst_def);
+}
+
+/* exported interface documented in macsurf_wasm.h */
+void macsurf_wasm_install(JSContext *ctx, JSValueConst global)
+{
+	static const struct {
+		const char *name;
+		JSCFunction *fn;
+		int n;
+	} fns[] = {
+		{ "parse", js_parse, 1 },
+		{ "newMemory", js_new_memory, 2 },
+		{ "instantiate", js_instantiate, 3 },
+		{ "func", js_func, 2 },
+		{ "memBuffer", js_mem_buffer, 1 },
+		{ "memGrow", js_mem_grow, 2 },
+		{ "memPages", js_mem_pages, 1 },
+		{ "globalGet", js_global_get, 2 },
+		{ "globalSet", js_global_set, 3 },
+		{ "globalType", js_global_type, 2 },
+		{ "tableLength", js_table_length, 1 },
+		{ "tableGet", js_table_get, 2 },
+		{ "detach", js_detach, 1 },
+	};
+	JSValue o = JS_NewObject(ctx);
+	size_t i;
+
+	for (i = 0; i < sizeof(fns) / sizeof(fns[0]); i++)
+		JS_SetPropertyStr(ctx, o, fns[i].name,
+			JS_NewCFunction(ctx, fns[i].fn, fns[i].name, fns[i].n));
+	JS_SetPropertyStr(ctx, global, "__wasm", o);
+}
+
+#endif
diff --git a/content/handlers/javascript/quickjs/macsurf_wasm.h b/content/handlers/javascript/quickjs/macsurf_wasm.h
new file mode 100644
--- /dev/null
+++ b/content/handlers/javascript/quickjs/macsurf_wasm.h
@@ -0,0 +1,31 @@
+/*
+ * VitaBrowser patch 254: WebAssembly.
+ *
+ * wasm3 (tools/fetch-wasm3.sh, an interpreter in portable C) behind the
+ * natives of the hidden global `__wasm`; the WebAssembly namespace itself
+ * -- Module, Instance, Memory, Table, Global, the errors, validate /
+ * compile / instantiate -- is JavaScript, in vita_polyfill.js.
+ *
+ * A long call is sliced: wasm3 calls m3_Yield every few thousand calls and
+ * loop iterations (patches/wasm3/01), and every WASM_SLICE_MS of it the
+ * frontend draws a frame (macsurf_wasm_slice), which may stop the call.
+ * Time inside WebAssembly does not count against the script's runaway
+ * deadline.
+ */
+
+#ifndef MACSURF_WASM_H
+#define MACSURF_WASM_H
+
+#ifdef WITH_QUICKJS
+
+#include "quickjs.h"
+
+/** Register the handle classes with a runtime (once per runtime). */
+void macsurf_wasm_init_class(JSRuntime *rt);
+
+/** Install `__wasm` on a realm's global object. */
+void macsurf_wasm_install(JSContext *ctx, JSValueConst global);
+
+#endif
+
+#endif
