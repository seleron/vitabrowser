+/* "Content-Type:" in any case (without <strings.h>, as above) */
+static int
+xhr_is_content_type(const char *h)
+{
+	static const char want[] = "content-type:";
+	size_t i;
+
+	for (i = 0; i < sizeof(want) - 1; i++) {
+		char c = h[i];
+		if (c >= 'A' && c <= 'Z')
+			c += 'a' - 'A';
+		if (c != want[i])
+			return 0;
+	}
+	return 1;
+}
