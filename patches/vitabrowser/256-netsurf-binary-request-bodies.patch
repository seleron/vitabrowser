+/* VitaBrowser patch 256: the request body as bytes. An ArrayBuffer, a
+ * typed array or a Blob is copied as it is (hCaptcha's getcaptcha is a
+ * msgpack body full of NULs; it was sent as "146,218,2,..." and answered
+ * 415); anything else is its string, as before. 0 on success (s->body is
+ * NULL for no body), -1 out of memory or a throwing toString. */
+static int
+xhr_take_body(JSContext *ctx, JSValueConst v, struct qjs_xhr_slot *s)
+{
+	const uint8_t *bytes = NULL;
+	size_t len = 0;
+	const char *type;
+	const char *str;
+	JSValue buf = JS_UNDEFINED;
+
+	if (JS_IsNull(v) || JS_IsUndefined(v))
+		return 0;
+	if (JS_IsArrayBuffer(v)) {
+		bytes = JS_GetArrayBuffer(ctx, &len, v);
+	} else if (JS_GetTypedArrayType(v) >= 0) {
+		size_t off = 0, n = 0, per = 0;
+		buf = JS_GetTypedArrayBuffer(ctx, v, &off, &n, &per);
+		if (JS_IsException(buf))
+			return -1;
+		bytes = JS_GetArrayBuffer(ctx, &len, buf);
+		if (bytes != NULL && off + n <= len) {
+			bytes += off;
+			len = n;
+		} else {
+			bytes = NULL;
+			len = 0;
+		}
+	} else if (!macsurf_qjs_blob_bytes(v, &bytes, &len, &type)) {
+		str = JS_ToCStringLen(ctx, &len, v);
+		if (str == NULL)
+			return -1;
+		s->body = (char *) malloc(len + 1);
+		if (s->body != NULL) {
+			memcpy(s->body, str, len + 1);
+			s->body_len = (long) len;
+			/* a NUL inside a string would cut it short too */
+			s->body_bin = memchr(str, 0, len) != NULL;
+		}
+		JS_FreeCString(ctx, str);
+		return s->body != NULL ? 0 : -1;
+	}
+	s->body = (char *) malloc(len + 1);
+	if (s->body != NULL) {
+		if (len != 0 && bytes != NULL)
+			memcpy(s->body, bytes, len);
+		s->body[len] = '\0';
+		s->body_len = (long) len;
+		s->body_bin = 1;
+	}
+	JS_FreeValue(ctx, buf);
+	return s->body != NULL ? 0 : -1;
+}
