# netsurf: FormData sends files -- a Blob/File entry's bytes go in the
# multipart body (patch 257)
# Generated 2026-10-12
# Base: seleron/vitabrowser (patch stack through 256)
#
# A script's file upload -- FormData with a Blob or File, sent by
# XMLHttpRequest or fetch() -- sent every file as an empty part: the
# multipart encoder (XMLHttpRequest.prototype._encodeFormData) built one
# string and wrote '' where a file's content belonged, because the request
# layer could only send text. Patch 256 taught it to send a Blob's bytes,
# so the body is now a Blob of the parts: headers and text values as UTF-8,
# each file's own bytes. As in a browser (Chromium checked):
#
#  - FormData.append / set store a Blob as a File named by the filename
#    argument, else the File's own name, else "blob"; any other value as
#    its string (objects were kept as they were);
#  - names and filenames escape '"' CR LF as %22 %0D %0A; text values'
#    line breaks become CRLF;
#  - fetch() sends the same Blob (extractBody), with the multipart type.
#
# Not touched: <form enctype="multipart/form-data"> submitted without
# script (the engine's own form path; the Vita has no file picker), and
# Response.formData() still parses url-encoded bodies only.
#
# Gate: testpages/pages/JS-fetch-body.html checks 13-17 (file bytes by XHR
# and by fetch, the stored File, string values, UTF-8 / CRLF / escaped
# names), 17/17 over http and https (Chromium 17/17; run 34's build
# 12/17).
diff --git a/content/handlers/javascript/quickjs/macsurf_qjs.c b/content/handlers/javascript/quickjs/macsurf_qjs.c
--- a/content/handlers/javascript/quickjs/macsurf_qjs.c
+++ b/content/handlers/javascript/quickjs/macsurf_qjs.c
@@ -14045,11 +14045,13 @@
 
 	/* --- FormData ---
 	 * Ordered [key,value,filename] triples, not a spec-perfect Map --
-	 * enough for a script that constructs/populates/reads text entries.
-	 * Blob has byte semantics; File remains absent. The current request
-	 * transport does not yet submit a Blob FormData body. Callers may still
-	 * supply an arbitrary value and its optional filename. Iteration order
-	 * matches insertion order (spec). */
+	 * enough for a script that constructs/populates/reads entries.
+	 * Iteration order matches insertion order (spec).
+	 * VitaBrowser patch 257: as the spec has it, a Blob value is stored as
+	 * a File named by the filename argument, else its own name, else
+	 * "blob" (File is the polyfill's: a Blob with name/lastModified), and
+	 * any other value as its string; XMLHttpRequest.prototype.
+	 * _encodeFormData sends a File's bytes. */
 	macsurf_qjs__safe_eval(ctx,
 		"function FormData(form){"
 			"this._k=[];this._v=[];this._f=[];"
@@ -14067,9 +14069,18 @@
 			"}"
 		"}"
 		"FormData.prototype.append=function(k,v,fn){"
+			"var isB=typeof Blob==='function'&&v instanceof Blob;"
+			"if(isB){"
+				"var nm=fn!==undefined?String(fn):"
+					"(typeof v.name==='string'?v.name:'blob');"
+				"if((v.name!==nm||fn!==undefined)&&typeof File==='function')"
+					"v=new File([v],nm,{type:v.type,"
+						"lastModified:v.lastModified});"
+				"fn=nm;"
+			"}"
 			"this._k.push(String(k));"
-			"this._v.push((v&&typeof v==='object')?v:String(v));"
-			"this._f.push(fn);};"
+			"this._v.push(isB?v:String(v));"
+			"this._f.push(isB?fn:undefined);};"
 		"FormData.prototype.get=function(k){"
 			"for(var i=0;i<this._k.length;i++)"
 				"if(this._k[i]==k)return this._v[i];"
@@ -14244,30 +14255,36 @@
 			"this._fire('readystatechange');"
 			"this._fire('progress',received);"
 		"};"
-		/* FormData bodies are not native-fetch-layer aware -- __xhrNativeSend
