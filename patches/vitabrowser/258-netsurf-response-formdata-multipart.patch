# netsurf: Response.formData() reads multipart/form-data bodies (patch 258)
# Generated 2026-10-12
# Base: seleron/vitabrowser (patch stack through 257)
#
# Response.formData() rejected anything but an url-encoded body
# ("formData() supports url-encoded bodies only"), so a multipart body --
# from a server, or a FormData put through a Response -- could not be
# read. It is parsed now, the way
# Chromium reads one (checked case by case):
#
#  - the boundary from the Content-Type, quoted or not (none: TypeError
#    "Invalid MIME type"); preamble and epilogue skipped; header names in
#    any case;
#  - a part with a filename becomes a File (type text/plain unless the
#    part has one; an empty filename is still a File), any other part a
#    string decoded as UTF-8 (its Content-Type ignored); names and
#    filenames are UTF-8 and not unescaped (%22 stays);
#  - a malformed body rejects with TypeError: no closing delimiter, a part
#    whose disposition is not form-data or has no name. Other types reject
#    too ("Failed to fetch", as Chromium says).
#
# Request still has no body methods (text / json / formData ...).
#
# Gate: testpages/pages/JS-fetch-body.html checks 18-22 (a FormData with a
# binary file through a Response and back, Chromium's edge cases, UTF-8,
# five malformed bodies, url-encoded still), 22/22 over http and https
# (Chromium 22/22; the build before stops at check 18).
diff --git a/content/handlers/javascript/quickjs/vita_polyfill.js b/content/handlers/javascript/quickjs/vita_polyfill.js
--- a/content/handlers/javascript/quickjs/vita_polyfill.js
+++ b/content/handlers/javascript/quickjs/vita_polyfill.js
@@ -1156,10 +1156,78 @@
 	if (!isFn(g.Blob)) return Promise.reject(new TypeError('Blob is not supported'));
 	return this.bytes().then(function (u) { return new g.Blob([u], { type: type }); });
 };
+/* VitaBrowser patch 258: a multipart/form-data body into a FormData, as
+ * Chromium reads it: preamble and epilogue skipped, header names in any
+ * case, a part with a filename becomes a File (type text/plain unless the
+ * part says otherwise; a filename may be empty), any other part a UTF-8
+ * string; names and filenames are UTF-8 and not unescaped. null when the
+ * body is malformed: no closing delimiter, a part that is not
+ * "form-data" or has no name. u is the body's bytes. */
+function multipartParam(v, key) {
+	var m = new RegExp('(?:^|;)\\s*' + key + '\\s*=\\s*(?:"([^"]*)"|([^;\\s]*))', 'i').exec(v);
+	return m ? (m[1] !== undefined ? m[1] : m[2]) : null;
+}
+function latin1Utf8(t) {
+	var b = new Uint8Array(t.length);
+	for (var i = 0; i < t.length; i++) b[i] = t.charCodeAt(i);
+	return new g.TextDecoder().decode(b);
+}
+function multipartParse(u, boundary) {
+	/* one char per byte, to search in */
+	var s = '', i;
+	for (i = 0; i < u.length; i += 8192)
+		s += String.fromCharCode.apply(null, u.subarray(i, i + 8192));
+	var dl = '--' + boundary, fd = new g.FormData(), pos = s.indexOf(dl);
+	if (pos < 0) return null;
+	pos += dl.length;
+	for (;;) {
+		if (s.substr(pos, 2) === '--') return fd;
+		if (s.substr(pos, 2) !== '\r\n') return null;
+		pos += 2;
+		var he = s.indexOf('\r\n\r\n', pos);
+		if (he < 0) return null;
+		var lines = s.slice(pos, he).split('\r\n'), name = null, fname = null, type = '';
+		for (i = 0; i < lines.length; i++) {
+			var c = lines[i].indexOf(':');
+			if (c < 0) continue;
+			var k = lines[i].slice(0, c).replace(/^\s+|\s+$/g, '').toLowerCase();
+			var v = lines[i].slice(c + 1).replace(/^\s+|\s+$/g, '');
+			if (k === 'content-disposition') {
+				if (!/^form-data\s*(;|$)/i.test(v)) return null;
+				name = multipartParam(v, 'name');
+				fname = multipartParam(v, 'filename');
+			} else if (k === 'content-type') {
+				type = v;
+			}
+		}
+		if (name === null) return null;
+		var de = s.indexOf('\r\n' + dl, he + 4);
+		if (de < 0) return null;
+		var data = u.subarray(he + 4, de);
+		if (fname !== null)
+			fd.append(latin1Utf8(name), new g.File([data], latin1Utf8(fname),
+				{ type: type || 'text/plain' }));
+		else
+			fd.append(latin1Utf8(name), new g.TextDecoder().decode(data));
+		pos = de + 2 + dl.length;
+	}
+}
 Resp.prototype.formData = function () {
-	var type = (this._headers.get('content-type') || '').toLowerCase();
-	if (!isFn(g.FormData) || type.indexOf('application/x-www-form-urlencoded') !== 0)
-		return Promise.reject(new TypeError('formData() supports url-encoded bodies only'));
+	var ct = this._headers.get('content-type') || '', type = ct.toLowerCase();
+	if (!isFn(g.FormData))
+		return Promise.reject(new TypeError('FormData is not supported'));
+	if (type.indexOf('multipart/form-data') === 0) {
+		var boundary = multipartParam(ct, 'boundary');
+		if (!boundary)
+			return Promise.reject(new TypeError('Invalid MIME type'));
+		return this.bytes().then(function (u) {
+			var fd = multipartParse(u, boundary);
+			if (!fd) throw new TypeError('Failed to fetch');
+			return fd;
+		});
+	}
+	if (type.indexOf('application/x-www-form-urlencoded') !== 0)
+		return Promise.reject(new TypeError('Failed to fetch'));
 	return this.text().then(function (t) {
 		var fd = new g.FormData(), q = new g.URLSearchParams(t);
 		q.forEach(function (v, k) { fd.append(k, v); });
