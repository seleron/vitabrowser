# netsurf: a blank iframe a script makes is a realm of its own (patch 260)
# Generated 2026-10-13
# Base: seleron/vitabrowser (patch stack through 259)
#
# Stack Overflow (and claude.ai, at times) sit behind Cloudflare's
# "Just a moment..." challenge, which never cleared here: its script
# evaluates its decoded program through a script-made blank iframe and
# enumerates one frame's globals. Patch 143 gave such a frame a stand-in
# window -- Object.create(the page's window) with the page's eval -- so
# the program ran in the page's realm, `this` was not the frame's window,
# its location was the page's, its document unfinished, and the frame kept
# a window after removal. Given that same stand-in, Chromium never passes
# the challenge either.
#
#  - quickjs/macsurf_qjs.c: __vitaNewRealm() -- a new context in the page's
#    runtime with the standard intrinsics (its own Object, Array, Function,
#    eval ...), returned as its global object. The context is a GC object:
#    it lives while anything of it does.
#  - vita_polyfill.js: localWindow() builds the frame's window on such a
#    realm, with the page's browser APIs on it (functions as they are,
#    accessors read through the page), location about:blank, a detached
#    document whose readyState is "complete", parent / top / frameElement;
#    contentWindow and contentDocument are null once the frame is out of
#    the document. Without the native, the old stand-in.
#
# Google's BotGuard (patch 143's reason) still evaluates into the frame:
# the frame's eval is now the frame realm's own.
#
# Gate: testpages/pages/JS-frame-realm.html (REALM, with 261 and 262)
# checks 1-5, Chromium 11/11; the build before 1/11.
diff --git a/content/handlers/javascript/quickjs/macsurf_qjs.c b/content/handlers/javascript/quickjs/macsurf_qjs.c
--- a/content/handlers/javascript/quickjs/macsurf_qjs.c
+++ b/content/handlers/javascript/quickjs/macsurf_qjs.c
@@ -1113,6 +1113,41 @@
  * pure-JS versions in the polyfill string. */
 
 /* ------------------------------------------------------------------ */
+/* VitaBrowser patch 260: a realm for a blank script-made iframe        */
+/* ------------------------------------------------------------------ */
+
+/* __vitaNewRealm(): the global object of a new realm in this runtime --
+ * its own Object, Array, Function, eval, ... -- for vita_polyfill.js to
+ * make into a frame's window (it adds the browser APIs). The context is
+ * a GC object: it lives while anything of it does (its global, its
+ * functions), so this reference is dropped at once. */
+static JSValue qjs_new_realm(JSContext *ctx, JSValueConst this_val,
+		int argc, JSValueConst *argv)
+{
+	JSContext *sub;
+	JSValue global;
+
+	(void)this_val; (void)argc; (void)argv;
+	sub = JS_NewContextRaw(JS_GetRuntime(ctx));
+	if (sub == NULL)
+		return JS_ThrowOutOfMemory(ctx);
+	JS_AddIntrinsicBaseObjects(sub);
+	JS_AddIntrinsicDate(sub);
+	JS_AddIntrinsicEval(sub);
+	JS_AddIntrinsicRegExp(sub);
+	JS_AddIntrinsicJSON(sub);
+	JS_AddIntrinsicProxy(sub);
+	JS_AddIntrinsicMapSet(sub);
+	JS_AddIntrinsicTypedArrays(sub);
+	JS_AddIntrinsicPromise(sub);
+	JS_AddIntrinsicWeakRef(sub);
+	JS_AddIntrinsicAToB(sub);
+	global = JS_GetGlobalObject(sub);
+	JS_FreeContext(sub);
+	return global;
+}
+
+/* ------------------------------------------------------------------ */
 /* monotonic clock for performance.now()                               */
 /* ------------------------------------------------------------------ */
 
@@ -12926,6 +12961,7 @@
 
 	/* --- monotonic clock for performance.now() --- */
 	qjs_set_func(ctx, global, "__macsurf_monotonic_ms", qjs_monotonic_ms, 0);
+	qjs_set_func(ctx, global, "__vitaNewRealm", qjs_new_realm, 0); /* 260 */
 	qjs_set_func(ctx, global, "__canvasMeasureText",
 			qjs_canvas_measure_text_width, 2); /* fixes1245 */
 
