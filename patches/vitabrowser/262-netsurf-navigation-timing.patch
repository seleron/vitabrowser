+			setTimeout(function () { mark('loadEnd'); }, 0);
+		});
+	} catch (e) { /* */ }
+	var NavTiming = function PerformanceNavigationTiming() {
+		throw new TypeError('Illegal constructor');
+	};
+	var NP = NavTiming.prototype;
+	var fields = {
+		name: function () { return String(g.location && g.location.href); },
+		entryType: function () { return 'navigation'; },
+		startTime: function () { return 0; },
