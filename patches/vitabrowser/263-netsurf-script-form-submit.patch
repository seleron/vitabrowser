# netsurf: a script submits a form -- submit(), requestSubmit(), a submit
# button's click() (patch 263)
# Generated 2026-10-13
# Base: seleron/vitabrowser (patch stack through 262)
#
# Element click() fired the click event and nothing else ("deliberately
# does NOT perform the default action"), and form.submit() and
# requestSubmit() went through a click on a submit control: no script
# could submit a form. Cloudflare's challenge ends by building a form and
# clicking its hidden submit button; Stack Overflow never cleared.
#
#  - quickjs/macsurf_qjs.c: __vitaSubmitForm(form, submitter) -- the
#    engine's own submission (form_submit: encoding, method, target), run
#    from the main loop; it waits while the page is not yet shown (an
#    inline script submitting during the parse) and gives up if the page
#    has gone. A form made after the parse gets its record
#    (html_forms_form_for_node), and its action is resolved against the
#    document's base (form_submit takes an absolute URL).
#  - vita_polyfill.js: click() fires the click event and, unless it was
#    cancelled, a submit button's (button / input type submit or image)
#    activation behaviour: its form's requestSubmit(button) -- the submit
#    event, then the submission. form.submit() submits with no event.
#
# The fields a script appended reach the request with patch 265 (libdom).
#
# Gate: testpages/pages/JS-form-submit.html -- three pre-checks, then the
# hidden-button submission; the gate httpd's /echo answers with the body,
# "res=passed3of3&ev=fired&k=v+1" (Chromium: the same).
diff --git a/content/handlers/javascript/quickjs/macsurf_qjs.c b/content/handlers/javascript/quickjs/macsurf_qjs.c
--- a/content/handlers/javascript/quickjs/macsurf_qjs.c
+++ b/content/handlers/javascript/quickjs/macsurf_qjs.c
@@ -42,6 +42,7 @@
 #include "netsurf/layout.h"
 #include "content/handlers/html/private.h"
 #include <nsutils/time.h>	/* patch 262: navigation start */
+#include "content/handlers/html/form_internal.h"	/* patch 263: form_submit */
 #include "content/handlers/html/html.h"	/* patch 250: html_image_* */
 /* fixes1011 (Phase 3) - the box tree, for the layout metrics. box.h defines
  * struct box and the LEFT/RIGHT/TOP/BOTTOM edge indices; box_inspect.h has
@@ -12073,6 +12074,117 @@
 	}
 }
 
+/* VitaBrowser patch 263: a script submits a form.
+ *
+ * __vitaSubmitForm(form, submitter) -- the engine's own submission (field
+ * encoding, method, enctype, target) of a form element, as a click on a
+ * submit control does, for vita_polyfill.js's form.submit(),
+ * requestSubmit() and a submit button's click(). It runs from the main
+ * loop, not inside the script: the page's realm must still be the same
+ * then, or nothing happens. A form a script made after the page was
+ * parsed gets its record here (html_forms_form_for_node). */
+struct qjs_pending_submit {
+	JSContext *ctx;
+	unsigned long gen;
+	struct content *content;
+	dom_node *form;
+	dom_node *submitter;	/* or NULL */
+	int tries;		/* passes waited for the page to be shown */
+};
+
+static void qjs_submit_form_cb(void *p)
+{
+	struct qjs_pending_submit *ps = p;
+	struct qjs_realm_owner *owner = qjs_owner_for_ctx(ps->ctx);
+	html_content *html;
+	struct form *form;
+	struct form_control *ctl = NULL;
+	struct browser_window *target;
+	nserror res;
+
+	if (owner == NULL || owner->content != ps->content ||
+	    qjs_ctx_gen(ps->ctx) != ps->gen || ps->content == NULL ||
+	    ps->content->handler == NULL ||
+	    ps->content->handler->type() != CONTENT_HTML) {
+		macsurf_debug_log_writef("LIFE js submit: page gone, dropped");
+		goto out;
+	}
+	html = (html_content *)ps->content;
+	/* A script that submits while the page is still parsing (an inline
+	 * script) runs before the page has its window: wait for it, a few
+	 * seconds at most, as a browser submits once it can navigate. */
+	if (html->bw == NULL || html->encoding == NULL) {
+		if (++ps->tries <= 100) {
+			macos9_schedule(100, qjs_submit_form_cb, ps);
+			return;
+		}
+		macsurf_debug_log_writef("LIFE js submit: page never shown, dropped");
+		goto out;
+	}
+	form = html_forms_form_for_node(&html->forms, html->encoding,
+			ps->form);
+	if (form == NULL) {
+		macsurf_debug_log_writef("LIFE js submit: no form record");
+		goto out;
+	}
+	if (ps->submitter != NULL) {
+		ctl = html_forms_get_control_for_node(html->forms,
+				ps->submitter);
+		if (ctl != NULL && ctl->form == NULL)
+			ctl->form = form;
+	}
+	/* form_submit takes the action as an absolute URL: resolve it
+	 * against the document's base (an empty action is the document) */
+	{
+		nsurl *base = html->base_url != NULL ? html->base_url :
+				content_get_url(ps->content), *abs = NULL;
+		const char *a = form->action != NULL ? form->action : "";
+		if (base != NULL && nsurl_join(base, a[0] != '\0' ? a :
+				nsurl_access(content_get_url(ps->content)),
+				&abs) == NSERROR_OK) {
+			char *dup = strdup(nsurl_access(abs));
+			if (dup != NULL) {
+				free(form->action);
+				form->action = dup;
+			}
+			nsurl_unref(abs);
+		}
+	}
+	target = browser_window_find_target(html->bw, form->target, 0);
+	res = form_submit(content_get_url(ps->content), target, form, ctl);
+	macsurf_debug_log_writef("LIFE js submit: form_submit -> %d", (int)res);
+out:
+	dom_node_unref(ps->form);
+	if (ps->submitter != NULL)
+		dom_node_unref(ps->submitter);
+	free(ps);
+}
+
+static JSValue qjs_submit_form(JSContext *ctx, JSValueConst this_val,
+		int argc, JSValueConst *argv)
+{
+	struct qjs_realm_owner *owner = qjs_owner_for_ctx(ctx);
+	struct qjs_pending_submit *ps;
+	dom_node *form, *sub = NULL;
+
+	(void)this_val;
+	if (argc < 1 || owner == NULL || owner->content == NULL ||
+	    (form = qjs_get_node(argv[0])) == NULL)
+		return JS_FALSE;
+	if (argc > 1 && JS_IsObject(argv[1]))
+		sub = qjs_get_node(argv[1]);
+	ps = calloc(1, sizeof(*ps));
+	if (ps == NULL)
+		return JS_FALSE;
+	ps->ctx = ctx;
+	ps->gen = qjs_ctx_gen(ctx);
+	ps->content = owner->content;
+	ps->form = dom_node_ref(form);
+	ps->submitter = sub != NULL ? dom_node_ref(sub) : NULL;
+	macos9_schedule(0, qjs_submit_form_cb, ps);
+	return JS_TRUE;
+}
+
 static void qjs_dom_install(JSContext *ctx)
 {
 	JSValue global = JS_GetGlobalObject(ctx);
@@ -12995,6 +13107,7 @@
 	/* --- monotonic clock for performance.now() --- */
 	qjs_set_func(ctx, global, "__macsurf_monotonic_ms", qjs_monotonic_ms, 0);
 	qjs_set_func(ctx, global, "__vitaNewRealm", qjs_new_realm, 0); /* 260 */
+	qjs_set_func(ctx, global, "__vitaSubmitForm", qjs_submit_form, 2); /* 263 */
 	qjs_set_func(ctx, global, "__canvasMeasureText",
 			qjs_canvas_measure_text_width, 2); /* fixes1245 */
 
