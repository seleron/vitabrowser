+	/* click(): the click event, then -- unless it was cancelled -- a
+	 * submit button's activation behaviour, submitting its form through
+	 * requestSubmit (so the form's submit event fires first). */
+	(function () {
+		var o = d.createElement('button'), owner = null;
+		while (o && !owner) {
+			if (Object.prototype.hasOwnProperty.call(o, 'click')) owner = o;
+			o = Object.getPrototypeOf(o);
+		}
+		if (!owner) return;
+		function formOf(el) {
+			var f = null;
+			try { f = el.form; } catch (e) { /* */ }
+			if (f && f.tagName && String(f.tagName).toUpperCase() === 'FORM') return f;
+			try { return el.closest ? el.closest('form') : null; } catch (e) { return null; }
+		}
+		function isSubmitter(el) {
+			var tag = String(el.tagName || '').toUpperCase(), t;
+			if (el.hasAttribute && el.hasAttribute('disabled')) return false;
+			t = String((el.getAttribute && el.getAttribute('type')) || '').toLowerCase();
+			if (tag === 'BUTTON') return t === '' || t === 'submit' || (t !== 'button' && t !== 'reset');
+			if (tag === 'INPUT') return t === 'submit' || t === 'image';
+			return false;
+		}
+		define(owner, 'click', function click() {
+			var ev, f;
+			try { ev = new g.MouseEvent('click', { bubbles: true, cancelable: true, view: g }); }
+			catch (e) { ev = new Event('click', { bubbles: true, cancelable: true }); }
+			var go = this.dispatchEvent ? this.dispatchEvent(ev) : true;
+			if (go === false || ev.defaultPrevented || !isSubmitter(this)) return;
+			f = formOf(this);
+			if (f && isFn(f.requestSubmit)) f.requestSubmit(this);
+		});
+	})();
 	acc(F, 'elements', function () { return this.querySelectorAll('input,select,textarea,button,fieldset,output,object'); });
 	/* text nodes */
