# libdom: a form control's owner is its nearest <form> ancestor when the
# parser recorded none (patch 265)
# Generated 2026-10-13
# Base: seleron/vitabrowser (patch stack through 264)
#
# A form's elements collection counted a control by the form pointer the
# HTML parser records; a control a script makes and appends has none, so
# it belonged to no form and a form built by script submitted no fields
# (Cloudflare's challenge answer went out as an empty POST). As the HTML
# standard has it, such a control's owner is its nearest <form> ancestor.
#
# Gate: JS-form-submit.html's echoed body carries the fields
# (res / ev / k); with 263 alone it is empty.
diff --git a/src/html/html_form_element.c b/src/html/html_form_element.c
--- a/src/html/html_form_element.c
+++ b/src/html/html_form_element.c
@@ -299,6 +299,28 @@
 
 /* Callback function to test whether certain node is a form control, see 
  * src/html/html_collection.h for detail. */
+/* VitaBrowser (patch 265): a control's form owner. The parser records it
+ * (the element's form pointer); a control a script made and appended has
+ * none, and its owner is then its nearest <form> ancestor, as the HTML
+ * standard has it -- it belonged to no form, so a form a script built
+ * submitted no fields (Cloudflare's challenge answer arrived empty). */
+static struct dom_html_form_element *_dom_form_owner(
+		struct dom_node_internal *node, struct dom_html_document *doc,
+		struct dom_html_form_element *recorded)
+{
+	struct dom_node_internal *n;
+
+	if (recorded != NULL)
+		return recorded;
+	for (n = node->parent; n != NULL; n = n->parent) {
+		if (n->type == DOM_ELEMENT_NODE && n->name != NULL &&
+		    dom_string_caseless_isequal(n->name,
+				doc->elements[DOM_HTML_ELEMENT_TYPE_FORM]))
+			return (struct dom_html_form_element *) n;
+	}
+	return NULL;
+}
+
 static bool _dom_is_form_control(struct dom_node_internal *node, void *ctx)
 {
 	struct dom_html_document *doc =
@@ -311,16 +333,20 @@
         /* Form controls are INPUT TEXTAREA SELECT and BUTTON*/
         if (dom_string_caseless_isequal(node->name,
 					doc->elements[DOM_HTML_ELEMENT_TYPE_INPUT]))
-		return ((dom_html_input_element *)node)->form == form;
+		return _dom_form_owner(node, doc,
+			((dom_html_input_element *)node)->form) == form;
 	if (dom_string_caseless_isequal(node->name,
 					doc->elements[DOM_HTML_ELEMENT_TYPE_TEXTAREA]))
-		return ((dom_html_text_area_element *)node)->form == form;
+		return _dom_form_owner(node, doc,
+			((dom_html_text_area_element *)node)->form) == form;
 	if (dom_string_caseless_isequal(node->name,
 					doc->elements[DOM_HTML_ELEMENT_TYPE_SELECT]))
-		return ((dom_html_select_element *)node)->form == form;
+		return _dom_form_owner(node, doc,
+			((dom_html_select_element *)node)->form) == form;
 	if (dom_string_caseless_isequal(node->name,
 					doc->elements[DOM_HTML_ELEMENT_TYPE_BUTTON])) {
-		return ((dom_html_button_element *)node)->form == form;
+		return _dom_form_owner(node, doc,
+			((dom_html_button_element *)node)->form) == form;
 	}
 
 	return false;
