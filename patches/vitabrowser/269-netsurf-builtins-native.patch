+/* VitaBrowser patch 269: the browser's own functions are built-in
+ * functions, however they are written, and Function.prototype.toString
+ * of a built-in gives "function name() { [native code] }" (ECMA-262,
+ * NativeFunction syntax) -- it gave the bridge's and the polyfill's source
+ * text. Everything compiled here is the bridge's text (setup scripts, the
+ * polyfill, event-dispatch snippets; never a page's), so it is compiled
+ * without source (patches/quickjs/02); pages' functions keep theirs. */
+static JSValue qjs_eval_builtin(JSContext *ctx, const char *src, size_t len,
+		const char *name, int flags)
+{
+	JSValue v;
+	JS_SetStripFunctionSource(true);
+	v = JS_Eval(ctx, src, len, name, flags);
+	JS_SetStripFunctionSource(false);
+	return v;
+}
