 	for (i = 0; i < qjs_bc_cache_n; i++) {
 		if (qjs_bc_cache[i].hash == h && qjs_bc_cache[i].len == len) {
@@ -825,13 +842,13 @@
 					JS_READ_OBJ_BYTECODE);
