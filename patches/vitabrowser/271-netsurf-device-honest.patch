 		"Object.defineProperty(this,'pageYOffset',{configurable:true,"
 			"get:function(){return __scrollY();}});"
 		"this.devicePixelRatio=1;"
-		"this.screen={width:1024,height:768,availWidth:1024,availHeight:740,colorDepth:24};"
+		/* VitaBrowser patch 271: the screen is the Vita's, 960x544 in
+		 * 24-bit colour, all of it the browser's (it said 1024x768, a
+		 * desktop's, which no Vita has) */
+		"this.screen={width:960,height:544,availWidth:960,availHeight:544,"
+			"availLeft:0,availTop:0,colorDepth:24,pixelDepth:24};"
 		"this.performance={"
 			"now:function(){return __macsurf_monotonic_ms();},"
 			"getEntriesByType:function(){return [];},"
