+/* VitaBrowser patch 272: __vitaBattery() -> [level, charging,
+ * dischargingSeconds] from the platform (frontends/vita js_platform.c:
+ * scePower on the Vita), or null when it has no battery information. */
+static JSValue qjs_battery(JSContext *ctx, JSValueConst this_val,
+		int argc, JSValueConst *argv)
+{
+	double level = 1.0, dis = -1.0;
+	int charging = 1;
+	JSValue a;
+	(void)this_val; (void)argc; (void)argv;
+	if (!macsurf_battery(&level, &charging, &dis))
+		return JS_NULL;
+	a = JS_NewArray(ctx);
+	JS_SetPropertyUint32(ctx, a, 0, JS_NewFloat64(ctx, level));
+	JS_SetPropertyUint32(ctx, a, 1, JS_NewBool(ctx, charging != 0));
+	JS_SetPropertyUint32(ctx, a, 2, JS_NewFloat64(ctx, dis));
+	return a;
+}
