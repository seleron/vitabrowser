+ * The Vita runs on a battery and says how full it is (scePower): level,
+ * charging (or on external power), and the minutes of use left. One
+ * BatteryManager per page, read again every minute, with levelchange /
+ * chargingchange / dischargingtimechange / chargingtimechange events. A
+ * platform with no battery information (the simulator's host) gives the
+ * spec's defaults: charging, level 1, chargingTime 0, dischargingTime
+ * Infinity. Secure contexts only, as in Chromium. */
+(function () {
+	var n = g.navigator;
+	if (!n || isFn(n.getBattery) || !isFn(g.__vitaBattery) || g.isSecureContext === false) return;
+	function illegal() { throw new TypeError('Illegal constructor'); }
+	var ET = g.EventTarget;
+	var BM = function BatteryManager() { illegal(); };
+	if (isFn(ET)) Object.setPrototypeOf(BM.prototype, ET.prototype);
+	try { Object.defineProperty(BM.prototype, Symbol.toStringTag, { value: 'BatteryManager', configurable: true }); } catch (e) { /* */ }
+	define(g, 'BatteryManager', BM);
+	var cur = null, promise = null, mgr = null;
+	function read() {
+		var r = null;
+		try { r = g.__vitaBattery(); } catch (e) { /* */ }
+		if (!r) return { charging: true, chargingTime: 0, dischargingTime: Infinity, level: 1 };
+		var full = r[0] >= 1;
+		return { charging: !!r[1], level: r[0],
+			chargingTime: r[1] ? (full ? 0 : Infinity) : Infinity,
+			dischargingTime: r[1] || !(r[2] > 0) ? Infinity : r[2] };
+	}
+	['charging', 'chargingTime', 'dischargingTime', 'level'].forEach(function (k) {
+		Object.defineProperty(BM.prototype, k, { get: function () {
+			if (this !== mgr) throw new TypeError('Illegal invocation');
+			return cur[k];
+		}, enumerable: true, configurable: true });
+	});
+	var EV = { charging: 'chargingchange', chargingTime: 'chargingtimechange',
+		dischargingTime: 'dischargingtimechange', level: 'levelchange' };
+	function poll() {
+		var nv = read(), old = cur;
+		cur = nv;
+		Object.keys(EV).forEach(function (k) {
+			if (old[k] === nv[k]) return;
+			var ev = new Event(EV[k]);
+			try { mgr.dispatchEvent(ev); } catch (e) { /* */ }
+			var h = mgr['on' + EV[k]];
+			if (isFn(h)) try { h.call(mgr, ev); } catch (e) { /* */ }
+		});
+	}
+	define(n, 'getBattery', function getBattery() {
+		if (!promise) {
+			mgr = isFn(ET) ? new ET() : {};
+			Object.setPrototypeOf(mgr, BM.prototype);
+			Object.keys(EV).forEach(function (k) { mgr['on' + EV[k]] = null; });
+			cur = read();
+			setInterval(poll, 60000);
+			promise = Promise.resolve(mgr);
+		}
+		return promise;
+	});
+	try { Object.defineProperty(n, 'getBattery', { enumerable: true }); } catch (e) { /* */ }
