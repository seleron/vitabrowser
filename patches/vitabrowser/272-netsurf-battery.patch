+int macsurf_battery(double *level, int *charging, double *discharging_s)
+{
+#ifdef __vita__
+	int pct = scePowerGetBatteryLifePercent();
+	int mins = scePowerGetBatteryLifeTime();
+
+	if (pct < 0)
+		return 0;
+	*level = (pct > 100 ? 100 : pct) / 100.0;
+	*charging = scePowerIsBatteryCharging() || scePowerIsPowerOnline();
+	*discharging_s = mins > 0 ? mins * 60.0 : -1.0;
+	return 1;
+#else
+	/* the simulator's host: no battery to speak of */
+	(void)level; (void)charging; (void)discharging_s;
+	return 0;
+#endif
+}
