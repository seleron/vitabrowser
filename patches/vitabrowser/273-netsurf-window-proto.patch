+/* ---- window is a Window (patch 273) -------------------------------------
+ * Object.prototype.toString(window) said "[object global]": QuickJS-ng
+ * gives its global object an own @@toStringTag "global" (Node's word; no
+ * browser has it), and window's prototype was the bridge's WANT census
+ * object, not Window.prototype. In browsers window's chain is
+ * Window.prototype (@@toStringTag "Window", the TEMPORARY / PERSISTENT
+ * constants) -> WindowProperties (the named-properties object,
+ * @@toStringTag "WindowProperties") -> EventTarget.prototype. The census
+ * object takes the named-properties object's place: it still sees every
+ * name a page looks for and does not find. */
+(function () {
+	var W = g.Window, WP = W && W.prototype;
+	if (!WP) return;
+	try { delete g[Symbol.toStringTag]; } catch (e) { /* */ }
+	/* the polyfill can run twice in one realm: once is enough */
+	if (Object.getPrototypeOf(g) === WP && Object.prototype.hasOwnProperty.call(
+	    Object.getPrototypeOf(WP), Symbol.toStringTag)) return;
+	try {
+		var first = Object.getPrototypeOf(g), named = null;
+		if (first !== WP && Object.getPrototypeOf(first) === WP &&
+		    !Object.prototype.hasOwnProperty.call(first, 'constructor'))
+			named = first;
+		var above = Object.getPrototypeOf(WP);
+		if (!named) named = Object.create(above);
+		else Object.setPrototypeOf(named, above);
+		Object.setPrototypeOf(g, WP);
+		Object.setPrototypeOf(WP, named);
+		Object.defineProperty(named, Symbol.toStringTag, { value: 'WindowProperties', configurable: true });
+	} catch (e) { /* */ }
+	try { Object.defineProperty(WP, Symbol.toStringTag, { value: 'Window', configurable: true }); } catch (e) { /* */ }
+	[['TEMPORARY', 0], ['PERSISTENT', 1]].forEach(function (c) {
+		[W, WP].forEach(function (o) {
+			if (!Object.prototype.hasOwnProperty.call(o, c[0]))
+				try { Object.defineProperty(o, c[0], { value: c[1], enumerable: true }); } catch (e) { /* */ }
+		});
+	});
+})();
