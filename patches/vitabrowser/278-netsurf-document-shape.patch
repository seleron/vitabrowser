+/* VitaBrowser patch 278: the engine's own state about a page object --
+ * a document's native hooks, its event registry, ... -- lives in a record
+ * per object that only the engine can reach: __vitaP(obj) (a WeakMap in
+ * macsurf_qjs_setup_globals), not as the object's own properties a page
+ * sees. This is its C side; on failure, the object itself. */
+static JSValue qjs_priv(JSContext *ctx, JSValueConst obj)
+{
+	JSValue g = JS_GetGlobalObject(ctx);
+	JSValue f = JS_GetPropertyStr(ctx, g, "__vitaP");
+	JSValue r;
+
+	JS_FreeValue(ctx, g);
+	if (!JS_IsFunction(ctx, f)) {
+		JS_FreeValue(ctx, f);
+		return JS_DupValue(ctx, obj);
+	}
+	r = JS_Call(ctx, f, JS_UNDEFINED, 1, &obj);
+	JS_FreeValue(ctx, f);
+	if (JS_IsException(r)) {
+		JS_FreeValue(ctx, JS_GetException(ctx));
+		return JS_DupValue(ctx, obj);
+	}
+	return r;
+}
