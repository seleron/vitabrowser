+static JSValue qjs_node_get_name(JSContext *ctx, JSValueConst this_val,
+		int argc, JSValueConst *argv)
+{
+	dom_node *n = qjs_get_node(this_val);
+	dom_node_type t = 0;
+	char lc[128], uc[128];
+
+	(void)argc; (void)argv;
+	if (n == NULL) return JS_UNDEFINED;
+	macsurf_dom_node_get_node_type(n, &t);
+	switch ((int)t) {
+	case 1:
+		qjs_el_names((dom_element *)n, lc, uc);
+		return qjs_names_value(ctx, uc);
+	case 3: return qjs_names_value(ctx, "#text");
+	case 4: return qjs_names_value(ctx, "#cdata-section");
+	case 8: return qjs_names_value(ctx, "#comment");
+	case 9: return qjs_names_value(ctx, "#document");
+	case 11: return qjs_names_value(ctx, "#document-fragment");
+	default: return JS_UNDEFINED;
+	}
+}
