+static int qjs_priv_set(JSContext *ctx, JSValueConst obj, const char *k,
+		JSValue v)
+{
+	JSValue r = qjs_priv(ctx, obj);
+	int ret = JS_SetPropertyStr(ctx, r, k, v);
+	JS_FreeValue(ctx, r);
+	return ret;
+}
