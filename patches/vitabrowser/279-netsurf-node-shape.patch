+static JSValue qjs_priv_get(JSContext *ctx, JSValueConst obj, const char *k)
+{
+	JSValue r = qjs_priv(ctx, obj);
+	JSValue v = JS_GetPropertyStr(ctx, r, k);
+	JS_FreeValue(ctx, r);
+	return v;
+}
