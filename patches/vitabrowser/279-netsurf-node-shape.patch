+/* patch 279: nodeType, nodeName and tagName, read from the node --
+ * Node.prototype's and Element.prototype's getters, as in browsers (they
+ * were own properties of every wrapper). Anything without a node (a
+ * scratch document, a stand-in object) reads undefined, as it did. */
+static JSValue qjs_node_get_type(JSContext *ctx, JSValueConst this_val,
+		int argc, JSValueConst *argv)
+{
+	dom_node *n = qjs_get_node(this_val);
+	dom_node_type t = 0;
+
+	(void)argc; (void)argv;
+	if (n == NULL) return JS_UNDEFINED;
+	macsurf_dom_node_get_node_type(n, &t);
+	return t ? JS_NewInt32(ctx, (int)t) : JS_UNDEFINED;
