# vitabrowser: libcss -- fix gradient `to right` / `to left` direction detection
#
# The -macsurf-gradient parser (MacSurf's p_macsurf_gradient.c) detects the
# `to <side>` direction by comparing the direction token against the interned
# propstring table. It used the LIBCSS_RIGHT / LIBCSS_LEFT indices, but those
# resolve to the *property* keywords "-libcss-right" / "-libcss-left" (the
# MacSurf text-align keywords), not the bare "right" / "left" tokens that the
# CSS `to right` form carries. So the comparison never matched, `horizontal`
# was never set, and every `to right` / `to left` gradient silently fell back
# to the default vertical direction -- rendering identical to `to bottom`.
#
# Fix: compare against the RIGHT / LEFT indices, which resolve to the literal
# "right" / "left" tokens. Single-file, 2-token change. `to top` / `to bottom`
# and angle directions use the fall-through path and are untouched.
#
diff --git a/src/parse/properties/p_macsurf_gradient.c b/src/parse/properties/p_macsurf_gradient.c
index e2e0825..0d6e0e8 100644
--- a/src/parse/properties/p_macsurf_gradient.c
+++ b/src/parse/properties/p_macsurf_gradient.c
@@ -312,12 +312,12 @@ css_error css__parse_macsurf_gradient(css_language *c,
 					bool side_match = false;
 					if ((lwc_string_caseless_isequal(
 					        token->idata,
-					        c->strings[LIBCSS_RIGHT],
+					        c->strings[RIGHT],
 					        &side_match) == lwc_error_ok
 					     && side_match) ||
 					    (lwc_string_caseless_isequal(
 					        token->idata,
-					        c->strings[LIBCSS_LEFT],
+					        c->strings[LEFT],
 					        &side_match) == lwc_error_ok
 					     && side_match)) {
 						horizontal = true;
