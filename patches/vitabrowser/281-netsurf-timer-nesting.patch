+/* patch 281: requestAnimationFrame's timer -- not a timer task, so neither
+ * clamped nor raising the nesting level of what its callback sets */
+static JSValue qjs_raf_timeout(JSContext *ctx, JSValueConst this_val,
+		int argc, JSValueConst *argv)
+{
+	JSValue a[2];
+
+	if (argc < 1) return JS_NewInt32(ctx, 0);
+	a[0] = argv[0];
+	a[1] = JS_NewInt32(ctx, 16);
