+/* exported interface documented in macsurf_qjs.h (patch 281) */
+int macsurf_qjs_timer_chain_active(void)
+{
+	double now = macsurf_qjs_get_now();
+	int i;
+
+	for (i = 0; i < QJS_MAX_TIMERS; i++) {
+		const struct qjs_timer *t = &s_timer_arena[i];
+		if (t->live && t->interval_ms <= 4.0 &&
+		    t->expiry_ms - now <= 4.5)
+			return 1;
+	}
+	return 0;
+}
+
+/* exported interface documented in macsurf_qjs.h (patch 281) */
+double macsurf_qjs_next_timer_ms(void)
+{
+	double now = macsurf_qjs_get_now(), best = -1.0;
+	int i;
+
+	for (i = 0; i < QJS_MAX_TIMERS; i++) {
+		double d;
+		if (!s_timer_arena[i].live) continue;
+		d = s_timer_arena[i].expiry_ms - now;
+		if (d < 0.0) d = 0.0;
+		if (best < 0.0 || d < best) best = d;
+	}
+	return best;
+}
