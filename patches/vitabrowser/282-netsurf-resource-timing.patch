+/* ---- Resource Timing (VitaBrowser patch 282) ----------------------------
+ * A page's fetches as PerformanceResourceTiming entries: the html handler
+ * registers each subresource fetch it starts (macsurf_rt_begin: <link>
+ * stylesheets, scripts, images / objects / CSS backgrounds) and hlcache
+ * reports its completion (macsurf_rt_event); the finished entry waits
+ * here, keyed by its document's content, until that document's realm
+ * reads its timeline (__vitaResourceTake, vita_polyfill.js). fetch() and
+ * XMLHttpRequest are recorded by the polyfill itself. Times are the
+ * engine's clock (macsurf_qjs_get_now); the realm's time origin is taken
+ * off when they are handed over. A URL is one entry per document, as a
+ * browser's memory cache makes it: the engine fetches some again (a
+ * stylesheet is discovered twice, a box tree rebuilt) from its cache, so
+ * an entry stays here, marked handed over, until its document dies. */
+void macsurf_rt_begin(void *parent, void *handle, const char *initiator);
+void macsurf_rt_event(void *handle, int msg);
+
+#define RT_PENDING 512
+#define RT_ENTRIES 1024
+#define RT_PER_DOCUMENT 250	/* a browser's default buffer size */
+struct rt_pending {
+	void *handle;
+	struct content *parent;
+	const char *initiator;
+	double start;
+};
+struct rt_entry {
+	struct content *parent;
+	char *url;
+	const char *initiator;
+	double start, end;
+	long size;
+	long status;
+	char *mime;	/* the response's Content-Type, "" if none */
+	char *tao;	/* its Timing-Allow-Origin, NULL if none */
+	bool taken;	/* handed to the realm */
+};
+static struct rt_pending s_rt_pending[RT_PENDING];
+static unsigned int s_rt_pnext;
+static struct rt_entry s_rt[RT_ENTRIES];
+static int s_rt_n;
+
+static void rt_free(struct rt_entry *e)
+{
+	free(e->url);
+	free(e->mime);
+	free(e->tao);
+}
+
+static void rt_record(struct content *parent, struct hlcache_handle *h,
+		const char *initiator, double start)
+{
+	struct content *c = hlcache_handle_get_content(h);
+	struct nsurl *u = hlcache_handle_get_url(h);
+	struct rt_entry *e;
+	const char *tao;
+	size_t size = 0;
+	int i, mine = 0;
+
+	if (parent == NULL || c == NULL || u == NULL)
+		return;
+	for (i = 0; i < s_rt_n; i++) {
+		if (s_rt[i].parent != parent)
+			continue;
+		if (strcmp(s_rt[i].url, nsurl_access(u)) == 0)
+			return;
+		mine++;
+	}
+	if (mine >= RT_PER_DOCUMENT)
+		return;
+	if (s_rt_n == RT_ENTRIES) {	/* drop the oldest */
+		rt_free(&s_rt[0]);
+		memmove(&s_rt[0], &s_rt[1], sizeof(s_rt[0]) * (RT_ENTRIES - 1));
+		s_rt_n--;
+	}
+	(void)content_get_source_data(h, &size);
+	e = &s_rt[s_rt_n];
+	e->url = strdup(nsurl_access(u));
+	if (e->url == NULL)
+		return;
+	/* the type is the response's Content-Type, as browsers report it
+	 * (the engine's own is sniffed), else the engine's */
+	tao = c->llcache != NULL ?
+		llcache_handle_get_header(c->llcache, "Content-Type") : NULL;
+	e->mime = strdup(tao != NULL ? tao : c->mime_type != NULL ?
+			lwc_string_data(c->mime_type) : "");
+	tao = c->llcache != NULL ?
+		llcache_handle_get_header(c->llcache, "Timing-Allow-Origin") : NULL;
+	e->tao = tao != NULL ? strdup(tao) : NULL;
+	if (e->mime == NULL) {
+		rt_free(e);
+		return;
+	}
+	e->parent = parent;
+	e->initiator = initiator;
+	e->start = start;
+	e->end = macsurf_qjs_get_now();
+	e->size = (long)size;
+	e->status = c->http_code;
+	e->taken = false;
+	s_rt_n++;
+}
+
+/* exported interface documented in macsurf_frontend_stubs.c */
+void macsurf_rt_begin(void *parent, void *handle, const char *initiator)
+{
+	struct rt_pending *p;
+
+	if (parent == NULL || handle == NULL)
+		return;
+	/* a cached content can be caught up to done inside the retrieve */
+	if (hlcache_handle_get_content(handle) != NULL &&
+	    content_get_status(handle) == CONTENT_STATUS_DONE) {
+		rt_record(parent, handle, initiator, macsurf_qjs_get_now());
+		return;
+	}
+	macsurf_rt_event(handle, -1);	/* a handle address used before */
+	p = &s_rt_pending[s_rt_pnext++ % RT_PENDING];
+	p->handle = handle;
+	p->parent = parent;
+	p->initiator = initiator;
+	p->start = macsurf_qjs_get_now();
+}
+
+/* exported interface documented in macsurf_frontend_stubs.c */
+void macsurf_rt_event(void *handle, int msg)
+{
+	int i;
+
+	/* -1: the handle is released (hlcache_handle_release) */
+	if (msg != CONTENT_MSG_DONE && msg != CONTENT_MSG_ERROR && msg != -1)
+		return;
+	for (i = 0; i < RT_PENDING; i++) {
+		struct rt_pending *p = &s_rt_pending[i];
+		if (p->handle != handle)
+			continue;
+		if (msg == CONTENT_MSG_DONE)
+			rt_record(p->parent, handle, p->initiator, p->start);
+		p->handle = NULL;
+	}
+}
+
+static void rt_forget(struct content *c)
+{
+	int i, j = 0;
+
+	for (i = 0; i < RT_PENDING; i++)
+		if (s_rt_pending[i].parent == c)
+			s_rt_pending[i].handle = NULL;
+	for (i = 0; i < s_rt_n; i++) {
+		if (s_rt[i].parent == c) { rt_free(&s_rt[i]); continue; }
+		s_rt[j++] = s_rt[i];
+	}
+	s_rt_n = j;
+}
+
+/* __vitaResourceTake() -> this realm's entries finished since the last
+ * call: [[url, initiatorType, startTime, responseEnd, size, status, type,
+ * Timing-Allow-Origin or null], ...],
+ * times in ms from the realm's time origin, 100 us steps (patch 270) */
+static JSValue qjs_rt_take(JSContext *ctx, JSValueConst this_val,
+		int argc, JSValueConst *argv)
+{
+	struct qjs_realm_owner *o = qjs_owner_for_ctx(ctx);
+	JSValue arr = JS_NewArray(ctx);
+	uint32_t n = 0;
+	int i;
+
+	(void)this_val; (void)argc; (void)argv;
+	if (o == NULL || o->content == NULL)
+		return arr;
+	for (i = 0; i < s_rt_n; i++) {
+		struct rt_entry *e = &s_rt[i];
+		if (e->parent != o->content || e->taken)
+			continue;
+		e->taken = true;
+		{
+			JSValue r = JS_NewArray(ctx);
+			JS_SetPropertyUint32(ctx, r, 0, JS_NewString(ctx, e->url));
+			JS_SetPropertyUint32(ctx, r, 1, JS_NewString(ctx, e->initiator));
+			JS_SetPropertyUint32(ctx, r, 2, JS_NewFloat64(ctx,
+				floor((e->start - o->t_origin) * 10.0) / 10.0));
+			JS_SetPropertyUint32(ctx, r, 3, JS_NewFloat64(ctx,
+				floor((e->end - o->t_origin) * 10.0) / 10.0));
+			JS_SetPropertyUint32(ctx, r, 4, JS_NewInt64(ctx, e->size));
+			JS_SetPropertyUint32(ctx, r, 5, JS_NewInt64(ctx, e->status));
+			JS_SetPropertyUint32(ctx, r, 6, JS_NewString(ctx, e->mime));
+			JS_SetPropertyUint32(ctx, r, 7, e->tao != NULL ?
+				JS_NewString(ctx, e->tao) : JS_NULL);
+			JS_SetPropertyUint32(ctx, arr, n++, r);
+		}
+	}
+	return arr;
+}
