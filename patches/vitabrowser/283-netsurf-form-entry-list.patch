+/* VitaBrowser patch 283: the encodings a form submission is made in
+ * without iconv, by their WHATWG names. Per the Encoding Standard the
+ * labels iso-8859-1, latin1 and us-ascii all mean windows-1252. */
+enum form_cs { FORM_CS_OTHER, FORM_CS_UTF8, FORM_CS_1252 };
+
+static enum form_cs form_charset_kind(const char *name)
+{
+	static const char *const w1252[] = { "windows-1252", "cp1252",
+		"x-cp1252", "iso-8859-1", "iso8859-1", "iso_8859-1",
+		"iso-ir-100", "latin1", "l1", "csisolatin1", "ibm819",
+		"cp819", "us-ascii", "ascii", "ansi_x3.4-1968", NULL };
+	char n[32];
+	size_t i;
+
+	if (name == NULL)
+		return FORM_CS_OTHER;
+	for (i = 0; name[i] != '\0' && name[i] != '/' && i + 1 < sizeof(n); i++)
+		n[i] = ascii_to_lower(name[i]);
+	n[i] = '\0';
+	if (strcmp(n, "utf-8") == 0 || strcmp(n, "utf8") == 0 ||
+	    strcmp(n, "unicode-1-1-utf-8") == 0)
+		return FORM_CS_UTF8;
+	for (i = 0; w1252[i] != NULL; i++)
+		if (strcmp(n, w1252[i]) == 0)
+			return FORM_CS_1252;
+	return FORM_CS_OTHER;
+}
+
+/* the name HTML gives the encoding (what _charset_ is sent as) */
+static const char *form_charset_name(const char *charset)
+{
+	switch (form_charset_kind(charset)) {
+	case FORM_CS_UTF8: return "UTF-8";
+	case FORM_CS_1252: return "windows-1252";
+	default: return charset;
+	}
+}
+
+/* windows-1252 bytes 0x80-0x9F as Unicode (the five unassigned bytes
+ * are their C1 controls, as the Encoding Standard has it) */
+static const uint16_t form_cp1252_c1[32] = {
+	0x20AC, 0x0081, 0x201A, 0x0192, 0x201E, 0x2026, 0x2020, 0x2021,
+	0x02C6, 0x2030, 0x0160, 0x2039, 0x0152, 0x008D, 0x017D, 0x008F,
+	0x0090, 0x2018, 0x2019, 0x201C, 0x201D, 0x2022, 0x2013, 0x2014,
+	0x02DC, 0x2122, 0x0161, 0x203A, 0x0153, 0x009D, 0x017E, 0x0178 };
+
+/**
+ * UTF-8 to windows-1252 as HTML encodes a form: a character the
+ * encoding lacks becomes a decimal character reference "&#N;" (it was
+ * a "?", and the euro and the other 0x80-0x9F characters were lost).
+ */
+static char *form_encode_1252(const char *item, size_t len)
+{
+	size_t i = 0, o = 0;
+	char *out = malloc(len * 10 + 1);	/* "&#1114111;" per byte at most */
+
+	if (out == NULL)
+		return NULL;
+	while (i < len) {
+		uint32_t c = utf8_to_ucs4(item + i, len - i);
+		size_t n = utf8_next(item, len, i) - i;
+		int b = -1, k;
+
+		i += (n == 0) ? 1 : n;
+		if (c < 0x80 || (c >= 0xA0 && c <= 0xFF)) {
+			b = (int)c;
+		} else {
+			for (k = 0; k < 32; k++)
+				if (form_cp1252_c1[k] == c)
+					b = 0x80 + k;
+		}
+		if (b >= 0)
+			out[o++] = (char)b;
+		else
+			o += sprintf(out + o, "&#%lu;", (unsigned long)c);
+	}
+	out[o] = '\0';
+	return out;
+}
