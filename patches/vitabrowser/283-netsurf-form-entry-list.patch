+/* VitaBrowser patch 283: a DOM string is this ASCII word, any case */
+static bool form_ds_is(dom_string *ds, const char *word)
+{
+	size_t n = strlen(word);
+	return ds != NULL && dom_string_byte_length(ds) == n &&
+		strncasecmp(dom_string_data(ds), word, n) == 0;
+}
+
+/* VitaBrowser patch 283: an element's attribute by its name, NULL if it
+ * has none (the names are not in the corestring set) */
+static dom_exception form_attr(dom_node *node, const char *name,
+		dom_string **value)
+{
+	dom_string *key;
+	dom_exception exp;
+
+	*value = NULL;
+	exp = dom_string_create((const uint8_t *)name, strlen(name), &key);
+	if (exp != DOM_NO_ERR)
+		return exp;
+	exp = dom_element_get_attribute(node, key, value);
+	dom_string_unref(key);
+	return exp;
+}
+
+static dom_exception form_has_attr(dom_node *node, const char *name,
+		bool *has)
+{
+	dom_string *v = NULL;
+	dom_exception exp = form_attr(node, name, &v);
+
+	*has = (exp == DOM_NO_ERR && v != NULL);
+	if (v != NULL)
+		dom_string_unref(v);
+	return exp;
+}
+
+/**
+ * VitaBrowser patch 283: whether a control is disabled -- its own
+ * disabled attribute, or a disabled <fieldset> it is inside, unless it is
+ * inside that fieldset's first <legend> (HTML "actually disabled"). Only
+ * the element's own attribute was checked: a control in a disabled
+ * fieldset was submitted.
+ */
+static bool form_node_disabled(dom_node *node)
+{
+	dom_node *n = node, *child = NULL;
+	bool disabled = false;
+
+	if (form_has_attr((dom_node *)node, "disabled", &disabled) != DOM_NO_ERR || disabled)
+		return disabled;
+	dom_node_ref(n);
+	while (!disabled) {
+		dom_node *parent = NULL;
+		dom_string *pname = NULL;
+		dom_node_type type;
+
+		if (dom_node_get_parent_node(n, &parent) != DOM_NO_ERR ||
+		    parent == NULL)
+			break;
+		if (child != NULL)
+			dom_node_unref(child);
+		child = n;
+		n = parent;
+		if (dom_node_get_node_type(n, &type) != DOM_NO_ERR ||
+		    type != DOM_ELEMENT_NODE)
+			break;
+		if (dom_node_get_node_name(n, &pname) != DOM_NO_ERR ||
+		    pname == NULL)
+			break;
+		if (form_ds_is(pname, "fieldset")) {
+			bool fsdis = false;
+			form_has_attr((dom_node *)n, "disabled", &fsdis);
+			if (fsdis) {
+				/* the first legend child is exempt */
+				dom_node *c = NULL, *next;
+				dom_node_get_first_child(n, &c);
+				while (c != NULL) {
+					dom_string *cn = NULL;
+					dom_node_type ct;
+					bool legend = false;
+					if (dom_node_get_node_type(c, &ct) ==
+							DOM_NO_ERR &&
+					    ct == DOM_ELEMENT_NODE &&
+					    dom_node_get_node_name(c, &cn) ==
+							DOM_NO_ERR &&
+					    cn != NULL) {
+						legend = form_ds_is(cn, "legend");
+						dom_string_unref(cn);
+					}
+					if (legend)
+						break;
+					next = NULL;
+					dom_node_get_next_sibling(c, &next);
+					dom_node_unref(c);
+					c = next;
+				}
+				disabled = (c == NULL || c != child);
+				if (c != NULL)
+					dom_node_unref(c);
+			}
+		}
+		dom_string_unref(pname);
+	}
+	dom_node_unref(n);
+	if (child != NULL)
+		dom_node_unref(child);
+	return disabled;
+}
+
+/**
+ * VitaBrowser patch 283: a text field's dirname entry -- the name its
+ * dirname attribute gives, with "ltr" or "rtl", the element's
+ * directionality (its own or an ancestor's dir attribute; "auto": the
+ * first strong character of its value). It was not sent.
+ */
+static nserror
+form_dom_to_data_dirname(dom_node *node, dom_string *value,
+			 const char *form_charset, const char *doc_charset,
+			 struct fetch_multipart_data ***fetch_data_next_ptr)
+{
+	dom_string *dirname = NULL, *dir = NULL, *dirval;
+	dom_node *n = node;
+	const char *d = "ltr";
+	nserror res;
+
+	if (form_attr(node, "dirname", &dirname) != DOM_NO_ERR || dirname == NULL)
+		return NSERROR_OK;
+	if (dom_string_byte_length(dirname) == 0) {
+		dom_string_unref(dirname);
+		return NSERROR_OK;
+	}
+	dom_node_ref(n);
+	while (n != NULL) {
+		dom_node *parent = NULL;
+		dom_node_type type;
+		if (dom_node_get_node_type(n, &type) != DOM_NO_ERR ||
+		    type != DOM_ELEMENT_NODE)
+			break;
+		if (form_attr(n, "dir", &dir) ==
+				DOM_NO_ERR && dir != NULL) {
+			if (form_ds_is(dir, "rtl")) {
+				d = "rtl";
+				break;
+			}
+			if (form_ds_is(dir, "ltr"))
+				break;
+			if (n == node && form_ds_is(dir, "auto")) {
+				/* the first strong character: Hebrew,
+				 * Arabic, Syriac, Thaana, NKo... are RTL */
+				const char *v = value ? dom_string_data(value) : "";
+				size_t vl = value ? dom_string_byte_length(value) : 0, i = 0;
+				while (i < vl) {
+					uint32_t c = utf8_to_ucs4(v + i, vl - i);
+					size_t k = utf8_next(v, vl, i) - i;
+					i += (k == 0) ? 1 : k;
+					if ((c >= 0x0590 && c <= 0x08FF) ||
+					    (c >= 0xFB1D && c <= 0xFDFF) ||
+					    (c >= 0xFE70 && c <= 0xFEFF)) {
+						d = "rtl";
+						break;
+					}
+					if ((c >= 'A' && c <= 'Z') ||
+					    (c >= 'a' && c <= 'z') ||
+					    (c >= 0xC0 && c < 0x0590))
+						break;
+				}
+				break;
+			}
+			dom_string_unref(dir);
+			dir = NULL;
+		}
+		if (dom_node_get_parent_node(n, &parent) != DOM_NO_ERR)
+			parent = NULL;
+		dom_node_unref(n);
+		n = parent;
+	}
+	if (dir != NULL)
+		dom_string_unref(dir);
+	if (n != NULL)
+		dom_node_unref(n);
+	if (dom_string_create((const uint8_t *)d, 3, &dirval) != DOM_NO_ERR) {
+		dom_string_unref(dirname);
+		return NSERROR_NOMEM;
+	}
+	res = fetch_data_list_add(dirname, dirval, NULL, form_charset,
+				  doc_charset, fetch_data_next_ptr);
+	dom_string_unref(dirval);
+	dom_string_unref(dirname);
+	return res;
+}
