+/**
+ * VitaBrowser patch 283: a name or value with its line breaks -- CR LF,
+ * a lone CR, a lone LF -- as CR LF, as HTML submits every entry (a
+ * textarea's "a\nb" went as "a\nb"; Chromium sends "a\r\nb", and
+ * %0D%0A in a URL-encoded body).
+ */
+static char *form_crlf(const char *s, size_t len)
+{
+	size_t i, o = 0;
+	char *out = malloc(len * 2 + 1);
+
+	if (out == NULL)
+		return NULL;
+	for (i = 0; i < len; i++) {
+		if (s[i] == '\r') {
+			out[o++] = '\r';
+			out[o++] = '\n';
+			if (i + 1 < len && s[i + 1] == '\n')
+				i++;
+		} else if (s[i] == '\n') {
+			out[o++] = '\r';
+			out[o++] = '\n';
+		} else {
+			out[o++] = s[i];
+		}
+	}
+	out[o] = '\0';
+	return out;
+}
