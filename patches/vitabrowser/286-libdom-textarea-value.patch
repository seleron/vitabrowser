# libdom: a textarea's value is its text until one is set, and setting it
# leaves the text alone (patch 286)
# Generated 2026-10-13
# Base: seleron/vitabrowser (patch stack through 285)
#
# HTML: a textarea's default value is its text content; its value is that
# until the user or a script sets one (it is then dirty), and setting it
# does not touch the text.
#
#  - get_value read the text once and kept it: text a script put in the
#    element afterwards was never the value (and each read leaked the copy
#    before). It is the text as it is now, until a value is set.
#  - set_value replaced the text with the value, so a typed or script-set
#    value became the default value too. It keeps the value only.
#  - get_default_value was the text at the first read, kept; it is the text
#    content, and set_default_value sets it (it was a separate field).
#
# Gate (with 287): testpages/pages/JS-form-values.html check 1.
diff --git a/src/html/html_text_area_element.c b/src/html/html_text_area_element.c
index db351bc..e4443d2 100644
--- a/src/html/html_text_area_element.c
+++ b/src/html/html_text_area_element.c
@@ -171,22 +171,11 @@ dom_exception dom_html_text_area_element_set_read_only(dom_html_text_area_elemen
 dom_exception dom_html_text_area_element_get_default_value(
 	dom_html_text_area_element *ele, dom_string **default_value)
 {
-	dom_exception err;
-
-	if (ele->default_value_set == false) {
-		err = dom_node_get_text_content((dom_node *)ele,
-						&ele->default_value);
-		if (err == DOM_NO_ERR) {
-			ele->default_value_set = true;
-		}
-	}
-
-	*default_value = ele->default_value;
-
-	if (*default_value != NULL)
-		dom_string_ref(*default_value);
-
-	return DOM_NO_ERR;
+	/* VitaBrowser (patch 286): a textarea's default value is its text
+	 * content as it is now -- it was read once and kept, so text a
+	 * script put in the element later was neither the default nor (in
+	 * get_value) the value */
+	return dom_node_get_text_content((dom_node *)ele, default_value);
 }
 
 /**
@@ -199,16 +188,9 @@ dom_exception dom_html_text_area_element_get_default_value(
 dom_exception dom_html_text_area_element_set_default_value(
 	dom_html_text_area_element *ele, dom_string *default_value)
 {
-	if (ele->default_value != NULL)
-		dom_string_unref(ele->default_value);
-
-	ele->default_value = default_value;
-	ele->default_value_set = true;
-
-	if (ele->default_value != NULL)
-		dom_string_ref(ele->default_value);
-
-	return DOM_NO_ERR;
+	/* VitaBrowser (patch 286): setting the default value sets the text
+	 * content, as HTML has it */
+	return dom_node_set_text_content((dom_node *)ele, default_value);
 }
 
 /**
@@ -221,20 +203,12 @@ dom_exception dom_html_text_area_element_set_default_value(
 dom_exception dom_html_text_area_element_get_value(
 	dom_html_text_area_element *ele, dom_string **value)
 {
-	dom_exception err;
-
-	if (ele->value_set == false) {
-		err = dom_node_get_text_content((dom_node *)ele,
-						&ele->value);
-		if (err == DOM_NO_ERR) {
-			ele->default_value_set = true;
-			if (ele->default_value_set == false) {
-				ele->default_value_set = true;
-				ele->default_value = ele->value;
-				dom_string_ref(ele->default_value);
-			}
-		}
-	}
+	/* VitaBrowser (patch 286): until a value is set (by the user or a
