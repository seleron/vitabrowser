 	*value = ele->value;
 
@@ -254,16 +228,6 @@ dom_exception dom_html_text_area_element_get_value(
 dom_exception dom_html_text_area_element_set_value(
 	dom_html_text_area_element *ele, dom_string *value)
 {
-	dom_exception err;
-
-	if (ele->default_value_set == false) {
-		err = dom_node_get_text_content((dom_node *)ele,
-						&ele->default_value);
-		if (err == DOM_NO_ERR) {
-			ele->default_value_set = true;
-		}
-	}
-
 	if (ele->value != NULL)
 		dom_string_unref(ele->value);
 
@@ -273,7 +237,11 @@ dom_exception dom_html_text_area_element_set_value(
 	if (ele->value != NULL)
 		dom_string_ref(ele->value);
 
-	return dom_node_set_text_content((dom_node *)ele, ele->value);
+	/* VitaBrowser (patch 286): the value is the control's own; the
