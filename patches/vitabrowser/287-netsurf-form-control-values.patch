+/**
+ * A select's options and which of them are selected, as HTML decides it
+ * (VitaBrowser patch 287): in a select without "multiple" at most one --
+ * the last marked selected -- or, when none is and it shows one line,
+ * the first enabled option. The engine keeps an option's selectedness in
+ * its "selected" attribute; this is what the gadget shows, the form
+ * submits and scripts read.
+ *
+ * \param select The select element.
+ * \param opts Set to its options (referenced), in order.
+ * \param sel Set to whether each is selected.
+ * \param n Set to their number.
+ * \return NSERROR_OK, or an error and nothing allocated.
+ */
+nserror form_select_selectedness(struct dom_node *select,
+		struct dom_node ***opts, bool **sel, uint32_t *n);
