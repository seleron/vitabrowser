+/* VitaBrowser patch 287: an option is disabled by its own attribute or
+ * its optgroup's */
+static bool form_option_disabled(dom_node *option)
+{
+	bool dis = false;
+	dom_node *parent = NULL;
+
+	form_has_attr(option, "disabled", &dis);
+	if (!dis && dom_node_get_parent_node(option, &parent) == DOM_NO_ERR &&
+	    parent != NULL) {
+		dom_string *pn = NULL;
+		if (dom_node_get_node_name(parent, &pn) == DOM_NO_ERR &&
+		    pn != NULL) {
+			if (form_ds_is(pn, "optgroup"))
+				form_has_attr(parent, "disabled", &dis);
+			dom_string_unref(pn);
+		}
+		dom_node_unref(parent);
+	}
+	return dis;
+}
+
+/* VitaBrowser patch 287: a drop-down a script left with nothing selected
+ * (select.value = "no such value", selectedIndex = -1) stays so -- HTML
+ * re-selects the first option only when options change -- so the engine,
+ * whose selectedness is the options' "selected" attributes, notes it on
+ * the select. Any pick of an option clears it. */
+static dom_string *form_none_key(void)
+{
+	static dom_string *key;
+
+	if (key == NULL)
+		dom_string_create((const uint8_t *)"__vita_select_none", 18,
+				&key);
+	return key;
+}
+
+/* exported interface documented in html/form_internal.h */
+void form_select_set_none(dom_node *select, bool none)
+{
+	void *old = NULL;
+	dom_string *key = form_none_key();
+
+	if (key != NULL)
+		dom_node_set_user_data(select, key, none ? (void *)1 : NULL,
+				NULL, &old);
+}
+
+static bool form_select_none(dom_node *select)
+{
+	void *data = NULL;
+	dom_string *key = form_none_key();
+
+	return key != NULL && dom_node_get_user_data(select, key, &data) ==
+			DOM_NO_ERR && data != NULL;
+}
+
+/* exported interface documented in html/form_internal.h */
+nserror form_select_selectedness(dom_node *select, dom_node ***opts_out,
+		bool **sel_out, uint32_t *n_out)
+{
+	dom_html_options_collection *col = NULL;
+	dom_node **opts = NULL;
+	bool *sel = NULL, multiple = false;
+	uint32_t n = 0, i;
+	int32_t last = -1, size = 0;
+	dom_string *sz = NULL;
+
+	*opts_out = NULL;
+	*sel_out = NULL;
+	*n_out = 0;
+	if (dom_html_select_element_get_options(
+			(dom_html_select_element *)select, &col) != DOM_NO_ERR ||
+	    col == NULL)
+		return NSERROR_DOM;
+	if (dom_html_options_collection_get_length(col, &n) != DOM_NO_ERR)
+		n = 0;
+	if (n > 0) {
+		opts = calloc(n, sizeof(*opts));
+		sel = calloc(n, sizeof(*sel));
+		if (opts == NULL || sel == NULL) {
+			free(opts);
+			free(sel);
+			dom_html_options_collection_unref(col);
+			return NSERROR_NOMEM;
+		}
+	}
+	for (i = 0; i < n; i++) {
+		if (dom_html_options_collection_item(col, i, &opts[i]) !=
+				DOM_NO_ERR)
+			opts[i] = NULL;
+		if (opts[i] != NULL)
+			form_has_attr(opts[i], "selected", &sel[i]);
+	}
+	dom_html_options_collection_unref(col);
+
+	form_has_attr(select, "multiple", &multiple);
+	if (form_attr(select, "size", &sz) == DOM_NO_ERR && sz != NULL) {
+		size = atoi(dom_string_data(sz));
+		dom_string_unref(sz);
+	}
+	if (!multiple) {
+		/* one at most: the last option marked selected; with none,
+		 * a drop-down (display size 1) selects its first enabled
+		 * option (HTML "selectedness setting algorithm") */
+		for (i = 0; i < n; i++)
+			if (sel[i])
+				last = (int32_t)i;
+		for (i = 0; i < n; i++)
+			sel[i] = ((int32_t)i == last);
+		if (last < 0 && size <= 1 && !form_select_none(select)) {
+			for (i = 0; i < n; i++) {
+				if (opts[i] != NULL &&
+				    !form_option_disabled(opts[i])) {
+					sel[i] = true;
+					break;
+				}
+			}
+		}
+	}
+	*opts_out = opts;
+	*sel_out = sel;
+	*n_out = n;
+	return NSERROR_OK;
+}
+
+/* exported interface documented in html/form_internal.h */
+void form_select_selectedness_free(dom_node **opts, bool *sel, uint32_t n)
+{
+	uint32_t i;
+
+	for (i = 0; i < n; i++)
+		if (opts[i] != NULL)
+			dom_node_unref(opts[i]);
+	free(opts);
+	free(sel);
+}
