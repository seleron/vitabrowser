+/* exported interface documented in html/form_internal.h */
+void form_select_apply_dom(struct form_control *control, bool redraw)
+{
+	dom_node **opts = NULL;
+	bool *sel = NULL;
+	uint32_t n = 0, i;
+	struct form_option *o;
+	struct box *inline_box;
+
+	if (control == NULL || control->type != GADGET_SELECT ||
+	    control->node == NULL ||
+	    form_select_selectedness((dom_node *)control->node, &opts, &sel,
+			&n) != NSERROR_OK)
+		return;
+	control->data.select.num_selected = 0;
+	control->data.select.current = NULL;
+	for (o = control->data.select.items; o != NULL; o = o->next) {
+		o->selected = false;
+		for (i = 0; i < n; i++) {
+			if (opts[i] == (dom_node *)o->node) {
+				o->selected = sel[i];
+				break;
+			}
+		}
+		if (o->selected) {
+			control->data.select.num_selected++;
+			if (control->data.select.current == NULL ||
+			    !control->data.select.multiple)
+				control->data.select.current = o;
+		}
+	}
+	form_select_selectedness_free(opts, sel, n);
+	if (!redraw || control->box == NULL || control->html == NULL ||
+	    control->box->children == NULL ||
+	    (inline_box = control->box->children->children) == NULL)
+		return;
+	talloc_free(inline_box->text);
+	if (control->data.select.num_selected == 0)
+		inline_box->text = talloc_strdup(control->html->bctx,
+				messages_get("Form_None"));
+	else if (control->data.select.num_selected == 1)
+		inline_box->text = talloc_strdup(control->html->bctx,
+				control->data.select.current->text);
+	else
+		inline_box->text = talloc_strdup(control->html->bctx,
+				messages_get("Form_Many"));
+	inline_box->length = inline_box->text ? strlen(inline_box->text) : 0;
+	inline_box->width = control->box->width;
+	html__redraw_a_box(control->html, control->box);
+}
