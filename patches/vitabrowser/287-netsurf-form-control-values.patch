+/* VitaBrowser patch 287: a form control's state as the engine holds it,
+ * for the value / selectedIndex / selected accessors (vita_polyfill.js):
+ *   __vitaFormCtl(textarea, "get")          its value (the text until
+ *                                           a value is set)
+ *   __vitaFormCtl(textarea, "set", s)       set it; the field shows it
+ *   __vitaFormCtl(select, "sel")            [bool...], which options are
+ *                                           selected (form.c, as HTML)
+ *   __vitaFormCtl(select, "pick", i, mode)  mode 0: option i alone (-1:
+ *                                           none); 1 / 2: option i on /
+ *                                           off; the gadget shows it
+ * The control's gadget, when it has been laid out, is brought in line
+ * (form_gadget_sync_with_dom / form_select_apply_dom). */
+static struct form_control *qjs_form_ctl_for(JSContext *ctx, dom_node *n)
+{
+	struct qjs_realm_owner *owner = qjs_owner_for_ctx(ctx);
+	html_content *html;
+
+	if (owner == NULL || owner->content == NULL ||
+	    owner->content->handler == NULL ||
+	    owner->content->handler->type() != CONTENT_HTML)
+		return NULL;
+	html = (html_content *)owner->content;
+	return html_forms_get_control_for_node(html->forms, n);
+}
+
+static JSValue qjs_form_ctl(JSContext *ctx, JSValueConst this_val,
+		int argc, JSValueConst *argv)
+{
+	dom_node *n;
+	const char *op;
+	JSValue ret = JS_UNDEFINED;
+
+	(void)this_val;
+	if (argc < 2 || (n = qjs_get_node(argv[0])) == NULL)
+		return JS_UNDEFINED;
+	op = JS_ToCString(ctx, argv[1]);
+	if (op == NULL)
+		return JS_EXCEPTION;
+	if (strcmp(op, "get") == 0) {
+		dom_string *v = NULL;
+		if (dom_html_text_area_element_get_value(
+				(dom_html_text_area_element *)n, &v) ==
+				DOM_NO_ERR) {
+			ret = v != NULL ? JS_NewStringLen(ctx, dom_string_data(v),
+					dom_string_byte_length(v)) :
+				JS_NewString(ctx, "");
+			if (v != NULL)
+				dom_string_unref(v);
+		}
+	} else if (strcmp(op, "set") == 0 && argc > 2) {
+		size_t len;
+		const char *str = JS_ToCStringLen(ctx, &len, argv[2]);
+		dom_string *v = NULL;
+		if (str == NULL) {
+			JS_FreeCString(ctx, op);
+			return JS_EXCEPTION;
+		}
+		if (dom_string_create((const uint8_t *)str, len, &v) ==
+				DOM_NO_ERR) {
+			struct form_control *c;
+			dom_html_text_area_element_set_value(
+				(dom_html_text_area_element *)n, v);
+			dom_string_unref(v);
+			c = qjs_form_ctl_for(ctx, n);
+			if (c != NULL)
+				form_gadget_sync_with_dom(c);
+		}
+		JS_FreeCString(ctx, str);
+	} else if (strcmp(op, "sel") == 0 || strcmp(op, "pick") == 0) {
+		dom_node **opts = NULL;
+		bool *sel = NULL;
+		uint32_t cnt = 0, i;
+		if (form_select_selectedness(n, &opts, &sel, &cnt) ==
+				NSERROR_OK) {
+			if (op[0] == 's') {
+				ret = JS_NewArray(ctx);
+				for (i = 0; i < cnt; i++)
+					JS_SetPropertyUint32(ctx, ret, i,
+						JS_NewBool(ctx, sel[i]));
+			} else {
+				int32_t idx = -1, mode = 0;
+				struct form_control *c;
+				if (argc > 2)
+					JS_ToInt32(ctx, &idx, argv[2]);
+				if (argc > 3)
+					JS_ToInt32(ctx, &mode, argv[3]);
+				/* nothing picked in a drop-down stays so */
+				form_select_set_none(n, mode == 0 && idx < 0);
+				for (i = 0; i < cnt; i++) {
+					if (opts[i] == NULL)
+						continue;
+					if (mode == 0)
+						dom_html_option_element_set_selected(
+							(dom_html_option_element *)opts[i],
+							(int32_t)i == idx);
+					else if ((int32_t)i == idx)
+						dom_html_option_element_set_selected(
+							(dom_html_option_element *)opts[i],
+							mode == 1);
+				}
+				c = qjs_form_ctl_for(ctx, n);
+				if (c != NULL)
+					form_select_apply_dom(c, true);
+				ret = JS_TRUE;
+			}
+			form_select_selectedness_free(opts, sel, cnt);
+		}
+	}
+	JS_FreeCString(ctx, op);
+	return ret;
+}
