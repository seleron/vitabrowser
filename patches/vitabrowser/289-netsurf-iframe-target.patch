# netsurf: a form or link whose target names an iframe loads there, not
# over the whole page (patch 289)
# Generated 2026-10-13
# Base: seleron/vitabrowser (patch stack through 288)
#
# A target name is found among the page's browser windows, and an iframe
# had one only when it had a src and a box. So a form or link targeting an
# iframe with no src (declared before or after the form, or made by a
# script) or a display:none one found no window, and its result replaced
# the whole page (doc 10, 283's "found, not fixed"). In browsers each
# iframe is a browsing context with its name: the result loads in it.
#
#  - box_special.c box_iframe: a named iframe without src gets its iframe
#    record with no URL, so it has a window -- shown in its box, loading
#    nothing until something is sent there (it was a placeholder box). An
#    iframe with neither src nor name stays a placeholder.
#  - frames.c: a script-made named iframe without src gets its empty window
#    too (browser_window_iframe_is_new / sync); and
#    browser_window_iframe_for_name finds the <iframe name=...> in a page
#    that has no window yet -- display:none, not laid out -- and makes it a
#    box-less one (patch 244's kind), empty.
#  - browser_window.c browser_window_find_target: when no window has the
#    name, the requesting page's iframes and its parents' are asked
#    (browser_window_iframe_for_name) before the result goes anywhere else.
#
# Nothing is loaded that was not before: the new windows stay empty until
# a form or link targets them (patch 244: blank and same-origin script-made
# frames keep their in-page realm, and are not loaded again).
#
# Found on the way, not fixed: a script's a.click() on a link does not
# follow it (with or without a target): the polyfill's click() activates
# submit buttons only.
#
# Gate: testpages/pages/JS-form-target.html (FORMTARGET 5/5: forms into an
# iframe with no src, about:blank, display:none, script-made, declared
# after the form; Chromium 5/5) and tools/run-vita-sim.sh "scriptless form
# submissions": a tapped Send button and a tapped link into iframes
# (FORMTARGET tap tapped,link, as Chromium).
diff --git a/content/handlers/html/box_special.c b/content/handlers/html/box_special.c
index e2eaccab7..5788273dd 100644
--- a/content/handlers/html/box_special.c
+++ b/content/handlers/html/box_special.c
@@ -1176,25 +1176,44 @@ box_iframe(dom_node *n,
 
 	/* get frame URL */
 	err = dom_element_get_attribute(n, corestring_dom_src, &s);
-	if (err != DOM_NO_ERR || s == NULL)
-		return box_iframe_placeholder(box, convert_children);
-	if (box_extract_link(content, s, content->base_url, &url) == false) {
+	if (err != DOM_NO_ERR || s == NULL || dom_string_byte_length(s) == 0) {
+		/* VitaBrowser patch 289: an iframe with no src is still a
+		 * browsing context (about:blank), and a named one is where a
+		 * form or link with that target goes -- it went to the whole
+		 * window. It gets its record and window, which load nothing
+		 * until something is sent there (url NULL). */
+		dom_string *nm = NULL;
+		bool named = false;
+		if (s != NULL)
+			dom_string_unref(s);
+		if (dom_element_get_attribute(n, corestring_dom_name, &nm) ==
+				DOM_NO_ERR && nm != NULL) {
+			named = dom_string_byte_length(nm) > 0;
+			dom_string_unref(nm);
+		}
+		if (!named)
+			return box_iframe_placeholder(box, convert_children);
+		url = NULL;
+	} else {
+		if (box_extract_link(content, s, content->base_url, &url) ==
+				false) {
+			dom_string_unref(s);
+			return false;
+		}
 		dom_string_unref(s);
-		return false;
-	}
-	dom_string_unref(s);
-	if (url == NULL)
-		return true;
+		if (url == NULL)
+			return true;
 
-	/* don't include ourself */
-	if (nsurl_compare(content->base_url, url, NSURL_COMPLETE)) {
-		nsurl_unref(url);
-		return true;
+		/* don't include ourself */
+		if (nsurl_compare(content->base_url, url, NSURL_COMPLETE)) {
+			nsurl_unref(url);
+			return true;
+		}
 	}
 
 	/* fixes451: skip video-embed domains MacSurf cannot render.
 	 * These iframes waste connections and delay page conversion. */
-	{
+	if (url != NULL) {
 		lwc_string *host;
 		const char *hd;
 		int hl;
diff --git a/desktop/browser_window.c b/desktop/browser_window.c
index 53f5f3a7f..4b6ea8cf3 100644
--- a/desktop/browser_window.c
+++ b/desktop/browser_window.c
@@ -4770,6 +4770,18 @@ browser_window_find_target(struct browser_window *bw,
 	if (bw_target)
