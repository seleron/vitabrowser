+			continue;
 		NSLOG(netsurf, INFO, "script-made iframe %s as %s",
 		      nsurl_access(cur->url), key);
 		browser_window_navigate(window, cur->url,
@@ -601,6 +608,72 @@ static void browser_window_sync_iframes(void *p)
 }
 
 
+/* exported function documented in desktop/frames.h */
+struct browser_window *
+browser_window_iframe_for_name(struct browser_window *bw, const char *name)
+{
+	dom_document *doc;
+	dom_string *tag = NULL, *namename = NULL;
+	dom_nodelist *list = NULL;
+	struct browser_window *found = NULL;
+	uint32_t n = 0, k;
+	int i;
+
+	if (bw == NULL || name == NULL || *name == '\0' ||
+	    bw->current_content == NULL ||
+	    content_get_type(bw->current_content) != CONTENT_HTML ||
+	    (doc = html_get_document(bw->current_content)) == NULL)
+		return NULL;
+	if (dom_string_create((const uint8_t *)"iframe", 6, &tag) !=
+			DOM_NO_ERR ||
+	    dom_string_create((const uint8_t *)"name", 4, &namename) !=
+			DOM_NO_ERR ||
+	    dom_document_get_elements_by_tag_name(doc, tag, &list) !=
+			DOM_NO_ERR || list == NULL ||
+	    dom_nodelist_get_length(list, &n) != DOM_NO_ERR)
+		n = 0;
+	for (k = 0; k < n && found == NULL; k++) {
+		dom_node *node = NULL;
+		dom_string *nm = NULL;
+		bool match;
+
+		if (dom_nodelist_item(list, k, &node) != DOM_NO_ERR ||
+		    node == NULL)
+			continue;
+		dom_element_get_attribute((dom_element *)node, namename, &nm);
+		match = nm != NULL && strcasecmp(dom_string_data(nm), name) == 0;
+		if (nm != NULL)
+			dom_string_unref(nm);
+		if (match) {
+			for (i = 0; i < bw->iframe_count; i++)
+				if (bw->iframes[i]->iframe_node == node)
+					found = bw->iframes[i];
+			if (found == NULL) {
+				struct browser_window *window =
+						calloc(1, sizeof(*window));
+				if (window != NULL) {
+					window->name = strdup(name);
+					browser_window_iframe_setup_boxless(bw,
+							window, node, name);
+					window->script_made = true;
+					if (browser_window_iframe_add(bw, window))
+						found = window;
+					NSLOG(netsurf, INFO, "iframe %s: a window "
+					      "made for its target", name);
+				}
+			}
+		}
+		dom_node_unref(node);
+	}
+	if (list != NULL)
+		dom_nodelist_unref(list);
+	if (tag != NULL)
+		dom_string_unref(tag);
+	if (namename != NULL)
+		dom_string_unref(namename);
+	return found;
+}
