diff --git a/desktop/frames.c b/desktop/frames.c
index 21c5e7fff..45523749c 100644
--- a/desktop/frames.c
+++ b/desktop/frames.c
@@ -437,11 +437,16 @@ browser_window_iframe_is_new(struct browser_window *bw,
 {
 	int i;
 
-	if (cur->box == NULL || cur->box->node == NULL || cur->url == NULL)
