# netsurf: fix use-after-free in MacSurf's flex line-count guard (fixes167b)
# Generated 2026-09-22
#
# layout_flex_inner() destroyed its context and then read ctx->line.count for
# the FLEXSAFE trace line. Latent on every platform (the read hits freed
# heap); GCC 11 on the host never flagged it, GCC 15 in vitaSDK does
# (-Werror=use-after-free). Log first, then destroy. Found by the first Vita
# cross build: docs/phase-0/09-vita-frontend.md §3.

diff --git a/content/handlers/html/layout_flex.c b/content/handlers/html/layout_flex.c
index e852a3900..bb6e35119 100644
--- a/content/handlers/html/layout_flex.c
+++ b/content/handlers/html/layout_flex.c
@@ -2400,10 +2400,11 @@ static bool layout_flex_inner(struct box *flex, int available_width,
 	 * one line per item. Cap at FLEX_MAX_LINES; over the cap, fall
 	 * back to block. */
 	if (ctx->line.count > FLEX_MAX_LINES) {
-		layout_flex_ctx__destroy(ctx);
+		/* Log before destroying: the count lives in ctx. */
 		macsurf_debug_log_writef(
 			"FLEXSAFE line-count over cap flex=%p lines=%d",
 			(void *)flex, (int)ctx->line.count);
+		layout_flex_ctx__destroy(ctx);
 		return layout_flex_fallback_block(flex, available_width,
 				content);
 	}
