# libhubbub: numeric character references decoded as HTML has them now --
# &#13; is CR (patch 290)
# Generated 2026-10-13
# Base: seleron/vitabrowser (patch stack through 289)
#
# The tokeniser fixed numbers up with the 2010 draft's table: &#13; became
# LF, so a value written "a&#13;&#10;b" held two line breaks and a form sent
# "a\r\n\r\nb" where Chromium sends "a\r\nb" (doc 10, 283's "found, not
# fixed"); and the other controls (&#1;, &#11;, &#x7F;, &#x1F;), the
# unassigned windows-1252 bytes (&#x81; ...) and the noncharacters
# (&#xFDD0;, &#xFFFE;) became U+FFFD. HTML's numeric character reference
# end state now, as Chromium decodes (checked reference by reference):
#
#  - NUL, a surrogate, or a number beyond U+10FFFF: U+FFFD;
#  - 0x80-0x9F: windows-1252's character where it has one (0x81, 0x8D,
#    0x8F, 0x90, 0x9D stay as they are);
#  - anything else -- CR, the other controls, the noncharacters -- is the
#    code point it names.
#
# And U+10FFFF itself counted as beyond the range (>= in the overflow
# check): it is a code point.
#
# A textarea's value still reads LF for that CR -- its API value
# normalises line breaks (patch 287) -- as in browsers; its text keeps CR.
#
# Gate: testpages/pages/JS-charref.html (CHARREF 6/6, Chromium 6/6) and
# HTML-multipart-form.html's new "crlf" field (a&#13;&#10;b&#13;c) in the
# scriptless-forms section: the multipart digest, fcd2da030618, equals
# Chromium's.
diff --git a/src/tokeniser/tokeniser.c b/src/tokeniser/tokeniser.c
index 2258396..9099afa 100644
--- a/src/tokeniser/tokeniser.c
+++ b/src/tokeniser/tokeniser.c
@@ -3016,7 +3016,9 @@ hubbub_error hubbub_tokeniser_handle_numbered_entity(
 			break;
 		}
 
-		if (ctx->match_entity.codepoint >= 0x10FFFF) {
+		/* VitaBrowser patch 290: beyond U+10FFFF (U+10FFFF itself
+		 * is a code point; it became U+FFFD) */
+		if (ctx->match_entity.codepoint > 0x10FFFF) {
 			ctx->match_entity.overflow = true;
 		}
 	}
@@ -3034,20 +3036,22 @@ hubbub_error hubbub_tokeniser_handle_numbered_entity(
 	if (ctx->match_entity.had_data) {
 		uint32_t cp = ctx->match_entity.codepoint;
 
-		if (0x80 <= cp && cp <= 0x9F) {
-			cp = cp1252Table[cp - 0x80];
-		} else if (cp == 0x0D) {
-			cp = 0x000A;
-		} else if (ctx->match_entity.overflow || 
-				cp <= 0x0008 || cp == 0x000B ||
-				(0x000E <= cp && cp <= 0x001F) ||
-				(0x007F <= cp && cp <= 0x009F) ||
-				(0xD800 <= cp && cp <= 0xDFFF) ||
-				(0xFDD0 <= cp && cp <= 0xFDEF) ||
-				(cp & 0xFFFE) == 0xFFFE) {
+		/* VitaBrowser patch 290: HTML's numeric character reference
+		 * end state as it is now (and as Chromium decodes): only NUL,
+		 * a surrogate or a number beyond U+10FFFF becomes U+FFFD; 0x80
+		 * to 0x9F take their windows-1252 characters where it has one;
+		 * anything else -- CR, the other controls, the noncharacters --
+		 * is the code point it names. This was the 2010 draft's table:
+		 * &#13; became LF (a value written "a&#13;&#10;b" then held two
+		 * line breaks), and &#1;, &#x81;, &#xFFFE;... U+FFFD. */
+		if (ctx->match_entity.overflow || cp == 0 ||
+				(0xD800 <= cp && cp <= 0xDFFF)) {
 			/* the check for cp > 0x10FFFF per spec is performed
 			 * in the loop above to avoid overflow */
 			cp = 0xFFFD;
+		} else if (0x80 <= cp && cp <= 0x9F &&
+				cp1252Table[cp - 0x80] != 0xFFFD) {
+			cp = cp1252Table[cp - 0x80];
 		}
 
 		ctx->match_entity.codepoint = cp;
