+	/* click(): the click event, then -- unless it was cancelled -- the
+	 * activation behaviour: a submit button submits its form through
+	 * requestSubmit (so the form's submit event fires first); a link
+	 * follows its href (patch 292, through __vitaFollowLink). */
 	(function () {
 		var o = d.createElement('button'), owner = null;
 		while (o && !owner) {
@@ -5477,9 +5478,18 @@
 			try { ev = new g.MouseEvent('click', { bubbles: true, cancelable: true, view: g }); }
 			catch (e) { ev = new Event('click', { bubbles: true, cancelable: true }); }
 			var go = this.dispatchEvent ? this.dispatchEvent(ev) : true;
-			if (go === false || ev.defaultPrevented || !isSubmitter(this)) return;
-			f = formOf(this);
-			if (f && isFn(f.requestSubmit)) f.requestSubmit(this);
+			if (go === false || ev.defaultPrevented) return;
+			if (isSubmitter(this)) {
+				f = formOf(this);
+				if (f && isFn(f.requestSubmit)) f.requestSubmit(this);
+				return;
+			}
+			/* VitaBrowser patch 292: a link's activation behaviour
+			 * -- follow it, as a real click does. An <a> without an
+			 * href attribute is not a link and does nothing. */
+			if (String(this.tagName || '').toUpperCase() === 'A' &&
+			    this.getAttribute && this.getAttribute('href') !== null &&
+			    isFn(g.__vitaFollowLink)) g.__vitaFollowLink(this);
 		});
 	})();
 	acc(F, 'elements', function () { return this.querySelectorAll('input,select,textarea,button,fieldset,output,object'); });
