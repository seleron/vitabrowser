# netsurf: a cross-origin frame's contentDocument is null (patch 294)
# Generated 2026-10-14
# Base: seleron/vitabrowser (patch stack through 293)
#
# A parsed iframe whose src is cross-origin answered contentDocument
# with patch 143's shim document: a writable stand-in DOM wearing the
# frame's label. Browsers give null -- the document inside a
# cross-origin frame is not the parent's to see. With the shim, a
# script could read and write a fake DOM for a document it has no
# right to, and the standard cross-origin test
# (frame.contentDocument === null), which a great deal of frame
# code branches on before falling back to postMessage, took the
# wrong path and talked to the shim instead.
#
# The contentDocument getter now answers null when the frame's src
# is not same-origin with the page (the same sameOrigin() the frame
# code already uses for its script-made frames: no src, a blank src
# and about:blank count as same-origin). Same-origin and blank
# parsed frames keep the shim -- their real document lives in the
# frame's own content and script heap, and reaching it is the
# cross-heap work Doc 10 keeps as item 7; the shim remains the
# stand-in until then. contentWindow is unchanged: its shim window
# is the postMessage surface cross-origin frames are supposed to
# expose.
#
# Gate: testpages/pages/JS-frame-xdoc.html (XDOC 4/4 in the
# simulator and in a reference browser -- Firefox/Camoufox, for the
# reason patch 292's header gives). The checks: a same-origin parsed
# frame keeps its document; a cross-origin parsed frame's
# contentDocument is null; a frame with no src keeps its document;
# the cross-origin frame's contentWindow still offers postMessage.
# JS-xorigin-frame.html stays XFRAME 9/9. Simulator only; the vita
# cross-build was not run (no vitaSDK on this VM). Device
# expectation is in Doc 10.
#
# Decline conditions: when item 7 gives a parsed frame's real
# document to the parent's realm, same-origin frames should return
# that instead of the shim; the cross-origin null stays.
#
diff --git a/content/handlers/javascript/quickjs/vita_polyfill.js b/content/handlers/javascript/quickjs/vita_polyfill.js
--- a/content/handlers/javascript/quickjs/vita_polyfill.js
+++ b/content/handlers/javascript/quickjs/vita_polyfill.js
@@ -7318,6 +7318,19 @@
 								if (frameKey !== null) return null;
 								if (String(this.tagName).toUpperCase() !== 'IFRAME') return undefined;
 								if (localFrame(this)) return inDoc(this) ? localWindow(this).document : null;
+								/* VitaBrowser patch 294: a parsed frame whose
+								 * src is cross-origin has no accessible
+								 * document in a browser -- contentDocument
+								 * is null. Patch 143's shim document
+								 * answered for it anyway, so a script could
+								 * read and write a fake DOM for a document
+								 * it has no right to see, and code that
+								 * branches on the null (the standard
+								 * cross-origin test) took the wrong path.
+								 * Same-origin and blank parsed frames keep
+								 * the shim; their real document is the
+								 * cross-heap work of Doc 10's item 7. */
+								if (!sameOrigin(this)) return null;
 								return shimDoc(labelOf(this));
 							} catch (e) { return null; }
 						}
diff --git a/content/handlers/javascript/quickjs/vita_polyfill.inc b/content/handlers/javascript/quickjs/vita_polyfill.inc
--- a/content/handlers/javascript/quickjs/vita_polyfill.inc
+++ b/content/handlers/javascript/quickjs/vita_polyfill.inc
@@ -7319,6 +7319,19 @@
 "\t\t\t\t\t\t\t\tif (frameKey !== null) return null;\n"
 "\t\t\t\t\t\t\t\tif (String(this.tagName).toUpperCase() !== 'IFRAME') return undefined;\n"
 "\t\t\t\t\t\t\t\tif (localFrame(this)) return inDoc(this) ? localWindow(this).document : null;\n"
+"\t\t\t\t\t\t\t\t/* VitaBrowser patch 294: a parsed frame whose\n"
+"\t\t\t\t\t\t\t\t * src is cross-origin has no accessible\n"
+"\t\t\t\t\t\t\t\t * document in a browser -- contentDocument\n"
+"\t\t\t\t\t\t\t\t * is null. Patch 143's shim document\n"
+"\t\t\t\t\t\t\t\t * answered for it anyway, so a script could\n"
+"\t\t\t\t\t\t\t\t * read and write a fake DOM for a document\n"
+"\t\t\t\t\t\t\t\t * it has no right to see, and code that\n"
+"\t\t\t\t\t\t\t\t * branches on the null (the standard\n"
+"\t\t\t\t\t\t\t\t * cross-origin test) took the wrong path.\n"
+"\t\t\t\t\t\t\t\t * Same-origin and blank parsed frames keep\n"
+"\t\t\t\t\t\t\t\t * the shim; their real document is the\n"
+"\t\t\t\t\t\t\t\t * cross-heap work of Doc 10's item 7. */\n"
+"\t\t\t\t\t\t\t\tif (!sameOrigin(this)) return null;\n"
 "\t\t\t\t\t\t\t\treturn shimDoc(labelOf(this));\n"
 "\t\t\t\t\t\t\t} catch (e) { return null; }\n"
 "\t\t\t\t\t\t}\n"
