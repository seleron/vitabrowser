+/* patch 295: qjs_cs_colour's formatting into a caller buffer, for
+ * colours composed into a larger string (box-shadow's list). */
+static void qjs_cs_colour_str(css_color c, char *buf, size_t buflen)
+{
+	int a = (int)((c >> 24) & 0xff);
+	/* libcss packs colour as 0xAARRGGBB. */
+	if (a == 255) {
+		snprintf(buf, buflen, "rgb(%d, %d, %d)",
+			(int)((c >> 16) & 0xff), (int)((c >> 8) & 0xff),
+			(int)(c & 0xff));
+	} else {
+		int hundred = (a * 100 + 127) / 255;
+		char ab[8];
+
+		if ((hundred * 255 + 50) / 100 == a) {
+			if (hundred % 10 == 0)
+				snprintf(ab, sizeof ab, "%d.%d", hundred / 100,
+						(hundred / 10) % 10);
+			else
+				snprintf(ab, sizeof ab, "0.%02d", hundred);
+		} else {
+			snprintf(ab, sizeof ab, "0.%03d", (a * 1000 + 127) / 255);
+		}
+		if (a == 0)
+			strcpy(ab, "0");
+		snprintf(buf, buflen, "rgba(%d, %d, %d, %s)",
+			(int)((c >> 16) & 0xff), (int)((c >> 8) & 0xff),
+			(int)(c & 0xff), ab);
+	}
+}
+
+/* patch 295: a computed length as getComputedStyle prints it. A
+ * percentage stays a percentage (the cascade cannot resolve it);
+ * anything else is the cascade's length in px, the convention
+ * font-size above already follows. */
+static void qjs_cs_len_str(char *buf, size_t buflen, css_fixed len,
+		css_unit unit)
+{
+	if (unit == CSS_UNIT_PCT) {
+		double v = FIXTOFLT(len);
+		if (v == (double)(int)v)
+			snprintf(buf, buflen, "%d%%", (int)v);
+		else
+			snprintf(buf, buflen, "%g%%", v);
+	} else {
+		snprintf(buf, buflen, "%dpx", FIXTOINT(len));
+	}
+}
