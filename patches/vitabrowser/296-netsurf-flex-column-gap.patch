# netsurf: a column flex container takes its item gap from row-gap
# (patch 296)
# Generated 2026-10-14
# Base: seleron/vitabrowser (patch stack through 295)
#
# The flex context resolved its two gaps once per container as
# main_gap = column-gap and cross_gap = row-gap, with a comment
# saying column-gap sizes the gap between items on the main axis.
# That is only a row container's answer. The gap properties belong
# to the axis they separate: column-gap is the space between
# columns (between the items of a row container, and between the
# lines of a column one), row-gap the space between rows. In a
# column container the items stack in rows, so row-gap is the gap
# between items and column-gap the gap between lines -- the context
# had them swapped, and a column container with row-gap: 14px and
# column-gap: 4px stepped its items by 14px where Chromium steps
# 24px (measured on the gate page's geometry before the fix: the
# item step came out at the column-gap, and a wrapped column's
# second line started at the row-gap).
#
# The context now resolves both gaps to pixels and assigns them by
# direction: horizontal -- main = column-gap, cross = row-gap (as
# before); vertical -- main = row-gap, cross = column-gap. Every
# consumer of main_gap / cross_gap already works in axis-relative
# terms, so nothing else changes. (This was queued as one item
# with patch 295's computed-style gaps and split so each patch
# stays on one topic; Doc 10 records the split.)
#
# Gate: testpages/pages/CSS-flex-gap.html (FLEXGAP 5/5 in the
# simulator and in a reference browser -- Firefox/Camoufox, for
# the reason patch 292's header gives). The checks measure item
# offsets: a row container's step (the control, unchanged), a
# column container's item step and third item, and a wrapped
# column container whose second line starts one item width plus
# the column-gap over. Simulator only; the vita cross-build was
# not run (no vitaSDK on this VM). Device expectation is in
# Doc 10.
#
# Decline conditions: none expected -- the assignment was simply
# the wrong axis pairing for one direction.
#
diff --git a/content/handlers/html/layout_flex.c b/content/handlers/html/layout_flex.c
--- a/content/handlers/html/layout_flex.c
+++ b/content/handlers/html/layout_flex.c
@@ -309,23 +309,29 @@
 
 	/* Resolve the gaps to device pixels once per container.
 	 * CSS_COLUMN_GAP_NORMAL => 0 for flex (per spec).
-	 * Per CSS Flexbox: column-gap sizes the gap between items on the
-	 * main axis, row-gap the gap between flex lines on the cross axis.
-	 * row-gap is its own property now (independent storage). */
+	 * The gap properties belong to the axis they separate, not to
+	 * the flex direction: column-gap is the space between columns
+	 * (between the items of a row container, and between the lines
+	 * of a column one), row-gap the space between rows. Which of
+	 * them is the main-axis gap therefore depends on the
+	 * direction. VitaBrowser patch 296: this hardwired
+	 * main = column-gap and cross = row-gap, which is only the row
+	 * container's answer -- a column container with a row-gap laid
+	 * its items out with the column-gap instead (measured against
+	 * Chromium: a 10 px step where 17 px belonged). */
 	{
+		int col_gap_px = 0, row_gap_px = 0;
 		css_fixed gap_len = 0;
 		css_unit gap_unit = CSS_UNIT_PX;
 		uint8_t gap_type = css_computed_column_gap(flex->style,
 				&gap_len, &gap_unit);
 		if (gap_type == CSS_COLUMN_GAP_SET) {
-			ctx->main_gap = FIXTOINT(css_unit_len2device_px(
+			col_gap_px = FIXTOINT(css_unit_len2device_px(
 					flex->style, ctx->unit_len_ctx,
 					gap_len, gap_unit));
-			if (ctx->main_gap < 0) {
-				ctx->main_gap = 0;
+			if (col_gap_px < 0) {
+				col_gap_px = 0;
 			}
-		} else {
-			ctx->main_gap = 0;
 		}
 
 		gap_len = 0;
@@ -333,14 +339,20 @@
 		gap_type = css_computed_row_gap(flex->style,
 				&gap_len, &gap_unit);
 		if (gap_type == CSS_COLUMN_GAP_SET) {
-			ctx->cross_gap = FIXTOINT(css_unit_len2device_px(
+			row_gap_px = FIXTOINT(css_unit_len2device_px(
 					flex->style, ctx->unit_len_ctx,
 					gap_len, gap_unit));
-			if (ctx->cross_gap < 0) {
-				ctx->cross_gap = 0;
+			if (row_gap_px < 0) {
+				row_gap_px = 0;
 			}
+		}
+
+		if (ctx->horizontal) {
+			ctx->main_gap = col_gap_px;
+			ctx->cross_gap = row_gap_px;
 		} else {
-			ctx->cross_gap = 0;
+			ctx->main_gap = row_gap_px;
+			ctx->cross_gap = col_gap_px;
 		}
 	}
 
