+		/* the bridge puts some of the form's own IDL attributes
+		 * (action, method, target, name) on the shared element
+		 * prototype above FP, not on FP: wrap those where they
+		 * live -- the isA guard keeps every other element's reads
+		 * exactly as they were */
+		['name', 'action', 'method', 'enctype', 'encoding', 'target',
