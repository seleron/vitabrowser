+		 'relList', 'elements', 'length'].forEach(function (k) {
+			if (wrapped[k]) return;
+			for (var p = Object.getPrototypeOf(FP);
+			     p && p !== Object.prototype;
+			     p = Object.getPrototypeOf(p))
+				if (GOPD(p, k)) { wrapMember(p, k); break; }
+		});
+		above(FP, function (form, k) {
+			if (IDX.test(k)) return controls(form)[+k];
+			return k === '' ? null : formNamed(form, k);
+		});
+	}
 
