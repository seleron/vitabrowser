# netsurf: eventPhase, and the window steps of a document dispatch (patch 298)
# Generated 2026-10-14
# Base: seleron/vitabrowser (patch stack through 297)
#
# The follow-up patch 146's Doc 10 entry recorded but did not fix.
# Two defects, one root -- the JS side of event dispatch never kept
# eventPhase:
#
# A fresh Event read eventPhase === undefined (the constructor never
# set it), where a browser reads 0 (NONE). And document.dispatchEvent
# was a shim that fired only the document's own listeners, filtered
# by that undefined phase: an event a page dispatched on the document
# never reached window at all -- no capture step on the way down, no
# bubble step on the way up, no phases for the listeners it did reach,
# and currentTarget left pointing at the document afterwards. The
# native path was already right and stays right: an element dispatch
# goes through libdom, whose callback sets the true phase per visit
# and fans out to window at the document visit (patch 250).
#
# The constructor now sets eventPhase = 0, and the prototype's
# stopPropagation records __msStopProp (native dispatches shadow it
# with the C method the callback installs, as before). The document
# shim tells its three callers apart by the phase the event arrives
# with. A phase of 1-3 is the native callback delivering a libdom
# dispatch: fire the document's listeners only, exactly as it always
# has. The engine's own lifecycle events (js_fire_dom_ready /
# js_fire_window_load, which dispatch window separately) are marked
# __msDocOnly by a new __msDocEv helper and get a document-only step
# that now reports the at-target phase, 2. Anything else at phase 0
# is a page's direct call, and runs the path a document event really
# has: capture at window (1), at-target at the document (2), bubble
# at window (3) when the event bubbles -- window's own shim does the
# per-phase filtering -- honouring stopPropagation and
# stopImmediatePropagation between steps, and leaving the event at
# rest (phase 0, no currentTarget). 'load' skips the window steps: a
# document's window parent does not apply to it (patch 250's rule,
# measured there). The window shim treats a phase-0 arrival as a
# dispatch at window (phase 2 while firing, rest state after); its
# preset-phase calls are unchanged. After a native element dispatch,
# qjs_el_dispatch_event_data resets the reused JS event to phase 0 /
# currentTarget null -- the state browsers leave it in, and what
# keeps a re-dispatched event from looking like a native delivery
# still in progress.
#
# Deliberately unchanged: document.dispatchEvent still returns true
# unconditionally (a browser returns false for a cancelled cancelable
# event). That was not part of the recorded defect; changing the
# return contract is its own patch if it is ever wanted.
#
# Gate: testpages/pages/JS-event-phase.html (EVPHASE). Reference run
# in Firefox/Camoufox (this VM's Chromium refuses loopback
# navigations; see patch 292's header): 9/9. The simulator before
# this patch: 2/9 -- phases undefined, no window steps, currentTarget
# left set; the two passes were the native element path and the
# DOMContentLoaded-fires-once guard, both of which had to stay
# passing. After: EVPHASE 9/9, every listener sequence byte-identical
# to the reference, CAPTGT 7/7 and EVORDER 5/5 held, and the full
# adapted simulator gate exits 0 (its network-mirror section is
# skipped on this VM -- UDP sendto() is EPERM-blocked -- as in every
# adapted run). Simulator only; the Vita cross-build was not run (no
# vitaSDK on this VM). Device expectation is in Doc 10.
#
# Decline conditions: if the bridge ever grows a real C-side
# dispatchEvent for the document (libdom document events), the
# shim's hand-walked path should be deleted in its favour; the
# phase discrimination exists only because the native callback and
# the shim share one entry point.
#
diff --git a/content/handlers/javascript/quickjs/macsurf_qjs.c b/content/handlers/javascript/quickjs/macsurf_qjs.c
--- a/content/handlers/javascript/quickjs/macsurf_qjs.c
+++ b/content/handlers/javascript/quickjs/macsurf_qjs.c
@@ -10298,6 +10298,17 @@ static JSValue qjs_el_dispatch_event_data(JSContext *ctx,
 	(void)dom_event_target_dispatch_event(node, evt, &ok_flag);
 	g_qjs_in_dispatch = 0;
 
+	/* VitaBrowser patch 298 - leave the JS event at rest, as browsers
+	 * do (eventPhase NONE, no currentTarget). The listener callback
+	 * sets both per visit on this same object; without the reset a
+	 * later document.dispatchEvent of the same object would mistake
+	 * the stale phase for a native delivery in progress. */
+	if (JS_IsObject(argv[0])) {
+		JS_SetPropertyStr(ctx, argv[0], "eventPhase",
+				JS_NewInt32(ctx, 0));
+		JS_SetPropertyStr(ctx, argv[0], "currentTarget", JS_NULL);
+	}
+
 	g_synth_ev_stack = slot.prev;
 	dom_event_unref(evt);
 
@@ -14244,12 +14255,21 @@ static void register_browser_globals(JSContext *ctx)
 			"this.cancelable=!!opts.cancelable;"
 			"this.composed=!!opts.composed;"
 			"this.defaultPrevented=false;"
+			/* VitaBrowser patch 298 - eventPhase exists from birth:
+			 * 0 (NONE) at rest, as in browsers. It used to be absent,
+			 * so ev.eventPhase read undefined outside a native
+			 * dispatch (and during a JS-shim one). */
+			"this.eventPhase=0;"
 			"this.target=null;this.currentTarget=null;"
 		"}"
 		"Event.NONE=0;Event.CAPTURING_PHASE=1;Event.AT_TARGET=2;Event.BUBBLING_PHASE=3;"
 		"Event.prototype.NONE=0;Event.prototype.CAPTURING_PHASE=1;Event.prototype.AT_TARGET=2;Event.prototype.BUBBLING_PHASE=3;"
 		"Event.prototype.preventDefault=function(){if(this.cancelable)this.defaultPrevented=true;};"
-		"Event.prototype.stopPropagation=function(){};"
+		/* VitaBrowser patch 298 - the JS dispatch shims (document /
