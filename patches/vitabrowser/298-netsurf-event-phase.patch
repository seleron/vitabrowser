+									"((e&&e.name)?(e.name+': '):'')+((e&&e.message)||e)+(e&&e.stack?(' STACK: '+e.stack):''));}catch(_){}"
+						"}});}"
+					"var phIn=ev.eventPhase|0;"
+					/* VitaBrowser patch 298 - three ways in, kept apart
+					 * by the phase the event arrives with:
+					 * (a) phIn 1-3: the native listener callback is
