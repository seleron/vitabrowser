 		 * dropped - fired 10+ times per response, dominant log
 		 * volume contributor. */
 		object->fetch.state = LLCACHE_FETCH_HEADERS;
+		/* VitaBrowser patch 299 - a header is progress. */
+		object->fetch.last_progress = time(NULL);
 
 		error = llcache_fetch_process_header(object,
 				msg->data.header_or_data.buf,
@@ -3497,6 +3671,8 @@ static void llcache_fetch_callback(const fetch_msg *msg, void *p)
 	/* Normal 2xx state machine */
 	case FETCH_DATA:
 		/* Received some data. fixes97: per-chunk MS_LOG dropped. */
+		/* VitaBrowser patch 299 - a data chunk is progress. */
