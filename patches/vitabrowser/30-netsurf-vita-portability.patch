# netsurf: core portability for the Vita (newlib, no curl)
# Generated 2026-09-22
#
# - content/fetch.c: include the curl fetcher header only WITH_CURL. Upstream
#   registers the fetcher under the guard but includes its header (and so
#   <curl/curl.h>) unconditionally; the Vita's first build has no curl.
# - utils/time.c: <string.h> for memset (curl.h used to supply it); zero-init
#   `value` in time__parse_number, the curl-less date parser, which GCC 11
#   reports as maybe-uninitialized at -O2 (a false positive: a full-length
#   parse always stores it).
# - utils/config.h: __vita__ gets PATH_MAX from <sys/syslimits.h> (vitaSDK's
#   <limits.h> resolves to GCC's, which lacks it) and joins the platforms
#   without mmap and without dirfd/fstatat/unlinkat (newlib has neither).
# All three are no-ops on the host monkey build (L1 canary unchanged).
# See docs/phase-0/09-vita-frontend.md §3.

diff --git a/content/fetch.c b/content/fetch.c
index a8fa742a5..e56386baf 100644
--- a/content/fetch.c
+++ b/content/fetch.c
@@ -54,7 +54,9 @@
 #include "content/fetchers.h"
 #include "content/fetchers/resource.h"
 #include "content/fetchers/about/about.h"
+#ifdef WITH_CURL
 #include "content/fetchers/curl.h"
+#endif
 #include "content/fetchers/data.h"
 #include "content/fetchers/file/file.h"
 #include "javascript/fetcher.h"
