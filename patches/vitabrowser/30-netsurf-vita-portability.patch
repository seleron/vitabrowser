+
 #if defined(__NetBSD__)
 #include <sys/param.h>
 #if (defined(__NetBSD_Version__) && __NetBSD_Prereq__(8,0,0))
@@ -163,7 +167,7 @@ char *realpath(const char *path, char *resolved_path);
 #endif
 
 #define HAVE_MMAP
-#if (defined(_WIN32) || defined(__riscos__) || defined(__HAIKU__) || defined(__BEOS__) || defined(__amigaos4__) || defined(__AMIGA__) || defined(__MINT__) || defined(__MACOS9__))
+#if (defined(_WIN32) || defined(__riscos__) || defined(__HAIKU__) || defined(__BEOS__) || defined(__amigaos4__) || defined(__AMIGA__) || defined(__MINT__) || defined(__MACOS9__) || defined(__vita__))
 #undef HAVE_MMAP
 #endif
 
@@ -177,7 +181,7 @@ char *realpath(const char *path, char *resolved_path);
 #define HAVE_DIRFD
 #define HAVE_UNLINKAT
 #define HAVE_FSTATAT
-#if (defined(_WIN32) || defined(__riscos__) || defined(__HAIKU__) || defined(__BEOS__) || defined(__amigaos4__) || defined(__AMIGA__) || defined(__MINT__) || defined(__MACOS9__))
+#if (defined(_WIN32) || defined(__riscos__) || defined(__HAIKU__) || defined(__BEOS__) || defined(__amigaos4__) || defined(__AMIGA__) || defined(__MINT__) || defined(__MACOS9__) || defined(__vita__))
 #undef HAVE_DIRFD
