+/* ======================================================================
+ * VitaBrowser patch 306 -- item 7, stage 2 (doc 19): queries on the
+ * parsed-frame document handle (the handle itself is patch 304's,
+ * above). Each native resolves the child's current content /
+ * document / generation through qjs_fdoc_current at call time, so
+ * the answers track the frame the parent actually has: after a
+ * navigation they answer the NEW document, and on the null
+ * document (frame removed, destroyed, or not yet loaded) single
+ * lookups answer null and list lookups answer empty -- doc 19's
+ * "properties undefined, queries empty", never a throw across the
+ * boundary. Matches are minted as patch 304 node handles capturing
+ * this call's (content, generation), so they share the roots'
+ * lifetime discipline exactly: live within the generation that
+ * produced them, inert after it, and never an alias into a stale
+ * document's tree.
+ * ====================================================================== */
+
+/* The handle's live query context; 0 = the null document. */
+static int qjs_fdoc_query_ctx(JSValueConst this_val,
+		struct qjs_fbind **bp, struct content **cp,
+		dom_document **dp, unsigned long *gp)
+{
+	struct qjs_fdoc_state *st =
+		(struct qjs_fdoc_state *)JS_GetOpaque(this_val,
+				s_fdoc_class_id);
+	if (st == NULL) return 0;
+	if (!qjs_fdoc_current(st->bind, cp, dp, gp)) return 0;
+	*bp = st->bind;
+	return 1;
+}
+
+static JSValue qjs_fdoc_get_element_by_id(JSContext *ctx,
+		JSValueConst this_val, int argc, JSValueConst *argv)
+{
+	struct qjs_fbind *bind = NULL;
+	struct content *content = NULL;
+	dom_document *doc = NULL;
+	unsigned long gen = 0;
+	const char *id;
+	dom_string *id_ds;
+	dom_element *el = NULL;
+
+	if (argc < 1 || !qjs_fdoc_query_ctx(this_val, &bind, &content,
+			&doc, &gen))
+		return JS_NULL;
+	id = JS_ToCString(ctx, argv[0]);
+	if (id == NULL) return JS_NULL;
+	id_ds = qjs_make_domstr(id);
+	JS_FreeCString(ctx, id);
+	if (id_ds == NULL) return JS_NULL;
+	macsurf_dom_document_get_element_by_id(doc, id_ds, &el);
+	macsurf_dom_string_unref(id_ds);
+	if (el == NULL) return JS_NULL;
+	/* get_element_by_id hands back a ref; the handle adopts it. */
+	return qjs_fnode_wrap(ctx, bind, content, gen, (dom_node *)el, doc);
+}
+
+/* qjs_collect_by_sel_list with node-handle wrapping: every match in
+ * document order, each minted as a handle of this query's
+ * (content, generation). */
+static void qjs_fdoc_collect_by_sel_list(JSContext *ctx, dom_node *node,
+		const struct qjs_sel_list *sl, struct qjs_fbind *bind,
+		struct content *content, unsigned long gen,
+		dom_document *doc, JSValue arr, int *count)
+{
+	dom_node *child = NULL;
+	dom_node *next = NULL;
+
+	if (node == NULL) return;
+	if (qjs_sel_list_match(node, sl)) {
+		macsurf_dom_node_ref(node); /* the handle adopts the ref */
+		JS_SetPropertyUint32(ctx, arr, (uint32_t)(*count),
+				qjs_fnode_wrap(ctx, bind, content, gen,
+						node, doc));
+		(*count)++;
+	}
+	macsurf_dom_node_get_first_child(node, &child);
+	while (child != NULL) {
+		qjs_fdoc_collect_by_sel_list(ctx, child, sl, bind, content,
+				gen, doc, arr, count);
+		macsurf_dom_node_get_next_sibling(child, &next);
+		macsurf_dom_node_unref(child);
+		child = next;
+	}
+}
+
+/* The shared list walk behind querySelectorAll and
+ * getElementsByTagName: the realm's own document defines
+ * getElementsByTagName(t) AS querySelectorAll(t) (fixes873), and
+ * the handle mirrors it -- one matcher, no second walker. */
+static JSValue qjs_fdoc_query_list(JSContext *ctx,
+		JSValueConst this_val, int argc, JSValueConst *argv)
+{
+	struct qjs_fbind *bind = NULL;
+	struct content *content = NULL;
+	dom_document *doc = NULL;
+	unsigned long gen = 0;
+	const char *sel;
+	JSValue arr;
+	int count = 0;
+
+	arr = JS_NewArray(ctx);
+	if (argc < 1 || !qjs_fdoc_query_ctx(this_val, &bind, &content,
+			&doc, &gen))
+		return arr; /* the null document's queries are empty */
+	sel = JS_ToCString(ctx, argv[0]);
+	if (sel == NULL) return arr;
+	{
+		struct qjs_sel_list s;
+		dom_element *root = NULL;
+
+		qjs_sel_list_parse(sel, &s);
+		if (s.approx) {
+			macsurf_debug_log_writef(
+				"WORK fdoc qsa: APPROX selector (unsupported "
+				"syntax ignored) sel=%s", sel);
+		}
+		JS_FreeCString(ctx, sel);
+		if (s.n == 0) return arr;
+		macsurf_dom_document_get_document_element(doc, &root);
+		if (root != NULL) {
+			qjs_fdoc_collect_by_sel_list(ctx, (dom_node *)root,
+					&s, bind, content, gen, doc, arr,
+					&count);
+			macsurf_dom_node_unref((dom_node *)root);
+		}
+	}
+	return arr;
+}
+
+static JSValue qjs_fdoc_query_selector_all(JSContext *ctx,
+		JSValueConst this_val, int argc, JSValueConst *argv)
+{
+	return qjs_fdoc_query_list(ctx, this_val, argc, argv);
+}
+
+static JSValue qjs_fdoc_get_elements_by_tag_name(JSContext *ctx,
+		JSValueConst this_val, int argc, JSValueConst *argv)
+{
+	return qjs_fdoc_query_list(ctx, this_val, argc, argv);
+}
+
+static JSValue qjs_fdoc_query_selector(JSContext *ctx,
+		JSValueConst this_val, int argc, JSValueConst *argv)
+{
+	struct qjs_fbind *bind = NULL;
+	struct content *content = NULL;
+	dom_document *doc = NULL;
+	unsigned long gen = 0;
+	const char *sel;
+
+	if (argc < 1 || !qjs_fdoc_query_ctx(this_val, &bind, &content,
+			&doc, &gen))
+		return JS_NULL;
+	sel = JS_ToCString(ctx, argv[0]);
+	if (sel == NULL) return JS_NULL;
+	{
+		struct qjs_sel_list s;
+		dom_element *root = NULL;
+		dom_element *found = NULL;
+
+		qjs_sel_list_parse(sel, &s);
+		if (s.approx) {
+			macsurf_debug_log_writef(
+				"WORK fdoc qs: APPROX selector (unsupported "
+				"syntax ignored) sel=%s", sel);
+		}
+		JS_FreeCString(ctx, sel);
+		if (s.n == 0) return JS_NULL;
+
+		/* The single-id fast path, as in qjs_querySelector: it
+		 * applies only when the whole selector is one
+		 * id-bearing compound, and the result still runs the
+		 * full compound match before it is wrapped. */
+		if (s.n == 1 && s.alt[0].n == 1 &&
+		    s.alt[0].c[0].id[0] != '\0') {
+			dom_string *id_ds = qjs_make_domstr(s.alt[0].c[0].id);
+			dom_element *el = NULL;
+			if (id_ds == NULL) return JS_NULL;
+			macsurf_dom_document_get_element_by_id(doc,
+					id_ds, &el);
+			macsurf_dom_string_unref(id_ds);
+			if (el == NULL) return JS_NULL;
+			if (!qjs_compound_match((dom_node *)el,
+					&s.alt[0].c[0])) {
+				macsurf_dom_node_unref((dom_node *)el);
+				return JS_NULL;
+			}
+			return qjs_fnode_wrap(ctx, bind, content, gen,
+					(dom_node *)el, doc);
+		}
+
+		macsurf_dom_document_get_document_element(doc, &root);
+		if (root == NULL) return JS_NULL;
+		found = qjs_find_first_by_sel_list((dom_node *)root, &s);
+		macsurf_dom_node_unref((dom_node *)root);
+		if (found == NULL) return JS_NULL;
+		/* find_first hands back a ref; the handle adopts it. */
+		return qjs_fnode_wrap(ctx, bind, content, gen,
+				(dom_node *)found, doc);
+	}
+}
+
