+/* Patch 308 - doc-20 stage 0: name the cause of a batch's full
+ * reconvert. Called with the slot still intact, immediately after the
+ * flush site commits to html_reconvert_content and before it clears
+ * the slot. Coarse slots name their recorded cause (T2/T3); precise
+ * slots name try_local's last failure reason (T4/T5/T6). */
+static void
+macos9_reconvert_fullcause_count(int i)
+{
+	if (g_pending[i].coarse) {
+		if (g_pending[i].coarse_cause == 2)
+			g_fc_over++;
+		else
+			g_fc_nonode++;
+	} else {
+		switch (g_fc_reason) {
+		case 1: g_fc_kind++; break;
+		case 2: g_fc_local++; break;
+		case 3: g_fc_two++; break;
+		default:
+			break;
+		}
+	}
+	g_fc_total++;
+}
