 		s_convert_start_us = 0.0;
 	}
 	macos9_html_reformat_seq = 0; /* fixes560: fresh reflow-storm count per load */
@@ -3344,6 +3353,49 @@
 static long g_reconv_ph_us[RECONV_PH_N];
 static long g_reconv_ph_n = 0;
 
+/* Patch 309 - per-content last-full-conversion cost in microseconds: the
+ * doc-20 stage-1 cost guard's budget. Seeded by the initial conversion's
+ * measured build time (html_box_convert_done). Reconverts do NOT refresh
+ * it: the RECONVPHASE accumulators they would be read from are cumulative
+ * per navigation and do not bracket the real build work (they read sub-ms
+ * on pages whose rebuild is hundreds of ms), so a reconvert-derived sample
+ * would be garbage. The initial conversion is a full build of the same
+ * tree, strictly more expensive than a reconvert (it includes parse), so
+ * using it as the budget errs toward the permissive side -- the guard trips
+ * later, never earlier, than a true reconvert-cost budget would. */
+#define HTML_FULLUS_N 16
+static struct { struct content *c; double us; } g_html_fullus[HTML_FULLUS_N];
+
+static void html_note_full_us(struct content *c, double us)
+{
+	int i;
+
+	if (c == NULL || us <= 0.0)
+		return;
+	for (i = 0; i < HTML_FULLUS_N; i++) {
+		if (g_html_fullus[i].c == c) {
+			g_html_fullus[i].us = us;
+			return;
+		}
+	}
+	for (i = HTML_FULLUS_N - 1; i > 0; i--)
+		g_html_fullus[i] = g_html_fullus[i - 1];
+	g_html_fullus[0].c = c;
+	g_html_fullus[0].us = us;
+}
+
+/* Latest measured full-conversion cost for this content in microseconds,
+ * or 0.0 when the content has no completed conversion on record. */
+double html_content_full_us(struct content *c)
+{
+	int i;
+
+	for (i = 0; i < HTML_FULLUS_N; i++)
+		if (g_html_fullus[i].c == c)
+			return g_html_fullus[i].us;
+	return 0.0;
+}
+
 static const char *g_reconv_ph_name[RECONV_PH_N] = {
 	"h1", "h3", "css", "pin", "build", "relink", "freeold", "reformat"
 };
