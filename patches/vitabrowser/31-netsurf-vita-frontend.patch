+ * along with this program.  If not, see <http://www.gnu.org/licenses/>.
+ */
+
+/**
+ * \file
+ * Vita frontend: the rectangle plot contract as coloured geometry.
+ *
+ * The monkey frontend (patches 25-27) turns one plot->rectangle call into a
+ * sequence of `PLOT RECT` / `PLOT POLY` lines: gradient bands, drop and
+ * inset shadow rects, transformed 4-corner quads and an OPAQUE bucket. That
+ * stream records geometry only. This module produces the SAME sequence with
+ * the colour and paint decision each piece needs, so a pixel backend
+ * (vita2d, or a test sink) can render it. It has no platform dependencies.
+ *
+ * Invariant (checked by tools/test_vita_plotter.c against the real monkey
+ * plot.c): formatting the pieces emitted here as monkey lines reproduces the
+ * monkey stream byte for byte.
+ */
+
+#ifndef NETSURF_VITA_PLOT_GEOM_H
+#define NETSURF_VITA_PLOT_GEOM_H
+
+#include <stdbool.h>
+#include <stddef.h>
+
+#include "netsurf/types.h"
+#include "netsurf/plot_style.h"
+
+/** Band count for two-stop linear gradients (monkey MACMONK_GRAD_BANDS). */
+#define VITA_GRAD_BANDS 32
+
+/** Opacity bucket that means "fully opaque" (no OPAQUE token). */
+#define VITA_BUCKET_SOLID 4
+
+/** MacSurf's default drop-shadow colour: 50% grey (plotters.c 1363). */
+#define VITA_SHADOW_DEFAULT_COLOUR 0x666666
+
+/** What a piece of geometry is, for backends that care. */
+enum vita_geom_kind {
+	VITA_GEOM_FILL,		/**< the box fill itself */
+	VITA_GEOM_BAND,		/**< one gradient band */
+	VITA_GEOM_DROP_SHADOW,	/**< outer shadow, painted before the fill */
+	VITA_GEOM_INSET_SHADOW	/**< inset edge band, painted after the fill */
+};
+
+/**
+ * Receiver for the geometry of one rectangle plot.
+ *
+ * Pieces arrive in paint order. `paint` is false for a piece the stream
+ * records but that must not reach the screen (a stroke-only rectangle's
+ * fill, or an inset shadow with no colour, which MacSurf skips).
+ */
+struct vita_geom_sink {
+	void (*rect)(void *pw, enum vita_geom_kind kind,
+		     int x0, int y0, int x1, int y1,
+		     colour c, int bucket, bool paint);
+	void (*quad)(void *pw, const int x[4], const int y[4],
+		     colour c, int bucket, bool paint);
+	void *pw;
+};
+
+/**
+ * Map a style's opacity to MacSurf's stipple bucket (fixes49):
+ * 0 skip, 1 = 5-35%, 2 = 35-60%, 3 = 60-85%, 4 = solid.
+ * An unset (zero) opacity counts as opaque.
+ */
+int vita_geom_opacity_bucket(const plot_style_t *style);
+
+/**
+ * Decompose one plot->rectangle call into coloured geometry.
+ *
+ * \param style the plot style passed to the rectangle plotter
+ * \param rect the rectangle passed to the rectangle plotter
+ * \param sink receiver for the pieces, in paint order
+ */
+void vita_geom_rectangle(const plot_style_t *style, const struct rect *rect,
+			 const struct vita_geom_sink *sink);
+
+/**
+ * Format a rect piece as its monkey stream line, without the "PLOT "
+ * prefix: `RECT X0 .. Y1 ..`, plus ` OPAQUE n` when not solid.
+ *
+ * Lets the frontend emit the same text stream as nsmonkey (for on-device
+ * diffing against the desktop goldens) and lets the host test compare it.
+ *
+ * \return the snprintf result
+ */
+int vita_geom_format_rect(char *buf, size_t len, int x0, int y0, int x1,
+			  int y1, int bucket);
+
+/** Format a quad piece as its monkey `POLY ...` stream line. */
+int vita_geom_format_quad(char *buf, size_t len, const int x[4],
+			  const int y[4], int bucket);
+
+#endif
