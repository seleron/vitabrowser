+ * along with this program.  If not, see <http://www.gnu.org/licenses/>.
+ */
+
+/**
+ * \file
+ * Vita frontend: replay a recorded monkey plot stream through vita2d.
+ */
+
+#include <stdio.h>
+#include <string.h>
+
+#include "netsurf/types.h"
+
+#include "vita/plot_geom.h"
+#include "vita/plot.h"
+#include "vita/replay.h"
+
+/** Fill palette (NetSurf 0xBBGGRR), cycled per filled op. */
+static const colour replay_palette[] = {
+	0xf0e0d0, 0xd0e8f0, 0xd8f0d0, 0xe8d8f0, 0xd0f0f0, 0xf0f0c8
+};
+#define REPLAY_PALETTE_SIZE \
+	(sizeof(replay_palette) / sizeof(replay_palette[0]))
+
+/** Default text size for replayed text; the stream records none. */
+#define REPLAY_TEXT_PX 16.0f
+
+static unsigned int replay_fill_index;
+
+static colour next_fill(void)
+{
+	colour c = replay_palette[replay_fill_index % REPLAY_PALETTE_SIZE];
+	replay_fill_index++;
+	return c;
+}
+
+/** Parse the optional " OPAQUE n" suffix; solid when absent. */
+static int parse_bucket(const char *line)
+{
+	const char *op = strstr(line, " OPAQUE ");
+	int b;
+
+	if (op == NULL || sscanf(op, " OPAQUE %d", &b) != 1)
+		return VITA_BUCKET_SOLID;
+	return b;
+}
+
+/* exported interface documented in vita/replay.h */
+void vita_replay_line(const char *line, struct vita_replay_stats *stats)
+{
+	struct vita_replay_stats dummy;
+	int x0, y0, x1, y1;
+
+	if (stats == NULL)
+		stats = &dummy;
+	if (strncmp(line, "PLOT ", 5) != 0)
+		return;
+	line += 5;
+
+	if (sscanf(line, "CLIP X0 %d Y0 %d X1 %d Y1 %d",
+		   &x0, &y0, &x1, &y1) == 4) {
+		vita_plot_set_clip(x0, y0, x1, y1);
+		stats->clip++;
+	} else if (sscanf(line, "RECT X0 %d Y0 %d X1 %d Y1 %d",
+			  &x0, &y0, &x1, &y1) == 4) {
+		vita_plot_fill_rect(x0, y0, x1, y1, next_fill(),
+				    parse_bucket(line));
+		stats->rect++;
+	} else if (strncmp(line, "POLY X0", 7) == 0) {
+		int x[4], y[4];
+		if (sscanf(line, "POLY X0 %d Y0 %d X1 %d Y1 %d "
+			   "X2 %d Y2 %d X3 %d Y3 %d",
+			   &x[0], &y[0], &x[1], &y[1],
+			   &x[2], &y[2], &x[3], &y[3]) == 8) {
+			vita_plot_fill_quad(x, y, next_fill(),
+					    parse_bucket(line));
+			stats->poly++;
+		} else {
+			stats->skipped++;
+		}
+	} else if (sscanf(line, "LINE X0 %d Y0 %d X1 %d Y1 %d",
+			  &x0, &y0, &x1, &y1) == 4) {
+		vita_plot_line(x0, y0, x1, y1, 1, 0x404040);
+		stats->line++;
+	} else if (sscanf(line, "TEXT X %d Y %d STR ", &x0, &y0) == 2) {
+		const char *s = strstr(line, " STR ");
+		size_t len;
+		s = (s != NULL) ? s + 5 : "";
+		len = strcspn(s, "\r\n");
+		vita_plot_text(x0, y0, s, len, 0x000000,
+			       vita_plot_pgf_scale(REPLAY_TEXT_PX));
+		stats->text++;
+	} else if (sscanf(line, "DISC X %d Y %d RADIUS %d",
+			  &x0, &y0, &x1) == 3) {
+		/* Placeholder: the disc's bounding square at 50% coverage. */
+		vita_plot_fill_rect(x0 - x1, y0 - x1, x0 + x1, y0 + x1,
+				    next_fill(), 2);
+		stats->disc++;
+	} else if (sscanf(line, "BITMAP X %d Y %d WIDTH %d HEIGHT %d",
+			  &x0, &y0, &x1, &y1) == 4) {
+		/* Image placeholder: the stream has no pixels. */
+		vita_plot_fill_rect(x0, y0, x0 + x1, y0 + y1, 0xc0c0c0,
+				    VITA_BUCKET_SOLID);
+		stats->bitmap++;
+	} else {
+		/* ARC, POLYGON VERTICIES, PATH: counts only, no geometry. */
+		stats->skipped++;
+	}
+}
+
+/* exported interface documented in vita/replay.h */
+void vita_replay_stream(const char *stream, struct vita_replay_stats *stats)
+{
+	char line[1024];
+
+	replay_fill_index = 0;
+	while (*stream != '\0') {
+		size_t len = strcspn(stream, "\n");
+		size_t copy = (len < sizeof(line) - 1) ? len : sizeof(line) - 1;
+		memcpy(line, stream, copy);
+		line[copy] = '\0';
+		vita_replay_line(line, stats);
+		stream += len;
+		if (*stream == '\n')
+			stream++;
+	}
+}
