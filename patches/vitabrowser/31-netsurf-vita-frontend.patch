diff --git a/frontends/vita/layout.c b/frontends/vita/layout.c
new file mode 100644
index 000000000..50b43b838
--- /dev/null
+++ b/frontends/vita/layout.c
@@ -0,0 +1,181 @@
+/*
+ * Copyright 2026 VitaBrowser contributors
+ *
+ * This file is part of NetSurf, http://www.netsurf-browser.org/
+ *
+ * NetSurf is free software; you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation; version 2 of the License.
+ *
+ * NetSurf is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+ * GNU General Public License for more details.
+ *
+ * You should have received a copy of the GNU General Public License
+ * along with this program.  If not, see <http://www.gnu.org/licenses/>.
+ */
+
+/**
+ * \file
+ * Vita frontend: text measurement with the system PGF font.
+ *
+ * The plotters draw text with vita2d's PGF renderer, so layout must measure
+ * with the same font or lines overflow. Per-glyph advances are measured
+ * once at scale 1.0 and scaled per font size: the core measures text far
+ * more often than it draws it, and PGF measurement walks glyph bitmaps.
+ * No kerning, which PGF text rendering does not apply either.
+ */
+
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+#include <string.h>
+
+#include <vita2d.h>
+
+#include "utils/errors.h"
+#include "utils/utf8.h"
+#include "netsurf/plot_style.h"
+#include "netsurf/layout.h"
+
+#include "vita/plot.h"
+#include "vita/layout.h"
+
+/** Advance widths at scale 1.0 for printable ASCII; < 0 = not measured. */
+static int ascii_advance[128];
+static bool ascii_ready;
+
+/**
+ * Advance of one UTF-8 character at scale 1.0.
+ *
+ * Measured as width("a" c "a") - width("aa"), because PGF reports a bare
+ * space, or any glyph with no ink at its edges, narrower than it advances.
+ */
+static int glyph_advance(vita2d_pgf *font, const char *utf8, size_t len)
+{
+	char buf[16];
+	int with, without;
+
+	if (len > sizeof(buf) - 3)
+		len = sizeof(buf) - 3;
+	buf[0] = 'a';
+	memcpy(buf + 1, utf8, len);
+	buf[len + 1] = 'a';
+	buf[len + 2] = '\0';
+	with = vita2d_pgf_text_width(font, 1.0f, buf);
+	without = vita2d_pgf_text_width(font, 1.0f, "aa");
+	return (with > without) ? with - without : 0;
+}
+
+static void ascii_init(vita2d_pgf *font)
+{
+	char c;
+
+	for (c = 0; c < 0x20; c++)
+		ascii_advance[(int)c] = 0;
+	for (c = 0x20; c < 0x7f; c++)
+		ascii_advance[(int)c] = glyph_advance(font, &c, 1);
+	ascii_advance[0x7f] = 0;
+	ascii_ready = true;
+}
+
+/** Advance at scale 1.0 of the character at string[idx]. */
+static int char_advance(const char *string, size_t length, size_t idx,
+			size_t next)
+{
+	vita2d_pgf *font = vita_plot_font();
+	unsigned char c = (unsigned char)string[idx];
+
+	if (font == NULL)
+		return 0;
+	if (!ascii_ready)
+		ascii_init(font);
+	if (c < 0x80)
+		return ascii_advance[c];
+	return glyph_advance(font, string + idx, next - idx);
+}
+
+/** Scale from advances at 1.0 to pixels for this font style. */
+static float style_scale(const plot_font_style_t *fstyle)
+{
+	return vita_plot_pgf_scale(vita_plot_font_px(fstyle->size));
+}
+
+static nserror vita_font_width(const plot_font_style_t *fstyle,
+			       const char *string, size_t length, int *width)
+{
+	float scale = style_scale(fstyle);
+	size_t idx = 0;
+	int units = 0;
+
+	while (idx < length) {
+		size_t next = utf8_next(string, length, idx);
+		units += char_advance(string, length, idx, next);
+		idx = next;
+	}
+	*width = (int)((float)units * scale + 0.5f);
+	return NSERROR_OK;
+}
+
+static nserror vita_font_position(const plot_font_style_t *fstyle,
+				  const char *string, size_t length,
+				  int x, size_t *char_offset, int *actual_x)
+{
+	float scale = style_scale(fstyle);
+	size_t idx = 0;
+	float pos = 0;
+
+	/* Stop at the character boundary nearest x. */
+	while (idx < length) {
+		size_t next = utf8_next(string, length, idx);
+		float adv = (float)char_advance(string, length, idx, next) *
+			scale;
+		if ((float)x < pos + adv / 2)
+			break;
+		pos += adv;
+		idx = next;
+	}
+	*char_offset = idx;
+	*actual_x = (int)(pos + 0.5f);
+	return NSERROR_OK;
+}
+
+static nserror vita_font_split(const plot_font_style_t *fstyle,
+			       const char *string, size_t length,
+			       int x, size_t *char_offset, int *actual_x)
+{
+	float scale = style_scale(fstyle);
+	size_t idx = 0;
+	float pos = 0;
+	float last_space_x = 0;
+	size_t last_space_idx = 0;
+
+	/* Same contract as the framebuffer frontend: break at the last space
+	 * before the width is exceeded; with no such space, don't break. */
+	while (idx < length) {
+		size_t next = utf8_next(string, length, idx);
+		if (string[idx] == ' ') {
+			last_space_x = pos;
+			last_space_idx = idx;
+		}
+		pos += (float)char_advance(string, length, idx, next) * scale;
+		if (pos > (float)x && last_space_idx != 0) {
+			*char_offset = last_space_idx;
+			*actual_x = (int)(last_space_x + 0.5f);
+			return NSERROR_OK;
+		}
+		idx = next;
+	}
+	*char_offset = idx;
+	*actual_x = (int)(pos + 0.5f);
+	return NSERROR_OK;
+}
+
+static struct gui_layout_table layout_table = {
+	.width = vita_font_width,
+	.position = vita_font_position,
+	.split = vita_font_split,
+};
+
+struct gui_layout_table *vita_layout_table = &layout_table;
