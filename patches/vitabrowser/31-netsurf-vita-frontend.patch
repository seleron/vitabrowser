+/**
+ * \file
+ * Vita frontend: libvita2d plotters.
+ *
+ * The plotter table drives the rectangle contract through vita/plot_geom.c.
+ * The primitives below are what the table and the plot-stream replayer
+ * (vita/replay.c) both draw with, so a recorded monkey stream and a live
+ * engine render reach the GPU through the same calls.
+ */
+
+#ifndef NETSURF_VITA_PLOT_H
+#define NETSURF_VITA_PLOT_H
+
+#include <stddef.h>
+
+#include "utils/errors.h"
+#include "netsurf/types.h"
+
+struct plotter_table;
+
+/** Screen size of the Vita display. */
+#define VITA_SCREEN_WIDTH 960
+#define VITA_SCREEN_HEIGHT 544
+
+/** The vita2d plotter table. */
+extern const struct plotter_table *vita_plotters;
+
+/**
+ * Load the plotters' resources (the system PGF font).
+ * Call after vita2d_init().
+ */
+nserror vita_plot_init(void);
+
+/** Release the plotters' resources. */
+void vita_plot_fini(void);
+
+/** Convert a NetSurf colour and opacity bucket to a vita2d RGBA8 value. */
+unsigned int vita_plot_rgba(colour c, int bucket);
+
+/** Set the clip rectangle (x1/y1 exclusive), clamped to the screen. */
+void vita_plot_set_clip(int x0, int y0, int x1, int y1);
+
+/** Fill an axis-aligned rectangle (x1/y1 exclusive). Bucket 0 is a no-op. */
+void vita_plot_fill_rect(int x0, int y0, int x1, int y1, colour c,
+			 int bucket);
+
+/** Fill a 4-corner quad as a triangle fan. Bucket 0 is a no-op. */
+void vita_plot_fill_quad(const int x[4], const int y[4], colour c,
+			 int bucket);
+
+/** Draw a line of the given width in pixels. */
+void vita_plot_line(int x0, int y0, int x1, int y1, int width, colour c);
+
+/** Draw `length` bytes of UTF-8 text with its baseline at y. */
+void vita_plot_text(int x, int y, const char *text, size_t length,
+		    colour c, float scale);
+
+/** Font size in pixels for a plot font style size (pt, fixed point). */
+float vita_plot_font_px(int size);
+
+/** PGF scale factor that renders a font `px` pixels high. */
+float vita_plot_pgf_scale(float px);
+
+/** The system font the plotters draw with; NULL before vita_plot_init(). */
+struct vita2d_pgf *vita_plot_font(void);
+
+#endif
