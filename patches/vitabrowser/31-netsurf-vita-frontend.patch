+/**
+ * \file
+ * Vita frontend: the rectangle plot contract as coloured geometry.
+ *
+ * Every branch here mirrors monkey_plot_rectangle (frontends/monkey/plot.c,
+ * patches 25-27) statement for statement, in the same order, so the
+ * geometry cannot drift from the verified stream. Where monkey computes a
+ * value and drops it (the per-band gradient colour), we pass it on. Where
+ * MacSurf's own plotter paints differently from what the stream records,
+ * the difference is carried in the `paint` flag, never in the geometry.
+ */
+
+#include <stdint.h>
+#include <stdbool.h>
+#include <stdio.h>
+
+#include "vita/plot_geom.h"
+
+/* exported interface documented in vita/plot_geom.h */
+int vita_geom_format_rect(char *buf, size_t len, int x0, int y0, int x1,
+			  int y1, int bucket)
+{
+	if (bucket == VITA_BUCKET_SOLID)
+		return snprintf(buf, len, "RECT X0 %d Y0 %d X1 %d Y1 %d",
+				x0, y0, x1, y1);
+	return snprintf(buf, len, "RECT X0 %d Y0 %d X1 %d Y1 %d OPAQUE %d",
+			x0, y0, x1, y1, bucket);
+}
+
+/* exported interface documented in vita/plot_geom.h */
+int vita_geom_format_quad(char *buf, size_t len, const int x[4],
+			  const int y[4], int bucket)
+{
+	if (bucket == VITA_BUCKET_SOLID)
+		return snprintf(buf, len,
+			"POLY X0 %d Y0 %d X1 %d Y1 %d X2 %d Y2 %d X3 %d Y3 %d",
+			x[0], y[0], x[1], y[1], x[2], y[2], x[3], y[3]);
+	return snprintf(buf, len,
+		"POLY X0 %d Y0 %d X1 %d Y1 %d X2 %d Y2 %d X3 %d Y3 %d OPAQUE %d",
+		x[0], y[0], x[1], y[1], x[2], y[2], x[3], y[3], bucket);
+}
+
+/* MacSurf plotters.c 994: Q15 sine table, 0..90 degrees (copied verbatim
+ * from the monkey plotter, which copied it from MacSurf). */
+static const int16_t vita_sin_q15_table[91] = {
+    0,   572,  1144,  1715,  2286,  2856,  3425,  3993,  4560,  5126,
+  5690,  6252,  6813,  7371,  7927,  8481,  9032,  9580, 10126, 10668,
+ 11207, 11743, 12275, 12803, 13328, 13848, 14365, 14876, 15384, 15886,
+ 16384, 16877, 17364, 17847, 18324, 18795, 19261, 19720, 20174, 20622,
+ 21063, 21498, 21926, 22348, 22763, 23170, 23571, 23965, 24351, 24730,
+ 25102, 25466, 25822, 26170, 26510, 26842, 27166, 27482, 27789, 28088,
+ 28378, 28660, 28932, 29197, 29452, 29698, 29935, 30163, 30382, 30592,
+ 30792, 30983, 31164, 31336, 31499, 31651, 31795, 31928, 32052, 32166,
+ 32270, 32365, 32449, 32524, 32588, 32643, 32688, 32723, 32748, 32763,
+ 32767
+};
+
+static int vita_sin_q15(int deg)
+{
+	while (deg < 0) deg += 360;
+	while (deg >= 360) deg -= 360;
+	if (deg <=  90) return  vita_sin_q15_table[deg];
+	if (deg <= 180) return  vita_sin_q15_table[180 - deg];
+	if (deg <= 270) return -vita_sin_q15_table[deg - 180];
+	return -vita_sin_q15_table[360 - deg];
+}
+
+static int vita_cos_q15(int deg)
+{
+	return vita_sin_q15(deg + 90);
+}
+
+/* MacSurf plotters.c 1043: unpack the -macsurf-transform packed value.
+ * bits 31=percent-translate, 30..16=rotation Q10.6 (15-bit signed),
+ * 15..8=tx int8, 7..0=ty int8. */
+static void vita_transform_unpack(int transform, int *rot_deg, int *tx,
+				  int *ty)
+{
+	int32_t rot_q106;
+	int deg;
+	int is_pct = (int)(((uint32_t)transform >> 31) & 1);
+	int8_t tx_px = (int8_t)((((uint32_t)transform) >> 8) & 0xff);
+	int8_t ty_px = (int8_t)( ((uint32_t)transform)       & 0xff);
+
+	rot_q106 = (int32_t)((((uint32_t)transform) >> 16) & 0x7fff);
+	if (rot_q106 & 0x4000) rot_q106 -= 0x8000;
+	deg = (int)(rot_q106 / 64);
+	while (deg < 0)   deg += 360;
+	while (deg >= 360) deg -= 360;
+
+	*rot_deg = deg;
+	if (is_pct) {
+		*tx = 0;
+		*ty = 0;
+	} else {
+		*tx = (int)tx_px;
+		*ty = (int)ty_px;
+	}
+}
+
+/* MacSurf plotters.c 1077: rotate a point around (cx,cy) then translate.
+ * Exact for the four cardinals, Q15 affine otherwise. */
+static void vita_transform_point(int *px, int *py, int cx, int cy,
+				 int rot_deg, int tx, int ty)
+{
+	int dx = *px - cx;
+	int dy = *py - cy;
+	int s = vita_sin_q15(rot_deg);
+	int c = vita_cos_q15(rot_deg);
+	int nx, ny;
+
+	switch (rot_deg) {
+	case 0:    nx = dx;  ny = dy;  break;
+	case 90:   nx = -dy; ny = dx;  break;
+	case 180:  nx = -dx; ny = -dy; break;
+	case 270:  nx = dy;  ny = -dx; break;
+	default:
+		nx = (dx * c - dy * s + 16384) >> 15;
+		ny = (dx * s + dy * c + 16384) >> 15;
+		break;
+	}
+	*px = cx + nx + tx;
+	*py = cy + ny + ty;
+}
+
+/* exported interface documented in vita/plot_geom.h */
+int vita_geom_opacity_bucket(const plot_style_t *style)
+{
+	plot_style_fixed op = style->opacity;
+	if (op == 0) op = (plot_style_fixed)PLOT_STYLE_SCALE;
+	if (op < (plot_style_fixed)(PLOT_STYLE_SCALE / 20))
+		return 0;
+	if (op < (plot_style_fixed)((PLOT_STYLE_SCALE * 35) / 100))
+		return 1;
+	if (op < (plot_style_fixed)((PLOT_STYLE_SCALE * 60) / 100))
+		return 2;
+	if (op < (plot_style_fixed)((PLOT_STYLE_SCALE * 85) / 100))
+		return 3;
+	return VITA_BUCKET_SOLID;
+}
+
+static void emit_rect(const struct vita_geom_sink *sink,
+		      enum vita_geom_kind kind, struct rect r,
+		      colour c, int bucket, bool paint)
+{
+	sink->rect(sink->pw, kind, r.x0, r.y0, r.x1, r.y1,
+		   c & 0xffffff, bucket, paint);
+}
+
+/* Drop shadow colour: the style's, or MacSurf's 50% grey when unset. */
+static colour drop_colour(const plot_style_t *style)
+{
+	if (style->box_shadow_color != 0)
+		return style->box_shadow_color;
+	return VITA_SHADOW_DEFAULT_COLOUR;
+}
+
+/* Monkey macmonk_paint_drop / MacSurf plotters.c 1346. */
+static void paint_drop(const plot_style_t *style, struct rect r,
+		       const struct vita_geom_sink *sink)
+{
+	int hoff = (int)(style->box_shadow >> PLOT_STYLE_RADIX);
+	int voff = (int)(style->box_shadow_y >> PLOT_STYLE_RADIX);
+
+	if (hoff < -16) hoff = -16;
+	if (hoff >  16) hoff =  16;
+	if (voff < -16) voff = -16;
+	if (voff >  16) voff =  16;
+	if (hoff != 0 || voff != 0) {
+		r.x0 += hoff;
+		r.x1 += hoff;
+		r.y0 += voff;
+		r.y1 += voff;
+		emit_rect(sink, VITA_GEOM_DROP_SHADOW, r, drop_colour(style),
+			  VITA_BUCKET_SOLID, true);
+	}
+}
+
+/* Monkey macmonk_paint_inset / MacSurf plotters.c 1972. MacSurf skips the
+ * paint when box_shadow_color is 0 (the fixes225 dark-wash regression); the
+ * stream still records the bands, so they are emitted with paint = false. */
+static void paint_inset(const plot_style_t *style, struct rect r,
+			const struct vita_geom_sink *sink)
+{
+	int hoff = (int)(style->box_shadow >> PLOT_STYLE_RADIX);
+	int voff = (int)(style->box_shadow_y >> PLOT_STYLE_RADIX);
+	int bw = r.x1 - r.x0;
+	int bh = r.y1 - r.y0;
+	colour c = style->box_shadow_color;
+	bool paint = (c != 0);
+	struct rect edge;
+
+	if (hoff >  bw) hoff =  bw;
+	if (hoff < -bw) hoff = -bw;
+	if (voff >  bh) voff =  bh;
+	if (voff < -bh) voff = -bh;
+
+	if (hoff > 0) {
+		edge = r;
+		edge.x1 = r.x0 + hoff;
+		emit_rect(sink, VITA_GEOM_INSET_SHADOW, edge, c,
+			  VITA_BUCKET_SOLID, paint);
+	} else if (hoff < 0) {
+		edge = r;
+		edge.x0 = r.x1 + hoff;
+		emit_rect(sink, VITA_GEOM_INSET_SHADOW, edge, c,
+			  VITA_BUCKET_SOLID, paint);
+	}
+	if (voff > 0) {
+		edge = r;
+		edge.y1 = r.y0 + voff;
+		emit_rect(sink, VITA_GEOM_INSET_SHADOW, edge, c,
+			  VITA_BUCKET_SOLID, paint);
+	} else if (voff < 0) {
+		edge = r;
+		edge.y0 = r.y1 + voff;
+		emit_rect(sink, VITA_GEOM_INSET_SHADOW, edge, c,
+			  VITA_BUCKET_SOLID, paint);
+	}
+}
+
+/* Monkey macmonk_fill_transformed / MacSurf plotters.c 1174-1260. */
+static void fill_transformed(const plot_style_t *style, struct rect r,
+			     int ob, const struct vita_geom_sink *sink)
+{
+	int rot_deg, tx, ty;
+	int cx, cy;
+	int sx_q88, sy_q88;
+	int x[4], y[4];
+	int i;
+
+	vita_transform_unpack(style->transform, &rot_deg, &tx, &ty);
+	sx_q88 = (int)((((uint32_t)style->transform_b) >> 16) & 0xffff);
+	sy_q88 = (int)( ((uint32_t)style->transform_b)        & 0xffff);
+	if (sx_q88 == 0) sx_q88 = 256;
+	if (sy_q88 == 0) sy_q88 = 256;
+
+	cx = (r.x0 + r.x1) / 2;
+	cy = (r.y0 + r.y1) / 2;
+
+	x[0] = r.x0;  y[0] = r.y0;
+	x[1] = r.x1;  y[1] = r.y0;
+	x[2] = r.x1;  y[2] = r.y1;
+	x[3] = r.x0;  y[3] = r.y1;
+	if (sx_q88 != 256 || sy_q88 != 256) {
+		for (i = 0; i < 4; i++) {
+			int dx = x[i] - cx;
+			int dy = y[i] - cy;
+			x[i] = cx + (dx * sx_q88) / 256;
+			y[i] = cy + (dy * sy_q88) / 256;
+		}
+	}
+	for (i = 0; i < 4; i++) {
+		vita_transform_point(&x[i], &y[i], cx, cy, rot_deg, tx, ty);
+	}
+	sink->quad(sink->pw, x, y, style->fill_colour & 0xffffff, ob,
+		   ob != 0);
+}
+
+/* exported interface documented in vita/plot_geom.h */
+void vita_geom_rectangle(const plot_style_t *style, const struct rect *rect,
+			 const struct vita_geom_sink *sink)
+{
+	bool horizontal;
+	int n = VITA_GRAD_BANDS;
+	int span, i;
+	bool has_shadow = (style->box_shadow != 0 || style->box_shadow_y != 0)
+			&& style->fill_type != PLOT_OP_TYPE_NONE;
+	bool filled = (style->fill_type != PLOT_OP_TYPE_NONE);
+	struct rect r = *rect;
+
+	/* patch 27: non-identity transform -> 4-corner quad. */
+	if (style->fill_type != PLOT_OP_TYPE_NONE &&
+			(style->transform != 0 ||
+			 (style->transform_b != 0 &&
+			  style->transform_b != (int)0x01000100))) {
+		fill_transformed(style, r, vita_geom_opacity_bucket(style),
+				 sink);
+		return;
+	}
+
+	if (has_shadow && style->box_shadow_inset == false) {
+		paint_drop(style, r, sink);
+	}
+
+	if (style->fill_type != PLOT_OP_TYPE_LINEAR_GRADIENT &&
+			style->fill_type != PLOT_OP_TYPE_LINEAR_GRADIENT_H) {
+		/* Solid, dot, dash and radial fills are one flat rect (the
+		 * radial gradient has no bandable axis: its start colour). */
+		int ob = vita_geom_opacity_bucket(style);
+		emit_rect(sink, VITA_GEOM_FILL, r, style->fill_colour, ob,
+			  filled && ob != 0);
+		if (has_shadow && style->box_shadow_inset)
+			paint_inset(style, r, sink);
+		return;
+	}
+	horizontal = (style->fill_type == PLOT_OP_TYPE_LINEAR_GRADIENT_H);
+	span = horizontal ? (r.x1 - r.x0) : (r.y1 - r.y0);
+	if (span <= 0) {
+		emit_rect(sink, VITA_GEOM_FILL, r, style->fill_colour,
+			  VITA_BUCKET_SOLID, true);
+		if (has_shadow && style->box_shadow_inset)
+			paint_inset(style, r, sink);
+		return;
+	}
+
+	/* NetSurf colour: R in the low byte, then G, then B. Same integer
+	 * interpolation monkey computes (and discards) per band. */
+	{
+		uint32_t c1 = (uint32_t)style->fill_colour & 0xFFFFFF;
+		uint32_t c2 = (uint32_t)style->fill_colour2 & 0xFFFFFF;
+		int r1 = (int)(c1 & 0xFF), g1 = (int)((c1 >> 8) & 0xFF),
+		    b1 = (int)((c1 >> 16) & 0xFF);
+		int r2 = (int)(c2 & 0xFF), g2 = (int)((c2 >> 8) & 0xFF),
+		    b2 = (int)((c2 >> 16) & 0xFF);
+		for (i = 0; i < n; i++) {
+			struct rect br = r;
+			int t = (i * 255) / n;
+			int fr = r1 + ((r2 - r1) * t) / 255;
+			int fg = g1 + ((g2 - g1) * t) / 255;
+			int fb = b1 + ((b2 - b1) * t) / 255;
+			if (horizontal) {
+				br.x0 = r.x0 + span * i / n;
+				br.x1 = r.x0 + span * (i + 1) / n;
+			} else {
+				br.y0 = r.y0 + span * i / n;
+				br.y1 = r.y0 + span * (i + 1) / n;
+			}
+			if (br.x1 <= br.x0 || br.y1 <= br.y0)
+				continue;
+			emit_rect(sink, VITA_GEOM_BAND, br,
+				  (colour)((fb << 16) | (fg << 8) | fr),
+				  VITA_BUCKET_SOLID, true);
+		}
+	}
+	if (has_shadow && style->box_shadow_inset)
+		paint_inset(style, r, sink);
+}
