diff --git a/frontends/vita/Makefile b/frontends/vita/Makefile
new file mode 100644
index 000000000..1e7be53f9
--- /dev/null
+++ b/frontends/vita/Makefile
@@ -0,0 +1,96 @@
+#
+# Makefile for NetSurf PS Vita target
+#
+# This file is part of NetSurf
+
+# ----------------------------------------------------------------------------
+# Vita flag setup
+# ----------------------------------------------------------------------------
+
+CWARNFLAGS += -Werror
+
+# compat/ shadows system headers the SDK declares but does not implement.
+CFLAGS += -std=c99 -g -Ifrontends/vita/compat \
+	  -D_POSIX_C_SOURCE=200809L \
+	  -D_XOPEN_SOURCE=700 \
+	  -D_DEFAULT_SOURCE \
+	  -DNETSURF_VITA_START_PAGE=\"$(NETSURF_VITA_START_PAGE)\"
+
+ifeq ($(VITA_HOST_SIM),YES)
+# Host simulator (see Makefile.tools): stand-in SDK headers and library.
+CFLAGS += -I$(VITA_SIM_INCLUDE)
+LDFLAGS += $(VITA_SIM_LIB) $(shell pkg-config --libs freetype2) \
+	-lpcre2-posix -lpcre2-8 -lz -lm
+else
+# vitaSDK libraries. vita2d draws through the GXM and needs PGF for the
+# system font; the SceXxx_stub archives resolve the firmware imports.
+LDFLAGS += -Wl,-q \
+	-lvita2d -lfreetype -lpng -ljpeg -lbz2 -lz \
+	-lpcre2-posix -lpcre2-8 \
+	-lSceDisplay_stub -lSceGxm_stub -lSceSysmodule_stub -lSceCtrl_stub \
+	-lScePgf_stub -lScePvf_stub -lSceCommonDialog_stub -lSceAppUtil_stub \
+	-lSceAppMgr_stub \
+	-lm
+endif
+
+# ---------------------------------------------------------------------------
+# Target setup
+# ---------------------------------------------------------------------------
+
+VITA_RESOURCES_DIR := $(FRONTEND_RESOURCES_DIR)
+
+# The filter and target for split messages
+MESSAGES_FILTER=any
+MESSAGES_TARGET=$(VITA_RESOURCES_DIR)
+
+# ----------------------------------------------------------------------------
+# Source file setup
+# ----------------------------------------------------------------------------
+
+# S_FRONTEND are sources purely for the Vita build
+S_FRONTEND := main.c window.c schedule.c fetch.c file.c layout.c bitmap.c \
+	plot.c plot_geom.c replay.c
+
+# This is the final source build list
+# Note this is deliberately *not* expanded here as common and image
+#   are not yet available
+SOURCES = $(S_COMMON) $(S_IMAGE) $(S_BROWSER) $(S_FRONTEND)
+ifeq ($(VITA_HOST_SIM),YES)
+EXETARGET := nsvita-sim
+else
+EXETARGET := nsvita.elf
+endif
+
+# ----------------------------------------------------------------------------
+# Install target
+# ----------------------------------------------------------------------------
+
+install-vita:
+
+# ----------------------------------------------------------------------------
+# Package target: nsvita.elf -> eboot.bin -> VitaBrowser.vpk
+#
+# VITA_TITLE_ID is nine characters, four letters + five digits, and must be
+# unique on the device. VITA_EXTRA_FILES adds "src=dst" pairs to the VPK;
+# the VitaBrowser repo's tools/build-vita.sh passes the test pages that way.
+# ----------------------------------------------------------------------------
+
+VITA_TITLE_ID ?= VBRW00001
+VITA_APP_NAME ?= VitaBrowser
+VITA_PKGDIR := $(OBJROOT)/vpk
+VITA_RES_FILES := default.css quirks.css adblock.css internal.css \
+	Messages welcome.html credits.html licence.html
+
+package-vita: $(EXETARGET)
+	$(VQ)echo "     VPK: VitaBrowser.vpk"
+	$(Q)$(MKDIR) -p $(VITA_PKGDIR)
+	$(Q)$(VITA_ELF_CREATE) $(EXETARGET) $(VITA_PKGDIR)/nsvita.velf
+	$(Q)$(VITA_MAKE_FSELF) -s $(VITA_PKGDIR)/nsvita.velf \
+		$(VITA_PKGDIR)/eboot.bin
+	$(Q)$(VITA_MKSFOEX) -s TITLE_ID=$(VITA_TITLE_ID) "$(VITA_APP_NAME)" \
+		$(VITA_PKGDIR)/param.sfo
+	$(Q)$(VITA_PACK_VPK) -s $(VITA_PKGDIR)/param.sfo \
+		-b $(VITA_PKGDIR)/eboot.bin \
+		$(foreach f,$(VITA_RES_FILES),-a $(VITA_RESOURCES_DIR)/$(f)=res/$(f)) \
+		$(foreach p,$(VITA_EXTRA_FILES),-a $(p)) \
+		VitaBrowser.vpk
diff --git a/frontends/vita/Makefile.defaults b/frontends/vita/Makefile.defaults
new file mode 100644
index 000000000..9c3a436a0
--- /dev/null
+++ b/frontends/vita/Makefile.defaults
@@ -0,0 +1,41 @@
+# ----------------------------------------------------------------------------
+# Vita-specific options
+# ----------------------------------------------------------------------------
+
+# The first milestone fetches bundled pages from app0: through the file
+# fetcher; networking (curl + TLS) and JavaScript (QuickJS, not Duktape)
+# are later Phase 1 items. See docs/phase-0/09-vita-frontend.md.
+NETSURF_USE_CURL := NO
+NETSURF_USE_OPENSSL := NO
+NETSURF_USE_DUKTAPE := NO
+
+# Image decoders that exist for the Vita: libnsgif / libnsbmp are built by
+# tools/build-vita.sh, libpng / libjpeg-turbo come from vdpm.
+NETSURF_USE_BMP := YES
+NETSURF_USE_GIF := YES
+NETSURF_USE_PNG := YES
+NETSURF_USE_JPEG := YES
+NETSURF_USE_JPEGXL := NO
+NETSURF_USE_WEBP := NO
+NETSURF_USE_NSSVG := NO
+NETSURF_USE_ROSPRITE := NO
+NETSURF_USE_RSVG := NO
+NETSURF_USE_VIDEO := NO
+NETSURF_USE_HARU_PDF := NO
+
+NETSURF_USE_NSPSL := YES
+NETSURF_USE_NSLOG := NO
+NETSURF_USE_UTF8PROC := YES
+# newlib carries iconv in libc.
+NETSURF_USE_LIBICONV_PLUG := YES
+
+# No disc cache yet: the memory card path and budget are undecided.
+NETSURF_FS_BACKING_STORE := NO
+
+# vita-elf-create needs the relocations; the ELF is never shipped as-is.
+NETSURF_STRIP_BINARY := NO
+
+# The page opened at start-up, relative to the app bundle.
+NETSURF_VITA_START_PAGE := file:///app0:/testpages/L1-layout-basics.html
+
+CFLAGS += -O2
diff --git a/frontends/vita/Makefile.tools b/frontends/vita/Makefile.tools
new file mode 100644
index 000000000..7e8a243af
--- /dev/null
+++ b/frontends/vita/Makefile.tools
@@ -0,0 +1,46 @@
+# -*- mode: makefile-gmake -*-
+##
+## vita target tool setup
+##
+## Cross-compiles with vitaSDK's arm-vita-eabi toolchain. VITASDK must name
+## the SDK (the vitaSDK convention); VITA_PREFIX is where the NetSurf
+## libraries were installed for the Vita (tools/build-vita.sh in the
+## VitaBrowser repo builds them there).
+##
+## VITA_HOST_SIM=YES instead builds the same sources for the build machine
+## against a stand-in SDK (VITA_SIM_INCLUDE headers, VITA_SIM_LIB
+## implementation), so the frontend can run without Vita hardware. It gets
+## its own object directory, build/<host>-vita-sim.
+
+ifeq ($(VITA_HOST_SIM),YES)
+
+SUBTARGET := -sim
+# Host engine libraries: the caller points PKG_CONFIG_PATH at them.
+PKG_CONFIG := pkg-config
+
+else
+
+ifeq ($(VITASDK),)
+  $(error VITASDK is not set: point it at the vitaSDK install, e.g. ~/vitasdk)
+endif
+
+VITA_PREFIX ?= $(VITASDK)/arm-vita-eabi
+
+CC := $(VITASDK)/bin/arm-vita-eabi-gcc
+CXX := $(VITASDK)/bin/arm-vita-eabi-g++
+STRIP := $(VITASDK)/bin/arm-vita-eabi-strip
+
+# Only the Vita prefixes: never let a host .pc file leak host -I/-L paths
+# into the cross build. --static because everything links statically (so
+# libpng's .pc must pull in -lz); --define-prefix as vitaSDK's own
+# arm-vita-eabi-pkg-config does, since SDK packages carry build-time prefixes.
+PKG_CONFIG := PKG_CONFIG_PATH= \
+	PKG_CONFIG_LIBDIR="$(VITA_PREFIX)/lib/pkgconfig:$(VITASDK)/arm-vita-eabi/lib/pkgconfig" \
+	PKG_CONFIG_SYSROOT_DIR= pkg-config --define-prefix --static
+
+VITA_ELF_CREATE := $(VITASDK)/bin/vita-elf-create
+VITA_MAKE_FSELF := $(VITASDK)/bin/vita-make-fself
+VITA_MKSFOEX := $(VITASDK)/bin/vita-mksfoex
+VITA_PACK_VPK := $(VITASDK)/bin/vita-pack-vpk
+
+endif
