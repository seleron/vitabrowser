+ * GNU General Public License for more details.
+ *
+ * You should have received a copy of the GNU General Public License
+ * along with this program.  If not, see <http://www.gnu.org/licenses/>.
+ */
+
+/**
+ * \file
+ * Vita frontend: replay a recorded monkey plot stream through vita2d.
+ *
+ * A `.plot` file (tools/plotstream.py) records geometry but no colour, so
+ * fills use a fixed palette cycled per op and text is black. The point is
+ * that each stream op reaches vita2d through the same primitive the live
+ * plotter uses: RECT -> fill_rect, POLY -> fill_quad, CLIP -> set_clip,
+ * LINE -> line, TEXT -> text.
+ */
+
+#ifndef NETSURF_VITA_REPLAY_H
+#define NETSURF_VITA_REPLAY_H
+
+#include <stddef.h>
+
+/** Counts of stream ops replayed, by kind. */
+struct vita_replay_stats {
+	unsigned int clip;
+	unsigned int rect;
+	unsigned int poly;
+	unsigned int line;
+	unsigned int text;
+	unsigned int disc;
+	unsigned int bitmap;
+	unsigned int skipped;	/**< PLOT ops with no replayable geometry */
+};
+
+/**
+ * Replay one stream line. Non-PLOT lines are ignored.
+ *
+ * \param line one line, with or without its trailing newline
+ * \param stats counters to update, may be NULL
+ */
+void vita_replay_line(const char *line, struct vita_replay_stats *stats);
+
+/**
+ * Replay a whole stream held in memory (NUL-terminated).
+ *
+ * \param stream the stream text
+ * \param stats counters to update, may be NULL
+ */
+void vita_replay_stream(const char *stream, struct vita_replay_stats *stats);
+
+#endif
