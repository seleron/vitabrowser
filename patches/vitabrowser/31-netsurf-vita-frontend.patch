diff --git a/frontends/vita/main.c b/frontends/vita/main.c
new file mode 100644
index 000000000..0416a5582
--- /dev/null
+++ b/frontends/vita/main.c
@@ -0,0 +1,239 @@
+/*
+ * Copyright 2026 VitaBrowser contributors
+ *
+ * This file is part of NetSurf, http://www.netsurf-browser.org/
+ *
+ * NetSurf is free software; you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation; version 2 of the License.
+ *
+ * NetSurf is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+ * GNU General Public License for more details.
+ *
+ * You should have received a copy of the GNU General Public License
+ * along with this program.  If not, see <http://www.gnu.org/licenses/>.
+ */
+
+/**
+ * \file
+ * Vita frontend: application entry point and main loop.
+ *
+ * First milestone: open a bundled test page from app0: through the core's
+ * file fetcher, lay it out with PGF metrics and paint it with the vita2d
+ * plotters. Controls: D-pad / left stick scroll, L / R step through the
+ * bundled test pages, START quits.
+ */
+
+#include <stdbool.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include <psp2/ctrl.h>
+#include <psp2/kernel/processmgr.h>
+#include <psp2/kernel/threadmgr.h>
+#include <vita2d.h>
+
+#include "utils/errors.h"
+#include "utils/messages.h"
+#include "utils/nsoption.h"
+#include "utils/nsurl.h"
+#include "netsurf/browser.h"
+#include "netsurf/browser_window.h"
+#include "netsurf/misc.h"
+#include "netsurf/netsurf.h"
+
+#include "vita/bitmap.h"
+#include "vita/fetch.h"
+#include "vita/file.h"
+#include "vita/layout.h"
+#include "vita/plot.h"
+#include "vita/schedule.h"
+#include "vita/window.h"
+
+/* Memory layout, read by the vitaSDK runtime at start-up. The heap matches
+ * MacSurf's preferred 192 MB partition and fits the default 256 MiB MAIN
+ * budget (docs/phase-0/pre-phase-0-findings.md §1); layout recursion on
+ * deep documents wants more than the default main-thread stack. */
+int _newlib_heap_size_user = 192 * 1024 * 1024;
+unsigned int sceUserMainThreadStackSize = 4 * 1024 * 1024;
+
+/** vita2d's per-frame vertex pool: every rect is a few vertices. */
+#define VITA_FRAME_POOL (4 * 1024 * 1024)
+
+/** Scroll speed in pixels per frame for the D-pad. */
+#define VITA_SCROLL_STEP 24
+
+/** Left stick dead zone around the 128 centre. */
+#define VITA_STICK_DEADZONE 24
+
+/** The test pages bundled under app0:/testpages/ (testpages/pages/). */
+static const char *const vita_test_pages[] = {
+	"L1-layout-basics", "L2-macsurf-css", "L3-grid", "L4-flex",
+	"PM-gradient", "PM-shadow", "PM-animation", "PM-macsurf-grid",
+	"PM-tagtype", "PM-link", "PM-shadow-clip",
+};
+#define VITA_TEST_PAGE_COUNT \
+	(sizeof(vita_test_pages) / sizeof(vita_test_pages[0]))
+
+static bool vita_quit;
+
+static void vita_gui_quit(void)
+{
+	vita_quit = true;
+}
+
+static struct gui_misc_table vita_misc_table = {
+	.schedule = vita_schedule,
+	.quit = vita_gui_quit,
+};
+
+static nserror set_defaults(struct nsoption_s *defaults)
+{
+	/* Nothing to persist yet: no cookie jar or history on the card. */
+	return NSERROR_OK;
+}
+
+/** Navigate the window to bundled test page `idx`. */
+static nserror open_test_page(struct browser_window *bw, unsigned int idx)
+{
+	char url_s[128];
+	nsurl *url;
+	nserror err;
+
+	strcpy(url_s, "file:///app0:/testpages/");
+	strncat(url_s, vita_test_pages[idx % VITA_TEST_PAGE_COUNT],
+		sizeof(url_s) - strlen(url_s) - 6);
+	strcat(url_s, ".html");
+	err = nsurl_create(url_s, &url);
+	if (err != NSERROR_OK)
+		return err;
+	err = browser_window_navigate(bw, url, NULL, BW_NAVIGATE_HISTORY,
+				      NULL, NULL, NULL);
+	nsurl_unref(url);
+	return err;
+}
+
+/** Read the pad; returns true when the page should change (by *step). */
+static bool vita_input(struct gui_window *gw, int *step)
+{
+	static unsigned int prev_buttons;
+	SceCtrlData pad;
+	unsigned int pressed;
+	int dx = 0, dy = 0;
+
+	memset(&pad, 0, sizeof(pad));
+	sceCtrlPeekBufferPositive(0, &pad, 1);
+	pressed = pad.buttons & ~prev_buttons;
+	prev_buttons = pad.buttons;
+
+	if (pressed & SCE_CTRL_START)
+		vita_quit = true;
+	if (pad.buttons & SCE_CTRL_UP)
+		dy -= VITA_SCROLL_STEP;
+	if (pad.buttons & SCE_CTRL_DOWN)
+		dy += VITA_SCROLL_STEP;
+	if (pad.buttons & SCE_CTRL_LEFT)
+		dx -= VITA_SCROLL_STEP;
+	if (pad.buttons & SCE_CTRL_RIGHT)
+		dx += VITA_SCROLL_STEP;
+	if (abs((int)pad.lx - 128) > VITA_STICK_DEADZONE)
+		dx += ((int)pad.lx - 128) / 4;
+	if (abs((int)pad.ly - 128) > VITA_STICK_DEADZONE)
+		dy += ((int)pad.ly - 128) / 4;
+	if (dx != 0 || dy != 0)
+		vita_window_scroll_by(gw, dx, dy);
+
+	*step = 0;
+	if (pressed & SCE_CTRL_LTRIGGER)
+		*step = -1;
+	if (pressed & SCE_CTRL_RTRIGGER)
+		*step = 1;
+	return *step != 0;
+}
+
+static void vita_run(struct browser_window *bw)
+{
+	unsigned int page = 0;
+
+	while (!vita_quit) {
+		struct gui_window *gw = vita_window_current();
+		int step;
+
+		vita_schedule_run();
+
+		if (gw != NULL && vita_input(gw, &step)) {
+			page = (page + VITA_TEST_PAGE_COUNT + step) %
+				VITA_TEST_PAGE_COUNT;
+			open_test_page(bw, page);
+		}
+
+		if (vita_window_needs_redraw(gw)) {
+			vita2d_start_drawing();
+			vita2d_clear_screen();
+			vita_window_redraw(gw);
+			vita2d_end_drawing();
+			vita2d_swap_buffers();
+		} else {
+			/* Nothing to paint: yield for about a frame. */
+			sceKernelDelayThread(16 * 1000);
+		}
+	}
+}
+
+int main(int argc, char **argv)
+{
+	struct browser_window *bw = NULL;
+	nsurl *url;
+	nserror ret;
+	struct netsurf_table vita_table = {
+		.misc = &vita_misc_table,
+		.window = vita_window_table,
+		.fetch = vita_fetch_table,
+		.file = vita_file_table,
+		.bitmap = vita_bitmap_table,
+		.layout = vita_layout_table,
+	};
+
+	vita2d_init_advanced(VITA_FRAME_POOL);
+	vita2d_set_clear_color(RGBA8(0xff, 0xff, 0xff, 0xff));
+	sceCtrlSetSamplingMode(SCE_CTRL_MODE_ANALOG);
+	if (vita_plot_init() != NSERROR_OK)
+		goto fail;
+
+	ret = netsurf_register(&vita_table);
+	if (ret != NSERROR_OK)
+		goto fail;
+	ret = nsoption_init(set_defaults, &nsoptions, &nsoptions_default);
+	if (ret != NSERROR_OK)
+		goto fail;
+	/* Missing messages only lose UI strings; not fatal. */
+	messages_add_from_file(VITA_RESOURCE_DIR "Messages");
+
+	ret = netsurf_init(NULL);
+	if (ret != NSERROR_OK)
+		goto fail;
+	/* plot.c converts font points back to pixels at the same dpi. */
+	browser_set_dpi(96);
+
+	ret = nsurl_create(NETSURF_VITA_START_PAGE, &url);
+	if (ret == NSERROR_OK) {
+		ret = browser_window_create(BW_CREATE_HISTORY, url, NULL,
+					    NULL, &bw);
+		nsurl_unref(url);
+	}
+	if (ret != NSERROR_OK)
+		goto fail;
+
+	vita_run(bw);
+
+	browser_window_destroy(bw);
+	netsurf_exit();
+	nsoption_finalise(nsoptions, nsoptions_default);
+fail:
+	vita_plot_fini();
+	vita2d_fini();
+	sceKernelExitProcess(0);
+	return 0;
+}
diff --git a/frontends/vita/plot.c b/frontends/vita/plot.c
new file mode 100644
index 000000000..4aa503ea3
--- /dev/null
+++ b/frontends/vita/plot.c
@@ -0,0 +1,592 @@
+/*
+ * Copyright 2026 VitaBrowser contributors
+ *
+ * This file is part of NetSurf, http://www.netsurf-browser.org/
+ *
+ * NetSurf is free software; you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation; version 2 of the License.
+ *
+ * NetSurf is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+ * GNU General Public License for more details.
+ *
+ * You should have received a copy of the GNU General Public License
+ * along with this program.  If not, see <http://www.gnu.org/licenses/>.
+ */
+
+/**
+ * \file
+ * Vita frontend: libvita2d plotters.
+ *
+ * Rectangles go through vita/plot_geom.c, which reproduces the monkey
+ * stream contract (gradient bands, drop/inset shadows, transform quads,
+ * opacity buckets) with colours. Everything is drawn inside a
+ * vita2d_start_drawing() / vita2d_end_drawing() pair owned by the caller.
+ *
+ * Opacity: MacSurf approximates the fixes49 buckets with QuickDraw stipple
+ * patterns (ltGray / gray / dkGray = 25 / 50 / 75% foreground). The GXM has
+ * real alpha blending, so each bucket is drawn as that coverage in alpha.
+ * The bucket, not the exact CSS opacity, is what reaches the screen: that
+ * keeps the Vita render a function of the verified stream.
+ */
+
+#include <stdbool.h>
+#include <stdint.h>
+#include <string.h>
+#include <math.h>
+
+#include <vita2d.h>
+
+#include "utils/utils.h"
+#include "utils/errors.h"
+#include "netsurf/plotters.h"
+
+#include "vita/plot_geom.h"
+#include "vita/bitmap.h"
+#include "vita/plot.h"
+
+#ifndef M_PI
+#define M_PI 3.14159265358979323846
+#endif
+
+/** Alpha for each opacity bucket: skip, 25%, 50%, 75%, opaque. */
+static const unsigned int vita_bucket_alpha[VITA_BUCKET_SOLID + 1] = {
+	0, 64, 128, 191, 255
+};
+
+/**
+ * Height in pixels of the system PGF font at scale 1.0.
+ * UNVERIFIED: calibrate on hardware; only the text scale depends on it.
+ */
+#define VITA_PGF_EM_PX 20.0f
+
+/** Segments used to approximate a full circle. */
+#define VITA_CIRCLE_SEGMENTS 32
+
+/** Segments used to flatten one cubic Bezier. */
+#define VITA_BEZIER_SEGMENTS 12
+
+static vita2d_pgf *vita_font;
+
+/** Current clip; drawing is suppressed while it is empty. */
+static struct rect vita_clip = { 0, 0, VITA_SCREEN_WIDTH, VITA_SCREEN_HEIGHT };
+static bool vita_clip_empty;
+
+/* exported interface documented in vita/plot.h */
+unsigned int vita_plot_rgba(colour c, int bucket)
+{
+	if (bucket < 0)
+		bucket = 0;
+	if (bucket > VITA_BUCKET_SOLID)
+		bucket = VITA_BUCKET_SOLID;
+	/* NetSurf's colour and vita2d's RGBA8 share a byte order:
+	 * R in the low byte, then G, then B. Only alpha needs adding. */
+	return (c & 0xffffff) | (vita_bucket_alpha[bucket] << 24);
+}
+
+/* exported interface documented in vita/plot.h */
+float vita_plot_font_px(int size)
+{
+	/* Plot font sizes are points in PLOT_STYLE_SCALE fixed point; the
+	 * frontend runs the core at 96 dpi (see vita/main.c). */
+	return ((float)size / PLOT_STYLE_SCALE) * 96.0f / 72.0f;
+}
+
+/* exported interface documented in vita/plot.h */
+float vita_plot_pgf_scale(float px)
+{
+	return px / VITA_PGF_EM_PX;
+}
+
+/* exported interface documented in vita/plot.h */
+void vita_plot_set_clip(int x0, int y0, int x1, int y1)
+{
+	if (x0 < 0) x0 = 0;
+	if (y0 < 0) y0 = 0;
+	if (x1 > VITA_SCREEN_WIDTH) x1 = VITA_SCREEN_WIDTH;
+	if (y1 > VITA_SCREEN_HEIGHT) y1 = VITA_SCREEN_HEIGHT;
+
+	vita_clip.x0 = x0;
+	vita_clip.y0 = y0;
+	vita_clip.x1 = x1;
+	vita_clip.y1 = y1;
+	vita_clip_empty = (x1 <= x0 || y1 <= y0);
+	if (vita_clip_empty)
+		return;
+	vita2d_enable_clipping();
+	vita2d_set_clip_rectangle(x0, y0, x1, y1);
+}
+
+/* exported interface documented in vita/plot.h */
+void vita_plot_fill_rect(int x0, int y0, int x1, int y1, colour c,
+			 int bucket)
+{
+	if (vita_clip_empty || bucket <= 0 || x1 <= x0 || y1 <= y0)
+		return;
+	vita2d_draw_rectangle((float)x0, (float)y0,
+			      (float)(x1 - x0), (float)(y1 - y0),
+			      vita_plot_rgba(c, bucket));
+}
+
+/**
+ * Draw a convex vertex list as a triangle fan.
+ *
+ * Vertices must live in GPU-visible memory until the frame is done, so
+ * they come from vita2d's per-frame pool rather than the stack.
+ */
+static void vita_plot_fan(const float *xy, unsigned int n, unsigned int rgba)
+{
+	vita2d_color_vertex *v;
+	unsigned int i;
+
+	if (vita_clip_empty || n < 3)
+		return;
+	v = vita2d_pool_memalign(n * sizeof(vita2d_color_vertex),
+				 sizeof(vita2d_color_vertex));
+	if (v == NULL)
+		return;
+	for (i = 0; i < n; i++) {
+		v[i].x = xy[i * 2];
+		v[i].y = xy[i * 2 + 1];
+		v[i].z = 0.5f;
+		v[i].color = rgba;
+	}
+	vita2d_draw_array(SCE_GXM_PRIMITIVE_TRIANGLE_FAN, v, n);
+}
+
+/* exported interface documented in vita/plot.h */
+void vita_plot_fill_quad(const int x[4], const int y[4], colour c,
+			 int bucket)
+{
+	float xy[8];
+	int i;
+
+	if (bucket <= 0)
+		return;
+	for (i = 0; i < 4; i++) {
+		xy[i * 2] = (float)x[i];
+		xy[i * 2 + 1] = (float)y[i];
+	}
+	vita_plot_fan(xy, 4, vita_plot_rgba(c, bucket));
+}
+
+/* exported interface documented in vita/plot.h */
+void vita_plot_line(int x0, int y0, int x1, int y1, int width, colour c)
+{
+	unsigned int rgba = vita_plot_rgba(c, VITA_BUCKET_SOLID);
+	int half;
+
+	if (vita_clip_empty)
+		return;
+	if (width <= 1) {
+		vita2d_draw_line((float)x0, (float)y0, (float)x1, (float)y1,
+				 rgba);
+		return;
+	}
+	/* Thick axis-aligned lines (the common case: borders) are exact
+	 * rectangles centred on the line, as the plotter API specifies. */
+	half = width / 2;
+	if (y0 == y1) {
+		vita_plot_fill_rect(min(x0, x1), y0 - half, max(x0, x1),
+				    y0 - half + width, c, VITA_BUCKET_SOLID);
+	} else if (x0 == x1) {
+		vita_plot_fill_rect(x0 - half, min(y0, y1),
+				    x0 - half + width, max(y0, y1),
+				    c, VITA_BUCKET_SOLID);
+	} else {
+		float dx = (float)(x1 - x0), dy = (float)(y1 - y0);
+		float len = sqrtf(dx * dx + dy * dy);
+		float nx = -dy / len * (float)width / 2.0f;
+		float ny = dx / len * (float)width / 2.0f;
+		float xy[8] = {
+			x0 + nx, y0 + ny,  x1 + nx, y1 + ny,
+			x1 - nx, y1 - ny,  x0 - nx, y0 - ny
+		};
+		vita_plot_fan(xy, 4, rgba);
+	}
+}
+
+/* exported interface documented in vita/plot.h */
+void vita_plot_text(int x, int y, const char *text, size_t length,
+		    colour c, float scale)
+{
+	char buf[512];
+
+	if (vita_clip_empty || vita_font == NULL || length == 0)
+		return;
+	/* The core hands us a counted, unterminated UTF-8 run. */
+	if (length >= sizeof(buf))
+		length = sizeof(buf) - 1;
+	memcpy(buf, text, length);
+	buf[length] = '\0';
+	vita2d_pgf_draw_text(vita_font, x, y,
+			     vita_plot_rgba(c, VITA_BUCKET_SOLID), scale, buf);
+}
+
+/* ---- the rectangle contract ---------------------------------------- */
+
+static void geom_rect(void *pw, enum vita_geom_kind kind,
+		      int x0, int y0, int x1, int y1,
+		      colour c, int bucket, bool paint)
+{
+	if (paint)
+		vita_plot_fill_rect(x0, y0, x1, y1, c, bucket);
+}
+
+static void geom_quad(void *pw, const int x[4], const int y[4],
+		      colour c, int bucket, bool paint)
+{
+	if (paint)
+		vita_plot_fill_quad(x, y, c, bucket);
+}
+
+static const struct vita_geom_sink vita_geom_sink = {
+	.rect = geom_rect,
+	.quad = geom_quad,
+	.pw = NULL,
+};
+
+/** Stroke width in whole pixels, at least one. */
+static int stroke_px(const plot_style_t *style)
+{
+	int w = plot_style_fixed_to_int(style->stroke_width);
+	return (w < 1) ? 1 : w;
+}
+
+/* ---- plotter table ------------------------------------------------- */
+
+static nserror
+vita_plot_clip(const struct redraw_context *ctx, const struct rect *clip)
+{
+	vita_plot_set_clip(clip->x0, clip->y0, clip->x1, clip->y1);
+	return NSERROR_OK;
+}
+
+/** Stroke a polyline given as float x,y pairs. */
+static void stroke_polyline(const float *xy, unsigned int n, bool closed,
+			    int width, colour c)
+{
+	unsigned int i;
+
+	for (i = 0; i + 1 < n; i++) {
+		vita_plot_line((int)xy[i * 2], (int)xy[i * 2 + 1],
+			       (int)xy[i * 2 + 2], (int)xy[i * 2 + 3],
+			       width, c);
+	}
+	if (closed && n > 2) {
+		vita_plot_line((int)xy[(n - 1) * 2], (int)xy[(n - 1) * 2 + 1],
+			       (int)xy[0], (int)xy[1], width, c);
+	}
+}
+
+static nserror
+vita_plot_arc(const struct redraw_context *ctx,
+	      const plot_style_t *style,
+	      int x, int y, int radius, int angle1, int angle2)
+{
+	float xy[(VITA_CIRCLE_SEGMENTS + 1) * 2];
+	int segs, i;
+	float a1, a2;
+
+	/* Anticlockwise from angle1 to angle2, degrees from horizontal. */
+	while (angle2 < angle1)
+		angle2 += 360;
+	segs = (VITA_CIRCLE_SEGMENTS * (angle2 - angle1)) / 360;
+	if (segs < 1)
+		segs = 1;
+	a1 = (float)angle1 * (float)M_PI / 180.0f;
+	a2 = (float)angle2 * (float)M_PI / 180.0f;
+	for (i = 0; i <= segs; i++) {
+		float a = a1 + (a2 - a1) * (float)i / (float)segs;
+		/* Screen y grows downwards, so anticlockwise is -sin. */
+		xy[i * 2] = (float)x + (float)radius * cosf(a);
+		xy[i * 2 + 1] = (float)y - (float)radius * sinf(a);
+	}
+	stroke_polyline(xy, (unsigned int)segs + 1, false, stroke_px(style),
+			style->stroke_colour);
+	return NSERROR_OK;
+}
+
+static nserror
+vita_plot_disc(const struct redraw_context *ctx,
+	       const plot_style_t *style,
+	       int x, int y, int radius)
+{
+	if (style->fill_type != PLOT_OP_TYPE_NONE && !vita_clip_empty) {
+		vita2d_draw_fill_circle((float)x, (float)y, (float)radius,
+				vita_plot_rgba(style->fill_colour,
+					       VITA_BUCKET_SOLID));
+	}
+	if (style->stroke_type != PLOT_OP_TYPE_NONE) {
+		float xy[VITA_CIRCLE_SEGMENTS * 2];
+		int i;
+		for (i = 0; i < VITA_CIRCLE_SEGMENTS; i++) {
+			float a = 2.0f * (float)M_PI * (float)i /
+				VITA_CIRCLE_SEGMENTS;
+			xy[i * 2] = (float)x + (float)radius * cosf(a);
+			xy[i * 2 + 1] = (float)y + (float)radius * sinf(a);
+		}
+		stroke_polyline(xy, VITA_CIRCLE_SEGMENTS, true,
+				stroke_px(style), style->stroke_colour);
+	}
+	return NSERROR_OK;
+}
+
+static nserror
+vita_plot_line_op(const struct redraw_context *ctx,
+		  const plot_style_t *style,
+		  const struct rect *line)
+{
+	if (style->stroke_type == PLOT_OP_TYPE_NONE)
+		return NSERROR_OK;
+	vita_plot_line(line->x0, line->y0, line->x1, line->y1,
+		       stroke_px(style), style->stroke_colour);
+	return NSERROR_OK;
+}
+
+static nserror
+vita_plot_rectangle(const struct redraw_context *ctx,
+		    const plot_style_t *style,
+		    const struct rect *rect)
+{
+	vita_geom_rectangle(style, rect, &vita_geom_sink);
+
+	/* The stream contract is fill-only (monkey never records strokes);
+	 * the outline is ours, drawn over the fill as the API specifies. */
+	if (style->stroke_type != PLOT_OP_TYPE_NONE) {
+		int w = stroke_px(style);
+		colour c = style->stroke_colour;
+		const struct rect *r = rect;
+		vita_plot_fill_rect(r->x0, r->y0, r->x1, r->y0 + w, c,
+				    VITA_BUCKET_SOLID);
+		vita_plot_fill_rect(r->x0, r->y1 - w, r->x1, r->y1, c,
+				    VITA_BUCKET_SOLID);
+		vita_plot_fill_rect(r->x0, r->y0 + w, r->x0 + w, r->y1 - w, c,
+				    VITA_BUCKET_SOLID);
+		vita_plot_fill_rect(r->x1 - w, r->y0 + w, r->x1, r->y1 - w, c,
+				    VITA_BUCKET_SOLID);
+	}
+	return NSERROR_OK;
+}
+
+static nserror
+vita_plot_polygon(const struct redraw_context *ctx,
+		  const plot_style_t *style,
+		  const int *p,
+		  unsigned int n)
+{
+	float xy[64 * 2];
+	unsigned int i;
+
+	/* A fan is exact for convex polygons, which is what the core sends
+	 * (list bullets, form widgets). Longer ones are truncated. */
+	if (n > 64)
+		n = 64;
+	for (i = 0; i < n * 2; i++)
+		xy[i] = (float)p[i];
+	if (style->fill_type != PLOT_OP_TYPE_NONE)
+		vita_plot_fan(xy, n, vita_plot_rgba(style->fill_colour,
+						    VITA_BUCKET_SOLID));
+	if (style->stroke_type != PLOT_OP_TYPE_NONE)
+		stroke_polyline(xy, n, true, stroke_px(style),
+				style->stroke_colour);
+	return NSERROR_OK;
+}
+
+/** Apply the path plotter's 2D affine transform to a point. */
+static void path_xform(const float t[6], float x, float y, float *ox,
+		       float *oy)
+{
+	*ox = t[0] * x + t[2] * y + t[4];
+	*oy = t[1] * x + t[3] * y + t[5];
+}
+
+/** Paint one flattened path segment list (fill then stroke). */
+static void path_flush(const plot_style_t *style, float *xy, unsigned int n,
+		       bool closed)
+{
+	if (n < 2)
+		return;
+	if (style->fill_type != PLOT_OP_TYPE_NONE && n >= 3)
+		vita_plot_fan(xy, n, vita_plot_rgba(style->fill_colour,
+						    VITA_BUCKET_SOLID));
+	if (style->stroke_type != PLOT_OP_TYPE_NONE)
+		stroke_polyline(xy, n, closed, stroke_px(style),
+				style->stroke_colour);
+}
+
+static nserror
+vita_plot_path(const struct redraw_context *ctx,
+	       const plot_style_t *pstyle,
+	       const float *p,
+	       unsigned int n,
+	       const float transform[6])
+{
+	/* SVG paths: flatten Beziers to polylines, one subpath at a time.
+	 * Fills are fans, exact only for convex subpaths. */
+	float xy[256 * 2];
+	unsigned int count = 0;
+	unsigned int i = 0;
+	float cx = 0, cy = 0;
+	bool closed = false;
+
+	while (i < n) {
+		int cmd = (int)p[i];
+		if (cmd == PLOTTER_PATH_MOVE && i + 2 < n) {
+			path_flush(pstyle, xy, count, closed);
+			count = 0;
+			closed = false;
+			path_xform(transform, p[i + 1], p[i + 2], &cx, &cy);
+			xy[0] = cx;
+			xy[1] = cy;
+			count = 1;
+			i += 3;
+		} else if (cmd == PLOTTER_PATH_LINE && i + 2 < n) {
+			path_xform(transform, p[i + 1], p[i + 2], &cx, &cy);
+			if (count < 256) {
+				xy[count * 2] = cx;
+				xy[count * 2 + 1] = cy;
+				count++;
+			}
+			i += 3;
+		} else if (cmd == PLOTTER_PATH_BEZIER && i + 6 < n) {
+			float x1, y1, x2, y2, x3, y3;
+			int s;
+			path_xform(transform, p[i + 1], p[i + 2], &x1, &y1);
+			path_xform(transform, p[i + 3], p[i + 4], &x2, &y2);
+			path_xform(transform, p[i + 5], p[i + 6], &x3, &y3);
+			for (s = 1; s <= VITA_BEZIER_SEGMENTS; s++) {
+				float t = (float)s / VITA_BEZIER_SEGMENTS;
+				float u = 1.0f - t;
+				float bx = u * u * u * cx + 3 * u * u * t * x1 +
+					3 * u * t * t * x2 + t * t * t * x3;
+				float by = u * u * u * cy + 3 * u * u * t * y1 +
+					3 * u * t * t * y2 + t * t * t * y3;
+				if (count < 256) {
+					xy[count * 2] = bx;
+					xy[count * 2 + 1] = by;
+					count++;
+				}
+			}
+			cx = x3;
+			cy = y3;
+			i += 7;
+		} else if (cmd == PLOTTER_PATH_CLOSE) {
+			closed = true;
+			i += 1;
+		} else {
+			/* Malformed or truncated path: stop, keep what we have. */
+			break;
+		}
+	}
+	path_flush(pstyle, xy, count, closed);
+	return NSERROR_OK;
+}
+
+static nserror
+vita_plot_bitmap(const struct redraw_context *ctx,
+		 struct bitmap *bitmap,
+		 int x, int y,
+		 int width,
+		 int height,
+		 colour bg,
+		 bitmap_flags_t flags)
+{
+	vita2d_texture *tex;
+	float sx, sy;
+	int tx, ty, x_end, y_end;
+
+	if (vita_clip_empty || width <= 0 || height <= 0)
+		return NSERROR_OK;
+	tex = vita_bitmap_texture(bitmap);
+	if (tex == NULL)
+		return NSERROR_OK;
+	sx = (float)width / (float)vita2d_texture_get_width(tex);
+	sy = (float)height / (float)vita2d_texture_get_height(tex);
+
+	/* Tile across the clip rectangle on repeating axes; the GPU clip
+	 * trims the partial tiles at the edges. */
+	if (flags & BITMAPF_REPEAT_X) {
+		while (x > vita_clip.x0)
+			x -= width;
+		while (x + width <= vita_clip.x0)
+			x += width;
+		x_end = vita_clip.x1;
+	} else {
+		x_end = x + 1;
+	}
+	if (flags & BITMAPF_REPEAT_Y) {
+		while (y > vita_clip.y0)
+			y -= height;
+		while (y + height <= vita_clip.y0)
+			y += height;
+		y_end = vita_clip.y1;
+	} else {
+		y_end = y + 1;
+	}
+	for (ty = y; ty < y_end; ty += height) {
+		for (tx = x; tx < x_end; tx += width) {
+			vita2d_draw_texture_scale(tex, (float)tx, (float)ty,
+						  sx, sy);
+		}
+	}
+	return NSERROR_OK;
+}
+
+static nserror
+vita_plot_text_op(const struct redraw_context *ctx,
+		  const struct plot_font_style *fstyle,
+		  int x,
+		  int y,
+		  const char *text,
+		  size_t length)
+{
+	vita_plot_text(x, y, text, length, fstyle->foreground,
+		       vita_plot_pgf_scale(vita_plot_font_px(fstyle->size)));
+	return NSERROR_OK;
+}
+
+/* exported interface documented in vita/plot.h */
+struct vita2d_pgf *vita_plot_font(void)
+{
+	return vita_font;
+}
+
+/* exported interface documented in vita/plot.h */
+nserror vita_plot_init(void)
+{
+	vita_font = vita2d_load_default_pgf();
+	if (vita_font == NULL)
+		return NSERROR_INIT_FAILED;
+	vita_plot_set_clip(0, 0, VITA_SCREEN_WIDTH, VITA_SCREEN_HEIGHT);
+	return NSERROR_OK;
+}
+
+/* exported interface documented in vita/plot.h */
+void vita_plot_fini(void)
+{
+	if (vita_font != NULL) {
+		vita2d_free_pgf(vita_font);
+		vita_font = NULL;
+	}
+}
+
+/** vita2d plotter operations table */
+static const struct plotter_table plotters = {
+	.clip = vita_plot_clip,
+	.arc = vita_plot_arc,
+	.disc = vita_plot_disc,
+	.line = vita_plot_line_op,
+	.rectangle = vita_plot_rectangle,
+	.polygon = vita_plot_polygon,
+	.path = vita_plot_path,
+	.bitmap = vita_plot_bitmap,
+	.text = vita_plot_text_op,
+	/* Same as monkey: knockout reorders the core's plot calls, and the
+	 * verified stream was recorded with it on. */
+	.option_knockout = true,
+};
+
+const struct plotter_table *vita_plotters = &plotters;
