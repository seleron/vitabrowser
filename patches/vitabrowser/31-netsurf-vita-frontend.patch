@@ -0,0 +1,107 @@
+/*
+ * Copyright 2026 VitaBrowser contributors
+ *
+ * This file is part of NetSurf, http://www.netsurf-browser.org/
+ *
+ * NetSurf is free software; you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation; version 2 of the License.
+ *
+ * NetSurf is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+ * GNU General Public License for more details.
+ *
+ * You should have received a copy of the GNU General Public License
+ * along with this program.  If not, see <http://www.gnu.org/licenses/>.
+ */
+
+/**
+ * \file
+ * Vita frontend: file paths with device prefixes.
+ *
+ * Vita paths start with a device, "app0:/res/x" or "ux0:/data/x", with no
+ * leading slash. A file: URL needs an absolute path, so the device rides in
+ * the first path segment: file:///app0:/res/x. The POSIX table gets the
+ * rest right; these wrappers only move that one slash.
+ */
+
+#include <stdarg.h>
+#include <stdbool.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "utils/errors.h"
+#include "utils/file.h"
+
+#include "vita/file.h"
+
+/** Does `path` start with a device ("app0:", "ux0:")? */
+static bool vita_is_device_path(const char *path)
+{
+	const char *colon = strchr(path, ':');
+	const char *slash = strchr(path, '/');
+
+	return colon != NULL && colon != path &&
+		(slash == NULL || colon < slash);
+}
+
+static nserror vita_mkpath(char **str, size_t *size, size_t nemb,
+			   va_list ap)
+{
+	return default_file_table->mkpath(str, size, nemb, ap);
+}
+
+static nserror vita_basename(const char *path, char **str, size_t *size)
+{
+	return default_file_table->basename(path, str, size);
+}
+
+static nserror vita_nsurl_to_path(struct nsurl *url, char **path_out)
+{
+	nserror res = default_file_table->nsurl_to_path(url, path_out);
+	char *path;
+
+	if (res != NSERROR_OK)
+		return res;
+	/* "/app0:/res/x" -> "app0:/res/x" */
+	path = *path_out;
+	if (path[0] == '/' && vita_is_device_path(path + 1))
+		memmove(path, path + 1, strlen(path));
+	return NSERROR_OK;
+}
+
+static nserror vita_path_to_nsurl(const char *path, struct nsurl **url_out)
+{
+	char *abs;
+	size_t len;
+	nserror res;
+
+	if (!vita_is_device_path(path))
+		return default_file_table->path_to_nsurl(path, url_out);
+	/* "app0:/res/x" -> "/app0:/res/x" -> file:///app0:/res/x */
+	len = strlen(path);
+	abs = malloc(len + 2);
+	if (abs == NULL)
+		return NSERROR_NOMEM;
+	abs[0] = '/';
+	memcpy(abs + 1, path, len + 1);
+	res = default_file_table->path_to_nsurl(abs, url_out);
+	free(abs);
+	return res;
+}
+
+static nserror vita_mkdir_all(const char *fname)
+{
+	return default_file_table->mkdir_all(fname);
+}
+
+static struct gui_file_table file_table = {
+	.mkpath = vita_mkpath,
+	.basename = vita_basename,
+	.nsurl_to_path = vita_nsurl_to_path,
+	.path_to_nsurl = vita_path_to_nsurl,
+	.mkdir_all = vita_mkdir_all,
+};
+
+struct gui_file_table *vita_file_table = &file_table;
