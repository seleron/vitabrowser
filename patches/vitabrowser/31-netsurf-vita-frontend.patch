+
+/**
+ * Schedule a callback.
+ *
+ * \param  tival     interval before the callback should be made in ms
+ * \param  callback  callback function
+ * \param  p         user parameter, passed to callback function
+ *
+ * The callback function will be called as soon as possible after t ms have
+ * passed.
+ */
+
+nserror vita_schedule(int tival, void (*callback)(void *p), void *p);
+
+/**
+ * Process scheduled callbacks up to current time.
+ *
+ * @return The number of milliseconds untill the next scheduled event
+ * or -1 for no event.
+ */
+int vita_schedule_run(void);
+
+/**
+ * Log a list of all scheduled callbacks.
+ */
+void vita_schedule_list(void);
+
+#endif
diff --git a/frontends/vita/window.c b/frontends/vita/window.c
new file mode 100644
index 000000000..d9d63695a
--- /dev/null
+++ b/frontends/vita/window.c
@@ -0,0 +1,207 @@
+/*
+ * Copyright 2026 VitaBrowser contributors
+ *
+ * This file is part of NetSurf, http://www.netsurf-browser.org/
+ *
+ * NetSurf is free software; you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation; version 2 of the License.
+ *
+ * NetSurf is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+ * GNU General Public License for more details.
+ *
+ * You should have received a copy of the GNU General Public License
+ * along with this program.  If not, see <http://www.gnu.org/licenses/>.
+ */
+
+/**
+ * \file
+ * Vita frontend: the browser window.
+ *
+ * The Vita shows one page at a time, full screen, so there is one gui
+ * window and no chrome yet. Invalidation just marks the window dirty; the
+ * main loop repaints the whole screen, which vita2d does every frame anyway.
+ */
+
+#include <stdbool.h>
+#include <stdlib.h>
+
+#include "utils/errors.h"
+#include "utils/log.h"
+#include "netsurf/browser_window.h"
+#include "netsurf/window.h"
+#include "netsurf/plotters.h"
+
+#include "vita/plot.h"
+#include "vita/window.h"
+
+struct gui_window {
+	struct browser_window *bw;
+	int scrollx;
+	int scrolly;
+	bool dirty;
+};
+
+static struct gui_window *vita_current;
+
+static struct gui_window *
+vita_window_create(struct browser_window *bw,
+		   struct gui_window *existing,
+		   gui_window_create_flags flags)
+{
+	struct gui_window *gw = calloc(1, sizeof(*gw));
+
+	if (gw == NULL)
+		return NULL;
+	gw->bw = bw;
+	gw->dirty = true;
+	/* A new window (a link opened "in a new tab") replaces the view. */
+	vita_current = gw;
+	return gw;
+}
+
+static void vita_window_destroy(struct gui_window *gw)
+{
+	if (vita_current == gw)
+		vita_current = NULL;
+	free(gw);
+}
+
+static nserror vita_window_invalidate(struct gui_window *gw,
+				      const struct rect *rect)
+{
+	gw->dirty = true;
+	return NSERROR_OK;
+}
+
+static bool vita_window_get_scroll(struct gui_window *gw, int *sx, int *sy)
+{
+	*sx = gw->scrollx;
+	*sy = gw->scrolly;
+	return true;
+}
+
+static nserror vita_window_set_scroll(struct gui_window *gw,
+				      const struct rect *rect)
+{
+	gw->scrollx = rect->x0;
+	gw->scrolly = rect->y0;
+	gw->dirty = true;
+	return NSERROR_OK;
+}
+
+static nserror vita_window_get_dimensions(struct gui_window *gw,
+					  int *width, int *height)
+{
+	*width = VITA_SCREEN_WIDTH;
+	*height = VITA_SCREEN_HEIGHT;
+	return NSERROR_OK;
+}
+
+static nserror vita_window_event(struct gui_window *gw,
+				 enum gui_window_event event)
+{
+	switch (event) {
+	case GW_EVENT_NEW_CONTENT:
+		gw->scrollx = 0;
+		gw->scrolly = 0;
+		gw->dirty = true;
+		break;
+	case GW_EVENT_UPDATE_EXTENT:
+		/* Re-clamp the scroll offset to the new extent. */
+		vita_window_scroll_by(gw, 0, 0);
+		gw->dirty = true;
+		break;
+	default:
+		break;
+	}
+	return NSERROR_OK;
+}
+
+static void vita_window_set_title(struct gui_window *gw, const char *title)
+{
+	NSLOG(netsurf, INFO, "title: %s", title);
+}
+
+/* exported interface documented in vita/window.h */
+struct gui_window *vita_window_current(void)
+{
+	return vita_current;
+}
+
+/* exported interface documented in vita/window.h */
+bool vita_window_needs_redraw(struct gui_window *gw)
+{
+	return gw != NULL && gw->dirty && browser_window_redraw_ready(gw->bw);
+}
+
+/* exported interface documented in vita/window.h */
+void vita_window_redraw(struct gui_window *gw)
+{
+	struct rect clip = { 0, 0, VITA_SCREEN_WIDTH, VITA_SCREEN_HEIGHT };
+	struct redraw_context ctx = {
+		.interactive = true,
+		.background_images = true,
+		.plot = vita_plotters,
+	};
+
+	if (gw == NULL)
+		return;
+	vita_plot_set_clip(clip.x0, clip.y0, clip.x1, clip.y1);
+	/* The origin of the content on the canvas moves opposite to the
+	 * scroll offset. */
+	browser_window_redraw(gw->bw, -gw->scrollx, -gw->scrolly, &clip, &ctx);
+	gw->dirty = false;
+}
+
+/* exported interface documented in vita/window.h */
+void vita_window_scroll_by(struct gui_window *gw, int dx, int dy)
+{
+	int width = 0, height = 0;
+	int maxx, maxy;
+
+	if (gw == NULL)
+		return;
+	if (browser_window_get_extents(gw->bw, true, &width, &height) !=
+	    NSERROR_OK) {
+		width = VITA_SCREEN_WIDTH;
+		height = VITA_SCREEN_HEIGHT;
+	}
+	maxx = width - VITA_SCREEN_WIDTH;
+	maxy = height - VITA_SCREEN_HEIGHT;
+	if (maxx < 0) maxx = 0;
+	if (maxy < 0) maxy = 0;
+
+	dx += gw->scrollx;
+	dy += gw->scrolly;
+	if (dx < 0) dx = 0;
+	if (dy < 0) dy = 0;
+	if (dx > maxx) dx = maxx;
+	if (dy > maxy) dy = maxy;
+	if (dx != gw->scrollx || dy != gw->scrolly) {
+		gw->scrollx = dx;
+		gw->scrolly = dy;
+		gw->dirty = true;
+	}
+}
+
+/* exported interface documented in vita/window.h */
+struct browser_window *vita_window_browser(struct gui_window *gw)
+{
+	return (gw != NULL) ? gw->bw : NULL;
+}
+
+static struct gui_window_table window_table = {
+	.create = vita_window_create,
+	.destroy = vita_window_destroy,
+	.invalidate = vita_window_invalidate,
+	.get_scroll = vita_window_get_scroll,
+	.set_scroll = vita_window_set_scroll,
+	.get_dimensions = vita_window_get_dimensions,
+	.event = vita_window_event,
+	.set_title = vita_window_set_title,
+};
+
+struct gui_window_table *vita_window_table = &window_table;
