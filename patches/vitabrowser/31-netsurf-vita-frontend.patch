+ *
+ * NetSurf is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+ * GNU General Public License for more details.
+ *
+ * You should have received a copy of the GNU General Public License
+ * along with this program.  If not, see <http://www.gnu.org/licenses/>.
+ */
+
+/**
+ * \file
+ * Vita frontend: file types and bundled resources.
+ *
+ * There is no /etc/mime.types on the Vita, so file types come from a
+ * built-in extension table covering what the file fetcher will meet in the
+ * app bundle. Resources (default.css and friends) live in app0:/res/.
+ */
+
+#include <stddef.h>
+#include <string.h>
+#include <strings.h>
+
+#include "utils/errors.h"
+#include "utils/file.h"
+#include "utils/nsurl.h"
+#include "netsurf/fetch.h"
+
+#include "vita/fetch.h"
+
+static const struct {
+	const char *ext;
+	const char *type;
+} vita_filetypes[] = {
+	{ "html", "text/html" },
+	{ "htm", "text/html" },
+	{ "css", "text/css" },
+	{ "txt", "text/plain" },
+	{ "png", "image/png" },
+	{ "gif", "image/gif" },
+	{ "jpg", "image/jpeg" },
+	{ "jpeg", "image/jpeg" },
+	{ "bmp", "image/bmp" },
+	{ "ico", "image/x-icon" },
+	{ "js", "application/javascript" },
+	{ "svg", "image/svg+xml" },
+};
+
+static const char *vita_fetch_filetype(const char *unix_path)
+{
+	const char *dot = strrchr(unix_path, '.');
+	const char *slash = strrchr(unix_path, '/');
+	size_t i;
+
+	if (dot == NULL || (slash != NULL && dot < slash))
+		return "text/plain";
+	dot++;
+	for (i = 0; i < sizeof(vita_filetypes) / sizeof(vita_filetypes[0]);
+	     i++) {
+		if (strcasecmp(dot, vita_filetypes[i].ext) == 0)
+			return vita_filetypes[i].type;
+	}
+	return "text/plain";
+}
+
+static nsurl *vita_get_resource_url(const char *path)
+{
+	char buf[256];
+	nsurl *url = NULL;
+
+	/* "Messages" and the like, but not "../escape": resources are flat. */
+	if (strchr(path, '/') != NULL)
+		return NULL;
+	strncpy(buf, VITA_RESOURCE_DIR, sizeof(buf) - 1);
+	buf[sizeof(buf) - 1] = '\0';
+	strncat(buf, path, sizeof(buf) - strlen(buf) - 1);
+	if (netsurf_path_to_nsurl(buf, &url) != NSERROR_OK)
+		return NULL;
+	return url;
+}
+
+static struct gui_fetch_table fetch_table = {
+	.filetype = vita_fetch_filetype,
+	.get_resource_url = vita_get_resource_url,
+};
+
+struct gui_fetch_table *vita_fetch_table = &fetch_table;
