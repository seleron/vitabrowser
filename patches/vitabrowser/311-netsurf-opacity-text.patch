+/* patch 311: map a plot_style_fixed opacity to the fixes49 stipple
+ * bucket, the same thresholds as vita_geom_opacity_bucket (which takes
+ * a plot_style_t; the font style carries the same fixed-point field). */
+static int vita_font_opacity_bucket(plot_style_fixed op)
+{
+	if (op == 0)
+		op = (plot_style_fixed)PLOT_STYLE_SCALE;
+	if (op < (plot_style_fixed)(PLOT_STYLE_SCALE / 20))
+		return 0;
+	if (op < (plot_style_fixed)((PLOT_STYLE_SCALE * 35) / 100))
+		return 1;
+	if (op < (plot_style_fixed)((PLOT_STYLE_SCALE * 60) / 100))
+		return 2;
+	if (op < (plot_style_fixed)((PLOT_STYLE_SCALE * 85) / 100))
+		return 3;
+	return VITA_BUCKET_SOLID;
+}
