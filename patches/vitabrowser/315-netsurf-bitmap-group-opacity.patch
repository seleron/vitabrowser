 	(((bitmap_flags_t)(m) & 0x1fUL) << BITMAPF_BLEND_SHIFT)
+/* VitaBrowser patch 315 (doc 24): the composed group opacity rides in
+ * bits 16-23 as a byte. A masked value of 0 means "not supplied" and the
+ * plotter draws opaque -- what every caller that never writes the field
+ * produces -- so folding sites write max(byte, 1) for a real value (a
+ * group opacity of 0 lands on 1, which quantises to "skip"). Frontends
+ * that do not know the bits ignore them. Carried in the op so desktop
+ * knockout's queued replay keeps it verbatim. */
+#define BITMAPF_OPACITY_SHIFT 16
+#define BITMAPF_OPACITY_MASK (0xffUL << BITMAPF_OPACITY_SHIFT)
+#define BITMAPF_OPACITY(a) \
+	(((bitmap_flags_t)(a) & 0xffUL) << BITMAPF_OPACITY_SHIFT)
+#define BITMAPF_OPACITY_BYTE(f) \
+	((unsigned int)(((f) & BITMAPF_OPACITY_MASK) >> BITMAPF_OPACITY_SHIFT))
 
