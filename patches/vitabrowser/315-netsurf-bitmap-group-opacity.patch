+static int vita_font_opacity_bucket(plot_style_fixed op);
+
+/* VitaBrowser patch 315 (doc 24): the bitmap op's opacity byte
+ * (BITMAPF_OPACITY, bits 16-23) to a bucket -- the same thresholds as
+ * every other op. A byte of 0 is "not supplied": solid. */
+static int vita_bitmap_opacity_bucket(bitmap_flags_t flags)
+{
+	unsigned int b = BITMAPF_OPACITY_BYTE(flags);
+
+	if (b == 0)
+		return VITA_BUCKET_SOLID;
+	return vita_font_opacity_bucket((plot_style_fixed)
+			(((unsigned int)PLOT_STYLE_SCALE * b) / 255));
+}
