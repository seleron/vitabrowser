+/* VitaBrowser patch 315 (doc 24): the composed group opacity as the
+ * BITMAPF_OPACITY() byte. Full opacity is "not supplied" (0), so solid
+ * pages' bitmap ops carry exactly the flags they did; a partial value
+ * is rounded to a byte and kept >= 1 (byte 0 would read as solid). */
+unsigned char html_redraw_group_opacity_byte(void)
+{
+	unsigned int b;
+
+	if (g_group_opacity >= (plot_style_fixed)PLOT_STYLE_SCALE)
+		return 0;
+	if (g_group_opacity <= 0)
+		return 1;
+	b = (unsigned int)(((int64_t)g_group_opacity * 255 +
+				PLOT_STYLE_SCALE / 2) / PLOT_STYLE_SCALE);
+	return (unsigned char)(b < 1 ? 1 : (b > 255 ? 255 : b));
+}
