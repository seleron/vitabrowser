 extern void macos9_js_mark_dom_dirty(struct content *c);
 #endif
 
+/* VitaBrowser patch 316 (doc 23 stage 1): the sheet census. Every
+ * nodeless mark css.c emits for a sheet change is attributed to the
+ * stylesheet entry that caused it (census_marks). When the reconvert
+ * flush commits a full reconvert for a nodeless batch it asks
+ * html_css_census_batch_sheets() how many distinct entries marked since
+ * the previous batch: 1 = sheet-single (the shape doc 23 stage 2 could
+ * answer locally), >1 = sheet-multi, 0 = the nodeless mark came from
+ * somewhere other than a sheet. Instrumentation only: marks and
+ * reconverts are unchanged. */
+static void html_css_census_note(html_content *c, unsigned int i)
+{
+	if (i < c->stylesheet_count)
+		c->stylesheets[i].census_marks++;
+}
+
+/* exported for javascript/quickjs/macos9_reconvert.c (patch 316) */
+int html_css_census_batch_sheets(struct content *cc);
+int html_css_census_batch_sheets(struct content *cc)
+{
+	html_content *c = (html_content *)cc;
+	unsigned int i;
+	int n = 0;
+
+	/* the reconvert slots hold html contents only (the same cast
+	 * html_reconvert_content makes) */
+	if (c == NULL || c->stylesheets == NULL)
+		return 0;
+	for (i = 0; i != c->stylesheet_count; i++) {
+		struct html_stylesheet *s = &c->stylesheets[i];
+		if (s->census_marks != s->census_closed) {
+			n++;
+			s->census_closed = s->census_marks;
+		}
+	}
+	return n;
+}
+
