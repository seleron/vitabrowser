+/* __msMutWatch(): MutationObserver.observe() was called in this realm. */
+static JSValue qjs_ms_mut_watch(JSContext *ctx, JSValueConst this_val,
+		int argc, JSValueConst *argv)
+{
+	struct qjs_realm_owner *owner = qjs_owner_for_ctx(ctx);
+	(void)this_val; (void)argc; (void)argv;
+	if (owner != NULL)
+		owner->mo_watch = 1;
+	return JS_UNDEFINED;
+}
