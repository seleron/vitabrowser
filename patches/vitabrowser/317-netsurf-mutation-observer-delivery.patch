+static JSValue qjs_mo_node_array(JSContext *ctx, dom_node **nodes,
+		unsigned int n)
+{
+	JSValue a = JS_NewArray(ctx);
+	unsigned int i, k = 0;
+	if (JS_IsException(a)) return a;
+	for (i = 0; i < n; i++) {
+		JSValue w;
+		/* qjs_wrap_any_node adopts a reference: give it its own */
+		macsurf_dom_node_ref(nodes[i]);
+		w = qjs_wrap_any_node(ctx, nodes[i]);
+		if (JS_IsException(w)) {
+			JS_FreeValue(ctx, JS_GetException(ctx));
+			continue;
+		}
+		if (JS_IsNull(w) || JS_IsUndefined(w)) continue;
+		JS_SetPropertyUint32(ctx, a, k++, w);
+	}
+	return a;
+}
