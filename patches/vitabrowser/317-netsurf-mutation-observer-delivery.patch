+/* The delivery task(s): called from macsurf_qjs_pump_all, between page
+ * tasks. */
+static void qjs_mo_drain(void)
+{
+	struct qjs_mo_rec *list = g_qjs_mo_head, *r, *next;
+
+	if (list == NULL || g_qjs_mo_draining != NULL) return;
+	/* detach: records queued by a callback below form a fresh queue,
+	 * delivered on a later pump */
+	g_qjs_mo_head = NULL;
+	g_qjs_mo_tail = &g_qjs_mo_head;
+	g_qjs_mo_count = 0;
+	g_qjs_mo_draining = list;
+	if (g_qjs_mo_dropped != 0) {
+		macsurf_debug_log_writef("LIFE MUTOBS queue full: %lu records "
+				"dropped", g_qjs_mo_dropped);
+		g_qjs_mo_dropped = 0;
+	}
+	/* One delivery per realm with records, in queue order of first
+	 * record. A callback may free realms: their records are marked
+	 * dead by the purge (ctx NULL), so every ctx read here is live. */
+	for (r = list; r != NULL; r = r->next) {
+		JSContext *ctx = r->ctx;
+		struct qjs_mo_rec *q;
+		if (ctx == NULL) continue;
+		if (qjs_mo_build(ctx, r)) {
+			qjs_task_push(MACSURF_JS_TASK_INTERNAL_NOTIFICATION);
+			macsurf_qjs__safe_eval(ctx,
+				"(function(){try{"
+				"if(typeof __msDeliverMutations==='function')"
+				"__msDeliverMutations();"
+				"}catch(e){}})();");
+			qjs_task_pop();
+		}
+		/* this realm's records are delivered */
+		for (q = r; q != NULL; q = q->next)
+			if (q->ctx == ctx) q->ctx = NULL;
+	}
+	g_qjs_mo_draining = NULL;
+	for (r = list; r != NULL; r = next) {
+		next = r->next;
+		qjs_mo_free(r);
+	}
+}
