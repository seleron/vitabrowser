+/* A realm is going away: drop its records (they name its context and
+ * hold references into its document). A drain in progress keeps its
+ * detached records, marked dead, and frees them itself. */
+static void qjs_mo_purge_ctx(JSContext *ctx)
+{
+	struct qjs_mo_rec **pp = &g_qjs_mo_head, *r;
+
+	for (r = g_qjs_mo_draining; r != NULL; r = r->next)
+		if (r->ctx == ctx) r->ctx = NULL;
+	g_qjs_mo_tail = &g_qjs_mo_head;
+	while ((r = *pp) != NULL) {
+		if (r->ctx == ctx) {
+			*pp = r->next;
+			g_qjs_mo_count--;
+			qjs_mo_free(r);
+			continue;
+		}
+		g_qjs_mo_tail = &r->next;
+		pp = &r->next;
+	}
+}
