+/* Collect the node(s) a JS value names, in the CALLING realm: a node
+ * wrapper, or an array / NodeList snapshot of wrappers (a fragment's
+ * children, taken before the insert moved them). Each is referenced. */
+static unsigned int qjs_mo_nodes(JSContext *ctx, JSValueConst v,
+		dom_node ***out)
+{
+	dom_node *one;
+	dom_node **list = NULL;
+	unsigned int n = 0;
+	int64_t len = 0, i;
