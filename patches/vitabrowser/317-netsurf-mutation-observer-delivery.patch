+/* One realm's records, built inside its runtime and appended to its
+ * __msMutPending; 1 when anything was appended. */
+static int qjs_mo_build(JSContext *ctx, struct qjs_mo_rec *list)
+{
+	JSValue global = JS_GetGlobalObject(ctx);
+	JSValue pend = JS_GetPropertyStr(ctx, global, "__msMutPending");
+	struct qjs_mo_rec *r;
+	uint32_t at = 0;
+	int any = 0;
+
+	if (!JS_IsArray(pend)) {
+		JS_FreeValue(ctx, pend);
+		JS_FreeValue(ctx, global);
+		return 0;
+	}
+	{
+		JSValue l = JS_GetPropertyStr(ctx, pend, "length");
+		int64_t len = 0;
+		if (!JS_IsException(l) && JS_ToInt64(ctx, &len, l) == 0 &&
+		    len > 0)
+			at = (uint32_t)len;
+		JS_FreeValue(ctx, l);
+	}
+	for (r = list; r != NULL; r = r->next) {
+		JSValue o, t;
+		if (r->ctx != ctx) continue;
+		macsurf_dom_node_ref(r->target);	/* adopted by the wrap */
+		t = qjs_wrap_any_node(ctx, r->target);
+		if (JS_IsException(t)) {
+			JS_FreeValue(ctx, JS_GetException(ctx));
+			continue;
+		}
+		if (JS_IsNull(t) || JS_IsUndefined(t)) continue;
+		o = JS_NewObject(ctx);
+		if (JS_IsException(o)) {
+			JS_FreeValue(ctx, JS_GetException(ctx));
+			JS_FreeValue(ctx, t);
+			continue;
+		}
+		JS_SetPropertyStr(ctx, o, "type", JS_NewString(ctx,
+				r->type == QJS_MO_ATTR ? "attributes" :
+				r->type == QJS_MO_CDATA ? "characterData" :
+				"childList"));
+		JS_SetPropertyStr(ctx, o, "target", t);
+		JS_SetPropertyStr(ctx, o, "addedNodes",
+				qjs_mo_node_array(ctx, r->added, r->nadded));
+		JS_SetPropertyStr(ctx, o, "removedNodes",
+				qjs_mo_node_array(ctx, r->removed, r->nremoved));
+		JS_SetPropertyStr(ctx, o, "previousSibling", JS_NULL);
+		JS_SetPropertyStr(ctx, o, "nextSibling", JS_NULL);
+		JS_SetPropertyStr(ctx, o, "attributeName",
+				r->attr != NULL ? JS_NewString(ctx, r->attr) :
+				JS_NULL);
+		JS_SetPropertyStr(ctx, o, "attributeNamespace", JS_NULL);
+		JS_SetPropertyStr(ctx, o, "oldValue",
+				r->old != NULL ? JS_NewString(ctx, r->old) :
+				JS_NULL);
+		JS_SetPropertyUint32(ctx, pend, at++, o);
+		any = 1;
+	}
+	JS_FreeValue(ctx, pend);
 	JS_FreeValue(ctx, global);
+	return any;
+}
