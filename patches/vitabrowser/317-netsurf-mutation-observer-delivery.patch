+/* __msQueueMutation(type, target, added, removed, attr, oldValue): the
+ * polyfill's characterData setters (and anything else JS-side) queue
+ * through the same C queue; nothing is scheduled in JS. */
+static JSValue qjs_ms_queue_mutation(JSContext *ctx, JSValueConst this_val,
+		int argc, JSValueConst *argv)
+{
+	const char *type, *attr = NULL, *old = NULL;
+	dom_node *target;
+	dom_node **added = NULL, **removed = NULL;
+	unsigned int na = 0, nr = 0;
+	int kind;
+	(void)this_val;
+	if (!qjs_mo_watching(ctx) || argc < 2) return JS_UNDEFINED;
+	target = qjs_get_node(argv[1]);
+	if (target == NULL) return JS_UNDEFINED;
+	type = JS_ToCString(ctx, argv[0]);
+	if (type == NULL) {
+		JS_FreeValue(ctx, JS_GetException(ctx));
+		return JS_UNDEFINED;
+	}
+	kind = strcmp(type, "attributes") == 0 ? QJS_MO_ATTR :
+		strcmp(type, "characterData") == 0 ? QJS_MO_CDATA :
+		QJS_MO_CHILD;
+	JS_FreeCString(ctx, type);
+	if (argc > 2) na = qjs_mo_nodes(ctx, argv[2], &added);
+	if (argc > 3) nr = qjs_mo_nodes(ctx, argv[3], &removed);
+	if (argc > 4 && JS_IsString(argv[4])) attr = JS_ToCString(ctx, argv[4]);
+	if (argc > 5 && JS_IsString(argv[5])) old = JS_ToCString(ctx, argv[5]);
+	qjs_mo_push(ctx, kind, target, added, na, removed, nr, attr, old);
+	if (attr != NULL) JS_FreeCString(ctx, attr);
+	if (old != NULL) JS_FreeCString(ctx, old);
+	return JS_UNDEFINED;
+}
