+		if (list == NULL) return 0;
+		macsurf_dom_node_ref(one);
+		list[0] = one;
+		*out = list;
+		return 1;
+	}
+	if (!JS_IsObject(v)) return 0;
+	{
+		JSValue l = JS_GetPropertyStr(ctx, v, "length");
+		if (JS_IsException(l)) {
+			JS_FreeValue(ctx, JS_GetException(ctx));
+			return 0;
+		}
+		if (JS_ToInt64(ctx, &len, l) < 0) {
+			JS_FreeValue(ctx, JS_GetException(ctx));
+			len = 0;
+		}
+		JS_FreeValue(ctx, l);
+	}
+	if (len <= 0) return 0;
+	if (len > QJS_MO_MAX_NODES) len = QJS_MO_MAX_NODES;
+	list = (dom_node **)malloc((size_t)len * sizeof(*list));
+	if (list == NULL) return 0;
+	for (i = 0; i < len; i++) {
+		JSValue e = JS_GetPropertyUint32(ctx, v, (uint32_t)i);
+		dom_node *node;
+		if (JS_IsException(e)) {
+			JS_FreeValue(ctx, JS_GetException(ctx));
+			continue;
+		}
+		node = qjs_get_node(e);
+		JS_FreeValue(ctx, e);
+		if (node == NULL) continue;
+		macsurf_dom_node_ref(node);
+		list[n++] = node;
+	}
+	if (n == 0) {
+		free(list);
+		list = NULL;
+	}
+	*out = list;
+	return n;
