+/* VitaBrowser patch 318 (doc 23 piece A): emit the sheet mark. The
+ * settle window's set of changing entries is the finishing entry `i`
+ * (or -1), any entry held for patch 266's deferred refresh, and every
+ * entry still in flight -- queued for re-processing or its sheet still
+ * loading -- since that one will mark into the same window. A singleton
+ * set carries its identity (index + modification counter) on the mark;
+ * anything else is the nodeless mark exactly as before. */
+#ifdef WITH_QUICKJS
+static void html_css_mark_sheets(html_content *c, int i)
+{
+	unsigned int j, n = 0;
+	int idx = -1;
+
+	for (j = 0; j != c->stylesheet_count; j++) {
+		struct html_stylesheet *s = &c->stylesheets[j];
+		bool loading = s->sheet != NULL &&
+			content_get_status(s->sheet) != CONTENT_STATUS_DONE &&
+			content_get_status(s->sheet) != CONTENT_STATUS_ERROR;
+		if ((int)j == i || s->mark_pending || s->modified ||
+		    ((int)j != i && loading)) {
+			n++;
+			idx = (int)j;
+		}
+		s->mark_pending = false;
+	}
+	if (n == 1)
+		macos9_js_mark_dom_dirty_sheet(&c->base, idx,
+				c->stylesheets[idx].mod_count);
+	else
+		macos9_js_mark_dom_dirty(&c->base);
+}
+#endif
