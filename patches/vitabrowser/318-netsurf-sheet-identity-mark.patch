+/* Patch 318 - fold one nodeless mark's sheet identity into slot i.
+ * fresh: the slot was just (re)initialised. */
+static void
+macos9_reconvert_sheet_note(int i, int fresh)
+{
+	if (fresh) {
+		g_pending[i].sheet_state = 0;
+		g_pending[i].sheet_idx = -1;
+		g_pending[i].sheet_ctr = 0;
+		g_pending[i].sheet_unid = 0;
+	}
+	if (!g_sheet_mark.active) {
+		g_pending[i].sheet_unid = 1;
+		return;
+	}
+	if (g_pending[i].sheet_state == 0) {
+		g_pending[i].sheet_state = 1;
+		g_pending[i].sheet_idx = g_sheet_mark.idx;
+		/* first mark's counter: a later re-process of the same
+		 * entry makes it stale at the flush, by design */
+		g_pending[i].sheet_ctr = g_sheet_mark.ctr;
+	} else if (g_pending[i].sheet_state == 1 &&
+		   g_pending[i].sheet_idx != g_sheet_mark.idx) {
+		g_pending[i].sheet_state = 2;
+	}
+}
