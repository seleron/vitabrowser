+int html_css_sheet_mark_current(struct content *cc, int index,
+		unsigned int counter);
+int html_css_sheet_mark_current(struct content *cc, int index,
+		unsigned int counter)
+{
+	html_content *c = (html_content *)cc;
+
+	if (c == NULL || c->stylesheets == NULL || index < 0 ||
+	    (unsigned int)index >= c->stylesheet_count)
+		return 0;
+	return c->stylesheets[index].mod_count == counter;
+}
