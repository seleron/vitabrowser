+/* exported interface documented in vita/bitmap.h */
+struct vita2d_texture *vita_bitmap_faded_texture(struct bitmap *src,
+						 unsigned int alpha)
+{
+	struct bitmap *cp;
+	size_t stride;
+	int row, col;
+
+	if (src == NULL || src->pixels == NULL)
+		return NULL;
+	if (fade_copy != NULL && fade_src == src && fade_alpha == alpha)
+		return fade_copy->tex;
+	cp = bitmap_create(src->width, src->height, BITMAP_NONE);
+	if (cp == NULL) {
+		/* The caller draws solid; never a partial blend. */
+		if (fades_declined++ == 0)
+			vita_diag_log("bitmap: faded copy %dx%d refused "
+				      "(drawn solid)", src->width,
+				      src->height);
+		return NULL;
+	}
+	stride = (((size_t)src->width + 7) & ~(size_t)7) * 4;
+	memcpy(cp->pixels, src->pixels, stride * (size_t)src->height);
+	/* Straight alpha (see the top of this file): scaling the alpha byte
+	 * is the whole fade, texel x (white, alpha) as the tint shader and
+	 * the simulator's tint_part compute it -- so a scaled faded image
+	 * and a 1:1 one read the same pixels. */
+	for (row = 0; row < src->height; row++) {
+		unsigned char *p = (unsigned char *)cp->pixels +
+			(size_t)row * stride + 3;
+		for (col = 0; col < src->width; col++, p += 4)
+			*p = (unsigned char)((*p * alpha) / 255);
+	}
+	/* Destroyed at once: the memory stays put until the GPU has drawn
+	 * this frame (vita_bitmap_frame_retired), and nothing else holds
+	 * the copy. */
+	bitmap_destroy(cp);
+	fade_src = src;
+	fade_alpha = alpha;
+	fade_copy = cp;
+	fades_made++;
+	fade_bytes += stride * (size_t)src->height;
+	return cp->tex;
+}
