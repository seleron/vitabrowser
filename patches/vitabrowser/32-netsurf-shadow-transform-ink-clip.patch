+
+/**
+ * \file
+ * Ink overflow of a box's own background paint.
+ *
+ * The MacSurf plotters (frontends/monkey/plot.c, frontends/vita/plot_geom.c,
+ * MacSurf's macos9 plotters.c) paint two things outside the border box they
+ * are handed: the drop-shadow rect (offset clamped to +/-16px) and, for a
+ * non-identity -macsurf-transform, a rotated/scaled/translated quad in place
+ * of the fill. Layout's descendant bbox and redraw's clip rectangles only
+ * covered the border box, so both were cut to the box itself.
+ *
+ * box_ink_outset() gives how far that paint reaches past each border edge.
+ * Layout adds it to the box's own bbox (so ancestors' clips contain it) and
+ * redraw widens the clip around the background paint by it (so a box's own
+ * overflow:hidden does not cut its shadow). The bound is conservative: it
+ * may be a pixel wide, never narrow.
+ */
+
+#ifndef NETSURF_HTML_BOX_INK_H
+#define NETSURF_HTML_BOX_INK_H
+
+#include <math.h>
+#include <stdbool.h>
+#include <stdint.h>
+
+#include <libcss/libcss.h>
+
+#ifndef M_PI
+#define M_PI 3.14159265358979323846
+#endif
+
+/** Largest outset reported per edge; a garbage scale must not blow up
+ * descendant extents (see fixes625 in layout.c). */
+#define BOX_INK_MAX 4096
+
+static inline int box_ink__clamp(float v)
+{
+	if (v <= 0.0f)
+		return 0;
+	if (v >= (float)BOX_INK_MAX)
+		return BOX_INK_MAX;
+	return (int)ceilf(v);
+}
+
+/**
+ * Ink outset of a box's background paint beyond its border box.
+ *
+ * \param style  the style the background is painted with (may be NULL)
+ * \param bw     border-box width, in the units of the result
+ * \param bh     border-box height, in the units of the result
+ * \param l, t, r, b  updated to the outset past each edge, >= 0
+ */
+static inline void box_ink_outset(const css_computed_style *style,
+		int bw, int bh, int *l, int *t, int *r, int *b)
+{
+	int32_t tfm = 0, tfm_b = 0x01000100, anim_rot = 0, bsh = 0;
+	bool animated;
+	float fl = 0, ft = 0, fr = 0, fb = 0;
+
+	*l = *t = *r = *b = 0;
+	if (style == NULL || bw < 0 || bh < 0)
+		return;
+
+	if (css_computed_macsurf_transform(style, &tfm) ==
+			CSS_MACSURF_TRANSFORM_SET)
+		tfm_b = css_computed_macsurf_transform_b(style);
+	else
+		tfm = 0;
+	/* fixes77: an animated rotation replaces the angle at draw time,
+	 * so no single angle bounds it. */
+	animated = css_computed_macsurf_animation_rotate(style, &anim_rot) ==
+			CSS_MACSURF_ANIMATION_ROTATE_SET;
+
+	if (tfm != 0 || animated ||
+			(tfm_b != 0 && tfm_b != (int32_t)0x01000100)) {
+		/* The plotter's quad: scale about the centre (Q8.8, 0 = 1),
+		 * rotate (Q10.6 degrees in bits 30..16), translate by the
+		 * int8 tx/ty in bits 15..0 unless bit 31 (percent) is set. */
+		int sx = (int)((((uint32_t)tfm_b) >> 16) & 0xffff);
+		int sy = (int)(((uint32_t)tfm_b) & 0xffff);
+		float hw, hh, ex, ey, tx = 0, ty = 0;
+
+		if (sx == 0) sx = 256;
+		if (sy == 0) sy = 256;
+		hw = (float)bw * (float)sx / 512.0f;
+		hh = (float)bh * (float)sy / 512.0f;
+		if (animated) {
+			/* Any angle: the circumscribed circle. */
+			ex = ey = sqrtf(hw * hw + hh * hh);
+		} else {
+			int32_t q = (int32_t)((((uint32_t)tfm) >> 16) & 0x7fff);
+			float rad, c, s;
+			if (q & 0x4000)
+				q -= 0x8000;
+			rad = (float)(q / 64) * (float)M_PI / 180.0f;
+			c = fabsf(cosf(rad));
+			s = fabsf(sinf(rad));
+			ex = hw * c + hh * s;
+			ey = hw * s + hh * c;
+		}
+		if (((((uint32_t)tfm) >> 31) & 1) == 0) {
+			tx = (float)(int8_t)((((uint32_t)tfm) >> 8) & 0xff);
+			ty = (float)(int8_t)(((uint32_t)tfm) & 0xff);
+		}
+		/* Quad bounds relative to the border box's top-left, less the
+		 * box itself; +1 covers the plotter's integer centre and Q15
+		 * rounding. */
+		fl = ex - (float)bw / 2.0f - tx + 1.0f;
+		fr = ex - (float)bw / 2.0f + tx + 1.0f;
+		ft = ey - (float)bh / 2.0f - ty + 1.0f;
+		fb = ey - (float)bh / 2.0f + ty + 1.0f;
+	}
+
+	if (css_computed_box_shadow(style, &bsh) == CSS_BOX_SHADOW_SET &&
+			(((uint32_t)bsh) & 0x8000) == 0) {
+		/* Drop shadow (inset paints inside the box). Packed v2:
+		 * int8 h in bits 31..24, int8 v in 23..16; the plotters clamp
+		 * the offset to +/-16px. An animated box can be drawn
+		 * untransformed (angle 0), so the shadow counts then too. */
+		int h = (int8_t)((((uint32_t)bsh) >> 24) & 0xff);
+		int v = (int8_t)((((uint32_t)bsh) >> 16) & 0xff);
+		if (h < -16) h = -16;
+		if (h > 16) h = 16;
+		if (v < -16) v = -16;
+		if (v > 16) v = 16;
+		if (-h > fl) fl = (float)-h;
+		if (h > fr) fr = (float)h;
+		if (-v > ft) ft = (float)-v;
+		if (v > fb) fb = (float)v;
+	}
+
+	*l = box_ink__clamp(fl);
+	*t = box_ink__clamp(ft);
+	*r = box_ink__clamp(fr);
+	*b = box_ink__clamp(fb);
+}
+
+#endif
