+/* =========================================================================
+ * VitaBrowser patch 321 (doc 23 B1): the sheet-reach census.
+ *
+ * B0 (patch 320) made a <style> text edit reach the reconvert as one sheet
+ * batch; A (patch 318) gave the mark the sheet's identity. B1 asks, of the
+ * single-identified CURRENT batch, "how much of the document did this edit
+ * reach?" and logs the answer -- it decides nothing yet: B1's census is the
+ * gate C decides (doc 23 piece C).
+ *
+ * Per sheet entry the handler keeps two record tables (B.3): reach_prev,
+ * the version the boxes were last built from, and reach_cur, the live
+ * version. A record is a style rule (selector list + block); a group
+ * at-rule (@media / @supports / @document / @layer with a block) recurses
+ * into its block with its prelude prefixed to each inner record's text;
+ * any other at-rule (@font-face, @keyframes, ...) is one record over its
+ * whole text, and an at-statement (@layer a, b; @import ...) is one
+ * record over its prelude. A record's identity is FNV-1a over its
+ * normalized text (comments blanked, whitespace runs collapsed) -- the
+ * same hash as html_rl_fnv1a.
+ *
+ * The diff (B.2) is the longest common prefix and suffix of the two
+ * record sequences; the middle, both sides, is the change. The census
+ * (html_css_sheet_reach_census, called from macos9_reconvert.c at the
+ * SHEETID single-identified current mark) logs bounded, or the first
+ * unbounded cause in priority order:
+ *   no table (a <link> sheet, or never captured)   no-source
+ *   K > 64 changed records                          too-many
+ *   a changed record is an at-rule / statement      at-rule
+ *   touches counters                                counter
+ *   has a nested rule                               nesting
+ *   a selector uses an escape                       escape
+ *   a selector has no anchor                        unanchored
+ *   the walk finds 0 roots                          bounded
+ *   a root is <html>/<body>, an <li>, a child of
+ *   <ol>/<ul>/<menu>, or has no box (B.5 static)    admission
+ *   otherwise                                       bounded
+ *
+ * B1 builds the incoming table EAGERLY at the processed edit (B.3's
+ * lazy build-at-flush is C's): the <style>'s DOM text is the new
+ * version's source -- html_stylesheet_from_domnode hands those same
+ * bytes to the fetcher -- so the scan count is the same (once per
+ * version) and the lifetime is simpler.
+ *
+ * A selector's anchor (B.1) is the rightmost compound carrying a plain
+ * #id or .class (outside (), [] and strings) that is the subject or
+ * followed by a descendant / child combinator; id beats class in one
+ * compound. The walk's class match is dom_element_has_class itself --
+ * the engine's matcher, quirks mode included; id is an exact compare.
+ */
+
+struct html_css_reach_record {
+	uint32_t hash;
+	int reason;
+	int ntok;
+	char **tok;
+};
+
+struct html_css_reach_table {
+	struct html_css_reach_record *rec;
+	int nrec;
+};
+
+#define HTML_CSS_REACH_MAX_CHANGED 64
+#define HTML_CSS_REACH_MAX_GROUP 32
+#define HTML_CSS_REACH_MAX_ROOTS 1024
+
+static uint32_t html_css_reach_fnv1a(const uint8_t *s, size_t len)
+{
+	uint32_t h = 2166136261u;
+	size_t i;
+
+	for (i = 0; i < len; i++) {
+		h ^= s[i];
+		h *= 16777619u;
+	}
+	return h;
+}
+
+static inline bool html_css_reach_ws(int c)
+{
+	return c == ' ' || c == '\t' || c == '\n' || c == '\r' || c == '\f';
+}
+
+static void html_css_reach_table_free(struct html_css_reach_table *t)
+{
+	int i;
+
+	if (t == NULL)
+		return;
+	for (i = 0; i < t->nrec; i++) {
+		int j;
+		for (j = 0; t->rec[i].tok != NULL && j < t->rec[i].ntok; j++)
+			free(t->rec[i].tok[j]);
+		free(t->rec[i].tok);
+	}
+	free(t->rec);
+	free(t);
+}
+
+/* A small growable buffer for normalized text. */
+struct reach_buf {
+	char *s;
+	size_t len;
+	size_t cap;
+};
+
+static bool reach_buf_put(struct reach_buf *b, const char *s, size_t n)
+{
+	if (b->len + n + 1 > b->cap) {
+		size_t nc = b->cap ? b->cap * 2 : 256;
+		char *ns;
+		while (nc < b->len + n + 1)
+			nc *= 2;
+		ns = realloc(b->s, nc);
+		if (ns == NULL)
+			return false;
+		b->s = ns;
+		b->cap = nc;
+	}
+	memcpy(b->s + b->len, s, n);
+	b->len += n;
+	b->s[b->len] = '\0';
+	return true;
+}
+
+/* Append src[a,e) to b normalized: whitespace runs to one space, no
+ * leading / trailing space. b->s is a string even when nothing was
+ * appended (an empty block, `.x {}`, reads as ""). */
+static bool reach_norm_range(struct reach_buf *b, const char *src,
+		size_t a, size_t e)
+{
+	bool pend = false;
+	size_t i;
+
+	for (i = a; i < e; i++) {
+		if (html_css_reach_ws((unsigned char)src[i])) {
+			pend = true;
+		} else {
+			if (pend && b->len > 0) {
+				if (!reach_buf_put(b, " ", 1))
+					return false;
+			}
+			pend = false;
+			if (!reach_buf_put(b, src + i, 1))
+				return false;
+		}
+	}
+	if (b->s == NULL)
+		return reach_buf_put(b, "", 0);
+	return true;
+}
+
+/* Blank C-style comments to single spaces (a comment between tokens
+ * must not glue them); the result is the parse source. */
+static char *reach_strip_comments(const char *src, size_t len)
+{
+	char *w = malloc(len + 1);
+	size_t i;
+
+	if (w == NULL)
+		return NULL;
+	i = 0;
+	while (i < len) {
+		if (src[i] == '/' && i + 1 < len && src[i + 1] == '*') {
+			size_t j = i + 2;
+			while (j < len && !(src[j] == '*' && j + 1 < len &&
+			       src[j + 1] == '/'))
+				j++;
+			while (i < j + 2 && i < len)
+				w[i++] = ' ';
+			if (j + 2 > len)
+				break;
+		} else {
+			w[i] = src[i];
+			i++;
+		}
+	}
+	w[len] = '\0';
+	return w;
+}
+
+static inline bool reach_ident_char(unsigned char c, bool start)
+{
+	if ((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z'))
+		return true;
+	if (c >= '0' && c <= '9')
+		return !start;
+	return c == '_' || c == '-' || c == '\\' || c >= 0x80;
+}
+
+/* The first plain #id / .class of one compound, outside (), [] and
+ * strings; id beats class. malloc'd token KEEPS its leading delim ('#',
+ * '.' -> the class token is stored without it) so the walk can tell the
+ * kinds apart, NULL if the compound carries no plain anchor. */
+static char *reach_compound_token(const char *s, size_t len, bool *is_id)
+{
+	size_t i = 0;
+	int paren = 0, bracket = 0;
+	char strc = 0;
+	const char *id_at = NULL, *cls_at = NULL;
+	size_t id_len = 0, cls_len = 0;
+
+	while (i < len) {
+		char c = s[i];
+		if (strc != 0) {
+			if (c == strc)
+				strc = 0;
+			i++;
+			continue;
+		}
+		if (c == '"' || c == '\'') {
+			strc = c;
+			i++;
+			continue;
+		}
+		if (paren > 0) {
+			if (c == '(')
+				paren++;
+			else if (c == ')')
+				paren--;
+			i++;
+			continue;
+		}
+		if (c == '(') {
+			paren++;
+			i++;
+			continue;
+		}
+		if (bracket > 0) {
+			if (c == ']')
+				bracket--;
+			i++;
+			continue;
+		}
+		if (c == '[') {
+			bracket++;
+			i++;
+			continue;
+		}
+		if (c == '#' || c == '.') {
+			size_t j = i + 1;
+			if (j < len && reach_ident_char(s[j], true)) {
+				while (j < len && reach_ident_char(s[j], false))
+					j++;
+				if (c == '#' && id_at == NULL) {
+					id_at = s + i + 1;
+					id_len = j - i - 1;
+				} else if (c == '.' && cls_at == NULL) {
+					cls_at = s + i + 1;
+					cls_len = j - i - 1;
+				}
+			}
+			i = (j > i + 1) ? j : i + 1;
+			continue;
+		}
+		i++;
+	}
+	*is_id = (id_at != NULL);
+	if (id_at != NULL)
+		return strndup(id_at - 1, id_len + 1); /* keep the '#' */
+	if (cls_at != NULL)
+		return strndup(cls_at, cls_len);
+	return NULL;
+}
+
+/* B.1: the anchor token of one selector: the rightmost compound with a
+ * plain #id / .class that is the subject or followed by a descendant /
+ * child combinator (a sibling combinator to its right disqualifies). */
+static char *reach_selector_anchor(const char *sel, size_t len, bool *is_id)
+{
+	int *start = NULL, *cend = NULL, *comb = NULL;
+	int ncomp = 0, cap = 0;
+	int pend = 0;	/* 0 none (descendant), 1 child, 2 sibling */
+	size_t i = 0;
+	int k;
+
+	while (i < len && html_css_reach_ws((unsigned char)sel[i]))
+		i++;
+	while (i < len) {
+		/* scan the compound [i, j): to a top-level combinator,
+		 * whitespace, or the end */
+		size_t j = i;
+		int paren = 0, bracket = 0;
+		char strc = 0;
+		while (j < len) {
+			char c = sel[j];
+			if (strc != 0) {
+				if (c == strc)
+					strc = 0;
+				j++;
+				continue;
+			}
+			if (c == '"' || c == '\'') {
+				strc = c;
+				j++;
+				continue;
+			}
+			if (paren > 0) {
+				if (c == '(')
+					paren++;
+				else if (c == ')')
+					paren--;
+				j++;
+				continue;
+			}
+			if (c == '(') {
+				paren++;
+				j++;
+				continue;
+			}
+			if (bracket > 0) {
+				if (c == ']')
+					bracket--;
+				j++;
+				continue;
+			}
+			if (c == '[') {
+				bracket++;
+				j++;
+				continue;
+			}
+			if (c == '>' || c == '+' || c == '~' ||
+			    html_css_reach_ws((unsigned char)c))
+				break;
+			j++;
+		}
+		/* empty compound (stray combinator): consume it, else the
+		 * scan would not advance */
+		if (j == i) {
+			if (sel[i] == '>')
+				pend = 1;
+			else if (sel[i] == '+' || sel[i] == '~')
+				pend = 2;
+			i++;
+			continue;
+		}
+		/* the combinator after this compound, if any */
+		while (j < len && html_css_reach_ws((unsigned char)sel[j]))
+			j++;
+		{
+			int pc = pend;
+			pend = 0;
+			if (j < len && sel[j] == '>') {
+				j++;
+				pend = 1;
+				while (j < len &&
+				       html_css_reach_ws((unsigned char)sel[j]))
+					j++;
+			} else if (j < len && (sel[j] == '+' || sel[j] == '~')) {
+				j++;
+				pend = 2;
+				while (j < len &&
+				       html_css_reach_ws((unsigned char)sel[j]))
+					j++;
+			}
+			if (j > i && pc < 3) {
+				if (ncomp == cap) {
+					int nc = cap ? cap * 2 : 8;
+					int *ns;
+					ns = realloc(start, nc * sizeof(*ns));
+					if (ns != NULL) {
+						start = ns;
+						ns = realloc(cend, nc * sizeof(*ns));
+					}
+					if (ns != NULL) {
+						cend = ns;
+						ns = realloc(comb, nc * sizeof(*ns));
+					}
+					if (ns == NULL) {
+						free(start);
+						free(cend);
+						free(comb);
+						return NULL;
+					}
+					comb = ns;
+					cap = nc;
+				}
+				start[ncomp] = (int)i;
+				cend[ncomp] = (int)j;
+				comb[ncomp] = pc;
+				ncomp++;
+			}
+		}
+		i = j;
+	}
+	for (k = ncomp - 1; k >= 0; k--) {
+		bool ii;
+		char *t = reach_compound_token(sel + start[k],
+				cend[k] - start[k], &ii);
+		if (t == NULL)
+			continue;
+		if (k == ncomp - 1 || comb[k + 1] == 0 || comb[k + 1] == 1) {
+			*is_id = ii;
+			free(start);
+			free(cend);
+			free(comb);
+			return t;
+		}
+		free(t);
+	}
+	free(start);
+	free(cend);
+	free(comb);
+	return NULL;
+}
+
+struct reach_parser {
+	const char *s;
+	size_t len;
+	struct html_css_reach_table *t;
+	char **chain;
+	int nchain;
+	int chain_cap;
+	bool oom;
+};
+
+static bool reach_add_rec(struct reach_parser *p, uint32_t hash, int reason,
+		int ntok, char **tok)
+{
+	if (p->t->nrec % 64 == 0) {
+		struct html_css_reach_record *nr = realloc(p->t->rec,
+				sizeof(*nr) * (p->t->nrec + 64));
+		if (nr == NULL) {
+			p->oom = true;
+			return false;
+		}
+		p->t->rec = nr;
+	}
+	p->t->rec[p->t->nrec].hash = hash;
+	p->t->rec[p->t->nrec].reason = reason;
+	p->t->rec[p->t->nrec].ntok = ntok;
+	p->t->rec[p->t->nrec].tok = tok;
+	p->t->nrec++;
+	return true;
+}
+
+/* Hash the chain (the enclosing group preludes) + the normalized
+ * range [a,b). */
+static bool reach_hash_range(struct reach_parser *p, size_t a, size_t b,
+		uint32_t *h)
+{
+	struct reach_buf buf;
+	int ci;
+	bool ok = true;
+
+	memset(&buf, 0, sizeof(buf));
+	for (ci = 0; ci < p->nchain && ok; ci++) {
+		ok = reach_buf_put(&buf, p->chain[ci], strlen(p->chain[ci]));
+		ok = ok && reach_buf_put(&buf, " ", 1);
+	}
+	ok = ok && reach_norm_range(&buf, p->s, a, b);
+	if (ok)
+		*h = html_css_reach_fnv1a((const uint8_t *)buf.s, buf.len);
+	free(buf.s);
+	return ok;
+}
+
+/* One at-rule record over [a,b) (a,b the at-rule's full extent, or the
+ * statement's prelude up to its ';'). */
+static void reach_atrule_record(struct reach_parser *p, size_t a, size_t b)
+{
+	uint32_t h;
+	if (!reach_hash_range(p, a, b, &h)) {
+		p->oom = true;
+		return;
+	}
+	reach_add_rec(p, h, HTML_CSS_REACH_AT_RULE, 0, NULL);
+}
+
+/* One plain rule: prelude [sa, sb), block interior [ba, bb). */
+static void reach_plain_record(struct reach_parser *p, size_t sa, size_t sb,
+		size_t ba, size_t bb, size_t close)
+{
+	uint32_t h;
+	int reason = HTML_CSS_REACH_OK;
+	char **toks = NULL;
+	int ntok = 0, tcap = 0;
+	size_t m;
+	int paren, bracket;
+	char strc;
+
+	/* nesting: a '{' at depth 0 of the block interior */
+	reason = HTML_CSS_REACH_OK;
+	paren = bracket = 0;
+	strc = 0;
+	for (m = ba; m < bb; m++) {
+		char c = p->s[m];
+		if (strc != 0) {
+			if (c == strc)
+				strc = 0;
+			continue;
+		}
+		if (c == '"' || c == '\'') {
+			strc = c;
+			continue;
+		}
+		if (paren > 0) {
+			if (c == '(')
+				paren++;
+			else if (c == ')')
+				paren--;
+			continue;
+		}
+		if (c == '(') {
+			paren++;
+			continue;
+		}
+		if (bracket > 0) {
+			if (c == ']')
+				bracket--;
+			continue;
+		}
+		if (c == '[') {
+			bracket++;
+			continue;
+		}
+		if (c == '{') {
+			reason = HTML_CSS_REACH_NESTING;
+			break;
+		}
+	}
+
+	/* counters: the keywords, caseless, in the normalized block */
+	if (reason == HTML_CSS_REACH_OK) {
+		struct reach_buf nb;
+		size_t li;
+		memset(&nb, 0, sizeof(nb));
+		if (reach_norm_range(&nb, p->s, ba, bb)) {
+			for (li = 0; li < nb.len; li++)
+				nb.s[li] = (char)tolower((unsigned char)nb.s[li]);
+			if (strcasestr(nb.s, "counter-increment") != NULL ||
+			    strcasestr(nb.s, "counter-reset") != NULL ||
+			    strcasestr(nb.s, "counter-set") != NULL ||
+			    strcasestr(nb.s, "counter(") != NULL ||
+			    strcasestr(nb.s, "counters(") != NULL)
+				reason = HTML_CSS_REACH_COUNTER;
+		}
+		free(nb.s);
+	}
+
+	/* escape: a backslash in the raw prelude */
+	if (reason == HTML_CSS_REACH_OK) {
+		for (m = sa; m < sb; m++)
+			if (p->s[m] == '\\') {
+				reason = HTML_CSS_REACH_ESCAPE;
+				break;
+			}
+	}
+
+	/* anchors: each selector of the list, top-level commas */
+	if (reason == HTML_CSS_REACH_OK) {
+		struct reach_buf sb2;
+		size_t pos = 0;
+		bool unanch = false;
+		bool bad = false;
+		memset(&sb2, 0, sizeof(sb2));
+		bad = !reach_norm_range(&sb2, p->s, sa, sb);
+		while (!bad && !unanch) {
+			/* this selector ends at the next top-level ',' (a comma
+			 * inside (), [], strings does not split) or at the end */
+			size_t ce = 0;
+			paren = bracket = 0;
+			strc = 0;
+			for (m = pos; m < sb2.len; m++) {
+				char c = sb2.s[m];
+				if (strc != 0) {
+					if (c == strc)
+						strc = 0;
+					continue;
+				}
+				if (c == '"' || c == '\'') {
+					strc = c;
+					continue;
+				}
+				if (paren > 0) {
+					if (c == '(')
+						paren++;
+					else if (c == ')')
+						paren--;
+					continue;
+				}
+				if (c == '(') {
+					paren++;
+					continue;
+				}
+				if (bracket > 0) {
+					if (c == ']')
+						bracket--;
+					continue;
+				}
+				if (c == '[') {
+					bracket++;
+					continue;
+				}
+				if (c == ',') {
+					ce = m;
+					break;
+				}
+			}
+			if (ce == 0)
+				ce = sb2.len; /* no top-level comma: the last one */
+			{
+				bool ii;
+				char *t = reach_selector_anchor(
+						sb2.s + pos, ce - pos, &ii);
+				if (t == NULL) {
+					unanch = true;
+				} else {
+					int j;
+					bool seen = false;
+					for (j = 0; j < ntok; j++)
+						if (strcmp(toks[j], t) == 0) {
+							seen = true;
+							break;
+						}
+					if (!seen) {
+						if (ntok == tcap) {
+							int nt = tcap ? tcap * 2 : 4;
+							char **nt2 = realloc(
+									toks,
+									nt * sizeof(*nt2));
+							if (nt2 == NULL) {
+								bad = true;
+								break;
+							}
+							toks = nt2;
+							tcap = nt;
+						}
+						toks[ntok++] = t;
+					} else {
+						free(t);
+					}
+				}
+			}
+			if (ce == sb2.len)
+				break;
+			pos = ce + 1;
+		}
+		free(sb2.s);
+		if (bad) {
+			for (m = 0; m < (size_t)ntok; m++)
+				free(toks[m]);
+			free(toks);
+			p->oom = true;
+			return;
+		}
+		if (unanch) {
+			for (m = 0; m < (size_t)ntok; m++)
+				free(toks[m]);
+			free(toks);
+			reason = HTML_CSS_REACH_UNANCHORED;
+			toks = NULL;
+			ntok = 0;
+		}
+	}
+
+	if (!reach_hash_range(p, sa, close + 1, &h)) {
+		for (m = 0; m < (size_t)ntok; m++)
+			free(toks[m]);
+		free(toks);
+		p->oom = true;
+		return;
+	}
+	reach_add_rec(p, h, reason, ntok, toks);
+}
+
+static bool reach_is_group_name(const char *s, size_t a, size_t b)
+{
+	static const char *const grp[] = {
+		"media", "supports", "document", "layer"
+	};
+	int i;
+
+	for (i = 0; i < 4; i++) {
+		size_t n = strlen(grp[i]);
+		if (b - a == n &&
+		    strncasecmp(s + a, grp[i], n) == 0)
+			return true;
+	}
+	return false;
+}
+
+/* Parse the block interior [a,b) into records; the enclosing group
+ * preludes are the chain (nchain of them). */
+static void reach_parse_block(struct reach_parser *p, size_t a, size_t b)
+{
+	size_t i = a;
+
+	while (i < b && !p->oom) {
+		while (i < b && html_css_reach_ws((unsigned char)p->s[i]))
+			i++;
+		if (i >= b)
+			break;
+		/* the prelude: to the first top-level ';', '{' or '}' */
+		size_t j = i;
+		int paren = 0, bracket = 0;
+		char strc = 0;
+		while (j < b) {
+			char c = p->s[j];
+			if (strc != 0) {
+				if (c == strc)
+					strc = 0;
+				j++;
+				continue;
+			}
+			if (c == '"' || c == '\'') {
+				strc = c;
+				j++;
+				continue;
+			}
+			if (paren > 0) {
+				if (c == '(')
+					paren++;
+				else if (c == ')')
+					paren--;
+				j++;
+				continue;
+			}
+			if (c == '(') {
+				paren++;
+				j++;
+				continue;
+			}
+			if (bracket > 0) {
+				if (c == ']')
+					bracket--;
+				j++;
+				continue;
+			}
+			if (c == '[') {
+				bracket++;
+				j++;
+				continue;
+			}
+			if (c == ';' || c == '{' || c == '}')
+				break;
+			j++;
+		}
+		if (j >= b)
+			break;
+		if (p->s[j] == ';') {
+			reach_atrule_record(p, i, j);
+			i = j + 1;
+			continue;
+		}
+		/* '{' at j: find the matching '}' */
+		{
+			int depth = 1;
+			size_t k = j + 1;
+			paren = bracket = 0;
+			strc = 0;
+			while (k < b && depth > 0) {
+				char c = p->s[k];
+				if (strc != 0) {
+					if (c == strc)
+						strc = 0;
+					k++;
+					continue;
+				}
+				if (c == '"' || c == '\'') {
+					strc = c;
+					k++;
+					continue;
+				}
+				if (paren > 0) {
+					if (c == '(')
+						paren++;
+					else if (c == ')')
+						paren--;
+					k++;
+					continue;
+				}
+				if (c == '(') {
+					paren++;
+					k++;
+					continue;
+				}
+				if (bracket > 0) {
+					if (c == ']')
+						bracket--;
+					k++;
+					continue;
+				}
+				if (c == '[') {
+					bracket++;
+					k++;
+					continue;
+				}
+				if (c == '{')
+					depth++;
+				else if (c == '}')
+					depth--;
+				k++;
+			}
+			if (depth != 0) {
+				/* unbalanced: stop parsing */
+				i = b;
+				break;
+			}
+			if (p->s[i] == '@') {
+				/* the at-rule name: to the first
+				 * whitespace / '(' / '{' after the '@' */
+				size_t nm = i + 1;
+				while (nm < j &&
+				       !html_css_reach_ws((unsigned char)p->s[nm]) &&
+				       p->s[nm] != '(' && p->s[nm] != '{')
+					nm++;
+				if (reach_is_group_name(p->s, i + 1, nm) &&
+				    p->nchain < HTML_CSS_REACH_MAX_GROUP) {
+					char *cp;
+					struct reach_buf cb;
+					memset(&cb, 0, sizeof(cb));
+					cp = NULL;
+					if (reach_norm_range(&cb, p->s, i, j)) {
+						cp = cb.s;
+						cb.s = NULL;
+					}
+					if (cp == NULL) {
+						free(cb.s);
+						p->oom = true;
+						break;
+					}
+					if (p->nchain == p->chain_cap) {
+						int nc = p->chain_cap ?
+								p->chain_cap * 2 : 4;
+						char **ncp = realloc(p->chain,
+								nc * sizeof(*ncp));
+						if (ncp == NULL) {
+							free(cp);
+							p->oom = true;
+							break;
+						}
+						p->chain = ncp;
+						p->chain_cap = nc;
+					}
+					p->chain[p->nchain] = cp;
+					p->nchain++;
+					reach_parse_block(p, j + 1, k - 1);
+					free(p->chain[p->nchain - 1]);
+					p->nchain--;
+				} else {
+					reach_atrule_record(p, i, k);
+				}
+			} else {
+				reach_plain_record(p, i, j, j + 1, k - 1, k - 1);
+			}
+			i = k;
+		}
+	}
+}
+
+/* Scan a sheet source into its record table (NULL on OOM). */
+static struct html_css_reach_table *html_css_reach_scan(const char *src,
+		size_t len)
+{
+	char *s;
+	struct reach_parser p;
+	struct html_css_reach_table *t;
+
+	t = calloc(1, sizeof(*t));
+	if (t == NULL)
+		return NULL;
+	s = reach_strip_comments(src, len);
+	if (s == NULL) {
+		free(t);
+		return NULL;
+	}
+	memset(&p, 0, sizeof(p));
+	p.s = s;
+	p.len = len;
+	p.t = t;
+	reach_parse_block(&p, 0, len);
+	free(s);
+	free(p.chain);
+	if (p.oom) {
+		html_css_reach_table_free(t);
+		return NULL;
+	}
+	return t;
+}
+
+/* B.3: capture both versions' tables at the processed edit. */
+static void html_css_reach_capture(html_content *c, struct html_stylesheet *s)
+{
+	struct html_css_reach_table *prev;
+	dom_string *text;
+	dom_exception exc;
+
+	if (s->node == NULL) {
+		/* a <link> sheet: its next version is a fresh fetch, not
+		 * DOM text; its census reports no-source. */
+		html_css_reach_table_free(s->reach_prev);
+		html_css_reach_table_free(s->reach_cur);
+		s->reach_prev = NULL;
+		s->reach_cur = NULL;
+		return;
+	}
+
+	/* the live table is the version the boxes were built from (it
+	 * was computed at the last processed edit); with no table yet
+	 * (the first edit of this <style>) the outgoing source is the
+	 * old sheet's -- read it now, the caller releases the handle
+	 * right after. */
+	prev = s->reach_cur;
+	s->reach_cur = NULL;
+	if (prev == NULL) {
+		const uint8_t *data = NULL;
+		size_t size = 0;
+		if (s->sheet != NULL)
+			data = content_get_source_data(s->sheet, &size);
+		if (data != NULL) {
+			prev = html_css_reach_scan((const char *)data, size);
+		} else if (s->sheet == NULL) {
+			/* never loaded: nothing was built from */
+			prev = html_css_reach_scan("", 0);
+		}
+	}
+	html_css_reach_table_free(s->reach_prev);
+	s->reach_prev = prev;
+
+	/* B1 builds the incoming table eagerly here (B.3's lazy
+	 * build-at-flush is C's): the DOM text is the new version's
+	 * source -- html_stylesheet_from_domnode hands those same bytes
+	 * to the fetcher -- so the scan count is the same (once per
+	 * version) and the lifetime is simpler. */
+	exc = dom_node_get_text_content(s->node, &text);
+	if (exc == DOM_NO_ERR) {
+		if (text != NULL) {
+			s->reach_cur = html_css_reach_scan(
+						dom_string_data(text),
+						dom_string_byte_length(text));
+		} else {
+			/* emptied: an empty sheet */
+			s->reach_cur = html_css_reach_scan("", 0);
+		}
+		dom_string_unref(text);
+	}
+	/* on error s->reach_cur stays NULL: the census reports
+	 * no-source */
+}
+
+/* B.4: the walk's state; the matched roots are recorded for B.5. */
+struct reach_walk {
+	char **tok; /* id tokens keep their '#', class tokens bare */
+	lwc_string **lwc;
+	int ntok;
+	unsigned long roots;
+	unsigned long walked;
+	dom_node *rlist[HTML_CSS_REACH_MAX_ROOTS];
+	int nrlist;
+};
+
+/* Lazily-created dom_string for the "id" attribute name (the census
+ * walk reads it through the generic attribute getter; this fork has
+ * no dom_html_element_get_id). Process-lifetime static: the census
+ * is a logger, this never gets freed. */
+static dom_string *reach_id_name(void)
+{
+	static dom_string *id_name = NULL;
+	if (id_name == NULL)
+		dom_string_create((const uint8_t *)"id", 2, &id_name);
+	return id_name;
+}
+
+/* Does element n carry one of the walk's tokens? */
+static bool reach_matches(dom_node *n, struct reach_walk *w)
+{
+	bool matched = false;
+	int t;
+	dom_string *id = NULL;
+
+	for (t = 0; t < w->ntok && !matched; t++) {
+		if (w->tok[t][0] == '#') {
+			if (id == NULL && reach_id_name() != NULL)
+				dom_element_get_attribute((dom_element *)n,
+						reach_id_name(), &id);
+			if (id != NULL) {
+				const char *d = dom_string_data(id);
+				size_t sz = dom_string_byte_length(id);
+				if (sz == strlen(w->tok[t] + 1) &&
+				    memcmp(d, w->tok[t] + 1, sz) == 0)
+					matched = true;
+			}
+		} else if (w->lwc[t] != NULL) {
+			dom_element_has_class((dom_element *)n, w->lwc[t],
+					&matched);
+		}
+	}
+	if (id != NULL)
+		dom_string_unref(id);
+	return matched;
+}
+
+/* B.4: the walk, in document order and without recursion (a deep DOM
+ * must not grow the C stack on the Vita). A matched element is a root
+ * and its subtree is skipped; the roots are recorded for B.5. Every
+ * node reference taken here is released before the next step. */
+static void reach_walk_tree(dom_node *root, struct reach_walk *w)
+{
+	dom_node *n = dom_node_ref(root);
+
+	while (n != NULL) {
+		dom_node_type type;
+		dom_node *next = NULL;
+		bool descend = true;
+
+		w->walked++;
+		if (dom_node_get_node_type(n, &type) == DOM_NO_ERR &&
+		    type == DOM_ELEMENT_NODE && reach_matches(n, w)) {
+			if (w->nrlist < HTML_CSS_REACH_MAX_ROOTS)
+				w->rlist[w->nrlist++] = n;
+			w->roots++;
+			descend = false;
+		}
+		if (descend &&
+		    dom_node_get_first_child(n, &next) != DOM_NO_ERR)
+			next = NULL;
+		/* no child (or skipped): the next sibling of n or of the
+		 * nearest ancestor below root that has one */
+		while (next == NULL && n != root) {
+			dom_node *parent = NULL;
+			if (dom_node_get_next_sibling(n, &next) != DOM_NO_ERR)
+				next = NULL;
+			if (next != NULL)
+				break;
+			if (dom_node_get_parent_node(n, &parent) !=
+			    DOM_NO_ERR || parent == NULL)
+				break;
+			dom_node_unref(n);
+			n = parent;
+		}
+		dom_node_unref(n);
+		n = next;
+	}
+}
+
+/* B.5's static checks: the roots the census declines (1) -- <html>,
+ * <body>, <li>, a child of <ol>/<ul>/<menu>, a root with no box. The
+ * display-based checks are C's. */
+static bool reach_name_is(const dom_string *name, const char *s)
+{
+	size_t sz = dom_string_byte_length(name);
+	const char *d = dom_string_data(name);
+	size_t i;
+
+	if (sz != strlen(s))
+		return false;
+	for (i = 0; i < sz; i++) {
+		char a = (char)tolower((unsigned char)d[i]);
+		char b = (char)tolower((unsigned char)s[i]);
+		if (a != b)
+			return false;
+	}
+	return true;
+}
+
+static bool reach_root_admission(dom_node *n)
+{
+	dom_string *name;
+	bool r = false;
+	dom_node *parent;
+	static const char *const adm[] = { "html", "body", "li" };
+	static const char *const parents[] = { "ol", "ul", "menu" };
+	int i;
+
+	if (dom_node_get_node_name(n, &name) == DOM_NO_ERR && name != NULL) {
+		for (i = 0; i < 3; i++)
+			if (reach_name_is(name, adm[i]))
+				r = true;
+		dom_string_unref(name);
+	}
+	if (!r && dom_node_get_parent_node(n, &parent) == DOM_NO_ERR &&
+	    parent != NULL) {
+		if (dom_node_get_node_name(parent, &name) == DOM_NO_ERR && name != NULL) {
+			for (i = 0; i < 3; i++)
+				if (reach_name_is(name, parents[i]))
+					r = true;
+			dom_string_unref(name);
+		}
+		dom_node_unref(parent);
+	}
+	if (!r && box_for_node(n) == NULL)
+		r = true;
+	return r;
+}
+
+/* The census: exported, documented in html/css.h. */
+void html_css_sheet_reach_census(struct content *cc, int index,
+		struct html_css_reach_result *out)
+{
+	html_content *c = (html_content *)cc;
+	struct html_stylesheet *s;
+	const struct html_css_reach_table *o, *n;
+	int p, suf, omid, nmid;
+	unsigned int k;
+	int reason = HTML_CSS_REACH_OK;
+	int i;
+
+	memset(out, 0, sizeof(*out));
+	out->reason = HTML_CSS_REACH_NO_SOURCE;
+
+	if (c == NULL || c->stylesheets == NULL || index < 0 ||
+	    (size_t)index >= c->stylesheet_count)
+		return;
+	s = &c->stylesheets[index];
+	o = s->reach_prev;
+	n = s->reach_cur;
+	if (o == NULL || n == NULL)
+		return;
+
+	/* B.2: the longest common prefix and suffix; the middle, both
+	 * sides, is the change. */
+	p = 0;
+	while (p < o->nrec && p < n->nrec &&
+	       o->rec[p].hash == n->rec[p].hash)
+		p++;
+	suf = 0;
+	while (suf < o->nrec - p && suf < n->nrec - p &&
+	       o->rec[o->nrec - 1 - suf].hash ==
+	       n->rec[n->nrec - 1 - suf].hash)
+		suf++;
+	omid = o->nrec - p - suf;
+	nmid = n->nrec - p - suf;
+	k = (unsigned int)omid + (unsigned int)nmid;
+	out->changed = k;
+	if (k == 0) {
+		out->bounded = 1;
+		out->reason = HTML_CSS_REACH_OK;
+		return;
+	}
+	if (k > HTML_CSS_REACH_MAX_CHANGED) {
+		out->reason = HTML_CSS_REACH_TOO_MANY;
+		return;
+	}
+
+	/* the changed records' causes, in priority order */
+	{
+		static const int prio[] = {
+			HTML_CSS_REACH_AT_RULE,
+			HTML_CSS_REACH_COUNTER,
+			HTML_CSS_REACH_NESTING,
+			HTML_CSS_REACH_ESCAPE,
+			HTML_CSS_REACH_UNANCHORED
+		};
+		int pr;
+		for (pr = 0; pr < 5 && reason == HTML_CSS_REACH_OK; pr++) {
+			for (i = p; i < p + omid; i++)
+				if (o->rec[i].reason == prio[pr]) {
+					reason = prio[pr];
+					break;
+				}
+			for (i = p; i < p + nmid && reason == HTML_CSS_REACH_OK;
+			     i++)
+				if (n->rec[i].reason == prio[pr]) {
+					reason = prio[pr];
+					break;
+				}
+		}
+	}
+	if (reason != HTML_CSS_REACH_OK) {
+		out->reason = reason;
+		return;
+	}
+
+	/* the changed records' anchor tokens, distinct */
+	{
+		char **toks = NULL;
+		lwc_string **lwc = NULL;
+		int ntok = 0, tcap = 0;
+		int t;
+
+		for (i = p; i < p + omid; i++)
+			for (t = 0; t < o->rec[i].ntok; t++) {
+				int j, seen = 0;
+				for (j = 0; j < ntok; j++)
+					if (strcmp(toks[j], o->rec[i].tok[t]) == 0) {
+						seen = 1;
+						break;
+					}
+				if (seen)
+					continue;
+				if (ntok == tcap) {
+					int nt = tcap ? tcap * 2 : 4;
+					char **nt2;
+					lwc_string **nl2;
+					nt2 = realloc(toks, nt * sizeof(*nt2));
+					if (nt2 == NULL)
+						goto no_tokens;
+					toks = nt2;
+					nl2 = realloc(lwc, nt * sizeof(*nl2));
+					if (nl2 == NULL)
+						goto no_tokens;
+					lwc = nl2;
+					tcap = nt;
+				}
+				toks[ntok] = o->rec[i].tok[t];
+				lwc[ntok] = NULL;
+				ntok++;
+			}
+		for (i = p; i < p + nmid; i++)
+			for (t = 0; t < n->rec[i].ntok; t++) {
+				int j, seen = 0;
+				for (j = 0; j < ntok; j++)
+					if (strcmp(toks[j], n->rec[i].tok[t]) == 0) {
+						seen = 1;
+						break;
+					}
+				if (seen)
+					continue;
+				if (ntok == tcap) {
+					int nt = tcap ? tcap * 2 : 4;
+					char **nt2;
+					lwc_string **nl2;
+					nt2 = realloc(toks, nt * sizeof(*nt2));
+					if (nt2 == NULL)
+						goto no_tokens;
+					toks = nt2;
+					nl2 = realloc(lwc, nt * sizeof(*nl2));
+					if (nl2 == NULL)
+						goto no_tokens;
+					lwc = nl2;
+					tcap = nt;
+				}
+				toks[ntok] = n->rec[i].tok[t];
+				lwc[ntok] = NULL;
+				ntok++;
+			}
+		out->anchors = (unsigned int)ntok;
+		if (ntok == 0) {
+			out->reason = HTML_CSS_REACH_UNANCHORED;
+			goto no_tokens;
+		}
+		if (c->document == NULL)
+			goto no_tokens;
+
+		/* the walk (B.4): id tokens ('#x') compare raw, class
+		 * tokens (bare) go through dom_element_has_class */
+		{
+			struct reach_walk w;
+			bool ok = true;
+			memset(&w, 0, sizeof(w));
+			w.tok = toks;
+			w.lwc = lwc;
+			w.ntok = ntok;
+			for (t = 0; t < ntok && ok; t++)
+				if (toks[t][0] != '#')
+					ok = (lwc_intern_string(toks[t],
+							strlen(toks[t]),
+							&lwc[t]) ==
+					     lwc_error_ok);
+			if (!ok) {
+				for (t = 0; t < ntok; t++)
+					if (lwc[t] != NULL)
+						lwc_string_unref(lwc[t]);
+				goto no_tokens;
+			}
+			reach_walk_tree((dom_node *)c->document, &w);
+			out->roots = (unsigned int)w.roots;
+			out->walked = (unsigned int)w.walked;
+			if (w.roots == 0) {
+				out->bounded = 1;
+				out->reason = HTML_CSS_REACH_OK;
+				goto no_tokens;
+			}
+			/* B.5's static checks, per root */
+			for (t = 0; t < w.nrlist; t++) {
+				if (reach_root_admission(w.rlist[t])) {
+					out->reason = HTML_CSS_REACH_ADMISSION;
+					goto no_tokens;
+				}
+			}
+			out->bounded = 1;
+			out->reason = HTML_CSS_REACH_OK;
+		}
+no_tokens:
+		for (t = 0; t < ntok; t++)
+			if (lwc[t] != NULL)
+				lwc_string_unref(lwc[t]);
+		free(toks);
+		free(lwc);
+	}
+}
+
+/* The reason enum as the log strings (see html/css.h). */
+const char *html_css_reach_reason_name(int reason)
+{
+	switch (reason) {
+	case HTML_CSS_REACH_OK:
+		return "bounded";
+	case HTML_CSS_REACH_AT_RULE:
+		return "at-rule";
+	case HTML_CSS_REACH_TOO_MANY:
+		return "too-many";
+	case HTML_CSS_REACH_COUNTER:
+		return "counter";
+	case HTML_CSS_REACH_NESTING:
+		return "nesting";
+	case HTML_CSS_REACH_ESCAPE:
+		return "escape";
+	case HTML_CSS_REACH_UNANCHORED:
+		return "unanchored";
+	case HTML_CSS_REACH_ADMISSION:
+		return "admission";
+	case HTML_CSS_REACH_NO_SOURCE:
+		return "no-source";
+	}
+	return "unknown";
+}
