+	 * An exact, cheap pre-check for the named lookups below, using only
+	 * native lookups: getElementById, and a plain-selector query (the
+	 * native matcher) with one attribute read per element. Patch 305
+	 * wraps every member of Node / Element / HTMLElement for forms, so
+	 * each firstChild / nodeType / getAttribute read on a form ran the
+	 * whole control search -- a full-document JS walk for '[form]', the
+	 * controls' owner walks, and an owner walk per <img> -- and any DOM
+	 * walk passing a form paid it per read (theguardian.com: ~130 s of
+	 * CPU in one timer before a document appeared). A name no element
+	 * carries cannot shadow, so those reads now return at once. */
+	function anyNamed(node, tags, n) {
+		if (!node || typeof n !== 'string' || n === '') return true;
+		/* its own reads (ownerDocument and getAttribute on a form, ...)
+		 * must not re-enter the named lookups: run under 297's guard,
+		 * as the search does */
+		var was = inNamed;
+		inNamed = true;
+		try {
+			var doc = node.nodeType === 9 ? node : node.ownerDocument || d;
+			if (doc.getElementById(n)) return true;
+			var a = doc.querySelectorAll(tags);
+			for (var i = 0; i < a.length; i++)
+				if (a[i].getAttribute('name') === n) return true;
+			return false;
+		} catch (e) {
+			return true;	/* unsure: take the full search */
+		} finally {
+			inNamed = was;
+		}
+	}
+	var NAMEABLE = LISTED + ',img';
 
