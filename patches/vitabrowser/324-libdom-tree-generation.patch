+/* VitaBrowser patch 324: a process-wide generation number that moves on
+ * every change that can alter which elements are in a tree or what their
+ * attributes are -- a node attached, detached or replaced, an attribute
+ * set, changed or removed (__dom_dispatch_attr_modified_event). Callers
+ * cache answers computed from the tree and reuse them while it is
+ * unchanged (the bridge's form named-access check). Wrap-around is
+ * harmless: a reader compares for equality with the value it cached. */
+static unsigned long dom_tree_gen = 1;
+
+unsigned long dom_tree_generation(void)
+{
+	return dom_tree_gen;
+}
+
+void _dom_tree_generation_bump(void)
+{
+	dom_tree_gen++;
+}
