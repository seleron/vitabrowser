# libdom: a process-wide tree generation number (patch 324)
# Generated 2026-10-28
# Base: seleron/vitabrowser (patch stack through 323)
#
# dom_tree_generation() returns a counter that moves on every change that
# can alter which elements are in a tree or what their attributes are:
# _dom_node_attach_range, _dom_node_detach_range and _dom_node_replace
# (every insert / remove / replace funnels through them), and
# __dom_dispatch_attr_modified_event (every attribute set, change and
# removal; attributes set on a detached element are covered by its
# attach). Callers cache answers computed from the tree and reuse them
# while the value is unchanged; they compare for equality, so wrap-around
# is harmless. Used by the bridge's form named-access check (the netsurf
# half of patch 324, __vitaDomGen).
#
# A counter in the bridge's own mutation hook (macsurf_js_note_dom_mutation)
# would not do: it sits on the reconvert-mark path, which some mutations
# return before reaching, and it does not see parser-made changes.
--- a/include/dom/core/node.h
+++ b/include/dom/core/node.h
@@ -576,4 +576,9 @@
 #define dom_node_get_user_data(n, k, r) dom_node_get_user_data( \
 		(dom_node *) (n), (k), (void **) (r))
 
+/* VitaBrowser patch 324: the process-wide tree generation -- it moves on
+ * every attach, detach, replace and attribute change; equal values mean
+ * no element was added, removed or had an attribute changed in between. */
+unsigned long dom_tree_generation(void);
+
 #endif
--- a/src/core/node.c
+++ b/src/core/node.c
@@ -2145,6 +2145,25 @@
  *
  * The range is assumed to be a linked list of sibling nodes.
