# netsurf: the checkbox paints at the composed group opacity (patch 325)
# Generated 2026-10-29
# Base: seleron/vitabrowser (patch stack through 324)
#
# Doc 24's last open item (its 2026-10-26 status): checkbox gadgets drew
# their base fill, bevel lines and tick from the shared static plot
# styles, so a checkbox inside an opacity group painted solid while the
# radio beside it (patch 315), the text (311) and the borders (314) faded.
#
#  - redraw.c html_redraw_checkbox(): local copies of the base, dark and
#    light bevel styles beside the existing accent-color blob copies; all
#    five take g_group_opacity when it is below PLOT_STYLE_SCALE, as
#    html_redraw_radio() does. The vita line and rectangle ops already
#    derive their bucket from the style (patch 314) and trace OPAQUE <n>.
#
# Gate: CSS-opacity-group gains a checked checkbox inside .half and one
# outside. The faded one traces its 13x13 base RECT and all six LINEs
# (four bevel, two tick) with OPAQUE 2, the control none: RECT 1/1, LINE
# 6/12. Built without this patch the leg reads RECT 0/2, LINE 0/12. The
# dashed-border LINE count now takes only the page's long lines (>= 20 px)
# so the checkbox lines do not join it.
--- a/content/handlers/html/redraw.c
+++ b/content/handlers/html/redraw.c
@@ -1170,11 +1170,24 @@
 	 * static plot styles. */
 	plot_style_t blob_fill = *plot_style_fill_wblobc;
 	plot_style_t blob_stroke = *plot_style_stroke_wblobc;
+	/* VitaBrowser patch 325: the checkbox's base, bevel lines and mark
+	 * paint at the composed group opacity (local copies of the shared
+	 * styles, as the radio does since patch 315). */
+	plot_style_t base = *plot_style_fill_wbasec;
+	plot_style_t dark = *plot_style_stroke_darkwbasec;
+	plot_style_t light = *plot_style_stroke_lightwbasec;
 
 	if (accent_set) {
 		blob_fill.fill_colour = accent_col;
 		blob_stroke.stroke_colour = accent_col;
 	}
+	if (g_group_opacity < (plot_style_fixed)PLOT_STYLE_SCALE) {
+		base.opacity = g_group_opacity;
+		dark.opacity = g_group_opacity;
+		light.opacity = g_group_opacity;
+		blob_fill.opacity = g_group_opacity;
+		blob_stroke.opacity = g_group_opacity;
+	}
 
 	z = width * 0.15;
 	if (z == 0) {
@@ -1185,14 +1198,14 @@
 	rect.y0 = y ;
 	rect.x1 = x + width;
 	rect.y1 = y + height;
-	res = ctx->plot->rectangle(ctx, plot_style_fill_wbasec, &rect);
+	res = ctx->plot->rectangle(ctx, &base, &rect);
 	if (res != NSERROR_OK) {
 		return false;
 	}
 
 	/* dark line across top */
 	rect.y1 = y;
-	res = ctx->plot->line(ctx, plot_style_stroke_darkwbasec, &rect);
+	res = ctx->plot->line(ctx, &dark, &rect);
 	if (res != NSERROR_OK) {
 		return false;
 	}
@@ -1200,7 +1213,7 @@
 	/* dark line across left */
 	rect.x1 = x;
 	rect.y1 = y + height;
-	res = ctx->plot->line(ctx, plot_style_stroke_darkwbasec, &rect);
+	res = ctx->plot->line(ctx, &dark, &rect);
 	if (res != NSERROR_OK) {
 		return false;
 	}
@@ -1208,7 +1221,7 @@
 	/* light line across right */
 	rect.x0 = x + width;
 	rect.x1 = x + width;
-	res = ctx->plot->line(ctx, plot_style_stroke_lightwbasec, &rect);
+	res = ctx->plot->line(ctx, &light, &rect);
 	if (res != NSERROR_OK) {
 		return false;
 	}
@@ -1216,7 +1229,7 @@
 	/* light line across bottom */
 	rect.x0 = x;
 	rect.y0 = y + height;
-	res = ctx->plot->line(ctx, plot_style_stroke_lightwbasec, &rect);
+	res = ctx->plot->line(ctx, &light, &rect);
 	if (res != NSERROR_OK) {
 		return false;
 	}
