 /**
+ * VitaBrowser patch 327: length x px-per-unit for an exact-scale unit, in
+ * CSS pixels. Viewport and pt/pc/in lengths are computed as length x size
+ * / divisor in one step: 9.6 (1vw at 960) is not exact in 22.10 fixed
+ * point, and 10 x 9.5996 truncates to 95, not 96. Lengths too large for
+ * the one-step product fall back to length x the scale.
+ */
+static inline css_fixed css_unit__exact_len(const css_computed_style *style,
+		const css_fixed viewport_height, const css_fixed viewport_width,
+		const css_fixed length, const css_unit unit,
+		const css_fixed px_per_unit)
+{
+	css_fixed mag = (length < 0) ? -length : length;
+
+	switch (css_unit__map_viewport_units(style, viewport_height,
+			viewport_width, unit)) {
+	case CSS_UNIT_VW:
+		if (mag <= INTTOFIX(2000))
+			return FDIV(FMUL(length, viewport_width), F_100);
+		break;
+	case CSS_UNIT_VH:
+		if (mag <= INTTOFIX(2000))
+			return FDIV(FMUL(length, viewport_height), F_100);
+		break;
+	case CSS_UNIT_PT:
+		if (mag <= INTTOFIX(20000))
+			return FDIV(FMUL(length, F_96), F_72);
+		break;
+	case CSS_UNIT_PC:
+		return FMUL(length, INTTOFIX(16));
+	case CSS_UNIT_IN:
+		return FMUL(length, F_96);
+	default:
+		break;
+	}
+	return FMUL(length, px_per_unit);
+}
