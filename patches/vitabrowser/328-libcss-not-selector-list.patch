+/**
+ * VitaBrowser patch 328: is the argument at *ctx one simple selector
+ * followed by ')' (the CSS 2/3 form of :not())? Probes only: the caller
+ * restores *ctx either way. Nothing is allocated (detail init takes no
+ * references), so abandoning the probe leaks nothing.
+ */
+static bool parseNotSimple(css_language *c, const parserutils_vector *vector,
+		int32_t *ctx)
+{
+	const css_token *token = parserutils_vector_peek(vector, *ctx);
+	css_selector_detail det;
+	css_qname qname;
+
+	if (token == NULL)
+		return false;
+	if (token->type == CSS_TOKEN_IDENT || tokenIsChar(token, '*') ||
+			tokenIsChar(token, '|')) {
+		if (parseTypeSelector(c, vector, ctx, &qname) != CSS_OK)
+			return false;
+	} else if (parseSpecific(c, vector, ctx, true, &det) != CSS_OK) {
+		return false;
+	}
+	consumeWhitespace(vector, ctx);
+	token = parserutils_vector_peek(vector, *ctx);
+	return token != NULL && tokenIsChar(token, ')');
+}
+
+/**
+ * VitaBrowser patch 328: does a selector (any compound of its chain, or an
+ * :is()/:where() list inside it) use a pseudo-class this libcss parses but
+ * never matches (:has(), :host, :host-context())? Negated by :not(), such a
+ * selector would match every element; fixes360b rejects them inside a
+ * simple :not() for the same reason.
+ */
+static bool selector_never_matches_part(css_language *c,
+		const css_selector *sel)
+{
+	const css_selector *s;
+	const css_selector_detail *d;
+	uint32_t i;
+
+	for (s = sel; s != NULL; s = s->combinator) {
+		for (d = &s->data; d != NULL; d = d->next ? d + 1 : NULL) {
+			if (d->type != CSS_SELECTOR_PSEUDO_CLASS)
+				continue;
+			if (d->value_type == CSS_SELECTOR_DETAIL_VALUE_SELLIST) {
+				for (i = 0; i < d->value.sellist->count; i++) {
+					if (selector_never_matches_part(c,
+						d->value.sellist->sel[i]))
+						return true;
+				}
+				continue;
+			}
+			if (d->qname.name == c->strings[HAS_FN] ||
+					d->qname.name == c->strings[HOST] ||
+					d->qname.name == c->strings[HOST_CONTEXT])
+				return true;
+		}
+	}
+	return false;
+}
