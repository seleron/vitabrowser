+/**
+ * VitaBrowser patch 329: does the declaration being applied beat the one
+ * in \a existing on specificity, then cascade order? Inline, cascade
+ * order is processing order and every newcomer is later, so this is the
+ * old ">=" test. A queued var() declaration replays after the cascade
+ * with its own position restored, and loses a tie to anything after it.
+ */
+static inline bool css__later_or_more_specific(const css_select_state *state,
+		const prop_state *existing)
+{
+	uint32_t seq = (state->current_seq > 0xffffff) ?
+			0xffffff : state->current_seq;
+
+	if (state->current_specificity != existing->specificity)
+		return state->current_specificity > existing->specificity;
+	return seq >= existing->seq;
+}
