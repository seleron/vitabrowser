+/**
+ * \file
+ * Vita frontend: on-device diagnostics for hardware testing.
+ *
+ * Everything lands in VITA_DIAG_DIR on the memory card so a test run can be
+ * copied off and read on the desktop: a timestamped log (each line is
+ * flushed to the card, so a crash leaves everything up to it), plot-stream
+ * dumps in the nsmonkey format (diffable against the desktop goldens and
+ * the host simulator's dumps), PGF font metrics, and memory figures.
+ */
+
+#ifndef NETSURF_VITA_DIAG_H
+#define NETSURF_VITA_DIAG_H
+
+#include <stdbool.h>
+#include <stdio.h>
+
+/** Where diagnostics are written (created on start-up). */
+#define VITA_DIAG_DIR "ux0:data/VitaBrowser/"
+
+/** Open the log and write the boot banner. Safe to call before anything. */
+void vita_diag_init(void);
+
+/** Append one timestamped line to the log (printf format). */
+void vita_diag_log(const char *fmt, ...)
+	__attribute__((format(printf, 1, 2)));
+
+/** Milliseconds since vita_diag_init(), monotonic enough for timing. */
+unsigned int vita_diag_ms(void);
+
+/** Log free memory in every pool, tagged. */
+void vita_diag_memory(const char *tag);
+
+/** Allocate-until-failure in each pool, log the totals, free it all. */
+void vita_diag_mem_probe(void);
+
+/** Log the system font's metrics as the layout sees them. */
+void vita_diag_font_metrics(void);
+
+/**
+ * Start dumping plot calls to VITA_DIAG_DIR<name>.plot.
+ * Every plotter call until vita_diag_trace_end() is written in the
+ * nsmonkey plot-stream format.
+ */
+bool vita_diag_trace_begin(const char *name);
+
+/** Stop dumping; closes the file. */
+void vita_diag_trace_end(void);
+
+/** The open dump, or NULL: the plotters write to it when set. */
+extern FILE *vita_plot_trace;
+
+/** Create an empty marker file in VITA_DIAG_DIR (e.g. "autotest.done"). */
+void vita_diag_marker(const char *name);
+
+#endif
