+ * GNU General Public License for more details.
+ *
+ * You should have received a copy of the GNU General Public License
+ * along with this program.  If not, see <http://www.gnu.org/licenses/>.
+ */
+
+/**
+ * \file
+ * Vita frontend: on-device diagnostics for hardware testing.
+ *
+ * The SDK-only queries (memory pools, budget, clocks) are under __vita__;
+ * the host simulator build logs "n/a" for them and runs the rest unchanged,
+ * which is what makes its dumps a reference for the device's.
+ */
+
+#include <stdarg.h>
+#include <stdbool.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#ifdef __vita__
+#include <malloc.h>
+#endif
+#include <sys/stat.h>
+#include <sys/time.h>
+#include <sys/types.h>
+
+#include <vita2d.h>
+#ifdef __vita__
+#include <psp2/appmgr.h>
+#include <psp2/kernel/sysmem.h>
+#include <psp2/power.h>
+#endif
+
+#include "vita/plot.h"
+#include "vita/diag.h"
+
+/** Chunk size for the allocate-until-failure probes. */
+#define PROBE_CHUNK (1024 * 1024)
+/** Probe cap: above the Vita's 365 MiB ceiling, and keeps a host sane. */
+#define PROBE_MAX 512
+
+FILE *vita_plot_trace;
+
+static struct timeval diag_t0;
+static bool diag_ready;
+
+/* exported interface documented in vita/diag.h */
+unsigned int vita_diag_ms(void)
+{
+	struct timeval tv;
+
+	gettimeofday(&tv, NULL);
+	return (unsigned int)((tv.tv_sec - diag_t0.tv_sec) * 1000 +
+			      (tv.tv_usec - diag_t0.tv_usec) / 1000);
+}
+
+/* exported interface documented in vita/diag.h */
+void vita_diag_log(const char *fmt, ...)
+{
+	FILE *fp;
+	va_list ap;
+	unsigned int ms;
+
+	if (!diag_ready)
+		return;
+	/* Open, write, close per line: slow, but a crash cannot lose what
+	 * was logged before it, and nothing here is on a hot path. */
+	fp = fopen(VITA_DIAG_DIR "log.txt", "a");
+	if (fp == NULL)
+		return;
+	ms = vita_diag_ms();
+	fprintf(fp, "[%6u.%03u] ", ms / 1000, ms % 1000);
+	va_start(ap, fmt);
+	vfprintf(fp, fmt, ap);
+	va_end(ap);
+	fputc('\n', fp);
+	fclose(fp);
+}
+
+/* exported interface documented in vita/diag.h */
+void vita_diag_init(void)
+{
+	gettimeofday(&diag_t0, NULL);
+	/* ux0:data exists on every Vita; our directory may not. */
+	mkdir("ux0:data", 0777);
+	mkdir(VITA_DIAG_DIR, 0777);
+	diag_ready = true;
+	vita_diag_log("==== VitaBrowser boot (build " __DATE__ " " __TIME__ ") ====");
+#ifdef __vita__
+	{
+		/* 12 = TITLE_ID: tells the default and extended-memory VPKs
+		 * apart, since they share this log. */
+		char tid[16] = "?";
+		sceAppMgrAppParamGetString(0, 12, tid, sizeof(tid));
+		vita_diag_log("title id %s", tid);
+	}
+	vita_diag_log("clocks: arm %d MHz, gpu %d MHz",
+		      scePowerGetArmClockFrequency(),
+		      scePowerGetGpuClockFrequency());
+#else
+	vita_diag_log("clocks: n/a (host simulator)");
+#endif
+}
+
+/* exported interface documented in vita/diag.h */
+void vita_diag_memory(const char *tag)
+{
+#ifdef __vita__
+	struct mallinfo mi = mallinfo();
+	SceKernelFreeMemorySizeInfo info;
+
+	memset(&info, 0, sizeof(info));
+	info.size = sizeof(info);
+	if (sceKernelGetFreeMemorySize(&info) == 0)
+		vita_diag_log("mem[%s]: free user %d KiB, cdram %d KiB, "
+			      "phycont %d KiB; heap in use %d KiB of %d KiB",
+			      tag, info.size_user / 1024,
+			      info.size_cdram / 1024, info.size_phycont / 1024,
+			      mi.uordblks / 1024, mi.arena / 1024);
+	else
+		vita_diag_log("mem[%s]: sceKernelGetFreeMemorySize failed; "
+			      "heap in use %d KiB", tag, mi.uordblks / 1024);
+#else
+	/* glibc deprecates mallinfo(); the host numbers mean nothing here. */
+	vita_diag_log("mem[%s]: n/a (host simulator)", tag);
+#endif
+}
+
+/** malloc 1 MiB chunks until failure; returns how many succeeded. */
+static int probe_heap(void)
+{
+	void *chunks[PROBE_MAX];
+	int n = 0, i;
+
+	while (n < PROBE_MAX) {
+		chunks[n] = malloc(PROBE_CHUNK);
+		if (chunks[n] == NULL)
+			break;
+		/* Write to it, so the allocation cannot stay notional. */
+		((char *)chunks[n])[0] = 1;
+		n++;
+	}
+	for (i = 0; i < n; i++)
+		free(chunks[i]);
+	return n;
+}
+
+#ifdef __vita__
+/** Allocate 1 MiB memory blocks of `type` until failure. */
+static int probe_blocks(SceKernelMemBlockType type, int *err)
+{
+	SceUID uids[PROBE_MAX];
+	int n = 0, i;
+
+	*err = 0;
+	while (n < PROBE_MAX) {
+		SceUID uid = sceKernelAllocMemBlock("vbprobe", type,
+						    PROBE_CHUNK, NULL);
+		if (uid < 0) {
+			*err = uid;
+			break;
+		}
+		uids[n++] = uid;
+	}
+	for (i = 0; i < n; i++)
+		sceKernelFreeMemBlock(uids[i]);
+	return n;
+}
+#endif
+
+/* exported interface documented in vita/diag.h */
+void vita_diag_mem_probe(void)
+{
+	int heap;
+
+	vita_diag_memory("probe-before");
+	heap = probe_heap();
+	vita_diag_log("probe: newlib heap: %d MiB more malloc-able%s", heap,
+		      heap >= PROBE_MAX ? " (hit the probe cap)" : "");
+#ifdef __vita__
+	{
+		SceAppMgrBudgetInfo budget;
+		int n, err, ret;
+
+		n = probe_blocks(SCE_KERNEL_MEMBLOCK_TYPE_USER_RW, &err);
+		vita_diag_log("probe: USER_RW blocks: %d MiB beyond the heap "
+			      "(stopped with 0x%08x)", n, (unsigned int)err);
+		n = probe_blocks(SCE_KERNEL_MEMBLOCK_TYPE_USER_CDRAM_RW, &err);
+		vita_diag_log("probe: USER_CDRAM_RW blocks: %d MiB "
+			      "(stopped with 0x%08x)", n, (unsigned int)err);
+		n = probe_blocks(SCE_KERNEL_MEMBLOCK_TYPE_USER_MAIN_PHYCONT_NC_RW,
+				 &err);
+		vita_diag_log("probe: PHYCONT_NC blocks: %d MiB "
+			      "(stopped with 0x%08x)", n, (unsigned int)err);
+
+		memset(&budget, 0, sizeof(budget));
+		budget.size = sizeof(budget);
+		ret = sceAppMgrGetBudgetInfo(&budget);
+		if (ret == 0)
+			vita_diag_log("budget: mode %d, user_rw %u/%u KiB free, "
+				      "extra %s %u/%u KiB, phycont %u/%u KiB, "
+				      "cdram %u/%u KiB", budget.app_mode,
+				      budget.free_user_rw / 1024,
+				      budget.total_user_rw_mem / 1024,
+				      budget.extra_mem_allowed ? "on" : "off",
+				      budget.free_extra_mem / 1024,
+				      budget.total_extra_mem / 1024,
+				      budget.free_phycont_mem / 1024,
+				      budget.total_phycont_mem / 1024,
+				      budget.free_cdram_mem / 1024,
+				      budget.total_cdram_mem / 1024);
+		else
+			vita_diag_log("budget: sceAppMgrGetBudgetInfo -> 0x%08x "
+				      "(expected for a normal app)",
+				      (unsigned int)ret);
+	}
+#else
+	vita_diag_log("probe: memory blocks n/a (host simulator)");
+#endif
+	vita_diag_memory("probe-after");
+}
+
+/* exported interface documented in vita/diag.h */
+void vita_diag_font_metrics(void)
+{
+	struct vita2d_pgf *font = vita_plot_font();
+	char line[512];
+	size_t len = 0;
+	int c, aa;
+
+	if (font == NULL) {
+		vita_diag_log("font: no PGF font loaded");
+		return;
+	}
+	/* The numbers layout.c works from: text height at scale 1 and 2, and
+	 * each printable ASCII advance measured the way glyph_advance() does
+	 * (width of "a"c"a" minus "aa") next to the raw single-glyph width. */
+	vita_diag_log("font: height(\"Hg\") scale1 %d, scale2 %d; "
+		      "width(\"MMMMMMMMMM\") scale1 %d",
+		      vita2d_pgf_text_height(font, 1.0f, "Hg"),
+		      vita2d_pgf_text_height(font, 2.0f, "Hg"),
+		      vita2d_pgf_text_width(font, 1.0f, "MMMMMMMMMM"));
+	aa = vita2d_pgf_text_width(font, 1.0f, "aa");
+	for (c = 0x20; c < 0x7f; c++) {
+		char s1[2] = { (char)c, 0 };
+		char s3[4] = { 'a', (char)c, 'a', 0 };
+		len += (size_t)snprintf(line + len, sizeof(line) - len,
+				"%c=%d/%d ", c == ' ' ? '_' : c,
+				vita2d_pgf_text_width(font, 1.0f, s3) - aa,
+				vita2d_pgf_text_width(font, 1.0f, s1));
+		if (len > sizeof(line) - 16 || c == 0x7e) {
+			vita_diag_log("font advance/raw: %s", line);
+			len = 0;
+		}
+	}
+}
+
+/* exported interface documented in vita/diag.h */
+bool vita_diag_trace_begin(const char *name)
+{
+	char path[256];
+
+	vita_diag_trace_end();
+	snprintf(path, sizeof(path), VITA_DIAG_DIR "%s.plot", name);
+	vita_plot_trace = fopen(path, "w");
+	if (vita_plot_trace == NULL) {
+		vita_diag_log("dump: cannot open %s", path);
+		return false;
+	}
+	fprintf(vita_plot_trace, "# vitabrowser plot dump %s @ 960x544\n", name);
+	return true;
+}
+
+/* exported interface documented in vita/diag.h */
+void vita_diag_trace_end(void)
+{
+	if (vita_plot_trace != NULL) {
+		fclose(vita_plot_trace);
+		vita_plot_trace = NULL;
+	}
+}
+
+/* exported interface documented in vita/diag.h */
+void vita_diag_marker(const char *name)
+{
+	char path[256];
+	FILE *fp;
+
+	snprintf(path, sizeof(path), VITA_DIAG_DIR "%s", name);
+	fp = fopen(path, "w");
+	if (fp != NULL)
+		fclose(fp);
+}
