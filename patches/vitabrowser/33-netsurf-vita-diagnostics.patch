+	snprintf(msg, sizeof(msg), "VitaBrowser: %s failed (%d). "
+		 "See ux0:data/VitaBrowser/log.txt. START quits.", what, err);
+	vita_diag_log("FATAL: %s failed: %d", what, err);
+	if (vita_plot_font() == NULL)
+		return;
+	for (;;) {
+		SceCtrlData pad;
+		memset(&pad, 0, sizeof(pad));
+		sceCtrlPeekBufferPositive(0, &pad, 1);
+		if (pad.buttons & SCE_CTRL_START)
+			break;
+		vita2d_start_drawing();
+		vita2d_clear_screen();
+		vita_plot_set_clip(0, 0, VITA_SCREEN_WIDTH, VITA_SCREEN_HEIGHT);
+		vita_plot_text(20, 270, msg, strlen(msg), 0x0000ff,
+			       vita_plot_pgf_scale(18.0f));
+		vita2d_end_drawing();
+		vita2d_swap_buffers();
+		sceKernelDelayThread(50 * 1000);
+	}
 }
 
