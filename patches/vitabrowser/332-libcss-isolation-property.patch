+/* VitaBrowser 332 isolation: bits[15] shift 28 (2 bits), free between
+ * hanging_punctuation and justify_items */
+#define ISOLATION_INDEX 15
+#define ISOLATION_SHIFT 28
+#define ISOLATION_MASK 0x30000000
+static inline uint8_t get_isolation(const css_computed_style *style)
+{
+	uint32_t bits = style->i.bits[ISOLATION_INDEX];
+	bits &= ISOLATION_MASK;
+	bits >>= ISOLATION_SHIFT;
+
+	return (bits & 0x3);
+}
+#undef ISOLATION_INDEX
+#undef ISOLATION_SHIFT
+#undef ISOLATION_MASK
+
 #undef OBJECT_FIT_INDEX
 #undef OBJECT_FIT_SHIFT
 #undef OBJECT_FIT_MASK
