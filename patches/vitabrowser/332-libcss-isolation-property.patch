+#include "select/properties/properties.h"
+#include "select/properties/helpers.h"
+
+/* VitaBrowser patch 332: isolation, not inherited, initial auto. */
+
+css_error css__cascade_isolation(uint32_t opv, css_style *style,
+		css_select_state *state)
+{
+	uint16_t value = CSS_ISOLATION_INHERIT;
+
+	UNUSED(style);
+
+	if (hasFlagValue(opv) == false) {
+		switch (getValue(opv)) {
+		case CSS_ISOLATION_AUTO:
+			value = CSS_ISOLATION_AUTO;
+			break;
+		case CSS_ISOLATION_ISOLATE:
+			value = CSS_ISOLATION_ISOLATE;
+			break;
+		}
+	}
+
+	if (css__outranks_existing(getOpcode(opv), isImportant(opv), state,
+			getFlagValue(opv))) {
+		return set_isolation(state->computed, value);
+	}
+
+	return CSS_OK;
+}
+
+css_error css__set_isolation_from_hint(const css_hint *hint,
+		css_computed_style *style)
+{
+	return set_isolation(style, hint->status);
+}
+
+css_error css__initial_isolation(css_select_state *state)
+{
+	return set_isolation(state->computed, CSS_ISOLATION_AUTO);
+}
+
+css_error css__copy_isolation(
+		const css_computed_style *from,
+		css_computed_style *to)
+{
+	if (from == to)
+		return CSS_OK;
+
+	return set_isolation(to, get_isolation(from));
+}
+
+css_error css__compose_isolation(const css_computed_style *parent,
+		const css_computed_style *child,
+		css_computed_style *result)
+{
+	uint8_t type = get_isolation(child);
+
+	if (type == CSS_ISOLATION_INHERIT)
+		type = get_isolation(parent);
+
+	return set_isolation(result, type);
+}
+
+uint32_t destroy_isolation(void *bytecode)
+{
+	UNUSED(bytecode);
+
+	return 0;
+}
