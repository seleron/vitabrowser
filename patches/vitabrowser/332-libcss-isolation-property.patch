+/* VitaBrowser 332 isolation: bits[15] shift 28 (2 bits) */
+#define ISOLATION_INDEX 15
+#define ISOLATION_SHIFT 28
+#define ISOLATION_MASK 0x30000000
+static inline css_error set_isolation(css_computed_style *style, uint8_t type)
+{
+	uint32_t *bits = &style->i.bits[ISOLATION_INDEX];
+
+	*bits = (*bits & ~ISOLATION_MASK) |
+			(((uint32_t)type & 0x3) << ISOLATION_SHIFT);
+
+	return CSS_OK;
+}
+#undef ISOLATION_INDEX
+#undef ISOLATION_SHIFT
+#undef ISOLATION_MASK
+
 #undef OBJECT_FIT_INDEX
