# netsurf: isolation: isolate creates a stacking context (patch 332, with 332-libcss)
# Generated 2026-10-30
# Base: seleron/vitabrowser (patch stack through 331, with 332-libcss)
#
# claude.ai's black "Download" button is `relative isolate` with a fill
# span `absolute -z-[1]`. Without the stacking context the span was
# hoisted to the root's negative z phase and painted UNDER the white card,
# leaving white text on white. The grey "Continue with Google" fill was
# lost the same way.
#
#  - redraw.c html_redraw_box_classify(): isolation: isolate classifies as
#    a zero-z stacking context (like opacity < 1), so its negative-z
#    descendants paint in its own negative phase.
#
# Gate: CSS-isolation (snapshot pixels 5px inside each fill, located from
# the text marks): the isolated button's z-index:-1 fill is black over its
# card and the isolation:auto control is white (covered by its card, and
# culled from the plot), as in Chromium. Without the patch both read
# white.
--- a/content/handlers/html/redraw.c
+++ b/content/handlers/html/redraw.c
@@ -4329,7 +4329,8 @@
  *   - position: fixed (creates SC regardless of z-index)
  *   - opacity < 1
  *   - non-identity -macsurf-transform / transform (via fixes73)
- * Not yet covered: filter, mix-blend-mode, isolation, will-change.
+ *   - isolation: isolate (VitaBrowser patch 332)
+ * Not yet covered: filter, mix-blend-mode, will-change.
  *
  * Cross-level limitation: positioned descendants of a non-SC parent
  * stay within that parent's flow rather than escaping to the nearest
@@ -4396,6 +4397,15 @@
 		return HRBSC_ZERO;
 	}
 
+	/* VitaBrowser patch 332: isolation: isolate creates a stacking
+	 * context and does nothing else. Tailwind's `isolate` is how a
+	 * button keeps its `-z-[1]` fill span (claude.ai's black "Download"
+	 * button) above the card it sits on: without the context the span
+	 * was hoisted to the root's negative phase and painted UNDER the
+	 * card, leaving white text on white. */
+	if (css_computed_isolation(c->style) == CSS_ISOLATION_ISOLATE)
+		return HRBSC_ZERO;
+
 	return HRBSC_NONE;
 }
 
