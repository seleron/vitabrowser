# netsurf: a flex item's specified width is its max-content contribution (patch 334)
# Generated 2026-10-30
# Base: seleron/vitabrowser (patch stack through 333)
#
# layout_minmax_block() lets an explicit width replace a box's intrinsic
# min/max ("fixed width takes priority"), but skips flex items. Their
# min-content must stay content-based so flex-shrink can work. The skip
# also dropped the max side. A fixed-width flex item with no content
# reported max-content 0, and a shrink-to-fit box around a flex row of
# such items (a button holding a 93px icon, a flex item holding a toolbar)
# sized to 0 or to its own padding. m.youtube's logo button laid out 24px
# wide after 333 made its wrapper a block.
#
#  - layout.c: for a flex item with a definite width, max becomes that
#    width (and border-box is honoured as in the block below). It never
#    drops below the content minimum. min is untouched.
#
# Gate: CSS-flex-item-width-contrib (FLEXCONTRIB334, 5 legs: a button
# holding a 93px icon, the button as a flex item, a flex row of one fixed
# item inside a flex item, a row of three 40px items, and fixed-width
# items with short text still shrinking). Chromium 5/5. Without this patch
# it reads 1/5 (only the shrink control).
--- a/content/handlers/html/layout.c
+++ b/content/handlers/html/layout.c
@@ -1774,6 +1774,29 @@
 		min = 0;
 	}
 
+	/* VitaBrowser patch 334: a flex item's specified width is its
+	 * max-content contribution. The block below skips flex items (their
+	 * min-content must stay content-based so flex-shrink can work), so
+	 * a fixed-width item with no content reported max 0 and every
+	 * shrink-to-fit box around a row of them (a button holding a 93px
+	 * icon, a flex item holding a toolbar) sized to 0 or to its padding.
+	 * Only max moves; it never drops below the content minimum. */
+	if (block->type != BOX_TABLE_CELL && lh__box_is_flex_item(block) &&
+			block->style != NULL) {
+		int fw;
+
+		if (css_computed_width_px(block->style, &content->unit_len_ctx,
+				-1, &fw) == CSS_WIDTH_SET && fw >= 0) {
+			if (fw >= min) {
+				max = fw;
+				using_max_border_box =
+					(bs == CSS_BOX_SIZING_BORDER_BOX);
+			} else {
+				max = min;
+			}
+		}
+	}
+
 	/* fixed width takes priority */
 	if (block->type != BOX_TABLE_CELL && !lh__box_is_flex_item(block)) {
 		bool border_box = bs == CSS_BOX_SIZING_BORDER_BOX;
