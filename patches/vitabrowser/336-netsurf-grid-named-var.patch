+/* VitaBrowser patch 336: var() in a grid-template-columns value.
+ *
+ * The track list is compiled to -macsurf-grid text here, before libcss
+ * ever sees the sheet, so `grid-template-columns: var(--layout)` counted
+ * the var() as ONE track and MDN's whole page grid collapsed to a single
+ * column. The value is expanded from the custom property's definition in
+ * the same sheet: the first `--name:` declaration that is not inside an
+ * `@media print` block (MDN redefines its layouts to one column there),
+ * recursively (4 levels), using a var() fallback when the name is not
+ * defined in this sheet. A value that still cannot be expanded keeps the
+ * old behaviour. */
+static bool
+macsurf__gtc_in_print(const char *data, size_t pos)
+{
+	size_t m = pos;
+	/* nearest preceding @media whose block is still open at pos */
+	while (m > 0) {
+		size_t a, b;
+		int depth;
+
+		m--;
+		if (data[m] != '@' || strncasecmp(data + m, "@media", 6) != 0)
+			continue;
+		a = m + 6;
+		while (a < pos && data[a] != '{' && data[a] != ';')
+			a++;
+		if (a >= pos || data[a] != '{')
+			continue;
+		depth = 0;
+		for (b = a; b < pos; b++) {
+			if (data[b] == '{') depth++;
+			else if (data[b] == '}') depth--;
+			if (depth == 0) break;
+		}
+		if (b < pos)
+			continue;	/* that block closed before pos */
+		{
+			size_t k;
+			for (k = m + 6; k + 5 <= a; k++)
+				if (strncasecmp(data + k, "print", 5) == 0)
+					return true;
+		}
+		return false;
+	}
+	return false;
+}
+
+static bool
+macsurf__gtc_find_custom(const char *data, size_t size,
+		const char *name, size_t nlen, const char **vs, const char **ve)
+{
+	size_t i;
+
+	for (i = 0; i + nlen < size; i++) {
+		size_t j, e;
+		int depth = 0;
+
+		if (data[i] != '-' || memcmp(data + i, name, nlen) != 0)
+			continue;
+		if (i > 0 && (isalnum((unsigned char)data[i - 1]) ||
+				data[i - 1] == '-' || data[i - 1] == '_' ||
+				data[i - 1] == '('))
+			continue;
+		j = i + nlen;
+		while (j < size && isspace((unsigned char)data[j]))
+			j++;
+		if (j >= size || data[j] != ':')
+			continue;
+		if (macsurf__gtc_in_print(data, i))
+			continue;
+		j++;
+		for (e = j; e < size; e++) {
+			if (data[e] == '(') depth++;
+			else if (data[e] == ')') depth--;
+			else if (depth <= 0 && (data[e] == ';' || data[e] == '}'))
+				break;
+		}
+		*vs = data + j;
+		*ve = data + e;
+		return true;
+	}
+	return false;
+}
+
+/* Expand var()s in [p, end) into buf; returns the length, or -1. */
+static int
+macsurf__gtc_expand(const char *data, size_t size, const char *p,
+		const char *end, char *buf, size_t cap, int level)
+{
+	size_t n = 0;
+
+	if (level > 4)
+		return -1;
+	while (p < end) {
+		if (end - p > 6 && strncmp(p, "var(", 4) == 0) {
+			const char *q = p + 4, *ns, *ne, *fb = NULL, *close;
+			const char *vs, *ve;
+			int depth = 1, r;
+
+			while (q < end && isspace((unsigned char)*q)) q++;
+			ns = q;
+			while (q < end && (isalnum((unsigned char)*q) ||
+					*q == '-' || *q == '_'))
+				q++;
+			ne = q;
+			for (close = q; close < end; close++) {
+				if (*close == '(') depth++;
+				else if (*close == ')') {
+					if (--depth == 0) break;
+				} else if (*close == ',' && depth == 1 &&
+						fb == NULL) {
+					fb = close + 1;
+				}
+			}
+			if (close >= end || ne - ns < 3)
+				return -1;
+			if (macsurf__gtc_find_custom(data, size, ns,
+					(size_t)(ne - ns), &vs, &ve))
+				r = macsurf__gtc_expand(data, size, vs, ve,
+						buf + n, cap - n, level + 1);
+			else if (fb != NULL)
+				r = macsurf__gtc_expand(data, size, fb, close,
+						buf + n, cap - n, level + 1);
+			else
+				return -1;
+			if (r < 0)
+				return -1;
+			n += (size_t)r;
+			p = close + 1;
+			continue;
+		}
+		if (n + 1 >= cap)
+			return -1;
+		buf[n++] = *p++;
+	}
+	return (int)n;
+}
