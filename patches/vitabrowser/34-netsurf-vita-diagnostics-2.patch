@@ -304,3 +314,63 @@ void vita_diag_marker(const char *name)
 	if (fp != NULL)
 		fclose(fp);
 }
+
+/** nslog_init's hook: buffer the file, remember it for flushing. */
+static bool engine_log_ensure(FILE *fp)
+{
+	static char buf[64 * 1024];
+
+	setvbuf(fp, buf, _IOFBF, sizeof(buf));
+	engine_log = fp;
+	return true;
+}
+
+/* exported interface documented in vita/diag.h */
+void vita_diag_engine_log_init(void)
+{
+	/* nslog_init takes its target from the command line: -V <file>. */
+	static char a0[] = "nsvita", a1[] = "-V";
+	static char a2[] = VITA_DIAG_DIR "netsurf.log";
+	char *argv[] = { a0, a1, a2, NULL };
+	int argc = 3;
+	nserror ret = nslog_init(engine_log_ensure, &argc, argv);
+
+	vita_diag_log("engine log: %s -> %d", a2, ret);
+	if (engine_log != NULL)
+		fprintf(engine_log, "==== engine log, boot at diag %u ms ====\n",
+			vita_diag_ms());
+}
+
+/* exported interface documented in vita/diag.h */
+void vita_diag_engine_flush(void)
+{
+	if (engine_log == NULL)
+		return;
+	fflush(engine_log);
+	if (verbose_log && ftell(engine_log) > ENGINE_LOG_CAP) {
+		fprintf(engine_log, "==== engine log capped at %d bytes ====\n",
+			ENGINE_LOG_CAP);
+		fflush(engine_log);
+		verbose_log = false;
+		vita_diag_log("engine log: capped at %d bytes", ENGINE_LOG_CAP);
+	}
+}
+
+/**
+ * MacSurf's engine trace hook (VITABROWSER_ENGINE_TRACE). The compat
+ * layer's definition is weak and silent; this one writes to the engine
+ * log, so the navigation / fetch traces MacSurf left in the core are
+ * visible on the device.
+ */
+void macsurf_debug_log_writef(const char *fmt, ...)
+{
+	va_list ap;
+
+	if (engine_log == NULL || !verbose_log)
+		return;
+	fputs("MS ", engine_log);
+	va_start(ap, fmt);
+	vfprintf(engine_log, fmt, ap);
+	va_end(ap);
+	fputc('\n', engine_log);
+}
