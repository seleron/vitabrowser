+/**
+ * Track whether the current page has a document yet, log its progress
+ * once a second until it does, and switch on the fetch pump if it stalls.
+ *
+ * Hardware test 1 (2026-09-22, doc 10): every page stayed "load not
+ * finished" with no document on the Vita, while the same code loads in the
+ * host simulator. MacSurf's core documents fetches getting stranded when
+ * the self-rescheduling fetcher poll goes dormant (content/fetch.c,
+ * fixes90), and its own event loop calls fetch_pump() every iteration.
+ * Upstream frontends get the same effect from fetch_fdset(). Here the pump
+ * starts only after a stall, and the log says so, so each page shows
+ * whether it needed it.
+ */
+static void watch_load(struct gui_window *gw)
+{
+	unsigned int now = vita_diag_ms();
+	unsigned int age = now - vita_stats.nav_ms;
+	int w, h;
+
+	/* The old page stays on screen until the new document replaces it,
+	 * so its arrival is the NEW_CONTENT event, not a non-zero extent. */
+	vita_window_extent(gw, &w, &h);
+	if (vita_stats.content_ms == 0 &&
+	    vita_window_new_content(gw) != vita_stats.content_gen) {
+		vita_stats.content_ms = now;
+		vita_diag_log("page %s: document after %u ms (extent %dx%d)%s",
+			      vita_test_pages[vita_page], age, w, h,
+			      vita_stats.pumping ? " -- with the fetch pump on" : "");
+	}
+	if (vita_stats.content_ms == 0 && !vita_stats.pumping &&
+	    age >= VITA_STALL_MS) {
+		vita_stats.pumping = true;
+		vita_diag_log("page %s: no document after %u ms -- fetch stalled? "
+			      "loading %d, sched pending %u (added %u, fired %u); "
+			      "pumping fetchers from now on",
+			      vita_test_pages[vita_page], age,
+			      vita_window_loading(gw), vita_schedule_pending(),
+			      vita_schedule_added, vita_schedule_fired);
+	}
+	if ((vita_stats.content_ms == 0 || vita_window_loading(gw)) &&
+	    age < VITA_STATUS_LOG_MS && now - vita_stats.status_ms >= 1000) {
+		vita_stats.status_ms = now;
+		vita_diag_log("load status %s +%u ms: loading %d, extent %dx%d, "
+			      "sched pending %u (added %u, fired %u), pump %s",
+			      vita_test_pages[vita_page], age,
+			      vita_window_loading(gw), w, h,
+			      vita_schedule_pending(), vita_schedule_added,
+			      vita_schedule_fired,
+			      vita_stats.pumping ? "on" : "off");
+	}
+}
+
 static void vita_run(struct browser_window *bw)
 {
+	unsigned int last_flush = 0;
+
 	while (!vita_quit) {
 		struct gui_window *gw = vita_window_current();
 		bool dump;
 		int step;
 
 		vita_schedule_run();
+		if (vita_diag_ms() - last_flush >= 1000) {
+			last_flush = vita_diag_ms();
+			vita_diag_engine_flush();
+		}
 		if (gw == NULL) {
 			sceKernelDelayThread(16 * 1000);
 			continue;
 		}
+		watch_load(gw);
+		if (vita_stats.pumping)
+			fetch_pump();
 
 		/* Load timing comes from the throbber events. */
 		if (vita_window_loading(gw)) {
@@ -455,7 +535,8 @@ static void vita_run(struct browser_window *bw)
 		}
 		dump = autotest_pre(gw);
 
-		if (vita_window_needs_redraw(gw) || dump) {
+		if (vita_window_needs_redraw(gw) || dump ||
+		    vita_overlay_dirty) {
 			draw_frame(gw, dump);
 			if (dump)
 				autotest_post(gw, bw);
@@ -465,6 +546,7 @@ static void vita_run(struct browser_window *bw)
 		}
 	}
 	vita_diag_log("quit requested");
+	vita_diag_engine_flush();
 }
 
