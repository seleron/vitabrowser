+/* VitaBrowser patch 340: custom-property definitions seen in other sheets.
+ *
+ * The var() expansion above only searches the sheet being rewritten, and
+ * real sites define their layout variables in one sheet and use them in
+ * another (MDN: --layout-* in styles-global.css, the page grid in a
+ * chunk sheet), so the grid still fell back to one track. Every sheet
+ * the rewrite sees registers its top-level, non-print `--name: value`
+ * definitions here (last definition wins; values over 255 bytes are
+ * skipped); a name not defined in the sheet itself is looked up here.
+ * Process-wide and order-dependent: a definition from a sheet converted
+ * later, or from a previous page, is what it is -- this only serves the
+ * text-level grid compile, where the alternative is a single column. */
+#define MACSURF_GTC_REG_MAX 384
+struct macsurf_gtc_reg {
+	char name[64];
+	char val[256];
+};
+static struct macsurf_gtc_reg macsurf__gtc_reg[MACSURF_GTC_REG_MAX];
+static int macsurf__gtc_reg_n;
+static int macsurf__gtc_reg_next;
+
+static void
+macsurf__gtc_register(const char *data, size_t size)
+{
+	size_t i;
+
+	for (i = 0; i + 3 < size; i++) {
+		size_t ns = i, ne, j, e;
+		int depth = 0, k;
+		size_t nlen, vlen;
+
+		if (data[i] != '-' || data[i + 1] != '-')
+			continue;
+		if (i > 0 && !(data[i - 1] == '{' || data[i - 1] == ';' ||
+				isspace((unsigned char)data[i - 1])))
+			continue;
+		ne = i + 2;
+		while (ne < size && (isalnum((unsigned char)data[ne]) ||
+				data[ne] == '-' || data[ne] == '_'))
+			ne++;
+		j = ne;
+		while (j < size && isspace((unsigned char)data[j]))
+			j++;
+		if (j >= size || data[j] != ':')
+			continue;
+		nlen = ne - ns;
+		for (e = j + 1; e < size; e++) {
+			if (data[e] == '(') depth++;
+			else if (data[e] == ')') depth--;
+			else if (depth <= 0 && (data[e] == ';' || data[e] == '}'))
+				break;
+		}
+		vlen = e - (j + 1);
+		i = e;
+		if (nlen >= 64 || vlen >= 256 || vlen == 0)
+			continue;
+		if (macsurf__gtc_in_print(data, ns))
+			continue;
+		for (k = 0; k < macsurf__gtc_reg_n; k++)
+			if (strlen(macsurf__gtc_reg[k].name) == nlen &&
+					memcmp(macsurf__gtc_reg[k].name,
+						data + ns, nlen) == 0)
+				break;
+		if (k == macsurf__gtc_reg_n) {
+			if (macsurf__gtc_reg_n < MACSURF_GTC_REG_MAX) {
+				k = macsurf__gtc_reg_n++;
+			} else {
+				k = macsurf__gtc_reg_next;
+				macsurf__gtc_reg_next = (macsurf__gtc_reg_next +
+						1) % MACSURF_GTC_REG_MAX;
+			}
+		}
+		memcpy(macsurf__gtc_reg[k].name, data + ns, nlen);
+		macsurf__gtc_reg[k].name[nlen] = '\0';
+		memcpy(macsurf__gtc_reg[k].val, data + j + 1, vlen);
+		macsurf__gtc_reg[k].val[vlen] = '\0';
+	}
+}
+
+static bool
+macsurf__gtc_reg_find(const char *name, size_t nlen, const char **vs,
+		const char **ve)
+{
+	int k;
+
+	for (k = 0; k < macsurf__gtc_reg_n; k++)
+		if (strlen(macsurf__gtc_reg[k].name) == nlen &&
+				memcmp(macsurf__gtc_reg[k].name, name,
+					nlen) == 0) {
+			*vs = macsurf__gtc_reg[k].val;
+			*ve = *vs + strlen(*vs);
+			return true;
+		}
+	return false;
+}
