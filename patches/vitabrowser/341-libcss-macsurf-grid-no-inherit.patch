# libcss: -macsurf-grid is never taken from the parent (patch 341)
# Generated 2026-10-30
# Base: seleron/vitabrowser (patch stack through 340)
#
# -macsurf-grid stores its type in one bit. CSS_MACSURF_GRID_INHERIT and
# CSS_MACSURF_GRID_NONE are both 0, so css__compose_macsurf_grid's "child
# is INHERIT -> use the parent" also fired for "child has no grid", which
# is the initial value every element gets. Every element without its own
# -macsurf-grid carried its parent's tracks, and a plain `display: grid`
# list inside a grid laid out on the ancestor's columns. MDN's table of
# contents spread its entries across the page columns, over the title,
# once 337/340 gave the page grid its real tracks. It had been harmless
# while that grid had one track.
#
#  - select/properties/s_macsurf_grid.c: compose copies the child's own
#    value. The enum's comment already says author-side inheritance of a
#    grid is not useful, and an explicit `inherit` is not supported.
#
# Gate: CSS-grid-nested-padding leg 1 (GRIDNEST341). Before the patch the
# list's items sat side by side on the outer tracks (0 / 240).
--- a/src/select/properties/s_macsurf_grid.c
+++ b/src/select/properties/s_macsurf_grid.c
@@ -135,12 +135,17 @@
 		const css_computed_style *child,
 		css_computed_style *result)
 {
-	int32_t integer = 0;
-	uint8_t type = get_macsurf_grid(child, &integer);
+	/* VitaBrowser patch 341: never from the parent. INHERIT and NONE
+	 * share the value 0 in this 1-bit field, so "child is INHERIT" was
+	 * also "child has no grid" (the initial value), and every element
+	 * without its own -macsurf-grid took its parent's -- a plain
+	 * `display: grid` list inside a grid laid out on the ancestor's
+	 * tracks (MDN's table of contents spread across the page columns).
+	 * Author-side inheritance of a grid template is not useful (the
+	 * enum's own comment); an explicit `inherit` is not supported. */
+	UNUSED(parent);
 
-	return css__copy_macsurf_grid(
-			type == CSS_MACSURF_GRID_INHERIT ? parent : child,
-			result);
+	return css__copy_macsurf_grid(child, result);
 }
 
 uint32_t destroy_macsurf_grid(void *bytecode)
