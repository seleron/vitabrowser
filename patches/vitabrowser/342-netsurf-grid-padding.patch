# netsurf: grid items start after the grid's padding (patch 342)
# Generated 2026-10-30
# Base: seleron/vitabrowser (patch stack through 341)
#
# layout_grid placed each item at its track offset from the grid's border
# edge and ignored the grid's own padding (the border was already in the
# offset). MDN pads its page grid with 16px (padding-inline: max(1rem,
# ...)), so the whole page sat 16px left of Chromium.
#
#  - layout_grid.c: x adds padding[LEFT], y adds padding[TOP].
#
# Gate: CSS-grid-nested-padding legs 2-4 (GRIDNEST341): padding 10px 16px
# puts the first item at (16, 10) and the second track at 116/828 wide; a
# 4px left and 3px top border plus 16px padding puts it at (20, 3). All
# are as in Chromium. Before the patch: (0, 0).
--- a/content/handlers/html/layout_grid.c
+++ b/content/handlers/html/layout_grid.c
@@ -1833,6 +1833,11 @@
 				} else {
 					x_pos = slot_col * (col_width + col_gap);
 				}
+				/* VitaBrowser patch 342: the grid's own padding
+				 * comes before the first track (the border is
+				 * already accounted for); items sat 16px left of
+				 * MDN's padded page grid. */
+				x_pos += grid->padding[LEFT];
 				child->x = x_pos;
 
 				/* #279 justify-items: position the item on the
@@ -1926,7 +1931,7 @@
 					break;
 				}
 
-				child->y = y_pos;
+				child->y = y_pos + grid->padding[TOP];	/* 342 */
 
 				slot_index++;
 				child = child->next;
