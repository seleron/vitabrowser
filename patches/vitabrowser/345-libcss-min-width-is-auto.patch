+/* VitaBrowser patch 345: whether min-width is literally auto, whatever
+ * the element's own display. css_computed_min_width() turns auto into 0
+ * unless the ELEMENT is a flex container, but the automatic minimum size
+ * belongs to flex ITEMS, and an explicit min-width (even 0) switches it
+ * off. */
+bool css_computed_min_width_is_auto(const css_computed_style *style)
+{
+	css_fixed length = 0;
+	css_unit unit = CSS_UNIT_PX;
+
+	return get_min_width(style, &length, &unit) == CSS_MIN_WIDTH_AUTO;
+}
+
