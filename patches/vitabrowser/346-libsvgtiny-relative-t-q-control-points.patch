# libsvgtiny: relative t / q control points (patch 346)
# Generated 2026-10-30
# Base: seleron/vitabrowser (patch stack through 345)
#
# Two bugs in libsvgtiny's path code, worked around at the source by
# patch 344's inline-SVG serializer rewrite:
#
#  - generate_path_bcurveto (Q/q): stored the curve's control point in
#    state->quad_x/quad_y BEFORE applying the relative offset, so after
#    a relative `q` the stored control point was the raw relative
#    operand, not the absolute point. The next smooth curve reflected
#    that, so even an absolute T after a relative q reflected wrongly
#    (`M0 24q24 -24 48 0T96 24` reached y 56 in a 48-unit box).
#  - generate_path_sbcurveto (T/t): the reflected control point is
#    prev + (prev - quad), already absolute, and the relative branch
#    then added prev to it again. Every relative `t` after a curve
#    overshoots (Material icons "q-50 0-85-35t-35-85"; `M2 12q5 -10 10 0
#    t10 0` reached (28, 34.7) where the absolute T equivalent stays
#    within (22, 18.7)).
#
# libsvgtiny is now staged: build-patched.sh copies the pristine tree to
# applytest/upstream like the other libs, and the support builds pick up
# the patched copy (the host build in build-patched.sh, the Vita cross
# build in build-vita.sh, which already reuses $UP for the engine libs).
# apply-patches.sh routes NN-libsvgtiny-* names to it.
#
#  - svgtiny_path.c generate_path_bcurveto(): the control point is
#    stored after the relative offset.
#  - svgtiny_path.c generate_path_sbcurveto(): the relative branch no
#    longer re-offsets the reflected control point; only the endpoint
#    of a relative `t` is offset.
#
# Standalone (libsvgtiny linked against the engine prefix): the wave
# `M0 24q24 -24 48 0t48 0V48H0Z` now emits the dip's reflected control
# at (72, 48) -- the hump's (24, 0) mirrored about (48, 24) -- dip
# bottom (72, 36); the buggy build emitted (120, 96) and the fill
# missed. `q24 -24 48 0T96 24` reflects the same.
#
# Gate: CSS-svg-reltq (snapshot pixels, fixed layout) -- the same wave
# as CSS-svg-smooth-quad, as a standalone SVG through <img>, the path
# that never went through 344's serializer: inside the dip (72,72) red,
# above it (72,46) the #eee background, inside the hump (24,50) red,
# >=1 PLOT PATH and none OPAQUE. With the bug (72,72) reads background.
# Chromium-verified.
diff --git a/src/svgtiny_path.c b/src/svgtiny_path.c
index e193d0c..9363e33 100644
--- a/src/svgtiny_path.c
+++ b/src/svgtiny_path.c
@@ -390,14 +390,17 @@ generate_path_bcurveto(struct internal_path_state *state, int relative)
 			return res;
 		}
 
-		state->quad_x = state->cmd.p[cmdpc + 0] /* x1 */;
-		state->quad_y = state->cmd.p[cmdpc + 1] /* y1 */;
 		if (relative != 0) {
 			state->cmd.p[cmdpc + 0] += state->prev_x; /* x1 */
 			state->cmd.p[cmdpc + 1] += state->prev_y; /* y1 */
 			state->cmd.p[cmdpc + 2] += state->prev_x; /* x */
 			state->cmd.p[cmdpc + 3] += state->prev_y; /* y */
 		}
+		/* Store the control point for the next reflected smooth curve
+		 * only after the relative offset: a `t` reflects it as an
+		 * absolute point (VitaBrowser patch 346). */
+		state->quad_x = state->cmd.p[cmdpc + 0] /* x1 */;
+		state->quad_y = state->cmd.p[cmdpc + 1] /* y1 */;
 
 		state->path.p[state->path.used++] = svgtiny_PATH_BEZIER;
 		state->path.p[state->path.used++] =
@@ -452,9 +455,9 @@ generate_path_sbcurveto(struct internal_path_state *state, int relative)
 		state->quad_x = x1;
 		state->quad_y = y1;
 
+		/* The reflected control point is already absolute; only the
+		 * endpoint of a relative `t` is offset (VitaBrowser patch 346). */
 		if (relative != 0) {
-			x1 += state->prev_x;
-			y1 += state->prev_y;
 			state->cmd.p[cmdpc + 0] += state->prev_x; /* x */
 			state->cmd.p[cmdpc + 1] += state->prev_y; /* y */
 		}
