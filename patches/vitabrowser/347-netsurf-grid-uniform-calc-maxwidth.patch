+/* VitaBrowser patch 347: the count N when a grid-template-columns value
+ * is exactly one uniform flexible repeat -- `repeat(N, <k>fr)` or
+ * `repeat(N, minmax(0[unit], <k>fr))` -- else 0. Such a list is N equal
+ * columns, which the count form `-macsurf-grid: N` carries whole. The
+ * explicit form caps at MACSURF_GRID_TRACK_MAX tracks and must fit in
+ * the declaration's own text, so BBC's `repeat(24, 1fr)` came out as 5
+ * columns, and every span in it filled the row. */
+static int
+macsurf__uniform_fr_repeat(const char *p, const char *end)
+{
+	int n = 0;
+	const char *q;
+
+	while (p < end && isspace((unsigned char)*p)) p++;
+	while (end > p && isspace((unsigned char)end[-1])) end--;
+	if (end - p < 12 || strncasecmp(p, "repeat(", 7) != 0 ||
+			end[-1] != ')')
+		return 0;
+	p += 7;
+	end--;
+	while (p < end && isspace((unsigned char)*p)) p++;
+	while (p < end && *p >= '0' && *p <= '9' && n < 1000)
+		n = n * 10 + (*p++ - '0');
+	while (p < end && isspace((unsigned char)*p)) p++;
+	if (n < 1 || p >= end || *p != ',')
+		return 0;
+	p++;
+	while (p < end && isspace((unsigned char)*p)) p++;
+	while (end > p && isspace((unsigned char)end[-1])) end--;
+	if (end - p > 7 && strncasecmp(p, "minmax(", 7) == 0 &&
+			end[-1] == ')') {
+		p += 7;
+		end--;
+		while (p < end && isspace((unsigned char)*p)) p++;
+		if (p >= end || *p != '0')
+			return 0;
+		while (p < end && *p != ',') {
+			if (*p == '(' || *p == ')')
+				return 0;
+			p++;
+		}
+		if (p >= end)
+			return 0;
+		p++;
+		while (p < end && isspace((unsigned char)*p)) p++;
+		while (end > p && isspace((unsigned char)end[-1])) end--;
+	}
+	q = p;
+	while (q < end && ((*q >= '0' && *q <= '9') || *q == '.'))
+		q++;
+	if (q == p || end - q != 2 || strncasecmp(q, "fr", 2) != 0)
+		return 0;
+	return n;
+}
