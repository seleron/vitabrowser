+					 * leaves it below them. Either way the
+					 * CSS height stands -- it was replaced
+					 * by the rows' total, so a `height:
+					 * 60px` grid shrank to its content. */
+					int n_auto = 0, rr, yy = 0, add, rem;
+
+					for (rr = 0; rr <= max_row_used &&
+					     rr < MACSURF_GRID_ROWS_MAX; rr++)
+						if (!(has_row_tracks &&
+						      rr < n_row_tracks &&
+						      row_track_h[rr] > 0))
+							n_auto++;
+					if (ac != CSS_ALIGN_CONTENT_FLEX_START &&
+							n_auto > 0) {
+						int free_v = container_height -
+							row_y;
+						add = free_v / n_auto;
+						rem = free_v - add * n_auto;
+						for (rr = 0;
+						     rr <= max_row_used &&
+						     rr < MACSURF_GRID_ROWS_MAX;
+						     rr++) {
+							int h = row_max_h[rr];
+							if (has_row_tracks &&
+							    rr < n_row_tracks &&
+							    row_track_h[rr] > 0) {
+								h = row_track_h[rr];
+							} else {
+								h += add +
+								    (rem > 0 ? 1 : 0);
+								if (rem > 0)
+									rem--;
+								row_max_h[rr] = h;
+							}
+							row_y_arr[rr] = yy;
+							yy += h + row_gap;
+						}
+					}
+					row_y = container_height;
 				}
+			} else if (max_row_used >= 0 && grid->height > 0 &&
+					grid->height < row_y) {
+				/* patch 349: a definite height smaller than
+				 * the rows still stands; they overflow. */
+				row_y = grid->height;
