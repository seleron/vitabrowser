# netsurf: stop the error-page loop when the error page itself fails
# Generated 2026-09-23
#
# browser_window__handle_error() answers any content error by navigating to
# about:query/fetcherror. If that page cannot be built either, the error
# repeats forever -- upstream behaviour, not MacSurf's. Seen on the Vita
# (hardware run 2, doc 10), where no HTML could be created at all: the error
# page failed 6111 times in five minutes, pinning the CPU and writing 13 MB
# of log. Now a failure of the error page itself stops the load (throbber
# stopped, the window keeps whatever it showed). Decided before the content
# handle is released, since that may free the URL.

diff --git a/desktop/browser_window.c b/desktop/browser_window.c
index 116d30883..4b1351e8a 100644
--- a/desktop/browser_window.c
+++ b/desktop/browser_window.c
@@ -1513,6 +1513,20 @@ browser_window__handle_error(struct browser_window *bw,
 		browser_window_remove_caret(bw, false);
 	}
 
+	/* VitaBrowser: when the page that failed is the error page itself,
+	 * showing it again fails the same way, forever. Seen on the Vita,
+	 * where no HTML could be created at all: about:query/fetcherror failed
+	 * 6111 times in five minutes. Stop the load instead. Decided before the
+	 * release below, which may free `url`. */
+	if (url != NULL &&
+	    nsurl_compare(url, corestring_nsurl_about_query_fetcherror,
+			  NSURL_COMPLETE)) {
+		NSLOG(netsurf, ERROR,
+		      "the error page failed too (%s); not retrying", message);
+		hlcache_handle_release(c);
+		return browser_window_stop_throbber(bw);
+	}
+
 	hlcache_handle_release(c);
 
 	switch (code) {
