# netsurf: element.style setters for every supported property (patch 351)
# Generated 2026-10-30
# Base: seleron/vitabrowser (patch stack through 350)
#
# element.style defined setters only for a fixed list of camelCase names,
# plus, after 348/350, the grid ones. Any other property the engine
# supports (`el.style.flexGrow = 1`, `el.style.textTransform =
# 'uppercase'`, `el.style.letterSpacing = ...`) became a plain JS property
# that never reached the style attribute.
#
#  - macsurf_qjs.c: the rest of CSS.supports' property list
#    (vita_polyfill.js), 46 names, joins 350's shared accessors on
#    CSSStyleDeclaration.prototype. They are defined once and cost nothing
#    per element, which matters after 348's heap regression. Taking the
#    names from CSS.supports keeps feature detection (`'aspectRatio' in
#    el.style`) consistent with what the engine claims.
#
# Gate: JS-style-setters (STYLESET351 6/6, Chromium 6/6); GRIDINL348,
# JS-builtin-shape, JS-cssom and JS-cssom-190 unchanged. Full fresh
# scorecard (r71-351 vs r70): mean 84.4 -> 84.7, guardian unchanged
# (80.8), rte +2.0, cnnlite +1.3, no site down beyond ddglite's usual
# flip.
--- a/content/handlers/javascript/quickjs/macsurf_qjs.c
+++ b/content/handlers/javascript/quickjs/macsurf_qjs.c
@@ -8783,7 +8783,21 @@
 		"['gridColumn','gridRow','gridArea','gridColumnStart','gridColumnEnd',"
 		"'gridRowStart','gridRowEnd','gridTemplateColumns','gridTemplateRows',"
 		"'gridTemplateAreas','gridAutoFlow','gap','rowGap','columnGap',"
-		"'order','alignSelf','justifySelf','justifyItems'].forEach(function(p){"
+		"'order','alignSelf','justifySelf','justifyItems',"
+		/* patch 351: the rest of CSS.supports' list (vita_polyfill.js) --
+		 * every property the engine understands; `el.style.flexGrow =`
+		 * and the like were plain JS properties too. Shared, so free. */
+		"'alignContent','aspectRatio','backgroundAttachment','backgroundClip',"
+		"'backgroundImage','backgroundOrigin','backgroundPosition',"
+		"'backgroundRepeat','backgroundSize','borderColor','borderStyle',"
+		"'borderWidth','clip','columnCount','counterIncrement','counterReset',"
+		"'fill','flexBasis','flexFlow','flexGrow','flexShrink','font',"
+		"'fontVariant','grid','gridTemplate','inset','letterSpacing',"
+		"'listStyleImage','listStylePosition','listStyleType','mask',"
+		"'maskImage','objectFit','outlineStyle','outlineWidth','quotes',"
+		"'stroke','textIndent','textShadow','textTransform','unicodeBidi',"
+		"'wordBreak','wordSpacing','wordWrap','overflowWrap','writingMode'"
+		"].forEach(function(p){"
 		"if(Object.getOwnPropertyDescriptor(C,p))return;"
 		"Object.defineProperty(C,p,{"
 		"get:function(){return this.getPropertyValue?this.getPropertyValue(p):'';},"
