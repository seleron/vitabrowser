#
#  - css_rewrite.c: macsurf__strip_background_layers() blanks everything
#    after the first depth-0 comma in background, background-image and the
#    per-layer longhands (repeat, position, size, attachment, origin,
#    clip). It is a same-size pass that runs before the gradient passes in
#    both the stylesheet and inline-style paths. The final layer's colour
#    is lost, but the whole declaration was dropped before.
