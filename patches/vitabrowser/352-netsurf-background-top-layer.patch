+/* VitaBrowser patch 352: multiple backgrounds degrade to the TOP layer.
+ * libcss takes one background layer and drops any comma-separated list
+ * whole, and fixes318/fixes266 pick the first GRADIENT anywhere in the
+ * value -- not the top layer. HN's vote arrow is `background:
+ * url("triangle.svg"), linear-gradient(transparent, transparent)
+ * no-repeat`: the url layer was dropped and a transparent gradient
+ * painted, so no arrow. For background, background-image and the
+ * per-layer longhands, blank everything after the first depth-0 comma
+ * (same size, spaces). The final layer's colour is lost, but the whole
+ * declaration was dropped before. NULL when nothing changed. */
+static char *
+macsurf__strip_background_layers(const char *data, size_t in_size)
+{
+	static const char *const names[] = {
+		"background", "background-image", "background-repeat",
+		"background-position", "background-size",
+		"background-attachment", "background-origin",
+		"background-clip", NULL };
+	char *out;
+	size_t i = 0;
+	int changed = 0;
+
+	if (!macsurf__has_ci(data, in_size, "background") ||
+			memchr(data, ',', in_size) == NULL)
+		return NULL;
+	out = (char *)malloc(in_size + 1);
+	if (out == NULL)
+		return NULL;
+	memcpy(out, data, in_size);
+	out[in_size] = '\0';
+	while (i < in_size) {
+		size_t j = 0, k, comma = 0;
+		int n, depth = 0;
+		bool quote = false;
+		char q = 0;
+
+		for (n = 0; names[n] != NULL; n++) {
+			size_t l = strlen(names[n]);
+			if (macsurf__match_prop_name(data, in_size, i,
+					names[n], l)) {
+				j = i + l;
+				while (j < in_size && (data[j] == ' ' ||
+						data[j] == '\t' ||
+						data[j] == '\n' ||
+						data[j] == '\r')) j++;
+				if (j < in_size && data[j] == ':')
+					break;
+			}
+		}
+		if (names[n] == NULL) {
+			i++;
+			continue;
+		}
+		/* value: to the next depth-0 `;`, `}` or `!` */
+		for (k = j + 1; k < in_size; k++) {
+			char c = data[k];
+			if (quote) {
+				if (c == q) quote = false;
+				continue;
+			}
+			if (c == '"' || c == '\'') { quote = true; q = c; }
+			else if (c == '(') depth++;
+			else if (c == ')') { if (depth > 0) depth--; }
+			else if (depth == 0 && (c == ';' || c == '}' ||
+					c == '!')) break;
+			else if (depth == 0 && c == ',' && comma == 0)
+				comma = k;
+		}
+		if (comma != 0) {
+			memset(out + comma, ' ', k - comma);
+			changed++;
+		}
+		i = k;
+	}
+	if (!changed) {
+		free(out);
+		return NULL;
+	}
+	return out;
+}
