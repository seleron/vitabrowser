# libcss takes one background layer and drops a comma-separated list whole.
# fixes318/fixes266 then pick the first GRADIENT anywhere in the value,
# not the top layer. HN's vote arrow is `background: url("triangle.svg"),
# linear-gradient(transparent, transparent) no-repeat`: the url() layer
