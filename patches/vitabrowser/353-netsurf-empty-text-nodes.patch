# netsurf: empty text nodes render nothing (patch 353)
# Generated 2026-10-30
# Base: seleron/vitabrowser (patch stack through 352)
#
# An empty text node (data "") became a BOX_TEXT and with it a full line:
# a ~15px blank line wherever one sat. Frameworks insert them as markers.
# m.youtube.com has one before and after most components, so the topbar,
# tab renderer and rich grid each gained a blank line, and the page drew
# ~75px too low (search box at y 290 vs Chromium's 214). Browsers render
# nothing for an empty text node. A lone space was already folded into the
# previous box; an empty string was not.
#
#  - box_construct.c: box_construct_text() returns early, with no box,
#    for zero-length character data under any white-space. A node created
#    empty and filled later (data / appendData / nodeValue) still renders,
#    because the DOM change rebuilds the boxes.
#
# Gate: JS-empty-text-nodes (EMPTYTXT353 7/7, Chromium 7/7). Full fresh
# scorecard (r73-353 vs r72): youtube 77.4 -> 78.3 (search box at y 199).
# hackernews, rte and cnnlite moved with live content only: same layout,
# new or reordered stories.
--- a/content/handlers/html/box_construct.c
+++ b/content/handlers/html/box_construct.c
@@ -2099,6 +2099,16 @@
 	if (err != DOM_NO_ERR || content == NULL)
 		return false;
 
+	/* VitaBrowser patch 353: an EMPTY text node renders nothing, under
+	 * any white-space. Frameworks insert them as markers (YouTube's has
+	 * one before and after most components), and each became a text box
+	 * with a full line: a 15px blank line above every component, which
+	 * pushed m.youtube.com's whole page ~75px down. */
+	if (dom_string_byte_length(content) == 0) {
+		dom_string_unref(content);
+		return true;
+	}
+
 	if (css_computed_white_space(props.parent_style) ==
 			CSS_WHITE_SPACE_NORMAL ||
 			css_computed_white_space(props.parent_style) ==
