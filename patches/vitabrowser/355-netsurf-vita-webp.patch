# netsurf: WebP images on the Vita (patch 355)
# Generated 2026-10-30
# Base: seleron/vitabrowser (patch stack through 354)
#
# NETSURF_USE_WEBP was NO in the Vita frontend's defaults, because libwebp
# was not among the vdpm packages the build used. bbc.com serves its story
# images only as .jpg.webp (src and every srcset entry), so the lead
# images drew as alt text on every run.
#
#  - frontends/vita/Makefile.defaults: NETSURF_USE_WEBP := YES. The
#    device build links vdpm's libwebp (`vdpm install libwebp`;
#    tools/build-vita.sh now lists it and fails early without it). The
#    host simulator links the system libwebp.
#
# Changing the option needs a clean netsurf build: image.c registers the
# handler under the define, and an incremental build keeps the old object.
# Move build/Linux-vita(-sim) aside first.
#
# Device build (build-vita-355.log, exit 0): nsvita.elf links libwebp (147
# WebP/VP8 symbols). The VPK is 16.95 MB, against 16.71 MB at run 40 with
# every patch since included. Gate: CSS-img-webp (file:// snapshot: a
# 40x40 WebP, red / blue halves, pixels exact as Chromium). Full fresh
# scorecard (r75-355 vs r74): bbc 82.2 -> 91.0 (visual 0.556 -> 0.775),
# mean 84.3 -> 84.7. Other moves are live content.
--- a/frontends/vita/Makefile.defaults
+++ b/frontends/vita/Makefile.defaults
@@ -16,13 +16,16 @@
 NETSURF_USE_QUICKJS := YES
 
 # Image decoders that exist for the Vita: libnsgif / libnsbmp are built by
-# tools/build-vita.sh, libpng / libjpeg-turbo come from vdpm.
+# tools/build-vita.sh, libpng / libjpeg-turbo / libwebp come from vdpm.
+# VitaBrowser patch 355: WebP on. bbc.com serves its story images only as
+# .jpg.webp (src and srcset); without a decoder the lead images showed
+# alt text. The host simulator links the system libwebp.
 NETSURF_USE_BMP := YES
 NETSURF_USE_GIF := YES
 NETSURF_USE_PNG := YES
 NETSURF_USE_JPEG := YES
 NETSURF_USE_JPEGXL := NO
-NETSURF_USE_WEBP := NO
+NETSURF_USE_WEBP := YES
 NETSURF_USE_NSSVG := YES
 NETSURF_USE_ROSPRITE := NO
 NETSURF_USE_RSVG := NO
