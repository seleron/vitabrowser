+/* VitaBrowser patch 358: SVG stroke (as s_fill.c). Inherited; initial
+ * value is none. */
+#include "bytecode/bytecode.h"
+#include "bytecode/opcodes.h"
+#include "select/propset.h"
+#include "select/propget.h"
+#include "utils/utils.h"
+
+#include "select/properties/properties.h"
+#include "select/properties/helpers.h"
+
+css_error css__cascade_stroke(uint32_t opv, css_style *style,
+		css_select_state *state)
+{
+	int32_t status = CSS_STROKE_INHERIT;
+	css_color color = 0;
+
+	if (hasFlagValue(opv) == false) {
+		switch (getValue(opv)) {
+		case STROKE_NONE: status = CSS_STROKE_NONE; break;
+		case STROKE_CURRENT_COLOR: status = CSS_STROKE_CURRENT_COLOR; break;
+		case STROKE_SET:
+			status = CSS_STROKE_COLOR;
+			color = *((css_color *)style->bytecode);
+			advance_bytecode(style, sizeof(color));
+			break;
+		}
+	}
+
+	if (css__outranks_existing(getOpcode(opv), isImportant(opv), state,
+			getFlagValue(opv))) {
+		state->computed->i.stroke_status = status;
+		state->computed->i.stroke_color = color;
+	}
+	return CSS_OK;
+}
+
+css_error css__set_stroke_from_hint(const css_hint *hint,
+		css_computed_style *style)
+{
+	style->i.stroke_status = hint->status;
+	style->i.stroke_color = hint->data.color;
+	return CSS_OK;
+}
+
+css_error css__initial_stroke(css_select_state *state)
+{
+	state->computed->i.stroke_status = CSS_STROKE_NONE;
+	state->computed->i.stroke_color = 0;
+	return CSS_OK;
+}
+
+css_error css__copy_stroke(const css_computed_style *from,
+		css_computed_style *to)
+{
+	if (from != to) {
+		to->i.stroke_status = from->i.stroke_status;
+		to->i.stroke_color = from->i.stroke_color;
+	}
+	return CSS_OK;
+}
+
+css_error css__compose_stroke(const css_computed_style *parent,
+		const css_computed_style *child, css_computed_style *result)
+{
+	int32_t status = child->i.stroke_status;
+	css_color color = child->i.stroke_color;
+	if (status == CSS_STROKE_INHERIT) {
+		status = parent->i.stroke_status;
+		color = parent->i.stroke_color;
+	}
+	result->i.stroke_status = status;
+	result->i.stroke_color = color;
+	return CSS_OK;
+}
+
+uint32_t destroy_stroke(void *bytecode)
+{
+	(void)bytecode;
+	return 0;
+}
