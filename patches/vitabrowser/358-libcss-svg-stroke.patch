+/* VitaBrowser 358 */
+uint8_t css_computed_stroke(const css_computed_style *style, css_color *color)
+{
+	int32_t s = style->i.stroke_status;
+	css_color c = style->i.stroke_color;
+	if (s < CSS_STROKE_NONE || s > CSS_STROKE_COLOR) {
+		if (color != NULL) *color = 0;
+		return CSS_STROKE_NONE;
+	}
+	if (color != NULL) {
+		*color = (s == CSS_STROKE_COLOR) ? c : 0;
+	}
+	return (uint8_t)s;
+}
+
+uint8_t css_computed_stroke_width(const css_computed_style *style,
+		css_fixed *length, css_unit *unit)
+{
+	if (style->i.stroke_width_status != CSS_STROKE_WIDTH_SET) {
+		*length = INTTOFIX(1);
+		*unit = CSS_UNIT_PX;
+		return CSS_STROKE_WIDTH_SET;
+	}
+	*length = style->i.stroke_width;
+	*unit = (css_unit)style->i.stroke_width_unit;
+	return CSS_STROKE_WIDTH_SET;
+}
+
