+/* VitaBrowser patch 358: SVG stroke-width. Inherited; initial value is
+ * 1px. The length keeps its unit; relative units resolve against the
+ * element's own style when the stroke is drawn. */
+#include "bytecode/bytecode.h"
+#include "bytecode/opcodes.h"
+#include "select/propset.h"
+#include "select/propget.h"
+#include "select/helpers.h"
+#include "utils/utils.h"
+
+#include "select/properties/properties.h"
+#include "select/properties/helpers.h"
+
+css_error css__cascade_stroke_width(uint32_t opv, css_style *style,
+		css_select_state *state)
+{
+	int32_t status = CSS_STROKE_WIDTH_INHERIT;
+	css_fixed length = 0;
+	uint32_t unit = UNIT_PX;
+
+	if (hasFlagValue(opv) == false && getValue(opv) == STROKE_WIDTH_SET) {
+		status = CSS_STROKE_WIDTH_SET;
+		length = *((css_fixed *) style->bytecode);
+		advance_bytecode(style, sizeof(length));
+		unit = *((uint32_t *) style->bytecode);
+		advance_bytecode(style, sizeof(unit));
+	}
+
+	if (css__outranks_existing(getOpcode(opv), isImportant(opv), state,
+			getFlagValue(opv))) {
+		state->computed->i.stroke_width_status = status;
+		state->computed->i.stroke_width = length;
+		state->computed->i.stroke_width_unit =
+				(int32_t)css__to_css_unit(unit);
+	}
+	return CSS_OK;
+}
+
+css_error css__set_stroke_width_from_hint(const css_hint *hint,
+		css_computed_style *style)
+{
+	style->i.stroke_width_status = hint->status;
+	style->i.stroke_width = hint->data.length.value;
+	style->i.stroke_width_unit = (int32_t)hint->data.length.unit;
+	return CSS_OK;
+}
+
+css_error css__initial_stroke_width(css_select_state *state)
+{
+	state->computed->i.stroke_width_status = CSS_STROKE_WIDTH_SET;
+	state->computed->i.stroke_width = INTTOFIX(1);
+	state->computed->i.stroke_width_unit = CSS_UNIT_PX;
+	return CSS_OK;
+}
+
+css_error css__copy_stroke_width(const css_computed_style *from,
+		css_computed_style *to)
+{
+	if (from != to) {
+		to->i.stroke_width_status = from->i.stroke_width_status;
+		to->i.stroke_width = from->i.stroke_width;
+		to->i.stroke_width_unit = from->i.stroke_width_unit;
+	}
+	return CSS_OK;
+}
+
+css_error css__compose_stroke_width(const css_computed_style *parent,
+		const css_computed_style *child, css_computed_style *result)
+{
+	const css_computed_style *src =
+			child->i.stroke_width_status == CSS_STROKE_WIDTH_INHERIT ?
+			parent : child;
+
+	result->i.stroke_width_status = src->i.stroke_width_status;
+	result->i.stroke_width = src->i.stroke_width;
+	result->i.stroke_width_unit = src->i.stroke_width_unit;
+	return CSS_OK;
+}
+
+uint32_t destroy_stroke_width(void *bytecode)
+{
+	(void)bytecode;
+	return 0;
+}
