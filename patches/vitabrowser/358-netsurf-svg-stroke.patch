+/* VitaBrowser patch 358: the stroke and stroke-width presentation
+ * attributes, as fill above, so author CSS outranks them in the cascade
+ * (stroke: none on a class beats stroke="#00f"). */
+static dom_string *css_hint_svg_attr(dom_node *node, const char *attr)
+{
+	dom_string *name = NULL, *value = NULL;
+
+	if (dom_string_create((const uint8_t *)attr, strlen(attr), &name) !=
+			DOM_NO_ERR)
+		return NULL;
+	if (dom_element_get_attribute(node, name, &value) != DOM_NO_ERR)
+		value = NULL;
+	dom_string_unref(name);
+	return value;
+}
+
+static void css_hint_svg_stroke(dom_node *node)
+{
+	struct css_hint *hint = &hint_ctx.hints[hint_ctx.len];
+	dom_string *value = css_hint_svg_attr(node, "stroke");
+	const char *text;
+
+	if (value == NULL)
+		return;
+	text = (const char *)dom_string_data(value);
+	if (strcasecmp(text, "none") == 0) {
+		hint->prop = CSS_PROP_STROKE;
+		hint->status = CSS_STROKE_NONE;
+		css_hint_advance(&hint);
+	} else if (strcasecmp(text, "currentColor") == 0) {
+		hint->prop = CSS_PROP_STROKE;
+		hint->status = CSS_STROKE_CURRENT_COLOR;
+		css_hint_advance(&hint);
+	} else if (nscss_parse_colour(text, &hint->data.color)) {
+		hint->prop = CSS_PROP_STROKE;
+		hint->status = CSS_STROKE_COLOR;
+		css_hint_advance(&hint);
+	}
+	dom_string_unref(value);
+}
+
+static void css_hint_svg_stroke_width(dom_node *node)
+{
+	struct css_hint *hint = &hint_ctx.hints[hint_ctx.len];
+	dom_string *value = css_hint_svg_attr(node, "stroke-width");
+	css_fixed length;
+	css_unit unit;
+
+	if (value == NULL)
+		return;
+	/* a bare number is user units: parse_dimension gives it px */
+	if (parse_dimension((const char *)dom_string_data(value), false,
+			&length, &unit) && unit != CSS_UNIT_PCT && length >= 0) {
+		hint->prop = CSS_PROP_STROKE_WIDTH;
+		hint->status = CSS_STROKE_WIDTH_SET;
+		hint->data.length.value = length;
+		hint->data.length.unit = unit;
+		css_hint_advance(&hint);
+	}
+	dom_string_unref(value);
+}
+
