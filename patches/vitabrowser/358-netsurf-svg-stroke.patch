+/* patch 358: an SVG paint value for a computed CSS stroke; false for none
+ * or an unusable status (an absent stroke attribute already means none) */
+static bool css_stroke_str(const css_computed_style *s, char out[8],
+		bool *none)
+{
+	css_color sc = 0, col = 0xff000000;
+	uint8_t st = css_computed_stroke(s, &sc);
+
+	*none = false;
+	if (st == CSS_STROKE_CURRENT_COLOR) {
+		css_computed_color(s, &col);
+		sc = col;
+	} else if (st == CSS_STROKE_NONE || (sc >> 24) == 0) {
+		*none = true;
+		strcpy(out, "none");
+		return true;
+	} else if (st != CSS_STROKE_COLOR) {
+		return false;
+	}
+	snprintf(out, 8, "#%02x%02x%02x", (unsigned int)((sc >> 16) & 0xff),
+		 (unsigned int)((sc >> 8) & 0xff), (unsigned int)(sc & 0xff));
+	return true;
+}
+
+/* patch 358: stroke-width in user units -- a CSS px inside an SVG is a
+ * user unit, scaled by the viewBox like any other coordinate */
+static float css_stroke_width_uu(const struct ser *z,
+		const css_computed_style *s)
+{
+	css_fixed len = INTTOFIX(1);
+	css_unit unit = CSS_UNIT_PX;
+
+	css_computed_stroke_width(s, &len, &unit);
+	if (unit != CSS_UNIT_PX && z->html != NULL)
+		len = css_unit_len2device_px(s, &z->html->unit_len_ctx, len,
+				unit);
+	return FIXTOFLT(len);
+}
