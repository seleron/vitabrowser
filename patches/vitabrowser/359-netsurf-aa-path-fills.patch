+/* VitaBrowser patch 359: receives one row's coverage: cov[i] is the
+ * share of pixel (x0 + i, y) inside the shape, 0 (none) .. 255 (all).
+ * x0 < x1; cov[0] and cov[x1 - x0 - 1] are non-zero. */
+typedef void (*polyfill_cov_fn)(void *ctx, int y, int x0, int x1,
+                                const unsigned char *cov);
+
+/*
+ * The antialiased form of polyfill(): same shape, rule and clip, but
+ * each row reports how much of every pixel the shape covers rather
+ * than which pixel centres it holds. Coverage is sampled on
+ * POLYFILL_AA_SS sub-scanlines per row, each crossing exactly in x
+ * (the canvas rasteriser's method, quickjs/macsurf_canvas.c raster()).
+ * Rows are reported top to bottom, each once at most, trimmed to its
+ * covered pixels.
+ *
+ * Returns 0 on success, -1 if memory ran out (nothing more is
+ * reported after that).
+ */
+#define POLYFILL_AA_SS 4
+
+int polyfill_aa(const float *xy, const int *counts, int nsub,
+                enum polyfill_rule rule,
+                int cx0, int cy0, int cx1, int cy1,
+                polyfill_cov_fn fn, void *ctx);
+
 #endif /* POLYFILL_H */
