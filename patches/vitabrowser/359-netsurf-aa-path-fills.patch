+/* VitaBrowser patch 359: path fills are antialiased. polyfill_aa()
+ * reports each pixel's coverage; fully covered runs go through the span
+ * merger above as before, and the edge pixels -- partial coverage, the
+ * fill colour at that share of its alpha -- are batched into ONE
+ * triangle-list draw per path. Thin shapes (a 1.5px icon ring) no longer
+ * break into pixel crumbs where the old centre-sampling missed them.
+ *
+ * The vertices come from vita2d's per-frame pool (VITA_FRAME_POOL, 4 MB),
+ * which text and every rectangle share. A path whose edge pixels would
+ * leave less than PATH_AA_RESERVE of it, or that has more than
+ * PATH_AA_MAX_QUADS of them, draws its edge pixels the old way instead:
+ * solid where at least half covered. */
+
+#define PATH_AA_MAX_QUADS 4096
+#define PATH_AA_RESERVE (1024 * 1024)
+
+struct path_aa {
+	struct span_merge *m;
+	int *q;			/* x, y, w, coverage per edge run */
+	unsigned int nq, capq;
+	bool overflow;		/* too many: draw the old way */
+	bool any;		/* a row was reported */
+};
+
+static void path_aa_cov(void *ctx, int y, int x0, int x1,
+			const unsigned char *cov)
+{
+	struct path_aa *aa = ctx;
+	int i = 0, w = x1 - x0;
+
+	aa->any = true;
+	while (i < w) {
+		int j = i + 1;
+		unsigned char c = cov[i];
+
+		while (j < w && cov[j] == c)
+			j++;
+		if (c == 255) {
+			span_cb(aa->m, y, x0 + i, x0 + j);
+		} else if (c != 0) {
+			if (aa->nq == aa->capq && !aa->overflow) {
+				unsigned int cq = aa->capq ? aa->capq * 2 : 64;
+				int *nq = NULL;
+				if (cq <= PATH_AA_MAX_QUADS)
+					nq = realloc(aa->q, cq * 4 * sizeof(int));
+				if (nq == NULL) {
+					aa->overflow = true;
+				} else {
+					aa->q = nq;
+					aa->capq = cq;
+				}
+			}
+			if (aa->overflow) {
+				if (c >= 128)
+					span_cb(aa->m, y, x0 + i, x0 + j);
+			} else {
+				int *r = aa->q + aa->nq * 4;
+				r[0] = x0 + i; r[1] = y; r[2] = j - i; r[3] = c;
+				aa->nq++;
+			}
+		}
+		i = j;
+	}
+}
+
+/** Draw the batched edge runs of one path: one triangle list. */
+static void path_aa_flush(struct path_aa *aa, colour c, int bucket)
+{
+	unsigned int amax = vita_bucket_alpha[bucket], i, n = 0;
+	size_t need = (size_t)aa->nq * 6 * sizeof(vita2d_color_vertex);
+	vita2d_color_vertex *v = NULL;
+	int bx0 = INT_MAX, by0 = INT_MAX, bx1 = INT_MIN, by1 = INT_MIN;
+
+	if (aa->nq == 0)
+		return;
+	if (vita2d_pool_free_space() >= need + PATH_AA_RESERVE)
+		v = vita2d_pool_memalign((unsigned int)need,
+					 sizeof(vita2d_color_vertex));
+	if (v == NULL) {
+		/* The pool is short: the old centre-sampled look. */
+		for (i = 0; i < aa->nq; i++) {
+			const int *r = aa->q + i * 4;
+			if (r[3] >= 128)
+				vita_plot_fill_rect(r[0], r[1], r[0] + r[2],
+						    r[1] + 1, c, bucket);
+		}
+		return;
+	}
+	for (i = 0; i < aa->nq; i++) {
+		const int *r = aa->q + i * 4;
+		unsigned int a = ((unsigned int)r[3] * amax + 127) / 255;
+		unsigned int rgba = (c & 0xffffff) | (a << 24);
+		float x0 = (float)r[0], y0 = (float)r[1];
+		float x1 = x0 + (float)r[2], y1 = y0 + 1.0f;
+		vita2d_color_vertex *t = v + n * 6;
+
+		if (a == 0)
+			continue;
+		t[0].x = x0; t[0].y = y0;
+		t[1].x = x1; t[1].y = y0;
+		t[2].x = x0; t[2].y = y1;
+		t[3].x = x1; t[3].y = y0;
+		t[4].x = x1; t[4].y = y1;
+		t[5].x = x0; t[5].y = y1;
+		for (int k = 0; k < 6; k++) {
+			t[k].z = 0.5f;
+			t[k].color = rgba;
+		}
+		if (r[0] < bx0) bx0 = r[0];
+		if (r[1] < by0) by0 = r[1];
+		if (r[0] + r[2] > bx1) bx1 = r[0] + r[2];
+		if (r[1] + 1 > by1) by1 = r[1] + 1;
+		n++;
+	}
+	/* polyfill_aa reported inside the clip only: no stencil is needed,
+	 * clip_prepare just turns off a live one for another rectangle. */
+	if (n == 0 || !clip_prepare(bx0, by0, bx1, by1))
+		return;
+	vita_plot_calls++;
+	vita2d_draw_array(SCE_GXM_PRIMITIVE_TRIANGLES, v, n * 6);
+}
