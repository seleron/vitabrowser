+/* ---- VitaBrowser patch 359: antialiased coverage --------------------- */
+
+typedef struct {
+    float x0, y0, y1, dxdy;   /* top point, bottom y, slope */
+    int   dir;                /* +1 downward edge, -1 upward */
+} AaEdge;
+
+typedef struct {
+    float x;
+    int   dir;
+} AaCross;
+
+static int cmp_aa_edge(const void *a, const void *b)
+{
+    const AaEdge *ea = (const AaEdge *)a;
+    const AaEdge *eb = (const AaEdge *)b;
+    if (ea->y0 < eb->y0) return -1;
+    if (ea->y0 > eb->y0) return 1;
+    return 0;
+}
+
+/* Add weight w to every pixel of [xa, xb), partial pixels pro rata. */
+static void aa_span(float *acc, int width, float xa, float xb, float w)
+{
+    if (xa < 0) xa = 0;
+    if (xb > (float)width) xb = (float)width;
+    if (!(xb > xa))             /* NaN too */
+        return;
+    int ia = (int)xa, ib = (int)xb;
+    if (ia == ib) {
+        acc[ia] += (xb - xa) * w;
+        return;
+    }
+    acc[ia] += ((float)(ia + 1) - xa) * w;
+    for (int i = ia + 1; i < ib; i++)
+        acc[i] += w;
+    if (ib < width)
+        acc[ib] += (xb - (float)ib) * w;
+}
+
+static float aa_clamp(float v)
+{
+    if (v < -1e6f) return -1e6f;    /* keep the int conversions defined */
+    if (v > 1e6f) return 1e6f;
+    return v;
+}
+
+int polyfill_aa(const float *xy, const int *counts, int nsub,
+                enum polyfill_rule rule,
+                int cx0, int cy0, int cx1, int cy1,
+                polyfill_cov_fn fn, void *ctx)
+{
+    if (nsub <= 0 || cx0 >= cx1 || cy0 >= cy1)
+        return 0;
+
+    long total = 0;
+    for (int i = 0; i < nsub; i++) {
+        if (counts[i] < 0) return 0;
+        total += counts[i];
+    }
+    if (total > MAX_POINTS)
+        return -1;
+
+    size_t cap = (size_t)(total > 0 ? total : 1);
+    AaEdge  *e = malloc(cap * sizeof(AaEdge));
+    AaCross *cr = malloc((cap + 1) * sizeof(AaCross));
+    int     *act = malloc((cap + 1) * sizeof(int));
+    float   *acc = NULL;
+    unsigned char *cov = NULL;
+    int rc = -1;
+    if (!e || !cr || !act)
+        goto out;
+
+    int ne = 0;
+    float minx = 1e30f, maxx = -1e30f, miny = 1e30f, maxy = -1e30f;
+    const float *p = xy;
+    for (int i = 0; i < nsub; i++) {
+        int n = counts[i];
+        if (n < 3) { p += n * 2; continue; }
+        int ok = 1;
+        for (int k = 0; k < n; k++) {
+            if (!is_finite(p[k*2]) || !is_finite(p[k*2+1])) { ok = 0; break; }
+        }
+        if (!ok) { p += n * 2; continue; }
+        for (int k = 0; k < n; k++) {
+            float xa = aa_clamp(p[k*2]), ya = aa_clamp(p[k*2+1]);
+            float xb = aa_clamp(p[((k+1)%n)*2]);
+            float yb = aa_clamp(p[((k+1)%n)*2+1]);
+            /* Every point widens the box, a horizontal edge's too: a
+             * corner reached only by one would be cut off. */
+            if (xa < minx) minx = xa;
+            if (xa > maxx) maxx = xa;
+            if (ya < miny) miny = ya;
+            if (ya > maxy) maxy = ya;
+            if (ya == yb) continue;
+            AaEdge *ed = &e[ne++];
+            if (ya < yb) {
+                ed->x0 = xa; ed->y0 = ya; ed->y1 = yb; ed->dir = 1;
+            } else {
+                ed->x0 = xb; ed->y0 = yb; ed->y1 = ya; ed->dir = -1;
+            }
+            ed->dxdy = (xb - xa) / (yb - ya);
+        }
+        p += n * 2;
+    }
+    rc = 0;
+    if (ne == 0)
+        goto out;
+
+    int bx0 = (int)floorf(minx), bx1 = (int)ceilf(maxx);
+    int by0 = (int)floorf(miny), by1 = (int)ceilf(maxy);
+    if (bx0 < cx0) bx0 = cx0;
+    if (bx1 > cx1) bx1 = cx1;
+    if (by0 < cy0) by0 = cy0;
+    if (by1 > cy1) by1 = cy1;
+    if (bx1 <= bx0 || by1 <= by0)
+        goto out;
+
+    int width = bx1 - bx0;
+    acc = malloc(sizeof(float) * (size_t)(width + 2));
+    cov = malloc((size_t)width + 1);
+    if (!acc || !cov) {
+        rc = -1;
+        goto out;
+    }
+    qsort(e, (size_t)ne, sizeof(AaEdge), cmp_aa_edge);
+
+    /* Edges entirely above the first row never become active. */
+    int next = 0, nact = 0;
+    for (int y = by0; y < by1; y++) {
+        int lo = width, hi = -1;
+        memset(acc, 0, sizeof(float) * (size_t)(width + 2));
+        for (int s = 0; s < POLYFILL_AA_SS; s++) {
+            float sy = (float)y + ((float)s + 0.5f) / POLYFILL_AA_SS;
+            int nc = 0, k = 0;
+            while (next < ne && e[next].y0 <= sy)
+                act[nact++] = next++;
+            for (int j = 0; j < nact; j++)
+                if (e[act[j]].y1 > sy)
+                    act[k++] = act[j];
+            nact = k;
+            for (int j = 0; j < nact; j++) {
+                const AaEdge *ed = &e[act[j]];
+                AaCross c;
+                c.x = ed->x0 + (sy - ed->y0) * ed->dxdy - (float)bx0;
+                c.dir = ed->dir;
+                int m;
+                for (m = nc; m > 0 && cr[m - 1].x > c.x; m--)
+                    cr[m] = cr[m - 1];
+                cr[m] = c;
+                nc++;
+            }
+            int wind = 0;
+            float start = 0;
+            for (int j = 0; j < nc; j++) {
+                int before = wind;
+                wind += cr[j].dir;
+                int in0 = (rule == POLYFILL_NONZERO) ? (before != 0)
+                                                     : (before & 1);
+                int in1 = (rule == POLYFILL_NONZERO) ? (wind != 0)
+                                                     : (wind & 1);
+                if (!in0 && in1)
+                    start = cr[j].x;
+                else if (in0 && !in1)
+                    aa_span(acc, width, start, cr[j].x,
+                            1.0f / POLYFILL_AA_SS);
+            }
+        }
+        for (int i = 0; i < width; i++) {
+            float a = acc[i];
+            int c = a >= 1.0f ? 255 : (a <= 0.0f ? 0 :
+                                       (int)(a * 255.0f + 0.5f));
+            cov[i] = (unsigned char)c;
+            if (c != 0) {
+                if (i < lo) lo = i;
+                hi = i;
+            }
+        }
+        if (hi >= lo)
+            fn(ctx, y, bx0 + lo, bx0 + hi + 1, cov + lo);
+    }
+
+out:
+    free(e);
+    free(cr);
+    free(act);
+    free(acc);
+    free(cov);
+    return rc;
+}
