+	/* Hardware run 2 left log.txt untouched while netsurf.log was
+	 * written fine (doc 10). One handle, line-buffered, every write
+	 * checked, and each line mirrored into the engine log -- so a failing
+	 * log.txt shows up with its errno instead of silently. */
+	if (diag_fp != NULL) {
+		if (fprintf(diag_fp, "%s\n", line) < 0 || fflush(diag_fp) != 0) {
+			if (diag_write_errno == 0) {
+				diag_write_errno = errno ? errno : -1;
+				if (engine_log != NULL)
+					fprintf(engine_log, "DIAG log.txt write "
+						"failed: errno %d\n",
+						diag_write_errno);
+			}
+			clearerr(diag_fp);
+		}
+	}
+	if (engine_log != NULL)
+		fprintf(engine_log, "DIAG %s\n", line);
 }
 
