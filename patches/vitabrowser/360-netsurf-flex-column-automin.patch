+				/* VitaBrowser patch 360: OWN properties only. o
+				 * inherits CSSStyleDeclaration.prototype (patch 280),
+				 * whose patch-351 accessors call
+				 * this.getPropertyValue -- this function -- so any
+				 * property __gcsNative did not answer (flexGrow...)
+				 * recursed until the stack overflowed. */
+				"if(Object.prototype.hasOwnProperty.call(o,k)&&"
+					"o[k]!==undefined&&typeof o[k]!=='function')"
+					"return ''+o[k];"
 				"if(inl&&inl.getPropertyValue)return inl.getPropertyValue(p);"
 				"return '';};"
 			"o.setProperty=function(p,v){if(inl&&inl.setProperty)"
