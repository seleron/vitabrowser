 			try { Object.setPrototypeOf(base, g.CSSStyleDeclaration.prototype); } catch (e) { /* */ }
 		function read(k) {
-			var v = base[k];
+			/* patch 360: own properties only -- an inherited one is a
+			 * patch-351 CSSStyleDeclaration accessor, which calls
+			 * getPropertyValue, which reads here: a property the native
+			 * side did not answer recursed to a stack overflow */
+			var v = Object.prototype.hasOwnProperty.call(base, k) ? base[k] : undefined;
 			if (v !== undefined && v !== null && typeof v !== 'function') return String(v);
