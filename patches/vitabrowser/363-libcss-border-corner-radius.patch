+ * Not inherited; initial 0. Stored beside 358's stroke fields: status,
+ * horizontal and vertical length + unit per corner. */
+
+#include "bytecode/bytecode.h"
+#include "bytecode/opcodes.h"
+#include "select/propset.h"
+#include "select/propget.h"
