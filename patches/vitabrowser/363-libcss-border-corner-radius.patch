+static css_error cascade_corner(int k, uint32_t opv, css_style *style,
+		css_select_state *state)
+{
+	int32_t status = CSS_BORDER_CORNER_RADIUS_INHERIT;
+	css_fixed h = 0, v = 0;
+	uint32_t hu = UNIT_PX, vu = UNIT_PX;
+
+	if (hasFlagValue(opv) == false &&
+			getValue(opv) == BORDER_CORNER_RADIUS_SET) {
+		status = CSS_BORDER_CORNER_RADIUS_SET;
+		h = *((css_fixed *) style->bytecode);
+		advance_bytecode(style, sizeof(h));
+		hu = *((uint32_t *) style->bytecode);
+		advance_bytecode(style, sizeof(hu));
+		v = *((css_fixed *) style->bytecode);
+		advance_bytecode(style, sizeof(v));
+		vu = *((uint32_t *) style->bytecode);
+		advance_bytecode(style, sizeof(vu));
+	}
+
+	if (css__outranks_existing(getOpcode(opv), isImportant(opv), state,
+			getFlagValue(opv))) {
+		state->computed->i.corner_radius_status[k] = status;
+		state->computed->i.corner_radius_h[k] = h;
+		state->computed->i.corner_radius_hu[k] =
+				(int32_t)css__to_css_unit(hu);
+		state->computed->i.corner_radius_v[k] = v;
+		state->computed->i.corner_radius_vu[k] =
+				(int32_t)css__to_css_unit(vu);
+	}
+	return CSS_OK;
+}
+
+static void set_corner(css_computed_style *s, int k, int32_t status,
+		css_fixed h, int32_t hu, css_fixed v, int32_t vu)
+{
+	s->i.corner_radius_status[k] = status;
+	s->i.corner_radius_h[k] = h;
+	s->i.corner_radius_hu[k] = hu;
+	s->i.corner_radius_v[k] = v;
+	s->i.corner_radius_vu[k] = vu;
+}
+
+static void copy_corner(int k, const css_computed_style *from,
+		css_computed_style *to)
+{
+	set_corner(to, k, from->i.corner_radius_status[k],
+			from->i.corner_radius_h[k], from->i.corner_radius_hu[k],
+			from->i.corner_radius_v[k], from->i.corner_radius_vu[k]);
+}
+
+css_error css__cascade_border_top_left_radius(uint32_t opv, css_style *style,
+		css_select_state *state)
+{
+	return cascade_corner(0, opv, style, state);
+}
+
+css_error css__set_border_top_left_radius_from_hint(const css_hint *hint,
+		css_computed_style *style)
+{
+	set_corner(style, 0, hint->status, hint->data.length.value,
+			(int32_t)hint->data.length.unit,
+			hint->data.length.value,
+			(int32_t)hint->data.length.unit);
+	return CSS_OK;
+}
+
+css_error css__initial_border_top_left_radius(css_select_state *state)
+{
+	set_corner(state->computed, 0, CSS_BORDER_CORNER_RADIUS_SET,
+			0, CSS_UNIT_PX, 0, CSS_UNIT_PX);
+	return CSS_OK;
+}
+
+css_error css__copy_border_top_left_radius(const css_computed_style *from,
+		css_computed_style *to)
+{
+	if (from != to)
+		copy_corner(0, from, to);
+	return CSS_OK;
+}
+
+css_error css__compose_border_top_left_radius(const css_computed_style *parent,
+		const css_computed_style *child, css_computed_style *result)
+{
+	copy_corner(0, child->i.corner_radius_status[0] ==
+			CSS_BORDER_CORNER_RADIUS_INHERIT ? parent : child,
+			result);
+	return CSS_OK;
+}
+
+uint32_t destroy_border_top_left_radius(void *bytecode)
+{
+	(void)bytecode;
+	return 0;
+}
