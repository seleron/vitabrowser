+/* VitaBrowser 363: one corner; an unset corner is 0 */
+uint8_t css_computed_border_corner_radius(
+		const css_computed_style *style, int corner,
+		css_fixed *h, css_unit *hu, css_fixed *v, css_unit *vu)
+{
+	if (corner < 0 || corner > 3 ||
+	    style->i.corner_radius_status[corner] !=
+			CSS_BORDER_CORNER_RADIUS_SET) {
+		*h = *v = 0;
+		*hu = *vu = CSS_UNIT_PX;
+		return CSS_BORDER_CORNER_RADIUS_SET;
+	}
+	*h = style->i.corner_radius_h[corner];
+	*hu = (css_unit)style->i.corner_radius_hu[corner];
+	*v = style->i.corner_radius_v[corner];
+	*vu = (css_unit)style->i.corner_radius_vu[corner];
+	return CSS_BORDER_CORNER_RADIUS_SET;
+}
+
 uint8_t css_computed_border_radius(const css_computed_style *style,
 		css_fixed *length, css_unit *unit)
 {
+	/* VitaBrowser 363: border-radius is a shorthand now; the old
+	 * single value reads as the top-left corner's horizontal radius */
+	css_fixed v;
+	css_unit vu;
+
+	if (style->i.corner_radius_status[CSS_CORNER_TOP_LEFT] ==
+			CSS_BORDER_CORNER_RADIUS_SET) {
+		(void) css_computed_border_corner_radius(style,
+				CSS_CORNER_TOP_LEFT, length, unit, &v, &vu);
+		return (*length > 0) ? CSS_BORDER_RADIUS_SET :
+				CSS_BORDER_RADIUS_INHERIT;
+	}
 	return get_border_radius(style, length, unit);
 }
 
