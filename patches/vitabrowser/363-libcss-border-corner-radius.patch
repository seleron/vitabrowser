@@ -0,0 +1,144 @@
+/*
+ * This file is part of LibCSS.
+ * Licensed under the MIT License,
+ *		  http://www.opensource.org/licenses/mit-license.php
+ */
+
+/* VitaBrowser patch 363: the four corner radii.
+ *
+ *   border-top-left-radius etc.:  <length-percentage>{1,2}
+ *   border-radius (p_border_radius.c):
+ *       <length-percentage>{1,4} [ / <length-percentage>{1,4} ]?
+ *
+ * Each corner is stored as OPV + horizontal length, unit + vertical
+ * length, unit (the vertical one equal to the horizontal when not
+ * given). The logical corners (border-start-start-radius ...) and the
+ * -webkit- names are aliases (properties.c alias_props). */
+
+#include <assert.h>
+#include <string.h>
+
+#include "bytecode/bytecode.h"
+#include "bytecode/opcodes.h"
+#include "parse/properties/properties.h"
+#include "parse/properties/utils.h"
+
+/* One radius: a non-negative length or percentage. */
+css_error css__parse_corner_radius_one(css_language *c,
+		const parserutils_vector *vector, int32_t *ctx,
+		css_fixed *length, uint32_t *unit)
+{
+	int32_t orig_ctx = *ctx;
+	const css_token *token;
+	css_error error;
+
+	token = parserutils_vector_peek(vector, *ctx);
+	if (token == NULL || (token->type != CSS_TOKEN_DIMENSION &&
+			token->type != CSS_TOKEN_NUMBER &&
+			token->type != CSS_TOKEN_PERCENTAGE))
+		return CSS_INVALID;
+
+	error = css__parse_unit_specifier(c, vector, ctx, UNIT_PX,
+			length, unit);
+	if (error != CSS_OK) {
+		*ctx = orig_ctx;
+		return error;
+	}
+	if ((*unit & UNIT_ANGLE) || (*unit & UNIT_TIME) ||
+			(*unit & UNIT_FREQ) || *length < 0) {
+		*ctx = orig_ctx;
+		return CSS_INVALID;
+	}
+	return CSS_OK;
+}
+
+css_error css__corner_radius_append(css_style *result, int prop,
+		css_fixed h, uint32_t hu, css_fixed v, uint32_t vu)
+{
+	css_error error;
+
+	error = css__stylesheet_style_appendOPV(result, prop, 0,
+			BORDER_CORNER_RADIUS_SET);
+	if (error != CSS_OK)
+		return error;
+	return css__stylesheet_style_vappend(result, 4, h, hu, v, vu);
+}
+
+static css_error parse_corner(css_language *c,
+		const parserutils_vector *vector, int32_t *ctx,
+		css_style *result, int prop)
+{
+	int32_t orig_ctx = *ctx;
+	const css_token *token;
+	enum flag_value flag_value;
+	css_fixed h = 0, v = 0;
+	uint32_t hu = UNIT_PX, vu = UNIT_PX;
+	css_error error;
+
+	token = parserutils_vector_peek(vector, *ctx);
+	if (token == NULL)
+		return CSS_INVALID;
+
+	flag_value = get_css_flag_value(c, token);
+	if (flag_value != FLAG_VALUE__NONE) {
+		parserutils_vector_iterate(vector, ctx);
+		return css_stylesheet_style_flag_value(result, flag_value,
+				prop);
+	}
+
+	error = css__parse_corner_radius_one(c, vector, ctx, &h, &hu);
+	if (error != CSS_OK) {
+		*ctx = orig_ctx;
+		return error;
+	}
+	v = h;
+	vu = hu;
+	consumeWhitespace(vector, ctx);
+	token = parserutils_vector_peek(vector, *ctx);
+	if (token != NULL && (token->type == CSS_TOKEN_DIMENSION ||
+			token->type == CSS_TOKEN_NUMBER ||
+			token->type == CSS_TOKEN_PERCENTAGE)) {
+		error = css__parse_corner_radius_one(c, vector, ctx, &v, &vu);
+		if (error != CSS_OK) {
+			*ctx = orig_ctx;
+			return error;
+		}
+	}
+
+	error = css__corner_radius_append(result, prop, h, hu, v, vu);
+	if (error != CSS_OK)
+		*ctx = orig_ctx;
+	return error;
+}
