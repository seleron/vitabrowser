+/* ---- VitaBrowser patch 363: rounded corners --------------------------
+ *
+ * border-radius was parsed (one length, patch 107) and never drawn: the
+ * Vita painted every box square. libcss now keeps four corners (each a
+ * horizontal and a vertical radius); here they become device pixels and
+ * a path: the background fill (redraw.c) and a solid one-colour border
+ * draw through the path plotter, which antialiases (patch 359). Mixed
+ * border colours or styles keep the square painter; images, shadows and
+ * overflow clipping stay square. */
+
+#ifndef M_PI
+#define M_PI 3.14159265358979323846
+#endif
+#define HTML_RR_SEG_MAX 16
+#define HTML_RR_FLOATS (2 * (4 * (HTML_RR_SEG_MAX + 1) * 3 + 1))
+
+bool html_redraw_corner_radii(const struct box *box,
+		const css_unit_ctx *unit_len_ctx, float scale, float bw,
+		float bh, float rx[4], float ry[4])
+{
+	float f = 1.0f;
+	bool any = false;
+	int k;
+
+	if (box == NULL || box->style == NULL || bw <= 0 || bh <= 0)
+		return false;
+	for (k = 0; k < 4; k++) {
+		css_fixed h = 0, v = 0;
+		css_unit hu = CSS_UNIT_PX, vu = CSS_UNIT_PX;
+
+		css_computed_border_corner_radius(box->style, k,
+				&h, &hu, &v, &vu);
+		rx[k] = (hu == CSS_UNIT_PCT) ? FIXTOFLT(h) * bw / 100.0f :
+			FIXTOFLT(css_unit_len2device_px(box->style,
+					unit_len_ctx, h, hu)) * scale;
+		ry[k] = (vu == CSS_UNIT_PCT) ? FIXTOFLT(v) * bh / 100.0f :
+			FIXTOFLT(css_unit_len2device_px(box->style,
+					unit_len_ctx, v, vu)) * scale;
+		if (rx[k] < 0.5f || ry[k] < 0.5f)
+			rx[k] = ry[k] = 0;
+		else
+			any = true;
+	}
+	if (!any)
+		return false;
+	/* CSS backgrounds 5.5: radii that overlap on a side shrink
+	 * together */
+#define HTML_RR_FIT(len, a, b) \
+	if ((a) + (b) > (len) && (len) / ((a) + (b)) < f) \
+		f = (len) / ((a) + (b))
+	HTML_RR_FIT(bw, rx[0], rx[1]);
+	HTML_RR_FIT(bw, rx[3], rx[2]);
+	HTML_RR_FIT(bh, ry[0], ry[3]);
+	HTML_RR_FIT(bh, ry[1], ry[2]);
+#undef HTML_RR_FIT
+	if (f < 1.0f)
+		for (k = 0; k < 4; k++) {
+			rx[k] *= f;
+			ry[k] *= f;
+		}
+	return true;
+}
+
+/* Append one rounded rectangle as a closed subpath: corners clockwise
+ * from the top left, or anticlockwise (the ring's hole). */
+static unsigned int html_rr_subpath(float *p, unsigned int n,
+		const float r[4], const float rx[4], const float ry[4],
+		bool anticlockwise)
+{
+	/* each corner's centre and start angle (y down, so increasing
+	 * angle runs clockwise on screen) */
+	float cx[4], cy[4], a0[4];
+	float pts[4 * (HTML_RR_SEG_MAX + 1)][2];
+	unsigned int np = 0, i;
+	int k, s;
+
+	cx[0] = r[0] + rx[0]; cy[0] = r[1] + ry[0]; a0[0] = (float)M_PI;
+	cx[1] = r[2] - rx[1]; cy[1] = r[1] + ry[1]; a0[1] = 1.5f * (float)M_PI;
+	cx[2] = r[2] - rx[2]; cy[2] = r[3] - ry[2]; a0[2] = 0;
+	cx[3] = r[0] + rx[3]; cy[3] = r[3] - ry[3]; a0[3] = 0.5f * (float)M_PI;
+	for (k = 0; k < 4; k++) {
+		int segs;
+		float m = rx[k] > ry[k] ? rx[k] : ry[k];
+
+		if (rx[k] <= 0 || ry[k] <= 0) {
+			/* a square corner */
+			pts[np][0] = (k == 0 || k == 3) ? r[0] : r[2];
+			pts[np][1] = (k == 0 || k == 1) ? r[1] : r[3];
+			np++;
+			continue;
+		}
+		segs = (int)(m / 2.0f) + 2;
+		if (segs > HTML_RR_SEG_MAX)
+			segs = HTML_RR_SEG_MAX;
+		for (s = 0; s <= segs; s++) {
+			float a = a0[k] + 0.5f * (float)M_PI * s / segs;
+			pts[np][0] = cx[k] + rx[k] * cosf(a);
+			pts[np][1] = cy[k] + ry[k] * sinf(a);
+			np++;
+		}
+	}
+	for (i = 0; i < np; i++) {
+		unsigned int j = anticlockwise ? np - 1 - i : i;
+		p[n++] = (float)(i == 0 ? PLOTTER_PATH_MOVE :
+				PLOTTER_PATH_LINE);
+		p[n++] = pts[j][0];
+		p[n++] = pts[j][1];
+	}
+	p[n++] = (float)PLOTTER_PATH_CLOSE;
+	return n;
+}
+
+nserror html_redraw_rounded_shape(const struct redraw_context *ctx,
+		const plot_style_t *style, const struct rect *clip,
+		const float outer[4], const float rx[4], const float ry[4],
+		const float *inner, const float *irx, const float *iry)
+{
+	static const float identity[6] = { 1, 0, 0, 1, 0, 0 };
+	float p[HTML_RR_FLOATS];
+	unsigned int n;
+	plot_style_t st = *style;
+	nserror res;
+
+	if (ctx->plot->path == NULL)
+		return NSERROR_NOT_IMPLEMENTED;
+	n = html_rr_subpath(p, 0, outer, rx, ry, false);
+	if (inner != NULL && inner[2] > inner[0] && inner[3] > inner[1])
+		n = html_rr_subpath(p, n, inner, irx, iry, true);
+	st.stroke_type = PLOT_OP_TYPE_NONE;
+	st.fill_type = PLOT_OP_TYPE_SOLID;
+	res = ctx->plot->clip(ctx, clip);
+	if (res != NSERROR_OK)
+		return res;
+	return ctx->plot->path(ctx, &st, p, n, identity);
+}
+
+bool html_redraw_border_can_round(const struct box *box, css_color *colour,
+		bool *any)
+{
+	static const unsigned int sides[4] = { TOP, RIGHT, BOTTOM, LEFT };
+	bool have = false;
+	css_color col = 0;
+	int k;
+
+	for (k = 0; k < 4; k++) {
+		const struct box_border *b = &box->border[sides[k]];
+
+		if (b->width == 0 || b->style == CSS_BORDER_STYLE_NONE ||
+		    b->style == CSS_BORDER_STYLE_HIDDEN ||
+		    nscss_color_is_transparent(b->c))
+			continue;
+		if (b->style != CSS_BORDER_STYLE_SOLID ||
+		    (have && b->c != col))
+			return false;
+		col = b->c;
+		have = true;
+	}
+	if (colour != NULL)
+		*colour = col;
+	if (any != NULL)
+		*any = have;
+	return true;
+}
+
+bool html_redraw_borders_rounded(struct box *box, int x_parent,
+		int y_parent, int p_width, int p_height,
+		const struct rect *clip, float scale,
+		const css_unit_ctx *unit_len_ctx,
+		const struct redraw_context *ctx)
+{
+	static const unsigned int sides[4] = { TOP, RIGHT, BOTTOM, LEFT };
+	float bw[4], outer[4], inner[4], rx[4], ry[4], irx[4], iry[4];
+	css_color col = 0;
+	bool have = false;
+	plot_style_t st;
+	unsigned int alpha;
+	plot_style_fixed group;
+	float x, y;
+	int k;
+
+	if (box->style == NULL ||
+	    !html_redraw_border_can_round(box, &col, &have) || !have)
+		return false;
+	/* the band each side draws (a hidden side draws none) */
+	for (k = 0; k < 4; k++) {
+		const struct box_border *b = &box->border[sides[k]];
+
+		bw[k] = (b->width == 0 || b->style == CSS_BORDER_STYLE_NONE ||
+			 b->style == CSS_BORDER_STYLE_HIDDEN ||
+			 nscss_color_is_transparent(b->c)) ? 0 :
+			b->width * scale;
+	}
+
+	x = (x_parent + box->x) * scale;
+	y = (y_parent + box->y) * scale;
+	outer[0] = x - box->border[LEFT].width * scale;
+	outer[1] = y - box->border[TOP].width * scale;
+	outer[2] = x + p_width + box->border[RIGHT].width * scale;
+	outer[3] = y + p_height + box->border[BOTTOM].width * scale;
+	if (!html_redraw_corner_radii(box, unit_len_ctx, scale,
+			outer[2] - outer[0], outer[3] - outer[1], rx, ry))
+		return false;
+
+	/* the hole: the padding box, its radii less the border widths */
+	inner[0] = outer[0] + bw[3];
+	inner[1] = outer[1] + bw[0];
+	inner[2] = outer[2] - bw[1];
+	inner[3] = outer[3] - bw[2];
+	irx[0] = rx[0] - bw[3]; iry[0] = ry[0] - bw[0];
+	irx[1] = rx[1] - bw[1]; iry[1] = ry[1] - bw[0];
+	irx[2] = rx[2] - bw[1]; iry[2] = ry[2] - bw[2];
+	irx[3] = rx[3] - bw[3]; iry[3] = ry[3] - bw[2];
+	for (k = 0; k < 4; k++)
+		if (irx[k] <= 0 || iry[k] <= 0)
+			irx[k] = iry[k] = 0;
+
+	/* the colour's alpha, folded with the group opacity, as
+	 * html_redraw_border_plot does (0 = opaque for the plotters) */
+	alpha = (col >> 24) & 0xff;
+	group = html_redraw_group_opacity();
+	if (group < (plot_style_fixed)PLOT_STYLE_SCALE)
+		alpha = (unsigned int)(((uint64_t)alpha *
+				(unsigned int)group) / PLOT_STYLE_SCALE);
+	if (alpha == 0)
+		return true;	/* nothing to draw, and nothing square */
+	memset(&st, 0, sizeof(st));
+	st.fill_type = PLOT_OP_TYPE_SOLID;
+	st.fill_colour = nscss_color_to_ns(col);
+	st.opacity = alpha >= 255 ? 0 :
+		(plot_style_fixed)(alpha * PLOT_STYLE_SCALE / 255);
+	return html_redraw_rounded_shape(ctx, &st, clip, outer, rx, ry,
+			inner, irx, iry) == NSERROR_OK;
+}
