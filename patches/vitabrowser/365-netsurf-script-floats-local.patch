 /* A script inserted and/or removed blocks among parent's block children:
  * build (or unlink) just those and place them (layout_relayout_block).
  * 0 done, -1 declined (nothing changed). */
+/* Patch 365: a float between blocks is an anonymous inline container
+ * holding float boxes (no node), each wrapping its element's box
+ * (box_construct.c). True for such a "float carrier": nothing else in
+ * it, so it can be edited float by float. */
+static bool html_rl_float_carrier(const struct box *b)
+{
+	const struct box *f;
+
+	if (b->type != BOX_INLINE_CONTAINER || b->node != NULL ||
+	    b->children == NULL)
+		return false;
+	for (f = b->children; f != NULL; f = f->next)
+		if ((f->type != BOX_FLOAT_LEFT && f->type != BOX_FLOAT_RIGHT) ||
+		    f->node != NULL || f->children == NULL ||
+		    f->children->next != NULL ||
+		    f->children->node == NULL)
+			return false;
+	return true;
+}
+
+/* Patch 365: the element of a removed box and its element neighbours
+ * as they were: a float box stands for its element, and a float carrier
+ * beside it for the nearest float's element (the carrier has no node). */
+static dom_node *html_rl_edge_elem(struct box *b, bool last)
+{
+	if (b == NULL)
+		return NULL;
+	if (html_rl_float_carrier(b))
+		b = last ? b->last : b->children;
+	if (b->type == BOX_FLOAT_LEFT || b->type == BOX_FLOAT_RIGHT)
+		b = b->children;
+	return b != NULL ? b->node : NULL;
+}
+
+static void html_rl_removed_nodes(struct box *r, dom_node **e,
+		dom_node **prev, dom_node **next)
+{
+	bool f = r->type == BOX_FLOAT_LEFT || r->type == BOX_FLOAT_RIGHT;
+	struct box *top = (f && r->parent != NULL) ? r->parent : r;
+
+	*e = html_rl_edge_elem(r, false);
+	*prev = (f && r->prev != NULL) ? html_rl_edge_elem(r->prev, true) :
+			html_rl_edge_elem(top->prev, true);
+	*next = (f && r->next != NULL) ? html_rl_edge_elem(r->next, false) :
+			html_rl_edge_elem(top->next, false);
+}
+
+/* Patch 365: the box among pbox's children that holds b (b itself, or
+ * the float carrier its float sits in); NULL if b is not under pbox */
+static struct box *html_rl_top_under(struct box *b, const struct box *pbox)
+{
+	while (b != NULL && b->parent != pbox)
+		b = b->parent;
+	return b;
+}
