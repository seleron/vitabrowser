+/* ---- a cell's own class (patch 369) ---------------------------------
+ *
+ * A class change on a table cell's own box restyles that box, and a cell's
+ * box carries what table normalisation and the table layout work out from
+ * every cell: its start column, its collapsed borders (from its
+ * neighbours, table.c), the table's column types. So the scope is the
+ * table: it is built again whole, with a fresh cascade, and put back where
+ * it was; the page is then laid out once (which makes the column types
+ * again, layout.c). Outside the table a class could reach through a
+ * counter it changes -- a counter in the page's CSS declines, as does a
+ * table holding objects, controls, frames or list markers -- or through
+ * :has() on an ancestor, but this libcss parses :has() and never matches
+ * it (patch 328, selector_never_matches_part), so a full build applies no
+ * such rule either. If :has() matching is ever added, this must decline
+ * on it. */
+
+/* does a used author sheet mention a counter at all (conservative: the
+ * raw source, comments included)? */
+static bool html_rl_page_counters(html_content *c)
+{
+	unsigned int si;
+
+	for (si = STYLESHEET_START; si < c->stylesheet_count; si++) {
+		const uint8_t *data;
+		size_t size = 0, i;
+
+		if (c->stylesheets[si].sheet == NULL ||
+		    c->stylesheets[si].unused)
+			continue;
+		data = content_get_source_data(c->stylesheets[si].sheet, &size);
+		if (data == NULL)
+			continue;
+		for (i = 0; i + 8 <= size; i++)
+			if (strncasecmp((const char *) data + i, "counter-",
+					8) == 0)
+				return true;
+	}
+	return false;
+}
+
+static int html_rl_table_restyle(html_content *c, struct box *cell,
+		double t0)
+{
+	struct content *base_c = &c->base;
+	struct box *row = cell->parent;
+	struct box *grp = row != NULL ? row->parent : NULL;
+	struct box *tb = grp != NULL ? grp->parent : NULL;
+	struct box *pbox, *prev, *nb;
+	dom_node *el;
+	unsigned int objects_before;
+	static unsigned long table_n;
+
+#define RL_TNO(w) do { macsurf_debug_log_writef( \
+		"LIFE rebuild local: declined (%s)", (w)); return -1; } while (0)
+	if (row == NULL || row->type != BOX_TABLE_ROW ||
+	    grp == NULL || grp->type != BOX_TABLE_ROW_GROUP ||
+	    tb == NULL || tb->type != BOX_TABLE || tb->node == NULL)
+		RL_TNO("restyled cell's table is not a plain table");
+	pbox = tb->parent;
+	if (pbox == NULL || (pbox->type != BOX_BLOCK &&
+			     pbox->type != BOX_TABLE_CELL))
+		RL_TNO("restyled cell's table is not in a block");
+	if (tb->object != NULL || tb->gadget != NULL || tb->iframe != NULL ||
+	    tb->list_marker != NULL ||
+	    html_rl_subtree_referenced(tb->children))
+		RL_TNO("restyled cell's table holds objects, controls or "
+			"frames");
+	if (html_rl_page_counters(c))
+		RL_TNO("a cell's class could reach outside its table "
+			"(counters)");
+
+	/* out with the old table, in with the new, cascaded afresh, where
+	 * the old one was */
+	el = tb->node;
+	dom_node_ref(el);
+	prev = tb->prev;
+	html_rl_unlink(tb);
+	box_free(tb);
+	html_rl_invalidate(pbox);
+	objects_before = c->num_objects;
+	(void) html_reconvert_reset_node_data_walk(el, 0);
+	if (!box_build_element(c, el)) {
+		nb = box_for_node(el);
+		if (nb != NULL) {
+			html_rl_unlink(nb);
+			box_free(nb);
+		}
+		dom_node_unref(el);
+		macsurf_debug_log_writef("LIFE rebuild local: restyled table "
+			"failed to build, full reconvert");
+		return -1;
+	}
+	nb = box_for_node(el);
+	dom_node_unref(el);
+	if (nb == NULL || nb->type != BOX_TABLE || nb->parent != pbox) {
+		if (nb != NULL) {
+			html_rl_unlink(nb);
+			box_free(nb);
+		}
+		macsurf_debug_log_writef("LIFE rebuild local: restyled table "
+			"is no longer a table here, full reconvert");
+		return -1;
+	}
+	html_rl_unlink(nb);
+	html_rl_link_after(pbox, prev, nb);
+	if (!box_normalise_table_ext(nb, c->layout, c) ||
+	    c->num_objects != objects_before) {
+		/* the tree is whole, but not as a full build makes it: the
+		 * full reconvert starts from the DOM */
+		macsurf_debug_log_writef("LIFE rebuild local: restyled table "
+			"did not normalise, full reconvert");
+		return -1;
+	}
+	html_rl_invalidate(nb);
+	table_n++;
+	macsurf_debug_log_writef("LIFE rebuild local: table restyled, full "
+		"layout (a cell's own class) in %ld us (%lu so far)",
+		(long)(macos9_micros() - t0), table_n);
+	content__reformat(base_c, false, base_c->available_width,
+			base_c->available_height);
+	return 0;
+#undef RL_TNO
+}
