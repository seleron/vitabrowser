+/* ---- clipping --------------------------------------------------------
+ *
+ * vita2d clips with the stencil buffer, and every
+ * vita2d_set_clip_rectangle() -- vita2d_enable_clipping() calls it too --
+ * rewrites that stencil: a full 960x544 rectangle to clear it, then the
+ * clip rectangle (libvita2d vita2d.c). The first version called both per
+ * core clip, four stencil fills each, and hardware run 3 measured 12-69 ms
+ * of GPU per frame at 30-160 core clips a frame (doc 10).
+ *
+ * So clipping happens on the CPU wherever it can: an axis-aligned fill is
+ * intersected with the clip exactly, a primitive wholly inside the clip
+ * needs no clipping, one wholly outside is skipped, and only a primitive
+ * that really crosses the clip edge gets the stencil -- rewritten only if
+ * the clip changed since it was last written. VITA_CLIP_STENCIL keeps the
+ * old behaviour, for measuring against.
+ */
+enum vita_clip_mode vita_plot_clip_mode = VITA_CLIP_CPU;
+struct vita_plot_clip_stats vita_plot_clip_stats;
+
+static bool gpu_clip_on;	/**< stencil test enabled in vita2d */
+static bool stencil_valid;	/**< the stencil holds stencil_rect */
+static struct rect stencil_rect;
+
+static bool rect_inside(int x0, int y0, int x1, int y1, const struct rect *r)
+{
+	return x0 >= r->x0 && y0 >= r->y0 && x1 <= r->x1 && y1 <= r->y1;
+}
+
+/**
+ * Get the GPU clip state right for a primitive covering [x0,x1) x [y0,y1).
+ *
+ * \return false if nothing of it can be visible (skip drawing it)
+ */
+static bool clip_prepare(int x0, int y0, int x1, int y1)
+{
+	const struct rect *c = &vita_clip;
+
+	if (vita_clip_empty)
+		return false;
+	if (vita_plot_clip_mode == VITA_CLIP_STENCIL)
+		return true;	/* the stencil was set by vita_plot_set_clip */
+	if (x1 <= c->x0 || y1 <= c->y0 || x0 >= c->x1 || y0 >= c->y1) {
+		vita_plot_clip_stats.culled++;
+		return false;
+	}
+	if (rect_inside(x0, y0, x1, y1, c)) {
+		/* Needs no clip -- but a live stencil test for some other
+		 * rectangle must not cut it. Disabling is a state change only. */
+		if (gpu_clip_on &&
+		    !rect_inside(x0, y0, x1, y1, &stencil_rect)) {
+			vita2d_disable_clipping();
+			gpu_clip_on = false;
+		}
+		return true;
+	}
+	/* Crosses the clip edge: only the stencil can cut it exactly. */
+	if (!stencil_valid || stencil_rect.x0 != c->x0 ||
+	    stencil_rect.y0 != c->y0 || stencil_rect.x1 != c->x1 ||
+	    stencil_rect.y1 != c->y1) {
+		vita2d_set_clip_rectangle(c->x0, c->y0, c->x1, c->y1);
+		stencil_rect = *c;
+		stencil_valid = true;
+		vita_plot_clip_stats.stencil_writes++;
+	}
+	if (!gpu_clip_on) {
+		/* Rewrites the stencil once more: vita2d has no cheaper way
+		 * to switch the test on. */
+		vita2d_enable_clipping();
+		gpu_clip_on = true;
+		vita_plot_clip_stats.stencil_writes++;
+	}
+	vita_plot_clip_stats.gpu_clipped++;
+	return true;
+}
+
+/* exported interface documented in vita/plot.h */
+void vita_plot_frame_begin(void)
+{
+	memset(&vita_plot_clip_stats, 0, sizeof(vita_plot_clip_stats));
+	stencil_valid = false;
+	if (vita_plot_clip_mode == VITA_CLIP_CPU) {
+		/* A stencil mode frame before this one may have left the
+		 * test on; switching it off is a state change, no fill. */
+		vita2d_disable_clipping();
+		gpu_clip_on = false;
+	}
+}
+
+/* exported interface documented in vita/plot.h */
+void vita_plot_frame_end(void)
+{
+	/* With clipping left on, vita2d_start_drawing() rewrites the stencil
+	 * before the next frame draws anything. */
+	if (vita_plot_clip_mode == VITA_CLIP_CPU && gpu_clip_on) {
+		vita2d_disable_clipping();
+		gpu_clip_on = false;
+	}
+}
