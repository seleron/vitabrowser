+	unsigned int stencil_writes;	/**< vita2d stencil rewrites */
+	unsigned int culled;		/**< primitives skipped, all outside */
+	unsigned int cut;		/**< fills intersected on the CPU */
+	unsigned int gpu_clipped;	/**< primitives the stencil clipped */
+};
+extern struct vita_plot_clip_stats vita_plot_clip_stats;
