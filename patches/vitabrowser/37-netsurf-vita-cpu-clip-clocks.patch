+/* exported interface documented in vita/diag.h */
+void vita_diag_set_clocks(const char *tag, int arm, int bus, int gpu,
+			  int xbar)
+{
+#ifdef __vita__
+	int ra, rb, rg, rx;
+
+	if (arm == 0) arm = boot_arm;
+	if (bus == 0) bus = boot_bus;
+	if (gpu == 0) gpu = boot_gpu;
+	if (xbar == 0) xbar = boot_xbar;
+	ra = scePowerSetArmClockFrequency(arm);
+	rb = scePowerSetBusClockFrequency(bus);
+	rg = scePowerSetGpuClockFrequency(gpu);
+	rx = scePowerSetGpuXbarClockFrequency(xbar);
+	vita_diag_log("clocks[%s]: set arm %d (0x%x), bus %d (0x%x), gpu %d "
+		      "(0x%x), xbar %d (0x%x); now arm %d, bus %d, gpu %d, "
+		      "xbar %d MHz", tag, arm, (unsigned int)ra, bus,
+		      (unsigned int)rb, gpu, (unsigned int)rg, xbar,
+		      (unsigned int)rx, scePowerGetArmClockFrequency(),
+		      scePowerGetBusClockFrequency(),
+		      scePowerGetGpuClockFrequency(),
+		      scePowerGetGpuXbarClockFrequency());
+#else
+	(void)boot_arm; (void)boot_bus; (void)boot_gpu; (void)boot_xbar;
+	vita_diag_log("clocks[%s]: arm %d, bus %d, gpu %d, xbar %d requested "
+		      "(host simulator: no effect)", tag, arm, bus, gpu, xbar);
+#endif
+}
