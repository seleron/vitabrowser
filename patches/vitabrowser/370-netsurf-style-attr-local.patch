+/* Patch 370: a change to an element's style attribute. Like a class
+ * change, it restyles the element's own box -- and the class paths are
+ * exactly the ones that select an element's style afresh: the inline
+ * content of its block rebuilt (165/173), a block restyled (174), a
+ * cell's table rebuilt (369); an element with no box (display: none
+ * before) is found by its parent's rebuild as a new one. Declined when
+ * a sibling selector can match on the attribute (below): the change
+ * could then restyle a sibling the rebuild does not reach. The class has
+ * not changed, so patch 186's sibling check gets the current value as
+ * the old one and finds no difference (NULL would decline it). */
+/* Patch 370: could a style attribute change restyle something the
+ * rebuild does not? The rebuild selects the element and everything under
+ * it afresh, so a [style...] selector matching the element or a
+ * descendant is covered; :has() never matches in this libcss (patch 328).
+ * What is left is a sibling combinator whose left compound tests the
+ * attribute (`[style*="display: none"] + p`): the patch-186 cache holds
+ * every such compound. A sheet that scan gave up on (state 2) is a
+ * risk only if it can select on the attribute at all (patch 310's
+ * textual scan). */
+static bool html_rl_cp_tests_attr(const struct html_rl_sib_compound *cp,
+		const char *name)
+{
+	int i;
+
+	for (i = 0; i < cp->nattrs; i++)
+		if (cp->attrs[i].name != NULL &&
+		    strcmp(cp->attrs[i].name, name) == 0)
+			return true;
+	return false;
+}
+
+static bool html_rl_style_sibling_risk(html_content *c)
+{
+	unsigned int si;
+	int k;
+
+	for (si = STYLESHEET_START; si < c->stylesheet_count; si++) {
+		struct html_rl_sib_sheet *sh;
+		if (c->stylesheets[si].sheet == NULL ||
+		    c->stylesheets[si].unused)
+			continue;
+		sh = html_rl_sib_sheet_for(c->stylesheets[si].sheet);
+		if (sh == NULL)
+			continue;
+		if (sh->state == 2) {
+			/* the scan gave up on this sheet's sibling rules (a
+			 * pseudo-class in a left compound, say): it is a risk
+			 * only if the sheet can select on the attribute at all
+			 * (patch 310's scan) */
+			const uint8_t *data;
+			size_t size = 0;
+			data = content_get_source_data(
+					c->stylesheets[si].sheet, &size);
+			if (data == NULL || size == 0 ||
+			    html_rl_sheet_scan_attr(data, size, "style", 5,
+					html_rl_pseudos_for("style")))
+				return true;
+			continue;
+		}
+		for (k = 0; k < sh->nlefts; k++)
+			if (html_rl_cp_tests_attr(&sh->lefts[k], "style"))
+				return true;
+		for (k = 0; k < sh->nrules; k++)
+			if (html_rl_cp_tests_attr(&sh->rules[k].l, "style"))
+				return true;
+	}
+	return false;
+}
+
+int html_reconvert_local_style(struct content *base_c, void *vnode);
+int html_reconvert_local_style(struct content *base_c, void *vnode)
+{
+	html_content *c = (html_content *)base_c;
+	dom_string *cls = NULL;
+	char *cs;
+	int r;
+
+	if (c == NULL || vnode == NULL)
+		return -1;
+	if (html_rl_style_sibling_risk(c)) {
+		macsurf_debug_log_writef("LIFE rebuild local: declined (a "
+			"sibling selector can match on the style attribute)");
+		return -1;
+	}
+	if (dom_element_get_attribute((dom_node *)vnode, corestring_dom_class,
+			&cls) != DOM_NO_ERR)
+		return -1;
+	cs = cls != NULL ? strndup(dom_string_data(cls),
+			dom_string_byte_length(cls)) : strdup("");
+	if (cls != NULL)
+		dom_string_unref(cls);
+	if (cs == NULL)
+		return -1;
+	macsurf_debug_log_writef("LIFE rebuild local: style attribute "
+		"change, as a class change");
+	r = html_reconvert_local_change(base_c, vnode, true, cs);
+	free(cs);
+	return r;
+}
+
