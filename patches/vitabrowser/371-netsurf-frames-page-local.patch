+/* Patch 371: an iframe's box. b->iframe is its window, linked only once
+ * the window is made -- a record (c->iframe, which the window code walks
+ * on every reformat) also points at boxes with no window yet or ever (a
+ * same-origin frame a script made, frames past SCRIPT_FRAMES_MAX).
+ * box_iframe marks every box it makes a record for IFRAME: a box either
+ * way must never be freed by a local rebuild. */
+#define HTML_RL_FRAME(b) ((b)->iframe != NULL || ((b)->flags & IFRAME) != 0)
+
+/* Patch 371: does a box subtree hold an iframe's box? */
+static bool html_rl_subtree_frames(struct box *b)
+{
+	for (; b != NULL; b = b->next) {
+		if (HTML_RL_FRAME(b))
+			return true;
+		if (html_rl_subtree_frames(b->children))
+			return true;
+	}
+	return false;
+}
