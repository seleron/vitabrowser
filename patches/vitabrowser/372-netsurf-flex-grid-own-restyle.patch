+/* Patch 372: a class or style change on a flex or grid container's own
+ * box. The r96 census: rte's carousel (slick) writes the style of its
+ * track, a flex container of 75-335 boxes, on every slide, and each
+ * write was a full box-tree rebuild ("class change on an element with a
+ * non-inline, non-block box"). Its items' styles may depend on it
+ * (descendant selectors, inheritance) and the container's layout is the
+ * items' layout, so the whole container is built again -- cascaded
+ * afresh from the DOM, as the cell's table of patch 369 -- and the page
+ * laid out whole. Declined: a container holding objects, controls or
+ * frames (others point at those boxes); one not directly in a block,
+ * cell, flex or grid box (a float's, an inline's); a sibling selector
+ * the class can move (patch 186); counters in page CSS. */
+static int html_rl_flex_restyle(html_content *c, dom_node *el,
+		struct box *ob, double t0, const char *old_class)
+{
+	struct content *base_c = &c->base;
+	struct box *pbox = ob->parent, *prev, *nb;
+	unsigned int objects_before;
+	bool ok;
+	static unsigned long flex_n;
+
+#define RL_FNO(w) do { macsurf_debug_log_writef( \
+		"LIFE rebuild local: declined (%s)", (w)); return -1; } while (0)
+	if (pbox == NULL || (pbox->type != BOX_BLOCK &&
+			     pbox->type != BOX_TABLE_CELL &&
+			     pbox->type != BOX_FLEX && pbox->type != BOX_GRID))
+		RL_FNO("restyled flex or grid box is not in a block");
+	if (ob->object != NULL || ob->gadget != NULL || HTML_RL_FRAME(ob) ||
+	    html_rl_subtree_objects(ob->children))
+		RL_FNO("restyled flex or grid box holds objects, controls or "
+			"frames");
+	if (html_rl_class_sibling_risk(c, (dom_element *)el, old_class))
+		RL_FNO("class change may move a sibling selector");
+	if (html_rl_page_counters(c))
+		RL_FNO("a class could reach outside its flex or grid box "
+			"(counters)");
+
+	/* out with the old box, in with the new, where the old one was */
+	dom_node_ref(el);
+	prev = ob->prev;
+	html_rl_unlink(ob);
+	box_free(ob);
+	html_rl_invalidate(pbox);
+	objects_before = c->num_objects;
+	(void) html_reconvert_reset_node_data_walk(el, 0);
+	if (!box_build_element(c, el)) {
+		nb = box_for_node(el);
+		if (nb != NULL) {
+			html_rl_unlink(nb);
+			box_free(nb);
+		}
+		dom_node_unref(el);
+		macsurf_debug_log_writef("LIFE rebuild local: restyled flex "
+			"or grid box failed to build, full reconvert");
+		return -1;
+	}
+	nb = box_for_node(el);
+	dom_node_unref(el);
+	if (nb != NULL) {		/* else display: none -- a removal */
+		if (nb->parent != pbox || (nb->type != BOX_FLEX &&
+		    nb->type != BOX_GRID && nb->type != BOX_BLOCK)) {
+			html_rl_unlink(nb);
+			box_free(nb);
+			macsurf_debug_log_writef("LIFE rebuild local: restyled "
+				"flex or grid box is no longer a block-level "
+				"box here, full reconvert");
+			return -1;
+		}
+		html_rl_unlink(nb);
+		html_rl_link_after(pbox, prev, nb);
+		ok = nb->type == BOX_BLOCK ?
+			box_normalise_block(nb, c->layout, c) :
+			box_normalise_flex_ext(nb, c->layout, c);
+		if (!ok || c->num_objects != objects_before) {
+			/* the tree is whole, but not as a full build makes
+			 * it: the full reconvert starts from the DOM */
+			macsurf_debug_log_writef("LIFE rebuild local: restyled "
+				"flex or grid box did not normalise, full "
+				"reconvert");
+			return -1;
+		}
+		html_rl_invalidate(nb);
+	}
+	flex_n++;
+	macsurf_debug_log_writef("LIFE rebuild local: flex or grid box "
+		"restyled, full layout (its own class or style) in %ld us "
+		"(%lu so far)", (long)(macos9_micros() - t0), flex_n);
+	content__reformat(base_c, false, base_c->available_width,
+			base_c->available_height);
+	return 0;
+#undef RL_FNO
+}
