+/* VitaBrowser patch 372: normalise one flex or grid container on its own
+ * -- html.c builds one again when its own class or style changes, and its
+ * new box needs what box_normalise_block does for a flex or grid child. */
+bool box_normalise_flex_ext(struct box *flex, const struct box *root,
+		html_content *c)
+{
+	return box_normalise_flex(flex, root, c);
+}
