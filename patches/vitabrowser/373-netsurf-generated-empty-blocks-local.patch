# netsurf: blocks with generated content, and empty blocks, built again alone (patch 373)
# Generated 2026-11-06
# Base: seleron/vitabrowser (patch stack through 372)
#
# The 370 census's second unparked cause, "block is not one line container
# of plain content", has two shapes this patch takes: a change inside a
# block with ::before / ::after (youtube, wpblog, github) -- rebuilding its
# children alone would lose the generated boxes -- and content arriving in
# an empty block (github, google, wikipedia), which has no line to
# rebuild. Both were full box-tree rebuilds: 104-109 ms on a
# 2500-paragraph sim page.
#
#  - html.c, html_reconvert_local_change: such a block is built again
#    whole, as a restyle of its own box (html_rl_block_restyle, patch
#    174; the current class as the "old" one, so no class changed):
#    box_build_element makes its generated content and its new children,
#    cascaded afresh; placed locally among plain blocks, else the page
#    laid out whole.
#  - Declined: a counter shown in page CSS when the block has generated
#    content (box construction numbers counter() in one flat table per
#    build pass); a sibling rule whose left compound tests :empty when
#    the block was or becomes empty (html_rl_empty_sibling_risk: patch
#    198's compounds, a state-2 sheet searched as text). The line path
#    gets the same :empty check when it empties a block (it had none).
#  - The counters guard of 372's flex restyle, and of the generated
#    content above, is html_rl_page_counter_shown(): counter( or
#    counters( in a sheet. 369's "counter-" match declined rte's slick
#    tracks for a counter-reset nothing displays.
#
# Result on the sim page (median of 3): text under ::before 109 -> 18 ms;
# content into an empty div 104 -> 18 ms; a flex track's style on a page
# with counter-reset 107 -> 19 ms.
#
--- a/content/handlers/html/html.c
+++ b/content/handlers/html/html.c
@@ -9415,6 +9415,37 @@
 	return false;
 }
 
+/* Patch 373: does any sheet show a counter (counter() / counters() in a
+ * content value)? Box construction numbers those in one flat table per
+ * build pass, so a subtree built alone would count from zero; without
+ * one, counter-reset and counter-increment change nothing on screen --
+ * html_rl_page_counters' "counter-" match is broader than these
+ * rebuilds need (rte: counter-reset in its sheets, no counter() shown). */
+static bool html_rl_page_counter_shown(html_content *c)
+{
+	unsigned int si;
+
+	for (si = STYLESHEET_START; si < c->stylesheet_count; si++) {
+		const uint8_t *data;
+		size_t size = 0, i;
+
+		if (c->stylesheets[si].sheet == NULL ||
+		    c->stylesheets[si].unused)
+			continue;
+		data = content_get_source_data(c->stylesheets[si].sheet, &size);
+		if (data == NULL)
+			continue;
+		for (i = 0; i + 8 <= size; i++)
+			if (strncasecmp((const char *) data + i, "counter",
+					7) == 0 &&
+			    (data[i + 7] == '(' ||
+			     (data[i + 7] == 's' && i + 9 <= size &&
+			      data[i + 8] == '(')))
+				return true;
+	}
+	return false;
+}
+
