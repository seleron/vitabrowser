 }
 
+/* Patch 373: can a sibling rule see the change's block go empty or stop
+ * being empty? :empty on the block itself is cascaded again by its
+ * rebuild, and no ancestor of it can be empty; what reaches outside is a
+ * + / ~ rule whose left compound has :empty (patch 198 keeps those
+ * compounds; a sheet the patch-186 scan gave up on is searched as text). */
+static bool html_rl_empty_sibling_risk(html_content *c)
+{
+	unsigned int si;
+	int k;
+
+	for (si = STYLESHEET_START; si < c->stylesheet_count; si++) {
+		struct html_rl_sib_sheet *sh;
+		if (c->stylesheets[si].sheet == NULL ||
+		    c->stylesheets[si].unused)
+			continue;
+		sh = html_rl_sib_sheet_for(c->stylesheets[si].sheet);
+		if (sh == NULL)
+			continue;
+		if (sh->state == 2) {
+			const uint8_t *data;
+			size_t size = 0, i;
+			data = content_get_source_data(
+					c->stylesheets[si].sheet, &size);
+			if (data == NULL || size == 0)
+				return true;
+			for (i = 0; i + 6 <= size; i++)
+				if (strncasecmp((const char *) data + i,
+						":empty", 6) == 0)
+					return true;
+			continue;
+		}
+		for (k = 0; k < sh->nlefts; k++)
+			if (sh->lefts[k].has_empty)
+				return true;
+		for (k = 0; k < sh->nrules; k++)
+			if (sh->rules[k].l.has_empty)
+				return true;
+	}
+	return false;
+}
+
+/* Patch 373: does the element have no element and no text child now (as
+ * :empty sees it: comments do not count)? */
+static bool html_rl_node_empty(dom_node *el)
+{
+	dom_node *ch = NULL, *nx;
+	bool empty = true;
+
+	if (dom_node_get_first_child(el, &ch) != DOM_NO_ERR)
+		return false;
+	while (ch != NULL && empty) {
+		dom_node_type type;
+		if (dom_node_get_node_type(ch, &type) != DOM_NO_ERR ||
+		    type == DOM_ELEMENT_NODE)
+			empty = false;
+		else if (type == DOM_TEXT_NODE ||
+			 type == DOM_CDATA_SECTION_NODE) {
+			dom_string *d = NULL;
+			if (dom_characterdata_get_data(ch, &d) != DOM_NO_ERR ||
+			    (d != NULL && dom_string_byte_length(d) > 0))
+				empty = false;
+			if (d != NULL)
+				dom_string_unref(d);
+		}
+		nx = NULL;
+		if (dom_node_get_next_sibling(ch, &nx) != DOM_NO_ERR)
+			nx = NULL;
+		dom_node_unref(ch);
+		ch = nx;
+	}
+	if (ch != NULL)
+		dom_node_unref(ch);
+	return empty;
+}
