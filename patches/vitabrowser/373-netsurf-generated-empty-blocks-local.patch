+	/* Patch 373: a block with generated content (::before / ::after), or
+	 * one that was empty (content arriving): rebuilding its children
+	 * alone (below) would lose the generated boxes, and there is no line
+	 * to rebuild. Build the whole block again instead, as a restyle of
+	 * its own box does (patch 174): box_build_element makes its
+	 * generated content and its new children, cascaded afresh. */
+	if (block->type == BOX_BLOCK && block->styles != NULL &&
+	    block->object == NULL && block->gadget == NULL &&
+	    !HTML_RL_FRAME(block) &&
+	    (old_ic == NULL ||
+	     block->styles->styles[CSS_PSEUDO_ELEMENT_BEFORE] != NULL ||
+	     block->styles->styles[CSS_PSEUDO_ELEMENT_AFTER] != NULL)) {
+		bool gen = block->styles->styles[CSS_PSEUDO_ELEMENT_BEFORE] !=
+				NULL ||
+			block->styles->styles[CSS_PSEUDO_ELEMENT_AFTER] != NULL;
+		dom_string *cls = NULL;
+		char *cs;
+		int r;
+
+		/* box construction numbers counter() in one flat table per
+		 * build pass: a block built alone would count from zero */
+		if (gen && html_rl_page_counter_shown(c)) {
+			dom_node_unref(element);
+			RL_NO("a counter shown in page CSS");
+		}
+		if ((old_ic == NULL || html_rl_node_empty(element)) &&
+		    html_rl_empty_sibling_risk(c)) {
+			dom_node_unref(element);
+			RL_NO("a sibling rule tests :empty");
+		}
+		if (dom_element_get_attribute(element, corestring_dom_class,
+				&cls) != DOM_NO_ERR) {
+			dom_node_unref(element);
+			RL_NO("dom error");
+		}
+		cs = cls != NULL ? strndup(dom_string_data(cls),
+				dom_string_byte_length(cls)) : strdup("");
+		if (cls != NULL)
+			dom_string_unref(cls);
+		if (cs == NULL) {
+			dom_node_unref(element);
+			return -1;
+		}
+		macsurf_debug_log_writef("LIFE rebuild local: %s, the block "
+			"built again", old_ic == NULL ? "content in an empty "
+			"block" : "a block with generated content");
+		/* the current class as the "old" one: no class changed */
+		r = html_rl_block_restyle(c, element, block, t0, cs);
+		free(cs);
+		dom_node_unref(element);
+		return r;
+	}
+
 	/* a block of inline content: one inline container, nothing generated,
 	 * no objects or controls, now or after the change */
 	if (block->object != NULL || block->gadget != NULL ||
@@ -10048,6 +10206,12 @@
 		dom_node_unref(element);
 		RL_NO("block is not one line container of plain content");
 	}
+	/* Patch 373: a line emptied flips the block's :empty -- a sibling
+	 * rule can see that */
+	if (html_rl_node_empty(element) && html_rl_empty_sibling_risk(c)) {
+		dom_node_unref(element);
+		RL_NO("a sibling rule tests :empty");
+	}
