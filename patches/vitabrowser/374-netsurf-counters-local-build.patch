+/* Patch 374: does any entry of the page's object list point at a box in
+ * the subtree under top (top included)? Each fetched object -- an <img>,
+ * but also a CSS background image (box->background is set only once it
+ * arrives), a list-style image -- keeps o->box, which its load callback
+ * and the full reconvert's html_reconvert_relink_objects read
+ * (o->box->node). Freeing such a box leaves the entry dangling: rte's
+ * carousel slides (background images) crashed the relink once 374 let
+ * their track take a local rebuild. The boxes are still alive here; each
+ * entry's box is walked up to the root. */
+static bool html_rl_objects_point_into(html_content *c, struct box *top)
+{
+	struct content_html_object *o;
+	struct box *b;
+
+	if (top == NULL)
+		return false;
+	for (o = c->object_list; o != NULL; o = o->next)
+		for (b = o->box; b != NULL; b = b->parent)
+			if (b == top)
+				return true;
+	return false;
+}
