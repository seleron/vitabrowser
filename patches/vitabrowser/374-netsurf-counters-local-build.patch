+/* Patch 374: a local builder giving up after box_build_element ran. Its
+ * new box can be freed only if the build fetched no object: each object
+ * fetched is an entry in c->object_list pointing at a box of the new
+ * subtree, and the full reconvert that follows re-links every entry
+ * through its box (html_reconvert_relink_objects) -- rte's carousel track
+ * crashed there once 374 let it reach the build. Otherwise the new box
+ * stays where the build put it: the tree is whole, and the full reconvert
+ * rebuilds it from the DOM, as a failed normalise already leaves it. */
+static void html_rl_drop_new(html_content *c, struct box *nb,
+		unsigned int objects_before)
+{
+	if (nb == NULL)
+		return;
+	if (c->num_objects != objects_before) {
+		macsurf_debug_log_writef("LIFE rebuild local: the new boxes "
+			"fetched objects, kept for the full reconvert");
+		return;
+	}
+	html_rl_unlink(nb);
+	box_free(nb);
+}
