+/* VitaBrowser patch 374: a build touched the counter table (see
+ * box_construct.h), and which boxes hold the elements that did. The
+ * element being built is attached to its box only after its counters and
+ * its ::before run, so the mark goes on the nearest ancestor that has a
+ * box (its parent, in this pass). */
+static bool box_counters_were_touched;
+
+void box_counters_touched_reset(void)
+{
+	box_counters_were_touched = false;
+}
+
+bool box_counters_touched(void)
+{
+	return box_counters_were_touched;
+}
+
+static void counter_mark(struct box_construct_ctx *ctx)
+{
+	dom_node *n = NULL, *up;
+	struct box *b = NULL;
+
+	box_counters_were_touched = true;
+	/* from the PARENT: the node being built has no box of its own yet,
+	 * and box_for_node on it can return its box from the tree this one
+	 * replaces -- in a local build already freed */
+	if (ctx->n == NULL ||
+	    dom_node_get_parent_node(ctx->n, &n) != DOM_NO_ERR)
+		return;
+	while (n != NULL) {
+		b = box_for_node(n);
+		if (b != NULL)
+			break;
+		up = NULL;
+		if (dom_node_get_parent_node(n, &up) != DOM_NO_ERR)
+			up = NULL;
+		dom_node_unref(n);
+		n = up;
+	}
+	if (n != NULL)
+		dom_node_unref(n);
+	if (b != NULL)
+		b->flags |= VB_COUNTS;
+}
