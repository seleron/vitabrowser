# netsurf: local rebuilds carry objects over to the new boxes (patch 375)
# Generated 2026-11-06
# Base: seleron/vitabrowser (patch stack through 374)
#
# 374 made every local rebuild decline when an object entry -- an <img>,
# a CSS background image -- points into the subtree it would free: the
# entry's load callback and the full reconvert's relink read o->box. That
# decline now stops rte's backgrounded slick tracks and the "holds
# objects" restyles (youtube 3, rte 1).
#
# The full reconvert solves the same problem for the whole tree
# (html_reconvert_relink_objects: each entry to box_for_node of its old
# box's node, duplicates deduped, the rest retired). This patch does it for
# the subtree a restyle rebuilds:
#  - the flex/grid restyle (372), the block restyle (174, and 373's
#    route) and the cell's table restyle (369) keep the old subtree alive,
#    unlinked, its node backlinks cleared, across the build (they freed it
#    first). That also makes html_fetch_object's fixes977 adoption sound:
#    while building, it moves an entry of the same element and URL to the
#    new box -- reading the OLD box's node, which used to be freed.
#  - html_rl_relink_subtree(): after the build, each entry still under the
#    old subtree goes to the new box of its element (attached, if loaded,
#    as object or background, ancestors re-measured), or is retired if the
#    element has no box now, or loses to an entry the build made for the
#    same box (the loaded one is kept, as the full relink dedupes). Retired
#    entries go through html_object_free_objects. Then the old subtree is
#    freed. Entries elsewhere are not touched.
#  - given up after the build, the old subtree is left for the full
#    reconvert (its relink reads those boxes); 374's html_rl_drop_new
#    still decides the new one.
#  - still declined: an <object> / <embed> (CONTENT_ANY: the full relink
#    drops those too), controls, frames; the line path and block removal
#    keep 374's decline.
#
# Result on a 2500-paragraph sim page: a track of 30 slides, each with an
# image and a background image, its style 109 -> 20 ms.
#
--- a/content/handlers/html/html.c
+++ b/content/handlers/html/html.c
@@ -6533,6 +6533,169 @@
 	return false;
 }
 
+/* Patch 375: is box b in the subtree under top (top included)? */
+static bool html_rl_box_under(struct box *b, struct box *top)
+{
+	for (; b != NULL; b = b->parent)
+		if (b == top)
+			return true;
+	return false;
+}
+
+/* Patch 375: can every object entry pointing into the subtree under top be
+ * re-pointed at the box a rebuild makes for the same element? Images and
+ * backgrounds (CONTENT_IMAGE) can, as the full reconvert's relink does;
+ * an <object> / <embed> (CONTENT_ANY) is dropped there, so not here. */
+static bool html_rl_objects_relinkable(html_content *c, struct box *top)
+{
+	struct content_html_object *o;
+
+	for (o = c->object_list; o != NULL; o = o->next)
+		if (html_rl_box_under(o->box, top) &&
+		    (g_object_relink_enabled == 0 ||
+		     o->permitted_types != CONTENT_IMAGE))
+			return false;
+	return true;
+}
+
+/* Patch 375: a subtree's controls and frames (what others point at that
+ * html_rl_relink_subtree cannot carry over) */
+static bool html_rl_subtree_controls_frames(struct box *b)
+{
+	for (; b != NULL; b = b->next) {
+		if (b->gadget != NULL || HTML_RL_FRAME(b))
+			return true;
+		if (html_rl_subtree_controls_frames(b->children))
+			return true;
+	}
+	return false;
+}
+
+/* Patch 375: list markers in a subtree (369 kept the table restyle off
+ * them; objects are carried over now, markers still are not) */
+static bool html_rl_subtree_markers(struct box *b)
+{
+	for (; b != NULL; b = b->next) {
+		if (b->list_marker != NULL)
+			return true;
+		if (html_rl_subtree_markers(b->children))
+			return true;
+	}
+	return false;
+}
+
+/* Patch 375: the object entries of a subtree a local rebuild replaced,
+ * moved to the new boxes -- html_reconvert_relink_objects (the full
+ * reconvert's) for the entries under old_root only. The old subtree is
+ * still alive, unlinked, its backlinks cleared before the build, so
+ * box_for_node of an element of it is its NEW box, or NULL if it has none
+ * now (display:none, gone from the DOM). Per entry under old_root:
+ *  - no new box: retired (its handle released, its callback disarmed);
+ *  - an entry the build made for the same new box (same kind): the one
+ *    already loaded is kept and the other retired, as the full relink
+ *    dedupes; different URLs: the old one goes;
+ *  - else re-pointed, and a loaded one attached to the new box (object or
+ *    background), with the new box's ancestors re-measured.
+ * Entries elsewhere are not touched: the rest of the tree is the same
+ * tree. The caller frees old_root after this. Most entries arrive here
+ * already moved: html_fetch_object adopts an entry of the same element and
+ * URL for the new box while it builds (fixes977) -- reading the OLD box's
+ * node, which before this patch the local paths had freed. */
+static void html_rl_relink_subtree(html_content *c, struct box *old_root)
+{
+	struct content_html_object *o, *next, *olds = NULL, *rest = NULL;
+	struct content_html_object *drop = NULL;
+	unsigned int n = 0;
+	int relinked = 0, inflight = 0, retired = 0, dedup = 0;
+
+	for (o = c->object_list; o != NULL; o = next) {
+		next = o->next;
+		if (o->box != NULL && html_rl_box_under(o->box, old_root)) {
+			o->next = olds;
+			olds = o;
+		} else {
+			o->next = rest;
+			rest = o;
+		}
+	}
+	for (o = olds; o != NULL; o = next) {
+		struct content_html_object *k, *kprev = NULL;
+		struct box *newbox, *b;
+		dom_node *node = o->box->node;
+
+		next = o->next;
+		newbox = node != NULL ? box_for_node(node) : NULL;
+		if (newbox == NULL || html_rl_box_under(newbox, old_root)) {
+			o->next = drop;
+			drop = o;
+			retired++;
+			continue;
+		}
+		for (k = rest; k != NULL; kprev = k, k = k->next)
+			if (k->box == newbox &&
+			    (k->background ? 1 : 0) == (o->background ? 1 : 0))
+				break;
+		if (k != NULL) {
+			bool o_done = o->content != NULL &&
+				content_get_status(o->content) ==
+					CONTENT_STATUS_DONE;
+			bool k_done = k->content != NULL &&
+				content_get_status(k->content) ==
+					CONTENT_STATUS_DONE;
+			bool same_url = o->url == NULL || k->url == NULL ||
+				o->url == k->url ||
+				nsurl_compare(o->url, k->url, NSURL_COMPLETE);
+
+			dedup++;
+			if (!same_url || !(o_done && !k_done)) {
+				o->next = drop;
+				drop = o;
+				retired++;
+				continue;
+			}
+			if (kprev != NULL)
+				kprev->next = k->next;
+			else
+				rest = k->next;
+			k->next = drop;
+			drop = k;
+			retired++;
+		}
+		o->box = newbox;
+		if (o->content != NULL &&
+		    content_get_status(o->content) == CONTENT_STATUS_DONE) {
+			if (o->background) {
+				newbox->background = o->content;
+			} else {
+				newbox->object = o->content;
+				if (newbox->type == BOX_TABLE)
+					newbox->type = BOX_BLOCK;
+				if (!(newbox->flags & REPLACE_DIM))
+					for (b = newbox; b != NULL;
+					     b = b->parent)
+						b->max_width =
+							UNKNOWN_MAX_WIDTH;
+			}
+			relinked++;
+		} else {
+			inflight++;
+		}
+		o->next = rest;
+		rest = o;
+	}
+	/* retire through the one teardown (as the full relink does) */
+	c->object_list = drop;
+	(void) html_object_free_objects(c);
+	c->object_list = rest;
+	for (o = rest; o != NULL; o = o->next)
+		n++;
+	c->num_objects = n;
+	if (relinked || inflight || retired)
+		macsurf_debug_log_writef("LIFE rebuild local: objects "
+			"re-pointed %d (in flight %d), retired %d (dedup %d)",
+			relinked, inflight, retired, dedup);
+}
