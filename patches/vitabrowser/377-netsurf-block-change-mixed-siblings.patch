+/* Patch 377: the box under pbox holding the nearest element sibling of n
+ * (forward or back) that has a box, or NULL */
+static struct box *html_rl_sib_top(dom_node *n, const struct box *pbox,
+		bool forward)
+{
+	dom_node *s = n, *t;
+	struct box *top = NULL;
+
+	dom_node_ref(s);
+	while (top == NULL) {
+		t = NULL;
+		if ((forward ? dom_node_get_next_sibling(s, &t) :
+			       dom_node_get_previous_sibling(s, &t)) !=
+				DOM_NO_ERR || t == NULL)
+			break;
+		dom_node_unref(s);
+		s = t;
+		if (box_for_node(s) != NULL)
+			top = html_rl_top_under(box_for_node(s), pbox);
+	}
+	dom_node_unref(s);
+	return top;
+}
