 /* Patch 365: the box among pbox's children that holds b (b itself, or
  * the float carrier its float sits in); NULL if b is not under pbox */
+/* Patch 377: does a box hold a block-level child (a block, a flex, grid
+ * or table element box, a float carrier)? Not a box of one line. */
+static bool html_rl_has_block_child(struct box *block)
+{
+	struct box *b;
+
+	for (b = block->children; b != NULL; b = b->next)
+		if (b->type == BOX_BLOCK || html_rl_float_carrier(b) ||
+		    ((b->type == BOX_FLEX || b->type == BOX_GRID ||
+		      b->type == BOX_TABLE) && b->node != NULL))
+			return true;
+	return false;
+}
+
+/* Patch 377: an anonymous inline container (inline content directly in a
+ * parent of blocks: youtube's hidden <iframe> in <body>, guardian's
+ * <gu-island>s) */
+static bool html_rl_anon_ic(const struct box *b)
+{
+	return b != NULL && b->type == BOX_INLINE_CONTAINER && b->node == NULL;
+}
+
+/* Patch 377: is every element an inline container holds still inside
+ * pnode (none removed: its box would stay behind)? Text inside them is an
+ * element's (text directly in pnode declines on its own below). */
+static bool html_rl_ic_intact(struct box *ic, dom_node *pnode)
+{
+	struct box *k = ic->children;
+
+	while (k != NULL) {
+		if (k->node != NULL) {
+			dom_node *n = k->node, *up;
+			bool in = false;
+			dom_node_ref(n);
+			while (n != NULL) {
+				up = NULL;
+				if (dom_node_get_parent_node(n, &up) !=
+						DOM_NO_ERR)
+					up = NULL;
+				dom_node_unref(n);
+				n = up;
+				if (n == pnode) {
+					in = true;
+					break;
+				}
+			}
+			if (n != NULL)
+				dom_node_unref(n);
+			if (!in)
+				return false;
+		}
+		/* next in document order, inside ic */
+		if (k->children != NULL) {
+			k = k->children;
+			continue;
+		}
+		while (k != ic && k->next == NULL)
+			k = k->parent;
+		if (k == ic)
+			break;
+		k = k->next;
+	}
+	return true;
+}
