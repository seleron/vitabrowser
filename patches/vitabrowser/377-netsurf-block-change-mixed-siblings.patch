+/* Patch 377: elements that never have a box (362's shape: a <script> in
+ * <body> read as a block "added" with no box) */
+static bool html_rl_never_boxed(dom_node *n)
+{
+	static const char *const tags[] = {
+		"script", "style", "link", "meta", "template", "title",
+		"base", "noscript", NULL
+	};
+	dom_string *name = NULL;
+	bool found = false;
+	int i;
+
+	if (dom_node_get_node_name(n, &name) != DOM_NO_ERR || name == NULL)
+		return false;
+	for (i = 0; tags[i] != NULL && !found; i++)
+		if (dom_string_byte_length(name) == strlen(tags[i]) &&
+		    strncasecmp(dom_string_data(name), tags[i],
+				strlen(tags[i])) == 0)
+			found = true;
+	dom_string_unref(name);
+	return found;
+}
+
+/* Patch 377: normalise a new box as box_normalise_block would as its
+ * child -- a new element can be a flex, grid or table box by its CSS (a
+ * <div class="track">), and box_normalise_block asserts on those (gate377:
+ * a shown display:flex <div> among <body>'s mixed children). False: not
+ * normalised, or a type this path does not place. */
+static bool html_rl_normalise_new(struct box *nb, html_content *c)
+{
+	switch (nb->type) {
+	case BOX_BLOCK:
+	case BOX_INLINE_BLOCK:
+	case BOX_TABLE_CELL:
+		return box_normalise_block(nb, c->layout, c);
+	case BOX_FLEX:
+	case BOX_GRID:
+		macsurf_debug_log_writef("LIFE rebuild local: new box "
+			"normalised as a flex or grid");
+		return box_normalise_flex_ext(nb, c->layout, c);
+	case BOX_TABLE:
+		macsurf_debug_log_writef("LIFE rebuild local: new box "
+			"normalised as a table");
+		return box_normalise_table_ext(nb, c->layout, c);
+	default:
+		return false;
+	}
+}
