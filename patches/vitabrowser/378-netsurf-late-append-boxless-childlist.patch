+/* Patch 378: the parent of the child-list change being answered
+ * (appendChild / insertBefore / removeChild mark it), else NULL -- set by
+ * html_reconvert_local_childlist for the length of one local answer. */
+static dom_node *html_rl_childlist_parent;
+
+/* Patch 378: elements a script appends at the end of a parent that this
+ * path builds on their own wherever they are inline-level: box_construct
+ * puts a new inline box at the end of the parent's last line (or a new
+ * one), which is its place exactly when no later sibling has a box.
+ * youtube's, guardian's and cnnlite's ad and tracker <iframe>s, tracking
+ * pixel <img>s. */
+static bool html_rl_late_tag(dom_node *n)
+{
+	static const char *const tags[] = { "iframe", "img", NULL };
+	dom_string *name = NULL;
+	bool found = false;
+	int i;
+
+	if (dom_node_get_node_name(n, &name) != DOM_NO_ERR || name == NULL)
+		return false;
+	for (i = 0; tags[i] != NULL && !found; i++)
+		if (dom_string_byte_length(name) == strlen(tags[i]) &&
+		    strncasecmp(dom_string_data(name), tags[i],
+				strlen(tags[i])) == 0)
+			found = true;
+	dom_string_unref(name);
+	return found;
+}
+
+/* Patch 378: does any later sibling of n have a box, or is it text that
+ * is not white space? */
+static bool html_rl_boxed_after(dom_node *n)
+{
+	dom_node *s = n, *t;
+	bool after = false;
+
+	dom_node_ref(s);
+	while (!after) {
+		dom_node_type type;
+		t = NULL;
+		if (dom_node_get_next_sibling(s, &t) != DOM_NO_ERR || t == NULL)
+			break;
+		dom_node_unref(s);
+		s = t;
+		if (dom_node_get_node_type(s, &type) != DOM_NO_ERR)
+			after = true;
+		else if (type == DOM_ELEMENT_NODE)
+			after = box_for_node(s) != NULL;
+		else if (type == DOM_TEXT_NODE)
+			after = !html_rl_text_is_space(s);
+	}
+	dom_node_unref(s);
+	return after;
+}
