+/* parse the compound s[a, b) into cp (tag, id, classes); unbounded if it
+ * does not parse simply */
+static void html_rl_struct_parse_cp(const uint8_t *s, size_t a, size_t b,
+		struct html_rl_struct_cp *cp)
+{
+	size_t i = a, j;
