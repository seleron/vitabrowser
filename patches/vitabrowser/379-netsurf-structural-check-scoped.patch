+static struct html_rl_struct_sheet *html_rl_struct_sheet_for(
+		struct hlcache_handle *sheet)
+{
+	const uint8_t *data;
+	size_t size = 0;
+	uint32_t hash;
+	unsigned int k;
+	struct html_rl_struct_sheet *e = NULL;
+
+	data = content_get_source_data(sheet, &size);
+	if (data == NULL || size == 0)
+		return NULL;
+	hash = html_rl_fnv1a(data, size);
+	for (k = 0; k < HTML_RL_STRUCT_CACHE_N; k++)
+		if (html_rl_struct_cache[k].sheet == sheet) {
+			e = &html_rl_struct_cache[k];
+			break;
 		}
+	if (e == NULL) {
+		e = &html_rl_struct_cache[html_rl_struct_cache_next];
+		html_rl_struct_cache_next = (html_rl_struct_cache_next + 1) %
+			HTML_RL_STRUCT_CACHE_N;
+	} else if (e->data == data && e->size == size && e->hash == hash) {
+		return e;
+	}
+	html_rl_struct_sheet_free(e);
+	e->sheet = sheet;
+	e->data = data;
+	e->size = size;
+	e->hash = hash;
+	html_rl_struct_scan(data, size, e);
+	return e;
+}
