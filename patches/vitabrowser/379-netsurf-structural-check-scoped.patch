+			cp->unbounded = true;
+			return;
+		}
+	if (i < b && s[i] == '*') {
+		i++;
+	} else if (i < b && html_rl_struct_ident_ch(s[i]) &&
+		   !(s[i] >= '0' && s[i] <= '9')) {
+		j = i;
+		while (j < b && html_rl_struct_ident_ch(s[j]))
+			j++;
+		cp->tag = html_rl_struct_dup_lower(s + i, j - i);
+		i = j;
+	}
+	while (i < b) {
+		uint8_t c = s[i];
+		if (c == '#' || c == '.') {
+			char *v;
+			j = ++i;
+			while (j < b && html_rl_struct_ident_ch(s[j]))
+				j++;
+			if (j == i) {
+				cp->unbounded = true;
+				return;
+			}
+			v = html_rl_struct_dup_lower(s + i, j - i);
+			if (v == NULL) {
+				cp->unbounded = true;
+				return;
+			}
+			if (c == '#') {
+				free(cp->id);
+				cp->id = v;
+			} else {
+				char **nc = realloc(cp->classes,
+					(cp->ncl + 1) * sizeof(char *));
+				if (nc == NULL) {
+					free(v);
+					cp->unbounded = true;
+					return;
+				}
+				cp->classes = nc;
+				cp->classes[cp->ncl++] = v;
+			}
+			i = j;
+		} else if (c == '[') {
+			while (i < b && s[i] != ']')
+				i++;
+			if (i >= b) {
+				cp->unbounded = true;
+				return;
+			}
+			i++;
+		} else if (c == ':') {
+			while (i < b && s[i] == ':')
+				i++;
+			while (i < b && html_rl_struct_ident_ch(s[i]))
+				i++;
+			if (i < b && s[i] == '(') {
+				int depth = 0;
+				for (; i < b; i++) {
+					if (s[i] == '(')
+						depth++;
+					else if (s[i] == ')' && --depth == 0)
+						break;
+				}
+				if (i >= b) {
+					cp->unbounded = true;
+					return;
+				}
+				i++;
+			}
+		} else {
+			cp->unbounded = true;
+			return;
+		}
+	}
+}
