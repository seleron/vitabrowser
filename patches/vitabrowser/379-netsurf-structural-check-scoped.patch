+static bool html_rl_struct_has_class(const char *list, const char *c)
+{
+	size_t n = strlen(c);
+	const char *p = list;
+
+	while (p != NULL && *p != 0) {
+		while (*p == ' ' || *p == '\t' || *p == '\n' || *p == '\r' ||
+		       *p == '\f')
+			p++;
+		if (strncmp(p, c, n) == 0 &&
+		    (p[n] == 0 || p[n] == ' ' || p[n] == '\t' ||
+		     p[n] == '\n' || p[n] == '\r' || p[n] == '\f'))
+			return true;
+		while (*p != 0 && *p != ' ' && *p != '\t' && *p != '\n' &&
+		       *p != '\r' && *p != '\f')
+			p++;
 	}
 	return false;
 }
 
+static bool html_rl_struct_cp_matches(const struct html_rl_struct_cp *cp,
+		const struct html_rl_struct_el *e)
+{
+	int i;
+
+	if (cp->unbounded)
+		return true;
+	if (cp->tag != NULL && (e->tag == NULL || strcmp(cp->tag, e->tag) != 0))
+		return false;
+	if (cp->id != NULL && (e->id == NULL || strcmp(cp->id, e->id) != 0))
+		return false;
+	for (i = 0; i < cp->ncl; i++)
+		if (e->cls == NULL || !html_rl_struct_has_class(e->cls,
+				cp->classes[i]))
+			return false;
+	return true;
+}
