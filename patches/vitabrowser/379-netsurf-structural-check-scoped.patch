+	if (dom_element_get_attribute((dom_element *)n, name, &v) ==
+			DOM_NO_ERR && v != NULL) {
+		r = html_rl_struct_dup_lower((const uint8_t *)dom_string_data(v),
+				dom_string_byte_length(v));
+		dom_string_unref(v);
+	}
+	return r;
+}
