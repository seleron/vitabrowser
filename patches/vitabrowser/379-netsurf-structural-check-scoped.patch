+static char *html_rl_struct_dup_lower(const uint8_t *s, size_t n)
+{
+	char *d = malloc(n + 1);
+	size_t i;
+
+	if (d == NULL)
+		return NULL;
+	for (i = 0; i < n; i++)
+		d[i] = (s[i] >= 'A' && s[i] <= 'Z') ? (char)(s[i] + 32) :
+			(char)s[i];
+	d[n] = 0;
+	return d;
+}
