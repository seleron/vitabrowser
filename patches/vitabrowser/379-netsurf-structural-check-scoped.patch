+/* Patch 379: can a structural rule (or, with counters_matter, a counter)
+ * in page CSS restyle a child of pnode now that the elements of tags
+ * moved[0..nmoved) went in or out? */
+static bool html_rl_block_struct_risk(html_content *c, dom_node *pnode,
+		char **moved, unsigned int nmoved, bool counters_matter,
+		const char **why)
+{
+	struct html_rl_struct_sheet *sh[64];
+	struct html_rl_struct_el *els = NULL;
+	unsigned int nsh = 0, si, nel = 0, k, m;
+	bool any = false, risk = false;
+	dom_node *ch = NULL, *nx;
+	int q;
+
+	*why = NULL;
+	for (si = STYLESHEET_START; si < c->stylesheet_count && nsh < 64;
+	     si++) {
+		struct html_rl_struct_sheet *e;
+		if (c->stylesheets[si].sheet == NULL ||
+		    c->stylesheets[si].unused)
+			continue;
+		e = html_rl_struct_sheet_for(c->stylesheets[si].sheet);
+		if (e == NULL)
+			continue;
+		if (counters_matter && e->counters) {
+			*why = "counters in page CSS";
+			return true;
+		}
+		if (e->ncps > 0 || e->overflow) {
+			sh[nsh++] = e;
+			any = true;
+		}
+	}
+	if (si < c->stylesheet_count) {
+		*why = "too many sheets";
+		return true;
+	}
+	if (!any)
+		return false;
+	/* the parent's children, read once */
+	if (dom_node_get_first_child(pnode, &ch) != DOM_NO_ERR)
+		ch = NULL;
+	while (ch != NULL) {
+		dom_node_type type;
+		if (dom_node_get_node_type(ch, &type) == DOM_NO_ERR &&
+		    type == DOM_ELEMENT_NODE) {
+			struct html_rl_struct_el *ne;
+			if (nel >= 1000) {
+				*why = "a parent of over 1000 children";
+				risk = true;
+				dom_node_unref(ch);
+				break;
+			}
+			ne = realloc(els, (nel + 1) * sizeof(*ne));
+			if (ne == NULL) {
+				*why = "no memory";
+				risk = true;
+				dom_node_unref(ch);
+				break;
+			}
+			els = ne;
+			els[nel].tag = html_rl_struct_tag(ch);
+			els[nel].id = html_rl_struct_attr(ch, corestring_dom_id);
+			els[nel].cls = html_rl_struct_attr(ch,
+					corestring_dom_class);
+			nel++;
+		}
+		nx = NULL;
+		if (dom_node_get_next_sibling(ch, &nx) != DOM_NO_ERR)
+			nx = NULL;
+		dom_node_unref(ch);
+		ch = nx;
+	}
+	for (si = 0; si < nsh && !risk; si++) {
+		if (sh[si]->overflow && nel > 0) {
+			*why = "a sheet of too many structural rules";
+			risk = true;
+			break;
+		}
+		for (q = 0; q < sh[si]->ncps && !risk; q++) {
+			const struct html_rl_struct_cp *cp = &sh[si]->cps[q];
+			if (cp->of_type && cp->tag != NULL) {
+				/* only the moved elements' own type */
+				bool same = false;
+				for (m = 0; m < nmoved && !same; m++)
+					same = moved[m] != NULL &&
+						strcmp(moved[m], cp->tag) == 0;
+				if (!same)
+					continue;
+			}
+			for (k = 0; k < nel && !risk; k++)
+				if (html_rl_struct_cp_matches(cp, &els[k])) {
+					*why = "a structural rule matches a "
+						"sibling";
+					risk = true;
+				}
+		}
+	}
+	for (k = 0; k < nel; k++) {
+		free(els[k].tag);
+		free(els[k].id);
+		free(els[k].cls);
+	}
+	free(els);
+	return risk;
+}
