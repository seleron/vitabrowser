+
+/**
+ * \file
+ * Vita frontend: text, rendered with FreeType.
+ *
+ * Faces open lazily. A code point resolves to the style's DejaVu face if it
+ * has the glyph, else to the regular sans (coverage), else through the
+ * fallbacks; the result and its advance are cached per (code point, size,
+ * style), and layout and drawing both read that cache, so measured and
+ * drawn widths cannot disagree.
+ *
+ * Glyphs are rendered at the exact pixel size into 512x512 8-bit alpha
+ * atlas pages (SCE_GXM_TEXTURE_FORMAT_U8_R111: white, alpha = coverage),
+ * shelf-packed with a 1-pixel gap, sampled with point filtering, and drawn
+ * unscaled at whole-pixel positions with vita2d_draw_texture_tint_part().
+ * When every page is full the atlas is reset between frames, never during
+ * one, since the GPU may still be reading glyphs already drawn.
+ */
+
+#include <stdbool.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include <ft2build.h>
+#include FT_FREETYPE_H
+#include <vita2d.h>
+
+#include "utils/errors.h"
+#include "utils/log.h"
+#include "utils/utf8.h"
+#include "netsurf/plot_style.h"
+
+#include "vita/text.h"
+
+/* The twelve DejaVu faces, indexed family * 4 + bold * 2 + italic, then the
+ * fallbacks, in the order they are tried. */
+static const char *const face_files[] = {
+	"DejaVuSans.ttf", "DejaVuSans-Oblique.ttf",
+	"DejaVuSans-Bold.ttf", "DejaVuSans-BoldOblique.ttf",
+	"DejaVuSerif.ttf", "DejaVuSerif-Italic.ttf",
+	"DejaVuSerif-Bold.ttf", "DejaVuSerif-BoldItalic.ttf",
+	"DejaVuSansMono.ttf", "DejaVuSansMono-Oblique.ttf",
+	"DejaVuSansMono-Bold.ttf", "DejaVuSansMono-BoldOblique.ttf",
+	"DroidSansFallbackFull.ttf",	/* kana, CJK */
+	"NanumGothic-Regular.ttf",	/* Hangul */
+};
+#define FACE_COUNT ((int)(sizeof(face_files) / sizeof(face_files[0])))
+#define FACE_SANS 0
+#define FACE_FIRST_FALLBACK 12
+
+/** Advance / resolution cache entries (direct-mapped). */
+#define ADV_CACHE 8192
+/** Atlas glyph entries (direct-mapped). */
+#define GLYPH_CACHE 4096
+/** Atlas page size and count: 16 x 256 KiB. */
+#define ATLAS_W 512
+#define ATLAS_H 512
+#define ATLAS_PAGES 16
+/** Gap left around every glyph in the atlas. */
+#define ATLAS_GAP 1
+
+struct face {
+	FT_Face ft;
+	int px;		/**< size currently set on ft, 0 = none */
+	bool tried;	/**< an open was attempted */
+};
+
+struct adv_entry {
+	uint32_t cp;
+	uint16_t px;
+	uint8_t slot;	/**< style slot the entry is for */
+	uint8_t face;	/**< face the code point resolved to */
+	uint32_t gi;	/**< glyph index in that face (0 = missing) */
+	int16_t adv;
+	bool valid;
+};
+
+struct glyph_entry {
+	uint32_t gi;
+	uint16_t px;
+	uint8_t face;
+	uint8_t page;
+	uint16_t x, y, w, h;
+	int16_t left, top;
+	bool valid;
+};
+
+struct atlas_page {
+	vita2d_texture *tex;
+	int x, y, row_h;	/**< shelf packing cursor */
+};
+
+struct vita_text_stats vita_text_stats;
+
+static FT_Library ft_lib;
+static struct face faces[FACE_COUNT];
+static char font_dir[256];
+static struct adv_entry adv_cache[ADV_CACHE];
+static struct glyph_entry glyph_cache[GLYPH_CACHE];
+static struct atlas_page pages[ATLAS_PAGES];
+static int page_count, page_cur;
+static bool flush_pending;
+
+static int style_slot(const struct vita_text_style *s)
+{
+	return (int)s->family * 4 + (s->bold ? 2 : 0) + (s->italic ? 1 : 0);
+}
+
+/** The face at index i, opened on first use; NULL if it cannot be. */
+static FT_Face face_get(int i)
+{
+	char path[512];
+
+	if (faces[i].tried)
+		return faces[i].ft;
+	faces[i].tried = true;
+	snprintf(path, sizeof(path), "%s%s", font_dir, face_files[i]);
+	if (FT_New_Face(ft_lib, path, 0, &faces[i].ft) != 0) {
+		faces[i].ft = NULL;
+		vita_text_stats.face_failures++;
+		NSLOG(netsurf, ERROR, "font %s: cannot open", path);
+	}
+	return faces[i].ft;
+}
+
+/** Face i at `px` pixels; NULL if the face is unavailable. */
+static FT_Face face_at(int i, int px)
+{
+	FT_Face f = face_get(i);
+
+	if (f != NULL && faces[i].px != px) {
+		FT_Set_Pixel_Sizes(f, 0, (FT_UInt)px);
+		faces[i].px = px;
+	}
+	return f;
+}
+
+static unsigned int hash3(uint32_t a, uint32_t b, uint32_t c)
+{
+	uint32_t h = a * 2654435761u ^ (b * 40503u) ^ (c * 2246822519u);
+	return h ^ (h >> 15);
+}
+
+/**
+ * Resolve a code point: the style's face, the regular sans, then the
+ * fallbacks. A code point nobody has resolves to the style's face with
+ * glyph 0, which draws its "missing glyph" box.
+ */
+static const struct adv_entry *resolve(const struct vita_text_style *s,
+				       uint32_t cp)
+{
+	int slot = style_slot(s);
+	int px = s->px < 1 ? 1 : (s->px > 1000 ? 1000 : s->px);
+	struct adv_entry *e = &adv_cache[hash3(cp, (uint32_t)px,
+					       (uint32_t)slot) % ADV_CACHE];
+	int order[FACE_COUNT - FACE_FIRST_FALLBACK + 2];
+	int n = 0, i, face = -1;
+	FT_UInt gi = 0;
+	FT_Face f;
+
+	if (e->valid && e->cp == cp && e->px == px && e->slot == slot)
+		return e;
+
+	order[n++] = slot;
+	if (slot != FACE_SANS)
+		order[n++] = FACE_SANS;
+	for (i = FACE_FIRST_FALLBACK; i < FACE_COUNT; i++)
+		order[n++] = i;
+	for (i = 0; i < n; i++) {
+		f = face_get(order[i]);
+		if (f != NULL && (gi = FT_Get_Char_Index(f, cp)) != 0) {
+			face = order[i];
+			break;
+		}
+	}
+	if (face < 0) {
+		face = face_get(slot) != NULL ? slot : FACE_SANS;
+		gi = 0;
+		if (cp >= 0x20)
+			vita_text_stats.missing++;
+	}
+
+	e->cp = cp;
+	e->px = (uint16_t)px;
+	e->slot = (uint8_t)slot;
+	e->face = (uint8_t)face;
+	e->gi = gi;
+	e->adv = 0;
+	f = face_at(face, px);
+	if (f != NULL && FT_Load_Glyph(f, gi, FT_LOAD_DEFAULT) == 0)
+		e->adv = (int16_t)((f->glyph->advance.x + 32) >> 6);
+	/* Control characters take no room, whatever the font says. */
+	if (cp < 0x20)
+		e->adv = 0;
+	e->valid = true;
+	return e;
+}
+
+/* exported interface documented in vita/text.h */
+int vita_text_advance(const struct vita_text_style *style, uint32_t cp)
+{
+	return resolve(style, cp)->adv;
+}
+
+/* exported interface documented in vita/text.h */
+int vita_text_width(const struct vita_text_style *style, const char *utf8,
+		    size_t len)
+{
+	size_t i = 0;
+	int w = 0;
+
+	while (i < len) {
+		w += resolve(style, utf8_to_ucs4(utf8 + i, len - i))->adv;
+		i = utf8_next(utf8, len, i);
+	}
+	return w;
+}
+
+/* exported interface documented in vita/text.h */
+void vita_text_extents(const struct vita_text_style *style, int *ascent,
+		       int *descent)
+{
+	FT_Face f = face_at(style_slot(style), style->px < 1 ? 1 : style->px);
+
+	if (f == NULL)
+		f = face_at(FACE_SANS, style->px < 1 ? 1 : style->px);
+	if (f == NULL) {
+		*ascent = style->px;
+		*descent = style->px / 4;
+		return;
+	}
+	*ascent = (int)((f->size->metrics.ascender + 63) >> 6);
+	*descent = (int)((-f->size->metrics.descender + 63) >> 6);
+}
+
+/** Make room for a w x h glyph; false (and a pending reset) if full. */
+static bool atlas_place(int w, int h, int *page, int *x, int *y)
+{
+	struct atlas_page *p;
+
+	if (w + 2 * ATLAS_GAP > ATLAS_W || h + 2 * ATLAS_GAP > ATLAS_H)
+		return false;	/* bigger than a page: never cached */
+	while (page_cur < ATLAS_PAGES) {
+		if (page_cur == page_count) {
+			vita2d_texture *t = vita2d_create_empty_texture_format(
+				ATLAS_W, ATLAS_H, SCE_GXM_TEXTURE_FORMAT_U8_R111);
+			if (t == NULL)
+				break;
+			/* Zeroed so every gap reads as empty coverage. */
+			memset(vita2d_texture_get_datap(t), 0,
+			       vita2d_texture_get_stride(t) * ATLAS_H);
+			vita2d_texture_set_filters(t, SCE_GXM_TEXTURE_FILTER_POINT,
+						   SCE_GXM_TEXTURE_FILTER_POINT);
+			pages[page_count].tex = t;
+			pages[page_count].x = ATLAS_GAP;
+			pages[page_count].y = ATLAS_GAP;
+			pages[page_count].row_h = 0;
+			page_count++;
+			vita_text_stats.atlas_pages++;
+		}
+		p = &pages[page_cur];
+		if (p->x + w + ATLAS_GAP > ATLAS_W) {
+			/* Next shelf. */
+			p->x = ATLAS_GAP;
+			p->y += p->row_h + ATLAS_GAP;
+			p->row_h = 0;
+		}
+		if (p->y + h + ATLAS_GAP <= ATLAS_H) {
+			*page = page_cur;
+			*x = p->x;
+			*y = p->y;
+			p->x += w + ATLAS_GAP;
+			if (h > p->row_h)
+				p->row_h = h;
+			return true;
+		}
+		page_cur++;
+	}
+	flush_pending = true;
+	return false;
+}
+
+/** The atlas entry for a resolved glyph, rendering it on first use. */
+static const struct glyph_entry *glyph_get(int face, uint32_t gi, int px)
+{
+	struct glyph_entry *g = &glyph_cache[hash3(gi, (uint32_t)px,
+						   (uint32_t)face) % GLYPH_CACHE];
+	FT_Bitmap *bm;
+	FT_Face f;
+	int page, x, y, r, c;
+	unsigned char *dst;
+	unsigned int stride;
+
+	if (g->valid && g->gi == gi && g->px == px && g->face == face) {
+		vita_text_stats.atlas_hits++;
+		return g;
+	}
+	f = face_at(face, px);
+	if (f == NULL || FT_Load_Glyph(f, gi, FT_LOAD_RENDER) != 0)
+		return NULL;
+	bm = &f->glyph->bitmap;
+	g->valid = false;
+	g->gi = gi;
+	g->px = (uint16_t)px;
+	g->face = (uint8_t)face;
+	g->w = (uint16_t)bm->width;
+	g->h = (uint16_t)bm->rows;
+	g->left = (int16_t)f->glyph->bitmap_left;
+	g->top = (int16_t)f->glyph->bitmap_top;
+	g->page = 0;
+	g->x = g->y = 0;
+	if (bm->width > 0 && bm->rows > 0) {
+		if (!atlas_place((int)bm->width, (int)bm->rows, &page, &x, &y))
+			return NULL;
+		g->page = (uint8_t)page;
+		g->x = (uint16_t)x;
+		g->y = (uint16_t)y;
+		dst = vita2d_texture_get_datap(pages[page].tex);
+		stride = vita2d_texture_get_stride(pages[page].tex);
+		for (r = 0; r < (int)bm->rows; r++) {
+			const unsigned char *src = bm->buffer +
+				(bm->pitch >= 0 ? r * bm->pitch :
+				 ((int)bm->rows - 1 - r) * -bm->pitch);
+			unsigned char *row = dst + (y + r) * stride + x;
+			if (bm->pixel_mode == FT_PIXEL_MODE_MONO) {
+				for (c = 0; c < (int)bm->width; c++)
+					row[c] = (src[c >> 3] & (0x80 >> (c & 7))) ?
+						0xff : 0;
+			} else {
+				memcpy(row, src, bm->width);
+			}
+		}
+	}
+	vita_text_stats.rasterised++;
+	g->valid = true;
+	return g;
+}
+
+/* exported interface documented in vita/text.h */
+int vita_text_draw(const struct vita_text_style *style, int x, int y,
+		   const char *utf8, size_t len, unsigned int rgba)
+{
+	size_t i = 0;
+	int pen = x;
+
+	while (i < len) {
+		const struct adv_entry *e =
+			resolve(style, utf8_to_ucs4(utf8 + i, len - i));
+		const struct glyph_entry *g;
+
+		i = utf8_next(utf8, len, i);
+		if (e->cp >= 0x20 && e->cp != 0x20 && e->cp != 0xa0) {
+			g = glyph_get(e->face, e->gi, e->px);
+			if (g == NULL)
+				vita_text_stats.dropped++;
+			else if (g->w > 0 && g->h > 0)
+				vita2d_draw_texture_tint_part(
+					pages[g->page].tex,
+					(float)(pen + g->left),
+					(float)(y - g->top),
+					(float)g->x, (float)g->y,
+					(float)g->w, (float)g->h, rgba);
+		}
+		pen += e->adv;
+	}
+	return pen - x;
+}
+
+/* exported interface documented in vita/text.h */
+void vita_text_frame_begin(void)
+{
+	int i;
+
+	if (!flush_pending)
+		return;
+	/* The previous frame may still be reading the atlas. */
+	vita2d_wait_rendering_done();
+	for (i = 0; i < page_count; i++) {
+		memset(vita2d_texture_get_datap(pages[i].tex), 0,
+		       vita2d_texture_get_stride(pages[i].tex) * ATLAS_H);
+		pages[i].x = ATLAS_GAP;
+		pages[i].y = ATLAS_GAP;
+		pages[i].row_h = 0;
+	}
+	page_cur = 0;
+	memset(glyph_cache, 0, sizeof(glyph_cache));
+	flush_pending = false;
+	vita_text_stats.flushes++;
+}
+
+/* exported interface documented in vita/text.h */
+void vita_text_style_default(struct vita_text_style *style, int px)
+{
+	style->px = px;
+	style->family = VITA_FAMILY_SANS;
+	style->bold = false;
+	style->italic = false;
+}
+
+/* exported interface documented in vita/text.h */
+void vita_text_style_from_plot(const plot_font_style_t *fstyle,
+			       struct vita_text_style *style)
+{
+	/* Plot font sizes are points in PLOT_STYLE_SCALE fixed point; the
+	 * core runs at 96 dpi (vita/main.c), so px = pt * 96 / 72. */
+	int px = (int)((fstyle->size * 96 / 72 + PLOT_STYLE_SCALE / 2) /
+		       PLOT_STYLE_SCALE);
+
+	style->px = px < 1 ? 1 : px;
+	switch (fstyle->family) {
+	case PLOT_FONT_FAMILY_SERIF:
+		style->family = VITA_FAMILY_SERIF;
+		break;
+	case PLOT_FONT_FAMILY_MONOSPACE:
+		style->family = VITA_FAMILY_MONO;
+		break;
+	default:	/* sans-serif, cursive, fantasy */
+		style->family = VITA_FAMILY_SANS;
+		break;
+	}
+	style->bold = fstyle->weight >= 600;
+	style->italic = (fstyle->flags & (FONTF_ITALIC | FONTF_OBLIQUE)) != 0;
+}
+
+/* exported interface documented in vita/text.h */
+const char *vita_text_face_name(const struct vita_text_style *style,
+				uint32_t cp)
+{
+	const struct adv_entry *e = resolve(style, cp);
+
+	return e->gi != 0 ? face_files[e->face] : NULL;
+}
+
+/* exported interface documented in vita/text.h */
+nserror vita_text_init(const char *dir)
+{
+	memset(&vita_text_stats, 0, sizeof(vita_text_stats));
+	snprintf(font_dir, sizeof(font_dir), "%s", dir);
+	if (FT_Init_FreeType(&ft_lib) != 0)
+		return NSERROR_INIT_FAILED;
+	/* The primary face is required; the rest open when first needed. */
+	if (face_get(FACE_SANS) == NULL)
+		return NSERROR_INIT_FAILED;
+	return NSERROR_OK;
+}
+
+/* exported interface documented in vita/text.h */
+void vita_text_fini(void)
+{
+	int i;
+
+	for (i = 0; i < page_count; i++)
+		vita2d_free_texture(pages[i].tex);
+	page_count = page_cur = 0;
+	for (i = 0; i < FACE_COUNT; i++) {
+		if (faces[i].ft != NULL)
+			FT_Done_Face(faces[i].ft);
+		faces[i].ft = NULL;
+		faces[i].tried = false;
+		faces[i].px = 0;
+	}
+	memset(adv_cache, 0, sizeof(adv_cache));
+	memset(glyph_cache, 0, sizeof(glyph_cache));
+	FT_Done_FreeType(ft_lib);
+}
