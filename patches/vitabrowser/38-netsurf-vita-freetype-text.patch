+/**
+ * \file
+ * Vita frontend: text, rendered with FreeType.
+ *
+ * One engine measures (vita/layout.c) and draws (vita/plot.c), with the
+ * same faces at the same pixel size, so what layout measures is what is
+ * drawn. Glyphs are rasterised at the exact size they are drawn at and
+ * drawn unscaled from an 8-bit alpha atlas with a 1-pixel gap, so no
+ * neighbouring glyph can bleed in (the system PGF font's marks, hardware
+ * run 3). Code points the style's face lacks fall back through a chain:
+ * DejaVu (Latin, Greek, Cyrillic) -> DroidSansFallback (kana, CJK) ->
+ * NanumGothic (Hangul); see tools/fetch-fonts.sh in the VitaBrowser repo.
+ */
+
+#ifndef NETSURF_VITA_TEXT_H
+#define NETSURF_VITA_TEXT_H
+
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+
+#include "utils/errors.h"
+#include "netsurf/plot_style.h"
+
+/** Where the fonts are, inside the app bundle. */
+#define VITA_FONT_DIR "app0:/res/fonts/"
+
+/** Generic families, each with bold / italic faces. */
+enum vita_text_family {
+	VITA_FAMILY_SANS,
+	VITA_FAMILY_SERIF,
+	VITA_FAMILY_MONO
+};
+
+/** What text is set in. */
+struct vita_text_style {
+	int px;				/**< em size in pixels */
+	enum vita_text_family family;
+	bool bold;
+	bool italic;
+};
+
+/** Counters since start-up, for the diagnostics. */
+struct vita_text_stats {
+	unsigned int rasterised;	/**< glyphs rendered into the atlas */
+	unsigned int atlas_hits;	/**< glyph draws served from the atlas */
+	unsigned int atlas_pages;	/**< atlas textures allocated */
+	unsigned int flushes;		/**< atlas reset because it was full */
+	unsigned int dropped;		/**< glyphs not drawn: atlas full */
+	unsigned int missing;		/**< code points no face has */
+	unsigned int face_failures;	/**< font files that would not open */
+};
+extern struct vita_text_stats vita_text_stats;
+
+/**
+ * Start FreeType; faces open lazily from `dir` on first use.
+ * \return NSERROR_OK, or NSERROR_INIT_FAILED if FreeType or the primary
+ *         face (DejaVuSans) cannot be used
+ */
+nserror vita_text_init(const char *dir);
+
+/** Release faces, the atlas and FreeType. */
+void vita_text_fini(void);
+
+/** A text style from the core's plot font style (size in pt at 96 dpi). */
+void vita_text_style_from_plot(const plot_font_style_t *fstyle,
+			       struct vita_text_style *style);
+
+/** Regular sans-serif at `px` pixels (HUD, messages, replay). */
+void vita_text_style_default(struct vita_text_style *style, int px);
+
+/** Advance of one code point, in whole pixels, as drawn. */
+int vita_text_advance(const struct vita_text_style *style, uint32_t cp);
+
+/** Width of `len` bytes of UTF-8, as drawn: the sum of the advances. */
+int vita_text_width(const struct vita_text_style *style, const char *utf8,
+		    size_t len);
+
+/** The primary face's ascent and descent (both >= 0) at this size. */
+void vita_text_extents(const struct vita_text_style *style, int *ascent,
+		       int *descent);
+
+/**
+ * Draw `len` bytes of UTF-8 with the baseline at y, in vita2d RGBA8.
+ * Call between vita2d_start_drawing() and vita2d_end_drawing().
+ * \return the advance, as vita_text_width() would give it
+ */
+int vita_text_draw(const struct vita_text_style *style, int x, int y,
+		   const char *utf8, size_t len, unsigned int rgba);
+
+/** Call at the start of a frame: resets the atlas if it filled up. */
+void vita_text_frame_begin(void);
+
+/**
+ * Which font a code point is drawn with (diagnostics and tests).
+ * \return the font file name, or NULL if no face has it
+ */
+const char *vita_text_face_name(const struct vita_text_style *style,
+				uint32_t cp);
+
+#endif
