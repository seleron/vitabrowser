+/* Patch 380: a structural pseudo-class as the argument of a functional
+ * one -- open is the '(' -- bounded by the OUTER compound when the
+ * function keeps its element (:not, :is, :where, :matches, :-webkit-any);
+ * else unbounded. The parser skips the parenthesised part. */
+static void html_rl_struct_outer_cp(const uint8_t *s, size_t len, size_t open,
+		struct html_rl_struct_cp *cp)
+{
+	static const char *const keep[] = {
+		"not", "is", "where", "matches", "-webkit-any", "-moz-any", NULL
+	};
+	size_t ne = open, ns = open, a, b;
+	int depth = 0, i;
+	bool ok = false;
+
+	while (ns > 0 && html_rl_struct_ident_ch(s[ns - 1]))
+		ns--;
+	if (ns == 0 || s[ns - 1] != ':' || ns == ne) {
+		cp->unbounded = true;
+		return;
+	}
+	for (i = 0; keep[i] != NULL && !ok; i++)
+		if (ne - ns == strlen(keep[i]) &&
+		    strncasecmp((const char *)s + ns, keep[i], ne - ns) == 0)
+			ok = true;
+	if (!ok) {
+		cp->unbounded = true;
+		return;
+	}
+	/* the outer compound: back from the ':' to a boundary, forward past
+	 * the matching ')' to one */
+	a = html_rl_struct_back(s, ns - 1);
+	for (b = open; b < len; b++) {
+		if (s[b] == '(')
+			depth++;
+		else if (s[b] == ')' && --depth == 0)
+			break;
+	}
+	if (b >= len) {
+		cp->unbounded = true;
+		return;
+	}
+	b++;
+	while (b < len && !html_rl_struct_boundary(s[b]))
+		b++;
+	html_rl_struct_parse_cp(s, a, b, cp);
+}
