+static void qjs_mark_dom_dirty_removal(JSContext *ctx, void *node,
+		void *next)
+{
+	struct content *content = qjs_get_content_for_ctx(ctx);
+	struct dom_document *doc = NULL;
+	bool in_doc = true;
+
+	if (content == NULL || node == NULL)
+		return;
+	if (dom_node_get_owner_document((dom_node *) node, &doc) ==
+			DOM_NO_ERR && doc != NULL) {
+		if ((void *) doc != node &&
+		    dom_node_contains((dom_node *) doc, (dom_node *) node,
+				&in_doc) != DOM_NO_ERR)
+			in_doc = true;
+		dom_node_unref(doc);
+	}
+	if (!in_doc)
+		return;
+	macos9_js_mark_dom_dirty_removal(content, node, next);
+}
