+/* Patch 380: the start of the compound that ends before s[a] -- back to a
+ * boundary, over balanced (...) groups of functional pseudo-classes
+ * (.x:not(.y):last-child is one compound: the plain backward scan stopped
+ * at its ')' and kept only :last-child, unbounded) */
+static size_t html_rl_struct_back(const uint8_t *s, size_t a)
+{
+	while (a > 0) {
+		uint8_t c = s[a - 1];
+		if (c == ')') {
+			int depth = 0;
+			size_t j = a - 1;
+			for (;;) {
+				if (s[j] == ')')
+					depth++;
+				else if (s[j] == '(' && --depth == 0)
+					break;
+				if (j == 0)
+					return a;	/* unbalanced: stop here */
+				j--;
+			}
+			a = j;	/* at the '(' -- go on past the name */
+			continue;
+		}
+		if (html_rl_struct_boundary(c))
+			break;
+		a--;
+	}
+	return a;
+}
