+
+/**
+ * \file
+ * Vita frontend: the diagnostics files, mirrored to a PC over UDP.
+ *
+ * Everything the frontend writes under ux0:data/VitaBrowser/ (log.txt,
+ * netsurf.log, the plot dumps, autotest.done) is also sent, as it is
+ * written, to a receiver on the LAN (tools/vita-netlog.py in the
+ * VitaBrowser repo), which rebuilds the same files on the PC. The manual
+ * copy from the Vita to the PC has cost results before (run 2's stale FTP
+ * copies; runs 4 and 5 never reached the results folder); this removes
+ * the copy.
+ *
+ * Datagrams are one text header line, then payload bytes:
+ *
+ *   VBL1 <boot> <seq> <type> <name> <offset> <length>\n<payload>
+ *
+ *   boot    8 hex digits, new each launch: one receiver folder per boot
+ *   seq     packet number from 0, so the receiver can count losses
+ *   type    H hello (payload: who we are), D data at <offset> of <name>,
+ *           E end of <name>: <offset> is its total length and the payload
+ *           its CRC-32 in 8 hex digits, B bye (clean exit)
+ *
+ * Until a receiver answers ("VBL1 ACK <boot>\n" to the sender's port)
+ * everything is broadcast, so no address needs configuring; after the
+ * answer it is sent to the receiver alone (unicast Wi-Fi frames are
+ * retried by the radio; broadcast ones are not). The hello is repeated
+ * every few seconds until then, so the receiver may start late.
+ *
+ * ux0:data/VitaBrowser/netlog.cfg, if present, overrides the target:
+ * "off", or "a.b.c.d" / "a.b.c.d:port" to send there from the start.
+ *
+ * Sending never blocks the frontend for long: sockets are non-blocking, a
+ * full send buffer is retried for a few milliseconds and then the packet
+ * is dropped (and counted); other send errors are not retried, and after
+ * a run of failures sending pauses until a hello gets through again.
+ * Bursts are paced (a 2 ms pause per ~10 KB) so a receiver or an access
+ * point is not overrun. Losing the network loses only the mirror;
+ * the files on the memory card are written as before.
+ */
+
+#ifndef NETSURF_VITA_NETLOG_H
+#define NETSURF_VITA_NETLOG_H
+
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+
+/** The receiver's UDP port (tools/vita-netlog.py --port). */
+#define VITA_NETLOG_PORT 45100
+
+/** Largest payload per datagram: header + payload stay under one
+ * Ethernet/Wi-Fi MTU, so nothing is fragmented. */
+#define VITA_NETLOG_CHUNK 1200
+
+/** Counters for the log and the tests. */
+struct vita_netlog_stats {
+	unsigned int packets;		/**< datagrams sent */
+	unsigned long bytes;		/**< payload bytes sent */
+	unsigned int retries;		/**< sends retried: buffer full */
+	unsigned int dropped;		/**< datagrams given up on */
+	unsigned int hellos;		/**< hello datagrams sent */
+	unsigned int pauses;		/**< pacing pauses taken */
+	int last_errno;			/**< errno of the last failed send */
+};
+extern struct vita_netlog_stats vita_netlog_stats;
+
+/**
+ * Bring up the network (sceNet on the Vita) and the socket, read
+ * netlog.cfg, send the first hello. Never fatal.
+ * \param config  path of netlog.cfg
+ * \param hello   text for the hello payload (title id, build)
+ * \return a line for the log saying what happened; static storage
+ */
+const char *vita_netlog_init(const char *config, const char *hello);
+
+/** Whether packets are being sent at all (not off, socket open). */
+bool vita_netlog_active(void);
+
+/** The receiver's address once one has answered, else NULL. */
+const char *vita_netlog_receiver(void);
+
+/** Send `len` bytes of file `name` found at `offset`, in chunks. */
+void vita_netlog_data(const char *name, uint32_t offset, const void *data,
+		      size_t len);
+
+/** Mark file `name` complete at `total` bytes with CRC-32 `crc`. */
+void vita_netlog_end(const char *name, uint32_t total, uint32_t crc);
+
+/** Send a whole file from the card as `name`, then its end mark.
+ * \return false if it could not be read */
+bool vita_netlog_file(const char *name, const char *path);
+
+/**
+ * Check for the receiver's answer and repeat the hello if none yet.
+ * Call about once a second.
+ * \return a line for the log if the state changed, else NULL
+ */
+const char *vita_netlog_poll(void);
+
+/** Say goodbye and close. */
+void vita_netlog_fini(void);
+
+#endif
