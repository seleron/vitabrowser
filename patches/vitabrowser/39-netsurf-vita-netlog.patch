+/** Send what netsurf.log gained since the last call, up to `max` bytes. */
+static void engine_tail(size_t max)
+{
+	char buf[VITA_NETLOG_CHUNK];
+	size_t n, sent = 0;
+	FILE *fp;
+
+	if (!net_started || !vita_netlog_active() ||
+	    engine_sent >= ENGINE_NET_CAP)
+		return;
+	fp = fopen(VITA_DIAG_DIR "netsurf.log", "rb");
+	if (fp == NULL)
+		return;
+	if (fseek(fp, engine_start + (long)engine_sent, SEEK_SET) == 0) {
+		while (sent < max && engine_sent < ENGINE_NET_CAP &&
+		       (n = fread(buf, 1, sizeof(buf), fp)) > 0) {
+			vita_netlog_data("netsurf.log", engine_sent, buf, n);
+			engine_crc = (uint32_t)crc32(engine_crc,
+						     (const Bytef *)buf, (uInt)n);
+			engine_sent += (uint32_t)n;
+			sent += n;
+		}
+	}
+	fclose(fp);
+}
