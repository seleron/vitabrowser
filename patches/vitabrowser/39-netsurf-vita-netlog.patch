+/**
+ * \file
+ * Vita frontend: the diagnostics files, mirrored to a PC over UDP
+ * (protocol in vita/netlog.h).
+ *
+ * The sending side is plain BSD sockets, which vitaSDK's newlib provides
+ * on top of sceNet once sceNetInit() has run, so the host simulator runs
+ * this same code on Linux sockets. Only bringing the network up is
+ * Vita-specific.
+ */
+
+#include <errno.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/time.h>
+#include <unistd.h>
+#include <sys/socket.h>
+#include <netinet/in.h>
+#include <arpa/inet.h>
+#include <zlib.h>
+
+#ifdef __vita__
+#include <psp2/kernel/threadmgr.h>
+#include <psp2/sysmodule.h>
+#include <psp2/net/net.h>
+#include <psp2/net/netctl.h>
+#endif
+
+#include "vita/netlog.h"
+
+struct vita_netlog_stats vita_netlog_stats;
+
+/** Sends retried per datagram (1 ms apart), when the send buffer is
+ * full, before it is dropped. Other errors are not retried. */
+#define SEND_RETRIES 8
+/** Datagrams dropped in a row before sending pauses (network gone). */
+#define PAUSE_AFTER_DROPS 16
+/** Pacing: a pause of PACE_MS after every PACE_BURST datagrams (about
+ * 10 KB), so a burst -- netsurf.log's tail, a plot dump -- cannot overrun
+ * the receiver's socket buffer or the access point's queue. Sending 2 MB
+ * costs about 0.4 s of pauses in all. */
+#define PACE_BURST 8
+#define PACE_MS 2
+/** How often the hello is repeated until a receiver answers, and how
+ * often a paused mirror tries again. */
+#define HELLO_EVERY_MS 3000
+
+static int sock = -1;
+static struct sockaddr_in dest;
+static uint32_t boot_id;
+static uint32_t seq;
+static bool acked;
+static bool paused;
+static unsigned int drops_in_row;
+static unsigned int burst;
+static unsigned int last_hello_ms;
+static char hello_text[256];
+static char receiver[32];
+static char status[160];
+static struct timeval t0;
+
+#ifdef __vita__
+/** sceNet's working memory: it keeps socket buffers here. */
+static char net_pool[256 * 1024] __attribute__((aligned(64)));
+#endif
+
+static unsigned int now_ms(void)
+{
+	struct timeval t;
+
+	gettimeofday(&t, NULL);
+	return (unsigned int)((t.tv_sec - t0.tv_sec) * 1000 +
+			      (t.tv_usec - t0.tv_usec) / 1000);
+}
+
+static void sleep_ms(unsigned int ms)
+{
+#ifdef __vita__
+	sceKernelDelayThread(ms * 1000);
+#else
+	usleep(ms * 1000);
+#endif
+}
+
+/** A send that may succeed if retried: the socket buffer is full. The
+ * raw numbers are the BSD values sceNet uses (SCE_NET_EAGAIN 35,
+ * SCE_NET_ENOBUFS 55), in case newlib passes them through untranslated. */
+static bool transient(int e)
+{
+	return e == EAGAIN || e == EWOULDBLOCK || e == ENOBUFS ||
+	       e == 35 || e == 55;
+}
+
+/** One datagram. Never blocks for more than SEND_RETRIES ms. */
+static bool send_packet(char type, const char *name, uint32_t off,
+			const void *data, size_t len)
+{
+	char buf[VITA_NETLOG_CHUNK + 160];
+	int n, tries;
+
+	if (sock < 0 || paused)
+		return false;
+	n = snprintf(buf, sizeof(buf) - VITA_NETLOG_CHUNK,
+		     "VBL1 %08x %u %c %s %u %u\n", (unsigned int)boot_id,
+		     (unsigned int)seq, type, name, (unsigned int)off,
+		     (unsigned int)len);
+	if (n < 0 || (size_t)n >= sizeof(buf) - VITA_NETLOG_CHUNK ||
+	    len > VITA_NETLOG_CHUNK)
+		return false;
+	memcpy(buf + n, data, len);
+	/* The sequence number counts attempts, so a dropped datagram shows
+	 * up at the receiver as a gap. */
+	seq++;
+	for (tries = 0; tries <= SEND_RETRIES; tries++) {
+		ssize_t r = sendto(sock, buf, (size_t)n + len, MSG_DONTWAIT,
+				   (struct sockaddr *)&dest, sizeof(dest));
+		if (r == (ssize_t)((size_t)n + len)) {
+			vita_netlog_stats.packets++;
+			vita_netlog_stats.bytes += len;
+			drops_in_row = 0;
+			if (++burst >= PACE_BURST) {
+				burst = 0;
+				vita_netlog_stats.pauses++;
+				sleep_ms(PACE_MS);
+			}
+			return true;
+		}
+		vita_netlog_stats.last_errno = errno;
+		if (!transient(errno))
+			break;
+		if (tries < SEND_RETRIES) {
+			vita_netlog_stats.retries++;
+			sleep_ms(1);
+		}
+	}
+	vita_netlog_stats.dropped++;
+	if (++drops_in_row >= PAUSE_AFTER_DROPS) {
+		/* No network (or no route): stop trying per log line. poll()
+		 * tries a hello again every few seconds. */
+		paused = true;
+		snprintf(status, sizeof(status), "netlog: paused after %u "
+			 "failed sends in a row (errno %d)", drops_in_row,
+			 vita_netlog_stats.last_errno);
+	}
+	return false;
+}
+
+static void send_hello(void)
+{
+	last_hello_ms = now_ms();
+	if (send_packet('H', "hello", 0, hello_text, strlen(hello_text)))
+		vita_netlog_stats.hellos++;
+}
+
+/** netlog.cfg: "off", "a.b.c.d" or "a.b.c.d:port"; absent = broadcast. */
+static bool read_config(const char *path, bool *off)
+{
+	char line[64], *colon, *end;
+	FILE *fp = fopen(path, "r");
+	bool ok = true;
+
+	*off = false;
+	if (fp == NULL)
+		return true;
+	if (fgets(line, sizeof(line), fp) != NULL) {
+		line[strcspn(line, " \t\r\n")] = '\0';
+		if (strcmp(line, "off") == 0) {
+			*off = true;
+		} else if (line[0] != '\0') {
+			colon = strchr(line, ':');
+			if (colon != NULL) {
+				long port;
+				*colon = '\0';
+				port = strtol(colon + 1, &end, 10);
+				if (*end != '\0' || port <= 0 || port > 65535)
+					ok = false;
+				else
+					dest.sin_port = htons((uint16_t)port);
+			}
+			if (inet_pton(AF_INET, line, &dest.sin_addr) != 1)
+				ok = false;
+		}
+	}
+	fclose(fp);
+	return ok;
+}
+
+#ifdef __vita__
+/** sceNet up, once. \return 0 or the failing call's result */
+static int net_start(const char **what)
+{
+	SceNetInitParam p;
+	int r;
+
+	*what = "sceSysmoduleLoadModule(NET)";
+	if (sceSysmoduleIsLoaded(SCE_SYSMODULE_NET) != 0) {
+		r = sceSysmoduleLoadModule(SCE_SYSMODULE_NET);
+		if (r < 0)
+			return r;
+	}
+	*what = "sceNetInit";
+	p.memory = net_pool;
+	p.size = sizeof(net_pool);
+	p.flags = 0;
+	r = sceNetInit(&p);
+	/* Already initialised (by a plugin) is fine. */
+	if (r < 0 && r != (int)SCE_NET_ERROR_EBUSY)
+		return r;
+	*what = "sceNetCtlInit";
+	r = sceNetCtlInit();
+	/* 0x80412102: already initialised (VitaShell's
+	 * NET_CTL_ERROR_NOT_TERMINATED; vitaSDK has no name for it). */
+	if (r < 0 && (unsigned int)r != 0x80412102u)
+		return r;
+	return 0;
+}
+#endif
+
+/* exported interface documented in vita/netlog.h */
+const char *vita_netlog_init(const char *config, const char *hello)
+{
+	char ip[20] = "?";
+	bool off;
+	int on = 1;
+
+	gettimeofday(&t0, NULL);
+	memset(&vita_netlog_stats, 0, sizeof(vita_netlog_stats));
+	memset(&dest, 0, sizeof(dest));
+	dest.sin_family = AF_INET;
+	dest.sin_port = htons(VITA_NETLOG_PORT);
+	dest.sin_addr.s_addr = htonl(INADDR_BROADCAST);
+	/* Distinct per launch (the Vita's clock is set; so is the host's). */
+	boot_id = (uint32_t)t0.tv_sec * 2654435761u ^ (uint32_t)t0.tv_usec;
+	snprintf(hello_text, sizeof(hello_text), "%s", hello);
+
+	if (!read_config(config, &off)) {
+		snprintf(status, sizeof(status), "netlog: %s unreadable; "
+			 "expected off, a.b.c.d or a.b.c.d:port", config);
+		return status;
+	}
+	if (off) {
+		snprintf(status, sizeof(status), "netlog: off (%s)", config);
+		return status;
+	}
+#ifdef __vita__
+	{
+		const char *what;
+		SceNetCtlInfo info;
+		int r = net_start(&what);
+		if (r != 0) {
+			snprintf(status, sizeof(status), "netlog: %s -> 0x%08x;"
+				 " not sending", what, (unsigned int)r);
+			return status;
+		}
+		if (sceNetCtlInetGetInfo(SCE_NETCTL_INFO_GET_IP_ADDRESS,
+					 &info) >= 0)
+			snprintf(ip, sizeof(ip), "%s", info.ip_address);
+		else
+			snprintf(ip, sizeof(ip), "none (Wi-Fi off?)");
+	}
+#else
+	snprintf(ip, sizeof(ip), "host");
+#endif
+	sock = socket(AF_INET, SOCK_DGRAM, 0);
+	if (sock < 0) {
+		snprintf(status, sizeof(status), "netlog: socket -> errno %d;"
+			 " not sending", errno);
+		return status;
+	}
+	setsockopt(sock, SOL_SOCKET, SO_BROADCAST, &on, sizeof(on));
+	send_hello();
+	snprintf(status, sizeof(status), "netlog: boot %08x, our ip %s, "
+		 "sending to %s:%u (%s), hello %s", (unsigned int)boot_id, ip,
+		 inet_ntoa(dest.sin_addr), (unsigned int)ntohs(dest.sin_port),
+		 dest.sin_addr.s_addr == htonl(INADDR_BROADCAST) ?
+		 "broadcast until a receiver answers" : "netlog.cfg",
+		 vita_netlog_stats.hellos ? "sent" : "NOT sent");
+	return status;
+}
+
+/* exported interface documented in vita/netlog.h */
+bool vita_netlog_active(void)
+{
+	return sock >= 0 && !paused;
+}
+
+/* exported interface documented in vita/netlog.h */
+const char *vita_netlog_receiver(void)
+{
+	return acked ? receiver : NULL;
+}
+
+/* exported interface documented in vita/netlog.h */
+void vita_netlog_data(const char *name, uint32_t offset, const void *data,
+		      size_t len)
+{
+	const char *p = data;
+
+	while (len > 0 && vita_netlog_active()) {
+		size_t n = len < VITA_NETLOG_CHUNK ? len : VITA_NETLOG_CHUNK;
+		send_packet('D', name, offset, p, n);
+		p += n;
+		offset += (uint32_t)n;
+		len -= n;
+	}
+}
+
+/* exported interface documented in vita/netlog.h */
+void vita_netlog_end(const char *name, uint32_t total, uint32_t crc)
+{
+	char hex[12];
+
+	snprintf(hex, sizeof(hex), "%08x", (unsigned int)crc);
+	send_packet('E', name, total, hex, 8);
+}
+
+/* exported interface documented in vita/netlog.h */
+bool vita_netlog_file(const char *name, const char *path)
+{
+	char buf[VITA_NETLOG_CHUNK];
+	uint32_t off = 0;
+	uLong crc = crc32(0L, Z_NULL, 0);
+	size_t n;
+	FILE *fp;
+
+	if (!vita_netlog_active())
+		return true;
+	fp = fopen(path, "rb");
+	if (fp == NULL)
+		return false;
+	while ((n = fread(buf, 1, sizeof(buf), fp)) > 0) {
+		vita_netlog_data(name, off, buf, n);
+		crc = crc32(crc, (const Bytef *)buf, (uInt)n);
+		off += (uint32_t)n;
+	}
+	fclose(fp);
+	vita_netlog_end(name, off, (uint32_t)crc);
+	return true;
+}
+
+/* exported interface documented in vita/netlog.h */
+const char *vita_netlog_poll(void)
+{
+	char buf[64];
+	struct sockaddr_in from;
+	socklen_t fromlen;
+	ssize_t r;
+	unsigned int ack_boot;
+
+	if (sock < 0)
+		return NULL;
+	if (paused) {
+		if (now_ms() - last_hello_ms < HELLO_EVERY_MS)
+			return NULL;
+		paused = false;
+		last_hello_ms = now_ms();
+		if (!send_packet('H', "hello", 0, hello_text,
+				 strlen(hello_text))) {
+			paused = true;
+			return NULL;
+		}
+		vita_netlog_stats.hellos++;
+		drops_in_row = 0;
+		snprintf(status, sizeof(status), "netlog: sending again");
+		return status;
+	}
+	for (;;) {
+		fromlen = sizeof(from);
+		r = recvfrom(sock, buf, sizeof(buf) - 1, MSG_DONTWAIT,
+			     (struct sockaddr *)&from, &fromlen);
+		if (r <= 0)
+			break;
+		buf[r] = '\0';
+		if (acked || sscanf(buf, "VBL1 ACK %x", &ack_boot) != 1 ||
+		    ack_boot != boot_id)
+			continue;
+		/* From now on, to the receiver alone. */
+		dest = from;
+		acked = true;
+		snprintf(receiver, sizeof(receiver), "%s:%u",
+			 inet_ntoa(from.sin_addr),
+			 (unsigned int)ntohs(from.sin_port));
+		snprintf(status, sizeof(status), "netlog: receiver %s answered;"
+			 " unicast from now on", receiver);
+		return status;
+	}
+	if (!acked && now_ms() - last_hello_ms >= HELLO_EVERY_MS)
+		send_hello();
+	return paused ? status : NULL;
+}
+
+/* exported interface documented in vita/netlog.h */
+void vita_netlog_fini(void)
+{
+	if (sock < 0)
+		return;
+	paused = false;
+	send_packet('B', "bye", 0, "", 0);
+	close(sock);
+	sock = -1;
+}
