# netsurf: the diag.c noise filter gets a rate-capped allowance for the
# two full-rebuild triage lines (patch 391)
# Generated 2026-11-07
# Base: seleron/vitabrowser (patch stack through 389)
#
# Two lines that name what matters when a full rebuild goes wrong sat
# under diag.c's noise prefixes, so a rebuild storm was invisible in
# exactly the run it would have explained:
#
# - "LIFE reconvert: html_reconvert_content rc=" (macos9_reconvert.c)
#   is the one line naming every full rebuild's start (385 entry: it
#   hid fixes1135's class-drop from every log).
# - "LIFE objects relinked" (html.c, the relink's own line, 386 entry).
#
# The fix is in diag.c only: engine_is_noise checks a small allowance
# list before the noise list. Each allowed line is shown while its
# per-boot count is below the cap (32 -- a whole simulator autotest
# boot does ~20 full rebuilds, run 18's log had 18); the line that
# crosses the cap logs
#
#   MS diag: more '<prefix>' lines suppressed (showing the first 32,
#   this boot)
#
# once, and the rest are dropped. Per boot, like the engine log
# itself: the process is fresh on every boot, so the statics start at
# zero. "LIFE objects relinked" leaves the noise list (it is now
# allowed); the "LIFE reconvert" prefix stays, so the start/done/depth
# lines under it remain dropped as before. No engine change, no
# per-element JS objects, no scorecard.
#
diff -ruN a/frontends/vita/diag.c b/frontends/vita/diag.c
--- a/frontends/vita/diag.c
+++ b/frontends/vita/diag.c
@@ -831,13 +831,50 @@
 	"LIFE FLEXITEMCALL", "LIFE FBVAR", "LIFE FBBG", "svg_box", "img diag",
 	"LIFE imgdims", "LIFE img ctor", "LIFE obj fetch", "html_reformat",
 	"reformat: ", "reconvert: ", "box: convert_xml", "TALLOC-INFO",
-	"LIFE objects relinked", "LIFE VPORT", "LIFE reconvert"
+	"LIFE VPORT", "LIFE reconvert"
 };
 
+/* Patch 391 - a rate-capped allowance, not a prefix drop. The two lines
+ * that name what matters when a full rebuild goes wrong sat under the
+ * noise prefixes above: "LIFE reconvert: html_reconvert_content rc=" is
+ * the one line naming every full rebuild's start (385 entry), and
+ * "LIFE objects relinked" is the relink's own line (386 entry) -- so a
+ * rebuild storm was invisible in exactly the run it would have
+ * explained. Each is shown while the per-boot count is below the cap;
+ * the line that crosses it logs the cap once, and the rest are
+ * dropped. Per boot, like the log itself: the process is fresh on
+ * every boot, so the statics start at zero. The cap covers a whole
+ * simulator autotest boot (~20 full rebuilds in run 18's log) while
+ * bounding a runaway carousel on the device. */
+#define ENGINE_NOISE_ALLOW 32
+static const char *const engine_allow[] = {
+	"LIFE reconvert: html_reconvert_content rc=",
+	"LIFE objects relinked"
+};
+static unsigned long engine_allow_seen[
+	sizeof(engine_allow) / sizeof(engine_allow[0])];
+static bool engine_allow_capped[
+	sizeof(engine_allow) / sizeof(engine_allow[0])];
+
 static bool engine_is_noise(const char *s)
 {
 	size_t i;
 
+	for (i = 0; i < sizeof(engine_allow) / sizeof(engine_allow[0]); i++)
+		if (strncmp(s, engine_allow[i], strlen(engine_allow[i])) == 0) {
+			if (engine_allow_seen[i] < ENGINE_NOISE_ALLOW) {
+				engine_allow_seen[i]++;
+				return false;
+			}
+			if (!engine_allow_capped[i]) {
+				engine_allow_capped[i] = true;
+				fprintf(engine_log,
+					"MS diag: more '%s' lines suppressed "
+					"(showing the first %d, this boot)\n",
+					engine_allow[i], ENGINE_NOISE_ALLOW);
+			}
+			return true;
+		}
 	for (i = 0; i < sizeof(engine_noise) / sizeof(engine_noise[0]); i++)
 		if (strncmp(s, engine_noise[i], strlen(engine_noise[i])) == 0)
 			return true;
