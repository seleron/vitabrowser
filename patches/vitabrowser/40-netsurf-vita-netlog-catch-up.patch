diff --git a/frontends/vita/netlog.c b/frontends/vita/netlog.c
index 83cf354ed..8084d3ce4 100644
--- a/frontends/vita/netlog.c
+++ b/frontends/vita/netlog.c
@@ -309,6 +309,21 @@ const char *vita_netlog_receiver(void)
 	return acked ? receiver : NULL;
 }
 
+/* exported interface documented in vita/netlog.h */
+const char *vita_netlog_hud(void)
+{
+	static char hud[24];
+
+	if (sock < 0)
+		return "off";
+	if (paused)
+		return "no network";
+	if (!acked)
+		return "waiting for PC";
+	snprintf(hud, sizeof(hud), "%s", inet_ntoa(dest.sin_addr));
+	return hud;
+}
