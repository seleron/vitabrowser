 }
 
+/* Patch 404: the class argument of html_rl_flex_restyle when no class
+ * changed (a child-list change): its class-sibling check does not apply. */
+static const char html_rl_class_same[] = "";
+static int html_rl_flex_restyle(html_content *c, dom_node *el,
+		struct box *ob, double t0, const char *old_class,
+		bool is_block);
+
+/* Patch 404: a child-list change whose structural check found a rule that
+ * reaches the parent's children ("a structural rule matches a sibling":
+ * :first-child, :nth-child(), :last-of-type, ... -- the r114 census: 12 of
+ * 107 full rebuilds on the 21 sites, youtube 7). Such a rule reads only an
+ * element's siblings and parent, so what it can restyle is the parent's
+ * children and their descendants: the parent's subtree, rebuilt from the
+ * DOM by the container rebuild of patches 372/376 (its guards: controls,
+ * frames, counting, objects, normalisation), and the page laid out whole.
+ * Was: a full box-tree rebuild. :has() reaching up and :empty on the
+ * parent are checked apart (patches 193/198/373). A parent whose box is
+ * not a plain block (a table cell) keeps the full rebuild. */
+/* the decline line the census counts, when the subtree rebuild declined */
+static int html_rl_struct_declined(void)
+{
+	macsurf_debug_log_writef("LIFE rebuild local: declined (structural "
+		"selectors or counters in page CSS)");
+	return -1;
+}
+static int html_rl_struct_parent_rebuild(html_content *c, dom_node *pnode,
+		struct box *pbox, double t0)
+{
+	extern double macos9_micros(void);
+	static unsigned long struct_n;
+	if (pbox->type != BOX_BLOCK) {
+		macsurf_debug_log_writef("LIFE rebuild local: structural "
+			"change: the parent is not a plain block");
+		return -1;
+	}
+	if (html_rl_flex_restyle(c, pnode, pbox, t0, html_rl_class_same,
+			true) != 0)
+		return -1;
+	struct_n++;
+	macsurf_debug_log_writef("LIFE rebuild local: structural change: "
+		"the parent's subtree rebuilt in %ld us (%lu so far)",
+		(long)(macos9_micros() - t0), struct_n);
+	return 0;
+}
+
 static int html_rl_block_change(html_content *c, dom_node *pnode,
 		struct box *pbox, double t0)
 {
