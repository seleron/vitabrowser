  * Was: a full box-tree rebuild. :has() reaching up and :empty on the
  * parent are checked apart (patches 193/198/373). A parent whose box is
  * not a plain block (a table cell) keeps the full rebuild. */
+static int html_rl_struct_declined(void);
+/* Patch 405: the structural check names the children a rule matches;
+ * when each matching compound is bounded and no sibling combinator
+ * follows it, a flip restyles only those children (and their
+ * descendants: a descendant or child combinator after the compound). Each
+ * is rebuilt alone by the container rebuild, the parent and its other
+ * children left as they are -- youtube appends <iframe>s to a <body> that
+ * holds frames and controls, where 404's whole-parent rebuild declines,
+ * and only the old last child flips. A matching child with no box, or not
+ * a block-level box of the parent, declines into the full rebuild. */
+static int html_rl_struct_hits_restyle(html_content *c, struct box *pbox,
+		dom_node **hits, unsigned int n, double t0)
+{
+	static unsigned long hits_n;
+	unsigned int i;
+	for (i = 0; i < n; i++) {
+		struct box *hb = box_for_node(hits[i]);
+		if (hb == NULL || hb->parent != pbox ||
+		    (hb->type != BOX_BLOCK && hb->type != BOX_FLEX &&
+		     hb->type != BOX_GRID)) {
+			macsurf_debug_log_writef("LIFE rebuild local: "
+				"structural change: a matching sibling is not "
+				"a block-level box of the parent");
+			return -1;
+		}
+		if (html_rl_flex_restyle(c, hits[i], hb, t0,
+				html_rl_class_same, hb->type == BOX_BLOCK) != 0)
+			return -1;
+	}
+	hits_n++;
+	macsurf_debug_log_writef("LIFE rebuild local: structural change: %u "
+		"matching sibling%s restyled alone in %ld us (%lu so far)", n,
+		n == 1 ? "" : "s", (long)(macos9_micros() - t0), hits_n);
+	return 0;
+}
+static void html_rl_struct_hits_release(dom_node **hits, unsigned int *n)
+{
+	unsigned int i;
+	for (i = 0; i < *n; i++)
+		dom_node_unref(hits[i]);
+	*n = 0;
+}
+
+/* at a placement's success: the matching siblings, if any (patch 405) */
+static int html_rl_struct_hits_finish(html_content *c, struct box *pbox,
+		dom_node **hits, unsigned int *n, double t0)
+{
+	int r = 0;
+	if (*n > 0)
+		r = html_rl_struct_hits_restyle(c, pbox, hits, *n, t0);
+	html_rl_struct_hits_release(hits, n);
+	return r == 0 ? 0 : html_rl_struct_declined();
+}
