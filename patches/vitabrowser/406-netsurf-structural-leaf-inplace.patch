  * parent are checked apart (patches 193/198/373). A parent whose box is
  * not a plain block (a table cell) keeps the full rebuild. */
 static int html_rl_struct_declined(void);
+/* Patch 406: a matching child whose box has no children (an <iframe>,
+ * an <img>: youtube's flips are a bare :last-child on the previous
+ * <iframe>) is restyled where it is -- a new computed style on the same
+ * box, as html_reconvert_fast_style does, then the page laid out whole.
+ * Nothing is freed: a frame's box (never freed, patch 371) and its
+ * window stay. Declined -- into the full rebuild -- when the new style
+ * changes what construction decided (display, float, position), brings
+ * ::before/::after, or either style counts; a control, a clone, a box
+ * without element styles. */
+static bool html_rl_style_counts(const css_computed_style *st);
+/* would box construction make a ::before/::after box from this style?
+ * (box_construct_generate: never for a replaced element; else only when
+ * content is not normal and display is not none -- a universal
+ * *::before { box-sizing: ... } rule gives every element a pseudo style
+ * that generates nothing) */
+static bool html_rl_pseudo_generates(const struct box *box,
+		const css_computed_style *st)
+{
+	const css_computed_content_item *ci = NULL;
+	if (st == NULL || (box->flags & IS_REPLACED))
+		return false;
+	if (css_computed_content(st, &ci) == CSS_CONTENT_NORMAL)
+		return false;
+	if (css_computed_display(st, false) == CSS_DISPLAY_NONE)
+		return false;
+	return true;
+}
+static int html_rl_leaf_restyle(html_content *c, dom_node *node,
+		struct box *box, struct box *cssparent)
+{
+	css_select_results *ns;
+	css_custom_env *new_env = NULL, *use_parent_env = NULL;
+	const css_computed_style *use_parent = NULL, *use_root = NULL;
+	css_computed_style *st;
+	const char *why = NULL;
+
+	if (box->children != NULL || box->styles == NULL || box->style == NULL ||
+	    (box->flags & CLONE) || box->gadget != NULL || c->select_ctx == NULL ||
+	    box->type == BOX_CONTENTS)
+		why = "not a plain leaf box";
+	else if (html_rl_style_counts(box->style))
+		why = "it counts";
+	if (why != NULL) {
+		macsurf_debug_log_writef("LIFE rebuild local: leaf restyle "
+			"declined (%s)", why);
+		return -1;
+	}
+	nscss_reset_node_data(node);
+	/* the element's CSS parent: the block whose children changed, not
+	 * an anonymous line box between them */
+	if (cssparent != NULL && cssparent != c->layout) {
+		use_parent = cssparent->style;
+		use_parent_env = cssparent->custom_env;
+	}
+	use_root = c->layout->style;
+	ns = box_get_style(c, use_parent, use_root, node, use_parent_env,
+			&new_env);
+	if (ns == NULL || (st = ns->styles[CSS_PSEUDO_ELEMENT_NONE]) == NULL)
+		why = "no style";
+	else if (css_computed_display(st, false) !=
+		 css_computed_display(box->style, false) ||
+		 css_computed_float(st) != css_computed_float(box->style) ||
+		 css_computed_position(st) != css_computed_position(box->style))
+		why = "display, float or position changes";
+	else if (html_rl_pseudo_generates(box,
+			ns->styles[CSS_PSEUDO_ELEMENT_BEFORE]) ||
+		 html_rl_pseudo_generates(box,
+			ns->styles[CSS_PSEUDO_ELEMENT_AFTER]))
+		why = "generated content";
+	else if (html_rl_style_counts(st))
+		why = "it counts";
+	if (why != NULL) {
+		if (ns != NULL)
+			css_select_results_destroy(ns);
+		if (new_env != NULL)
+			css_custom_env_unref(new_env);
+		macsurf_debug_log_writef("LIFE rebuild local: leaf restyle "
+			"declined (%s)", why);
+		return -1;
+	}
+	if (box->custom_env != NULL)
+		css_custom_env_unref(box->custom_env);
+	box->custom_env = new_env;
+	css_select_results_destroy(box->styles);
+	box->styles = ns;
+	box->style = st;
+	return 0;
+}
