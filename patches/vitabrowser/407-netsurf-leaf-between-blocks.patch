+/* Patch 407: a leaf element -- replaced, or a form control -- that may be
+ * inserted between blocks: built alone, then given a line of its own. */
+static bool html_rl_leaf_tag(dom_node *n)
+{
+	static const char *const tags[] = {
+		"iframe", "img", "input", "textarea", "button", "select", NULL
+	};
+	dom_string *name = NULL;
+	bool found = false;
+	int i;
+
+	if (dom_node_get_node_name(n, &name) != DOM_NO_ERR || name == NULL)
+		return false;
+	for (i = 0; tags[i] != NULL && !found; i++)
+		if (dom_string_byte_length(name) == strlen(tags[i]) &&
+		    strncasecmp(dom_string_data(name), tags[i],
+				strlen(tags[i])) == 0)
+			found = true;
+	dom_string_unref(name);
+	return found;
+}
+
+/* Patch 407: the nearest sibling of n on one side that has a box is a
+ * block-level box directly in pbox (or there is none), and no text other
+ * than white space lies between -- such text would sit in a line the new
+ * element must join instead. */
+static bool html_rl_block_neighbour(dom_node *n, struct box *pbox,
+		bool forward)
+{
+	dom_node *s = n, *t;
+	bool ok = true;
+
+	dom_node_ref(s);
+	for (;;) {
+		dom_node_type type;
+		struct box *b;
+		t = NULL;
+		if ((forward ? dom_node_get_next_sibling(s, &t) :
+		     dom_node_get_previous_sibling(s, &t)) != DOM_NO_ERR ||
+		    t == NULL)
+			break;
+		dom_node_unref(s);
+		s = t;
+		if (dom_node_get_node_type(s, &type) != DOM_NO_ERR) {
+			ok = false;
+			break;
+		}
+		if (type == DOM_TEXT_NODE) {
+			if (!html_rl_text_is_space(s)) {
+				ok = false;
+				break;
+			}
+			continue;
+		}
+		if (type != DOM_ELEMENT_NODE)
+			continue;
+		b = box_for_node(s);
+		if (b == NULL)
+			continue;
+		ok = b->parent == pbox && b->type != BOX_INLINE_CONTAINER;
+		break;
+	}
+	dom_node_unref(s);
+	return ok;
+}
