# netsurf: pass CURLOPT_VERBOSE a long (content/fetchers/curl.c)
# Generated 2026-09-23
#
# curl_easy_setopt() takes a long for integer options; fetch_curl_register()
# passes the int literals 0 / 1 for CURLOPT_VERBOSE. Harmless where int and
# long have the same size and calling convention, but undefined in general,
# and libcurl >= 8.x's GCC type checks (curl/typecheck-gcc.h) turn it into
# "curl_easy_setopt expects a long argument" -- an error under -Werror, as
# in the Vita frontend's build with libcurl 8.22. Every other SETOPT in the
# file already passes longs (1L, 0L). Not Vita-specific; upstreamable.
# See docs/phase-0/10-hardware-test-plan.md §Run 8.

diff --git a/content/fetchers/curl.c b/content/fetchers/curl.c
index 4b03b8118..af71944d6 100644
--- a/content/fetchers/curl.c
+++ b/content/fetchers/curl.c
@@ -2047,9 +2047,9 @@ nserror fetch_curl_register(void)
 	SETOPT(CURLOPT_ERRORBUFFER, fetch_error_buffer);
 	SETOPT(CURLOPT_DEBUGFUNCTION, fetch_curl_debug);
 	if (nsoption_bool(suppress_curl_debug)) {
-		SETOPT(CURLOPT_VERBOSE, 0);
+		SETOPT(CURLOPT_VERBOSE, 0L);
 	} else {
-		SETOPT(CURLOPT_VERBOSE, 1);
+		SETOPT(CURLOPT_VERBOSE, 1L);
 	}
 
 	/* Currently we explode if curl uses HTTP2, so force 1.1. */
