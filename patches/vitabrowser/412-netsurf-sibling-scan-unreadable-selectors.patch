 /* Full sheet scan. 0 = none, 1 = precise (lefts filled), 2 = decline. */
+/* Patch 412: a selector prelude [a, b) the sibling parser could not read
+ * adds no sibling risk when its text holds no sibling combinator (a + or
+ * ~ outside [...] and strings; escapes skipped), no :empty and no :has(:
+ * patch 186's class check, 198's insert/remove check, 370/409's style
+ * check and 373's :empty check all read only those. (Was: one such
+ * selector made the whole sheet "conservative" -- state 2 -- and every
+ * block insert or removal on the page declined: cnnlite, rte, google,
+ * oldreddit.) A + inside parentheses (:nth-child(2n+1)) still counts. */
+static bool html_rl_prelude_sib_free(const uint8_t *s, size_t a, size_t b)
+{
+	size_t i;
+	int br = 0;
+	uint8_t q = 0;
+
+	for (i = a; i < b; i++) {
+		uint8_t ch = s[i];
+		if (q != 0) {
+			if (ch == '\\' && i + 1 < b)
+				i++;
+			else if (ch == q)
+				q = 0;
+			continue;
+		}
+		if (ch == '\\') {
+			i++;
+			continue;
+		}
+		if (ch == '"' || ch == '\'') {
+			q = ch;
+			continue;
+		}
+		if (br > 0) {
+			if (ch == ']')
+				br--;
+			continue;
+		}
+		if (ch == '[') {
+			br++;
+			continue;
+		}
+		if (ch == '+' || ch == '~')
+			return false;
+		if (ch == ':' && i + 1 < b) {
+			size_t j = i + 1;
+			if (s[j] == ':')
+				continue;
+			if (b - j >= 5 && strncasecmp((const char *)s + j,
+					"empty", 5) == 0)
+				return false;
+			if (b - j >= 4 && strncasecmp((const char *)s + j,
+					"has(", 4) == 0)
+				return false;
+		}
+	}
+	return q == 0 && br == 0;
+}
