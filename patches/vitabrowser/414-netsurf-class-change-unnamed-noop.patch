+/* Set while a style attribute change runs as a class change (370): its
+ * "old class" is the current one, and the change is not to the class. */
+static bool html_rl_style_as_class;
+
+/* 1 when the class change old_class -> (live class) on el restyles
+ * nothing: no added or removed token is named by any sheet. */
+static int html_rl_class_change_unnamed(html_content *c, dom_node *el,
+		const char *old_class, int *ntok)
+{
+	char *new_class = html_rl_sib_attr_value((dom_element *)el, "class",
+			NULL);
+	const char *nw = new_class != NULL ? new_class : "";
+	int r = html_rl_cls_diff_unnamed(c, old_class, nw, ntok) &&
+		html_rl_cls_diff_unnamed(c, nw, old_class, ntok) ? 1 : 0;
+	free(new_class);
+	return r;
+}
