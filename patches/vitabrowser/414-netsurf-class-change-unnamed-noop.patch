+/* Patch 414: a class change whose added and removed class names no
+ * stylesheet names cannot restyle anything -- a computed style depends
+ * on class only through selectors (box construction reads no class:
+ * the html.c reads are diagnostics and the load-time has-js class).
+ * Six of the census's seven "restyled block's parent is not a block"
+ * were class changes on <html> itself (cnnlite 2, archwiki, wikipedia,
+ * jquery, wpnews): a root with no parent box, a full rebuild, for
+ * tokens such as userconsent-cntry-ie that no selector names. */
+static uint32_t html_rl_cls_hash_step(uint32_t h, uint8_t ch)
+{
+	if (ch >= 'A' && ch <= 'Z')
+		ch = (uint8_t)(ch - 'A' + 'a');
+	return (h ^ ch) * 16777619u;
+}
+
+static bool html_rl_cls_hex(uint8_t ch)
+{
+	return (ch >= '0' && ch <= '9') || (ch >= 'a' && ch <= 'f') ||
+	       (ch >= 'A' && ch <= 'F');
+}
+
+/* Decode the identifier at st[*ip] (escapes resolved) into its hash.
+ * False if no identifier starts there. */
+static bool html_rl_cls_ident(const uint8_t *st, size_t len, size_t *ip,
+		uint32_t *out)
+{
+	size_t i = *ip;
+	uint32_t h = 2166136261u;
+	bool any = false;
+	while (i < len) {
+		uint8_t ch = st[i];
+		if (ch == '\\' && i + 1 < len && st[i + 1] != '\n') {
+			i++;
+			if (html_rl_cls_hex(st[i])) {
+				unsigned long cp = 0;
+				int nd = 0;
+				uint8_t u[4];
+				int nu, q;
+				while (i < len && nd < 6 &&
+				       html_rl_cls_hex(st[i])) {
+					uint8_t d = st[i];
+					cp = cp * 16 + (unsigned long)(
+						d <= '9' ? d - '0' :
+						(d | 0x20) - 'a' + 10);
+					i++;
+					nd++;
+				}
+				if (i < len && (st[i] == ' ' ||
+				    st[i] == '\t' || st[i] == '\n'))
+					i++;
+				if (cp == 0 || cp > 0x10FFFF)
+					cp = 0xFFFD;
+				if (cp < 0x80) {
+					u[0] = (uint8_t)cp;
+					nu = 1;
+				} else if (cp < 0x800) {
+					u[0] = (uint8_t)(0xC0 | (cp >> 6));
+					u[1] = (uint8_t)(0x80 | (cp & 0x3F));
+					nu = 2;
+				} else if (cp < 0x10000) {
+					u[0] = (uint8_t)(0xE0 | (cp >> 12));
+					u[1] = (uint8_t)(0x80 |
+						((cp >> 6) & 0x3F));
+					u[2] = (uint8_t)(0x80 | (cp & 0x3F));
+					nu = 3;
+				} else {
+					u[0] = (uint8_t)(0xF0 | (cp >> 18));
+					u[1] = (uint8_t)(0x80 |
+						((cp >> 12) & 0x3F));
+					u[2] = (uint8_t)(0x80 |
+						((cp >> 6) & 0x3F));
+					u[3] = (uint8_t)(0x80 | (cp & 0x3F));
+					nu = 4;
+				}
+				for (q = 0; q < nu; q++)
+					h = html_rl_cls_hash_step(h, u[q]);
+			} else {
+				h = html_rl_cls_hash_step(h, st[i]);
+				i++;
+			}
+			any = true;
+			continue;
+		}
+		if (!html_rl310_is_namech(ch))
+			break;
+		h = html_rl_cls_hash_step(h, ch);
+		any = true;
+		i++;
+	}
+	*ip = i;
+	*out = h;
+	return any;
+}
+
+static int html_rl_cls_cmp(const void *a, const void *b)
+{
+	uint32_t x = *(const uint32_t *)a, y = *(const uint32_t *)b;
+	return x < y ? -1 : x > y ? 1 : 0;
+}
+
+/* Build e's class-name set (cls_state 1), or mark it "any" (2). */
+static void html_rl_sheet_classes(struct html_rl_sib_sheet *e)
+{
+	const uint8_t *st = e->data;
+	size_t len = e->size, i = 0;
+	uint8_t quote = 0;
+	int cap = 0, n = 0, k, w;
+	uint32_t *v = NULL;
+	e->cls_state = 2;
+	while (i < len) {
+		uint8_t ch = st[i];
+		if (quote != 0) {
+			if (ch == '\\' && i + 1 < len)
+				i += 2;
+			else {
+				if (ch == quote || ch == '\n')
+					quote = 0;
+				i++;
+			}
+			continue;
+		}
+		if (ch == '/' && i + 1 < len && st[i + 1] == '*') {
+			for (i += 2; i + 1 < len &&
+			     !(st[i] == '*' && st[i + 1] == '/'); i++)
+				;
+			i += 2;
+			continue;
+		}
+		if (ch == '"' || ch == '\'') {
+			quote = ch;
+			i++;
+			continue;
+		}
+		if (ch == '\\') {
+			i += 2;
+			continue;
+		}
+		if (ch == '@') {
+			if (i + 7 <= len &&
+			    html_rl310_cieq(st + i + 1, "import", 6)) {
+				free(v);
+				return;		/* imported rules unseen */
+			}
+			i++;
+			continue;
+		}
+		if (ch == '[') {
+			size_t j = i + 1;
+			while (j < len && html_rl310_is_ws(st[j]))
+				j++;
+			if (j < len && st[j] == '*') {
+				if (j + 1 < len && st[j + 1] == '|')
+					j += 2;
+			} else {
+				size_t q = j;
+				while (q < len && html_rl310_is_namech(st[q]))
+					q++;
+				if (q > j && q < len && st[q] == '|' &&
+				    !(q + 1 < len && st[q + 1] == '='))
+					j = q + 1;
+			}
+			while (j < len && html_rl310_is_ws(st[j]))
+				j++;
+			if (j < len && (st[j] == '\\' ||
+			    (j + 5 <= len &&
+			     html_rl310_cieq(st + j, "class", 5) &&
+			     (j + 5 == len ||
+			      !html_rl310_is_namech(st[j + 5]))))) {
+				free(v);
+				return;		/* [class...] */
+			}
+			i++;
+			continue;
+		}
+		if (ch == '.') {
+			uint32_t h;
+			size_t j = i + 1;
+			if (html_rl_cls_ident(st, len, &j, &h)) {
+				if (n == cap) {
+					uint32_t *nv;
+					cap = cap ? cap * 2 : 256;
+					nv = realloc(v, (size_t)cap *
+							sizeof(*v));
+					if (nv == NULL) {
+						free(v);
+						return;
+					}
+					v = nv;
+				}
+				v[n++] = h;
+				i = j;
+				continue;
+			}
+			i++;
+			continue;
+		}
+		i++;
+	}
+	if (n > 1) {
+		qsort(v, (size_t)n, sizeof(*v), html_rl_cls_cmp);
+		for (k = 1, w = 1; k < n; k++)
+			if (v[k] != v[w - 1])
+				v[w++] = v[k];
+		n = w;
+	}
+	e->cls = v;
+	e->ncls = n;
+	e->cls_state = 1;
+}
+
+/* Is the class token tok[0..tl) one any used sheet may name? */
+static bool html_rl_class_named(html_content *c, const char *tok, size_t tl)
+{
+	unsigned int i;
+	uint32_t h = 2166136261u;
+	size_t q;
+	for (q = 0; q < tl; q++)
+		h = html_rl_cls_hash_step(h, (uint8_t)tok[q]);
+	for (i = 0; i < c->stylesheet_count; i++) {
+		struct html_rl_sib_sheet *e;
+		if (c->stylesheets[i].sheet == NULL ||
+		    c->stylesheets[i].unused)
+			continue;
+		e = html_rl_sib_sheet_for(c->stylesheets[i].sheet);
+		if (e == NULL)
+			return true;	/* unreadable: may name it */
+		if (e->cls_state == 0)
+			html_rl_sheet_classes(e);
+		if (e->cls_state != 1)
+			return true;
+		if (e->ncls > 0 && bsearch(&h, e->cls, (size_t)e->ncls,
+				sizeof(h), html_rl_cls_cmp) != NULL)
+			return true;
+	}
+	return false;
+}
+
+static bool html_rl_cls_ws(char ch)
+{
+	return ch == ' ' || ch == '\t' || ch == '\n' || ch == '\r' ||
+	       ch == '\f';
+}
+
+/* Is tok[0..tl) one of list's whitespace-separated tokens? */
+static bool html_rl_cls_has(const char *list, const char *tok, size_t tl)
+{
+	const char *p = list;
+	while (*p != '\0') {
+		const char *a;
+		while (html_rl_cls_ws(*p))
+			p++;
+		a = p;
+		while (*p != '\0' && !html_rl_cls_ws(*p))
+			p++;
+		if ((size_t)(p - a) == tl && tl > 0 &&
+		    memcmp(a, tok, tl) == 0)
+			return true;
+	}
+	return false;
+}
+
+/* True if every token in `from` that is missing from `to` is named by no
+ * sheet. *ntok counts those tokens. */
+static bool html_rl_cls_diff_unnamed(html_content *c, const char *from,
+		const char *to, int *ntok)
+{
+	const char *p = from;
+	while (*p != '\0') {
+		const char *a;
+		while (html_rl_cls_ws(*p))
+			p++;
+		a = p;
+		while (*p != '\0' && !html_rl_cls_ws(*p))
+			p++;
+		if (p == a || html_rl_cls_has(to, a, (size_t)(p - a)))
+			continue;
+		(*ntok)++;
+		if (html_rl_class_named(c, a, (size_t)(p - a)))
+			return false;
+	}
+	return true;
+}
