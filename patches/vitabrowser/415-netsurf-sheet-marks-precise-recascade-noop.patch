# netsurf: a sheet mark no longer makes its batch coarse; a sheet change that re-cascades to the same styles rebuilds nothing (patch 415)
# Generated 2026-11-08
# Base: seleron/vitabrowser (patch stack through 414)
#
# The census's largest cause, "nonode" (about 30 in a 21-site run): a
# stylesheet arrived or changed after first layout (CSS-in-JS, per-module
# CSS, late <link>s), its nodeless mark made the batch coarse -- dropping
# every precise mark in it -- and the whole document was rebuilt.
#
# Measured first (scratch build only, doc 10): at every full rebuild on
# the 21 scorecard sites, the whole document was re-cascaded against the
# current sheets and compared with the styles the boxes held. Of 21 sheet
# batches whose sheets had settled, 19 changed NO element's computed
# style and two (claude) only layout properties; none changed box
# structure. 14 more flushed while a sheet was still loading.
#
#  - css.c: the multi-sheet settle window's mark goes through a new
#    macos9_js_mark_dom_dirty_sheets, so every sheet mark is known.
#  - macos9_reconvert.c: a sheet mark sets the slot's `sheets` flag
#    instead of making it coarse (multi stays set, so the single-mark fast
#    paths never take it); a sheet-only slot adopts the first node mark
#    as its primary. try_local answers the precise marks as always, then
#    calls html_rl_sheet_batch_noop; its decline is fullcause reason 5,
#    logged as the census's "nonode" with the sheet census (316/318/321)
#    as before.
#  - html.c, html_rl_sheet_batch_noop: settled sheets, no detached sheet
#    to prune, then every element of the document re-cascaded with a
#    fresh selection context; the first element whose own, ::before or
#    ::after style differs from its box's (or a box-less element that
#    would get a box: construction's tag skips -- style, title, meta,
#    link, base, head -- and input type=hidden mirrored; children of
#    replaced boxes and select/textarea gadgets not walked) declines. On
#    success the fresh context replaces c->select_ctx and the page is
#    redrawn (a new @font-face is looked up at paint).
#
--- a/content/handlers/html/html.c	2026-11-08 11:59:47.336929638 +0000
+++ b/content/handlers/html/html.c	2026-11-08 12:45:36.816799356 +0000
@@ -8666,6 +8666,302 @@
 	return 0;
 }
 
+/* ---- a sheet change that restyles nothing (patch 415) ----------------
+ *
+ * The census's largest cause is the coarse "nonode" batch: a stylesheet
+ * arrived or changed after first layout (CSS-in-JS, google's per-module
+ * CSS, late <link>s) and the whole document was rebuilt. A dry run
+ * (scratch build, every full rebuild on the 21 scorecard sites)
+ * re-cascaded the whole document at each such batch: of 21 batches whose
+ * sheets had settled, 19 changed NO element's computed style -- the new
+ * rules match nothing built yet -- and the other two (claude) changed only
+ * layout properties. Answered here: when the sheets have settled and a
+ * fresh selection context gives every element the style its box already
+ * holds, and gives no box-less element a box, nothing is rebuilt.
+ *
+ * What the walk mirrors from box construction (box_construct.c):
+ *  - an element's own style, ::before and ::after are all compared (a
+ *    pseudo style that generates nothing, old and new, is ignored);
+ *  - a box-less element is fine when its new display is none, or when
+ *    construction gives it no box by tag (style, title, meta, link, base,
+ *    head) or type (input type=hidden); otherwise it would get a box:
+ *    declined;
+ *  - the children of a replaced box (svg, img, object, iframe) and of a
+ *    select or textarea gadget are not converted, so not walked.
+ * The first difference stops the walk (declined: the full rebuild, as
+ * before). On success the fresh context replaces c->select_ctx -- the
+ * one html_css_refresh_selection_context made at the settle should be
+ * the same, this makes sure -- and the page is redrawn: a new @font-face
+ * is looked up at paint (html_macsurf_font_face_url). */
+static bool html_rl_sheets_settled(html_content *c)
+{
+	unsigned int i;
+	for (i = 0; i != c->stylesheet_count; i++) {
+		if (c->stylesheets[i].modified)
+			return false;
+		if (c->stylesheets[i].sheet != NULL &&
+		    content_get_status(c->stylesheets[i].sheet) !=
+				CONTENT_STATUS_DONE)
+			return false;
+	}
+	return true;
+}
+
+/* NULL when the two selections give the box the same styles */
+static const char *html_rl_noop_diff(struct box *box,
+		const css_select_results *o, const css_select_results *nw)
+{
+	int k;
+	if (o->styles[CSS_PSEUDO_ELEMENT_NONE] == NULL ||
+	    nw->styles[CSS_PSEUDO_ELEMENT_NONE] == NULL)
+		return "no style";
+	if (css_computed_style_diff(o->styles[CSS_PSEUDO_ELEMENT_NONE],
+			nw->styles[CSS_PSEUDO_ELEMENT_NONE]) !=
+			CSS_COMPUTED_STYLE_NO_DIFF)
+		return "an element's style changes";
+	for (k = CSS_PSEUDO_ELEMENT_BEFORE; k <= CSS_PSEUDO_ELEMENT_AFTER;
+			k++) {
+		const css_computed_style *pa = o->styles[k], *pb = nw->styles[k];
+		bool ga = html_rl_pseudo_generates(box, pa);
+		bool gb = html_rl_pseudo_generates(box, pb);
+		if (ga != gb)
+			return "a ::before or ::after appears or goes";
+		if (ga && css_computed_style_diff(pa, pb) !=
+				CSS_COMPUTED_STYLE_NO_DIFF)
+			return "a ::before or ::after changes";
+	}
+	return NULL;
+}
+
+/* construction gives this box-less element no box whatever its display */
+static bool html_rl_noop_never_boxed(dom_node *n)
+{
+	dom_string *nm = NULL, *ty = NULL;
+	bool r = false;
+	if (dom_node_get_node_name(n, &nm) != DOM_NO_ERR || nm == NULL)
+		return false;
+	if (dom_string_caseless_lwc_isequal(nm, corestring_lwc_style) ||
+	    dom_string_caseless_lwc_isequal(nm, corestring_lwc_title) ||
+	    dom_string_caseless_lwc_isequal(nm, corestring_lwc_meta) ||
+	    dom_string_caseless_lwc_isequal(nm, corestring_lwc_link) ||
+	    dom_string_caseless_lwc_isequal(nm, corestring_lwc_base) ||
+	    dom_string_caseless_lwc_isequal(nm, corestring_lwc_head)) {
+		r = true;
+	} else if (dom_string_caseless_lwc_isequal(nm, corestring_lwc_input) &&
+		   dom_element_get_attribute(n, corestring_dom_type, &ty) ==
+				DOM_NO_ERR && ty != NULL) {
+		r = dom_string_caseless_lwc_isequal(ty, corestring_lwc_hidden);
+		dom_string_unref(ty);
+	}
+	dom_string_unref(nm);
+	return r;
+}
+
+struct html_rl_noop_frame {
+	dom_node *n;
+	const css_computed_style *ps;
+	css_custom_env *pe;
+};
+
+int html_rl_sheet_batch_noop(struct content *base_c);
+int html_rl_sheet_batch_noop(struct content *base_c)
+{
+	extern double macos9_micros(void);
+	html_content *c = (html_content *)base_c;
+	css_select_ctx *ctx = NULL;
+	struct html_rl_noop_frame *st = NULL;
+	css_select_results **keep = NULL;
+	css_custom_env **envs = NULL;
+	int nst = 0, cst = 0, nkeep = 0, ckeep = 0, nel = 0, k;
+	const css_computed_style *root_new = NULL;
+	dom_node *root = NULL;
+	const char *why = NULL;
+	char tag[48];
+	double t0;
+	static unsigned long noop_n;
+
+	tag[0] = '\0';
+	if (c == NULL || c->document == NULL || c->layout == NULL ||
+	    c->select_ctx == NULL || c->aborted)
+		return -1;
+	if (c->reflowing || c->box_conversion_context != NULL ||
+	    macsurf_reconvert_in_progress != 0 || macos9_paint_gw != NULL ||
+	    base_c->locked)
+		why = "busy";
+	else if (base_c->status != CONTENT_STATUS_READY &&
+		 base_c->status != CONTENT_STATUS_DONE)
+		why = "not loaded";
+	else if (!html_rl_sheets_settled(c))
+		why = "a sheet is still loading or changing";
+	else if (html_css_prune_detached_sheets(c) > 0)	/* unit 387 */
+		why = "detached stylesheet pruned";
+	if (why != NULL) {
+		macsurf_debug_log_writef("LIFE rebuild local: sheet change: "
+			"declined (%s)", why);
+		return -1;
+	}
+	t0 = macos9_micros();
+	if (html_css_new_selection_context(c, &ctx) != NSERROR_OK ||
+	    ctx == NULL ||
+	    dom_document_get_document_element(c->document, &root) !=
+			DOM_NO_ERR || root == NULL) {
+		why = "no selection context";
+		goto out;
+	}
+	cst = 64;
+	ckeep = 256;
+	st = malloc(sizeof(*st) * cst);
+	keep = malloc(sizeof(*keep) * ckeep);
+	envs = malloc(sizeof(*envs) * ckeep);
+	if (st == NULL || keep == NULL || envs == NULL) {
+		dom_node_unref(root);
+		why = "no memory";
+		goto out;
+	}
+	st[nst].n = root;	/* the reference moves into the stack */
+	st[nst].ps = NULL;
+	st[nst].pe = NULL;
+	nst++;
+	while (nst > 0 && why == NULL) {
+		struct html_rl_noop_frame f = st[--nst];
+		css_select_results *ns;
+		css_custom_env *env = NULL;
+		struct box *box;
+		dom_node *ch = NULL;
+		dom_node_type type;
+		bool walk = true;
+
+		if (dom_node_get_node_type(f.n, &type) != DOM_NO_ERR ||
+		    type != DOM_ELEMENT_NODE) {
+			dom_node_unref(f.n);
+			continue;
+		}
+		nel++;
+		ns = box_get_style_with_select_ctx(c, ctx, f.ps,
+				f.n == root ? NULL : root_new, f.n, f.pe, &env);
+		if (ns == NULL || ns->styles[CSS_PSEUDO_ELEMENT_NONE] == NULL) {
+			if (ns != NULL)
+				css_select_results_destroy(ns);
+			if (env != NULL)
+				css_custom_env_unref(env);
+			why = "no style";
+		} else {
+			/* kept until the end: children inherit from it */
+			if (nkeep == ckeep) {
+				css_select_results **a;
+				css_custom_env **b;
+				ckeep *= 2;
+				a = realloc(keep, sizeof(*keep) * ckeep);
+				if (a != NULL)
+					keep = a;
+				b = realloc(envs, sizeof(*envs) * ckeep);
+				if (b != NULL)
+					envs = b;
+				if (a == NULL || b == NULL) {
+					ckeep /= 2;
+					css_select_results_destroy(ns);
+					if (env != NULL)
+						css_custom_env_unref(env);
+					ns = NULL;
+					why = "no memory";
+				}
+			}
+			if (ns != NULL) {
+				keep[nkeep] = ns;
+				envs[nkeep] = env;
+				nkeep++;
+			}
+		}
+		if (why == NULL && f.n == root)
+			root_new = ns->styles[CSS_PSEUDO_ELEMENT_NONE];
+		box = why == NULL ? box_for_node(f.n) : NULL;
+		if (why != NULL) {
+			/* fall through to the tag below */
+		} else if (box == NULL) {
+			walk = false;
+			if (css_computed_display(
+					ns->styles[CSS_PSEUDO_ELEMENT_NONE],
+					f.n == root) != CSS_DISPLAY_NONE &&
+			    !html_rl_noop_never_boxed(f.n))
+				why = "an element without a box would get one";
+		} else if (box->styles == NULL) {
+			why = "a box without its own styles";
+		} else {
+			why = html_rl_noop_diff(box, box->styles, ns);
+			if (box->flags & IS_REPLACED || box->object != NULL ||
+			    (box->gadget != NULL &&
+			     (box->gadget->type == GADGET_SELECT ||
+			      box->gadget->type == GADGET_TEXTAREA)))
+				walk = false;
+		}
+		if (why != NULL) {
+			dom_string *nm = NULL;
+			if (dom_node_get_node_name(f.n, &nm) == DOM_NO_ERR &&
+			    nm != NULL) {
+				snprintf(tag, sizeof(tag), "%.*s",
+					(int)dom_string_byte_length(nm),
+					dom_string_data(nm));
+				dom_string_unref(nm);
+			}
+			dom_node_unref(f.n);
+			break;
+		}
+		if (walk && dom_node_get_first_child(f.n, &ch) == DOM_NO_ERR) {
+			while (ch != NULL) {
+				dom_node *nx = NULL;
+				if (nst == cst) {
+					struct html_rl_noop_frame *a;
+					cst *= 2;
+					a = realloc(st, sizeof(*st) * cst);
+					if (a == NULL) {
+						cst /= 2;
+						dom_node_unref(ch);
+						why = "no memory";
+						break;
+					}
+					st = a;
+				}
+				st[nst].n = ch;
+				st[nst].ps =
+					ns->styles[CSS_PSEUDO_ELEMENT_NONE];
+				st[nst].pe = env;
+				nst++;
+				dom_node_get_next_sibling(ch, &nx);
+				ch = nx;
+			}
+		}
+		dom_node_unref(f.n);
+	}
+out:
+	while (nst > 0)
+		dom_node_unref(st[--nst].n);
+	for (k = 0; k < nkeep; k++) {
+		css_select_results_destroy(keep[k]);
+		if (envs[k] != NULL)
+			css_custom_env_unref(envs[k]);
+	}
+	free(keep);
+	free(envs);
+	free(st);
+	if (why != NULL) {
+		if (ctx != NULL)
+			css_select_ctx_destroy(ctx);
+		macsurf_debug_log_writef("LIFE rebuild local: sheet change: "
+			"declined (%s%s%s) after %d elements in %ld us", why,
+			tag[0] ? ", " : "", tag, nel,
+			(long)(macos9_micros() - t0));
+		return -1;
+	}
+	css_select_ctx_destroy(c->select_ctx);
+	c->select_ctx = ctx;
+	html__redraw_a_box(c, c->layout);
+	noop_n++;
+	macsurf_debug_log_writef("LIFE rebuild local: sheet change restyles "
+		"nothing (%d elements re-cascaded in %ld us, %lu so far)", nel,
+		(long)(macos9_micros() - t0), noop_n);
+	return 0;
+}
