+/* Patch 416: libcss here parses :has() but never matches it (patch 328,
+ * selector_never_matches_part), and rejects it inside :not() (fixes360b).
+ * A selector of a prelude that holds :has( directly in a compound, or
+ * directly inside :not(, never applies: it is dropped before the sibling
+ * parser reads the prelude (inside a forgiving :is()/:where() list only
+ * that branch would drop, so those are left alone). google's
+ * ".mj3qce:has(.cDeo3)+.CHVz3d", rte's ":has(~ .blur-container ...)" and
+ * wpblog's ":not(.wp-block-cover:has(...+...))" made whole sheets
+ * conservative. 0: nothing dropped (read the prelude as it is); 1: *out
+ * (malloc'd, *outlen bytes, possibly 0 = nothing left) holds the kept
+ * selectors joined by commas; -1: no memory (read it as it is). */
+static int html_rl_prelude_drop_has(const uint8_t *s, size_t a, size_t b,
+		uint8_t **out, size_t *outlen)
+{
+	size_t i = a, part = a, o = 0;
+	int depth = 0, br = 0, dropped = 0;
+	uint8_t q = 0;
+	bool kill = false, not_fn[16];
+	uint8_t *buf = NULL;
+	memset(not_fn, 0, sizeof(not_fn));
+	for (;;) {
+		uint8_t ch = i < b ? s[i] : ',';
+		if (i < b && q != 0) {
+			if (ch == '\\' && i + 1 < b)
+				i++;
+			else if (ch == q)
+				q = 0;
+			i++;
+			continue;
+		}
+		if (i < b && ch == '\\') {
+			i += 2;
+			continue;
+		}
+		if (i < b && (ch == '"' || ch == '\'')) {
+			q = ch;
+			i++;
+			continue;
+		}
+		if (i < b && ch == '[') {
+			br++;
+			i++;
+			continue;
+		}
+		if (i < b && ch == ']') {
+			if (br > 0)
+				br--;
+			i++;
+			continue;
+		}
+		if (br > 0 && i < b) {
+			i++;
+			continue;
+		}
+		if (i < b && ch == ':' && !(i > a && s[i - 1] == ':') &&
+		    i + 5 <= b && strncasecmp((const char *)s + i + 1,
+				"has(", 4) == 0 &&
+		    (depth == 0 || (depth < 16 && not_fn[depth]))) {
+			kill = true;
+		}
+		if (i < b && ch == '(') {
+			depth++;
+			if (depth < 16)
+				not_fn[depth] = i >= a + 4 &&
+					strncasecmp((const char *)s + i - 4,
+						":not", 4) == 0;
+			i++;
+			continue;
+		}
+		if (i < b && ch == ')') {
+			if (depth > 0)
+				depth--;
+			i++;
+			continue;
+		}
+		/* the prelude's end always closes the last selector (its
+		 * parentheses may not balance) */
+		if (ch == ',' && (depth == 0 || i >= b)) {
+			if (kill) {
+				dropped++;
+			} else {
+				if (buf == NULL) {
+					buf = malloc(b - a + 1);
+					if (buf == NULL)
+						return -1;
+				}
+				size_t e = i < b ? i : b;
+				if (o > 0)
+					buf[o++] = ',';
+				if (e > part) {
+					memcpy(buf + o, s + part, e - part);
+					o += e - part;
+				}
+			}
+			kill = false;
+			if (i >= b)
+				break;
+			part = i + 1;
+		}
+		i++;
+	}
+	if (dropped == 0) {
+		free(buf);
+		return 0;
+	}
+	*out = buf;
+	*outlen = o;
+	return 1;
+}
