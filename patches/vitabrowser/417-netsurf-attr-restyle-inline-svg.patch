+/* Patch 417: an attribute a used sheet can select on (310 sent every one
+ * to the full rebuild through try_local's kind gate) is answered as 370
+ * answers a style attribute: the element and its subtree re-selected by
+ * the class-change paths, unless a sibling selector can match on the
+ * attribute (409's selector scan, for any name). The kind batches of the
+ * 21 sites were data-theme / data-*-theme on <html> (a root: still the
+ * full rebuild), aria-expanded, disabled, tabindex, title, href, eid, an
+ * ng-app-id on a <style>... An element box construction never gives a box
+ * (a <style>, <meta>, <link> ...) renders nothing. Not id: #id selectors
+ * are not found by the attribute scans. */
+int html_reconvert_local_attr_restyle(struct content *base_c, void *vnode,
+		const char *attr_name);
+int html_reconvert_local_attr_restyle(struct content *base_c, void *vnode,
+		const char *attr_name)
+{
+	html_content *c = (html_content *)base_c;
+	dom_string *cls = NULL;
+	char name[64], *cs;
+	size_t k;
+	int r;
+
+	if (c == NULL || vnode == NULL || attr_name == NULL ||
+	    attr_name[0] == '\0' || strlen(attr_name) >= sizeof(name) ||
+	    strcasecmp(attr_name, "id") == 0)
+		return -1;
+	for (k = 0; attr_name[k] != '\0'; k++)
+		name[k] = (char)tolower((unsigned char)attr_name[k]);
+	name[k] = '\0';
+	if (html_rl_attr_sibling_risk(c, name)) {
+		macsurf_debug_log_writef("LIFE rebuild local: declined (a "
+			"sibling selector can match on the %s attribute)", name);
+		return -1;
+	}
+	if (box_for_node((dom_node *)vnode) == NULL &&
+	    html_rl_noop_never_boxed((dom_node *)vnode)) {
+		macsurf_debug_log_writef("LIFE rebuild local: %s attribute on "
+			"an element that renders nothing", name);
+		return 0;
+	}
+	if (dom_element_get_attribute((dom_node *)vnode, corestring_dom_class,
+			&cls) != DOM_NO_ERR)
+		return -1;
+	cs = cls != NULL ? strndup(dom_string_data(cls),
+			dom_string_byte_length(cls)) : strdup("");
+	if (cls != NULL)
+		dom_string_unref(cls);
+	if (cs == NULL)
+		return -1;
+	macsurf_debug_log_writef("LIFE rebuild local: %s attribute change, "
+		"as a class change", name);
+	html_rl_style_as_class = true;	/* not a class change (414) */
+	r = html_reconvert_local_change(base_c, vnode, true, cs);
+	html_rl_style_as_class = false;
+	free(cs);
 	return r;
 }
 
