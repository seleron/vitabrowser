# netsurf: DOMParser's documentElement for an XML type is the markup's root element, not the <html> it is parsed into (patch 418)
# Generated 2026-11-08
# Base: seleron/vitabrowser (patch stack through 417)
#
# claude's five "new element is not a plain block" declines a load: its
# submit spinner, a <div> holding an <html> element holding an <svg>. The
# <html> was ours: fixes873's DOMParser parses into a detached <html>
# element (innerHTML) and returned that element as documentElement for
# every type, so parseFromString(svgText, 'image/svg+xml').documentElement
# -- which claude appends -- was an <html> wrapper, not the <svg>.
#
#  - parseFromString: for a type with no "html" in it, or with "xml" in it
#    (image/svg+xml, text/xml, application/xml, application/xhtml+xml),
#    documentElement is the parsed markup's first element. text/html keeps
#    the <html> root (body, querySelector unchanged).
#
# claude (scratch build): new-element declines 5 -> 1-2; its spinner
# inserts built locally as blocks holding an <svg> (417's replaced leaf).
#
--- a/content/handlers/javascript/quickjs/macsurf_qjs.c	2026-11-08 17:06:44.689942017 +0000
+++ b/content/handlers/javascript/quickjs/macsurf_qjs.c	2026-11-08 17:25:58.184453863 +0000
@@ -17129,7 +17129,20 @@
 				"querySelectorAll:function(){return [];},"
 				"getElementById:function(){return null;},"
 				"getElementsByTagName:function(){return [];}};"
-			"return {documentElement:root,body:root,head:null,nodeType:9,"
+			/* VitaBrowser patch 418: for an XML type (image/svg+xml,
+			 * text/xml, application/xml, application/xhtml+xml) the
+			 * document element is the markup's own root element -- the
+			 * <svg> -- not the <html> this parse wraps it in: claude
+			 * appended parseFromString(svg,'image/svg+xml')
+			 * .documentElement into its spinner, an <html> holding the
+			 * <svg> (every one a full rebuild: "new element is not a
+			 * plain block") */
+			"var de=root;"
+			"if(String(m==null?'':m).toLowerCase().indexOf('html')<0||"
+				"String(m).toLowerCase().indexOf('xml')>=0){"
+				"for(var c=root.firstChild;c;c=c.nextSibling)"
+					"if(c.nodeType===1){de=c;break;}}"
+			"return {documentElement:de,body:root,head:null,nodeType:9,"
 				"querySelector:function(x){"
 					"try{return root.querySelector?root.querySelector(x):null;}"
 					"catch(e){return null;}},"
