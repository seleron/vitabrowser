+#include <psp2/net/net.h>
+#include <psp2/net/netctl.h>
+#endif
+
+#include "vita/net.h"
+
+static bool started, up;
+static char status[160];
+
+#ifdef __vita__
+/** sceNet's working memory: socket buffers for every connection curl
+ * keeps open, plus the diagnostics mirror. 1 MiB, as VitaShell uses. */
+static char net_pool[1024 * 1024] __attribute__((aligned(64)));
+
+/** \return 0, or the failing call's result with *what naming it */
+static int net_init(const char **what)
+{
+	SceNetInitParam p;
+	int r;
+
+	*what = "sceSysmoduleLoadModule(NET)";
+	if (sceSysmoduleIsLoaded(SCE_SYSMODULE_NET) != 0) {
+		r = sceSysmoduleLoadModule(SCE_SYSMODULE_NET);
+		if (r < 0)
+			return r;
+	}
+	*what = "sceNetInit";
+	p.memory = net_pool;
+	p.size = sizeof(net_pool);
+	p.flags = 0;
+	r = sceNetInit(&p);
+	/* Already initialised (by a plugin) is fine. */
+	if (r < 0 && r != (int)SCE_NET_ERROR_EBUSY)
+		return r;
+	*what = "sceNetCtlInit";
+	r = sceNetCtlInit();
+	/* 0x80412102: already initialised (VitaShell's
+	 * NET_CTL_ERROR_NOT_TERMINATED; vitaSDK has no name for it). */
+	if (r < 0 && (unsigned int)r != 0x80412102u)
+		return r;
+	return 0;
+}
+#endif
+
+/* exported interface documented in vita/net.h */
+const char *vita_net_start(void)
+{
+	if (started)
+		return status;
+	started = true;
+#ifdef __vita__
+	{
+		const char *what;
+		int r = net_init(&what);
+		if (r != 0) {
+			snprintf(status, sizeof(status), "net: %s -> 0x%08x; no "
+				 "network this run", what, (unsigned int)r);
+			return status;
+		}
+	}
+#endif
+	up = true;
+	snprintf(status, sizeof(status), "net: up, ip %s", vita_net_ip());
+	return status;
+}
+
+/* exported interface documented in vita/net.h */
+bool vita_net_up(void)
+{
+	return up;
+}
+
+/* exported interface documented in vita/net.h */
+const char *vita_net_ip(void)
+{
+#ifdef __vita__
+	static char ip[24];
+	SceNetCtlInfo info;
+
+	if (!up)
+		return "none (sceNet down)";
+	if (sceNetCtlInetGetInfo(SCE_NETCTL_INFO_GET_IP_ADDRESS, &info) < 0)
+		return "none (Wi-Fi off or not connected)";
+	snprintf(ip, sizeof(ip), "%s", info.ip_address);
+	return ip;
+#else
+	return "host";
+#endif
+}
