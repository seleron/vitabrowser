+/* Patch 420: a list marker with an image (list-style-image): its object
+ * is not carried over by html_rl_relink_subtree, which walks children */
+static bool html_rl_marker_objects(struct box *b)
+{
+	for (; b != NULL; b = b->next) {
+		if (b->list_marker != NULL &&
+		    (b->list_marker->object != NULL ||
+		     b->list_marker->background != NULL))
+			return true;
+		if (html_rl_marker_objects(b->children))
+			return true;
+	}
+	return false;
+}
