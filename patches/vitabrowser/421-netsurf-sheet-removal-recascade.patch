# netsurf: a removed stylesheet whose loss changes no style no longer forces the full rebuild (patch 421)
# Generated 2026-11-08
# Base: seleron/vitabrowser (patch stack through 420)
#
# The census's "detached stylesheet pruned" (8 in r132): a <style> or
# <link> that left the DOM is pruned up front (unit 387) and the change
# that found it declined into the full reconvert. oldreddit's web
# components drop <style>s from their fragments as they render; bbc,
# google and mdn remove one each.
#
#  - html_reconvert_local_change: after a prune, 415's whole-document walk
#    (html_rl_doc_noop, "sheet removal") re-cascades the document with a
#    fresh context made without the dead sheets. When every element keeps
#    the style its box holds, nothing the sheets did is lost and the
#    change goes on locally; otherwise the decline stands (unit 388-390's
#    pages, whose removed sheets matter, keep it).
#  - html_rl_doc_noop: a prune no longer declines the walk itself -- its
#    fresh context already leaves the pruned sheets out.
#
# Sites (scratch build): oldreddit 1 and mdn 1 removal answered; the
# other five (oldreddit 3, bbc, google) do restyle and decline.
#
--- a/content/handlers/html/html.c	2026-11-08 21:25:28.016298732 +0000
+++ b/content/handlers/html/html.c	2026-11-08 21:45:18.480161926 +0000
@@ -8838,8 +8838,15 @@
 		why = "not loaded";
 	else if (!html_rl_sheets_settled(c))
 		why = "a sheet is still loading or changing";
-	else if (html_css_prune_detached_sheets(c) > 0)	/* unit 387 */
-		why = "detached stylesheet pruned";
+	else {
+		/* patch 421: a detached sheet is pruned first (unit 387);
+		 * the fresh context below is made without it, so the walk
+		 * sees what its going changes (was: declined) */
+		int pruned = html_css_prune_detached_sheets(c);
+		if (pruned > 0)
+			macsurf_debug_log_writef("LIFE rebuild local: %s: %d "
+				"detached sheet(s) pruned first", what, pruned);
+	}
 	if (why != NULL) {
 		macsurf_debug_log_writef("LIFE rebuild local: %s: "
 			"declined (%s)", what, why);
@@ -13433,7 +13440,12 @@
 	 * dead sheet. */
 	{
 		int pruned = html_css_prune_detached_sheets(c);
-		if (pruned > 0)
+		/* Patch 421: unless the whole document, re-cascaded without
+		 * the dead sheets, keeps the styles its boxes hold (415's
+		 * walk): then nothing the sheets did is lost, and the change
+		 * goes on locally (oldreddit's web components drop <style>s
+		 * from their fragments as they render) */
+		if (pruned > 0 && html_rl_doc_noop(c, "sheet removal") != 0)
 			RL_NO("detached stylesheet pruned");
 	}
 	/* Patch 371: frames on the page are no reason by themselves (it was
