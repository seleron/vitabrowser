# netsurf: a block given content that is more than plain inline is built again whole (patch 425)
# Generated 2026-11-09
# Base: seleron/vitabrowser (patch stack through 424)
#
# The census's top decline after 424, "new content is not plain inline
# elements" (10 in r137: bbc 4, wpblog 4, oldreddit, youtube). A probe
# (scratch only): bbc's <div> given an <img>, wpblog's <div> given an
# <iframe> and a <script>, oldreddit's custom elements (shreddit-app and
# its app-plugin-* children). The line rebuild (WS-C) takes plain inline
# content only.
#
#  - html_reconvert_local_change: such a block (a BOX_BLOCK that is the
#    element's own box) is built again whole through 376's path
#    (html_rl_flex_restyle): from the DOM, its objects carried over, the
#    page laid out whole. Its own declines stand -- wpblog's <iframe>
#    meets "holds controls or frames".
#
#  - css.c, html_css_prune_detached_sheets (387/389): a finished sheet
#    whose element left the DOM was released while c->select_ctx still
#    held it -- the refresh after the prune is skipped while another
#    sheet is in flight -- and the next rebuild selected through freed
#    memory (ASan autotest: SEGV in css__selector_hash_find on
#    NET-js-link-detach, its settled sheet removed while the slow one
#    loaded; reached once this patch's faster steps moved the timing).
#    It is taken out of the live context first, as the update path does.
#
# Sites (scratch build): bbc 11 blocks built whole (BATCHCAUSE 8 -> 4),
# oldreddit 1; "new content is not plain inline" 9 -> 0 on the three.
#
--- a/content/handlers/html/html.c	2026-11-09 04:12:15.989959294 +0000
+++ b/content/handlers/html/html.c	2026-11-09 06:22:48.979422961 +0000
@@ -13907,6 +13907,24 @@
 	if (block->type == BOX_TABLE_CELL ?
 	    !html_rl_subtree_tags(element, true) :
 	    !html_rl_inline_subtree(element)) {
+		/* Patch 425: a block whose new content is more than plain
+		 * inline -- bbc's <div> given an <img>, oldreddit's custom
+		 * elements -- is built again whole, as 376 builds a restyled
+		 * block (html_rl_flex_restyle): from the DOM, its objects
+		 * carried over, the page laid out whole; its own declines
+		 * (frames, stateful controls, counting, objects) stand --
+		 * wpblog's <iframe> keeps the full rebuild. */
+		if (block->type == BOX_BLOCK && block->node == element &&
+		    box_for_node(element) == block) {
+			int r;
+			macsurf_debug_log_writef("LIFE rebuild local: new "
+				"content is not plain inline, the block built "
+				"again whole");
+			r = html_rl_flex_restyle(c, element, block, t0,
+					html_rl_class_same, true);
+			dom_node_unref(element);
+			return r;
+		}
 		dom_node_unref(element);
 		RL_NO("new content is not plain inline elements");
 	}
--- a/content/handlers/html/css.c	2026-11-09 06:22:35.037965630 +0000
+++ b/content/handlers/html/css.c	2026-11-09 06:22:48.984700936 +0000
@@ -906,6 +906,21 @@
 		hsheet->unused = true;
 		if (hsheet->sheet != NULL) {
 			if (content_get_status(hsheet->sheet) == CONTENT_STATUS_DONE) {
+				/* VitaBrowser patch 425: out of the live
+				 * selection context first, as the update path
+				 * above does -- the refresh below is skipped
+				 * while another sheet is still loading, and the
+				 * context kept a sheet the release freed (ASan:
+				 * SEGV in css__selector_hash_find at the next
+				 * rebuild; NET-js-link-detach, its settled sheet
+				 * removed while its slow one was in flight) */
+				if (c->select_ctx != NULL) {
+					css_stylesheet *old =
+						nscss_get_stylesheet(hsheet->sheet);
+					if (old != NULL)
+						(void)css_select_ctx_remove_sheet(
+							c->select_ctx, old);
+				}
 				hlcache_handle_release(hsheet->sheet);
 				hsheet->sheet = NULL;
 			}
