+			c->layout->style, n, pb == c->layout ? NULL :
+			pb->custom_env, &env);
+	if (ns == NULL)
+		return false;
+	if (ns->styles[CSS_PSEUDO_ELEMENT_NONE] != NULL &&
+	    b->styles->styles[CSS_PSEUDO_ELEMENT_NONE] != NULL &&
+	    css_computed_style_diff(b->styles->styles[CSS_PSEUDO_ELEMENT_NONE],
+			ns->styles[CSS_PSEUDO_ELEMENT_NONE]) ==
+			CSS_COMPUTED_STYLE_NO_DIFF) {
+		same = true;
+		for (k = CSS_PSEUDO_ELEMENT_BEFORE;
+		     k <= CSS_PSEUDO_ELEMENT_AFTER && same; k++) {
+			const css_computed_style *pa = b->styles->styles[k];
+			const css_computed_style *pn = ns->styles[k];
+			if ((pa == NULL) != (pn == NULL))
+				same = false;
+			else if (pa != NULL && css_computed_style_diff(pa, pn) !=
+					CSS_COMPUTED_STYLE_NO_DIFF)
+				same = false;
+		}
+	}
+	css_select_results_destroy(ns);
+	if (env != NULL)
+		css_custom_env_unref(env);
+	return same;
+}
 
