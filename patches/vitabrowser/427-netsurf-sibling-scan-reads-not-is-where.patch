+/* Patch 427: each compound of a :not() / :is() / :where() argument in a
+ * left compound is a left compound of its own (nested ones too). */
+static bool html_rl_sib_lefts_add(struct html_rl_sib_compound **arr,
+		int *narr, const struct html_rl_sib_compound *cp)
+{
+	int i;
+	for (i = 0; i < cp->nsubs; i++)
+		if (!html_rl_sib_compound_append(arr, narr, &cp->subs[i]) ||
+		    !html_rl_sib_lefts_add(arr, narr, &cp->subs[i]))
+			return false;
+	return true;
+}
