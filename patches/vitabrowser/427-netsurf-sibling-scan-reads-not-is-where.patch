 /* Parse one compound. 0 ok, 2 conservative decline, -1 parse error. */
 static int html_rl_parse_compound(struct html_rl_sel_parser *p,
+		struct html_rl_sib_compound *cp);
+
+/* Patch 427: read a :not() / :is() / :where() argument at p->i (its '(')
+ * as a comma list into cp->subs, one compound a part (the last of a
+ * descendant / child chain). false (cp->subs left as it was, p unmoved)
+ * for anything else: a sibling combinator, :has(), an unreadable part --
+ * the pseudo is then the functional one 413 declines. */
+static bool html_rl_sel_args_read(struct html_rl_sel_parser *p,
+		struct html_rl_sib_compound *cp)
+{
+	struct html_rl_sel_parser sub;
+	struct html_rl_sib_compound *subs = NULL;
+	size_t j = p->i, depth = 0;
+	int n = 0, k;
+	bool ok = true;
+
+	while (j < p->len) {
+		uint8_t c = p->s[j];
+		if (c == '(')
+			depth++;
+		else if (c == ')') {
+			if (--depth == 0)
+				break;
+		} else if (c == '"' || c == '\'') {
+			uint8_t q = c;
+			j++;
+			while (j < p->len && p->s[j] != q && p->s[j] != '\n') {
+				if (p->s[j] == '\\')
+					j++;
+				j++;
+			}
+		} else if (c == '\\')
+			j++;
+		j++;
+	}
+	if (j >= p->len)
+		return false;
+	sub.s = p->s;
+	sub.len = j;
+	sub.i = p->i + 1;
+	for (;;) {
+		struct html_rl_sib_compound one, *ns;
+		html_rl_skip_ws(&sub);
+		if (sub.i >= j)
+			break;
+		/* A part may be a chain joined by descendant or child
+		 * combinators (wordpress.org's :is(.a .b .c) + x): its
+		 * ancestors are the right compound's too, so a change to one
+		 * rebuilds a subtree holding both; only its last compound --
+		 * the element itself -- is kept. A sibling combinator in it
+		 * is not read. */
+		for (;;) {
+			uint8_t c;
+			memset(&one, 0, sizeof(one));
+			if (html_rl_parse_compound(&sub, &one) != 0 ||
+			    one.has_func_pseudo || one.has_has ||
+			    one.has_pel) {
+				ok = false;
+				break;
+			}
+			html_rl_skip_ws(&sub);
+			if (sub.i >= j || sub.s[sub.i] == ',')
+				break;
+			c = sub.s[sub.i];
+			if (c == '+' || c == '~') {
+				ok = false;
+				break;
+			}
+			if (c == '>') {
+				sub.i++;
+				html_rl_skip_ws(&sub);
+			}
+			html_rl_sib_compound_free(&one);	/* an ancestor */
+		}
+		if (!ok) {
+			html_rl_sib_compound_free(&one);
+			break;
+		}
+		ns = realloc(subs, (size_t)(n + 1) * sizeof(*subs));
+		if (ns == NULL) {
+			html_rl_sib_compound_free(&one);
+			ok = false;
+			break;
+		}
+		subs = ns;
+		subs[n++] = one;	/* moved */
+		if (sub.i < j)
+			sub.i++;	/* the ',' */
+	}
+	if (!ok || n == 0) {
+		for (k = 0; k < n; k++)
+			html_rl_sib_compound_free(&subs[k]);
+		free(subs);
+		return false;
+	}
+	for (k = 0; k < n; k++) {
+		struct html_rl_sib_compound *ns = realloc(cp->subs,
+				(size_t)(cp->nsubs + 1) * sizeof(*ns));
+		if (ns == NULL) {
+			for (; k < n; k++)
+				html_rl_sib_compound_free(&subs[k]);
+			free(subs);
+			return false;	/* cp->subs freed with cp */
+		}
+		cp->subs = ns;
+		if (subs[k].has_empty)
+			cp->has_empty = true;	/* the :empty checks */
+		cp->subs[cp->nsubs++] = subs[k];	/* moved */
+	}
+	free(subs);
+	return true;
+}
