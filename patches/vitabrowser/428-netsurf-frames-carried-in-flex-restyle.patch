 #define HTML_RL_FRAME(b) ((b)->iframe != NULL || ((b)->flags & IFRAME) != 0)
 
+/* Patch 428: a subtree's frames go to its rebuilt boxes. Box construction
+ * gives each <iframe> box a record of its own (box_iframe prepends it to
+ * c->iframe); the old records point at boxes about to be freed, and each
+ * frame's window at its old box. The records made since `before` are the
+ * new tree's: an old box's window goes to the new box of its element (a
+ * window has the record's values, not the record), or to none, and the
+ * old box's records leave the list (talloc frees each). The layout that
+ * follows places the windows (layout.c, by box->iframe). */
+static unsigned int html_rl_frames_carry(html_content *c, struct box *b,
+		struct content_html_iframe *before)
+{
+	unsigned int n = 0;
+
+	for (; b != NULL; b = b->next) {
+		if ((b->iframe != NULL || (b->flags & IFRAME) != 0)) {
+			struct content_html_iframe *f, **pp;
+			struct box *nb = NULL;
+			for (f = c->iframe; f != NULL && f != before;
+			     f = f->next)
+				if (f->box != NULL && f->box != b &&
+				    f->box->node == b->node) {
+					nb = f->box;
+					break;
+				}
+			if (b->iframe != NULL) {
+				browser_window_iframe_rebox(b->iframe, nb);
+				if (nb != NULL)
+					nb->iframe = b->iframe;
+				b->iframe = NULL;
+			}
+			pp = &c->iframe;
+			while (*pp != NULL) {
+				f = *pp;
+				if (f->box == b) {
+					*pp = f->next;
+					talloc_free(f->name);	/* bctx's */
+					talloc_free(f);
+				} else
+					pp = &f->next;
+			}
+			b->flags &= ~IFRAME;
+			n++;
+		}
+		n += html_rl_frames_carry(c, b->children, before);
+	}
+	return n;
+}
+
+/* Patch 428: a local build that is given up -- its records go (their
+ * boxes are freed with the new tree); the old ones never left. */
+static void html_rl_frames_drop_new(html_content *c,
+		struct content_html_iframe *before)
+{
+	while (c->iframe != NULL && c->iframe != before) {
+		struct content_html_iframe *f = c->iframe;
+		c->iframe = f->next;
+		talloc_free(f->name);	/* bctx's */
+		talloc_free(f);
+	}
+}
