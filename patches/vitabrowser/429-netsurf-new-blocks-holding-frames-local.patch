+		"iframe",	/* patch 429 */
 		NULL
 	};
 	dom_string *name = NULL;
@@ -9835,6 +9840,8 @@
 		struct box *nb, *after = NULL, *flt, *aftel;
 		dom_node *sib = NULL, *prevsib = NULL;
 		unsigned int objects_before = c->num_objects;
