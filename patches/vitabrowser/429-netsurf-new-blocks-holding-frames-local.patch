- * Not iframe/object/embed (frames and plugins), not fieldset (its legend
- * painter). */
+ * Not object/embed (plugins), not fieldset (its legend painter).
+ * Patch 429: iframes too -- the ad and embed slots cnnlite, guardian and
+ * rte insert between blocks (a <div> holding an <iframe>: the census's
+ * largest "new element is not a plain block"). A new frame box gets its
+ * record and its late load as in a full build (box_iframe, patch 244), as
+ * 378's appended and 407's inserted frames do; no old frame box is freed. */
 static bool html_rl_oc_tag(dom_node *n)
 {
 	static const char *const ok[] = {
 		"img", "input", "button", "select", "option", "optgroup",
