+ * along with this program.  If not, see <http://www.gnu.org/licenses/>.
+ */
+
+/**
+ * \file
+ * Vita frontend: the instrumentation hooks MacSurf's QuickJS expects (see
+ * vita/qjs_hooks.h).
+ */
+
+#include <stddef.h>
+#include <sys/time.h>
+#ifdef __vita__
+#include <psp2/kernel/processmgr.h>
+#endif
+
+#include "vita/qjs_hooks.h"
+
+long macsurf_qjs_ncalls;
+long macsurf_qjs_native_us;
+long macsurf_qjs_native_samp;
+static long gc_runs, gc_us;
+
+/* A monotonic microsecond clock. The name is MacSurf's: quickjs.c calls it
+ * around every 64th native call and around every collection. */
+double macos9_micros(void)
+{
+#ifdef __vita__
+	return (double)sceKernelGetProcessTimeWide();
+#else
+	struct timeval tv;
+
+	gettimeofday(&tv, NULL);
+	return (double)tv.tv_sec * 1e6 + (double)tv.tv_usec;
+#endif
+}
+
+void macsurf_qjs_gc_note(long us)
+{
+	gc_runs++;
+	if (us > 0)
+		gc_us += us;
+}
+
+void vita_qjs_stats_get(struct vita_qjs_stats *s)
+{
+	s->ncalls = macsurf_qjs_ncalls;
+	s->native_us = macsurf_qjs_native_us;
+	s->native_samples = macsurf_qjs_native_samp;
+	s->gc_runs = gc_runs;
+	s->gc_us = gc_us;
+}
