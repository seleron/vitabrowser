+/**
+ * \file
+ * Vita frontend: the instrumentation hooks MacSurf's QuickJS expects.
+ *
+ * MacSurf instrumented quickjs.c itself (fixes1071a/1078 and the GC note):
+ * every native call is counted, 1 in 64 is timed, and every collection is
+ * timed. The engine declares the counters and a microsecond clock extern;
+ * MacSurf defines them in its Mac OS 9 frontend (main.c's macos9_micros(),
+ * which returns 0 off the Mac, and the JS bridge). Until the bridge is
+ * ported, the Vita frontend defines them here, with a real clock, so the
+ * numbers mean something on the Vita and in the host test.
+ */
+
+#ifndef NETSURF_VITA_QJS_HOOKS_H
+#define NETSURF_VITA_QJS_HOOKS_H
+
+/** What the engine's instrumentation has counted since start-up. */
+struct vita_qjs_stats {
+	long ncalls;		/**< native (C) function calls */
+	long native_us;		/**< time in sampled native calls, us */
+	long native_samples;	/**< native calls sampled (1 in 64) */
+	long gc_runs;		/**< garbage collections */
+	long gc_us;		/**< time in them, us */
+};
+
+void vita_qjs_stats_get(struct vita_qjs_stats *s);
+
+/* The engine's side of the contract (quickjs.c declares these extern). */
+extern long macsurf_qjs_ncalls;
+extern long macsurf_qjs_native_us;
+extern long macsurf_qjs_native_samp;
+double macos9_micros(void);
+void macsurf_qjs_gc_note(long us);
+
+#endif
