+/**
+ * \file
+ * Vita frontend: QuickJS engine probe.
+ *
+ * The JavaScript engine the Vita build is to use (QuickJS-ng, as MacSurf
+ * ships it), exercised on its own, before any DOM binding exists: ES2023
+ * language features, promise jobs, Unicode regular expressions, and the
+ * two limits the design requires from the first hour (README §14.7) -- a
+ * hard memory cap and an interrupt handler that stops a runaway script
+ * without taking the runtime down. Plus a CPU benchmark.
+ *
+ * The same checks run in the host test (tools/test-quickjs.sh) and in the
+ * Vita autotest, so a device log says exactly which of them held there.
+ */
+
+#ifndef NETSURF_VITA_JSPROBE_H
+#define NETSURF_VITA_JSPROBE_H
+
+/** Where the probe reports: printf-like, one line per call, no newline. */
+typedef void (*vita_jsprobe_log_fn)(const char *fmt, ...)
+	__attribute__((format(printf, 1, 2)));
+
+/** Results of one probe run. */
+struct vita_jsprobe_result {
+	unsigned int checks;		/**< checks run */
+	unsigned int failed;		/**< checks that failed */
+	unsigned int fib_ms;		/**< fib(25) wall time */
+	unsigned int interrupt_ms;	/**< while(true){} until interrupted */
+	unsigned int oom_ms;		/**< allocating until the cap stopped it */
+};
+
+/**
+ * Run every check in a fresh runtime, logging each.
+ * \param log  where lines go
+ * \param res  filled in
+ */
+void vita_jsprobe_run(vita_jsprobe_log_fn log,
+		      struct vita_jsprobe_result *res);
+
+/** The memory cap the probe runs under, bytes. */
+#define VITA_JSPROBE_MEMORY_LIMIT (32 * 1024 * 1024)
+
+/** The runaway-script budget the probe's interrupt handler enforces, ms. */
+#define VITA_JSPROBE_BUDGET_MS 250
+
+#endif
