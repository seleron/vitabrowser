+
+/**
+ * \file
+ * Vita frontend: QuickJS engine probe (see vita/jsprobe.h).
+ */
+
+#include <stdbool.h>
+#include <stdio.h>
+#include <string.h>
+#include <sys/time.h>
+
+#include "quickjs.h"
+
+#include "vita/jsprobe.h"
+#include "vita/qjs_hooks.h"
+
+static unsigned int now_ms(void)
+{
+	struct timeval tv;
+
+	gettimeofday(&tv, NULL);
+	return (unsigned int)(tv.tv_sec * 1000 + tv.tv_usec / 1000);
+}
+
+/** The interrupt handler's deadline; 0 = no deadline. */
+static unsigned int deadline_ms;
+static unsigned int interrupts;
+
+/* QuickJS polls this every few thousand instructions; non-zero stops the
+ * script with an uncatchable InternalError ("interrupted"). */
+static int interrupt_handler(JSRuntime *rt, void *opaque)
+{
+	(void)rt;
+	(void)opaque;
+	if (deadline_ms != 0 && now_ms() >= deadline_ms) {
+		interrupts++;
+		return 1;
+	}
+	return 0;
+}
+
+/** Evaluate `src`; the result, or the exception, as a string in `out`.
+ * \return true if it completed without an exception */
+static bool eval_str(JSContext *ctx, const char *src, char *out, size_t len)
+{
+	JSValue v = JS_Eval(ctx, src, strlen(src), "<probe>",
+			    JS_EVAL_TYPE_GLOBAL);
+	bool ok = !JS_IsException(v);
+	const char *s;
+
+	if (!ok) {
+		JS_FreeValue(ctx, v);
+		v = JS_GetException(ctx);
+	}
+	s = JS_ToCString(ctx, v);
+	snprintf(out, len, "%s", s != NULL ? s : "(unprintable)");
+	if (s != NULL)
+		JS_FreeCString(ctx, s);
+	JS_FreeValue(ctx, v);
+	return ok;
+}
+
+/** Run the promise job queue dry. \return jobs run, or -1 on an error */
+static int run_jobs(JSRuntime *rt)
+{
+	JSContext *jctx;
+	int n = 0, r;
+
+	while ((r = JS_ExecutePendingJob(rt, &jctx)) > 0)
+		n++;
+	return r < 0 ? -1 : n;
+}
+
+/** A check: evaluate, compare with the expected string. */
+struct check {
+	const char *what;
+	const char *src;
+	const char *expect;
+};
+
+static const struct check language_checks[] = {
+	{ "class with private field and getter",
+	  "class A { #x = 41; get x() { return this.#x + 1; } }; new A().x",
+	  "42" },
+	{ "template literal, arrow, spread",
+	  "const f = (...a) => `${a.length}:${a.join('-')}`; f(...[1, 2, 3])",
+	  "3:1-2-3" },
+	{ "destructuring, default, rest",
+	  "const { a = 1, ...r } = { b: 2, c: 3 }; a + Object.keys(r).join('')",
+	  "1bc" },
+	{ "optional chaining, nullish coalescing",
+	  "const o = { p: null }; String(o.p?.q ?? 'dflt')",
+	  "dflt" },
+	{ "ES2022 at(), Object.hasOwn, ES2023 findLast, toSorted",
+	  "[[1,2,3].at(-1), Object.hasOwn({k:1}, 'k'),"
+	  " [1,2,3,4].findLast(x => x % 2), [3,1,2].toSorted().join('')].join()",
+	  "3,true,3,123" },
+	{ "BigInt",
+	  "(2n ** 64n).toString()",
+	  "18446744073709551616" },
+	{ "Map, Set, WeakMap, Symbol.iterator",
+	  "const m = new Map([[1,'a']]); const s = new Set([1,1,2]);"
+	  " new WeakMap(); [...m.values(), s.size].join()",
+	  "a,2" },
+	{ "Unicode property escape, case mapping (libregexp, libunicode)",
+	  "/\\p{Script=Greek}+/u.exec('abc \\u03b1\\u03b2\\u03b3')[0].length"
+	  " + ':' + '\\u00df'.toUpperCase()",
+	  "3:SS" },
+	{ "named groups, lookbehind",
+	  "'2026-09-23'.match(/(?<y>\\d{4})-(?<m>\\d\\d)/).groups.m"
+	  " + /(?<=\\$)\\d+/.exec('cost $42')[0]",
+	  "0942" },
+	{ "JSON round trip",
+	  "JSON.stringify(JSON.parse('{\"a\":[1,{\"b\":2}],\"c\":\"\\u00e9\"}'))",
+	  "{\"a\":[1,{\"b\":2}],\"c\":\"\xc3\xa9\"}" },
+	{ "Date arithmetic (UTC)",
+	  "new Date(Date.UTC(2026, 8, 23, 12)).toISOString()",
+	  "2026-09-23T12:00:00.000Z" },
+	{ "try/catch/finally, Error.cause",
+	  "let r = ''; try { throw new Error('x', { cause: 7 }); }"
+	  " catch (e) { r = e.cause; } finally { r += '!'; } r",
+	  "7!" },
+};
+
+void vita_jsprobe_run(vita_jsprobe_log_fn log,
+		      struct vita_jsprobe_result *res)
+{
+	JSRuntime *rt;
+	JSContext *ctx;
+	char out[256];
+	unsigned int i, t0;
+	bool ok;
+
+	memset(res, 0, sizeof(*res));
+	rt = JS_NewRuntime();
+	if (rt == NULL) {
+		log("js: JS_NewRuntime failed");
+		res->checks = res->failed = 1;
+		return;
+	}
+	/* The limits the browser will run pages under (README §14.7). */
+	JS_SetMemoryLimit(rt, VITA_JSPROBE_MEMORY_LIMIT);
+	JS_SetMaxStackSize(rt, 512 * 1024);
+	JS_SetInterruptHandler(rt, interrupt_handler, NULL);
+	ctx = JS_NewContext(rt);
+	if (ctx == NULL) {
+		log("js: JS_NewContext failed");
+		JS_FreeRuntime(rt);
+		res->checks = res->failed = 1;
+		return;
+	}
+	log("js: QuickJS-ng %s, memory cap %u MiB, script budget %u ms",
+	    JS_GetVersion(), VITA_JSPROBE_MEMORY_LIMIT >> 20,
+	    VITA_JSPROBE_BUDGET_MS);
+
+	for (i = 0; i < sizeof(language_checks) / sizeof(language_checks[0]);
+	     i++) {
+		const struct check *c = &language_checks[i];
+		char src[512];
+		/* A block of its own: top-level let / const would otherwise
+		 * persist into the next check. Its completion value is the
+		 * last expression's. */
+		snprintf(src, sizeof(src), "{ %s }", c->src);
+		ok = eval_str(ctx, src, out, sizeof(out)) &&
+		     strcmp(out, c->expect) == 0;
+		res->checks++;
+		if (!ok)
+			res->failed++;
+		log("js: %s %s%s%s", ok ? "ok  " : "FAIL", c->what,
+		    ok ? "" : " -> ", ok ? "" : out);
+	}
+
+	/* async / await: the job queue has to be run, as the browser's event
+	 * loop will. */
+	{
+		int jobs;
+		eval_str(ctx, "globalThis.r = 'pending';"
+			 " (async () => { await null; const v = await"
+			 " Promise.all([1, Promise.resolve(2)]);"
+			 " r = 'done ' + v.join('+'); })();", out, sizeof(out));
+		jobs = run_jobs(rt);
+		eval_str(ctx, "r", out, sizeof(out));
+		ok = jobs > 0 && strcmp(out, "done 1+2") == 0;
+		res->checks++;
+		if (!ok)
+			res->failed++;
+		log("js: %s async/await via the job queue (%d jobs) -> %s",
+		    ok ? "ok  " : "FAIL", jobs, out);
+	}
+
+	/* CPU: fib(25), 242785 calls. */
+	t0 = now_ms();
+	ok = eval_str(ctx, "function fib(n) { return n < 2 ? n :"
+		      " fib(n - 1) + fib(n - 2); } fib(25)", out, sizeof(out)) &&
+	     strcmp(out, "75025") == 0;
+	res->fib_ms = now_ms() - t0;
+	res->checks++;
+	if (!ok)
+		res->failed++;
+	log("js: %s fib(25) = %s in %u ms", ok ? "ok  " : "FAIL", out,
+	    res->fib_ms);
+
+	/* A runaway script is stopped by the interrupt handler, and the
+	 * runtime carries on. */
+	interrupts = 0;
+	t0 = now_ms();
+	deadline_ms = t0 + VITA_JSPROBE_BUDGET_MS;
+	ok = !eval_str(ctx, "for (;;) {}", out, sizeof(out));
+	res->interrupt_ms = now_ms() - t0;
+	deadline_ms = 0;
+	ok = ok && interrupts > 0 && strstr(out, "interrupted") != NULL &&
+	     res->interrupt_ms >= VITA_JSPROBE_BUDGET_MS &&
+	     res->interrupt_ms < VITA_JSPROBE_BUDGET_MS + 1000;
+	res->checks++;
+	if (!ok)
+		res->failed++;
+	log("js: %s while(true){} stopped after %u ms: %s",
+	    ok ? "ok  " : "FAIL", res->interrupt_ms, out);
+	ok = eval_str(ctx, "6 * 7", out, sizeof(out)) &&
+	     strcmp(out, "42") == 0;
+	res->checks++;
+	if (!ok)
+		res->failed++;
+	log("js: %s runtime usable after the interrupt", ok ? "ok  " : "FAIL");
+
+	/* Allocation past the cap fails inside the script, not in the
+	 * browser; the runtime survives and frees it all. */
+	t0 = now_ms();
+	ok = !eval_str(ctx, "let hog = []; for (;;) hog.push(new Array(65536)"
+		       ".fill(1.5));", out, sizeof(out));
+	res->oom_ms = now_ms() - t0;
+	ok = ok && strstr(out, "out of memory") != NULL;
+	res->checks++;
+	if (!ok)
+		res->failed++;
+	log("js: %s allocation stopped at the %u MiB cap after %u ms: %s",
+	    ok ? "ok  " : "FAIL", VITA_JSPROBE_MEMORY_LIMIT >> 20,
+	    res->oom_ms, out);
+	eval_str(ctx, "hog = null", out, sizeof(out));
+	JS_RunGC(rt);
+	ok = eval_str(ctx, "[...'abc'].reverse().join('')", out, sizeof(out)) &&
+	     strcmp(out, "cba") == 0;
+	res->checks++;
+	if (!ok)
+		res->failed++;
+	log("js: %s runtime usable after running out of memory",
+	    ok ? "ok  " : "FAIL");
+
+	JS_FreeContext(ctx);
+	JS_FreeRuntime(rt);
+	{
+		struct vita_qjs_stats st;
+		vita_qjs_stats_get(&st);
+		log("js: engine counters: %ld native calls (%ld sampled, %ld us"
+		    " in the samples), %ld collections in %ld us",
+		    st.ncalls, st.native_samples, st.native_us, st.gc_runs,
+		    st.gc_us);
+	}
+	log("js: %u/%u checks passed", res->checks - res->failed, res->checks);
+}
