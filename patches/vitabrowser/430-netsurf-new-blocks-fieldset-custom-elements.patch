# netsurf: a new block holding a fieldset or custom elements is built alone (patch 430)
# Generated 2026-11-09
# Base: seleron/vitabrowser (patch stack through 429)
#
# What was left of "new element is not a plain block" after 429 (9),
# logged in a scratch build with each block's rejected descendant tags:
#  - cnnlite 2, rte 2: a consent dialog (614 / 752 nodes) whose only
#    rejected tags are <fieldset> and <legend> -- patch 364 left fieldset
#    out for "its legend painter";
#  - google 1: a <div> holding <g-dropdown-menu>, <g-popup>, <g-menu>,
#    <g-menu-item>, <g-ripple> -- custom elements;
#  - youtube: <c3-icon> inserted straight into a flex box (another path),
#    a <div> holding a <video>.
#
# html_rl_oc_tag (364's tags a new block may hold; built alone, the page
# laid out whole) admits fieldset and legend: box construction flags them
# (VB_FIELDSET / VB_LEGEND, patches 222 / 228) and the legend's place and
# the border gap behind it are worked out from the boxes at layout and
# paint (vb_legend_margins, vb_fieldset_legend) -- nothing is kept that a
# local build could leave stale. And a custom element (a name with a '-',
# starting with a letter): box construction has no case for one, its
# page CSS decides its box as in a full build. <video>, and a custom
# element inserted into a flex box itself, still decline.
#
--- a/content/handlers/html/html.c	2026-11-09 14:33:06.032482379 +0000
+++ b/content/handlers/html/html.c	2026-11-09 14:51:43.877923046 +0000
@@ -6338,7 +6338,15 @@
 /* Patch 364: images and form controls a new block may hold. The block is
  * built alone (box_build_element fetches the image, the forms code makes
  * the control's gadget, as in a full build) and the page laid out whole.
- * Not object/embed (plugins), not fieldset (its legend painter).
+ * Not object/embed (plugins).
+ * Patch 430: <fieldset> and <legend> too -- the consent dialogs cnnlite
+ * and rte insert (614 and 752 nodes) hold one. Box construction flags them
+ * (VB_FIELDSET / VB_LEGEND, patches 222 and 228) and the legend's place
+ * and the border gap behind it are worked out from the boxes at layout
+ * and paint (vb_legend_margins, vb_fieldset_legend), nothing kept; the
+ * full layout that follows does it. And a custom element (a name with a
+ * '-': google's <g-dropdown-menu>, <g-menu-item>) -- box construction has
+ * no case for one; its page CSS decides its box, as in a full build.
  * Patch 429: iframes too -- the ad and embed slots cnnlite, guardian and
  * rte insert between blocks (a <div> holding an <iframe>: the census's
  * largest "new element is not a plain block"). A new frame box gets its
@@ -6351,6 +6359,7 @@
 		"textarea", "label", "form",
 		"svg",	/* patch 417: a replaced box, no object */
 		"iframe",	/* patch 429 */
+		"fieldset", "legend",	/* patch 430 */
 		NULL
 	};
 	dom_string *name = NULL;
@@ -6362,6 +6371,13 @@
 	for (i = 0; ok[i] != NULL && !found; i++)
 		if (strcasecmp(dom_string_data(name), ok[i]) == 0)
 			found = true;
+	/* patch 430: a custom element -- an HTML element whose name holds a
+	 * '-' (a valid custom element name starts with a letter) */
+	if (!found && dom_string_byte_length(name) > 1 &&
+	    isalpha((unsigned char)dom_string_data(name)[0]) &&
+	    memchr(dom_string_data(name), '-',
+		   dom_string_byte_length(name)) != NULL)
+		found = true;
 	dom_string_unref(name);
 	return found;
 }
