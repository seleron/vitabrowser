# netsurf: an inert attribute on a form control's box rebuilds nothing (patch 433)
# Generated 2026-11-09
# Base: seleron/vitabrowser (patch stack through 432)
#
# "nearest box is not a block" (9 in r145). Logged in a scratch build over
# two loads each of wpnews, wpblog, youtube and rte:
#  - wpnews 4, wpblog 3: an attribute mark on a <button> that is a flex
#    box -- wordpress.org's navigation buttons toggle aria-expanded. The
#    mark is set only for html_rl_attr_inert's attributes (no sheet can
#    match them: patch 310's gate), and patch 408 answers one on any box
#    with nothing to rebuild -- but not on a box holding a form control;
#  - wpnews 4: a child-list change inside an inline-block <button>;
#  - youtube 4: a change on flex <main> / <c-wiz> (no class, attribute or
#    child-list mark).
#
# 408's no-op admits a form control's box: html_rl_attr_inert's attributes
# (data-*, aria-*, role, tabindex, slot, inert...) are none that the forms
# code reads (value, name, type, checked, disabled...). Objects, frames and
# list markers stay excluded. The other two shapes are left.
#
# A single inert mark reaches this path only alone in its batch: several
# together are answered whole (patch 383's batch no-op). The gate page reads
# layout after each step so each is flushed alone (the gate's autotest runs
# timer steps back to back, as one batch).
#
--- a/content/handlers/html/html.c	2026-11-09 18:25:30.391751016 +0000
+++ b/content/handlers/html/html.c	2026-11-09 19:21:27.669557586 +0000
@@ -14122,11 +14122,18 @@
 			 * on it (wpblog's navigation <button>: aria-*). */
 			if (b != NULL && b->type != BOX_INLINE && n == vnode &&
 			    (dom_node *) vnode == html_rl_attr_mark_node &&
-			    b->object == NULL && b->gadget == NULL &&
+			    b->object == NULL &&
 			    !HTML_RL_FRAME(b) && b->list_marker == NULL) {
 				/* 383's no-op, on any box: no sheet can match
 				 * on the attribute (patch 310's gate), and
-				 * neither builder nor layout reads it */
+				 * neither builder nor layout reads it.
+				 * Patch 433: a form control's box too --
+				 * wordpress.org's navigation <button>s (flex
+				 * boxes) toggle aria-expanded: the mark is set
+				 * only for html_rl_attr_inert's attributes
+				 * (data-*, aria-*, role, tabindex...), none of
+				 * which the forms code reads (it reads value,
+				 * name, type, checked, disabled...) */
 				dom_node_unref(n);
 				macsurf_debug_log_writef("LIFE rebuild local: "
 					"attribute on a box that is not a block, "
