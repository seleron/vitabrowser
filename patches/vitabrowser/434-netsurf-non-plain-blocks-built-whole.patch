# netsurf: a block that is not one line of plain content is built again whole (patch 434)
# Generated 2026-11-09
# Base: seleron/vitabrowser (patch stack through 433)
#
# "block is not one line container of plain content" (7 in r145) declined
# any change inside a block whose content is not exactly one line container
# of plain inline content. Logged in a scratch build over two loads each:
#  - wpblog 8: a <code> block of 8 line containers (a normal build makes
#    one; earlier local rebuilds gave lines of their own);
#  - guardian 4: a display:block <button> (a control on the block's box);
#  - python 2: an <li> (a list marker).
#
# Such a plain block box (no object, no frame) is built again whole, as
# 422 does below a flex box: html_rl_flex_restyle(..., is_block = true)
# cascades it afresh from the DOM, hands controls over (382/423), carries
# objects and frames (375/428), lets layout number markers (420) and lays
# the page out whole; it still declines counting, controls it cannot
# rebuild, and a parent that is not a block. A change inside the block
# reaches outside only through :has(), which never matches here.
#
--- a/content/handlers/html/html.c	2026-11-09 20:23:52.801660571 +0000
+++ b/content/handlers/html/html.c	2026-11-09 20:42:52.933061189 +0000
@@ -14265,6 +14265,28 @@
 	    block->styles->styles[CSS_PSEUDO_ELEMENT_AFTER] != NULL ||
 	    old_ic == NULL || old_ic->next != NULL ||
 	    old_ic->type != BOX_INLINE_CONTAINER) {
+		/* Patch 434: a plain block box that is not one line of plain
+		 * content -- wpblog's <code> of several line containers,
+		 * guardian's display:block <button> (a control), python's
+		 * <li> (a list marker) -- is built again whole, as 422 does
+		 * below a flex box: cascaded afresh from the DOM, controls
+		 * handed over (382/423), objects and frames carried
+		 * (375/428), markers numbered at layout (420), the page laid
+		 * out whole. A change inside it reaches outside only through
+		 * :has(), which never matches here. html_rl_flex_restyle
+		 * declines what it cannot carry (counting, other controls,
+		 * a parent that is not a block). */
+		if (block->type == BOX_BLOCK && block->object == NULL &&
+		    !HTML_RL_FRAME(block) && block->styles != NULL) {
+			int r;
+			macsurf_debug_log_writef("LIFE rebuild local: a block "
+				"that is not one line of plain content, built "
+				"again whole");
+			r = html_rl_flex_restyle(c, element, block, t0,
+					html_rl_class_same, true);
+			dom_node_unref(element);
+			return r;
+		}
 		dom_node_unref(element);
 		RL_NO("block is not one line container of plain content");
 	}
