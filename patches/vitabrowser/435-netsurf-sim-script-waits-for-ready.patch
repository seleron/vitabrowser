# netsurf: the simulator's script can wait for the page's content to be ready (patch 435)
# Generated 2026-11-22
# Base: seleron/vitabrowser (patch stack through 434)
#
# The scorecard's script settled for a fixed 15 s, then ran its text eval.
# guardian becomes ready (its content current, READY) around 15.2 s, so
# some loads met the eval with no content ("sim eval: content missing"),
# text 0, score 36.8 instead of 62 (428). tools/vita-sim/vitasim.c gains a
# "ready MAX_MS" command: it waits until vitasim_page_ready() and ~1 s
# without a frame, or MAX_MS. This patch is the frontend's half:
# vitasim_page_ready() (VITA_HOST_SIM only) answers whether the window's
# content exists and is READY or DONE; vitasim_command records the window
# every main-loop pass. vitasim.c declares it weak, so a test program that
# links the harness without the frontend counts as always ready.
#
--- a/frontends/vita/main.c
+++ b/frontends/vita/main.c
@@ -1054,9 +1054,35 @@
  * "nav URL" and "eval FILE" (JavaScript run in the current page). */
 const char *vitasim_take_command(void);
 
+/* VitaBrowser patch 435: the window the script's commands act on, for
+ * vitasim_page_ready (set every main-loop pass by vitasim_command). */
+static struct browser_window *vitasim_bw;
+
+/* tools/vita-sim VITA_SIM_SCRIPT "ready": the page's content is current
+ * and converted (READY or DONE). Before that, browser_window_get_content
+ * answers NULL and an "eval" finds no content to run in (the scorecard's
+ * guardian, ready ~15.2 s into a 15 s settle, read text 0). */
+int vitasim_page_ready(void);
+int vitasim_page_ready(void)
+{
+	struct hlcache_handle *h;
+	content_status st;
+
+	if (vitasim_bw == NULL)
+		return 0;
+	h = browser_window_get_content(vitasim_bw);
+	if (h == NULL)
+		return 0;
+	st = content_get_status(h);
+	return st == CONTENT_STATUS_READY || st == CONTENT_STATUS_DONE;
+}
+
 static void vitasim_command(struct browser_window *bw)
 {
-	const char *cmd = vitasim_take_command();
+	const char *cmd;
+
+	vitasim_bw = bw;
+	cmd = vitasim_take_command();
 
 	if (cmd == NULL)
 		return;
