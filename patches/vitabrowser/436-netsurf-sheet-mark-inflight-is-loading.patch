# netsurf: a sheet mark counts a sheet in flight as loading (patch 436)
# Generated 2026-11-22
# Base: seleron/vitabrowser (patch stack through 435)
#
# html_css_mark_sheets (patch 318) gives a sheet mark one sheet's identity
# only when no other entry is still loading. It took CONTENT_STATUS_ERROR
# as settled, but content_get_status() answers ERROR for a handle whose
# content does not exist yet -- a fetch in flight (found in 432); a sheet
# that really failed has no handle left (the callback's ERROR case
# releases it and NULLs s->sheet). A mark could carry a single identity
# while another sheet was still to mark into the same window. Any status
# but DONE now counts as loading. An unused entry (pruned in flight, unit
# 389) is out of the cascade and is not waited for, as in 432's settle
# check. The identity feeds only the census lines (LIFE SHEETID /
# SHEETREACH); rebuilds are unchanged.
#
--- a/content/handlers/html/css.c
+++ b/content/handlers/html/css.c
@@ -88,9 +88,17 @@
 
 	for (j = 0; j != c->stylesheet_count; j++) {
 		struct html_stylesheet *s = &c->stylesheets[j];
-		bool loading = s->sheet != NULL &&
-			content_get_status(s->sheet) != CONTENT_STATUS_DONE &&
-			content_get_status(s->sheet) != CONTENT_STATUS_ERROR;
+		/* Patch 436: CONTENT_STATUS_ERROR is "still loading" too.
+		 * content_get_status() answers ERROR for a handle with no
+		 * content yet -- a fetch in flight (432) -- and a sheet that
+		 * really failed has no handle left (the callback's ERROR
+		 * case releases it and NULLs s->sheet). Taking ERROR as
+		 * settled let a mark carry a single identity while another
+		 * sheet was still to mark into the same window. An unused
+		 * entry (pruned in flight, unit 389) is out of the cascade:
+		 * it is not waited for, as in 432's settle check. */
+		bool loading = s->sheet != NULL && !s->unused &&
+			content_get_status(s->sheet) != CONTENT_STATUS_DONE;
 		if ((int)j == i || s->mark_pending || s->modified ||
 		    ((int)j != i && loading)) {
 			n++;
