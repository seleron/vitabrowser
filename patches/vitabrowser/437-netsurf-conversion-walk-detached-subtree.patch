+extern void macos9_js_mark_dom_dirty(struct content *c);
+#endif
+
+/**
+ * VitaBrowser patch 437: the walk met a node no longer in the document.
+ *
+ * The first conversion builds 100 nodes a slice; between slices the main
+ * loop runs the page's timers, and a script may remove the subtree the
+ * walk is inside. The walk then reads a node whose parent chain ends at a
+ * parentless node, with no box above it: no containing block, which was
+ * a NULL dereference (box_construct_element), an assert in
+ * box_construct_text, box_add_child's `parent` assert at an inline's
+ * close (guardian, 428) or next_node's `parent != NULL`. Where the walk
+ * should go on in the document is lost with the subtree, so it stops:
+ * convert_xml_to_box_inner completes the tree as it stands
+ * (box_construct_close_inlines) and asks for a full rebuild.
+ */
+static void box_construct_note_detached(struct box_construct_ctx *ctx,
+		const char *where)
+{
+	if (ctx->walk_detached)
+		return;
+	ctx->walk_detached = true;
+	macsurf_debug_log_writef("LIFE box: conversion walk left the "
+		"document (%s): the walk stops, a full rebuild follows", where);
+}
+
+/**
+ * Patch 437: give every inline box the walk opened but never closed its
+ * INLINE_END, at the end of the line it opened in, as
+ * box_construct_element_after would have (an inline with children it
+ * converted: CONVERT_CHILDREN), so the tree laid out until the rebuild is
+ * whole.
+ */
+static void box_construct_close_inlines(struct box_construct_ctx *ctx,
+		struct box *b)
+{
+	struct box *c;
+
+	for (c = b->children; c != NULL; c = c->next) {
+		bool kids = false;
+
+		if (c->type == BOX_INLINE && c->inline_end == NULL &&
+		    (c->flags & CONVERT_CHILDREN) && c->parent != NULL &&
+		    c->node != NULL &&
+		    dom_node_has_child_nodes(c->node, &kids) == DOM_NO_ERR &&
+		    kids) {
+			struct box *end = box_create(NULL, c->style, false,
+					c->href, c->target, c->title,
+					c->id == NULL ? NULL :
+					lwc_string_ref(c->id), ctx->bctx);
+			if (end != NULL) {
+				end->type = BOX_INLINE_END;
+				box_add_child(c->parent, end);
+				c->inline_end = end;
+				end->inline_end = c;
+			}
+		}
+		box_construct_close_inlines(ctx, c);
+	}
+}
