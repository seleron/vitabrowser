+/* Patch 438: a flex or grid box built again whole for a change in its own
+ * content -- boxed children in or out (408 declined them), text or
+ * innerHTML set on it (youtube's flex <main> / <c-wiz>) -- through 372's
+ * container rebuild: cascaded afresh from the DOM, controls handed over,
+ * objects and frames carried, the page laid out whole. What reaches
+ * outside the box is its own :empty, flipped by the change, which a
+ * + / ~ rule could see (373's check). */
+static int html_rl_flex_whole(html_content *c, dom_node *el, struct box *b,
+		double t0, const char *what)
+{
+	if ((b->children == NULL || html_rl_node_empty(el)) &&
+	    html_rl_empty_sibling_risk(c)) {
+		macsurf_debug_log_writef("LIFE rebuild local: declined (a "
+			"sibling rule tests :empty)");
+		return -1;
+	}
+	macsurf_debug_log_writef("LIFE rebuild local: %s, the box built again "
+		"whole", what);
+	return html_rl_flex_restyle(c, el, b, t0, html_rl_class_same, false);
+}
