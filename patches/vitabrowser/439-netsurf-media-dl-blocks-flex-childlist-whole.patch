# netsurf: new media and description-list blocks built alone; a flex child list the local path cannot place builds the box whole (patch 439)
# Generated 2026-11-22
# Base: seleron/vitabrowser (patch stack through 438)
#
# "new element is not a plain block, list item or block of blocks" (5.3 a
# load on 7 sites, 438's census) declined into the full rebuild. A scratch
# probe over two loads each named the elements:
#  - youtube 4: a <div> holding a <video> (and its <source>);
#  - wpblog 2: a <div> holding a <dl>;
#  - youtube 4: a <c3-icon> inserted into a flex box (408's flex
#    child-list mode: the placement declined before 438's rebuild ran).
#
# html_rl_oc_tag admits video, audio, source, track and picture: box
# construction has no case for them (no object), the page CSS decides
# their boxes, as in a full build; the new block is built alone and the
# page laid out whole, as for images (364). html_rl_list_tag admits dl, dt
# and dd: blocks, built alone and laid out whole as lists are (176). In
# 408's flex child-list mode every reason html_rl_block_change gives is
# about placing boxes among the box's children, which a whole rebuild makes
# afresh: the decline path builds the box again whole (html_rl_flex_whole,
# 438, which checks its own :empty), and RL_BNO logs those reasons as "not
# placed here", not as declines.
#
--- a/content/handlers/html/html.c
+++ b/content/handlers/html/html.c
@@ -6360,6 +6360,11 @@
 		"svg",	/* patch 417: a replaced box, no object */
 		"iframe",	/* patch 429 */
 		"fieldset", "legend",	/* patch 430 */
+		/* patch 439: media -- youtube inserts a <div> holding its
+		 * <video>; box construction has no case for these (no
+		 * object), the page CSS decides their boxes, as in a full
+		 * build */
+		"video", "audio", "source", "track", "picture",
 		NULL
 	};
 	dom_string *name = NULL;
@@ -6556,7 +6561,10 @@
 /* list items and lists (patch 176) */
 static bool html_rl_list_tag(dom_node *n)
 {
-	static const char *const ok[] = { "li", "ul", "ol", NULL };
+	/* patch 439: description lists too (wpblog inserts a <div> holding
+	 * a <dl>): blocks, as lists are, built alone and laid out whole */
+	static const char *const ok[] = { "li", "ul", "ol", "dl", "dt", "dd",
+		NULL };
 	dom_string *name = NULL;
 	bool found = false;
 	int i;
@@ -9365,8 +9373,12 @@
 	const char *why = NULL;
 	static unsigned long block_n;
 
-#define RL_BNO(w) do { macsurf_debug_log_writef( \
-		"LIFE rebuild local: declined (%s)", (w)); goto decline; } while (0)
+/* patch 439: in 408's flex child-list mode a reason here is not a decline:
+ * the box is built again whole (see decline:) */
+#define RL_BNO(w) do { macsurf_debug_log_writef(html_rl_noop_only ? \
+		"LIFE rebuild local: flex or grid child list not placed " \
+		"here (%s)" : "LIFE rebuild local: declined (%s)", (w)); \
+		goto decline; } while (0)
 
 	/* Patch 366: blocks in a table cell: the table lays the cell out
 	 * (its width, its row's height), so the page is laid out whole */
@@ -10168,6 +10180,15 @@
 		dom_node_unref(added[i]);
 	for (i = 0; i < nskip; i++)
 		dom_node_unref(skipped[i]);
+	/* Patch 439: a flex or grid box's own child list (408's mode) that
+	 * the placement here cannot answer -- youtube's <c3-icon> into its
+	 * flex box: "new element is not a plain block" -- builds the box
+	 * again whole, as boxed children do (438). Every reason here is
+	 * about placing boxes among its children, which that rebuild makes
+	 * afresh; its own :empty is html_rl_flex_whole's check. */
+	if (html_rl_noop_only)
+		return html_rl_flex_whole(c, pnode, pbox, t0, "a flex or grid "
+			"box's child list the local path declined");
 	return -1;
 #undef RL_BNO
 }
