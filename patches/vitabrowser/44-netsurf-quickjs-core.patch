# netsurf: QuickJS backend switch, live-content registry, reconvert CSS reset (core)
# Generated 2026-09-23
#
# The core half of running MacSurf's QuickJS DOM bridge (QuickJS step 2).
# - Makefile, Makefile.defaults: NETSURF_USE_QUICKJS (default NO), a
#   feature switch that defines WITH_QUICKJS.
# - javascript/Makefile: QuickJS selects content/handlers/javascript/quickjs
#   (patch 45) ahead of Duktape / none.
# - content.c, hlcache.c, html.c, script.c, object.c, box_construct.c:
#   MacSurf's live-content registry (register at creation, unregister at
#   destroy; is_live / generation tokens for callbacks that outlive a
#   content) and macos9_schedule_cancel_owner were compiled for __MACOS9__
#   only, the rest getting "always live" macros. With scripts, callbacks
#   do outlive contents, so they are now real under WITH_QUICKJS too.
#   Death row (deferred destruction) stays Mac-only.
# - css/select.c: the two pieces of MacSurf's css/cssh_select.c the
#   reconvert needs (fixes899 nscss_reset_node_data; fixes130e freeing
#   first-cascade node data instead of asserting). Without them the first
#   script-driven relayout aborted in set_libcss_node_data. The rest of
#   that file-fork stays deferred (doc 06 §7).
# See docs/phase-0/10-hardware-test-plan.md §Run 10.

diff --git a/Makefile b/Makefile
index d6ba68388..97f1a6bfa 100644
--- a/Makefile
+++ b/Makefile
@@ -124,6 +124,7 @@ $(eval $(call feature_switch,JPEG,JPEG (libjpeg),-DWITH_JPEG,-ljpeg,-UWITH_JPEG,
 $(eval $(call feature_switch,HARU_PDF,PDF export (haru),-DWITH_PDF_EXPORT,-lhpdf -lpng,-UWITH_PDF_EXPORT,))
 $(eval $(call feature_switch,LIBICONV_PLUG,glibc internal iconv,-DLIBICONV_PLUG,,-ULIBICONV_PLUG,-liconv))
 $(eval $(call feature_switch,DUKTAPE,Javascript (Duktape),,,,,))
+$(eval $(call feature_switch,QUICKJS,Javascript (QuickJS-ng + MacSurf bridge),-DWITH_QUICKJS,,-UWITH_QUICKJS,))
 
 # Common libraries with pkgconfig
 $(eval $(call pkg_config_find_and_add,libcss,CSS))
