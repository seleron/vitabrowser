+/* Patch 440: a block of blocks built again whole -- a change below it
+ * that left every child with its box and no box without its element
+ * (google's innerHTML on a <div> holding one boxed <div>; a boxed child
+ * moved): 434's whole-block rebuild, cascaded afresh from the DOM, the
+ * page laid out whole. Its own :empty is what reaches outside. */
+static int html_rl_block_whole(html_content *c, dom_node *el, struct box *b,
+		double t0)
+{
+	if ((b->children == NULL || html_rl_node_empty(el)) &&
+	    html_rl_empty_sibling_risk(c)) {
+		macsurf_debug_log_writef("LIFE rebuild local: declined (a "
+			"sibling rule tests :empty)");
+		return -1;
+	}
+	macsurf_debug_log_writef("LIFE rebuild local: a block of blocks with "
+		"no block in or out, built again whole");
+	return html_rl_flex_restyle(c, el, b, t0, html_rl_class_same, true);
+}
