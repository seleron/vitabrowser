+/* Patch 440: are the boxes of pnode's element children, where they sit
+ * directly in pbox or in a line directly in it, in the DOM's order? (A
+ * child whose box sits anywhere else -- a float carrier, a deeper level --
+ * answers no: the caller rebuilds, which is right either way.) */
+static bool html_rl_boxes_in_order(dom_node *pnode, struct box *pbox)
+{
+	dom_node *ch = NULL, *nx;
+	unsigned long last = 0;
+	bool first = true, ok = true;
+
+	if (dom_node_get_first_child(pnode, &ch) != DOM_NO_ERR)
+		return false;
+	while (ch != NULL && ok) {
+		dom_node_type type;
+		struct box *b, *top, *q;
+		if (dom_node_get_node_type(ch, &type) == DOM_NO_ERR &&
+		    type == DOM_ELEMENT_NODE &&
+		    (b = box_for_node(ch)) != NULL) {
+			unsigned long ti = 0, ii = 0, pos;
+			top = b->parent == pbox ? b :
+				(b->parent != NULL &&
+				 b->parent->parent == pbox) ? b->parent : NULL;
+			if (top == NULL) {
+				ok = false;
+				break;
+			}
+			for (q = pbox->children; q != NULL && q != top;
+			     q = q->next)
+				ti++;
+			if (top != b)
+				for (q = top->children; q != NULL && q != b;
+				     q = q->next)
+					ii++;
+			pos = (ti << 16) | (ii & 0xffff);
+			if (!first && pos <= last)
+				ok = false;
+			last = pos;
+			first = false;
+		}
+		nx = NULL;
+		if (dom_node_get_next_sibling(ch, &nx) != DOM_NO_ERR)
+			nx = NULL;
+		dom_node_unref(ch);
+		ch = nx;
+	}
+	if (ch != NULL)
+		dom_node_unref(ch);
+	return ok;
+}
