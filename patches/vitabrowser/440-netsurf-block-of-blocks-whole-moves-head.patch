+/* Patch 440: is n, or an element above it, a <head> with no box? Not when n
+ * is a <base> or <meta> (the build reads them). */
+static bool html_rl_in_boxless_head(dom_node *n)
+{
+	dom_node *e = n, *p;
+	bool head = false, first = true;
+
+	dom_node_ref(e);
+	while (e != NULL && !head) {
+		dom_node_type type;
+		if (dom_node_get_node_type(e, &type) == DOM_NO_ERR &&
+		    type == DOM_ELEMENT_NODE) {
+			dom_string *nm = NULL;
+			if (dom_node_get_node_name(e, &nm) == DOM_NO_ERR &&
+			    nm != NULL) {
+				const char *t = dom_string_data(nm);
+				if (first && (strcasecmp(t, "base") == 0 ||
+					      strcasecmp(t, "meta") == 0)) {
+					dom_string_unref(nm);
+					dom_node_unref(e);
+					return false;
+				}
+				head = strcasecmp(t, "head") == 0 &&
+					box_for_node(e) == NULL;
+				dom_string_unref(nm);
+			}
+			first = false;
+		}
+		p = NULL;
+		if (dom_node_get_parent_node(e, &p) != DOM_NO_ERR)
+			p = NULL;
+		dom_node_unref(e);
+		e = p;
+	}
+	if (e != NULL)
+		dom_node_unref(e);
+	return head;
+}
