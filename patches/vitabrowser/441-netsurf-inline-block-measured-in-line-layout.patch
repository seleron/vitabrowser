# netsurf: an inline-block reaching line layout unmeasured is measured there (patch 441)
# Generated 2026-11-22
# Base: seleron/vitabrowser (patch stack through 440)
#
# wpblog aborted on about half its loads, on every binary from 434 on
# (layout.c layout_line: Assertion 'b->width != UNKNOWN_WIDTH'), after its
# o2 live-update poll (an XHR) rebuilt part of the page. gdb: an
# inline-block whose max_width was UNKNOWN_MAX_WIDTH, in a line (also
# unmeasured) under a block whose min/max were cached; pass 1 of
# layout_line calls layout_float only when max_width is known, so the box
# kept UNKNOWN_WIDTH into pass 2. A probe before every reformat found no
# such box, so it appears during the layout itself; the trigger (live
# content) is not identified. Pass 1 now measures such a box
# (layout_minmax_block, as layout_minmax_line does) and logs
# "LIFE layout: an inline-block with no min/max widths, measured in line
# layout".
#
--- a/content/handlers/html/layout.c
+++ b/content/handlers/html/layout.c
@@ -4709,6 +4709,19 @@
 		if (b->type == BOX_INLINE_BLOCK ||
 		    b->type == BOX_INLINE_FLEX ||
 		    b->type == BOX_INLINE_GRID) {
+			/* VitaBrowser patch 441: an inline-block that reaches
+			 * line layout with no min/max widths was skipped here
+			 * and kept width UNKNOWN_WIDTH into pass 2, which
+			 * asserts (wpblog: after its o2 live-update poll
+			 * rebuilt a block, the line of one inline-block
+			 * appeared unmeasured under a measured block). Measure
+			 * it here, as layout_minmax_line would have. */
+			if (b->max_width == UNKNOWN_MAX_WIDTH) {
+				layout_minmax_block(b, font_func, content);
+				macsurf_debug_log_writef("LIFE layout: an "
+					"inline-block with no min/max widths, "
+					"measured in line layout");
+			}
 			if (b->max_width != UNKNOWN_WIDTH)
 				if (!layout_float(b, *width, content))
 					return false;
