+static int html_rl_unsettled;
+/* set by macos9_reconvert_cb while the batch it tries may still wait */
+int html_rl_sheet_wait_ok;
+int html_rl_take_unsettled(void);
+int html_rl_take_unsettled(void)
+{
+	int v = html_rl_unsettled;
+	html_rl_unsettled = 0;
+	return v;
+}
