+/* VitaBrowser patch 443: c->select_ctx changed -- a new generation. The
+ * box tree's recorded generation (rl_boxes_gen) no longer matches until a
+ * whole-tree cascade with this context records it. 0 is never used. */
+void html_css_ctx_changed(html_content *c)
+{
+	if (++c->rl_ctx_gen == 0)
+		c->rl_ctx_gen = 1;
+}
