+	/* VitaBrowser patch 443: the selection context's generation (bumped
+	 * at every change to select_ctx: html_css_ctx_changed), the one the
+	 * box build in progress started with, and the one the whole box tree
+	 * was last cascaded with (0 = none known) */
+	unsigned int rl_ctx_gen;
+	unsigned int rl_build_gen;
+	unsigned int rl_boxes_gen;
 	/**< Style selection media specification */
 	css_media media;
 	/** CSS length conversion context for document. */
