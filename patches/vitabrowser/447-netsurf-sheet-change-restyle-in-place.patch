+/* Patch 447: one element a sheet change restyles (html_rl_doc_noop's
+ * walk found its own style, or its ::before / ::after, changed under the
+ * fresh selection context, now c->select_ctx). Re-selected with its
+ * subtree by the class-change paths, as 370 answers a style attribute:
+ * its "old class" the current one, so no class-token check (414) or
+ * sibling check (186) sees a change. No sibling check is needed here:
+ * the walk compared every element outside the restyled subtrees with the
+ * fresh context, siblings included. */
+static int html_rl_sheet_hit_restyle(html_content *c, dom_node *el)
+{
+	dom_string *cls = NULL;
+	char *cs;
+	int r;
+
+	if (dom_element_get_attribute(el, corestring_dom_class, &cls) !=
+			DOM_NO_ERR)
+		return -1;
+	cs = cls != NULL ? strndup(dom_string_data(cls),
+			dom_string_byte_length(cls)) : strdup("");
+	if (cls != NULL)
+		dom_string_unref(cls);
+	if (cs == NULL)
+		return -1;
+	html_rl_style_as_class = true;	/* not a class change (414) */
+	r = html_reconvert_local_change(&c->base, el, true, cs);
+	html_rl_style_as_class = false;
+	free(cs);
+	return r;
 }
 
