+/* Patch 447 - the sheet census lines of a sheet batch (patches 316, 318,
+ * 321): what the marks said and the edit's reach. Logged for a committed
+ * full reconvert of a nodeless batch (beside its BATCHCAUSE), and for a
+ * sheet batch restyled in place (html_rl_sheet_batch_noop's re-cascade
+ * found a few elements to restyle: beside "LIFE SHEETINPLACE"), so the
+ * census still sees every sheet batch that changes a style. */
+static void
+macos9_sheet_census_lines(int i, int sheets)
+{
+	/* patch 316: synchronous, beside BATCHCAUSE */
+	macsurf_debug_log_writef("LIFE SHEETCAUSE sheets=%d",
+		sheets);
+	/* patch 318: what the marks themselves said */
+	if (g_pending[i].sheet_state == 1 &&
+	    !g_pending[i].sheet_unid) {
+		int cur = html_css_sheet_mark_current(
+			g_pending[i].c, g_pending[i].sheet_idx,
+			g_pending[i].sheet_ctr);
+		macsurf_debug_log_writef(
+			"LIFE SHEETID %s idx=%d ctr=%u",
+			cur ? "single" : "stale",
+			g_pending[i].sheet_idx,
+			g_pending[i].sheet_ctr);
+		if (cur)
+			g_id_single++;
+		else
+			g_id_stale++;
+		/* Patch 321 B1: the reach census --
+		 * census only, no behaviour
+		 * change. Bounded: how small
+		 * the edit's reach is;
+		 * unbounded: the cause. */
+		{
+			struct html_css_reach_result rr;
+			html_css_sheet_reach_census(
+				g_pending[i].c,
+				g_pending[i].sheet_idx,
+				&rr);
+			if (rr.bounded) {
+				g_sr_bounded++;
+				macsurf_debug_log_writef(
+					"LIFE SHEETREACH bounded "
+					"changed=%d anchors=%d "
+					"roots=%d walked=%d",
+					(int)rr.changed,
+					(int)rr.anchors,
+					(int)rr.roots,
+					(int)rr.walked);
+			} else {
+				g_sr_unbounded++;
+				if (rr.reason >= 0 &&
+				    rr.reason <=
+				    HTML_CSS_REACH_NO_SOURCE)
+					g_sr_reasons[rr.reason]++;
+				macsurf_debug_log_writef(
+					"LIFE SHEETREACH unbounded "
+					"reason=%s",
+					html_css_reach_reason_name(
+						rr.reason));
+			}
+		}
+	} else if (g_pending[i].sheet_state != 0) {
+		macsurf_debug_log_writef("LIFE SHEETID multi");
+		g_id_multi++;
+	} else {
+		macsurf_debug_log_writef("LIFE SHEETID none");
+		g_id_none++;
+	}
+}
