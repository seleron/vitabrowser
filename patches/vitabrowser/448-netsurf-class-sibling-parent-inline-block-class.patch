 			continue;
 		if (e->state == 2) {
-			macsurf_debug_log_writef("LIFE rebuild local: declined "
-				"(page CSS needs conservative sibling check)");
+			/* patch 448: a risk, not a decline (the caller rebuilds
+			 * the parent, or declines) */
+			macsurf_debug_log_writef("LIFE rebuild local: sibling "
+				"risk (page CSS needs conservative sibling check)");
 			risk = true;
 			break;
 		}
@@ -12735,7 +12740,7 @@
 					&e->lefts[k], new_class);
 			if (m_old != m_new) {
 				macsurf_debug_log_writef("LIFE rebuild local: "
-					"declined (class change moves a "
+					"sibling risk (class change moves a "
 					"sibling selector)");
 				risk = true;
 				break;
@@ -13347,8 +13352,12 @@
 	    HTML_RL_FRAME(ob) || html_rl_subtree_controls(ob->children))
 		RL_FNO("restyled flex or grid box holds controls or frames");
 	if (old_class != html_rl_class_same &&	/* patch 404 */
-	    html_rl_class_sibling_risk(c, (dom_element *)el, old_class))
+	    html_rl_class_sibling_risk(c, (dom_element *)el, old_class)) {
+		/* patch 448: the parent, built again whole */
+		if (html_rl_sib_parent_rebuild(c, el, "class") == 0)
+			return 0;
 		RL_FNO("class change may move a sibling selector");
+	}
 	if (html_rl_box_counts(ob))		/* patch 374 */
 		RL_FNO("the restyled flex or grid box takes part in counting");
 	if (!html_rl_objects_relinkable(c, ob))	/* patch 375 */
@@ -13538,8 +13547,21 @@
 	/* a class on this block could restyle its following siblings, but
 	 * only if a sibling selector's left compound actually matches the
 	 * element differently under the old vs new class (patch 186) */
-	if (html_rl_class_sibling_risk(c, (dom_element *)el, old_class))
+	/* Patch 448: as 445 says for an attribute, a + / ~ rule the class
+	 * can move reaches only the element's later siblings and their
+	 * descendants -- without :has() (never matched, patch 328) a
+	 * selector sees an element's ancestors and earlier siblings, so a
+	 * class on el can restyle only el's subtree, its later siblings'
+	 * subtrees: all inside the parent. The parent is built again whole
+	 * (a block: 440, a flex or grid box: 438), which re-selects them
+	 * all; a parent that cannot be keeps the full rebuild. The same
+	 * holds where the scan gave up on a sheet (state 2: "page CSS
+	 * needs conservative sibling check"): github, oldreddit. */
+	if (html_rl_class_sibling_risk(c, (dom_element *)el, old_class)) {
+		if (html_rl_sib_parent_rebuild(c, el, "class") == 0)
+			return 0;
 		RL_RNO("class change may move a sibling selector");
+	}
 
 	/* out with the old box, as a removal */
 	prev = ob->prev;
