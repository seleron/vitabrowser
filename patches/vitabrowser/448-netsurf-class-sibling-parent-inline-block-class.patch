# netsurf: a class a sibling rule can move rebuilds the parent; a class on an inline-block goes up to its line (patch 448)
# Generated 2026-11-25
# Base: seleron/vitabrowser (patch stack through 447)
#
# "class change may move a sibling selector" / "page CSS needs
# conservative sibling check" (patch 186's html_rl_class_sibling_risk, in
# the block and flex restyles: github, oldreddit) declined into the full
# rebuild. Without :has() (never matched, patch 328) a selector sees an
# element's ancestors and earlier siblings, so a class on el restyles only
# el's subtree and its later siblings' subtrees, all inside the parent:
# the parent is built again whole (445's html_rl_sib_parent_rebuild: a
# block 440, a flex or grid box 438); one that cannot be keeps the full
# rebuild. The risk lines say "sibling risk (...)" now, not "declined".
# "class change on an element with a non-inline, non-block box"
# (oldreddit, google, youtube: data-eqid, disabled, type on inline-block
# controls): an inline-block, inline-flex or inline-grid box sits in its
# block's line as an inline does (438), so the walk goes on up to the
# block, whose path builds the line again whole (425/434). Other box types
# still decline, naming the tag and box type.
#
--- a/content/handlers/html/html.c
+++ b/content/handlers/html/html.c
@@ -8803,6 +8803,9 @@
 /* Patch 404: the class argument of html_rl_flex_restyle when no class
  * changed (a child-list change): its class-sibling check does not apply. */
 static const char html_rl_class_same[] = "";
+/* Patch 448: the parent of a class or attribute a sibling rule can see */
+static int html_rl_sib_parent_rebuild(html_content *c, dom_node *el,
+		const char *name);
 static int html_rl_flex_restyle(html_content *c, dom_node *el,
 		struct box *ob, double t0, const char *old_class,
 		bool is_block);
@@ -12721,8 +12724,10 @@
