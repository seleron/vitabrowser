# netsurf: 441's guard names the inline-block it measured and its block (patch 449)
# Generated 2026-11-25
# Base: seleron/vitabrowser (patch stack through 448)
#
# Patch 441 measures an inline-block that reaches line layout with no
# min/max widths (wpblog's intermittent layout_line UNKNOWN_WIDTH abort);
# its trigger is unidentified because the live content shows it only now
# and then. The guard's LIFE line is now followed by two that name the
# inline-block and its nearest element box: tag, id, class (80 chars),
# box type, size, max width, children. The LIFE rebuild lines before them
# say which operation built it. No behaviour change.
#
--- a/content/handlers/html/layout.c
+++ b/content/handlers/html/layout.c
@@ -4609,6 +4609,36 @@
  * \param  content  memory pool for any new boxes
  * \return  true on success, false on memory exhaustion
  */
+/* VitaBrowser patch 449: 441's guard names the box it measured -- tag,
+ * id, class, box type and whether it holds a fresh local build -- so a
+ * census load that shows the guard's line identifies the trigger. */
+static void layout_449_probe(const char *what, struct box *b)
+{
+	dom_string *nm = NULL, *id = NULL, *cl = NULL;
+	if (b == NULL || b->node == NULL) {
+		macsurf_debug_log_writef("LIFE layout: %s: no element", what);
+		return;
+	}
+	dom_node_get_node_name(b->node, &nm);
+	dom_element_get_attribute(b->node, corestring_dom_id, &id);
+	dom_element_get_attribute(b->node, corestring_dom_class, &cl);
+	macsurf_debug_log_writef("LIFE layout: %s: <%.*s id=\"%.*s\" "
+		"class=\"%.*s\"> box type %d, %dx%d, max %d, %s children",
+		what,
+		nm ? (int)dom_string_byte_length(nm) : 1, nm ? dom_string_data(nm) : "?",
+		id ? (int)dom_string_byte_length(id) : 0, id ? dom_string_data(id) : "",
+		cl ? (int)(dom_string_byte_length(cl) > 80 ? 80 : dom_string_byte_length(cl)) : 0,
+		cl ? dom_string_data(cl) : "",
+		(int)b->type, b->width, b->height, b->max_width,
+		b->children != NULL ? "with" : "no");
+	if (nm != NULL)
+		dom_string_unref(nm);
+	if (id != NULL)
+		dom_string_unref(id);
+	if (cl != NULL)
+		dom_string_unref(cl);
+}
+
 static bool
 layout_line(struct box *first,
 	    int *width,
@@ -4721,6 +4751,16 @@
 				macsurf_debug_log_writef("LIFE layout: an "
 					"inline-block with no min/max widths, "
 					"measured in line layout");
+				/* patch 449: name it and its block (the
+				 * LIFE rebuild lines before this say which
+				 * operation built it) -- 441's trigger */
+				layout_449_probe("the inline-block", b);
+				{
+					struct box *up = b->parent;
+					while (up != NULL && up->node == NULL)
+						up = up->parent;
+					layout_449_probe("its block", up);
+				}
 			}
 			if (b->max_width != UNKNOWN_WIDTH)
 				if (!layout_float(b, *width, content))
