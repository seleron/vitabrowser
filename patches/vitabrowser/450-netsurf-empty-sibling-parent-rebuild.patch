+/* Patch 450: el's parent built again whole -- a block (440), a flex or
+ * grid box (438); -1 for a parent with no box or another kind of box.
+ * Used for what a sibling rule reaches from el (445, 448, 450). The
+ * parent holds el, so its own :empty cannot flip: one level only (the
+ * depth guard says so). */
+static int html_rl_parent_whole(html_content *c, dom_node *el,
+		const char *what)
 {
 	extern double macos9_micros(void);
+	static int depth;
 	dom_node *p = NULL;
 	struct box *pb;
-	char what[96];
 	int r = -1;
 
+	if (depth > 0)
+		return -1;
 	if (dom_node_get_parent_node(el, &p) != DOM_NO_ERR || p == NULL)
 		return -1;
 	pb = box_for_node(p);
-	snprintf(what, sizeof what, "a sibling selector can match on the %s "
-		"attribute: the parent", name);
+	depth++;
 	if (pb != NULL && pb->type == BOX_BLOCK && pb->parent != NULL &&
 	    pb->object == NULL && !HTML_RL_FRAME(pb))
 		r = html_rl_block_whole(c, p, pb, macos9_micros(), what);
 	else if (pb != NULL && (pb->type == BOX_FLEX || pb->type == BOX_GRID))
 		r = html_rl_flex_whole(c, p, pb, macos9_micros(), what);
+	depth--;
 	dom_node_unref(p);
 	return r;
 }
 
+static int html_rl_sib_parent_rebuild(html_content *c, dom_node *el,
+		const char *name)
+{
+	char what[160];
+
+	snprintf(what, sizeof what, "a sibling selector can match on the %s "
+		"attribute: the parent", name);
+	return html_rl_parent_whole(c, el, what);
+}
