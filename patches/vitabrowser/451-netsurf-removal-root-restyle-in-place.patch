# netsurf: a sheet removal or a root change that restyles a few elements is answered in place (patch 451)
# Generated 2026-11-25
# Base: seleron/vitabrowser (patch stack through 450)
#
# 447 restyled a sheet batch's changed elements in place but kept the
# decline for a sheet removal ("detached stylesheet pruned": the prune at
# the start of html_reconvert_local_change, 3.3 a load on the 7 census
# sites) and a root change (419, in html_rl_block_restyle), because those
# walks run inside a local change whose mark globals name the outer
# change. Both callers are safe for the hits: the removal walk runs
# before the outer change looks anything up, and the root change returns
# at once after it. So the walk collects hits for all three, and
# html_rl_hits_restyle saves the mark state (child-list parent, removal
# place, append, attribute node, flex no-op mode, style-as-class, style
# change, oc tags), clears it for the hits' own local changes, and puts
# it back. SHEETINPLACE (the batch census) stays for sheet batches only.
#
--- a/content/handlers/html/html.c
+++ b/content/handlers/html/html.c
@@ -9066,6 +9066,56 @@
 /* Patch 447: a sheet change restyles a few elements in place (below) */
 static int html_rl_sheet_hit_restyle(html_content *c, dom_node *el);
 #define HTML_RL_SHEET_HITS_MAX 8
+/* (tentative definitions: defined with their users below) */
+static bool html_rl_style_as_class;
+static bool html_rl_style_change;
+
+/* Patch 451: restyle the hits with the local-change mark state of the
+ * change that is being answered (a sheet removal pruned at the start of
+ * html_reconvert_local_change, a root change in html_rl_block_restyle)
+ * saved and cleared: each hit's restyle is a local change of its own, and
+ * those globals name the outer change's node, kind and place. Restored
+ * after, whatever the result. At the top (a sheet batch) they are all
+ * clear already. */
+static int html_rl_hits_restyle(html_content *c, dom_node **hits, int nhits)
+{
+	dom_node *s_parent = html_rl_childlist_parent;
+	dom_node *s_attr = html_rl_attr_mark_node;
+	dom_node *s_rm_next = html_rl_childlist_rm_next;
+	bool s_removal = html_rl_childlist_removal;
+	bool s_rm_known = html_rl_childlist_rm_known;
+	bool s_append = html_rl_childlist_append;
+	bool s_noop_only = html_rl_noop_only;
+	bool s_as_class = html_rl_style_as_class;
+	bool s_style = html_rl_style_change;
+	bool s_oc = html_rl_tags_oc;
+	int k, r = 0;
+
+	html_rl_childlist_parent = NULL;
+	html_rl_attr_mark_node = NULL;
+	html_rl_childlist_rm_next = NULL;
+	html_rl_childlist_removal = false;
+	html_rl_childlist_rm_known = false;
+	html_rl_childlist_append = false;
+	html_rl_noop_only = false;
+	html_rl_style_as_class = false;
+	html_rl_style_change = false;
+	html_rl_tags_oc = false;
+	for (k = 0; k < nhits; k++)
+		if (r == 0 && html_rl_sheet_hit_restyle(c, hits[k]) != 0)
+			r = -1;
+	html_rl_childlist_parent = s_parent;
+	html_rl_attr_mark_node = s_attr;
+	html_rl_childlist_rm_next = s_rm_next;
+	html_rl_childlist_removal = s_removal;
+	html_rl_childlist_rm_known = s_rm_known;
+	html_rl_childlist_append = s_append;
+	html_rl_noop_only = s_noop_only;
+	html_rl_style_as_class = s_as_class;
+	html_rl_style_change = s_style;
+	html_rl_tags_oc = s_oc;
+	return r;
+}
 
