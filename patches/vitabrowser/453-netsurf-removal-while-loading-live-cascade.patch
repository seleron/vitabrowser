# netsurf: a sheet removal while another sheet loads is answered against the live cascade (patch 453)
# Generated 2026-11-25
# Base: seleron/vitabrowser (patch stack through 452)
#
# "sheet removal: a sheet is still loading or changing" (2.3 a load in the
# 452 census, most of what is left of "detached stylesheet pruned")
# declined into the full rebuild: 415's walk builds a fresh selection
# context only from settled sheets. But c->select_ctx is refreshed only once
# every sheet has settled, and the prune takes a settled sheet out of it
# (patch 425): so the live context is the held cascade minus the removed
# sheet -- what a full rebuild would cascade now -- provided the box tree
# held the context's generation just before the prune (443's rl_boxes_gen;
# html_reconvert_local_change records it in html_rl_removal_held around
# its prune) and no sheet has a pending text update
# (html_rl_sheet_modified). Then html_rl_doc_noop walks against the live
# context itself -- no fresh one, no swap, never destroyed -- and its hits
# are restyled in place (447/451). The sheet in flight marks when it is
# done, and that batch re-cascades everything.
#
--- a/content/handlers/html/html.c
+++ b/content/handlers/html/html.c
@@ -8973,6 +8973,17 @@
 	return true;
 }
 
+/* Patch 453: a sheet with a pending text update (its new rules not yet in
+ * any context) -- the live context does not hold the cascade then */
+static bool html_rl_sheet_modified(html_content *c)
+{
+	unsigned int i;
+	for (i = 0; i != c->stylesheet_count; i++)
+		if (!c->stylesheets[i].unused && c->stylesheets[i].modified)
+			return true;
+	return false;
+}
