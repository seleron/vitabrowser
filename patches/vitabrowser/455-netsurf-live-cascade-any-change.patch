- * box tree held the selection context's generation just before it (443's
- * rl_boxes_gen), so the live context, minus the pruned sheet, is the
- * cascade a full rebuild would use while another sheet is in flight */
-static bool html_rl_removal_held;
 /* set by macos9_reconvert_cb while the batch it tries may still wait */
 int html_rl_sheet_wait_ok;
 int html_rl_take_unsettled(void);
