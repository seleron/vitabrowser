+/** Is the page's DOM waiting for a relayout the scripts asked for?
+ * (MacSurf's reconvert driver, quickjs/macos9_reconvert.c: a mutation
+ * that lands while the box tree is being built is retried 400 ms later,
+ * after the page can look idle.) */
+static bool page_reconvert_pending(struct gui_window *gw)
+{
+	struct browser_window *bw = vita_window_browser(gw);
+	struct hlcache_handle *h = bw ? browser_window_get_content(bw) : NULL;
+	struct content *c = h ? hlcache_handle_get_content(h) : NULL;
+
+	return c != NULL && macos9_reconvert_pending_for(c);
+}
+
 /** Has the current page finished loading and stopped repainting? */
 static bool page_settled(struct gui_window *gw)
 {
@@ -364,6 +384,12 @@ static bool page_settled(struct gui_window *gw)
 
 	if (vita_stats.frames == 0 || vita_window_loading(gw))
 		return false;
+	/* Not while script-driven relayout is still due: its frame is the
+	 * page as the scripts left it. */
+	if (page_reconvert_pending(gw)) {
+		vita_stats.last_frame_ms = now;
+		return false;
+	}
 	return now - vita_stats.last_frame_ms >= VITA_SETTLE_MS;
 }
 
