+/**
+ * \file
+ * Vita frontend: the services MacSurf's QuickJS bridge calls
+ * (content/handlers/javascript/quickjs/macos9.h).
+ *
+ * The bridge was written against MacSurf's Mac OS 9 frontend. These are
+ * the Vita's versions: the frontend scheduler, plain allocation, and
+ * clocks. The microsecond clock macos9_micros() is in vita/qjs_hooks.c,
+ * shared with the engine's own instrumentation.
+ */
+
+#include <stdlib.h>
+#include <unistd.h>
+#include <sys/time.h>
+
+#include "utils/errors.h"
+#include "content/handlers/javascript/quickjs/macos9.h"
+
+#include "vita/schedule.h"
+#include "vita/layout.h"
+#include "vita/js_platform.h"
+
+/* Time spent in JavaScript, us, as the bridge reports it. */
+long vita_js_time_us;
+unsigned long vita_js_random_failures;
+
+/* exported interface documented in quickjs/macos9.h */
+nserror macos9_schedule(int t, void (*callback)(void *p), void *p)
+{
+	return vita_schedule(t, callback, p);
+}
+
+/* exported interface documented in quickjs/macos9.h */
+void macos9_schedule_cancel_owner(void *p)
+{
+	vita_schedule_remove_owner(p);
+}
+
+/* exported interface documented in quickjs/macos9.h: may fail, and the
+ * bridge handles NULL (the QuickJS heap itself is capped separately). */
+void *macsurf_try_alloc(size_t size)
+{
+	return malloc(size);
+}
+
+/* exported interface documented in quickjs/macos9.h */
+void *macsurf_try_realloc(void *ptr, size_t size)
+{
+	return realloc(ptr, size);
+}
+
+/* exported interface documented in quickjs/macos9.h */
+unsigned long TickCount(void)
+{
+	return (unsigned long)(macos9_micros() * 60.0 / 1e6);
+}
+
+/* exported interface documented in quickjs/macos9.h */
+int macos9_sched_is_queued(void (*callback)(void *p), void *p)
+{
+	return vita_schedule_is_queued(callback, p) ? 1 : 0;
+}
+
+/* exported interface documented in quickjs/macos9.h: performance.now()'s
+ * clock, ms since start-up with sub-millisecond resolution. */
+double macsurf_monotonic_ms(void)
+{
+	static double t0 = -1.0;
+	double now = macos9_micros();
+
+	if (t0 < 0.0)
+		t0 = now;
+	return (now - t0) / 1000.0;
+}
+
+/* exported interface documented in quickjs/macos9.h: crypto.getRandomValues
+ * and crypto.randomUUID. getentropy() is the kernel's generator (on the
+ * Vita, newlib's getentropy() calls sceKernelGetRandomNumber); it takes at
+ * most 256 bytes a call. Never falls back to a weak source: on failure the
+ * buffer is left zeroed and the failure logged by the caller's counters. */
+void OSTLS_RandomBytes(void *out, unsigned long len)
+{
+	unsigned char *p = out;
+
+	while (len > 0) {
+		size_t n = len > 256 ? 256 : (size_t)len;
+		if (getentropy(p, n) != 0) {
+			while (len-- > 0)
+				*p++ = 0;
+			vita_js_random_failures++;
+			return;
+		}
+		p += n;
+		len -= n;
+	}
+}
+
+/* The frontend's text measurement, for canvas measureText() and the
+ * bridge's geometry (MacSurf's macos9_layout_table). Set by
+ * vita_js_platform_init(). */
+struct gui_layout_table *macos9_layout_table;
+
+
+/* exported interface documented in quickjs/macos9.h */
+void macsurf_profile_accum_js(long us)
+{
+	if (us > 0)
+		vita_js_time_us += us;
+}
+
+/* exported interface documented in vita/js_platform.h */
+void vita_js_platform_init(void)
+{
+	macos9_layout_table = vita_layout_table;
+}
