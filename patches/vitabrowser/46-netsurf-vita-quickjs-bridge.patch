index b54de171f..3d6436dd6 100644
--- a/frontends/vita/schedule.c
+++ b/frontends/vita/schedule.c
@@ -69,7 +69,8 @@ static nserror schedule_remove(void (*callback)(void *p), void *p)
 	prev_nscb = NULL;
 
 	while (cur_nscb != NULL) {
-		if ((cur_nscb->callback ==  callback) &&
+		/* A NULL callback matches any: every entry owned by p. */
+		if ((callback == NULL || cur_nscb->callback == callback) &&
 		    (cur_nscb->p ==  p)) {
 			/* item to remove */
 
@@ -232,3 +233,20 @@ void vita_schedule_list(void)
 		cur_nscb = cur_nscb->next;
 	}
 }
+
+/* exported interface documented in vita/schedule.h */
+void vita_schedule_remove_owner(void *p)
+{
+	schedule_remove(NULL, p);
+}
+
+/* exported interface documented in vita/schedule.h */
+bool vita_schedule_is_queued(void (*callback)(void *p), void *p)
+{
+	struct nscallback *cur;
+
+	for (cur = schedule_list; cur != NULL; cur = cur->next)
+		if (cur->callback == callback && cur->p == p)
+			return true;
+	return false;
+}
