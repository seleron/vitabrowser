# netsurf: an element that gets a box in the re-cascade makes its parent a hit (patch 462)
# Generated 2026-11-28
# Base: seleron/vitabrowser (patch stack through 461)
#
# "sheet removal: an element without a box would get one" (oldreddit: a
# <div> a removed sheet had hidden; with "detached stylesheet pruned" the
# largest remaining local decline at 1.0 a load) stopped html_rl_doc_noop's
# walk. Such an element is built by its parent's rebuild: the parent --
# with a box, not the root -- becomes a hit of the walk (447), once, and
# its restyle re-selects and builds its subtree from the DOM, the new box
# with it. Hits that overlap it are restyled again, redundantly but
# correctly. The cap of 8 hits still applies.
#
--- a/content/handlers/html/html.c
+++ b/content/handlers/html/html.c
@@ -9332,6 +9332,37 @@
 					f.n == root) != CSS_DISPLAY_NONE &&
 			    !html_rl_noop_never_boxed(f.n))
 				why = "an element without a box would get one";
+			/* Patch 462: such an element (oldreddit: a <div> a
+			 * removed sheet had hidden) is built by its parent's
+			 * rebuild -- the parent, with a box and not the root,
+			 * becomes a hit (once): its restyle re-selects and
+			 * builds its subtree from the DOM. Hits that overlap
+			 * it are restyled again, redundantly but correctly. */
+			if (why != NULL && can_hit) {
+				dom_node *pn = NULL;
+				if (dom_node_get_parent_node(f.n, &pn) ==
+						DOM_NO_ERR && pn != NULL &&
+				    pn != root && box_for_node(pn) != NULL) {
+					int h;
+					for (h = 0; h < nhits; h++)
+						if (hits[h] == pn)
+							break;
+					if (h < nhits) {
+						why = NULL;	/* already */
+					} else if (nhits <
+						   HTML_RL_SHEET_HITS_MAX) {
+						dom_node_ref(pn);
+						hits[nhits++] = pn;
+						why = NULL;
+						macsurf_debug_log_writef("LIFE "
+							"rebuild local: %s: an "
+							"element gets a box, its "
+							"parent restyled", what);
+					}
+				}
+				if (pn != NULL)
+					dom_node_unref(pn);
+			}
 		} else if (box->styles == NULL) {
