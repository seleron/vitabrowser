+/* Patch 463: a cache entry's validity check that does not read the whole
+ * sheet: the same handle with the same data pointer and size, and the
+ * same bytes at four 64-byte spans. html_rl_fnv1a over the whole source
+ * on every lookup -- hits included -- was the largest single cost of the
+ * local path on youtube (its sheets are hundreds of KB, checked per mark
+ * per sheet). A <style> whose text changes gets a new sheet content (a
+ * new handle), so in-place edits of one source are not the case guarded. */
+static uint32_t html_rl_sample_hash(const uint8_t *s, size_t len)
+{
+	uint32_t h = 2166136261u ^ (uint32_t)len;
+	size_t at[4], k, i, n;
+
+	at[0] = 0;
+	at[1] = len / 3;
+	at[2] = (len / 3) * 2;
+	at[3] = len > 64 ? len - 64 : 0;
+	for (k = 0; k < 4; k++) {
+		n = len - at[k] < 64 ? len - at[k] : 64;
+		for (i = 0; i < n; i++) {
+			h ^= s[at[k] + i];
+			h *= 16777619u;
+		}
 	}
 	return h;
 }
