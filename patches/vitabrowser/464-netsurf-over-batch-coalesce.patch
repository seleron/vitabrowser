+/* Patch 464 - coalescing a batch that overflows extra[] (the 463 census:
+ * wpblog's and github's batches of 128+ distinct marks, "over", 2.0 a
+ * load). The body marks -- head marks render nothing and stay extras --
+ * are replaced by one mark on their lowest common ancestor, when that is
+ * below <body>; an attribute, class or style mark on the ancestor itself
+ * could reach its later siblings through a + / ~ rule, so the ancestor
+ * then goes one level up. The slot's primary becomes that element
+ * (`coalesced`), answered by html_rl_subtree_rebuild (its nearest block,
+ * flex or grid box built again whole). */
+extern void *html_rl_lca(void *, void *);
+extern int html_rl_node_in_head(void *);
+extern int html_rl_is_within(void *, void *);
+extern int html_rl_too_wide(void *);
+extern void *html_rl_parent_of(void *);
+extern void html_rl_node_describe(void *, char *, size_t);
+
+static int macos9_reconvert_attrish(int kind)
+{
+	return kind == MACOS9_DOMMUT_SETATTRIBUTE ||
+		kind == MACOS9_DOMMUT_REMOVEATTRIBUTE ||
+		kind == MACOS9_DOMMUT_SETATTR_CLASS ||
+		kind == MACOS9_DOMMUT_SETATTR_STYLE;
+}
+
+/* the ancestor one level up when an attribute-like mark sits on it; NULL
+ * (released) when too wide. Takes and returns a reference. */
+static void *macos9_reconvert_lca_fix(void *lca, void *node, int kind)
+{
+	if (lca != NULL && node == lca && macos9_reconvert_attrish(kind)) {
+		void *p = html_rl_parent_of(lca);
+		macsurf_reconvert_node_unref(lca);
+		lca = p;
+	}
+	if (lca != NULL && html_rl_too_wide(lca)) {
+		macsurf_reconvert_node_unref(lca);
+		lca = NULL;
+	}
+	return lca;
+}
+
+static void macos9_reconvert_extra_release(struct macos9_reconvert_extra *e)
+{
+	if (e->node != NULL)
+		macsurf_reconvert_node_unref(e->node);
+	e->node = NULL;
+	free(e->old_class);
+	e->old_class = NULL;
+	free(e->attr_name);
+	e->attr_name = NULL;
+	if (e->rm_next != NULL)
+		macsurf_reconvert_node_unref(e->rm_next);
+	e->rm_next = NULL;
+	e->rm_state = 0;
+}
+
+static int macos9_reconvert_coalesce(int i, void *node, int kind,
+		const char *old_class, const char *attr_name)
+{
+	void *lca = NULL, *l2;
+	int q, kept = 0, n_all = g_pending[i].extra_n + 2, attr_on = 0;
+	struct macos9_reconvert_extra prim;
+	char d[96];
+
+	if (g_pending[i].node == NULL || node == NULL)
+		return 0;
+	/* the common ancestor of every body mark, the new one included */
+	for (q = -2; q < g_pending[i].extra_n; q++) {
+		void *nn = q == -2 ? node : q == -1 ? g_pending[i].node :
+			g_pending[i].extra[q].node;
+		if (nn == NULL || html_rl_node_in_head(nn))
+			continue;
+		l2 = html_rl_lca(lca, nn);
+		if (lca != NULL)
+			macsurf_reconvert_node_unref(lca);
+		lca = l2;
+	}
+	if (lca == NULL)
+		return 0;
+	for (q = -2; q < g_pending[i].extra_n; q++) {
+		void *nn = q == -2 ? node : q == -1 ? g_pending[i].node :
+			g_pending[i].extra[q].node;
+		int kk = q == -2 ? kind : q == -1 ? g_pending[i].kind :
+			g_pending[i].extra[q].kind;
+		if (nn == lca && macos9_reconvert_attrish(kk))
+			attr_on = 1;
+	}
+	lca = macos9_reconvert_lca_fix(lca, attr_on ? lca : NULL,
+			MACOS9_DOMMUT_SETATTRIBUTE);
+	if (lca == NULL) {
+		macsurf_debug_log_writef("LIFE over: %d marks, too wide to "
+			"coalesce", n_all - 1);
+		return 0;
+	}
+	/* the primary as an extra, then keep only the head marks */
+	prim.node = g_pending[i].node;
+	prim.kind = g_pending[i].kind;
+	prim.old_class = g_pending[i].old_class;
+	prim.attr_name = g_pending[i].attr_name;
+	prim.rm_next = g_pending[i].rm_next;
+	prim.rm_state = g_pending[i].rm_state;
+	g_pending[i].node = NULL;
+	g_pending[i].old_class = NULL;
+	g_pending[i].attr_name = NULL;
+	g_pending[i].rm_next = NULL;
+	g_pending[i].rm_state = 0;
+	/* compact the extras in place (the write index never passes the read
+	 * index), then the old primary after them -- moving the primary in
+	 * first overwrote extra[0] before it was read */
+	for (q = 0; q < g_pending[i].extra_n; q++) {
+		struct macos9_reconvert_extra *e = &g_pending[i].extra[q];
+		if (e->node != NULL && html_rl_node_in_head(e->node)) {
+			if (kept != q)
+				g_pending[i].extra[kept] = *e;	/* moves */
+			kept++;
+		} else {
+			macos9_reconvert_extra_release(e);
+		}
+	}
+	if (prim.node != NULL && html_rl_node_in_head(prim.node) &&
+	    kept < RECONVERT_MAX_EXTRA)
+		g_pending[i].extra[kept++] = prim;	/* moves */
+	else
+		macos9_reconvert_extra_release(&prim);
+	g_pending[i].extra_n = kept;
+	if (html_rl_node_in_head(node) && kept < RECONVERT_MAX_EXTRA) {
+		struct macos9_reconvert_extra *e =
+			&g_pending[i].extra[g_pending[i].extra_n++];
+		e->node = macsurf_reconvert_node_ref(node);
+		e->kind = kind;
+		e->old_class = (kind == MACOS9_DOMMUT_SETATTR_CLASS &&
+			old_class != NULL) ? strdup(old_class) : NULL;
+		e->attr_name = macos9_reconvert_attr_dup(kind, attr_name);
+		macos9_reconvert_rm_set(&e->rm_next, &e->rm_state, kind);
+		kept++;
+	}
+	g_pending[i].node = lca;	/* the reference moves in */
+	g_pending[i].kind = MACOS9_DOMMUT_INNERHTML;
+	g_pending[i].coalesced = 1;
+	g_pending[i].multi = 1;
+	html_rl_node_describe(lca, d, sizeof d);
+	macsurf_debug_log_writef("LIFE over: %d marks coalesced under %s, %d "
+		"in <head> kept", n_all - 1, d, kept);
+	return 1;
+}
+
+/* a mark into a coalesced slot: 1 covered by the coalesced subtree, 0 an
+ * extra as usual -- a <head> mark, a mark outside the subtree (github: a
+ * later mark beside the coalesced <div> widened it to <body>, too wide,
+ * and the batch went to the full rebuild after all), or an attribute-like
+ * mark on the ancestor itself (its own sibling checks then apply). The
+ * slot has room again after coalescing; a second overflow coalesces
+ * everything it holds then, the coalesced primary included. */
+static int macos9_reconvert_coalesced_mark(int i, void *node, int kind)
+{
+	if (html_rl_node_in_head(node))
+		return 0;
+	if (html_rl_is_within(g_pending[i].node, node) &&
+	    !(node == g_pending[i].node && macos9_reconvert_attrish(kind)))
+		return 1;
+	return 0;
+}
