+/* Patch 464: the answer to a coalesced batch (macos9_reconvert: more than
+ * 128 distinct marks, their body marks under one element below <body>):
+ * the nearest block, flex or grid box at or above that element is built
+ * again whole from the DOM (440 / 438), which re-selects and rebuilds
+ * everything the marks touched -- any of them a + / ~ rule could reach
+ * from is inside it (an attribute mark on the element itself made the
+ * queue go one level up). The local path's prelude first: busy, loaded,
+ * find in page, pruned sheets, outside the document. */
+int html_rl_subtree_rebuild(struct content *base_c, void *vnode);
+int html_rl_subtree_rebuild(struct content *base_c, void *vnode)
+{
+	extern double macos9_micros(void);
+	html_content *c = (html_content *)base_c;
+	dom_node *n, *p;
+	struct box *b;
+	int r = -1, pruned;
+	double t0;
+
+#define RL_SNO(why) do { macsurf_debug_log_writef( \
+		"LIFE rebuild local: declined (%s)", (why)); return -1; } while (0)
+	if (c == NULL || vnode == NULL || c->layout == NULL ||
+	    c->document == NULL || c->aborted)
+		return -1;
+	if (c->reflowing || c->box_conversion_context != NULL ||
+	    macsurf_reconvert_in_progress != 0 || macos9_paint_gw != NULL ||
+	    base_c->locked)
+		RL_SNO("busy");
+	if (base_c->status != CONTENT_STATUS_READY &&
+	    base_c->status != CONTENT_STATUS_DONE)
+		RL_SNO("not loaded");
+	if (base_c->textsearch.context != NULL)
+		RL_SNO("find in page is open");
+	/* the sheets a batch removed are pruned first (the live context
+	 * loses them, patch 425); the sheet-removal walk comes AFTER the
+	 * subtree is rebuilt -- before, it met the batch's new elements in
+	 * the subtree, still without boxes, and declined (github) */
+	pruned = html_css_prune_detached_sheets(c);
+	if (!html_rl_in_document((dom_node *)vnode)) {
+		if (pruned > 0 && html_rl_doc_noop(c, "sheet removal") != 0)
+			RL_SNO("detached stylesheet pruned");
+		macsurf_debug_log_writef("LIFE rebuild local: coalesced marks "
+			"outside the document, nothing to rebuild");
+		return 0;
+	}
+	t0 = macos9_micros();
+	n = vnode;
+	dom_node_ref(n);
+	while (n != NULL) {
+		if (html_rl_too_wide(n)) {
+			dom_node_unref(n);
+			RL_SNO("coalesced marks reach the body");
+		}
+		b = box_for_node(n);
+		if (b != NULL && b->type == BOX_BLOCK && b->parent != NULL &&
+		    b->object == NULL && !HTML_RL_FRAME(b)) {
+			r = html_rl_block_whole(c, n, b, t0, "coalesced marks: "
+				"their common block");
+			dom_node_unref(n);
+			if (r == 0 && pruned > 0 &&
+			    html_rl_doc_noop(c, "sheet removal") != 0)
+				RL_SNO("detached stylesheet pruned");
+			return r;
+		}
+		if (b != NULL && (b->type == BOX_FLEX || b->type == BOX_GRID)) {
+			r = html_rl_flex_whole(c, n, b, t0, "coalesced marks: "
+				"their common flex or grid box");
+			dom_node_unref(n);
+			if (r == 0 && pruned > 0 &&
+			    html_rl_doc_noop(c, "sheet removal") != 0)
+				RL_SNO("detached stylesheet pruned");
+			return r;
+		}
+		p = NULL;
+		if (dom_node_get_parent_node(n, &p) != DOM_NO_ERR)
+			p = NULL;
+		dom_node_unref(n);
+		n = p;
+	}
+	RL_SNO("coalesced marks: no block above them");
+#undef RL_SNO
+}
