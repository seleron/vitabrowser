+/* Patch 464: the lowest common ancestor of two nodes (either may be NULL:
+ * the other is returned), a new reference; NULL when none */
+static int html_rl_depth(dom_node *n)
+{
+	int d = 0;
+	dom_node *p = NULL;
+	dom_node_ref(n);
+	while (n != NULL) {
+		d++;
+		p = NULL;
+		if (dom_node_get_parent_node(n, &p) != DOM_NO_ERR)
+			p = NULL;
+		dom_node_unref(n);
+		n = p;
+	}
+	return d;
+}
+void *html_rl_lca(void *va, void *vb);
+void *html_rl_lca(void *va, void *vb)
+{
+	dom_node *a = va, *b = vb, *p;
+	int da, db;
+	if (a == NULL && b == NULL)
+		return NULL;
+	if (a == NULL) {
+		dom_node_ref(b);
+		return b;
+	}
+	if (b == NULL) {
+		dom_node_ref(a);
+		return a;
+	}
+	da = html_rl_depth(a);
+	db = html_rl_depth(b);
+	dom_node_ref(a);
+	dom_node_ref(b);
+	while (da > db) {
+		p = NULL;
+		dom_node_get_parent_node(a, &p);
+		dom_node_unref(a);
+		a = p;
+		da--;
+	}
+	while (db > da) {
+		p = NULL;
+		dom_node_get_parent_node(b, &p);
+		dom_node_unref(b);
+		b = p;
+		db--;
+	}
+	while (a != NULL && b != NULL && a != b) {
+		p = NULL;
+		dom_node_get_parent_node(a, &p);
+		dom_node_unref(a);
+		a = p;
+		p = NULL;
+		dom_node_get_parent_node(b, &p);
+		dom_node_unref(b);
+		b = p;
+	}
+	if (b != NULL)
+		dom_node_unref(b);
+	return a;	/* a == b, or NULL */
+}
+/* Patch 464: is the node <head> or inside it? */
+int html_rl_node_in_head(void *node);
+int html_rl_node_in_head(void *node)
+{
+	dom_node *n = node, *p;
+	int r = 0;
+	if (n == NULL)
+		return 0;
+	dom_node_ref(n);
+	while (n != NULL) {
+		char *t = html_rl_struct_tag(n);
+		if (t != NULL && strcmp(t, "head") == 0)
+			r = 1;
+		free(t);
+		if (r)
+			break;
+		p = NULL;
+		if (dom_node_get_parent_node(n, &p) != DOM_NO_ERR)
+			p = NULL;
+		dom_node_unref(n);
+		n = p;
+	}
+	if (n != NULL)
+		dom_node_unref(n);
+	return r;
+}
+
+/* Patch 464: is node anc itself or inside it? */
+int html_rl_is_within(void *anc, void *node);
+int html_rl_is_within(void *anc, void *node)
+{
+	dom_node *n = node, *p;
+	int r = 0;
+	if (anc == NULL || n == NULL)
+		return 0;
+	dom_node_ref(n);
+	while (n != NULL) {
+		if (n == (dom_node *)anc) {
+			r = 1;
+			break;
+		}
+		p = NULL;
+		if (dom_node_get_parent_node(n, &p) != DOM_NO_ERR)
+			p = NULL;
+		dom_node_unref(n);
+		n = p;
+	}
+	if (n != NULL)
+		dom_node_unref(n);
+	return r;
+}
+
+/* Patch 464: <body>, <html> or not an element (the document): too wide a
+ * subtree to coalesce marks under */
+int html_rl_too_wide(void *node);
+int html_rl_too_wide(void *node)
+{
+	dom_node_type type;
+	char *t;
+	int r;
+	if (node == NULL ||
+	    dom_node_get_node_type((dom_node *)node, &type) != DOM_NO_ERR ||
+	    type != DOM_ELEMENT_NODE)
+		return 1;
+	t = html_rl_struct_tag((dom_node *)node);
+	r = t == NULL || strcmp(t, "body") == 0 || strcmp(t, "html") == 0;
+	free(t);
+	return r;
+}
+
+/* Patch 464: a node's parent, a new reference (or NULL) */
+void *html_rl_parent_of(void *node);
+void *html_rl_parent_of(void *node)
+{
+	dom_node *p = NULL;
+	if (node == NULL ||
+	    dom_node_get_parent_node((dom_node *)node, &p) != DOM_NO_ERR)
+		return NULL;
+	return p;
+}
+
+/* Patch 464: a node's tag and its child count, for the log */
+void html_rl_node_describe(void *node, char *buf, size_t len);
+void html_rl_node_describe(void *node, char *buf, size_t len)
+{
+	char *t = node ? html_rl_struct_tag((dom_node *)node) : NULL;
+	dom_nodelist *kids = NULL;
+	uint32_t nk = 0;
+	if (node != NULL && dom_node_get_child_nodes((dom_node *)node,
+			&kids) == DOM_NO_ERR && kids != NULL) {
+		dom_nodelist_get_length(kids, &nk);
+		dom_nodelist_unref(kids);
+	}
+	snprintf(buf, len, "<%s> (%u child nodes, depth %d)", t ? t : "?",
+		(unsigned)nk, node ? html_rl_depth((dom_node *)node) : 0);
+	free(t);
+}
