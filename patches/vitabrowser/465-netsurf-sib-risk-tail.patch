# netsurf: an attribute a sibling rule can see, with nothing with a box after the element, is answered locally (patch 465)
# Generated 2026-11-27
# Base: seleron/vitabrowser (patch stack through 464)
#
# A sibling rule (X[attr] + Y, X[attr] ~ Y Z) reaches only the element's
# later siblings and their descendants. 445 builds the parent again whole
# for such a change; the root has no parent box, so an attribute on <html>
# a sibling rule could see (github's data-turbo-loaded, after 464's
# coalesced batch) went to the full rebuild. With nothing with a box after
# the element (381's tail test: only never-boxed elements or white space)
# the rule reaches nothing that renders -- the root always, and any last
# child -- so the style or attribute change is answered as one no sibling
# rule can see (html_rl_sib_risk_reaches_nothing): the element and its
# subtree re-selected by the class-change paths. Logged: "a sibling
# selector can match on the X attribute, but nothing with a box follows
# the element".
#
--- a/content/handlers/html/html.c
+++ b/content/handlers/html/html.c
@@ -14625,6 +14625,23 @@
 	return r;
 }
 
+/* Patch 465: a sibling rule (X[attr] + Y, X[attr] ~ Y Z) reaches only
+ * the element's LATER siblings and their descendants. With nothing with a
+ * box after the element (381's tail test: only elements that never have a
+ * box, or white space) it reaches nothing that renders -- the root above
+ * all (github's data-turbo-loaded on <html>: the document holds no later
+ * element), and the last child of any parent. The attribute is then
+ * answered as one no sibling rule can see. */
+static bool html_rl_sib_risk_reaches_nothing(dom_node *el, const char *name)
+{
+	if (!html_rl_at_tail(el))
+		return false;
+	macsurf_debug_log_writef("LIFE rebuild local: a sibling selector can "
+		"match on the %s attribute, but nothing with a box follows the "
+		"element", name);
+	return true;
+}
+
 static int html_rl_sib_parent_rebuild(html_content *c, dom_node *el,
 		const char *name)
 {
@@ -14645,7 +14662,8 @@
 
 	if (c == NULL || vnode == NULL)
 		return -1;
-	if (html_rl_style_sibling_risk(c)) {
+	if (html_rl_style_sibling_risk(c) &&
+	    !html_rl_sib_risk_reaches_nothing((dom_node *)vnode, "style")) {
 		if (html_rl_sib_parent_rebuild(c, (dom_node *)vnode,
 				"style") == 0)
 			return 0;	/* patch 445 */
@@ -14701,7 +14719,8 @@
 	for (k = 0; attr_name[k] != '\0'; k++)
 		name[k] = (char)tolower((unsigned char)attr_name[k]);
 	name[k] = '\0';
-	if (html_rl_attr_sibling_risk(c, name)) {
+	if (html_rl_attr_sibling_risk(c, name) &&
+	    !html_rl_sib_risk_reaches_nothing((dom_node *)vnode, name)) {
 		if (html_rl_sib_parent_rebuild(c, (dom_node *)vnode,
 				name) == 0)
 			return 0;	/* patch 445 */
