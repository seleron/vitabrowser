# netsurf: the root's child list and a box-less element's id answered by the whole-document walk (patch 466)
# Generated 2026-11-27
# Base: seleron/vitabrowser (patch stack through 465)
#
# wpblog's "two" batch (1.0 a load): a <fieldset> with no box made a child
# of <html>, before <head>, its id set in the same task. Three marks
# declined:
# - the root's child list, a structural rule seeing it: 404 rebuilds the
#   parent's subtree, and the root's box has no parent to rebuild it in
#   ("restyled <html> ... not in a block");
# - the root's child list again, a sibling rule seeing it: 446 builds the
#   parent again whole, the same dead end ("no parent box");
# - the id: 417 refused every id change, silently (#id selectors are not
#   in the attribute scans).
# Each is now answered by the whole-document walk (html_rl_doc_noop,
# 419 / 447 / 459), which re-cascades every element against the DOM as it
# is now and restyles what changed (hits, the root in place) or declines
# when a rebuild is needed (an element that would get a box). Only for
# changes in elements with no box: the walk goes over the DOM, so a boxed
# child removed or added at the root keeps the full rebuild (the 404 path
# is told so, html_rl_struct_parent_rebuild's boxless). An id on an element
# WITH a box keeps the full rebuild, now logged ("declined (an id change:
# #id selectors are not scanned)").
#
--- a/content/handlers/html/html.c
+++ b/content/handlers/html/html.c
@@ -9723,10 +9723,34 @@
 	return -1;
 }
 static int html_rl_struct_parent_rebuild(html_content *c, dom_node *pnode,
-		struct box *pbox, double t0)
+		struct box *pbox, double t0, bool boxless)
 {
 	extern double macos9_micros(void);
 	static unsigned long struct_n;
+#define RL_ROOT_NO(w) do { macsurf_debug_log_writef("LIFE rebuild local: " \
+		"structural change at the root: declined (%s)", (w)); \
+		return -1; } while (0)
+	/* Patch 466: the root's child list (wpblog: an element with no box
+	 * added beside <body>, a structural rule seeing it). Its subtree is
+	 * the document and its box has no parent to rebuild it in; the
+	 * whole-document walk (419 / 447 / 459) re-cascades every element
+	 * against the DOM as it is now and restyles what changed (the hits,
+	 * the root in place) -- or declines as a rebuild would be needed.
+	 * Only when every changed child has no box (boxless): the walk goes
+	 * over the DOM, so a removed child's box would stay and a new one's
+	 * would be missing ("an element without a box would get one") */
+	if (pbox == c->layout && pbox->parent == NULL) {
+		if (!boxless)
+			RL_ROOT_NO("a child with a box changed");
+		if (html_rl_doc_noop(c, "structural change at the root") != 0)
+			return -1;
+		struct_n++;
+		macsurf_debug_log_writef("LIFE rebuild local: structural "
+			"change at the root: the document re-cascaded in %ld us "
+			"(%lu so far)", (long)(macos9_micros() - t0), struct_n);
+		return 0;
+	}
+#undef RL_ROOT_NO
 	if (pbox->type != BOX_BLOCK) {
 		macsurf_debug_log_writef("LIFE rebuild local: structural "
 			"change: the parent is not a plain block");
