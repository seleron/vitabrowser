+			more_type = (int)b->type;
+			more_anon = b->node == NULL;
+			RL_BMORE("parent holds more than blocks");
+		}
 		if (dom_node_get_parent_node(b->node, &parent) != DOM_NO_ERR)
 			RL_BNO("dom error");
