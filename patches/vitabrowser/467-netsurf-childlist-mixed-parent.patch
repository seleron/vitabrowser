+/* patch 467: a child box the placement here cannot track (an inline-level
+ * or anonymous box among the blocks) -- the parent is built again whole
+ * at decline:, as 446 and 454 do */
+#define RL_BMORE(w) do { more_why = (w); goto decline; } while (0)
 
 	/* Patch 366: blocks in a table cell: the table lays the cell out
 	 * (its width, its row's height), so the page is laid out whole */
@@ -9863,8 +9870,13 @@
 			full = true;
