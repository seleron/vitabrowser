 	bool sib_boxless = false;		/* patch 466 */
+	const char *more_why = NULL;		/* patch 467 */
+	int more_type = -1;
+	bool more_anon = false;
 	const char *obj_why = NULL;		/* patch 454 */
 	const char *obj_decl = NULL;		/* patch 457: its decline */
