# netsurf: a sibling rule's reach under a parent the rebuild cannot take -- the nearest block above (patch 469)
# Generated 2026-11-27
# Base: seleron/vitabrowser (patch stack through 468)
#
# wpnews's last full rebuild (1.0 a load): aria-expanded, which a sibling
# rule can see, toggled on a <button> whose parent <li> has no box.
# html_rl_parent_whole (445 / 448 / 450) builds the parent again whole --
# a block or a flex / grid box -- and declined silently on anything else
# (no box, a contents or inline-level box, a cell). What the rule reaches
# (the element's later siblings and their descendants) is in the parent's
# subtree, so the nearest block, flex or grid box ABOVE the parent, built
# again whole, covers it too. Climbs to below <body> (464's too-wide
# test). Logged: "sibling parent <x> box type N: the nearest block above
# it", then "a sibling rule's reach: the nearest ... above the parent".
#
--- a/content/handlers/html/html.c
+++ b/content/handlers/html/html.c
@@ -14715,6 +14715,52 @@
 		r = html_rl_block_whole(c, p, pb, macos9_micros(), what);
 	else if (pb != NULL && (pb->type == BOX_FLEX || pb->type == BOX_GRID))
 		r = html_rl_flex_whole(c, p, pb, macos9_micros(), what);
+	else {
+		/* Patch 469: a parent the rebuild cannot take -- no box, an
+		 * inline-level box, a cell (wpnews: the <button> toggling
+		 * aria-expanded). What the sibling rule reaches is in the
+		 * parent's subtree, so the nearest block, flex or grid box
+		 * ABOVE it, built again whole, covers it too -- below <body>
+		 * (464's too-wide test: that is nearly the page). */
+		extern int html_rl_too_wide(void *node);
+		dom_node *a = p, *up;
+		struct box *ab;
+		char *pt = html_rl_struct_tag(p);
+		macsurf_debug_log_writef("LIFE rebuild local: sibling parent "
+			"<%s> box type %d: the nearest block above it", pt ?
+			pt : "?", pb != NULL ? (int)pb->type : -1);
+		free(pt);
+		dom_node_ref(a);
+		while (a != NULL && !html_rl_too_wide(a)) {
+			up = NULL;
+			if (dom_node_get_parent_node(a, &up) != DOM_NO_ERR)
+				up = NULL;
+			dom_node_unref(a);
+			a = up;
+			if (a == NULL || html_rl_too_wide(a))
+				break;
+			ab = box_for_node(a);
+			if (ab != NULL && ab->type == BOX_BLOCK &&
+			    ab->parent != NULL && ab->object == NULL &&
+			    !HTML_RL_FRAME(ab)) {
+				r = html_rl_block_whole(c, a, ab,
+					macos9_micros(), "a sibling rule's "
+					"reach: the nearest block above the "
+					"parent");
+				break;
+			}
+			if (ab != NULL && (ab->type == BOX_FLEX ||
+			    ab->type == BOX_GRID)) {
+				r = html_rl_flex_whole(c, a, ab,
+					macos9_micros(), "a sibling rule's "
+					"reach: the nearest flex or grid box "
+					"above the parent");
+				break;
+			}
+		}
+		if (a != NULL)
+			dom_node_unref(a);
+	}
 	depth--;
 	dom_node_unref(p);
 	return r;
