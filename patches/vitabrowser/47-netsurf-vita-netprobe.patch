+		set_message(0, "AUTOTEST network probe - do not touch");
+		vita_netprobe_run(http, https, vita_diag_log);
+	}
 	vita_autotest = AT_SETTLE;
 	set_message(0, "AUTOTEST pass %c page 1/%u - do not touch",
 		    vita_passes[i].tag, pass_end(i) - pass_first(i));
