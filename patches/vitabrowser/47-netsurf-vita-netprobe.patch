+/**
+ * \file
+ * Vita frontend: network path probe.
+ *
+ * Hardware run 10: fetching http:// and https://example.com froze the whole
+ * app for 30 s (curl_fetch_timeout) each, then failed, while UDP to the PC
+ * worked. curl's own error text was lost (netsurf.log was capped). This
+ * probe walks the path one step at a time, bounds each step, and logs the
+ * result and its time to log.txt:
+ *
+ *   1. the DNS servers the Vita was given (sceNetCtl);
+ *   2. the system resolver with an explicit bound (sceNetResolverStartNtoa);
+ *   3. getaddrinfo(), the call curl makes -- on the Vita it is newlib's
+ *      gethostbyname() -> sceNetResolverStartNtoa(timeout 0 = default);
+ *   4. a non-blocking TCP connect bounded by select(), with select() and
+ *      poll() at timeout 0 timed on the way: curl checks a connect in
+ *      progress that way, so if they block, so does curl_multi_perform().
+ *      A freeze of exactly curl's connect timeout (30.010 s in run 10)
+ *      points there rather than at DNS;
+ *   5. curl itself, over http and https, with its error buffer and its
+ *      name-lookup / connect / TLS / total times.
+ *
+ * Run once at the start of the autotest's network pass. It blocks while
+ * it runs; each step is bounded, except (3), whose bound is the system's.
+ */
+
+#ifndef NETSURF_VITA_NETPROBE_H
+#define NETSURF_VITA_NETPROBE_H
+
+/**
+ * Probe the path to the hosts of these URLs (either may be NULL).
+ * \param log  where lines go (printf-like)
+ */
+void vita_netprobe_run(const char *http_url, const char *https_url,
+		       void (*log)(const char *fmt, ...));
+
+#endif
