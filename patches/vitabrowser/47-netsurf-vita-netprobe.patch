# netsurf: Vita network path probe (frontends/vita)
# Generated 2026-09-23
#
# Hardware run 10: http:// and https://example.com froze the whole app for
# 30.010 s each (exactly curl_fetch_timeout) and then failed, while UDP to
# the PC kept working; curl's error text was lost to the capped engine log.
# - netprobe.c/.h (new): at the start of the autotest's network pass, walk
#   the path one bounded step at a time and log each to log.txt: the DHCP
#   DNS servers; the system resolver with an explicit 3 s x 2 bound;
#   getaddrinfo() (on the Vita newlib's gethostbyname ->
#   sceNetResolverStartNtoa with timeout 0, the system default); a
#   non-blocking TCP connect, timing select() and poll() at timeout 0 on
#   the way (curl checks a connect in progress that way, so a blocking
#   zero-timeout poll would freeze curl_multi_perform); curl over http and
#   https with its error buffer and lookup / connect / TLS / total times.
# - main.c: run it before pass N's pages. Makefile: netprobe.c, and
#   -Wl,--defsym=__sce_headroom=0x4000: the SDK linker script's reserve
#   after the code segment for vita-elf-create's SCE data. Without it, this
#   build's code ended 1 008 bytes short of the 64 KiB-aligned data segment
#   and packaging failed ("Cannot allocate 3036 bytes for SCE data at end of
#   segment 0; segment 1 overlaps") -- a latent hazard of every build.
# See docs/phase-0/10-hardware-test-plan.md §Run 11.

diff --git a/frontends/vita/Makefile b/frontends/vita/Makefile
index e9c18aa79..792974f11 100644
--- a/frontends/vita/Makefile
+++ b/frontends/vita/Makefile
@@ -41,6 +41,13 @@ else
 # (vita/text.c), from the fonts bundled under res/fonts. The PGF/PVF stubs
 # stay only for libvita2d's own font objects, which are not linked unless
 # something calls them. The SceXxx_stub archives resolve firmware imports.
+# vita-elf-create appends the module's SCE data (import stubs, module info;
+# ~3 KB and growing with the import count) after the code segment. The SDK
+# linker script aligns the data segment straight after the code unless
+# __sce_headroom reserves room, so a build whose code happens to end within
+# ~3 KB of the alignment boundary fails to package ("Cannot allocate N bytes
+# for SCE data at end of segment 0; segment 1 overlaps"). Reserve 16 KiB.
+LDFLAGS += -Wl,--defsym=__sce_headroom=0x4000
 LDFLAGS += -Wl,-q -L$(VITA_QUICKJS)/lib -lquickjs \
 	-lvita2d -lfreetype -lpng -ljpeg -lbz2 -lz \
 	-lpcre2-posix -lpcre2-8 \
@@ -67,7 +74,7 @@ MESSAGES_TARGET=$(VITA_RESOURCES_DIR)
 # S_FRONTEND are sources purely for the Vita build
 S_FRONTEND := main.c window.c schedule.c fetch.c file.c layout.c bitmap.c \
 	plot.c plot_geom.c replay.c diag.c text.c netlog.c net.c jsprobe.c \
-	qjs_hooks.c js_platform.c
+	qjs_hooks.c js_platform.c netprobe.c
 
 # This is the final source build list
 # Note this is deliberately *not* expanded here as common and image
