# netsurf: a line holding an object's box (a CSS background) builds its block again whole (patch 474)
# Generated 2026-11-27
# Base: seleron/vitabrowser (patch stack through 473)
#
# "declined (an object (a background) is in the line)" -- 2.0 a load on
# the 21-site census, all rte. The line path rebuilds a block's inline
# content and frees the old line's boxes; an object entry (rte: a CSS
# background on an inline in the line) would keep pointing at one, so 374
# declined it into the full rebuild. 434's whole-block rebuild
# (html_rl_flex_restyle) carries objects over (375: html_rl_relink_subtree)
# and declines what it cannot carry; the block is now built again whole
# there instead, when it is a plain block box. Logged: "an object (a
# background) is in the line, the block built again whole".
#
--- a/content/handlers/html/html.c
+++ b/content/handlers/html/html.c
@@ -16092,6 +16092,23 @@
 		RL_NO("the line takes part in counting");
 	}
 	if (html_rl_objects_point_into(c, old_ic)) {	/* patch 374 */
+		/* Patch 474: the line path frees the old line's boxes, and an
+		 * object (rte: a CSS background on an inline in the line)
+		 * would keep pointing at one -- so it declined (2.0 a load,
+		 * all rte). 434's whole-block rebuild carries objects over
+		 * (375: html_rl_relink_subtree) and checks what it cannot
+		 * carry; the block is built again whole there instead. */
+		if (block->type == BOX_BLOCK && block->object == NULL &&
+		    !HTML_RL_FRAME(block) && block->styles != NULL) {
+			int r;
+			macsurf_debug_log_writef("LIFE rebuild local: an object "
+				"(a background) is in the line, the block built "
+				"again whole");
+			r = html_rl_flex_restyle(c, element, block, t0,
+					html_rl_class_same, true);
+			dom_node_unref(element);
+			return r;
+		}
 		dom_node_unref(element);
 		RL_NO("an object (a background) is in the line");
 	}
