# netsurf: the root restyled in place when its position changes between static, relative and sticky (patch 475)
# Generated 2026-11-27
# Base: seleron/vitabrowser (patch stack through 474)
#
# rte's last decline (1.0 a load): "sheet change: declined (an element's
# style changes, HTML)" -- a late sheet (while another still loads, 455's
# live cascade) makes <html> position: relative. 459 restyles the root in
# place when construction would decide the same, and required the same
# display, float and position. Box construction reads position only for
# absolute and fixed (box_construct.c: an absolutely positioned box);
# static, relative and sticky act at layout -- offsets, the containing
# block for absolutes -- which 459's in-place restyle redoes whole. The
# position test is now html_rl_pos_construct_same: equal, or neither
# absolute nor fixed.
#
--- a/content/handlers/html/html.c
+++ b/content/handlers/html/html.c
@@ -9188,6 +9188,20 @@
 	return r;
 }
 
+/* Patch 475: would box construction decide the same with either
+ * position? It reads position only for absolute and fixed
+ * (box_construct.c: an absolutely positioned box); static, relative and
+ * sticky act at layout (offsets, the containing block for absolutes),
+ * which 459's in-place root restyle redoes whole. rte: a late sheet makes
+ * <html> position: relative. */
+static bool html_rl_pos_construct_same(uint8_t a, uint8_t b)
+{
+	bool ap = a == CSS_POSITION_ABSOLUTE || a == CSS_POSITION_FIXED;
+	bool bp = b == CSS_POSITION_ABSOLUTE || b == CSS_POSITION_FIXED;
+
+	return a == b || (!ap && !bp);
+}
