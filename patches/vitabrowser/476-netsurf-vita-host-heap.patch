# netsurf: the simulator reports its heap (mallinfo2) where the device reports its arena (patch 476)
# Generated 2026-11-27
# Base: seleron/vitabrowser (patch stack through 475)
#
# P1 of the run-43 feedback (heavy pages take minutes on the Vita; the heap
# arena tops out near 90 MiB on bbc and github) needs a heap figure from
# the simulator to compare loads and patches. vita_diag_memory printed
# "mem[<tag>]: n/a (host simulator)" there; it now prints the host heap in
# use -- glibc's arena in-use bytes plus its mmapped blocks (large blocks
# live outside the arena on glibc; the device's one newlib arena holds
# both) -- as "mem[<tag>]: host heap in use N KiB (arena in use A KiB of
# T KiB, mmapped M KiB)". A relative proxy only: allocator overheads and
# 64-bit pointers make the host's figure larger than the device's. The
# device's line is unchanged. tools/scorecard/profile.py reads it.
#
--- a/frontends/vita/diag.c
+++ b/frontends/vita/diag.c
@@ -31,9 +31,7 @@
 #include <stdio.h>
 #include <stdlib.h>
 #include <string.h>
-#ifdef __vita__
-#include <malloc.h>
-#endif
+#include <malloc.h>	/* the device's mallinfo; the host's mallinfo2 (476) */
 #include <sys/stat.h>
 #include <sys/time.h>
 #include <time.h>
@@ -294,8 +292,22 @@
 		vita_diag_log("mem[%s]: sceKernelGetFreeMemorySize failed; "
 			      "heap in use %d KiB", tag, mi.uordblks / 1024);
 #else
-	/* glibc deprecates mallinfo(); the host numbers mean nothing here. */
-	vita_diag_log("mem[%s]: n/a (host simulator)", tag);
+	/* Patch 476: the host's heap, as a relative proxy for the device's
+	 * (newlib's one arena, mallinfo above). glibc serves large blocks
+	 * from their own mmaps, outside its arena, so "in use" is the
+	 * arena's in-use bytes plus the mmapped ones; the device's arena
+	 * holds both. Absolute sizes differ (allocator overheads, 64-bit
+	 * pointers); compare loads and patches with each other, not with
+	 * the device. */
+	{
+		struct mallinfo2 mi = mallinfo2();
+		vita_diag_log("mem[%s]: host heap in use %lu KiB (arena in use "
+			      "%lu KiB of %lu KiB, mmapped %lu KiB)", tag,
+			      (unsigned long)((mi.uordblks + mi.hblkhd) / 1024),
+			      (unsigned long)(mi.uordblks / 1024),
+			      (unsigned long)(mi.arena / 1024),
+			      (unsigned long)(mi.hblkhd / 1024));
+	}
 #endif
 }
 
