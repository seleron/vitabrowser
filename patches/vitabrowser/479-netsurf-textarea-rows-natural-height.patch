 /**
+ * VitaBrowser patch 479: a textarea's natural content height -- its rows
+ * (the attribute, as a browser parses it: a positive integer, else 2)
+ * times its line height. Browsers size an auto-height textarea this way,
+ * and box-sizing never touches it; NetSurf instead mapped rows=N to an
+ * author height of N em (css/hints.c), which border-box then shrank by
+ * the borders: Google's search field (rows=1, line-height 24px,
+ * transparent 12px top and bottom borders, border-box) came out 24px of
+ * border and no content, so a tap on the lower half of its 48px pill
+ * landed on the wrapper -- no focus, no keyboard (device run 43).
+ */
+static int vb_textarea_natural_height(
+		const css_unit_ctx *unit_len_ctx,
+		const struct box *box)
+{
+	int rows = 2;
+
+	if (box->node != NULL) {
+		dom_string *attr = NULL;
+
+		if (dom_element_get_attribute(box->node, corestring_dom_rows,
+				&attr) == DOM_NO_ERR && attr != NULL) {
+			const char *v = dom_string_data(attr);
+			char *end = NULL;
+			long n;
+
+			while (*v == ' ' || *v == '\t' || *v == '\n' ||
+					*v == '\r' || *v == '\f')
+				v++;
+			n = strtol(v, &end, 10);
+			if (end != v && n > 0)
+				rows = n > 1000 ? 1000 : (int) n;
+			dom_string_unref(attr);
+		}
+	}
+	return rows * line_height(unit_len_ctx, box->style);
+}
