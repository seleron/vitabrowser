+ * are both of the origin, so a site's pages share one map, as the spec
+ * says. Only http, https and file documents persist (about:, data: and
+ * the like have no origin worth a file). Writes go to a temporary file
+ * that then replaces the old one, so a crash mid-write cannot leave a
+ * truncated map that JSON.parse would reject. */
+static int
+macsurf_storage_path(JSContext *ctx, char *path, size_t size)
+{
+	struct content *c = qjs_get_content_for_ctx(ctx);
+	const char *dir = macsurf_storage_dir();
+	unsigned char fname[32];
+	char *origin = NULL;
+	size_t olen = 0;
+	int ok;
+
+	if (dir == NULL || c == NULL || !macos9_content_is_live(c) ||
+	    c->llcache == NULL)
+		return 0;
+	if (nsurl_get(content_get_url(c), NSURL_SCHEME | NSURL_HOST |
+			NSURL_PORT, &origin, &olen) != NSERROR_OK)
+		return 0;
+	ok = strncmp(origin, "http://", 7) == 0 ||
+	     strncmp(origin, "https://", 8) == 0 ||
+	     strncmp(origin, "file://", 7) == 0;
+	if (ok) {
+		macsurf_storage_fname(origin, fname);
+		snprintf(path, size, "%s%.*s", dir, (int)fname[0],
+				(const char *)fname + 1);
+	}
+	free(origin);
+	return ok;
+}
