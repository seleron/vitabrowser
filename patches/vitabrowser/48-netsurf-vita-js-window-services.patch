+/**
+ * The browser window a script's document is shown in, or NULL.
+ *
+ * An HTML content knows its window once it is opened (html->bw, which is
+ * also how an iframe's document finds its own child window). A document
+ * still being parsed -- where a script in <head> runs -- has no window
+ * yet; it can only be the front window's loading page. Anything else (a
+ * document already replaced, an iframe still loading) gets no window, so a
+ * stale realm can never steer the page that replaced it.
+ */
+static struct browser_window *window_for(struct content *c)
+{
+	struct browser_window *bw =
+		vita_window_browser(vita_window_current());
+	html_content *htmlc = (html_content *)c;
+
+	if (c == NULL)
+		return bw;
+	if (!macos9_content_is_live(c))
+		return NULL;
+	if (htmlc->bw != NULL)
+		return htmlc->bw;
+	if (bw != NULL && bw->loading_content != NULL &&
+	    hlcache_handle_get_content(bw->loading_content) == c)
+		return bw;
+	if (bw != NULL && bw->current_content != NULL &&
+	    hlcache_handle_get_content(bw->current_content) == c)
+		return bw;
+	return NULL;
+}
+
+/*
+ * One queued navigation or history step. Never run inside the script that
+ * asked for it: that script's document may be the one being replaced, and
+ * MacSurf navigated synchronously from inside JS. The last request of a
+ * script wins, as in browsers (location.href = a; location.href = b loads
+ * b).
+ */
+static struct {
+	bool queued;
+	struct content *c;	/**< the requesting document */
+	nsurl *url;		/**< navigate here; NULL: history step */
+	nsurl *referer;
+	bool replace;		/**< no new session-history entry */
+	int delta;		/**< history: <0 back, >0 forward, 0 reload */
+} vita_js_nav;
