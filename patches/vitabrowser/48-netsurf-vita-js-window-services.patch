+static void js_nav_clear(void)
+{
+	if (vita_js_nav.url != NULL)
+		nsurl_unref(vita_js_nav.url);
+	if (vita_js_nav.referer != NULL)
+		nsurl_unref(vita_js_nav.referer);
+	memset(&vita_js_nav, 0, sizeof(vita_js_nav));
+}
+
+static void js_nav_run(void *p)
+{
+	struct browser_window *bw;
+	nserror err = NSERROR_OK;
+
+	(void)p;
+	if (!vita_js_nav.queued)
+		return;
+	bw = window_for(vita_js_nav.c);
+	if (bw == NULL) {
+		vita_diag_log("js nav: dropped, its document is gone");
+	} else if (vita_js_nav.url != NULL) {
+		vita_diag_log("js nav: %s%s", nsurl_access(vita_js_nav.url),
+			      vita_js_nav.replace ? " (replace)" : "");
+		err = browser_window_navigate(bw, vita_js_nav.url,
+				vita_js_nav.referer,
+				vita_js_nav.replace ? 0 : BW_NAVIGATE_HISTORY,
+				NULL, NULL, NULL);
+	} else if (vita_js_nav.delta == 0) {
+		vita_diag_log("js nav: reload");
+		err = browser_window_reload(bw, false);
+	} else {
+		/* Session history is the top-level window's. Walk to the
+		 * entry; out of range does nothing (the HTML standard). */
+		struct browser_window *root = browser_window_get_root(bw);
+		struct history_entry *e = (root->history != NULL) ?
+			root->history->current : NULL;
+		int d = vita_js_nav.delta;
+
+		while (e != NULL && d < 0) {
+			e = e->back;
+			d++;
+		}
+		while (e != NULL && d > 0) {
+			e = e->forward_pref;
+			d--;
+		}
+		vita_diag_log("js nav: history %+d%s", vita_js_nav.delta,
+			      e != NULL ? "" : " (out of range)");
+		if (e != NULL)
+			err = browser_window_history_go(root, e, false);
+	}
+	if (err != NSERROR_OK)
+		vita_diag_log("js nav: failed: %d", err);
+	js_nav_clear();
+}
+
+static void js_nav_queue(struct content *c)
+{
+	vita_js_nav.queued = true;
+	vita_js_nav.c = c;
+	vita_schedule(0, js_nav_run, NULL);
+}
+
+/* exported interface documented in quickjs/macos9.h */
+char *macsurf_window_location(struct content *c)
+{
+	struct browser_window *bw;
+	lwc_string *frag = NULL;
+	nsurl *url, *full;
+	char *s;
+
+	if (c == NULL || c->llcache == NULL)
+		return NULL;
+	url = content_get_url(c);
+	/* The window's fragment is the one of the page it is loading, or
+	 * of the page it shows when it is loading nothing. */
+	bw = window_for(c);
+	if (bw != NULL && bw->frag_id != NULL) {
+		if (bw->loading_content != NULL ?
+		    hlcache_handle_get_content(bw->loading_content) == c :
+		    (bw->current_content != NULL &&
+		     hlcache_handle_get_content(bw->current_content) == c))
+			frag = bw->frag_id;
+	}
+	if (frag != NULL && nsurl_refragment(url, frag, &full) == NSERROR_OK) {
+		s = strdup(nsurl_access(full));
+		nsurl_unref(full);
+		return s;
+	}
+	return strdup(nsurl_access(url));
+}
+
+/* exported interface documented in quickjs/macos9.h */
+void macsurf_window_navigate(struct content *c, const char *url, int replace)
+{
+	nsurl *base = (c != NULL && c->llcache != NULL) ?
+		content_get_url(c) : NULL;
+	nsurl *joined = NULL;
+	nserror err;
+
+	/* location.href = "page2.html" is relative to the document. */
+	if (base != NULL)
+		err = nsurl_join(base, url, &joined);
+	else
+		err = nsurl_create(url, &joined);
+	if (err != NSERROR_OK) {
+		vita_diag_log("js nav: bad URL '%s' (%d)", url, err);
+		return;
+	}
+	js_nav_clear();
+	vita_js_nav.url = joined;
+	vita_js_nav.referer = (base != NULL) ? nsurl_ref(base) : NULL;
+	vita_js_nav.replace = replace != 0;
+	js_nav_queue(c);
+}
+
+/* exported interface documented in quickjs/macos9.h */
+void macsurf_window_history(struct content *c, int delta)
+{
+	js_nav_clear();
+	vita_js_nav.delta = delta;
+	js_nav_queue(c);
+}
