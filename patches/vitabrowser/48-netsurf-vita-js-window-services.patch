+#ifdef __vita__
+/**
+ * The system message dialog, run to completion. The page is not repainted
+ * underneath: this runs inside a script, possibly in the middle of
+ * building the page's boxes, where drawing it is not safe.
+ *
+ * 
+eturn 1 for OK / Yes, 0 for No / cancel, -1 if it could not be shown
+ */
+static int msg_dialog(const char *msg, int ask)
+{
+	SceMsgDialogUserMessageParam user;
+	SceMsgDialogParam param;
+	SceMsgDialogResult result;
+	char text[500];
+	size_t n = strlen(msg);
+	int r;
+
+	/* The dialog takes at most 512 bytes; cut on a UTF-8 boundary. */
+	if (n >= sizeof(text)) {
+		n = sizeof(text) - 1;
+		while (n > 0 && ((unsigned char)msg[n] & 0xc0) == 0x80)
+			n--;
+	}
+	memcpy(text, msg, n);
+	text[n] = '\0';
+
+	memset(&user, 0, sizeof(user));
+	user.buttonType = ask ? SCE_MSG_DIALOG_BUTTON_TYPE_YESNO :
+		SCE_MSG_DIALOG_BUTTON_TYPE_OK;
+	user.msg = (const SceChar8 *)text;
+	sceMsgDialogParamInit(&param);
+	param.mode = SCE_MSG_DIALOG_MODE_USER_MSG;
+	param.userMsgParam = &user;
+	r = sceMsgDialogInit(&param);
+	if (r < 0) {
+		vita_diag_log("js dialog: sceMsgDialogInit -> 0x%08x", r);
+		return -1;
+	}
+	while (sceMsgDialogGetStatus() == SCE_COMMON_DIALOG_STATUS_RUNNING) {
+		vita2d_start_drawing();
+		vita2d_clear_screen();
+		vita2d_end_drawing();
+		vita2d_common_dialog_update();
+		vita2d_swap_buffers();
+		sceKernelDelayThread(16 * 1000);
+	}
+	memset(&result, 0, sizeof(result));
+	r = sceMsgDialogGetResult(&result);
+	sceMsgDialogTerm();
+	if (r < 0)
+		return -1;
+	return (result.buttonId == SCE_MSG_DIALOG_BUTTON_ID_YES) ? 1 : 0;
+}
+#endif
+
+/* exported interface documented in quickjs/macos9.h */
+int macsurf_window_dialog(struct content *c, const char *msg, int ask,
+		double *blocked_ms)
+{
+	unsigned int t0 = vita_diag_ms();
+	int r = 1;
+
+	(void)c;
+	*blocked_ms = 0.0;
+#ifdef __vita__
+	if (!vita_js_dialog_auto) {
+		r = msg_dialog(msg, ask);
+		*blocked_ms = (double)(vita_diag_ms() - t0);
+		vita_diag_log("js %s: \"%.200s\" -> %s after %u ms",
+			      ask ? "confirm" : "alert", msg,
+			      r < 0 ? "not shown" : r ? "OK" : "cancel",
+			      vita_diag_ms() - t0);
+		/* Could not ask: an alert is as good as read, a confirm is
+		 * a no. */
+		return r < 0 ? !ask : r;
+	}
+#endif
+	/* The autotest (and the simulator) cannot press buttons: answer
+	 * OK at once, and say so. */
+	vita_diag_log("js %s (auto OK): \"%.200s\"", ask ? "confirm" : "alert",
+		      msg);
+	(void)t0;
+	return r;
+}
