# netsurf: setAttribute throws InvalidCharacterError for a name the DOM refuses (patch 485)
# Generated 2026-11-27
# Base: seleron/vitabrowser (patch stack through 484)
#
# Pairs with 485-libdom-attribute-names-html.patch: libdom takes any HTML
# attribute name now and refuses the ones the DOM standard refuses, but the
# bridge's setAttribute swallowed the error. vita_polyfill.js wraps
# setAttribute on every element prototype that owns one: an empty name, or
# one with ASCII whitespace, NUL, '/', '=' or '>', throws
# InvalidCharacterError, as in browsers.
--- a/content/handlers/javascript/quickjs/vita_polyfill.js
+++ b/content/handlers/javascript/quickjs/vita_polyfill.js
@@ -6452,6 +6452,38 @@
 	});
 })();
 
+/* ---- patch 485: setAttribute refuses what the DOM refuses ---------------
+ * libdom now takes any HTML attribute name (lit's `name$lit$` markers), and
+ * refuses the names the DOM standard refuses -- empty, or containing ASCII
+ * whitespace, NUL, '/', '=' or '>' -- but the bridge's setAttribute
+ * swallowed that error. A page testing for the InvalidCharacterError
+ * (feature detection, sanitizers) saw success. */
+(function () {
+	var d = g.document;
+	if (!d) return;
+	var BAD = /[\t\n\f\r \u0000\/=>]/;
+	function wrap(t) {
+		var orig = t.setAttribute;
+		if (typeof orig !== 'function' || PV(orig).__vbAttrName) return;
+		var w = function setAttribute(name, value) {
+			var n = String(name);
+			if (n.length === 0 || BAD.test(n)) {
+				throw new DOMException("Failed to execute 'setAttribute' on 'Element': '" +
+					n + "' is not a valid attribute name.", 'InvalidCharacterError');
+			}
+			return orig.apply(this, arguments);
+		};
+		PV(w).__vbAttrName = true;
+		try { Object.defineProperty(t, 'setAttribute', { value: w, writable: true, configurable: true }); } catch (x) { /* */ }
+	}
+	try {
+		for (var p = Object.getPrototypeOf(d.createElement('section')); p; p = Object.getPrototypeOf(p))
+			if (Object.prototype.hasOwnProperty.call(p, 'setAttribute')) wrap(p);
+		if (g.HTMLElement && Object.prototype.hasOwnProperty.call(g.HTMLElement.prototype, 'setAttribute'))
+			wrap(g.HTMLElement.prototype);
+	} catch (x) { /* */ }
+})();
+
