+/**
+ * \file
+ * Name lookup for the curl fetcher, done by the frontend without blocking
+ * (WITH_CURL_ASYNC_RESOLVE).
+ *
+ * A libcurl built without its threaded or c-ares resolver -- vitaSDK's is
+ * one -- looks names up with a blocking getaddrinfo() inside
+ * curl_multi_perform(), on the only thread the browser has. A DNS server
+ * that does not answer then freezes everything for curl's whole connect
+ * timeout (hardware run 11: 30 s per page). With this switch the fetcher
+ * asks the frontend first and hands curl the answer with CURLOPT_RESOLVE,
+ * so curl never resolves by itself; a fetch whose name is still being
+ * looked up waits in the fetch queue, and one whose lookup failed ends
+ * with CURLE_COULDNT_RESOLVE_HOST at once.
+ */
+
+#ifndef NETSURF_CONTENT_FETCHERS_CURL_RESOLVE_H
+#define NETSURF_CONTENT_FETCHERS_CURL_RESOLVE_H
+
+#include <stddef.h>
+
+enum fetch_curl_resolve_result {
+	FETCH_CURL_RESOLVE_READY,	/**< addr holds the address, or ""
+					 * when curl needs no help (the
+					 * host is an address itself) */
+	FETCH_CURL_RESOLVE_PENDING,	/**< being looked up; ask again */
+	FETCH_CURL_RESOLVE_FAILED	/**< no such name, or no answer */
+};
+
+/**
+ * Look a host name up without blocking. Implemented by the frontend.
+ *
+ * \param host  the host name, as in the URL
+ * \param addr  receives the numeric address on READY
+ * \param size  size of addr (46 bytes holds any address)
+ */
+enum fetch_curl_resolve_result
+fetch_curl_resolve(const char *host, char *addr, size_t size);
+
+#endif
