+ *
+ * 
+eturn false while the lookup is pending: the fetch stays queued, and
+ *	   the queue is asked again shortly.
+ */
+static bool fetch_curl_resolve_host(struct curl_fetch_info *fetch)
+{
+	char addr[64], entry[400];
+	const char *host = lwc_string_data(fetch->host);
+	lwc_string *port_s;
+	long port;
+
+	if (fetch->resolve != NULL || fetch->dns_failed)
+		return true;	/* decided on an earlier attempt */
+	switch (fetch_curl_resolve(host, addr, sizeof(addr))) {
+	case FETCH_CURL_RESOLVE_PENDING:
+		NSLOG(netsurf, DEBUG, "Deferring fetch: looking up %s", host);
+		guit->misc->schedule(FETCH_CURL_RESOLVE_RETRY_MS,
+				fetch_kick, NULL);
+		return false;
+	case FETCH_CURL_RESOLVE_FAILED:
+		NSLOG(netsurf, INFO, "No address for %s", host);
+		fetch->dns_failed = true;
+		return true;
+	case FETCH_CURL_RESOLVE_READY:
+		break;
+	}
+	if (addr[0] == '\0')
+		return true;	/* an address already: curl needs no help */
+
+	port_s = nsurl_get_component(fetch->url, NSURL_PORT);
+	if (port_s != NULL) {
+		port = strtol(lwc_string_data(port_s), NULL, 10);
+		lwc_string_unref(port_s);
+	} else {
+		port = (nsurl_get_scheme_type(fetch->url) ==
+				NSURL_SCHEME_HTTPS) ? 443 : 80;
+	}
+	snprintf(entry, sizeof(entry), "%s:%ld:%s", host, port, addr);
+	fetch->resolve = curl_slist_append(NULL, entry);
+	/* Without the list curl would resolve by itself: fail instead. */
+	if (fetch->resolve == NULL)
+		fetch->dns_failed = true;
+	return true;
+}
+#endif
+
 
