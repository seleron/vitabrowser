+ * GNU General Public License for more details.
+ *
+ * You should have received a copy of the GNU General Public License
+ * along with this program.  If not, see <http://www.gnu.org/licenses/>.
+ */
+
+/**
+ * \file
+ * Vita frontend: name lookup for the curl fetcher, off the main thread
+ * (content/fetchers/curl_resolve.h).
+ *
+ * Hardware run 11: vitaSDK's libcurl has no asynchronous resolver, so curl
+ * looked names up with newlib's getaddrinfo() -> gethostbyname() ->
+ * sceNetResolverStartNtoa() with the system's default bound, inside
+ * curl_multi_perform(). With a DNS server that did not answer, the whole
+ * browser froze for curl's 30 s connect timeout per page.
+ *
+ * Here one worker thread does the lookups, one at a time, each bounded
+ * (on the Vita: sceNetResolverStartNtoa, 2 s x 2 tries); the main thread
+ * only reads a small cache. IPv4 only: the Vita has no IPv6.
+ */
+
+#include <stdbool.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <time.h>
+#include <pthread.h>
+#include <arpa/inet.h>
+#include <netinet/in.h>
+#include <sys/socket.h>
+#include <netdb.h>
+
+#ifdef __vita__
+#include <psp2/net/net.h>
+#endif
+
+#include "content/fetchers/curl_resolve.h"
+
+#include "vita/diag.h"
+#include "vita/resolve.h"
+
+/** Remember answers this long, ms. */
+#define RESOLVE_OK_TTL_MS (5 * 60 * 1000)
+/** ...and failures this long, so a page's many requests to a dead name
+ * fail together instead of one lookup each. */
+#define RESOLVE_FAIL_TTL_MS (15 * 1000)
+/** On the Vita: per try, us, and tries. */
+#define RESOLVE_TIMEOUT_US (2 * 1000 * 1000)
+#define RESOLVE_TRIES 2
+
+#define RESOLVE_SLOTS 32
+#define RESOLVE_HOST_MAX 256
+
+enum slot_state { SLOT_FREE, SLOT_QUEUED, SLOT_BUSY, SLOT_OK, SLOT_FAILED };
+
+static struct resolve_slot {
+	enum slot_state state;
+	char host[RESOLVE_HOST_MAX];
+	char addr[INET_ADDRSTRLEN];
+	unsigned int done_ms;	/**< when the answer arrived */
+	unsigned int asked_ms;	/**< when the fetcher first asked */
+} slots[RESOLVE_SLOTS];
+
+static pthread_mutex_t lock = PTHREAD_MUTEX_INITIALIZER;
+static pthread_cond_t wake = PTHREAD_COND_INITIALIZER;
+static bool worker_started;
+static bool worker_failed;
+
+/** Counters for the log. */
+static unsigned int n_lookups, n_failed, n_hits;
+
+/** Finished lookups for the log, which is main-thread code
+ * (vita_resolve_poll() writes them). */
+#define RESOLVE_LOG_LINES 8
+static char log_lines[RESOLVE_LOG_LINES][320];
+static unsigned int log_head, log_tail;
+
+/**
+ * One bounded lookup; on success addr holds a dotted quad.
+ *
+ * \return 0 or an error code for the log
+ */
+static int lookup(const char *host, char *addr, size_t size)
+{
+#ifdef __vita__
+	SceNetInAddr sa;
+	struct in_addr in;
+	int rid, r;
+
+	rid = sceNetResolverCreate("vbdns", NULL, 0);
+	if (rid < 0)
+		return rid;
+	r = sceNetResolverStartNtoa(rid, host, &sa, RESOLVE_TIMEOUT_US,
+				    RESOLVE_TRIES, 0);
+	sceNetResolverDestroy(rid);
+	if (r < 0)
+		return r;
+	memcpy(&in, &sa, sizeof(in));
+	inet_ntop(AF_INET, &in, addr, size);
+	return 0;
+#else
+	struct addrinfo hints, *res = NULL;
+	int r;
+
+#ifdef VITA_HOST_SIM
+	/* The simulator's stand-in for a DNS server that never answers:
+	 * any *.sim-hang name takes the Vita's worst case, then fails. */
+	size_t n = strlen(host);
+	if (n > 9 && strcmp(host + n - 9, ".sim-hang") == 0) {
+		struct timespec ts = { RESOLVE_TRIES * RESOLVE_TIMEOUT_US /
+				       1000000, 0 };
+		nanosleep(&ts, NULL);
+		return -1;
+	}
+#endif
+	memset(&hints, 0, sizeof(hints));
+	hints.ai_family = AF_INET;
+	hints.ai_socktype = SOCK_STREAM;
+	r = getaddrinfo(host, NULL, &hints, &res);
+	if (r != 0 || res == NULL)
+		return r != 0 ? r : -1;
+	inet_ntop(AF_INET, &((struct sockaddr_in *)res->ai_addr)->sin_addr,
+		  addr, size);
+	freeaddrinfo(res);
+	return 0;
+#endif
+}
+
+static void *worker(void *unused)
+{
+	(void)unused;
+	pthread_mutex_lock(&lock);
+	for (;;) {
+		struct resolve_slot *s = NULL;
+		char host[RESOLVE_HOST_MAX], addr[INET_ADDRSTRLEN];
+		unsigned int t0;
+		int i, r;
+
+		for (i = 0; i < RESOLVE_SLOTS && s == NULL; i++)
+			if (slots[i].state == SLOT_QUEUED)
+				s = &slots[i];
+		if (s == NULL) {
+			pthread_cond_wait(&wake, &lock);
+			continue;
+		}
+		s->state = SLOT_BUSY;
+		memcpy(host, s->host, sizeof(host));
+		pthread_mutex_unlock(&lock);
+
+		t0 = vita_diag_ms();
+		addr[0] = '\0';
+		r = lookup(host, addr, sizeof(addr));
+
+		pthread_mutex_lock(&lock);
+		/* The slot is ours while BUSY: nothing else reuses it. */
+		s->state = (r == 0) ? SLOT_OK : SLOT_FAILED;
+		memcpy(s->addr, addr, sizeof(s->addr));
+		s->done_ms = vita_diag_ms();
+		n_lookups++;
+		if (r != 0)
+			n_failed++;
+		if (log_head - log_tail < RESOLVE_LOG_LINES) {
+			char *l = log_lines[log_head++ % RESOLVE_LOG_LINES];
+			if (r == 0)
+				snprintf(l, sizeof(log_lines[0]),
+					 "dns: %.200s -> %s in %u ms", host,
+					 addr, s->done_ms - t0);
+			else
+				snprintf(l, sizeof(log_lines[0]),
+					 "dns: %.200s -> FAILED (%d / 0x%08x) "
+					 "in %u ms", host, r, (unsigned int)r,
+					 s->done_ms - t0);
+		}
+	}
+	return NULL;
+}
+
+/** Start the worker on first use. Called with the lock held. */
+static bool start_worker(void)
+{
+	pthread_attr_t attr;
+	pthread_t t;
+
+	if (worker_started || worker_failed)
+		return worker_started;
+	pthread_attr_init(&attr);
+	pthread_attr_setstacksize(&attr, 64 * 1024);
+	pthread_attr_setdetachstate(&attr, PTHREAD_CREATE_DETACHED);
+	if (pthread_create(&t, &attr, worker, NULL) == 0)
+		worker_started = true;
+	else
+		worker_failed = true;
+	pthread_attr_destroy(&attr);
+	return worker_started;
+}
+
+/** Is host an IPv4 or IPv6 address (curl needs no lookup)? */
+static bool is_address(const char *host)
+{
+	struct in_addr a;
+
+	return inet_pton(AF_INET, host, &a) == 1 || strchr(host, ':') != NULL;
+}
+
+/* exported interface documented in content/fetchers/curl_resolve.h */
+enum fetch_curl_resolve_result
+fetch_curl_resolve(const char *host, char *addr, size_t size)
+{
+	enum fetch_curl_resolve_result result;
+	struct resolve_slot *s = NULL, *oldest = NULL;
+	unsigned int now = vita_diag_ms();
+	int i;
+
+	addr[0] = '\0';
+	if (is_address(host) || strlen(host) >= RESOLVE_HOST_MAX)
+		return FETCH_CURL_RESOLVE_READY;
+
+	pthread_mutex_lock(&lock);
+	for (i = 0; i < RESOLVE_SLOTS; i++) {
+		struct resolve_slot *c = &slots[i];
+		if (c->state == SLOT_FREE)
+			continue;
+		/* Expire finished answers. */
+		if ((c->state == SLOT_OK &&
+		     now - c->done_ms > RESOLVE_OK_TTL_MS) ||
+		    (c->state == SLOT_FAILED &&
+		     now - c->done_ms > RESOLVE_FAIL_TTL_MS)) {
+			c->state = SLOT_FREE;
+			continue;
+		}
+		if (strcmp(c->host, host) == 0)
+			s = c;
+	}
+	if (s == NULL) {
+		if (!start_worker()) {
+			/* No thread: let curl look it up, blocking, as it
+			 * did before. */
+			pthread_mutex_unlock(&lock);
+			return FETCH_CURL_RESOLVE_READY;
+		}
+		for (i = 0; i < RESOLVE_SLOTS && s == NULL; i++)
+			if (slots[i].state == SLOT_FREE)
+				s = &slots[i];
+		for (i = 0; i < RESOLVE_SLOTS && s == NULL; i++) {
+			/* Full: reuse the oldest finished answer. */
+			struct resolve_slot *c = &slots[i];
+			if ((c->state == SLOT_OK || c->state == SLOT_FAILED) &&
+			    (oldest == NULL || c->done_ms < oldest->done_ms))
+				oldest = c;
+		}
+		if (s == NULL)
+			s = oldest;
+		if (s == NULL) {
+			/* 32 lookups in flight: wait for one to finish. */
+			pthread_mutex_unlock(&lock);
+			return FETCH_CURL_RESOLVE_PENDING;
+		}
+		memset(s, 0, sizeof(*s));
+		snprintf(s->host, sizeof(s->host), "%s", host);
+		s->state = SLOT_QUEUED;
+		s->asked_ms = now;
+		pthread_cond_signal(&wake);
+	}
+	switch (s->state) {
+	case SLOT_OK:
+		snprintf(addr, size, "%s", s->addr);
+		n_hits++;
+		result = FETCH_CURL_RESOLVE_READY;
+		break;
+	case SLOT_FAILED:
+		result = FETCH_CURL_RESOLVE_FAILED;
+		break;
+	default:
+		result = FETCH_CURL_RESOLVE_PENDING;
+		break;
+	}
+	pthread_mutex_unlock(&lock);
+	return result;
+}
+
+/* exported interface documented in vita/resolve.h */
+void vita_resolve_poll(void)
+{
+	char line[sizeof(log_lines[0])];
+	unsigned int lookups, failed, hits;
+
+	for (;;) {
+		pthread_mutex_lock(&lock);
+		if (log_tail == log_head) {
+			pthread_mutex_unlock(&lock);
+			return;
+		}
+		memcpy(line, log_lines[log_tail++ % RESOLVE_LOG_LINES],
+		       sizeof(line));
+		lookups = n_lookups;
+		failed = n_failed;
+		hits = n_hits;
+		pthread_mutex_unlock(&lock);
+		vita_diag_log("%s (%u lookups, %u failed, %u cache hits)",
+			      line, lookups, failed, hits);
+	}
+}
