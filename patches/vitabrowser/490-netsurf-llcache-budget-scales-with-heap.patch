# netsurf: the low-level cache budget scales with the heap (patch 490)
# Generated 2026-11-27
# Base: seleron/vitabrowser (patch stack through 489)
#
# P1 (load time + RAM): the Vita frontend never set memory_cache_size, so
# llcache ran on NetSurf's default 12 MiB. A session re-fetched what it had
# just had: in the simulator, bbc -> youtube -> github -> bbc re-created 95
# network objects, 87 of them bbc's on the revisit (run 43 on the device:
# 942 llcache adds, 909 reclaims, 901 frees in one session).
#
# main.c sets it to an eighth of the heap after nsoption_init: 24 MiB on
# the default VPK (192 MiB heap), 36 MiB on the extended one (288, patch
# 489). The cache holds sources (compressed images, scripts, sheets), not
# decoded bitmaps.
#
# Same session at 24 MiB: re-created 95 -> 1 (bbc's revisit 87 -> 1), the
# bbc revisit Done 3.4 -> 2.2 s, session heap peak 142.3 -> 143.6 MiB (+1%).
--- a/frontends/vita/main.c
+++ b/frontends/vita/main.c
@@ -1554,6 +1554,15 @@
 	/* JavaScript: QuickJS-ng with MacSurf's DOM bridge (NetSurf's default
 	 * is off). */
 	nsoption_set_bool(enable_javascript, true);
+	/* VitaBrowser patch 490: the low-level cache's budget scales with the
+	 * heap -- an eighth of it: 24 MiB on the default VPK (192 MiB heap),
+	 * 36 MiB on the extended one (288, patch 489). NetSurf's default was
+	 * 12 MiB, so a session re-fetched what it had just had: bbc -> youtube
+	 * -> github -> bbc in the simulator re-created 87 of bbc's objects on
+	 * the revisit (run 43 on the device: 942 adds, 909 reclaims, 901 frees).
+	 * The cache holds sources (compressed images, scripts, sheets), not
+	 * decoded bitmaps. */
+	nsoption_set_int(memory_cache_size, (VITA_HEAP_MB / 8) * 1024 * 1024);
 	vita_js_platform_init();
 	/* Missing messages only lose UI strings; not fatal. */
 	ret = messages_add_from_file(VITA_RESOURCE_DIR "Messages");
