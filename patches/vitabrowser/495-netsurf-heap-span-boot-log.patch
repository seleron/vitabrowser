# netsurf: boot-log the newlib heap the runtime actually granted (patch 495)
# Generated 2026-11-27
# Base: seleron/vitabrowser (patch stack through 494)
#
# Run 44 (ext-mem VPK, 288 MiB newlib heap): the app sometimes died at
# launch and the receiver saw nothing. The vitaSDK runtime's
# _init_vita_heap (libc sbrk.o, read from its disassembly: the SDK ships no
# source) allocates _newlib_heap_size_user as ONE sceKernelAllocMemBlock
# (type 0x0c20d060, user RW) before main and never clamps -- it gets the
# whole request or nothing (heap base 0, every malloc fails, death before
# netlog starts). Its heap globals are file-static, and _get_vita_heap_size
# returns the REQUESTED size even on failure, so neither proves anything.
#
# vita_diag_heap_span() asks the kernel about the block a live malloc
# pointer sits in (sceKernelGetMemBlockInfoByAddr: mappedBase/mappedSize)
# and logs "mem: runtime heap span N MiB at 0x... (requested M MiB)",
# with " -- MISMATCH" if they differ, next to patch 489's "mem: newlib
# heap" line. The ext build now asks for 256 MiB (tools/build-vita.sh).
# Host simulator: logged as not applicable.
--- a/frontends/vita/main.c
+++ b/frontends/vita/main.c
@@ -104,7 +104,14 @@
  * tools/build-vita.sh now relinks the ext ELF with VITA_HEAP_MB=288 (run
  * 43, default VPK: 32 MiB of user memory free after init beside the heap;
  * 288 keeps ~45 MiB free in the ext budget). Textures come from CDRAM
- * first (bitmap.c), not this heap. */
+ * first (bitmap.c), not this heap.
+ *
+ * Patch 495: the ext build now asks for 256 (tools/build-vita.sh,
+ * VITA_EXT_HEAP_MB). The runtime allocates the heap as ONE block before
+ * main and never clamps -- all or nothing -- so an ext launch that cannot
+ * get a contiguous 288 MiB block dies before netlog starts (run 44's
+ * "crash at launch, not detected"). Run 44's peak engine heap was
+ * ~22 MiB; 256 is >10x that. Boot logs "mem: runtime heap span". */
 #ifndef VITA_HEAP_MB
 #define VITA_HEAP_MB 192
 #endif
@@ -1523,6 +1530,8 @@
 	load_net_pages();
 	/* patch 489: which budget this build has (the ext VPK's is larger) */
 	vita_diag_log("mem: newlib heap %d MiB", VITA_HEAP_MB);
+	/* patch 495: and what the runtime actually granted */
+	vita_diag_heap_span((unsigned int)_newlib_heap_size_user);
 	vita_diag_memory("boot");
 
