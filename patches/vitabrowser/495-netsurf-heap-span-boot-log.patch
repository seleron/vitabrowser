+/**
+ * Patch 495: log the newlib heap the runtime actually granted -- the
+ * kernel memory block a live malloc pointer sits in -- against the
+ * requested size. The vitaSDK runtime (_init_vita_heap) allocates the
+ * whole request as ONE block before main and never clamps: it either gets
+ * all of it or none (heap base 0, every malloc fails, the app dies before
+ * netlog starts). Host simulator: logged as not applicable.
+ */
+void vita_diag_heap_span(unsigned int requested_bytes);
+
 /** Allocate-until-failure in each pool, log the totals, free it all. */
 void vita_diag_mem_probe(void);
 
