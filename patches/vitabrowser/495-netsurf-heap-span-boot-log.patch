+/* exported interface documented in vita/diag.h */
+void vita_diag_heap_span(unsigned int requested_bytes)
+{
+#ifdef __vita__
+	void *probe = malloc(16);
+	SceKernelMemBlockInfo bi;
+	int rc;
+
+	if (probe == NULL) {
+		vita_diag_log("mem: runtime heap NOT granted: malloc fails "
+			      "(requested %u MiB)", requested_bytes >> 20);
+		return;
+	}
+	memset(&bi, 0, sizeof(bi));
+	bi.size = sizeof(bi);
+	rc = sceKernelGetMemBlockInfoByAddr(probe, &bi);
+	if (rc < 0)
+		vita_diag_log("mem: runtime heap span unknown "
+			      "(sceKernelGetMemBlockInfoByAddr 0x%08x; "
+			      "requested %u MiB)", (unsigned int)rc,
+			      requested_bytes >> 20);
+	else
+		vita_diag_log("mem: runtime heap span %lu MiB at 0x%08lx, type "
+			      "0x%08x (requested %u MiB)%s",
+			      (unsigned long)(bi.mappedSize >> 20),
+			      (unsigned long)(uintptr_t)bi.mappedBase,
+			      (unsigned int)bi.type,
+			      requested_bytes >> 20,
+			      (unsigned long)bi.mappedSize == (unsigned long)requested_bytes ?
+			      "" : " -- MISMATCH");
+	free(probe);
+#else
+	vita_diag_log("mem: runtime heap span: host simulator (glibc heap; "
+		      "requested %u MiB not applied)", requested_bytes >> 20);
+#endif
+}
+
 /** malloc 1 MiB chunks until failure; returns how many succeeded. */
 static int probe_heap(void)
 {
