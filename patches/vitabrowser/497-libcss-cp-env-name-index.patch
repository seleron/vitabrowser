+/* VitaBrowser patch 497: the environment's name index.
+ *
+ * css__cp_env_add scanned the element's bindings once per definition
+ * (quadratic for a rule that defines hundreds of custom properties: the
+ * root variable blocks of github.com's Primer and theguardian.com), and
+ * css__cp_env_find scanned every ancestor level once per var(). In the
+ * simulator cp_name_equal under these two was ~18% of github's
+ * main-thread time after patch 496. Each environment with
+ * CP_ENV_INDEX_MIN or more own bindings now keeps a hash index over
+ * them by NORMALISED name (the same up-to-two-leading-dashes rule as
+ * cp_name_equal, so "-x" and "--x" hash alike); a probe hit is still
+ * confirmed by cp_name_equal. An add only ever replaces a binding's name
+ * with an equal one, and nothing reorders or removes items, so the index
+ * stays valid for the environment's life. Without an index (few
+ * bindings, or no memory) the scan answers, as before. */
+#define CP_ENV_INDEX_MIN 8
+
+static uint32_t cp_name_hash(lwc_string *s)
+{
+	const char *d = lwc_string_data(s);
+	size_t l = lwc_string_length(s);
+	uint32_t h = 2166136261u;
+
+	if (l >= 2 && d[0] == '-' && d[1] == '-') {
+		d += 2;
+		l -= 2;
+	} else if (l >= 1 && d[0] == '-') {
+		d += 1;
+		l -= 1;
+	}
+	while (l-- > 0) {
+		h ^= (unsigned char)*d++;
+		h *= 16777619u;
+	}
+	return h;
+}
+
+static void cp_env_index_put(css_cp_env *e, uint32_t h, uint32_t item)
+{
+	uint32_t mask = e->hcap - 1, k = h & mask;
+
+	while (e->hidx[k] != 0)
+		k = (k + 1) & mask;
+	e->hidx[k] = item + 1;
+}
+
+/* (Re)build the index for every binding, at least twice as many slots
+ * as bindings. Out of memory: no index (lookups scan). */
+static void cp_env_index_build(css_cp_env *e)
+{
+	uint32_t cap = e->hcap ? e->hcap * 2 : 32, i;
+	uint32_t *nx;
+
+	while (cap < e->used * 2 + 2)
+		cap *= 2;
+	nx = (uint32_t *)calloc(cap, sizeof(uint32_t));
+	free(e->hidx);
+	e->hidx = nx;
+	e->hcap = nx != NULL ? cap : 0;
+	if (nx == NULL)
+		return;
+	for (i = 0; i < e->used; i++)
+		cp_env_index_put(e, cp_name_hash(e->items[i].entry.name), i);
+}
+
+/* The binding named name in e alone, or -1 */
+static int32_t cp_env_lookup(const css_cp_env *e, lwc_string *name,
+		uint32_t h)
+{
+	uint32_t i;
+
+	if (e->hidx != NULL) {
+		uint32_t mask = e->hcap - 1, k = h & mask;
+
+		while (e->hidx[k] != 0) {
+			i = e->hidx[k] - 1;
+			if (cp_name_equal(e->items[i].entry.name, name))
+				return (int32_t)i;
+			k = (k + 1) & mask;
+		}
+		return -1;
+	}
+	for (i = 0; i < e->used; i++)
+		if (cp_name_equal(e->items[i].entry.name, name))
+			return (int32_t)i;
+	return -1;
+}
+
+#ifdef VITA_CPENV_CHECK
+static unsigned long cpenv_checked, cpenv_mismatch;
+static void cpenv_report(void)
+{
+	fprintf(stderr, "CPENVCHECK checked %lu, mismatches %lu\n",
+			cpenv_checked, cpenv_mismatch);
+}
+static void cpenv_count(bool same)
+{
+	if (cpenv_checked++ == 0)
+		atexit(cpenv_report);
+	if (!same) {
+		cpenv_mismatch++;
+		fprintf(stderr, "CPENVCHECK mismatch #%lu\n", cpenv_mismatch);
+	}
+}
+static int32_t cp_env_lookup_linear(const css_cp_env *e, lwc_string *name)
+{
+	uint32_t i;
+	for (i = 0; i < e->used; i++)
+		if (cp_name_equal(e->items[i].entry.name, name))
+			return (int32_t)i;
+	return -1;
+}
+#endif
