# netsurf: the form named-access pre-check memoises on the name generation (patch 498)
# Generated 2026-11-28
# Base: seleron/vitabrowser (patch stack through 497)
#
# vita_polyfill.js anyNamed (patch 322; memo from 324) answers "can any
# element carry the name n" with getElementById plus a whole-document
# querySelectorAll of the listed elements and <img>. Patch 305 asks it on
# EVERY member read on a form (a control named "parentNode" shadows
# form.parentNode, as in browsers), so DOM walks that pass a form ask it
# constantly; claude.ai's sign-in page asked ~14,000 times per load
# (parentNode, tagName, nodeType, localName) and 324's memo, keyed on the
# whole-tree generation, missed on 3019 of them (class/style churn).
#
# The memo is now keyed on __vitaDomNameGen() (libdom's name generation:
# attach, detach, replace, id / name attributes -- patch 498's libdom half),
# falling back to __vitaDomGen. With __vitaNamedCheck set (a sim inject),
# every memo hit is recomputed and disagreements counted: the
# verification described in doc 10.
--- a/content/handlers/javascript/quickjs/macsurf_qjs.c
+++ b/content/handlers/javascript/quickjs/macsurf_qjs.c
@@ -4905,6 +4905,21 @@
 	return JS_NewFloat64(ctx, (double)dom_tree_generation());
 }
 
+/* VitaBrowser patch 498: __vitaDomNameGen() -> libdom's NAME generation,
+ * which moves only on an attach, detach or replace, or an id / name
+ * attribute change (libdom core/node.c dom_name_gen). The form
+ * named-access pre-check (vita_polyfill.js anyNamed) keys its memo on it:
+ * its answer depends on which elements are in the document and on their
+ * ids and names, nothing else. */
+extern unsigned long dom_tree_name_generation(void);
+
+static JSValue qjs_dom_name_gen(JSContext *ctx, JSValueConst this_val,
+		int argc, JSValueConst *argv)
+{
+	(void)this_val; (void)argc; (void)argv;
+	return JS_NewFloat64(ctx, (double)dom_tree_name_generation());
+}
+
 /* __vitaResourceTake() -> this realm's entries finished since the last
  * call: [[url, initiatorType, startTime, responseEnd, size, status, type,
  * Timing-Allow-Origin or null], ...],
@@ -16173,6 +16188,7 @@
 	qjs_set_func(ctx, global, "__msRafTimeout", qjs_raf_timeout, 1);	/* patch 281 */
 	qjs_set_func(ctx, global, "__vitaResourceTake", qjs_rt_take, 0);	/* patch 282 */
 	qjs_set_func(ctx, global, "__vitaDomGen", qjs_dom_gen, 0);	/* patch 324 */
+	qjs_set_func(ctx, global, "__vitaDomNameGen", qjs_dom_name_gen, 0);	/* patch 498 */
 	qjs_set_func(ctx, global, "setInterval",   qjs_setinterval, 2);
 	qjs_set_func(ctx, global, "clearTimeout",  qjs_cleartimeout, 1);
 	qjs_set_func(ctx, global, "clearInterval", qjs_cleartimeout, 1);
