+			/* patch 498: keyed on the NAME generation (attach, detach,
+			 * replace, id / name attributes), which is all the answer
+			 * depends on; the tree generation also moved on every class
+			 * and style change, so on a page that animates by attribute
+			 * (claude.ai: 3019 generations in 14,000 calls) the memo
+			 * missed and each call ran a whole-document query */
+			var gen = typeof g.__vitaDomNameGen === 'function' ? g.__vitaDomNameGen() :
+				typeof g.__vitaDomGen === 'function' ? g.__vitaDomGen() : null,
+				pv = gen !== null ? PV(doc) : null, memo = null, key = tags + '\n' + n, r = false,
+				hit = false, hitv;
 			if (pv) {
 				if (pv.namedGen !== gen) { pv.namedGen = gen; pv.namedMemo = new Map(); }
 				memo = pv.namedMemo;
-				if (memo.has(key)) return memo.get(key);
