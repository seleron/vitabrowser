# netsurf: the autotest waits out a page's own post-load timers
# Generated 2026-09-23
#
# Hardware run 12: JS-window (page 18) did everything right on the Vita --
# every navigation, history step and dialog is in the log -- but its dump
# was taken mid-sequence. A page counted as settled after VITA_SETTLE_MS
# without a frame; the Vita drew nothing during a step page's 1.4 s load,
# so the page was "settled" the moment the load ended, before the page's
# own timer could navigate on. The simulator loads in 0.17 s and never
# showed it (it now also runs the autotest at the Vita's pace,
# VITA_SIM_SLOW_MS).
# - main.c page_settled(): loading counts as activity, so a page gets
#   VITA_SETTLE_MS of quiet after its load as well as after its last frame.
# See docs/phase-0/10-hardware-test-plan.md §Run 12 results.

diff --git a/frontends/vita/main.c b/frontends/vita/main.c
index 3fc9e17..901a58e 100644
--- a/frontends/vita/main.c
+++ b/frontends/vita/main.c
@@ -384,8 +384,16 @@ static bool page_settled(struct gui_window *gw)
 {
 	unsigned int now = vita_diag_ms();
 
-	if (vita_stats.frames == 0 || vita_window_loading(gw))
+	if (vita_stats.frames == 0)
 		return false;
+	/* Loading counts as activity, so a page also gets VITA_SETTLE_MS of
+	 * quiet after its load, not just after its last frame. Hardware run
+	 * 12: a page drew nothing during a 1.4 s load, so it was "settled" the
+	 * moment the load ended -- before its own scripts' timers ran. */
+	if (vita_window_loading(gw)) {
+		vita_stats.last_frame_ms = now;
+		return false;
+	}
 	/* Not while script-driven relayout is still due: its frame is the
 	 * page as the scripts left it. */
 	if (page_reconvert_pending(gw)) {
