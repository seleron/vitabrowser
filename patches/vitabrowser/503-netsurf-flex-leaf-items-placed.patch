+				 * builder, its box straight under the flex box as
+				 * in a full build (stackoverflow inserts <iframe>s
+				 * into its flex <body>: ~2,900 boxes rebuilt each
+				 * time). One that lands in a line instead is a full
+				 * reconvert at placement (502's guard). */
+				if (!plain && !oc &&
 				    nadd < HTML_RL_MAX_CHANGES &&
 				    html_rl_leaf_tag(n) && html_rl_boxed_after(n) &&
 				    html_rl_block_neighbour(n, pbox, false) &&
@@ -10104,7 +10111,9 @@
