+static void html_rl_inner_free(struct html_rl_inner_sink *k)
+{
+	int i;
+	for (i = 0; i < k->nlefts; i++)
+		html_rl_sib_compound_free(&k->lefts[i]);
+	free(k->lefts);
+	for (i = 0; i < k->nrules; i++) {
+		html_rl_sib_compound_free(&k->rules[i].l);
+		html_rl_sib_compound_free(&k->rules[i].r);
+	}
+	free(k->rules);
+	for (i = 0; i < k->nempty; i++)
+		html_rl_sib_compound_free(&k->empty[i]);
+	free(k->empty);
+	for (i = 0; i < k->nhas; i++)
+		html_rl_sib_compound_free(&k->has[i]);
+	free(k->has);
+	memset(k, 0, sizeof(*k));
+}
+
+/* move n compounds from src onto the end of *dst; false: none moved */
+static bool html_rl_inner_move_cps(struct html_rl_sib_compound **dst,
+		int *ndst, struct html_rl_sib_compound *src, int n)
+{
+	struct html_rl_sib_compound *na;
+	if (n == 0)
+		return true;
+	if (dst == NULL)
+		return false;
+	na = realloc(*dst, (size_t)(*ndst + n) * sizeof(*na));
+	if (na == NULL)
+		return false;
+	*dst = na;
+	memcpy(&na[*ndst], src, (size_t)n * sizeof(*na));
+	*ndst += n;
+	return true;
+}
