 static int html_rl_parse_compound(struct html_rl_sel_parser *p,
 		struct html_rl_sib_compound *cp);
 
+/* Patch 505: the argument at p->i (its '(') of a :not() / :is() /
+ * :where() holding a sibling combinator, parsed as a prelude of its own
+ * into fresh arrays that then go to the inner sink. 0: done (p unmoved);
+ * otherwise the sheet declines as before. */
+static int html_rl_inner_arg(struct html_rl_sel_parser *p)
+{
+	struct html_rl_inner_sink tmp, *k = html_rl_inner;
+	struct html_rl_sel_parser sub;
+	size_t j = p->i, depth = 0;
+	int r;
+
+	while (j < p->len) {
+		uint8_t c = p->s[j];
+		if (c == '(')
+			depth++;
+		else if (c == ')') {
+			if (--depth == 0)
+				break;
+		} else if (c == '"' || c == '\'') {
+			uint8_t q = c;
+			j++;
+			while (j < p->len && p->s[j] != q && p->s[j] != '\n') {
+				if (p->s[j] == '\\')
+					j++;
+				j++;
+			}
+		} else if (c == '\\')
+			j++;
+		j++;
+	}
+	if (k == NULL || j >= p->len)
+		return -1;
+	memset(&tmp, 0, sizeof(tmp));
+	sub.s = p->s;
+	sub.len = j;
+	sub.i = p->i + 1;
+	r = html_rl_parse_prelude(&sub, j, &tmp.lefts, &tmp.nlefts,
+			&tmp.rules, &tmp.nrules, &tmp.empty, &tmp.nempty,
+			&tmp.has, &tmp.nhas);
+	if (r != 1 || tmp.nrules == 0) {
+		html_rl_inner_free(&tmp);
+		return -1;
+	}
+	{
+		struct html_rl_sib_rule *nr = realloc(k->rules,
+			(size_t)(k->nrules + tmp.nrules) * sizeof(*nr));
+		if (nr == NULL) {
+			html_rl_inner_free(&tmp);
+			return -1;
+		}
+		k->rules = nr;
+		memcpy(&nr[k->nrules], tmp.rules,
+			(size_t)tmp.nrules * sizeof(*nr));
+		k->nrules += tmp.nrules;
+		free(tmp.rules);
+		tmp.rules = NULL;
+		tmp.nrules = 0;
+	}
+	if (!html_rl_inner_move_cps(&k->lefts, &k->nlefts, tmp.lefts,
+			tmp.nlefts) ||
+	    !html_rl_inner_move_cps(&k->empty, &k->nempty, tmp.empty,
+			tmp.nempty) ||
+	    !html_rl_inner_move_cps(&k->has, &k->nhas, tmp.has, tmp.nhas)) {
+		html_rl_inner_free(&tmp);
+		return -1;
+	}
+	free(tmp.lefts);
+	free(tmp.empty);
+	free(tmp.has);
+	return 0;
+}
