+/* Patch 505: html_rl_parse_prelude1 with the inner sink (above): the
+ * rules found inside functional pseudo-classes are the prelude's rules
+ * too, so a prelude holding one reports a sibling combinator (1). */
+static int html_rl_parse_prelude(struct html_rl_sel_parser *p, size_t end,
+		struct html_rl_sib_compound **lefts, int *nlefts,
+		struct html_rl_sib_rule **rules, int *nrules,
+		struct html_rl_sib_compound **empty_cp, int *nempty,
+		struct html_rl_sib_compound **has_cp, int *nhas)
+{
+	struct html_rl_inner_sink sink, *saved = html_rl_inner;
+	int r;
+
+	memset(&sink, 0, sizeof(sink));
+	html_rl_inner = rules != NULL ? &sink : NULL;
+	r = html_rl_parse_prelude1(p, end, lefts, nlefts, rules, nrules,
+			empty_cp, nempty, has_cp, nhas);
+	html_rl_inner = saved;
+	if (r != 0 && r != 1) {
+		html_rl_inner_free(&sink);
+		return r;
+	}
+	if (sink.nrules == 0 && sink.nlefts == 0 && sink.nempty == 0 &&
+	    sink.nhas == 0)
+		return r;
+	{
+		struct html_rl_sib_rule *nr = sink.nrules == 0 ? *rules :
+			realloc(*rules, (size_t)(*nrules + sink.nrules) *
+				sizeof(*nr));
+		if (nr == NULL) {
+			html_rl_inner_free(&sink);
+			return 2;	/* no memory: conservative */
+		}
+		*rules = nr;
+		memcpy(&nr[*nrules], sink.rules,
+			(size_t)sink.nrules * sizeof(*nr));
+		*nrules += sink.nrules;
+		free(sink.rules);
+		sink.rules = NULL;
+		sink.nrules = 0;
+	}
+	if (!html_rl_inner_move_cps(lefts, nlefts, sink.lefts, sink.nlefts) ||
+	    !html_rl_inner_move_cps(empty_cp, nempty, sink.empty,
+			sink.nempty) ||
+	    !html_rl_inner_move_cps(has_cp, nhas, sink.has, sink.nhas)) {
+		/* what moved is the caller's now; free only the rest */
+		html_rl_inner_free(&sink);
+		return 2;
+	}
+	free(sink.lefts);
+	free(sink.empty);
+	free(sink.has);
+	return 1;
+}
