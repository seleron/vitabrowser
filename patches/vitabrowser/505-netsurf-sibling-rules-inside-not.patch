+/* Patch 505: sibling rules found inside a :not() / :is() / :where()
+ * argument of the prelude being parsed -- "X:not(A + B)" depends on X's
+ * previous sibling just as "A + B" does. html_rl_parse_prelude points the
+ * sink at its own arrays while its caller collects rules, and moves what
+ * the compounds put there into the caller's lists on success. */
+struct html_rl_inner_sink {
+	struct html_rl_sib_compound *lefts;
+	int nlefts;
+	struct html_rl_sib_rule *rules;
+	int nrules;
+	struct html_rl_sib_compound *empty;
+	int nempty;
+	struct html_rl_sib_compound *has;
+	int nhas;
+};
+static struct html_rl_inner_sink *html_rl_inner;
+static void html_rl_inner_free(struct html_rl_inner_sink *k);
+static bool html_rl_inner_move_cps(struct html_rl_sib_compound **dst,
+		int *ndst, struct html_rl_sib_compound *src, int n);
