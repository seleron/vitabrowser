+/* Patch 506: does pnode (kind 1), or pnode or an ancestor (kind 2), match
+ * cp's context compound? Matched as the children are (tag, id, classes) */
+static bool html_rl_struct_ctx_ok(dom_node *pnode,
+		const struct html_rl_struct_cp *cp)
+{
+	dom_node *n = pnode, *up;
+	bool ok = false;
+	int depth = 0;
+
+	dom_node_ref(n);
+	while (n != NULL && !ok && depth++ < 256) {
+		dom_node_type type;
+		if (dom_node_get_node_type(n, &type) == DOM_NO_ERR &&
+		    type == DOM_ELEMENT_NODE) {
+			struct html_rl_struct_el el;
+			memset(&el, 0, sizeof(el));
+			el.tag = html_rl_struct_tag(n);
+			el.id = html_rl_struct_attr(n, corestring_dom_id);
+			el.cls = html_rl_struct_attr(n, corestring_dom_class);
+			el.node = n;
+			ok = html_rl_struct_cp_matches(cp->ctx, &el);
+			free(el.tag);
+			free(el.id);
+			free(el.cls);
+		}
+		if (ok || cp->ctxkind == 1)
+			break;
+		up = NULL;
+		if (dom_node_get_parent_node(n, &up) != DOM_NO_ERR)
+			up = NULL;
+		dom_node_unref(n);
+		n = up;
+	}
+	if (n != NULL)
+		dom_node_unref(n);
+	return ok || depth >= 256;	/* too deep: assume it may */
+}
