+/* Patch 506: the compound left of a structural compound that starts at a:
+ * "X > C" (a parent) or "X C" (an ancestor), kept as cp->ctx. Google's
+ * ".P1ekSe-ZMv3u>div:nth-child(2)" (its sign-in widget's sheet, on
+ * stackoverflow) was kept as div:nth-child(2) and hit every second <div>
+ * of every parent -- stackoverflow's <body> among them. A start, a comma,
+ * a brace, a + or a ~ before it, or a context that does not parse to a
+ * tag, id or class, leaves none. */
+static void html_rl_struct_ctx(const uint8_t *s, size_t a,
+		struct html_rl_struct_cp *cp)
+{
+	size_t e = a, x;
+	int kind = 2;
+	struct html_rl_struct_cp *c;
+
+	while (e > 0 && (s[e - 1] == ' ' || s[e - 1] == '\t' ||
+			 s[e - 1] == '\r' || s[e - 1] == '\n' ||
+			 s[e - 1] == '\f'))
+		e--;
+	if (e > 0 && s[e - 1] == '>') {
+		kind = 1;
+		e--;
+		while (e > 0 && (s[e - 1] == ' ' || s[e - 1] == '\t' ||
+				 s[e - 1] == '\r' || s[e - 1] == '\n' ||
+				 s[e - 1] == '\f'))
+			e--;
+	} else if (e == a) {
+		return;		/* no combinator: nothing before it */
+	}
+	if (e == 0)
+		return;
+	/* the context compound must end in a name, ']', ')' or '*' */
+	if (!(html_rl_struct_ident_ch(s[e - 1]) || s[e - 1] == ']' ||
+	      s[e - 1] == ')' || s[e - 1] == '*'))
+		return;
+	x = html_rl_struct_back(s, e);
+	if (x >= e)
+		return;
+	c = calloc(1, sizeof(*c));
+	if (c == NULL)
+		return;
+	html_rl_struct_parse_cp(s, x, e, c);
+	if (c->unbounded || (c->tag == NULL && c->id == NULL && c->ncl == 0)) {
+		html_rl_struct_cp_free(c);
+		free(c);
+		return;
+	}
+	cp->ctx = c;
+	cp->ctxkind = kind;
+}
