+/* Patch 508: node.compareDocumentPosition() in C. It was a JS function
+ * built on contains() that answered FOLLOWING (4) both ways for any two
+ * nodes neither containing the other, so a document-order sort could not
+ * order them: jQuery's uniqueSort (Sizzle sortOrder) then took its
+ * "disconnected" branch on every comparison -- ownerDocument reads,
+ * contains() calls, -1 for every pair -- and returned its results out of
+ * document order. On rte.ie that was 7 sorts of 3,600-4,179 nodes, 2.5 s of
+ * the load's 5.75 s main-thread time in the sim.
+ *
+ * The realm's document object is not an element-class wrapper: it is
+ * matched by identity and answered as the libdom document node. A
+ * non-object argument throws Chromium's TypeError; an object that is no
+ * node of this realm (another frame's document, a stand-in) is answered as
+ * disconnected, as is such a `this`. */
+static dom_node *qjs_cdp_node(JSContext *ctx, JSValueConst v)
+{
+	dom_node *n = qjs_get_node(v);
+	JSValue global, docv;
+	if (n != NULL || !JS_IsObject(v))
+		return n;
+	global = JS_GetGlobalObject(ctx);
+	docv = JS_GetPropertyStr(ctx, global, "document");
+	if (JS_IsObject(docv) &&
+	    JS_VALUE_GET_PTR(docv) == JS_VALUE_GET_PTR(v))
+		n = (dom_node *) qjs_document_for_ctx(ctx);
+	JS_FreeValue(ctx, docv);
+	JS_FreeValue(ctx, global);
+	return n;
+}
+
+static JSValue qjs_node_compare_position_data(JSContext *ctx,
+		JSValueConst this_val, int argc, JSValueConst *argv,
+		int magic, JSValueConst *func_data)
+{
+	dom_node *self, *other;
+	unsigned int r = 0;
+
+	(void) magic; (void) func_data;
+	if (argc < 1 || !JS_IsObject(argv[0]))
+		return JS_ThrowTypeError(ctx, "Failed to execute "
+			"'compareDocumentPosition' on 'Node': parameter 1 is "
+			"not of type 'Node'.");
+	if (JS_VALUE_GET_PTR(argv[0]) == JS_VALUE_GET_PTR(this_val))
+		return JS_NewInt32(ctx, 0);
+	other = qjs_cdp_node(ctx, argv[0]);
+	self = qjs_cdp_node(ctx, this_val);
+	if (self == NULL || other == NULL ||
+	    macsurf_dom_node_compare_position(self, other, &r) != DOM_NO_ERR)
+		return JS_NewInt32(ctx, 1 | 32 | 4);
+	return JS_NewInt32(ctx, (int32_t) r);
+}
