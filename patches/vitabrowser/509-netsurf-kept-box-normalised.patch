+#ifdef VITA_HOST_SIM
+/* Patch 509, simulator only: a test hook. When the local path declines,
+ * the full reconvert may not run at once (html_reconvert_content busy: a
+ * convert in flight, mid-layout; a sheet wait; the cosmetic deferral), and
+ * an object finishing meanwhile lays the page out first (what Wikipedia's
+ * #toc met). A page whose <html> carries data-vb-reformat-queued gets that
+ * reformat at once, just before the full reconvert is asked for
+ * (macos9_reconvert.c), every box's min/max width measured again, so a
+ * gate page meets the tree a kept box leaves every time. Never built for
+ * the device. */
+static void html_rl_sim_unmeasure(struct box *b)
+{
+	for (; b != NULL; b = b->next) {
+		b->max_width = UNKNOWN_MAX_WIDTH;
+		html_rl_sim_unmeasure(b->children);
+	}
+}
+
+void html_rl_sim_queued_reformat(struct content *cc)
+{
+	static dom_string *name = NULL;
+	html_content *c = (html_content *) cc;
+	bool has = false;
+
+	/* cc is the HTML content about to be reconverted */
+	if (cc == NULL || c->layout == NULL || c->layout->node == NULL)
+		return;
+	if (name == NULL && dom_string_create(
+			(const uint8_t *) "data-vb-reformat-queued", 23,
+			&name) != DOM_NO_ERR)
+		return;
+	if (dom_element_has_attribute((dom_element *) c->layout->node, name,
+			&has) != DOM_NO_ERR || !has)
+		return;
+	macsurf_debug_log_writef("LIFE test hook: a reformat before the "
+		"full reconvert (data-vb-reformat-queued)");
+	/* every width measured again, as objects arriving leave them
+	 * (html_object_done clears max_width up the object's ancestors) */
+	html_rl_sim_unmeasure(c->layout);
+	content__reformat(cc, false, cc->available_width,
+		cc->available_height);
+}
+#endif
+
+/* Patch 509: a new box kept for the full reconvert (patch 374) must lay
+ * out until that reconvert runs: html_reconvert_content only queues it, a
+ * sheet wait or the cosmetic deferral can hold it, and an object the new
+ * boxes fetched can finish meanwhile and reformat the page
+ * (html_object_callback -> html_reformat). box_build_element places the
+ * box under its DOM parent's box and normalises nothing: under a table,
+ * row group or row that is a block where layout reads a row group, row or
+ * cell -- Wikipedia's #toc (display: table): its .toctitle flex box,
+ * rebuilt whole and kept beside the table's anonymous row group, asserted
+ * in layout_minmax_table (cell->type == BOX_TABLE_CELL) when the toggle's
+ * SVG arrived. The enclosing table is normalised again, as a full build
+ * would make it (the anonymous row group, row and cell around the box;
+ * the boxes already normalised come through unchanged); anywhere else the
+ * new subtree itself is normalised. */
+static void html_rl_kept_normalise(html_content *c, struct box *nb)
+{
+	struct box *t = nb->parent;
+	bool ok = true;
+
+	while (t != NULL && (t->type == BOX_TABLE_ROW ||
+			t->type == BOX_TABLE_ROW_GROUP))
+		t = t->parent;
+	if (t != NULL && t->type == BOX_TABLE && t != nb) {
+		ok = box_normalise_table_ext(t, c->layout, c);
+		macsurf_debug_log_writef("LIFE rebuild local: kept box in a "
+			"table, the table normalised again%s",
+			ok ? "" : " (failed)");
+		return;
+	}
+	switch (nb->type) {
+	case BOX_BLOCK:
+	case BOX_INLINE_BLOCK:
+	case BOX_TABLE_CELL:
+		ok = box_normalise_block(nb, c->layout, c);
+		break;
+	case BOX_FLEX:
+	case BOX_GRID:
+		ok = box_normalise_flex_ext(nb, c->layout, c);
+		break;
+	case BOX_TABLE:
+		ok = box_normalise_table_ext(nb, c->layout, c);
+		break;
+	default:
+		return;
+	}
+	macsurf_debug_log_writef("LIFE rebuild local: kept box normalised%s",
+		ok ? "" : " (failed)");
+}
