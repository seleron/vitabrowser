# netsurf: hiding the caret no longer makes a page editable
# Generated 2026-09-24
#
# browser_window_remove_caret(bw, only_hide = true) set root_bw->can_edit
# = true, whether or not there was a caret. The core hides the caret on
# every CONTENT_MSG_REFORMAT, so any page that reflowed -- a script-driven
# relayout is enough -- reported BW_EDITOR_CAN_PASTE, "the caret is in a
# text field", with no field on the page. Found by the Vita autotest's
# interaction pass: a typed URL went into the page as keystrokes. Hiding
# now leaves can_edit as it was; removing still clears it.
# See docs/phase-0/10-hardware-test-plan.md §Run 14.

diff --git a/desktop/textinput.c b/desktop/textinput.c
index b8dced6..1f1f21f 100644
--- a/desktop/textinput.c
+++ b/desktop/textinput.c
@@ -92,9 +92,12 @@ void browser_window_remove_caret(struct browser_window *bw, bool only_hide)
 	root_bw = browser_window_get_root(bw);
 	assert(root_bw != NULL);
 
-	if (only_hide) {
-		root_bw->can_edit = true;
-	} else {
+	/* VitaBrowser: hiding leaves can_edit as it was. It used to set it
+	 * true, so the hide on every CONTENT_MSG_REFORMAT made any page that
+	 * reflowed -- a script-driven relayout is enough -- claim a caret in
+	 * a text field (browser_window_get_editor_flags() CAN_PASTE) with no
+	 * field on the page at all. */
+	if (!only_hide) {
 		root_bw->can_edit = false;
 	}
 
