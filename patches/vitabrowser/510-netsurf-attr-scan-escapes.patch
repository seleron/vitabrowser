+/* Patch 510: does the compound holding st[at] (an attribute selector's
+ * '[') also hold, as its own member, a dynamic pseudo-class -- :hover,
+ * :active, :focus, :focus-visible, :focus-within? Selection for boxes
+ * never matches one (node_is_hover / _active / _focus answer only for the
+ * dyn_*_node a hover or focus restyle sets, and libcss drops a rule with a
+ * pseudo-class it does not know), so that compound never matches while
+ * boxes are built, whatever the attribute: in a selector, in :is() /
+ * :where() (never), in :not() (always). Then the attribute cannot change
+ * a box's style through it. A dynamic pseudo-class inside a function of
+ * the compound (:not(:focus)) is no member: the occurrence counts. The
+ * compound runs, at its own nesting depth, to a combinator, whitespace, a
+ * comma, a brace, a semicolon, or the parenthesis that encloses it;
+ * brackets and parentheses inside it are skipped whole. */
+static int html_rl_attr_compound_dynamic(const uint8_t *st, size_t len,
+		size_t at)
+{
+	static const char *const dyn[] = { "hover", "active", "focus",
+		"focus-visible", "focus-within", NULL };
+	size_t a = at, b, k;
+	int depth;
+
+	/* back to the compound's start */
+	while (a > 0) {
+		uint8_t ch = st[a - 1];
+		if (ch == ']' || ch == ')') {
+			uint8_t open = ch == ']' ? '[' : '(';
+			depth = 1;
+			a--;
+			while (a > 0 && depth > 0) {
+				a--;
+				if (st[a] == ch)
+					depth++;
+				else if (st[a] == open)
+					depth--;
+			}
+			if (depth != 0)
+				return 0;
+			continue;
+		}
+		if (html_rl310_is_ws(ch) || ch == '>' || ch == '+' ||
+		    ch == '~' || ch == ',' || ch == '{' || ch == '}' ||
+		    ch == ';' || ch == '(' || ch == '/')
+			break;
+		a--;
+	}
+	/* on to its end */
+	b = at;
+	while (b < len) {
+		uint8_t ch = st[b];
+		if (ch == '[' || ch == '(') {
+			uint8_t close = ch == '[' ? ']' : ')';
+			uint8_t q = 0;
+			depth = 1;
+			b++;
+			while (b < len && depth > 0) {
+				if (q != 0) {
+					if (st[b] == '\\')
+						b++;
+					else if (st[b] == q)
+						q = 0;
+				} else if (st[b] == '"' || st[b] == '\'') {
+					q = st[b];
+				} else if (st[b] == ch) {
+					depth++;
+				} else if (st[b] == close) {
+					depth--;
+				}
+				b++;
+			}
+			if (depth != 0)
+				return 0;
+			continue;
+		}
+		if (html_rl310_is_ws(ch) || ch == '>' || ch == '+' ||
+		    ch == '~' || ch == ',' || ch == '{' || ch == '}' ||
+		    ch == ';' || ch == ')' || ch == '/')
+			break;
+		b++;
+	}
+	/* a ':' member of the compound itself (not '::', not inside a
+	 * function or a bracket) naming a dynamic pseudo-class */
+	for (k = a; k < b; k++) {
+		uint8_t ch = st[k];
+		int d;
+		if (ch == '[' || ch == '(') {
+			uint8_t close = ch == '[' ? ']' : ')';
+			depth = 1;
+			for (k++; k < b && depth > 0; k++) {
+				if (st[k] == ch)
+					depth++;
+				else if (st[k] == close)
+					depth--;
+			}
+			k--;
+			continue;
+		}
+		if (ch != ':' || (k + 1 < b && st[k + 1] == ':') ||
+		    (k > a && st[k - 1] == ':'))
+			continue;
+		for (d = 0; dyn[d] != NULL; d++) {
+			size_t tl = strlen(dyn[d]);
+			if (k + 1 + tl <= b &&
+			    html_rl310_cieq(st + k + 1, dyn[d], tl) &&
+			    (k + 1 + tl == b ||
+			     !html_rl310_is_namech(st[k + 1 + tl])))
+				return 1;
+		}
+	}
+	return 0;
+}
+
+/* Patch 510: occurrences an attribute scan found inert (their compound
+ * holds a dynamic pseudo-class), for the log */
+static unsigned int html_rl_attr_inert_seen;
+
+/* Patch 510: does the attribute selector name at st[j] read as `name`?
+ * Its escapes are decoded as CSS reads them (\65 or \e: one code point,
+ * up to six hex digits and one whitespace; \x: the character x) and the
+ * result compared, ignoring ASCII case, with the whole of `name`. Was: a
+ * plain byte compare, and any escape in a sheet answered "it might" for
+ * every name. Still "it might" (1): an escape to a code point beyond
+ * ASCII, and a namespace prefix spelled with an escape (the caller skips
+ * only plain prefixes). */
+static int html_rl_attr_name_at(const uint8_t *st, size_t len, size_t j,
+		const char *name, size_t namelen)
+{
+	size_t k = j, n = 0;
+	int match = 1;
+
+	while (k < len) {
+		unsigned long cp;
+		uint8_t ch = st[k];
+		if (ch == '\\') {
+			size_t h = 0;
+			cp = 0;
+			k++;
+			if (k >= len)
+				return 1;
+			while (k < len && h < 6 &&
+			       ((st[k] >= '0' && st[k] <= '9') ||
+				(st[k] >= 'a' && st[k] <= 'f') ||
+				(st[k] >= 'A' && st[k] <= 'F'))) {
+				cp = cp * 16 + (unsigned long)(st[k] <= '9' ?
+					st[k] - '0' : (st[k] | 0x20) - 'a' + 10);
+				k++;
+				h++;
+			}
+			if (h > 0) {
+				if (k < len && html_rl310_is_ws(st[k]))
+					k++;
+			} else {
+				cp = st[k];
+				k++;
+			}
+			if (cp == 0 || cp > 0x7f)
+				return 1;
+		} else if (html_rl310_is_namech(ch)) {
+			cp = ch;
+			k++;
+		} else {
+			break;
+		}
+		if (n >= namelen || !html_rl310_cieq(
+				(const uint8_t *) &(uint8_t){ (uint8_t) cp },
+				name + n, 1))
+			match = 0;
+		n++;
+	}
+	/* `prefix|name` whose prefix the caller did not skip */
+	if (k < len && st[k] == '|' && !(k + 1 < len && st[k + 1] == '='))
+		return 1;
+	return match && n == namelen;
+}
