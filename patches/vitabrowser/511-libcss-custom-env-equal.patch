+/* VitaBrowser patch 511: see select.h */
+bool css_custom_env_equal(const css_custom_env *a, const css_custom_env *b)
+{
+	uint32_t i, k;
+
+	if (a == b)
+		return true;
+	if (a == NULL || b == NULL)
+		return false;
+	if (a->inherited != b->inherited || a->used != b->used ||
+	    a->finalised != b->finalised)
+		return false;
+	for (i = 0; i < a->used; i++) {
+		const css_cp_binding *x = &a->items[i], *y = &b->items[i];
+		if (x->entry.name != y->entry.name ||
+		    x->invalid != y->invalid ||
+		    x->entry.n_tokens != y->entry.n_tokens)
+			return false;
+		for (k = 0; k < x->entry.n_tokens; k++)
+			if (x->entry.tokens[k].type != y->entry.tokens[k].type ||
+			    x->entry.tokens[k].idata !=
+					y->entry.tokens[k].idata)
+				return false;
+	}
+	return true;
+}
