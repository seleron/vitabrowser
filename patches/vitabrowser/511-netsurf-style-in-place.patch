+/* Patch 511: a style attribute change answered in place. 370 answers one
+ * as a class change: the element's box and its whole subtree built again
+ * and the page laid out -- for a flex <body> that is the page
+ * (stackoverflow: body.style set twice a load, 85-91 ms each in the sim).
+ * The box keeps its subtree when the change can reach nothing below it:
+ *   - no used sheet selects on [style] (310's scan) but in a selector's
+ *     subject compound: no other element's match changes (the element's
+ *     own is in its new selection, below);
+ *   - the element's new style builds the same box: display, float,
+ *     position (475), counting (none, old or new), background image (a
+ *     fetch), its ::before / ::after as they were; <body>: its background
+ *     colour (box_body may take it for the canvas);
+ *   - the custom-property environment defines what it did
+ *     (css_custom_env_equal, libcss patch 511: children inherit it by
+ *     reference, so a grandchild's var() could change unseen); the box
+ *     keeps its own, the children's parent;
+ *   - what descendants inherit is the same: a blank style from the old
+ *     and from the new compare equal (every inherited property: text and
+ *     anonymous boxes take them), and each element child, selected again
+ *     under the new style, comes out as its box holds it (a child's own
+ *     `inherit` of a non-inherited property is seen there); a box-less
+ *     child stays box-less.
+ * A descendant's style is a function of its ancestors' styles and the
+ * DOM, so with the children unchanged nothing below them changes. Then
+ * the new style is taken by the box -- and by every box of its subtree
+ * that shares the old one and is not another element's (text, inline
+ * ends, ::before / ::after contents) -- and the page is laid out. Otherwise the 370 path, as
+ * before. Not the root (419 / 459), nor a replaced, object or control
+ * box, nor any box but a block, flex or grid one. */
+/* Only boxes that hold no styles of their own: text, anonymous boxes,
+ * inline ends, generated content. A box that owns its styles is another
+ * element's and is left with its subtree -- libcss shares one computed
+ * style among elements that compute alike (gate511b: a <section> and its
+ * <p>s, all `margin: 4px 10px`; re-pointing by pointer alone gave the
+ * paragraphs the section's new margin). The shared style stays alive for
+ * them: computed styles are reference counted. */
+static void html_rl_repoint_styles(struct box *b,
+		const css_select_results *o, const css_select_results *nw)
+{
+	for (; b != NULL; b = b->next) {
+		int k;
+		if (b->styles != NULL)
+			continue;
+		for (k = 0; k < CSS_PSEUDO_ELEMENT_COUNT; k++)
+			if (o->styles[k] != NULL && b->style == o->styles[k]) {
+				b->style = nw->styles[k];
+				break;
+			}
+		html_rl_repoint_styles(b->children, o, nw);
+	}
+}
+
+static bool html_rl_blank_same(html_content *c, const css_computed_style *a,
+		const css_computed_style *b)
+{
+	nscss_select_ctx ctx;
+	css_computed_style *sa, *sb;
+	bool same = false;
+
+	memset(&ctx, 0, sizeof(ctx));
+	ctx.ctx = c->select_ctx;
+	ctx.quirks = (c->quirks == DOM_DOCUMENT_QUIRKS_MODE_FULL);
+	ctx.base_url = c->base_url;
+	ctx.universal = c->universal;
+	ctx.root_style = c->layout != NULL ? c->layout->style : NULL;
+	sa = nscss_get_blank_style(&ctx, &c->unit_len_ctx, a);
+	sb = nscss_get_blank_style(&ctx, &c->unit_len_ctx, b);
+	if (sa != NULL && sb != NULL)
+		same = css_computed_style_diff(sa, sb) ==
+			CSS_COMPUTED_STYLE_NO_DIFF;
+	if (sa != NULL)
+		css_computed_style_destroy(sa);
+	if (sb != NULL)
+		css_computed_style_destroy(sb);
+	return same;
+}
+
+static int html_rl_style_in_place(html_content *c, dom_node *el)
+{
+	struct box *b = box_for_node(el), *pb;
+	dom_node *pn = NULL, *ch = NULL, *next;
+	css_select_results *ns = NULL;
+	css_custom_env *env = NULL;
+	const css_computed_style *os;
+	css_computed_style *nst;
+	const char *why = NULL, *diff;
+	lwc_string *ia = NULL, *ib = NULL;
+	uint8_t ka, kb;
+	double t0 = macos9_micros();
+	int k, nch = 0;
+
+	if (b == NULL || b == c->layout || b->styles == NULL ||
+	    b->style == NULL || c->select_ctx == NULL || c->layout == NULL ||
+	    (b->type != BOX_BLOCK && b->type != BOX_FLEX &&
+	     b->type != BOX_GRID) ||
+	    (b->flags & IS_REPLACED) || b->object != NULL ||
+	    b->gadget != NULL)
+		return -1;
+	if (html_rl_sheet_refs_attr_others(c, "style")) {
+		macsurf_debug_log_writef("LIFE rebuild local: style in place: "
+			"declined (a sheet selects on [style] other than in a "
+			"selector's subject)");
+		return -1;
+	}
+	if (dom_node_get_parent_node(el, &pn) != DOM_NO_ERR || pn == NULL)
+		return -1;
+	pb = box_for_node(pn);
+	dom_node_unref(pn);
+	if (pb == NULL || pb->style == NULL)
+		return -1;
+	ns = box_get_style_with_select_ctx(c, c->select_ctx, pb->style,
+			c->layout->style, el, pb->custom_env, &env);
+	if (ns == NULL || ns->styles[CSS_PSEUDO_ELEMENT_NONE] == NULL) {
+		why = "no style";
+		goto out;
+	}
+	os = b->style;
+	nst = ns->styles[CSS_PSEUDO_ELEMENT_NONE];
+	if (!css_custom_env_equal(env, b->custom_env)) {
+		why = "its custom properties change";
+		goto out;
+	}
+	diff = html_rl_noop_diff(b, b->styles, ns);
+	if (diff == NULL) {
+		macsurf_debug_log_writef("LIFE rebuild local: style attribute "
+			"change restyles nothing (the element's style is the "
+			"same)");
+		goto done_same;
+	}
+	if (strcmp(diff, "an element's style changes") != 0) {
+		why = diff;
+		goto out;
+	}
+	for (k = CSS_PSEUDO_ELEMENT_BEFORE; k <= CSS_PSEUDO_ELEMENT_AFTER;
+			k++) {
+		bool ga = html_rl_pseudo_generates(b, b->styles->styles[k]);
+		bool gb = html_rl_pseudo_generates(b, ns->styles[k]);
+		if (ga != gb || (ga && css_computed_style_diff(
+				b->styles->styles[k], ns->styles[k]) !=
+				CSS_COMPUTED_STYLE_NO_DIFF)) {
+			why = "a ::before or ::after changes";
+			goto out;
+		}
+	}
+	if (css_computed_display(os, false) != css_computed_display(nst, false) ||
+	    css_computed_float(os) != css_computed_float(nst) ||
+	    !html_rl_pos_construct_same(css_computed_position(os),
+			css_computed_position(nst)) ||
+	    html_rl_style_counts(os) || html_rl_style_counts(nst)) {
+		why = "how the box is built changes";
+		goto out;
+	}
+	ka = css_computed_background_image(os, &ia);
+	kb = css_computed_background_image(nst, &ib);
+	if (ka != kb || ia != ib) {
+		why = "its background image changes";
+		goto out;
+	}
+	if (b->node != NULL && b->parent == c->layout) {
+		css_color ca, cb;
+		css_computed_background_color(os, &ca);
+		css_computed_background_color(nst, &cb);
+		if (ca != cb) {
+			why = "<body>'s background colour changes";
+			goto out;
+		}
+	}
+	if (!html_rl_blank_same(c, os, nst)) {
+		why = "an inherited property changes";
+		goto out;
+	}
+	/* each element child, selected again under the new style */
+	if (dom_node_get_first_child(el, &ch) != DOM_NO_ERR)
+		ch = NULL;
+	while (ch != NULL && why == NULL) {
+		dom_node_type type;
+		if (dom_node_get_node_type(ch, &type) == DOM_NO_ERR &&
+		    type == DOM_ELEMENT_NODE) {
+			struct box *cb = box_for_node(ch);
+			css_custom_env *cenv = NULL;
+			css_select_results *cs = box_get_style_with_select_ctx(c,
+					c->select_ctx, nst, c->layout->style, ch,
+					env, &cenv);
+			nch++;
+			if (cs == NULL ||
+			    cs->styles[CSS_PSEUDO_ELEMENT_NONE] == NULL) {
+				why = "a child has no style";
+			} else if (cb == NULL) {
+				if (css_computed_display(
+					cs->styles[CSS_PSEUDO_ELEMENT_NONE],
+					false) != CSS_DISPLAY_NONE &&
+				    !html_rl_noop_never_boxed(ch))
+					why = "a child without a box would get "
+						"one";
+			} else if (cb->styles == NULL ||
+				   html_rl_noop_diff(cb, cb->styles, cs) !=
+					NULL) {
+				why = "a child's style changes";
+			}
+			if (cs != NULL)
+				css_select_results_destroy(cs);
+			if (cenv != NULL)
+				css_custom_env_unref(cenv);
+		}
+		next = NULL;
+		if (dom_node_get_next_sibling(ch, &next) != DOM_NO_ERR)
+			next = NULL;
+		dom_node_unref(ch);
+		ch = next;
+	}
+	if (ch != NULL)
+		dom_node_unref(ch);
+	if (why != NULL)
+		goto out;
+	/* in place: the box and the boxes sharing its styles take the new */
+	html_rl_repoint_styles(b->children, b->styles, ns);
+	{
+		css_select_results *old = b->styles;
+		b->styles = ns;
+		b->style = nst;
+		css_select_results_destroy(old);
+		ns = NULL;
+		if (env != NULL)	/* equal to its own, which it keeps */
+			css_custom_env_unref(env);
+		env = NULL;
+	}
+	html_rl_invalidate(b);
+	macsurf_debug_log_writef("LIFE rebuild local: style attribute change, "
+		"the box restyled in place (%d children unchanged) in %ld us",
+		nch, (long)(macos9_micros() - t0));
+	content__reformat(&c->base, false, c->base.available_width,
+			c->base.available_height);
+	return 0;
+done_same:
+	css_select_results_destroy(ns);
+	if (env != NULL)
+		css_custom_env_unref(env);
+	return 0;
+out:
+	if (ns != NULL)
+		css_select_results_destroy(ns);
+	if (env != NULL)
+		css_custom_env_unref(env);
+	macsurf_debug_log_writef("LIFE rebuild local: style in place: "
+		"declined (%s)", why);
+	return -1;
+}
