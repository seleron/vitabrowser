+/* Patch 511: is the compound holding st[at] (an attribute selector's '[')
+ * the selector's subject -- nothing after it but white space and then a
+ * comma or the rule's brace? (Inside a function, ')' follows: not the
+ * subject, counted.) Brackets and parentheses inside it are skipped as
+ * html_rl_attr_compound_dynamic skips them. */
+static int html_rl_attr_compound_subject(const uint8_t *st, size_t len,
+		size_t at)
+{
+	size_t b = at;
+	int depth;
+
+	while (b < len) {
+		uint8_t ch = st[b];
+		if (ch == '[' || ch == '(') {
+			uint8_t close = ch == '[' ? ']' : ')';
+			uint8_t q = 0;
+			depth = 1;
+			b++;
+			while (b < len && depth > 0) {
+				if (q != 0) {
+					if (st[b] == '\\')
+						b++;
+					else if (st[b] == q)
+						q = 0;
+				} else if (st[b] == '"' || st[b] == '\'') {
+					q = st[b];
+				} else if (st[b] == ch) {
+					depth++;
+				} else if (st[b] == close) {
+					depth--;
+				}
+				b++;
+			}
+			if (depth != 0)
+				return 0;
+			continue;
+		}
+		if (ch == '\\') {
+			b += 2;
+			continue;
+		}
+		if (html_rl310_is_ws(ch) || ch == '>' || ch == '+' ||
+		    ch == '~' || ch == ',' || ch == '{' || ch == '}' ||
+		    ch == ';' || ch == ')' || ch == '/')
+			break;
+		b++;
+	}
+	while (b < len && html_rl310_is_ws(st[b]))
+		b++;
+	return b < len && (st[b] == ',' || st[b] == '{');
+}
