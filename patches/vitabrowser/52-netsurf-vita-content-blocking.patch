diff --git a/frontends/vita/resolve.c b/frontends/vita/resolve.c
index f4d473a..6c86a1a 100644
--- a/frontends/vita/resolve.c
+++ b/frontends/vita/resolve.c
@@ -48,6 +48,7 @@
 #endif
 
 #include "content/fetchers/curl_resolve.h"
+#include "utils/log.h"
 
 #include "vita/diag.h"
 #include "vita/resolve.h"
@@ -82,6 +83,136 @@ static bool worker_failed;
 /** Counters for the log. */
 static unsigned int n_lookups, n_failed, n_hits;
 
+/*
+ * Content blocking (README §14.5): on this CPU every extra origin costs a
+ * software TLS handshake, so ad and tracker hosts are refused here, before
+ * any lookup or connection. A host is blocked if it, or any domain it is
+ * under, is listed. The lists: VITA_BLOCKLIST_BUNDLED, then the user's
+ * VITA_BLOCKLIST_USER, where "host" adds and "@@host" allows.
+ */
+struct block_entry {
+	char *host;
+	bool allow;
+	unsigned int order;	/**< position in the files: later wins */
+};
+static struct block_entry *blocklist;
+static size_t block_count;
+static bool block_loaded;
+unsigned int vita_resolve_blocked;
+
+static int block_cmp(const void *a, const void *b)
+{
+	return strcmp(((const struct block_entry *)a)->host,
+		      ((const struct block_entry *)b)->host);
+}
+
+static int block_cmp_order(const void *a, const void *b)
+{
+	const struct block_entry *x = a, *y = b;
+	int c = strcmp(x->host, y->host);
+
+	if (c != 0)
+		return c;
+	return (x->order > y->order) - (x->order < y->order);
+}
+
+static void block_add_file(const char *path)
+{
+	static size_t cap;
+	char line[300];
+	FILE *fp = fopen(path, "r");
+	size_t n0 = block_count;
+
+	if (fp == NULL)
+		return;
+	while (fgets(line, sizeof(line), fp) != NULL) {
+		char *h = line, *e;
+		bool allow = false;
+
+		while (*h == ' ' || *h == '\t')
+			h++;
+		if (strncmp(h, "@@", 2) == 0) {
+			allow = true;
+			h += 2;
+		}
+		for (e = h; *e != '\0' && *e != ' ' && *e != '\t' &&
+			     *e != '\r' && *e != '\n' && *e != '#'; e++)
+			if (*e >= 'A' && *e <= 'Z')
+				*e = (char)(*e - 'A' + 'a');
+		*e = '\0';
+		if (*h == '\0')
+			continue;	/* blank or a # comment */
+		if (block_count == cap) {
+			size_t c = cap ? cap * 2 : 256;
+			struct block_entry *nb =
+				realloc(blocklist, c * sizeof(*blocklist));
+			if (nb == NULL)
+				break;
+			blocklist = nb;
+			cap = c;
+		}
+		blocklist[block_count].host = strdup(h);
+		blocklist[block_count].allow = allow;
+		blocklist[block_count].order = (unsigned int)block_count;
+		if (blocklist[block_count].host != NULL)
+			block_count++;
+	}
+	fclose(fp);
+	vita_diag_log("dns: blocklist %s: %u entries", path,
+		      (unsigned int)(block_count - n0));
+}
+
+/** Load the lists once: sorted by host, one entry per host, the last one
+ * in file order (so the user's list overrides the bundled one). */
+static void block_load(void)
+{
+	size_t i, o = 0;
+
+	block_loaded = true;
+	block_add_file(VITA_BLOCKLIST_BUNDLED);
+	block_add_file(VITA_BLOCKLIST_USER);
+	if (block_count == 0)
+		return;
+	qsort(blocklist, block_count, sizeof(*blocklist), block_cmp_order);
+	for (i = 0; i < block_count; i++) {
+		if (i + 1 < block_count &&
+		    strcmp(blocklist[i].host, blocklist[i + 1].host) == 0) {
+			free(blocklist[i].host);
+			continue;
+		}
+		blocklist[o++] = blocklist[i];
+	}
+	block_count = o;
+}
+
+/* exported interface documented in vita/resolve.h */
+bool vita_resolve_is_blocked(const char *host)
+{
+	char h[RESOLVE_HOST_MAX];
+	const char *p;
+	size_t i;
+
+	if (!block_loaded)
+		block_load();
+	if (block_count == 0 || strlen(host) >= sizeof(h))
+		return false;
+	for (i = 0; host[i] != '\0'; i++)
+		h[i] = (host[i] >= 'A' && host[i] <= 'Z') ?
+			(char)(host[i] - 'A' + 'a') : host[i];
+	h[i] = '\0';
+	/* The host, then each domain it is under; the most specific
+	 * listed one decides (so @@sub.example.com beats example.com). */
+	for (p = h; p != NULL; p = strchr(p, '.') ? strchr(p, '.') + 1 :
+		     NULL) {
+		struct block_entry key = { .host = (char *)p }, *e;
+		e = bsearch(&key, blocklist, block_count, sizeof(key),
+			    block_cmp);
+		if (e != NULL)
+			return !e->allow;
+	}
+	return false;
+}
+
 /** Finished lookups for the log, which is main-thread code
  * (vita_resolve_poll() writes them). */
 #define RESOLVE_LOG_LINES 8
@@ -225,6 +356,11 @@ fetch_curl_resolve(const char *host, char *addr, size_t size)
 	int i;
 
 	addr[0] = '\0';
+	if (vita_resolve_is_blocked(host)) {
+		vita_resolve_blocked++;
+		NSLOG(netsurf, INFO, "blocked: %s", host);
+		return FETCH_CURL_RESOLVE_FAILED;
+	}
 	if (is_address(host) || strlen(host) >= RESOLVE_HOST_MAX)
 		return FETCH_CURL_RESOLVE_READY;
 
