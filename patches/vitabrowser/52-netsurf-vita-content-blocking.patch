@@ -25,6 +25,19 @@
 #ifndef NETSURF_VITA_RESOLVE_H
 #define NETSURF_VITA_RESOLVE_H
 
+#include <stdbool.h>
+
+/** Content blocking: the bundled list, and the user's additions ("host")
+ * and exceptions ("@@host"), one per line. */
+#define VITA_BLOCKLIST_BUNDLED "app0:/res/blocklist.txt"
+#define VITA_BLOCKLIST_USER "ux0:data/VitaBrowser/blocklist.txt"
+
+/** Is host, or a domain it is under, blocked? */
+bool vita_resolve_is_blocked(const char *host);
+
+/** Fetches refused because their host is blocked. */
+extern unsigned int vita_resolve_blocked;
+
 /** Log the lookups finished since the last call. Main loop, every pass. */
 void vita_resolve_poll(void);
 
