+/** Glyphs drawn per batch (6 vertices each; vita2d's linear index
+ * buffer covers 65535). */
+#define TEXT_BATCH 256
+
+/** One glyph placed in a run, waiting for its batch: a copy of its atlas
+ * rectangle, not a pointer into glyph_cache -- a later glyph of the same
+ * run can take over the cache slot (the first cut of this drew a "9" as
+ * an "A" in the simulator). */
+struct placed {
+	int page, gx, gy, gw, gh;	/**< the atlas rectangle */
+	int x, y;			/**< where it goes on screen */
+};
+
+/**
+ * Draw placed glyphs: one vita2d_draw_array_textured() per atlas page, as
+ * triangle pairs with the same corners and texture coordinates as
+ * vita2d_draw_texture_tint_part()'s strip (libvita2d draw_texture_part_
+ * generic), so the pixels are the same. A run's glyphs share one colour,
+ * and alpha blending two layers of one colour gives the same result in
+ * either order, so grouping by page cannot change overlaps.
+ */
+static void draw_placed(const struct placed *pl, int n, unsigned int rgba)
+{
+	int page, i;
+
+	for (page = 0; page < page_count; page++) {
+		vita2d_texture_vertex *v;
+		float tw, th;
+		int count = 0, k = 0;
+
+		for (i = 0; i < n; i++)
+			if (pl[i].page == page)
+				count++;
+		if (count == 0)
+			continue;
+		v = vita2d_pool_memalign(6 * (unsigned int)count *
+					 sizeof(vita2d_texture_vertex),
+					 sizeof(vita2d_texture_vertex));
+		if (v == NULL) {
+			vita_text_stats.dropped += (unsigned int)count;
+			continue;
+		}
+		tw = (float)vita2d_texture_get_width(pages[page].tex);
+		th = (float)vita2d_texture_get_height(pages[page].tex);
+		for (i = 0; i < n; i++) {
+			const struct placed *g = &pl[i];
+			float x0, y0, x1, y1, u0, v0, u1, v1;
+			if (g->page != page)
+				continue;
+			x0 = (float)g->x;
+			y0 = (float)g->y;
+			x1 = x0 + (float)g->gw;
+			y1 = y0 + (float)g->gh;
+			u0 = (float)g->gx / tw;
+			v0 = (float)g->gy / th;
+			u1 = (float)(g->gx + g->gw) / tw;
+			v1 = (float)(g->gy + g->gh) / th;
+			/* The strip's two triangles: 0 1 2, then 2 1 3. */
+			v[k++] = (vita2d_texture_vertex){ x0, y0, 0.5f, u0, v0 };
+			v[k++] = (vita2d_texture_vertex){ x1, y0, 0.5f, u1, v0 };
+			v[k++] = (vita2d_texture_vertex){ x0, y1, 0.5f, u0, v1 };
+			v[k++] = (vita2d_texture_vertex){ x0, y1, 0.5f, u0, v1 };
+			v[k++] = (vita2d_texture_vertex){ x1, y0, 0.5f, u1, v0 };
+			v[k++] = (vita2d_texture_vertex){ x1, y1, 0.5f, u1, v1 };
+		}
+		vita2d_draw_array_textured(pages[page].tex,
+					   SCE_GXM_PRIMITIVE_TRIANGLES, v,
+					   (size_t)k, rgba);
+		vita_text_stats.batches++;
+	}
+}
+
+/** The simulator's reference path: VITA_SIM_TEXT_UNBATCHED=1 draws each
+ * glyph on its own, as before batching, so tools/run-vita-sim.sh can
+ * compare the two pixel for pixel. Always batched on the Vita. */
+static bool unbatched(void)
+{
+#ifdef VITA_HOST_SIM
+	static int on = -1;
+	if (on < 0)
+		on = getenv("VITA_SIM_TEXT_UNBATCHED") != NULL;
+	return on != 0;
+#else
+	return false;
+#endif
+}
+
 /* exported interface documented in vita/text.h */
 int vita_text_draw(const struct vita_text_style *style, int x, int y,
 		   const char *utf8, size_t len, unsigned int rgba)
 {
+	struct placed pl[TEXT_BATCH];
 	size_t i = 0;
-	int pen = x;
+	int pen = x, n = 0;
 
 	while (i < len) {
 		const struct adv_entry *e =
@@ -370,18 +459,34 @@ int vita_text_draw(const struct vita_text_style *style, int x, int y,
 		i = utf8_next(utf8, len, i);
 		if (e->cp >= 0x20 && e->cp != 0x20 && e->cp != 0xa0) {
 			g = glyph_get(e->face, e->gi, e->px);
-			if (g == NULL)
+			if (g == NULL) {
 				vita_text_stats.dropped++;
-			else if (g->w > 0 && g->h > 0)
+			} else if (g->w > 0 && g->h > 0 && unbatched()) {
 				vita2d_draw_texture_tint_part(
 					pages[g->page].tex,
 					(float)(pen + g->left),
 					(float)(y - g->top),
 					(float)g->x, (float)g->y,
 					(float)g->w, (float)g->h, rgba);
+			} else if (g->w > 0 && g->h > 0) {
+				pl[n].page = g->page;
+				pl[n].gx = g->x;
+				pl[n].gy = g->y;
+				pl[n].gw = g->w;
+				pl[n].gh = g->h;
+				pl[n].x = pen + g->left;
+				pl[n].y = y - g->top;
+				vita_text_stats.glyphs_drawn++;
+				if (++n == TEXT_BATCH) {
+					draw_placed(pl, n, rgba);
+					n = 0;
+				}
+			}
 		}
 		pen += e->adv;
 	}
+	if (n > 0)
+		draw_placed(pl, n, rgba);
 	return pen - x;
 }
 
