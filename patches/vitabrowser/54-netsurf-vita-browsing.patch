+/**
+ * \file
+ * Vita frontend: the autotest's interaction pass (vita/interact.c).
+ *
+ * Drives the browsing controls with scripted input -- taps, drags, the
+ * pointer, buttons, typed text, a URL pushed to the LAN listener -- through
+ * the same vita_input_browse() the pad uses, and checks what each step did
+ * (the URL, the scroll offset, the zoom, blocked fetches, the cookie jar).
+ * Runs on the device with nobody touching it, so one hardware run covers
+ * the controls too.
+ */
+
+#ifndef NETSURF_VITA_INTERACT_H
+#define NETSURF_VITA_INTERACT_H
+
+#include <stdbool.h>
+
+struct gui_window;
+struct vita_input;
+
+/** What the pass needs from the main loop. */
+struct vita_interact_host {
+	/** Has the page finished loading and repainting? */
+	bool (*settled)(struct gui_window *gw);
+	/** Navigate to url (the main loop's page bookkeeping included). */
+	void (*open)(struct gui_window *gw, const char *url);
+	/** Dump the next frame's plot calls as name. */
+	void (*dump)(const char *name);
+	/** Has the dump asked for been taken? */
+	bool (*dump_done)(void);
+	/** Save the cookie jar now; its file name. */
+	const char *(*save_cookies)(void);
+};
+
+/** Start the pass. */
+void vita_interact_start(const struct vita_interact_host *host);
+
+/**
+ * One main-loop pass: the scripted input for this pass in *in.
+ *
+ * \return false once the pass has finished (its summary is logged)
+ */
+bool vita_interact_step(struct gui_window *gw, struct vita_input *in);
+
+/** Steps passed and run, for the summary. */
+extern unsigned int vita_interact_passed, vita_interact_total;
+
+#endif
