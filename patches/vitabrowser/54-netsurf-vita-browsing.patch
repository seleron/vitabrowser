diff --git a/frontends/vita/remote.c b/frontends/vita/remote.c
new file mode 100644
index 0000000..c0c2333
--- /dev/null
+++ b/frontends/vita/remote.c
@@ -0,0 +1,311 @@
+/*
+ * Copyright 2026 VitaBrowser contributors
+ *
+ * This file is part of NetSurf, http://www.netsurf-browser.org/
+ *
+ * NetSurf is free software; you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation; version 2 of the License.
+ *
+ * NetSurf is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+ * GNU General Public License for more details.
+ *
+ * You should have received a copy of the GNU General Public License
+ * along with this program.  If not, see <http://www.gnu.org/licenses/>.
+ */
+
+/**
+ * \file
+ * Vita frontend: send a URL from a phone or PC (see vita/remote.h).
+ *
+ * Routes:
+ *   GET /             a form: one URL field and a button
+ *   GET /open?url=U   opens U on the Vita
+ *   GET /cookie       sets a cookie and shows the one the browser sent:
+ *                     loaded from the Vita (http://127.0.0.1:8080/cookie)
+ *                     it shows whether the cookie jar survived a restart
+ *
+ * Anyone on the LAN can open a page on the Vita this way; nothing else.
+ */
+
+#include <errno.h>
+#include <fcntl.h>
+#include <stdbool.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <strings.h>
+#include <time.h>
+#include <unistd.h>
+#include <arpa/inet.h>
+#include <netinet/in.h>
+#include <sys/socket.h>
+
+#include "utils/errors.h"
+
+#include "vita/chrome.h"
+#include "vita/diag.h"
+#include "vita/net.h"
+#include "vita/remote.h"
+
+/** A client gets this long to send its request, ms. */
+#define REQUEST_MS 3000
+
+unsigned int vita_remote_requests, vita_remote_opened;
+
+static int listen_fd = -1;
+static int client_fd = -1;
+static unsigned int client_ms;
+static char req[4096];
+static size_t req_len;
+static char address[64];
+static int port = VITA_REMOTE_PORT;
+
+/* exported interface documented in vita/remote.h */
+int vita_remote_port(void)
+{
+	return port;
+}
+
+static int set_nonblocking(int fd)
+{
+#ifdef __vita__
+	int on = 1;
+	return setsockopt(fd, SOL_SOCKET, SO_NONBLOCK, &on, sizeof(on));
+#else
+	return fcntl(fd, F_SETFL, fcntl(fd, F_GETFL, 0) | O_NONBLOCK);
+#endif
+}
+
+/* exported interface documented in vita/remote.h */
+nserror vita_remote_start(void)
+{
+	struct sockaddr_in sa;
+	int on = 1;
+
+#ifdef VITA_HOST_SIM
+	if (getenv("VITA_SIM_REMOTE_PORT") != NULL)
+		port = atoi(getenv("VITA_SIM_REMOTE_PORT"));
+#endif
+	listen_fd = socket(AF_INET, SOCK_STREAM, 0);
+	if (listen_fd < 0) {
+		vita_diag_log("remote: socket -> errno %d", errno);
+		return NSERROR_INIT_FAILED;
+	}
+	setsockopt(listen_fd, SOL_SOCKET, SO_REUSEADDR, &on, sizeof(on));
+	memset(&sa, 0, sizeof(sa));
+	sa.sin_family = AF_INET;
+	sa.sin_port = htons((unsigned short)port);
+	sa.sin_addr.s_addr = htonl(INADDR_ANY);
+	if (bind(listen_fd, (struct sockaddr *)&sa, sizeof(sa)) != 0 ||
+	    listen(listen_fd, 4) != 0 || set_nonblocking(listen_fd) != 0) {
+		vita_diag_log("remote: cannot listen on :%d, errno %d",
+			      port, errno);
+		close(listen_fd);
+		listen_fd = -1;
+		return NSERROR_INIT_FAILED;
+	}
+	vita_diag_log("remote: listening on :%d", port);
+	return NSERROR_OK;
+}
+
+/* exported interface documented in vita/remote.h */
+const char *vita_remote_address(void)
+{
+	struct in_addr a;
+	const char *ip;
+
+	if (listen_fd < 0)
+		return NULL;
+	ip = vita_net_ip();
+	if (ip == NULL || inet_pton(AF_INET, ip, &a) != 1)
+		return NULL;
+	snprintf(address, sizeof(address), "%s:%d", ip, port);
+	return address;
+}
+
+static void send_all(const char *s, size_t n)
+{
+	unsigned int t0 = vita_diag_ms();
+
+	/* Small responses; a full socket buffer only waits briefly. */
+	while (n > 0 && vita_diag_ms() - t0 < 1000) {
+		ssize_t w = send(client_fd, s, n, 0);
+		if (w > 0) {
+			s += w;
+			n -= (size_t)w;
+		} else if (w < 0 && errno != EAGAIN && errno != EWOULDBLOCK) {
+			break;
+		}
+	}
+}
+
+static void respond(const char *status, const char *extra_headers,
+		    const char *body)
+{
+	char head[512];
+	int n = snprintf(head, sizeof(head),
+			 "HTTP/1.0 %s\r\nContent-Type: text/html; "
+			 "charset=utf-8\r\nContent-Length: %u\r\n"
+			 "Cache-Control: no-store\r\n%sConnection: close\r\n\r\n",
+			 status, (unsigned int)strlen(body),
+			 extra_headers ? extra_headers : "");
+	send_all(head, (size_t)n);
+	send_all(body, strlen(body));
+}
+
+/** Decode %XX and '+' in place. */
+static void url_decode(char *s)
+{
+	char *o = s;
+
+	for (; *s != '\0'; s++) {
+		if (*s == '+') {
+			*o++ = ' ';
+		} else if (*s == '%' && s[1] != '\0' && s[2] != '\0') {
+			char hex[3] = { s[1], s[2], 0 };
+			*o++ = (char)strtol(hex, NULL, 16);
+			s += 2;
+		} else {
+			*o++ = *s;
+		}
+	}
+	*o = '\0';
+}
+
+/** HTML-escape into out. */
+static void escape(const char *s, char *out, size_t max)
+{
+	size_t o = 0;
+
+	for (; *s != '\0' && o + 7 < max; s++) {
+		switch (*s) {
+		case '&': o += (size_t)sprintf(out + o, "&amp;"); break;
+		case '<': o += (size_t)sprintf(out + o, "&lt;"); break;
+		case '>': o += (size_t)sprintf(out + o, "&gt;"); break;
+		case '"': o += (size_t)sprintf(out + o, "&quot;"); break;
+		default: out[o++] = *s; break;
+		}
+	}
+	out[o] = '\0';
+}
+
+static const char form_page[] =
+	"<!DOCTYPE html><html><head><meta charset=\"utf-8\">"
+	"<meta name=\"viewport\" content=\"width=device-width\">"
+	"<title>VitaBrowser</title></head><body style=\"font-family:"
+	"sans-serif;margin:24px\"><h1>Open on the Vita</h1>"
+	"<form action=\"/open\" method=\"get\"><input name=\"url\" "
+	"style=\"width:90%;font-size:20px\" autofocus placeholder="
+	"\"https://...\"> <button style=\"font-size:20px\">Open</button>"
+	"</form></body></html>";
+
+/** The value of header name in the request, or "". */
+static void header(const char *name, char *out, size_t max)
+{
+	const char *p = req;
+	size_t nl = strlen(name);
+
+	out[0] = '\0';
+	while ((p = strstr(p, "\r\n")) != NULL) {
+		p += 2;
+		if (strncasecmp(p, name, nl) == 0 && p[nl] == ':') {
+			const char *v = p + nl + 1, *e;
+			while (*v == ' ')
+				v++;
+			e = strstr(v, "\r\n");
+			if (e == NULL)
+				e = v + strlen(v);
+			snprintf(out, max, "%.*s", (int)(e - v), v);
+			return;
+		}
+	}
+}
+
+static void handle(struct gui_window *gw)
+{
+	char path[2048], body[4096], esc[2200], cookie[512];
+	char *q;
+
+	vita_remote_requests++;
+	if (sscanf(req, "GET %2047s", path) != 1) {
+		respond("405 Method Not Allowed", NULL, "GET only");
+		return;
+	}
+	vita_diag_log("remote: GET %.200s", path);
+	if (strcmp(path, "/") == 0) {
+		respond("200 OK", NULL, form_page);
+	} else if (strncmp(path, "/open?", 6) == 0 &&
+		   (q = strstr(path, "url=")) != NULL) {
+		char *amp = strchr(q, '&');
+		if (amp != NULL)
+			*amp = '\0';
+		url_decode(q + 4);
+		escape(q + 4, esc, sizeof(esc));
+		snprintf(body, sizeof(body), "<!DOCTYPE html><html><head>"
+			 "<meta charset=\"utf-8\"><title>Sent</title></head>"
+			 "<body style=\"font-family:sans-serif;margin:24px\">"
+			 "<p>Opening on the Vita: <b>%s</b></p>"
+			 "<p><a href=\"/\">Send another</a></p></body></html>",
+			 esc);
+		respond("200 OK", NULL, body);
+		if (vita_chrome_open(gw, q + 4, "remote") == NSERROR_OK)
+			vita_remote_opened++;
+	} else if (strcmp(path, "/cookie") == 0) {
+		char set[128];
+		header("Cookie", cookie, sizeof(cookie));
+		vita_diag_log("remote: /cookie request carried \"%s\"",
+			      cookie);
+		escape(cookie, esc, sizeof(esc));
+		snprintf(set, sizeof(set), "Set-Cookie: vbtest=%ld; "
+			 "Max-Age=31536000; Path=/\r\n", (long)time(NULL));
+		snprintf(body, sizeof(body), "<!DOCTYPE html><html><head>"
+			 "<meta charset=\"utf-8\"><title>Cookie test</title>"
+			 "</head><body style=\"font-family:sans-serif\">"
+			 "<p id=\"got\">Cookie sent: [%s]</p></body></html>",
+			 esc);
+		respond("200 OK", set, body);
+	} else {
+		respond("404 Not Found", NULL, "not found");
+	}
+}
+
+/* exported interface documented in vita/remote.h */
+void vita_remote_poll(struct gui_window *gw)
+{
+	if (listen_fd < 0)
+		return;
+	if (client_fd < 0) {
+		client_fd = accept(listen_fd, NULL, NULL);
+		if (client_fd < 0)
+			return;
+		set_nonblocking(client_fd);
+		client_ms = vita_diag_ms();
+		req_len = 0;
+	}
+	for (;;) {
+		ssize_t r = recv(client_fd, req + req_len,
+				 sizeof(req) - 1 - req_len, 0);
+		if (r > 0) {
+			req_len += (size_t)r;
+			req[req_len] = '\0';
+			if (strstr(req, "\r\n\r\n") != NULL ||
+			    req_len >= sizeof(req) - 1)
+				break;
+			continue;
+		}
+		if (r == 0 ||
+		    (errno != EAGAIN && errno != EWOULDBLOCK) ||
+		    vita_diag_ms() - client_ms > REQUEST_MS) {
+			/* Closed, failed or too slow: drop it. */
+			close(client_fd);
+			client_fd = -1;
+		}
+		return;	/* the rest next pass */
+	}
+	handle(gw);
+	close(client_fd);
+	client_fd = -1;
+}
