+ * README §14.6: typing a URL on the Vita is the worst interaction in the
+ * product, so a tiny HTTP listener on the LAN takes one instead. Opening
+ * http://<vita>:8080/ on any device on the same Wi-Fi shows a form; what it
+ * sends opens on the Vita. Served from the main loop, one request at a
+ * time, never blocking it.
+ */
+
+#ifndef NETSURF_VITA_REMOTE_H
+#define NETSURF_VITA_REMOTE_H
+
+#include "utils/errors.h"
+
+struct gui_window;
+
+/** The listener's port. */
+#define VITA_REMOTE_PORT 8080
+
+/** The port listened on: VITA_REMOTE_PORT (in the simulator,
+ * VITA_SIM_REMOTE_PORT may move it: the build machine's 8080 can be
+ * taken). */
+int vita_remote_port(void);
+
+/** Start listening on every interface. */
+nserror vita_remote_start(void);
+
+/** "ip:port" to show the user, or NULL when not listening / no address. */
+const char *vita_remote_address(void);
+
+/** Serve what has arrived; open pushed URLs in gw. Main loop, every pass. */
+void vita_remote_poll(struct gui_window *gw);
+
+/** Requests served so far, and URLs opened from them. */
+extern unsigned int vita_remote_requests, vita_remote_opened;
+
+#endif
