+ * You should have received a copy of the GNU General Public License
+ * along with this program.  If not, see <http://www.gnu.org/licenses/>.
+ */
+
+/**
+ * \file
+ * Vita frontend: browsing controls (vita/input.c).
+ *
+ * Input arrives as one record per main-loop pass -- the buttons held, the
+ * sticks, and a finger on the front touch panel -- read from the hardware
+ * or, in the autotest's interaction pass, scripted (vita/interact.c). Both
+ * go through vita_input_browse(), so the pass tests the real controls.
+ */
+
+#ifndef NETSURF_VITA_INPUT_H
+#define NETSURF_VITA_INPUT_H
+
+#include <stdbool.h>
+
+struct gui_window;
+
+/** One pass's input. */
+struct vita_input {
+	unsigned int buttons;		/**< SCE_CTRL_* held */
+	unsigned char lx, ly, rx, ry;	/**< sticks, 128 = centre */
+	bool touch;			/**< a finger on the front panel */
+	int tx, ty;			/**< where, in screen pixels */
+};
+
+/** What the main loop has to do after vita_input_browse(). */
+enum vita_browse_action {
+	VITA_BROWSE_NONE,
+	VITA_BROWSE_ENTER_TEXT,		/**< TRIANGLE: URL or text entry */
+	VITA_BROWSE_HOME,		/**< START: the home page */
+};
+
+/** Zoom steps SQUARE cycles through. */
+#define VITA_ZOOM_STEPS 4
+extern const float vita_zoom_steps[VITA_ZOOM_STEPS];
+
+/** Read the pad and the front touch panel. */
+void vita_input_read(struct vita_input *in);
+
+/** Neutral input: nothing held, sticks centred, no touch. */
+void vita_input_idle(struct vita_input *in);
+
+/**
+ * Apply the browsing controls for one pass.
+ *
+ *   touch: tap = click, drag = scroll    left stick: pointer, CROSS clicks
+ *   right stick, D-pad: scroll           L / R: back / forward
+ *   SQUARE: zoom 100/125/150/200 %       TRIANGLE: enter a URL or text
+ *   START: home                          (SELECT combinations are the test
+ *                                         functions, handled by main.c)
+ *
+ * \param in    this pass's input
+ * \param prev  the previous pass's, for button presses (edges)
+ */
+enum vita_browse_action vita_input_browse(struct gui_window *gw,
+					  const struct vita_input *in,
+					  const struct vita_input *prev);
+
+/** The pointer: position and whether to draw it (moved recently). */
+bool vita_input_pointer(int *x, int *y);
+
+/** Put the pointer back in the middle of the screen. */
+void vita_input_pointer_home(void);
+
+/** The current zoom step's index into vita_zoom_steps. */
+unsigned int vita_input_zoom_step(void);
+
+/** Set the zoom step (and the window's scale). */
+void vita_input_set_zoom(struct gui_window *gw, unsigned int step);
+
+/** Counters, for the log and the interaction pass. */
+struct vita_input_stats {
+	unsigned int clicks;		/**< clicks sent to the page */
+	unsigned int taps, drags;	/**< touch gestures recognised */
+	unsigned int backs, forwards;	/**< history steps taken */
+};
+extern struct vita_input_stats vita_input_stats;
+
+#endif
diff --git a/frontends/vita/interact.c b/frontends/vita/interact.c
new file mode 100644
index 0000000..4660d03
--- /dev/null
+++ b/frontends/vita/interact.c
@@ -0,0 +1,408 @@
+/*
+ * Copyright 2026 VitaBrowser contributors
+ *
+ * This file is part of NetSurf, http://www.netsurf-browser.org/
+ *
+ * NetSurf is free software; you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation; version 2 of the License.
+ *
+ * NetSurf is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+ * GNU General Public License for more details.
+ *
+ * You should have received a copy of the GNU General Public License
+ * along with this program.  If not, see <http://www.gnu.org/licenses/>.
+ */
+
+/**
+ * \file
+ * Vita frontend: the autotest's interaction pass (see vita/interact.h).
+ *
+ * The script works on the IN-* test pages (testpages/pages/IN-*.html),
+ * whose links and fields sit at fixed positions. Each step acts, waits for
+ * the page to settle (at least SETTLE_MIN_MS after acting), then checks.
+ */
+
+#include <stdbool.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include <psp2/ctrl.h>
+
+#include "utils/nsurl.h"
+#include "netsurf/browser_window.h"
+
+#include "vita/chrome.h"
+#include "vita/diag.h"
+#include "vita/input.h"
+#include "vita/remote.h"
+#include "vita/resolve.h"
+#include "vita/window.h"
+#include "vita/interact.h"
+
+/** After acting, wait at least this long before a page can count as
+ * settled, ms: a navigation's fetch may not have started yet. */
+#define SETTLE_MIN_MS 400
+/** Give up on a step after this long, ms. */
+#define STEP_TIMEOUT_MS 20000
+
+#define T "file:///app0:/testpages/"
+
+enum act {
+	A_NONE,		/**< nothing: a check only */
+	A_OPEN,		/**< navigate to arg */
+	A_TAP,		/**< touch at x,y and let go */
+	A_BUTTON,	/**< press and release button */
+	A_POINT,	/**< move the pointer to x,y with the stick, CROSS */
+	A_DRAG,		/**< touch at x,y, move to x2,y2, let go */
+	A_TYPE,		/**< deliver arg as entered text */
+	A_REMOTE,	/**< navigate to the LAN listener's path arg */
+};
+
+enum check {
+	C_URL,		/**< the URL ends with expect */
+	C_SCROLL,	/**< the vertical scroll offset is value */
+	C_ZOOM,		/**< the zoom step is value */
+	C_BLOCKED,	/**< at least value fetches were blocked by this step */
+	C_EDITING,	/**< a text field has the caret */
+	C_REMOTE,	/**< a pushed URL was opened, and the URL ends expect */
+	C_COOKIE,	/**< the saved jar holds the listener's cookie */
+	C_TYPED,	/**< vita_chrome_typed_url() turns text into URLs */
+	C_NONE,		/**< nothing to check */
+};
+
+static const struct step {
+	const char *name;
+	enum act act;
+	const char *arg;
+	int x, y, x2, y2;
+	unsigned int button;
+	enum check check;
+	const char *expect;
+	int value;
+	const char *dump;
+} steps[] = {
+	{ "typed text becomes a URL", A_NONE, NULL, 0, 0, 0, 0, 0,
+	  C_TYPED, NULL, 0, NULL },
+	{ "open IN-links", A_OPEN, T "IN-links.html", 0, 0, 0, 0, 0,
+	  C_URL, "IN-links.html", 0, NULL },
+	{ "tap a link", A_TAP, NULL, 250, 140, 0, 0, 0,
+	  C_URL, "IN-target.html?via=tap", 0, NULL },
+	{ "L goes back", A_BUTTON, NULL, 0, 0, 0, 0, SCE_CTRL_LTRIGGER,
+	  C_URL, "IN-links.html", 0, NULL },
+	{ "R goes forward", A_BUTTON, NULL, 0, 0, 0, 0, SCE_CTRL_RTRIGGER,
+	  C_URL, "IN-target.html?via=tap", 0, NULL },
+	{ "L back again", A_BUTTON, NULL, 0, 0, 0, 0, SCE_CTRL_LTRIGGER,
+	  C_URL, "IN-links.html", 0, NULL },
+	{ "pointer + CROSS clicks", A_POINT, NULL, 620, 272, 0, 0, 0,
+	  C_URL, "IN-target.html?via=pointer", 0, NULL },
+	{ "L back", A_BUTTON, NULL, 0, 0, 0, 0, SCE_CTRL_LTRIGGER,
+	  C_URL, "IN-links.html", 0, NULL },
+	{ "drag scrolls", A_DRAG, NULL, 480, 450, 480, 150, 0,
+	  C_SCROLL, NULL, 300, NULL },
+	{ "SQUARE zooms to 125%", A_BUTTON, NULL, 0, 0, 0, 0, SCE_CTRL_SQUARE,
+	  C_ZOOM, NULL, 1, "IN-zoom125" },
+	{ "SQUARE: 150%", A_BUTTON, NULL, 0, 0, 0, 0, SCE_CTRL_SQUARE,
+	  C_ZOOM, NULL, 2, NULL },
+	{ "SQUARE: 200%", A_BUTTON, NULL, 0, 0, 0, 0, SCE_CTRL_SQUARE,
+	  C_ZOOM, NULL, 3, NULL },
+	{ "SQUARE: back to 100%", A_BUTTON, NULL, 0, 0, 0, 0,
+	  SCE_CTRL_SQUARE, C_ZOOM, NULL, 0, NULL },
+	{ "ad and tracker hosts are blocked", A_OPEN, T "IN-block.html",
+	  0, 0, 0, 0, 0, C_BLOCKED, NULL, 3, "IN-block" },
+	{ "open IN-form", A_OPEN, T "IN-form.html", 0, 0, 0, 0, 0,
+	  C_URL, "IN-form.html", 0, NULL },
+	{ "tap puts the caret in a field", A_TAP, NULL, 300, 120, 0, 0, 0,
+	  C_EDITING, NULL, 0, NULL },
+	{ "text goes into the field", A_TYPE, "hello vita", 0, 0, 0, 0, 0,
+	  C_EDITING, NULL, 0, NULL },
+	{ "tap the submit button", A_TAP, NULL, 200, 225, 0, 0, 0,
+	  C_URL, "IN-target.html?via=form&q=hello+vita", 0, "IN-form-sent" },
+	{ "a typed URL opens", A_TYPE, T "IN-target.html?via=typed",
+	  0, 0, 0, 0, 0, C_URL, "IN-target.html?via=typed", 0, NULL },
+	{ "a URL pushed to the LAN listener opens", A_REMOTE,
+	  "/open?url=file%3A%2F%2F%2Fapp0%3A%2F"
+	  "testpages%2FIN-target.html%3Fvia%3Dremote", 0, 0, 0, 0, 0,
+	  C_REMOTE, "IN-target.html?via=remote", 0, NULL },
+	{ "cookies are saved to the card", A_REMOTE,
+	  "/cookie", 0, 0, 0, 0, 0,
+	  C_COOKIE, NULL, 0, NULL },
+	{ "START goes home", A_BUTTON, NULL, 0, 0, 0, 0, SCE_CTRL_START,
+	  C_URL, "VitaBrowser/home.html", 0, NULL },
+};
+#define STEP_COUNT (sizeof(steps) / sizeof(steps[0]))
+
+unsigned int vita_interact_passed, vita_interact_total;
+
+static const struct vita_interact_host *host;
+static struct {
+	unsigned int step;
+	enum { PH_ACT, PH_WAIT, PH_DUMP } phase;
+	unsigned int pass;		/**< passes into the current act */
+	unsigned int acted_ms;		/**< when the act finished */
+	unsigned int started_ms;	/**< when the step started */
+	unsigned int blocked0;		/**< vita_resolve_blocked before */
+	unsigned int opened0;		/**< vita_remote_opened before */
+	bool cross;			/**< A_POINT: CROSS is down */
+} run;
+
+/* exported interface documented in vita/interact.h */
+void vita_interact_start(const struct vita_interact_host *h)
+{
+	host = h;
+	memset(&run, 0, sizeof(run));
+	vita_interact_passed = vita_interact_total = 0;
+	run.started_ms = vita_diag_ms();
+	vita_input_pointer_home();
+	vita_diag_log("interact: start, %u steps", (unsigned int)STEP_COUNT);
+}
+
+static bool url_ends(struct gui_window *gw, const char *suffix, char *got,
+		     size_t max)
+{
+	struct browser_window *bw = vita_window_browser(gw);
+	nsurl *u = bw ? browser_window_access_url(bw) : NULL;
+	const char *s = u ? nsurl_access(u) : "";
+	size_t n = strlen(s), k = strlen(suffix);
+
+	snprintf(got, max, "%s", s);
+	return n >= k && strcmp(s + n - k, suffix) == 0;
+}
+
+static bool typed_ok(char *detail, size_t max)
+{
+	static const struct { const char *in, *out; } t[] = {
+		{ "example.com", "https://example.com" },
+		{ "  en.m.wikipedia.org/wiki/PS_Vita ",
+		  "https://en.m.wikipedia.org/wiki/PS_Vita" },
+		{ "http://x.test/a?b=1", "http://x.test/a?b=1" },
+		{ "vita browser",
+		  "https://lite.duckduckgo.com/lite/?q=vita+browser" },
+		{ "127.0.0.1:8080/cookie", "http://127.0.0.1:8080/cookie" },
+		{ "localhost/x", "http://localhost/x" },
+		{ "1.example.com", "https://1.example.com" },
+	};
+	unsigned int i;
+
+	for (i = 0; i < sizeof(t) / sizeof(t[0]); i++) {
+		char *u = vita_chrome_typed_url(t[i].in);
+		bool ok = u != NULL && strcmp(u, t[i].out) == 0;
+		if (!ok) {
+			snprintf(detail, max, "\"%s\" -> \"%s\"", t[i].in,
+				 u ? u : "(null)");
+			free(u);
+			return false;
+		}
+		free(u);
+	}
+	snprintf(detail, max, "%u cases", i);
+	return true;
+}
+
+static bool cookie_ok(char *detail, size_t max)
+{
+	const char *path = host->save_cookies();
+	char buf[4096];
+	size_t n = 0;
+	FILE *fp = path ? fopen(path, "rb") : NULL;
+
+	if (fp != NULL) {
+		n = fread(buf, 1, sizeof(buf) - 1, fp);
+		fclose(fp);
+	}
+	buf[n] = '\0';
+	snprintf(detail, max, "%s: %u bytes%s", path ? path : "(no jar)",
+		 (unsigned int)n, strstr(buf, "vbtest") ? ", has vbtest" : "");
+	return strstr(buf, "vbtest") != NULL;
+}
+
+/** Check the step just settled; log it. */
+static void check(struct gui_window *gw, const struct step *s)
+{
+	char detail[300] = "";
+	bool ok = false;
+	int x, y;
+
+	switch (s->check) {
+	case C_URL:
+		ok = url_ends(gw, s->expect, detail, sizeof(detail));
+		break;
+	case C_REMOTE:
+		ok = url_ends(gw, s->expect, detail, sizeof(detail)) &&
+			vita_remote_opened == run.opened0 + 1;
+		break;
+	case C_SCROLL:
+		vita_window_scroll_pos(gw, &x, &y);
+		ok = y == s->value;
+		snprintf(detail, sizeof(detail), "scroll %d,%d", x, y);
+		break;
+	case C_ZOOM:
+		ok = (int)vita_input_zoom_step() == s->value;
+		snprintf(detail, sizeof(detail), "zoom %d%%",
+			 (int)(vita_zoom_steps[vita_input_zoom_step()] *
+			       100.0f + 0.5f));
+		break;
+	case C_BLOCKED:
+		ok = vita_resolve_blocked - run.blocked0 >=
+			(unsigned int)s->value;
+		snprintf(detail, sizeof(detail), "%u blocked",
+			 vita_resolve_blocked - run.blocked0);
+		break;
+	case C_EDITING:
+		ok = vita_chrome_editing(gw);
+		snprintf(detail, sizeof(detail), "caret %s",
+			 ok ? "in a field" : "not in a field");
+		break;
+	case C_COOKIE:
+		ok = cookie_ok(detail, sizeof(detail));
+		break;
+	case C_TYPED:
+		ok = typed_ok(detail, sizeof(detail));
+		break;
+	case C_NONE:
+		ok = true;
+		break;
+	}
+	vita_interact_total++;
+	if (ok)
+		vita_interact_passed++;
+	vita_diag_log("interact: %u %s: %s (%s)", run.step + 1, s->name,
+		      ok ? "PASS" : "FAIL", detail);
+}
+
+/** This pass's input for the current act; true when the act is done. */
+static bool act(struct gui_window *gw, const struct step *s,
+		struct vita_input *in)
+{
+	unsigned int p = run.pass++;
+	int px, py;
+
+	switch (s->act) {
+	case A_NONE:
+		return true;
+	case A_OPEN:
+		host->open(gw, s->arg);
+		return true;
+	case A_REMOTE: {
+		/* Through curl and the listener, over loopback. */
+		char url[512];
+		snprintf(url, sizeof(url), "http://127.0.0.1:%d%s",
+			 vita_remote_port(), s->arg);
+		host->open(gw, url);
+		return true;
+	}
+	case A_TYPE:
+		vita_chrome_enter_text(gw, s->arg);
+		return true;
+	case A_BUTTON:
+		if (p == 0) {
+			in->buttons = s->button;
+			return false;
+		}
+		return true;	/* released */
+	case A_TAP:
+		if (p == 0) {
+			in->touch = true;
+			in->tx = s->x;
+			in->ty = s->y;
+			return false;
+		}
+		return true;
+	case A_DRAG: {
+		/* Ten passes from (x, y) to (x2, y2), then let go. */
+		if (p <= 10) {
+			in->touch = true;
+			in->tx = s->x + (s->x2 - s->x) * (int)p / 10;
+			in->ty = s->y + (s->y2 - s->y) * (int)p / 10;
+			return false;
+		}
+		return true;
+	}
+	case A_POINT:
+		/* The real stick path: push toward the target until the
+		 * pointer is within a few pixels, then press and release
+		 * CROSS. */
+		vita_input_pointer(&px, &py);
+		if (p < 400 && (abs(px - s->x) > 6 || abs(py - s->y) > 6)) {
+			int dx = s->x - px, dy = s->y - py;
+			/* Slow down near the target (the curve is
+			 * quadratic). */
+			int mag = (abs(dx) > 40 || abs(dy) > 40) ? 127 : 70;
+			if (dx != 0)
+				in->lx = (unsigned char)(128 + (dx > 0 ? mag :
+								-mag));
+			if (dy != 0)
+				in->ly = (unsigned char)(128 + (dy > 0 ? mag :
+								-mag));
+			if (abs(dx) <= 6)
+				in->lx = 128;
+			if (abs(dy) <= 6)
+				in->ly = 128;
+			return false;
+		}
+		if (!run.cross) {
+			/* Reached: CROSS down this pass, up the next. */
+			run.cross = true;
+			in->buttons = SCE_CTRL_CROSS;
+			return false;
+		}
+		return true;
+	}
+	return true;
+}
+
+/* exported interface documented in vita/interact.h */
+bool vita_interact_step(struct gui_window *gw, struct vita_input *in)
+{
+	const struct step *s;
+	unsigned int now = vita_diag_ms();
+
+	vita_input_idle(in);
+	if (run.step >= STEP_COUNT) {
+		vita_diag_log("interact: %u/%u passed", vita_interact_passed,
+			      vita_interact_total);
+		return false;
+	}
+	s = &steps[run.step];
+	switch (run.phase) {
+	case PH_ACT:
+		if (run.pass == 0) {
+			run.started_ms = now;
+			run.blocked0 = vita_resolve_blocked;
+			run.opened0 = vita_remote_opened;
+			vita_diag_log("interact: %u %s", run.step + 1, s->name);
+		}
+		if (act(gw, s, in)) {
+			run.phase = PH_WAIT;
+			run.acted_ms = now;
+		}
+		return true;
+	case PH_WAIT:
+		if (now - run.acted_ms < SETTLE_MIN_MS ||
+		    (!host->settled(gw) &&
+		     now - run.started_ms < STEP_TIMEOUT_MS))
+			return true;
+		if (!host->settled(gw))
+			vita_diag_log("interact: %u did not settle in %u ms",
+				      run.step + 1, STEP_TIMEOUT_MS);
+		check(gw, s);
+		if (s->dump != NULL) {
+			host->dump(s->dump);
+			run.phase = PH_DUMP;
+			return true;
+		}
+		break;
+	case PH_DUMP:
+		if (!host->dump_done())
+			return true;
+		break;
+	}
+	run.step++;
+	run.phase = PH_ACT;
+	run.pass = 0;
+	run.cross = false;
+	return true;
+}
