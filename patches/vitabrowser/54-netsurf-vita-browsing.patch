+/**
+ * \file
+ * Vita frontend: the home page, bookmarks, and entering URLs and text
+ * (see vita/chrome.h).
+ */
+
+#include <stdbool.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#ifdef __vita__
+#include <psp2/common_dialog.h>
+#include <psp2/ime_dialog.h>
+#include <psp2/libime.h>
+#include <psp2/kernel/threadmgr.h>
+#include <vita2d.h>
+#endif
+
+#include "utils/errors.h"
+#include "utils/nsurl.h"
+#include "utils/utf8.h"
+#include "netsurf/browser_window.h"
+#include "netsurf/keypress.h"
+
+#include "vita/diag.h"
+#include "vita/remote.h"
+#include "vita/window.h"
+#include "vita/chrome.h"
+
+/** Room for the keyboard's longest text in UTF-8. */
+#define TEXT_MAX (2048 * 3 + 1)
+
+/** Where typed words go (a page that works without JavaScript). */
+#define SEARCH_URL "https://lite.duckduckgo.com/lite/?q="
+
+static const char default_bookmarks[] =
+	"# VitaBrowser bookmarks: one \"Title | URL\" per line; lines\n"
+	"# starting with # are ignored. Edit this file freely (VitaShell,\n"
+	"# FTP); the home page is rebuilt from it at every start.\n"
+	"Claude Code | https://claude.ai/code\n"
+	"Wikipedia (mobile) | https://en.m.wikipedia.org/\n"
+	"Hacker News | https://news.ycombinator.com/\n"
+	"CNN Lite | https://lite.cnn.com/\n"
+	"example.com | https://example.com/\n";
+
+/** Write s to fp with HTML's special characters escaped. */
+static void put_escaped(FILE *fp, const char *s, size_t n)
+{
+	size_t i;
+
+	for (i = 0; i < n && s[i] != '\0'; i++) {
+		switch (s[i]) {
+		case '&': fputs("&amp;", fp); break;
+		case '<': fputs("&lt;", fp); break;
+		case '>': fputs("&gt;", fp); break;
+		case '"': fputs("&quot;", fp); break;
+		default: fputc(s[i], fp); break;
+		}
+	}
+}
+
+/** Trim spaces from both ends of [*s, *s + *n). */
+static void trim(const char **s, size_t *n)
+{
+	while (*n > 0 && (**s == ' ' || **s == '\t')) {
+		(*s)++;
+		(*n)--;
+	}
+	while (*n > 0 && ((*s)[*n - 1] == ' ' || (*s)[*n - 1] == '\t' ||
+			  (*s)[*n - 1] == '\r' || (*s)[*n - 1] == '\n'))
+		(*n)--;
+}
+
+/* exported interface documented in vita/chrome.h */
+nserror vita_chrome_write_home(const char *const *test_pages, unsigned int n)
+{
+	char line[1024];
+	FILE *bm, *fp;
+	unsigned int i, count = 0;
+
+	bm = fopen(VITA_BOOKMARKS_FILE, "r");
+	if (bm == NULL) {
+		fp = fopen(VITA_BOOKMARKS_FILE, "w");
+		if (fp != NULL) {
+			fputs(default_bookmarks, fp);
+			fclose(fp);
+			vita_diag_log("chrome: wrote default %s",
+				      VITA_BOOKMARKS_FILE);
+		}
+		bm = fopen(VITA_BOOKMARKS_FILE, "r");
+	}
+	fp = fopen(VITA_HOME_FILE, "w");
+	if (fp == NULL) {
+		if (bm != NULL)
+			fclose(bm);
+		return NSERROR_SAVE_FAILED;
+	}
+	fputs("<!DOCTYPE html>\n<html><head><meta charset=\"utf-8\">"
+	      "<title>VitaBrowser</title><style>\n"
+	      "body { font-family: sans-serif; font-size: 18px;"
+	      " margin: 28px 12px 30px 12px; }\n"
+	      "h1 { font-size: 26px; margin: 0 0 6px 0; }\n"
+	      "h2 { font-size: 20px; margin: 14px 0 4px 0; }\n"
+	      ".bm a { display: block; padding: 9px 12px; margin: 4px 0;"
+	      " background: #e8eef8; border-radius: 6px; color: #103070;"
+	      " text-decoration: none; font-size: 22px; }\n"
+	      ".hint { color: #444; font-size: 15px; }\n"
+	      ".tests a { display: inline-block; margin: 2px 8px 2px 0;"
+	      " font-size: 15px; }\n"
+	      "</style></head><body>\n<h1>VitaBrowser</h1>\n"
+	      "<p class=\"hint\">Tap a link, or move the pointer (left stick)"
+	      " and press &#x2715;. &#x25b3; types a URL. L / R: back /"
+	      " forward. &#x25a1;: zoom. START: this page.", fp);
+	if (vita_remote_address() != NULL) {
+		fputs(" From a phone or PC on the same Wi-Fi: <b>http://", fp);
+		put_escaped(fp, vita_remote_address(), 64);
+		fputs("/</b>", fp);
+	}
+	fputs("</p>\n<h2>Bookmarks</h2>\n<div class=\"bm\">\n", fp);
+	while (bm != NULL && fgets(line, sizeof(line), bm) != NULL) {
+		const char *bar = strchr(line, '|');
+		const char *t = line, *u;
+		size_t tn, un;
+
+		if (line[0] == '#' || bar == NULL)
+			continue;
+		tn = (size_t)(bar - line);
+		u = bar + 1;
+		un = strlen(u);
+		trim(&t, &tn);
+		trim(&u, &un);
+		if (un == 0)
+			continue;
+		fputs("<a href=\"", fp);
+		put_escaped(fp, u, un);
+		fputs("\">", fp);
+		put_escaped(fp, tn > 0 ? t : u, tn > 0 ? tn : un);
+		fputs("</a>\n", fp);
+		count++;
+	}
+	if (bm != NULL)
+		fclose(bm);
+	fputs("</div>\n<p class=\"hint\">Bookmarks: "
+	      VITA_BOOKMARKS_FILE "</p>\n<h2>Test pages</h2>\n"
+	      "<div class=\"tests\">\n", fp);
+	for (i = 0; i < n; i++) {
+		fprintf(fp, "<a href=\"file:///app0:/testpages/%s.html\">",
+			test_pages[i]);
+		put_escaped(fp, test_pages[i], 64);
+		fputs("</a>\n", fp);
+	}
+	/* The cookie jar's persistence test (vita/remote.c /cookie). */
+	fprintf(fp, "<a href=\"http://127.0.0.1:%d/cookie\">cookie test</a>\n",
+		vita_remote_port());
+	fputs("</div>\n</body></html>\n", fp);
+	fclose(fp);
+	vita_diag_log("chrome: home page with %u bookmarks", count);
+	return NSERROR_OK;
+}
+
+/* exported interface documented in vita/chrome.h */
+char *vita_chrome_typed_url(const char *typed)
+{
+	const char *s = typed;
+	size_t n = strlen(typed), i;
+	char *out, *o;
+	nsurl *url;
+
+	trim(&s, &n);
+	if (n == 0)
+		return NULL;
+	/* A URL with a scheme, as it is. */
+	for (i = 0; i < n && s[i] != ':' && s[i] != '/' && s[i] != ' '; i++)
+		;
+	if (i > 0 && i < n && s[i] == ':' && nsurl_create(s, &url) ==
+	    NSERROR_OK) {
+		out = strndup(s, n);
+		nsurl_unref(url);
+		return out;
+	}
+	/* A host or host/path: no spaces, and a dot (or localhost). An
+	 * IPv4 address or localhost gets http:// -- a LAN device, like the
+	 * Vita's own listener, rarely speaks TLS -- anything else https://. */
+	if (memchr(s, ' ', n) == NULL && (memchr(s, '.', n) != NULL ||
+					   strncmp(s, "localhost", 9) == 0)) {
+		size_t h = strcspn(s, ":/?#");
+		bool ip = h > 0 && h <= n && strspn(s, "0123456789.") == h;
+		bool plain = ip || (h == 9 && strncmp(s, "localhost", 9) == 0);
+		out = malloc(n + 9);
+		if (out != NULL)
+			snprintf(out, n + 9, "%s%.*s",
+				 plain ? "http://" : "https://", (int)n, s);
+		return out;
+	}
+	/* Words: a search. */
+	out = malloc(sizeof(SEARCH_URL) + n * 3);
+	if (out == NULL)
+		return NULL;
+	o = out + sprintf(out, "%s", SEARCH_URL);
+	for (i = 0; i < n; i++) {
+		unsigned char c = (unsigned char)s[i];
+		if ((c >= 'A' && c <= 'Z') || (c >= 'a' && c <= 'z') ||
+		    (c >= '0' && c <= '9') || c == '-' || c == '_' ||
+		    c == '.' || c == '~')
+			*o++ = (char)c;
+		else if (c == ' ')
+			*o++ = '+';
+		else
+			o += sprintf(o, "%%%02X", c);
+	}
+	*o = '\0';
+	return out;
+}
+
+/* exported interface documented in vita/chrome.h */
+nserror vita_chrome_open(struct gui_window *gw, const char *typed,
+			 const char *why)
+{
+	struct browser_window *bw = vita_window_browser(gw);
+	char *s = vita_chrome_typed_url(typed);
+	nsurl *url;
+	nserror err;
+
+	if (bw == NULL || s == NULL) {
+		free(s);
+		return NSERROR_BAD_PARAMETER;
+	}
+	err = nsurl_create(s, &url);
+	vita_diag_log("chrome: open %s (%s) -> %d", s, why, err);
+	free(s);
+	if (err != NSERROR_OK)
+		return err;
+	err = browser_window_navigate(bw, url, NULL, BW_NAVIGATE_HISTORY,
+				      NULL, NULL, NULL);
+	nsurl_unref(url);
+	return err;
+}
+
+/* exported interface documented in vita/chrome.h */
+bool vita_chrome_editing(struct gui_window *gw)
+{
+	struct browser_window *bw = vita_window_browser(gw);
+
+	return bw != NULL &&
+		(browser_window_get_editor_flags(bw) & BW_EDITOR_CAN_PASTE);
+}
+
+/* exported interface documented in vita/chrome.h */
+void vita_chrome_enter_text(struct gui_window *gw, const char *utf8)
+{
+	struct browser_window *bw = vita_window_browser(gw);
+	size_t i = 0, n = strlen(utf8);
+	unsigned int chars = 0;
+
+	if (bw == NULL)
+		return;
+	if (!vita_chrome_editing(gw)) {
+		vita_chrome_open(gw, utf8, "typed");
+		return;
+	}
+	while (i < n) {
+		uint32_t cp = utf8_to_ucs4(utf8 + i, n - i);
+		i = utf8_next(utf8, n, i);
+		/* The keyboard's line breaks become the page's. */
+		browser_window_key_press(bw, cp == '\n' ? NS_KEY_NL : cp);
+		chars++;
+	}
+	vita_diag_log("chrome: typed %u characters into the page", chars);
+	vita_window_force_redraw(gw);
+}
+
+#ifdef __vita__
+/** UTF-8 -> UTF-16 (no surrogates past the BMP: the dialog's limit). */
+static void to_utf16(const char *s, SceWChar16 *out, size_t max)
+{
+	size_t i = 0, n = strlen(s), o = 0;
+
+	while (i < n && o + 1 < max) {
+		uint32_t cp = utf8_to_ucs4(s + i, n - i);
+		i = utf8_next(s, n, i);
+		out[o++] = (SceWChar16)(cp > 0xffff ? '?' : cp);
+	}
+	out[o] = 0;
+}
+
+/** UTF-16 -> UTF-8. */
+static void from_utf16(const SceWChar16 *s, char *out, size_t max)
+{
+	size_t o = 0;
+	char buf[6];
+
+	for (; *s != 0; s++) {
+		size_t k = utf8_from_ucs4(*s, buf);
+		if (o + k + 1 > max)
+			break;
+		memcpy(out + o, buf, k);
+		o += k;
+	}
+	out[o] = '\0';
+}
+
+/** The system keyboard; false if cancelled or not shown. */
+static bool ime_dialog(bool url_mode, const char *initial, char *out,
+		       size_t max)
+{
+	static SceWChar16 title[64], init[SCE_IME_DIALOG_MAX_TEXT_LENGTH + 1],
+		buf[SCE_IME_DIALOG_MAX_TEXT_LENGTH + 1];
+	SceImeDialogParam param;
+	SceImeDialogResult result;
+	int r;
+
+	to_utf16(url_mode ? "Open URL or search" : "Text", title, 64);
+	to_utf16(initial, init, SCE_IME_DIALOG_MAX_TEXT_LENGTH);
+	memset(buf, 0, sizeof(buf));
+	sceImeDialogParamInit(&param);
+	param.supportedLanguages = 0x0001FFFF;
+	param.languagesForced = SCE_TRUE;
+	param.type = url_mode ? SCE_IME_TYPE_URL : SCE_IME_TYPE_DEFAULT;
+	param.option = url_mode ? SCE_IME_OPTION_NO_AUTO_CAPITALIZATION : 0;
+	param.dialogMode = SCE_IME_DIALOG_DIALOG_MODE_WITH_CANCEL;
+	param.textBoxMode = SCE_IME_DIALOG_TEXTBOX_MODE_WITH_CLEAR;
+	param.title = title;
+	param.maxTextLength = SCE_IME_DIALOG_MAX_TEXT_LENGTH;
+	param.initialText = init;
+	param.inputTextBuffer = buf;
+	r = sceImeDialogInit(&param);
+	if (r < 0) {
+		vita_diag_log("chrome: sceImeDialogInit -> 0x%08x",
+			      (unsigned int)r);
+		return false;
+	}
+	while (sceImeDialogGetStatus() == SCE_COMMON_DIALOG_STATUS_RUNNING) {
+		vita2d_start_drawing();
+		vita2d_clear_screen();
+		vita2d_end_drawing();
+		vita2d_common_dialog_update();
+		vita2d_swap_buffers();
+		sceKernelDelayThread(16 * 1000);
+	}
+	memset(&result, 0, sizeof(result));
+	r = sceImeDialogGetResult(&result);
+	sceImeDialogTerm();
+	if (r < 0 || result.button != SCE_IME_DIALOG_BUTTON_ENTER)
+		return false;
+	from_utf16(buf, out, max);
+	return true;
+}
+#endif
+
+/* exported interface documented in vita/chrome.h */
+void vita_chrome_text_entry(struct gui_window *gw)
+{
+	struct browser_window *bw = vita_window_browser(gw);
+	bool editing = vita_chrome_editing(gw);
+	const char *initial = "";
+	char text[TEXT_MAX];
+
+	if (bw == NULL)
+		return;
+	if (!editing) {
+		nsurl *u = browser_window_access_url(bw);
+		initial = u != NULL ? nsurl_access(u) : "";
+		/* The generated home page is no URL to edit. */
+		if (strcmp(initial, VITA_HOME_URL) == 0)
+			initial = "";
+	}
+#ifdef __vita__
+	if (!ime_dialog(!editing, initial, text, sizeof(text))) {
+		vita_diag_log("chrome: text entry cancelled");
+		vita_window_force_redraw(gw);
+		return;
+	}
+#else
+	/* The simulator has no keyboard: VITA_SIM_TYPE stands in for it. */
+	{
+		const char *t = getenv("VITA_SIM_TYPE");
+		(void)initial;
+		if (t == NULL)
+			return;
+		snprintf(text, sizeof(text), "%s", t);
+	}
+#endif
+	vita_chrome_enter_text(gw, text);
+	vita_window_force_redraw(gw);
+}
