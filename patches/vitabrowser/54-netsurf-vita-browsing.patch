+/** The bookmarks: one "Title | URL" per line, '#' comments. Created with
+ * defaults if missing; the user edits it (VitaShell, FTP). */
+#define VITA_BOOKMARKS_FILE "ux0:data/VitaBrowser/bookmarks.txt"
+
+/** The home page, generated from the bookmarks at start-up. */
+#define VITA_HOME_FILE "ux0:data/VitaBrowser/home.html"
+#define VITA_HOME_URL "file:///ux0:data/VitaBrowser/home.html"
+
+/**
+ * Write the home page from the bookmarks and the bundled test pages.
+ *
+ * \param test_pages  names of the bundled test pages (app0:/testpages/)
+ * \param n           how many
+ */
+nserror vita_chrome_write_home(const char *const *test_pages, unsigned int n);
+
+/**
+ * Turn what the user typed into a URL: a URL as it is, a bare host or
+ * path gets https://, anything else (spaces, no dot) becomes a search.
+ *
+ * \return the URL (malloc()ed) or NULL
+ */
+char *vita_chrome_typed_url(const char *typed);
+
+/** Open url (as typed or pushed) in the window. */
+nserror vita_chrome_open(struct gui_window *gw, const char *url,
+			 const char *why);
+
+/** Is the caret in a text field (typed text goes into the page)? */
+bool vita_chrome_editing(struct gui_window *gw);
+
+/**
+ * Deliver entered text: into the focused field when editing, else as a
+ * URL to open. Separate from the keyboard, so the autotest can drive it.
+ */
+void vita_chrome_enter_text(struct gui_window *gw, const char *utf8);
+
+/**
+ * TRIANGLE: show the system keyboard (on the Vita), prefilled with the
+ * current URL unless a text field has the caret, and deliver the result.
+ * The page is not repainted meanwhile (as for alert(), vita/js_platform.c).
+ */
+void vita_chrome_text_entry(struct gui_window *gw);
+
+#endif
diff --git a/frontends/vita/input.c b/frontends/vita/input.c
new file mode 100644
index 0000000..89582b8
--- /dev/null
+++ b/frontends/vita/input.c
@@ -0,0 +1,306 @@
+/*
+ * Copyright 2026 VitaBrowser contributors
+ *
+ * This file is part of NetSurf, http://www.netsurf-browser.org/
+ *
+ * NetSurf is free software; you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation; version 2 of the License.
+ *
+ * NetSurf is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+ * GNU General Public License for more details.
+ *
+ * You should have received a copy of the GNU General Public License
+ * along with this program.  If not, see <http://www.gnu.org/licenses/>.
+ */
+
+/**
+ * \file
+ * Vita frontend: browsing controls (see vita/input.h for the mapping).
+ *
+ * Clicks go to the core in window coordinates -- screen position plus the
+ * scroll offset; the core divides by the zoom itself -- as a press on the
+ * way down and a click on the way up, like the framebuffer frontend's
+ * mouse. The front panel reports 1920 x 1088 for the 960 x 544 screen.
+ */
+
+#include <stdbool.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include <psp2/ctrl.h>
+#include <psp2/touch.h>
+
+#include "utils/errors.h"
+#include "netsurf/browser_window.h"
+#include "netsurf/mouse.h"
+#include "desktop/browser_history.h"
+
+#include "vita/diag.h"
+#include "vita/plot.h"
+#include "vita/window.h"
+#include "vita/input.h"
+
+/** Stick dead zone around the 128 centre. */
+#define STICK_DEADZONE 24
+/** D-pad scroll, pixels per pass. */
+#define DPAD_STEP 24
+/** Pointer speed at full stick deflection, pixels per pass. */
+#define POINTER_MAX_SPEED 14.0f
+/** A touch that moves further than this is a drag, not a tap. */
+#define TAP_SLOP 12
+/** ...and one held longer than this, ms, is not a tap either. */
+#define TAP_MAX_MS 700
+/** The pointer is drawn for this long after it last moved, ms. */
+#define POINTER_SHOW_MS 4000
+
+const float vita_zoom_steps[VITA_ZOOM_STEPS] = { 1.0f, 1.25f, 1.5f, 2.0f };
+
+struct vita_input_stats vita_input_stats;
+
+static struct {
+	float x, y;			/**< the pointer */
+	unsigned int moved_ms;		/**< when it last moved */
+	bool cross_down;		/**< CROSS pressed on the page */
+	int cross_x, cross_y;		/**< ...here (window coordinates) */
+	bool touching;			/**< a finger is down */
+	bool dragging;			/**< ...and has moved past TAP_SLOP */
+	int touch_x0, touch_y0;		/**< where it went down */
+	int touch_x, touch_y;		/**< where it was last pass */
+	unsigned int touch_ms;		/**< when it went down */
+	unsigned int zoom;		/**< index into vita_zoom_steps */
+} st = { .x = VITA_SCREEN_WIDTH / 2.0f, .y = VITA_SCREEN_HEIGHT / 2.0f };
+
+/* exported interface documented in vita/input.h */
+void vita_input_idle(struct vita_input *in)
+{
+	memset(in, 0, sizeof(*in));
+	in->lx = in->ly = in->rx = in->ry = 128;
+}
+
+/* exported interface documented in vita/input.h */
+void vita_input_read(struct vita_input *in)
+{
+	static bool touch_on;
+	SceCtrlData pad;
+	SceTouchData touch;
+
+	vita_input_idle(in);
+	memset(&pad, 0, sizeof(pad));
+	sceCtrlPeekBufferPositive(0, &pad, 1);
+	in->buttons = pad.buttons;
+	in->lx = pad.lx;
+	in->ly = pad.ly;
+	in->rx = pad.rx;
+	in->ry = pad.ry;
+	if (!touch_on) {
+		sceTouchSetSamplingState(SCE_TOUCH_PORT_FRONT,
+					 SCE_TOUCH_SAMPLING_STATE_START);
+		touch_on = true;
+	}
+	memset(&touch, 0, sizeof(touch));
+	if (sceTouchPeek(SCE_TOUCH_PORT_FRONT, &touch, 1) >= 0 &&
+	    touch.reportNum > 0) {
+		in->touch = true;
+		in->tx = touch.report[0].x / 2;
+		in->ty = touch.report[0].y / 2;
+	}
+}
+
+/** Stick deflection beyond the dead zone, -1 .. 1. */
+static float stick(unsigned char v)
+{
+	int d = (int)v - 128;
+
+	if (abs(d) <= STICK_DEADZONE)
+		return 0.0f;
+	d += (d > 0) ? -STICK_DEADZONE : STICK_DEADZONE;
+	return (float)d / (float)(128 - STICK_DEADZONE);
+}
+
+static void window_xy(struct gui_window *gw, int sx, int sy, int *x, int *y)
+{
+	int scx, scy;
+
+	vita_window_scroll_pos(gw, &scx, &scy);
+	*x = sx + scx;
+	*y = sy + scy;
+}
+
+/** A click at a screen position: press and release in one go. */
+static void click_at(struct gui_window *gw, int sx, int sy)
+{
+	struct browser_window *bw = vita_window_browser(gw);
+	int x, y;
+
+	window_xy(gw, sx, sy, &x, &y);
+	vita_diag_log("input: click at %d,%d (page %d,%d)", sx, sy, x, y);
+	browser_window_mouse_click(bw, BROWSER_MOUSE_PRESS_1, x, y);
+	browser_window_mouse_click(bw, BROWSER_MOUSE_CLICK_1, x, y);
+	browser_window_mouse_track(bw, 0, x, y);
+	vita_input_stats.clicks++;
+}
+
+/** The front panel: tap = click, drag = scroll with the finger. */
+static void touch_step(struct gui_window *gw, const struct vita_input *in)
+{
+	unsigned int now = vita_diag_ms();
+
+	if (in->touch && !st.touching) {
+		st.touching = true;
+		st.dragging = false;
+		st.touch_x0 = st.touch_x = in->tx;
+		st.touch_y0 = st.touch_y = in->ty;
+		st.touch_ms = now;
+		return;
+	}
+	if (in->touch) {
+		if (!st.dragging &&
+		    (abs(in->tx - st.touch_x0) > TAP_SLOP ||
+		     abs(in->ty - st.touch_y0) > TAP_SLOP)) {
+			st.dragging = true;
+			vita_input_stats.drags++;
+		}
+		if (st.dragging)
+			vita_window_scroll_by(gw, st.touch_x - in->tx,
+					      st.touch_y - in->ty);
+		st.touch_x = in->tx;
+		st.touch_y = in->ty;
+		return;
+	}
+	if (st.touching) {
+		st.touching = false;
+		if (!st.dragging && now - st.touch_ms <= TAP_MAX_MS) {
+			vita_input_stats.taps++;
+			click_at(gw, st.touch_x0, st.touch_y0);
+		}
+	}
+}
+
+/** The pointer: the left stick moves it, CROSS clicks under it. */
+static void pointer_step(struct gui_window *gw, const struct vita_input *in,
+			 const struct vita_input *prev)
+{
+	struct browser_window *bw = vita_window_browser(gw);
+	float dx = stick(in->lx), dy = stick(in->ly);
+	int x, y;
+
+	if (dx != 0.0f || dy != 0.0f) {
+		/* Quadratic: fine control near the centre. */
+		st.x += dx * (dx < 0 ? -dx : dx) * POINTER_MAX_SPEED;
+		st.y += dy * (dy < 0 ? -dy : dy) * POINTER_MAX_SPEED;
+		if (st.x < 0) st.x = 0;
+		if (st.y < 0) st.y = 0;
+		if (st.x > VITA_SCREEN_WIDTH - 1) st.x = VITA_SCREEN_WIDTH - 1;
+		if (st.y > VITA_SCREEN_HEIGHT - 1) st.y = VITA_SCREEN_HEIGHT - 1;
+		st.moved_ms = vita_diag_ms();
+		window_xy(gw, (int)st.x, (int)st.y, &x, &y);
+		/* Hover: link highlighting and the status text. */
+		browser_window_mouse_track(bw, st.cross_down ?
+					   BROWSER_MOUSE_HOLDING_1 : 0, x, y);
+		vita_window_force_redraw(gw);
+	}
+	if ((in->buttons & SCE_CTRL_CROSS) &&
+	    !(prev->buttons & SCE_CTRL_CROSS)) {
+		st.moved_ms = vita_diag_ms();
+		window_xy(gw, (int)st.x, (int)st.y, &st.cross_x, &st.cross_y);
+		browser_window_mouse_click(bw, BROWSER_MOUSE_PRESS_1,
+					   st.cross_x, st.cross_y);
+		st.cross_down = true;
+	} else if (!(in->buttons & SCE_CTRL_CROSS) && st.cross_down) {
+		window_xy(gw, (int)st.x, (int)st.y, &x, &y);
+		vita_diag_log("input: pointer click at %d,%d (page %d,%d)",
+			      (int)st.x, (int)st.y, x, y);
+		browser_window_mouse_click(bw, BROWSER_MOUSE_CLICK_1, x, y);
+		browser_window_mouse_track(bw, 0, x, y);
+		st.cross_down = false;
+		vita_input_stats.clicks++;
+	}
+}
+
+/* exported interface documented in vita/input.h */
+void vita_input_set_zoom(struct gui_window *gw, unsigned int step)
+{
+	struct browser_window *bw = vita_window_browser(gw);
+
+	st.zoom = step % VITA_ZOOM_STEPS;
+	if (bw != NULL) {
+		vita_diag_log("input: zoom %d%%",
+			      (int)(vita_zoom_steps[st.zoom] * 100.0f + 0.5f));
+		browser_window_set_scale(bw, vita_zoom_steps[st.zoom], true);
+		vita_window_force_redraw(gw);
+	}
+}
+
+/* exported interface documented in vita/input.h */
+unsigned int vita_input_zoom_step(void)
+{
+	return st.zoom;
+}
+
+/* exported interface documented in vita/input.h */
+enum vita_browse_action vita_input_browse(struct gui_window *gw,
+					  const struct vita_input *in,
+					  const struct vita_input *prev)
+{
+	struct browser_window *bw = vita_window_browser(gw);
+	unsigned int pressed = in->buttons & ~prev->buttons;
+	int dx = 0, dy = 0;
+
+	if (gw == NULL || bw == NULL)
+		return VITA_BROWSE_NONE;
+
+	touch_step(gw, in);
+	pointer_step(gw, in, prev);
+
+	if (in->buttons & SCE_CTRL_UP)
+		dy -= DPAD_STEP;
+	if (in->buttons & SCE_CTRL_DOWN)
+		dy += DPAD_STEP;
+	if (in->buttons & SCE_CTRL_LEFT)
+		dx -= DPAD_STEP;
+	if (in->buttons & SCE_CTRL_RIGHT)
+		dx += DPAD_STEP;
+	dx += (int)(stick(in->rx) * 32.0f);
+	dy += (int)(stick(in->ry) * 32.0f);
+	if (dx != 0 || dy != 0)
+		vita_window_scroll_by(gw, dx, dy);
+
+	if ((pressed & SCE_CTRL_LTRIGGER) &&
+	    browser_window_history_back_available(bw)) {
+		vita_diag_log("input: back");
+		vita_input_stats.backs++;
+		browser_window_history_back(bw, false);
+	}
+	if ((pressed & SCE_CTRL_RTRIGGER) &&
+	    browser_window_history_forward_available(bw)) {
+		vita_diag_log("input: forward");
+		vita_input_stats.forwards++;
+		browser_window_history_forward(bw, false);
+	}
+	if (pressed & SCE_CTRL_SQUARE)
+		vita_input_set_zoom(gw, st.zoom + 1);
+	if (pressed & SCE_CTRL_TRIANGLE)
+		return VITA_BROWSE_ENTER_TEXT;
+	if (pressed & SCE_CTRL_START)
+		return VITA_BROWSE_HOME;
+	return VITA_BROWSE_NONE;
+}
+
+/* exported interface documented in vita/input.h */
+void vita_input_pointer_home(void)
+{
+	st.x = VITA_SCREEN_WIDTH / 2.0f;
+	st.y = VITA_SCREEN_HEIGHT / 2.0f;
+}
+
+/* exported interface documented in vita/input.h */
+bool vita_input_pointer(int *x, int *y)
+{
+	*x = (int)st.x;
+	*y = (int)st.y;
+	return st.moved_ms != 0 &&
+		vita_diag_ms() - st.moved_ms < POINTER_SHOW_MS;
+}
