# netsurf: the Vita's user agent, for HTTP and navigator
# Generated 2026-09-24
#
# Real sites on the live network (docs/phase-0/11): NetSurf sent
# "Mozilla/5.0 (X11; Linux) NetSurf/3.12" -- a Linux desktop -- so sites
# sent desktop layouts to a 960x544 screen. Wikipedia now serves every
# client from one domain (en.m. redirects there, even for phones) and
# picks the skin by user agent: desktop Vector for NetSurf's string,
# mobile Minerva for a device one.
# - Makefile.defaults: NETSURF_UA_FORMAT_STRING (the core's hook) =
#   "Mozilla/5.0 (PlayStation Vita 3.65) AppleWebKit/537.73 (KHTML, like
#   Gecko) Mobile NetSurf/3.12 VitaBrowser/0.1"; "%.0s" swallows the uname
#   sysname the core formats in (the simulator's says Linux).
# - quickjs bridge (MACSURF_WINDOW_SERVICES): navigator.userAgent and
#   appVersion from user_agent_string(), platform "PlayStation Vita" --
#   MacSurf hard-codes "MacSurf/2.3 (Macintosh; PPC Mac OS 9)", so scripts
#   and servers saw two different browsers.

diff --git a/content/handlers/javascript/quickjs/macos9.h b/content/handlers/javascript/quickjs/macos9.h
index b096901..f4d9470 100644
--- a/content/handlers/javascript/quickjs/macos9.h
+++ b/content/handlers/javascript/quickjs/macos9.h
@@ -92,6 +92,11 @@ void macsurf_profile_accum_js(long us);
  */
 #define MACSURF_WINDOW_SERVICES 1
 
+/** navigator.platform. */
+#ifndef MACSURF_JS_PLATFORM
+#define MACSURF_JS_PLATFORM "PlayStation Vita"
+#endif
+
 /** c's URL as location.href shows it: with the fragment, which NetSurf
  * keeps on the window, not the document. malloc()ed; NULL: none. */
 char *macsurf_window_location(struct content *c);
diff --git a/content/handlers/javascript/quickjs/macsurf_qjs.c b/content/handlers/javascript/quickjs/macsurf_qjs.c
index 99d54c8..c7eb221 100644
--- a/content/handlers/javascript/quickjs/macsurf_qjs.c
+++ b/content/handlers/javascript/quickjs/macsurf_qjs.c
@@ -12743,12 +12743,29 @@ static void register_browser_globals(JSContext *ctx)
 
 	/* --- navigator --- */
 	nav_obj = JS_NewObject(ctx);
+#ifdef MACSURF_WINDOW_SERVICES
+	/* VitaBrowser: the same user agent the fetchers send (utils/
+	 * useragent.c), so scripts and servers see one browser. MacSurf
+	 * hard-codes its own Mac OS 9 identity here. */
+	{
+		extern const char *user_agent_string(void);
+		const char *ua = user_agent_string();
+		const char *av = strncmp(ua, "Mozilla/", 8) == 0 ? ua + 8 : ua;
+		JS_SetPropertyStr(ctx, nav_obj, "userAgent",
+			JS_NewString(ctx, ua));
+		JS_SetPropertyStr(ctx, nav_obj, "appVersion",
+			JS_NewString(ctx, av));
+		JS_SetPropertyStr(ctx, nav_obj, "platform",
+			JS_NewString(ctx, MACSURF_JS_PLATFORM));
+	}
+#else
 	JS_SetPropertyStr(ctx, nav_obj, "userAgent",
 		JS_NewString(ctx, "MacSurf/2.3 (Macintosh; PPC Mac OS 9)"));
 	JS_SetPropertyStr(ctx, nav_obj, "appVersion",
 		JS_NewString(ctx, "5.0 (Macintosh; PPC Mac OS 9)"));
 	JS_SetPropertyStr(ctx, nav_obj, "platform",
 		JS_NewString(ctx, "MacPPC"));
+#endif
 	JS_SetPropertyStr(ctx, nav_obj, "appName",
 		JS_NewString(ctx, "Netscape"));
 	JS_SetPropertyStr(ctx, nav_obj, "language",
diff --git a/frontends/vita/Makefile.defaults b/frontends/vita/Makefile.defaults
index dd1dd8b..bf2923f 100644
--- a/frontends/vita/Makefile.defaults
+++ b/frontends/vita/Makefile.defaults
@@ -44,4 +44,10 @@ NETSURF_STRIP_BINARY := NO
 # The page opened at start-up, relative to the app bundle.
 NETSURF_VITA_START_PAGE := file:///ux0:data/VitaBrowser/home.html
 
+# The user agent (utils/useragent.c; navigator.userAgent reports it too):
+# the device, so sites send their mobile layout for a 960x544 screen --
+# Wikipedia's Minerva skin, not desktop Vector. "%.0s" swallows the uname
+# sysname the core formats in (the simulator's would say Linux).
+NETSURF_UA_FORMAT_STRING := "Mozilla/5.0 (PlayStation Vita 3.65%.0s) AppleWebKit/537.73 (KHTML, like Gecko) Mobile NetSurf/%d.%d VitaBrowser/0.1"
+
 CFLAGS += -O2
