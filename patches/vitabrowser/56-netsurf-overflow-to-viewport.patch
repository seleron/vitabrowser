+/**
+ * Viewport propagation of overflow (CSS 2.1 11.1.1): the root element's
+ * overflow applies to the viewport, and so does the body's when the root's
+ * is visible; those elements' own used overflow is then visible
+ * (box_overflow_x/y). The browser window is the viewport and always
+ * scrolls, so nothing more is needed here.
+ */
+static void layout_propagate_overflow(struct box *root)
+{
+	struct box *c;
+
+	if (root == NULL || root->style == NULL)
+		return;
+	root->flags |= OVERFLOW_TO_VIEWPORT;
+	if (css_computed_overflow_x(root->style) != CSS_OVERFLOW_VISIBLE ||
+	    css_computed_overflow_y(root->style) != CSS_OVERFLOW_VISIBLE)
+		return;
+	for (c = root->children; c != NULL; c = c->next) {
+		dom_string *name = NULL;
+		bool body;
+
+		if (c->node == NULL || c->style == NULL)
+			continue;
+		if (dom_node_get_node_name(c->node, &name) != DOM_NO_ERR ||
+		    name == NULL)
+			continue;
+		body = dom_string_caseless_lwc_isequal(name,
+						       corestring_lwc_body);
+		dom_string_unref(name);
+		if (body) {
+			c->flags |= OVERFLOW_TO_VIEWPORT;
+			break;
+		}
+	}
+}
