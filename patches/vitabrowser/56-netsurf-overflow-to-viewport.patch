@@ -152,4 +152,26 @@ static inline unsigned box_count_children(const struct box *b)
 	return count;
 }
 
+/**
+ * A box's used overflow: its computed overflow, except that the root
+ * element's, and the body's when the root's is visible, go to the viewport
+ * (CSS 2.1 11.1.1, CSS Overflow 3 3.3) and the box itself is visible. Set
+ * up per layout by layout_document (OVERFLOW_TO_VIEWPORT). Without it,
+ * html, body { height: 100% } with body { overflow-y: scroll } -- mobile
+ * Wikipedia -- made the body a viewport-high scroll box holding the page.
+ */
+static inline enum css_overflow_e box_overflow_x(const struct box *box)
+{
+	if (box->style == NULL || (box->flags & OVERFLOW_TO_VIEWPORT))
+		return CSS_OVERFLOW_VISIBLE;
+	return css_computed_overflow_x(box->style);
+}
+
+static inline enum css_overflow_e box_overflow_y(const struct box *box)
+{
+	if (box->style == NULL || (box->flags & OVERFLOW_TO_VIEWPORT))
+		return CSS_OVERFLOW_VISIBLE;
+	return css_computed_overflow_y(box->style);
+}
+
