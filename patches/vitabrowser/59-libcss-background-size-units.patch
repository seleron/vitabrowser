# libcss: background-size lengths were read as auto
# Generated 2026-09-24
#
# MacSurf's background-size parser (fixes191b) compared the unit from
# css__parse_unit_keyword() with the public CSS_UNIT_PX (0). That function
# returns the BYTECODE unit, UNIT_PX = 0x100 in this libcss -- MacSurf wrote
# the parser against an older libcss where the two coincided -- so every
# length fell through to "auto" and background-size never applied: a
# background image drew at its natural size whatever the CSS said (the
# nsmonkey build too). Found through the mask-image icons (patch 60), whose
# size is a background-size now. Compare with UNIT_PX.
# See docs/phase-0/11-real-sites.md.

diff --git a/src/parse/properties/p_background_size.c b/src/parse/properties/p_background_size.c
index 50506fd..a2f277f 100644
--- a/src/parse/properties/p_background_size.c
+++ b/src/parse/properties/p_background_size.c
@@ -101,7 +101,7 @@ css_error css__parse_background_size(css_language *c,
 	} else if (token->type == CSS_TOKEN_DIMENSION ||
 			token->type == CSS_TOKEN_NUMBER) {
 		css_fixed length = 0;
-		uint32_t unit = CSS_UNIT_PX;
+		uint32_t unit = UNIT_PX;
 		size_t consumed = 0;
 		if (token->idata == NULL) { *ctx = orig_ctx; return CSS_INVALID; }
 		length = css__number_from_lwc_string(token->idata, false,
@@ -114,11 +114,16 @@ css_error css__parse_background_size(css_language *c,
 		} else {
 			/* Bare number: treat as px when 0, else invalid. */
 			if (length != 0) { *ctx = orig_ctx; return CSS_INVALID; }
-			unit = CSS_UNIT_PX;
+			unit = UNIT_PX;
 		}
 		/* Only PX accepted in V1; other units fall back to auto so
-		 * the rest of the cascade still applies. */
-		if (unit == CSS_UNIT_PX) {
+		 * the rest of the cascade still applies.
+		 * VitaBrowser: css__parse_unit_keyword gives the BYTECODE unit
+		 * (UNIT_PX = 0x100 in this libcss), not the public CSS_UNIT_PX
+		 * (0) this compared with -- written against an older libcss
+		 * where the two coincided -- so every length read as auto and
+		 * background-size never applied (docs/phase-0/11). */
+		if (unit == UNIT_PX) {
 			int32_t px = FIXTOINT(length);
 			if (px < 1) px = 1;
 			if (px > 32767) px = 32767;
@@ -144,7 +149,7 @@ css_error css__parse_background_size(css_language *c,
 		} else if (token->type == CSS_TOKEN_DIMENSION ||
 				token->type == CSS_TOKEN_NUMBER) {
 			css_fixed length = 0;
-			uint32_t unit = CSS_UNIT_PX;
+			uint32_t unit = UNIT_PX;
 			size_t consumed = 0;
 			length = css__number_from_lwc_string(token->idata,
 					false, &consumed);
@@ -155,7 +160,7 @@ css_error css__parse_background_size(css_language *c,
 				size_t ulen = lwc_string_length(token->idata) -
 					consumed;
 				error = css__parse_unit_keyword(u, ulen, &unit);
-				if (error == CSS_OK && unit == CSS_UNIT_PX) {
+				if (error == CSS_OK && unit == UNIT_PX) {
 					int32_t px = FIXTOINT(length);
 					if (px < 1) px = 1;
 					if (px > 32767) px = 32767;
