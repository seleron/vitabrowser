+int css__property_id(css_language *c, lwc_string *name, bool *mask_image);
+
+/** Append background-color: transparent to style, unless the value at ctx
+ * is "none". */
+css_error css__mask_image_hides_colour(const parserutils_vector *vector,
+		int32_t ctx, css_style *style);
+
 css_error css__parse_align_content(css_language *c,
 		const parserutils_vector *vector, int32_t *ctx,
 		css_style *result);
