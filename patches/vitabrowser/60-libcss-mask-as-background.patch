diff --git a/src/parse/properties/properties.c b/src/parse/properties/properties.c
index 21c9ab3..658e795 100644
--- a/src/parse/properties/properties.c
+++ b/src/parse/properties/properties.c
@@ -5,6 +5,10 @@
  * Copyright 2008 John-Mark Bell <jmb@netsurf-browser.org>
  */
 
+#include <string.h>
+#include <strings.h>
+
+#include "bytecode/opcodes.h"
 #include "parse/properties/properties.h"
 
 /**
@@ -374,3 +378,73 @@ const uint32_t property_unit_mask[CSS_N_PROPERTIES] = {
 	[CSS_PROP_TRANSITION_TIMING_FUNCTION] = 0,
 	[CSS_PROP_TRANSITION_DELAY]      = 0,
 };
+
+/*
+ * VitaBrowser: the CSS mask properties, read as their background
+ * counterparts (docs/phase-0/11). libcss has no masking; sites use
+ * mask-image for monochrome icons -- a span with a background-color, shaped
+ * by an SVG mask -- so without it every such icon drew as a solid block of
+ * its background colour (Wikipedia's Minerva and Vector skins). Drawn as a
+ * background image instead, the icon shows its own shape, in the SVG's own
+ * colour rather than the element's. mask-image also makes the background
+ * colour transparent (css__mask_image_hides_colour), and the mask shorthand
+ * resets it through the background one.
+ */
+static const struct {
+	const char *name;
+	int prop;
+	bool image;
+} mask_aliases[] = {
+	{ "mask-image", BACKGROUND_IMAGE, true },
+	{ "-webkit-mask-image", BACKGROUND_IMAGE, true },
+	{ "mask-size", BACKGROUND_SIZE, false },
+	{ "-webkit-mask-size", BACKGROUND_SIZE, false },
+	{ "mask-position", BACKGROUND_POSITION, false },
+	{ "-webkit-mask-position", BACKGROUND_POSITION, false },
+	{ "mask-repeat", BACKGROUND_REPEAT, false },
+	{ "-webkit-mask-repeat", BACKGROUND_REPEAT, false },
+	{ "mask", BACKGROUND, false },
+	{ "-webkit-mask", BACKGROUND, false },
+};
+
+int css__property_id(css_language *c, lwc_string *name, bool *mask_image)
+{
+	const char *d = lwc_string_data(name);
+	size_t n = lwc_string_length(name), k;
+	bool match;
+	int i;
+
+	*mask_image = false;
+	for (i = FIRST_PROP; i <= LAST_PROP; i++) {
+		match = false;
+		if (lwc_string_caseless_isequal(name, c->strings[i],
+				&match) == lwc_error_ok && match)
+			return i;
+	}
+	for (k = 0; k < sizeof(mask_aliases) / sizeof(mask_aliases[0]); k++) {
+		const char *a = mask_aliases[k].name;
+		if (strlen(a) == n && strncasecmp(d, a, n) == 0) {
+			*mask_image = mask_aliases[k].image;
+			return mask_aliases[k].prop;
+		}
+	}
+	return -1;
+}
+
+css_error css__mask_image_hides_colour(const parserutils_vector *vector,
+		int32_t ctx, css_style *style)
+{
+	const css_token *t;
+
+	do {
+		t = parserutils_vector_iterate(vector, &ctx);
+	} while (t != NULL && t->type == CSS_TOKEN_S);
+	/* mask-image: none is no mask: the colour stays. */
+	if (t != NULL && t->type == CSS_TOKEN_IDENT && t->idata != NULL &&
+			lwc_string_length(t->idata) == 4 &&
+			strncasecmp(lwc_string_data(t->idata), "none", 4) == 0)
+		return CSS_OK;
+	return css__stylesheet_style_appendOPV(style,
+			CSS_PROP_BACKGROUND_COLOR, 0,
+			BACKGROUND_COLOR_TRANSPARENT);
+}
