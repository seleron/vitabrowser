# netsurf: the Vita's engine log is capped per boot, and rotated
# Generated 2026-09-24
#
# netsurf.log is appended to across boots, and the 16 MiB cap compared
# ftell() -- the whole file's size. Once earlier sessions had filled it, every
# later boot capped at once and logged nothing ("engine log: capped" 1.2 s
# after boot in hardware run 14's sessions). The cap now counts this boot's
# growth, and a file already past the cap at boot is moved to
# netsurf.old.log (one generation kept).

diff --git a/frontends/vita/diag.c b/frontends/vita/diag.c
index c57f577..df88e08 100644
--- a/frontends/vita/diag.c
+++ b/frontends/vita/diag.c
@@ -559,7 +559,18 @@ void vita_diag_engine_log_init(void)
 	static char a2[] = VITA_DIAG_DIR "netsurf.log";
 	char *argv[] = { a0, a1, a2, NULL };
 	int argc = 3;
-	nserror ret = nslog_init(engine_log_ensure, &argc, argv);
+	nserror ret;
+
+	{
+		/* Start afresh once the file has grown past a cap: the old
+		 * one is kept, once, as netsurf.old.log. */
+		struct stat st;
+		if (stat(a2, &st) == 0 && st.st_size > ENGINE_LOG_CAP) {
+			remove(VITA_DIAG_DIR "netsurf.old.log");
+			rename(a2, VITA_DIAG_DIR "netsurf.old.log");
+		}
+	}
+	ret = nslog_init(engine_log_ensure, &argc, argv);
 
 	{
 		/* The file is appended to across boots; mirror only ours. */
@@ -681,7 +692,10 @@ void vita_diag_engine_flush(void)
 	engine_tail(ENGINE_TAIL_STEP);
 	if (diag_fp != NULL)
 		fflush(diag_fp);
-	if (verbose_log && ftell(engine_log) > ENGINE_LOG_CAP) {
+	/* This boot's growth, not the file's size: the file is appended to
+	 * across boots, so once earlier sessions had filled it every later
+	 * boot capped at once and logged nothing (hardware run 14). */
+	if (verbose_log && ftell(engine_log) - engine_start > ENGINE_LOG_CAP) {
 		fprintf(engine_log, "==== engine log capped at %d bytes ====\n",
 			ENGINE_LOG_CAP);
 		fflush(engine_log);
