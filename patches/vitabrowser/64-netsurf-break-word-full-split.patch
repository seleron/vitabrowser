# netsurf: overflow-wrap / word-break char breaks under the Vita's font split
# Generated 2026-09-24
#
# MacSurf's fixes202 falls back to a character break (word-break: break-all,
# overflow-wrap: break-word | anywhere) when the font split finds no break
# opportunity -- which MacSurf's split reports as 0. The framebuffer
# contract the Vita's split follows reports the whole length instead ("break
# at the last space, else don't break"), so the fallback never fired: an
# unbreakable citation URL in Wikipedia's references (.content {
# word-wrap: break-word }) ran 51 px past the 960-px screen, the page 1011 px
# wide. The fallback now also fires when the split is the whole text and it
# does not fit.

diff --git a/content/handlers/html/layout.c b/content/handlers/html/layout.c
index c951cdf..007f40e 100644
--- a/content/handlers/html/layout.c
+++ b/content/handlers/html/layout.c
@@ -4695,7 +4695,16 @@ layout_line(struct box *first,
 			 * also fires when the available width is small but
 			 * the line is non-empty (left/right floats or
 			 * earlier inline siblings already placed). */
-			if (split == 0 && split_box->length > 1) {
+			/* VitaBrowser: "no break opportunity" is split == 0
+			 * under MacSurf's font split, but the whole length
+			 * under the framebuffer contract the Vita's follows
+			 * (break at the last space, else don't break) -- and
+			 * then this never fired, so an unbreakable URL in
+			 * overflow-wrap: break-word text (Wikipedia's
+			 * references) ran 51 px past the screen. */
+			if ((split == 0 || (split >= split_box->length &&
+					w > x1 - x0 - x - space_before)) &&
+					split_box->length > 1) {
 				enum css_word_break_e wb =
 					css_computed_word_break(split_box->style);
 				enum css_overflow_wrap_e ow =
