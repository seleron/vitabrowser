# netsurf: a set min-width raises the preferred width too
# Generated 2026-09-24
#
# layout_minmax_block raised a box's min width to its min-width but left the
# max (preferred) width below it; only the intrinsic-keyword branch applied
# "max = max(max, min)". A shrink-to-fit box -- inline-block, inline-flex, a
# flex item's content -- with min-width: 44px and 16 px of content therefore
# reported max 16 and was laid out 16 wide: Minerva's icon-only header button
# (.cdx-button--icon-only.cdx-button--size-large { min-width: 44px }) sat past
# its nav and 25 px past the screen.

diff --git a/content/handlers/html/layout.c b/content/handlers/html/layout.c
index 007f40e..6a12d60 100644
--- a/content/handlers/html/layout.c
+++ b/content/handlers/html/layout.c
@@ -1640,6 +1640,18 @@ static void layout_minmax_block_inner(
 				min = val;
 				using_min_border_box = border_box;
 			}
+			/* VitaBrowser: and the preferred width with it, as
+			 * the intrinsic branch below does. Only min was
+			 * raised, so a shrink-to-fit box (inline-block,
+			 * inline-flex, a flex item's content) with
+			 * min-width: 44px and 16px of content still reported
+			 * max 16 and was laid out 16 wide: Minerva's
+			 * icon-only header button overflowed its nav and the
+			 * screen (docs/phase-0/11). */
+			if (max < min) {
+				max = min;
+				using_max_border_box = border_box;
+			}
 		} else if (min_type == CSS_MIN_WIDTH_INTRINSIC) {
 			/* Same css_unit / css_intrinsic_kind_e overload as above. */
 			int val = ((enum css_intrinsic_kind_e) unit ==
