# libcss: a mask's transparent background colour is important
# Generated 2026-09-24
#
# Patch 60 reads mask-image as background-image plus background-color:
# transparent. Minerva's .minerva-icon { background-color: ... } comes AFTER
# its .minerva-icon--* { mask-image } rules at the same specificity, so the
# colour won and the live page's Language / Watch / Edit icons were still
# solid bars (the minimal test page, colour rule first, passed). A masked
# element's colour only ever shows through the mask, which is not drawn, so
# the transparent is now emitted important, on that opcode alone.

diff --git a/src/parse/properties/properties.c b/src/parse/properties/properties.c
index 658e795..06be01a 100644
--- a/src/parse/properties/properties.c
+++ b/src/parse/properties/properties.c
@@ -387,8 +387,8 @@ const uint32_t property_unit_mask[CSS_N_PROPERTIES] = {
  * its background colour (Wikipedia's Minerva and Vector skins). Drawn as a
  * background image instead, the icon shows its own shape, in the SVG's own
  * colour rather than the element's. mask-image also makes the background
- * colour transparent (css__mask_image_hides_colour), and the mask shorthand
- * resets it through the background one.
+ * colour transparent, with importance (css__mask_image_hides_colour), and
+ * the mask shorthand resets it through the background one.
  */
 static const struct {
 	const char *name;
@@ -444,7 +444,13 @@ css_error css__mask_image_hides_colour(const parserutils_vector *vector,
 			lwc_string_length(t->idata) == 4 &&
 			strncasecmp(lwc_string_data(t->idata), "none", 4) == 0)
 		return CSS_OK;
+	/* Important, on this opcode alone (the cascade reads the flag per
+	 * opcode): a masked element's colour only ever shows through the
+	 * mask, which is not drawn, so no later normal background-color may
+	 * bring the block back. Minerva's .minerva-icon { background-color }
+	 * comes AFTER its .minerva-icon--* { mask-image } rules at the same
+	 * specificity, so a normal transparent lost to it. */
 	return css__stylesheet_style_appendOPV(style,
-			CSS_PROP_BACKGROUND_COLOR, 0,
+			CSS_PROP_BACKGROUND_COLOR, FLAG_IMPORTANT,
 			BACKGROUND_COLOR_TRANSPARENT);
 }
