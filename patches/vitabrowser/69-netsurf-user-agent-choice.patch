# netsurf: choose the user agent (Chrome on Android by default)
# Generated 2026-09-24
#
# Hardware run 15: claude.ai's Cloudflare check turned the browser away as
# "too old" -- the PlayStation Vita / NetSurf user agent (patch 55) names no
# browser it supports. ux0:data/VitaBrowser/useragent.txt (created on first
# start) names a preset -- chrome (default), safari, firefox, vita -- or holds
# a whole string; vita_chrome_load_useragent() applies it before netsurf_init
# through the new user_agent_override() (utils/useragent.c). Scripts see the
# same browser: navigator.platform follows the user agent ("Linux armv8l" for
# Android) and navigator.vendor is Chrome's or Safari's.

diff --git a/content/handlers/javascript/quickjs/macsurf_qjs.c b/content/handlers/javascript/quickjs/macsurf_qjs.c
index c7eb221..e729cd8 100644
--- a/content/handlers/javascript/quickjs/macsurf_qjs.c
+++ b/content/handlers/javascript/quickjs/macsurf_qjs.c
@@ -12755,8 +12755,24 @@ static void register_browser_globals(JSContext *ctx)
 			JS_NewString(ctx, ua));
 		JS_SetPropertyStr(ctx, nav_obj, "appVersion",
 			JS_NewString(ctx, av));
+		/* navigator.platform matches whichever browser the user
+		 * agent names (the user may choose one, vita/chrome.c):
+		 * scripts that cross-check the two see one device. */
+		const char *pf = MACSURF_JS_PLATFORM;
+		if (strstr(ua, "Android") != NULL)
+			pf = "Linux armv8l";
+		else if (strstr(ua, "iPhone") != NULL)
+			pf = "iPhone";
+		else if (strstr(ua, "Windows") != NULL)
+			pf = "Win32";
 		JS_SetPropertyStr(ctx, nav_obj, "platform",
-			JS_NewString(ctx, MACSURF_JS_PLATFORM));
+			JS_NewString(ctx, pf));
+		/* Chrome's and Safari's vendor strings (Firefox's is ""). */
+		JS_SetPropertyStr(ctx, nav_obj, "vendor", JS_NewString(ctx,
+			strstr(ua, "Chrome/") != NULL ? "Google Inc." :
+			strstr(ua, "Safari/") != NULL &&
+			strstr(ua, "Version/") != NULL ? "Apple Computer, Inc." :
+			""));
 	}
 #else
 	JS_SetPropertyStr(ctx, nav_obj, "userAgent",
