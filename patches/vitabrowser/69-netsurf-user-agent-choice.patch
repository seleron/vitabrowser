+/* exported interface documented in vita/chrome.h */
+void vita_chrome_load_useragent(void)
+{
+	char line[1024];
+	const char *ua = NULL, *l;
+	size_t n, i;
+	bool found = false;
+	FILE *fp;
+
+	fp = fopen(VITA_USERAGENT_FILE, "r");
+	if (fp == NULL) {
+		fp = fopen(VITA_USERAGENT_FILE, "w");
+		if (fp != NULL) {
+			fputs(default_useragent, fp);
+			fclose(fp);
+			vita_diag_log("chrome: wrote default %s",
+				      VITA_USERAGENT_FILE);
+		}
+		fp = fopen(VITA_USERAGENT_FILE, "r");
+	}
+	while (fp != NULL && !found && fgets(line, sizeof(line), fp) != NULL) {
+		l = line;
+		n = strlen(line);
+		trim(&l, &n);
+		if (n == 0 || l[0] == '#')
+			continue;
+		((char *)l)[n] = '\0';
+		found = true;
+		ua = l;
+		for (i = 0; i < sizeof(ua_presets) / sizeof(ua_presets[0]); i++)
+			if (strcasecmp(l, ua_presets[i].name) == 0) {
+				ua = ua_presets[i].ua;
+				break;
+			}
+	}
+	if (fp != NULL)
+		fclose(fp);
+	if (!found)	/* no file (ux0: unwritable) or only comments */
+		ua = ua_presets[0].ua;
+	user_agent_override(ua);
+	vita_diag_log("chrome: user agent: %s", user_agent_string());
+}
