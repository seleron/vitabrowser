+static const char default_useragent[] =
+	"# VitaBrowser user agent: the browser every site is told this is.\n"
+	"# The first line that is not a comment is used; takes effect at the\n"
+	"# next start. One of:\n"
+	"#   chrome   Chrome on Android (the default: sites that turn old\n"
+	"#            browsers away, e.g. Cloudflare's checks, accept it)\n"
+	"#   safari   Safari on an iPhone\n"
+	"#   firefox  Firefox on Android\n"
+	"#   vita     VitaBrowser's own (PlayStation Vita, NetSurf)\n"
+	"# or a whole user agent string of your own.\n"
