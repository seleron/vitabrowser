+/* Public API documented in useragent.h */
+void
+user_agent_override(const char *ua)
+{
+	char *copy = NULL;
+
+	if (ua != NULL && ua[0] != '\0' && (copy = strdup(ua)) == NULL)
+		return;
+	free_user_agent_string();
+	core_user_agent_string = copy;
+	if (copy != NULL)
+		NSLOG(netsurf, INFO, "User agent overridden: \"%s\"", copy);
+}
