# netsurf: page loads send a browser's Accept header
# Generated 2026-09-24
#
# curl's default "Accept: */*" on a top-level page load is, with the user
# agent, what Cloudflare scores: claude.ai answered 403 "Just a moment..."
# whose challenge script then showed "Browser not supported". Measured with
# curl over HTTP/1.1 (the Vita's libcurl has no HTTP/2): Chrome UA alone ->
# 403, Chrome UA + "Accept: text/html,..." -> 200 and the real page; the Vita
# UA with the same Accept -> 403. Verifiable fetches (typed, bookmarked, a
# link, a form) without a caller Accept now send Chrome's navigation Accept
# and Upgrade-Insecure-Requests; sub-resources and scripts' fetch()/XHR,
# which are unverifiable, are unchanged.

diff --git a/content/fetchers/curl.c b/content/fetchers/curl.c
index 5a4f5e5..15c730a 100644
--- a/content/fetchers/curl.c
+++ b/content/fetchers/curl.c
@@ -563,6 +563,27 @@ fetch_curl_setup(struct fetch *parent_fetch,
 		APPEND(fetch->headers, headers[i]);
 	}
 
+	/* VitaBrowser: a page the user opens (a verifiable fetch: typed,
+	 * bookmarked, a link, a form) asks for HTML the way browsers do.
+	 * Left at curl's default (any type), Cloudflare answers claude.ai
+	 * with its "Just a moment..." challenge, which then reports the
+	 * browser unsupported (docs/phase-0/11); with a browser's user
+	 * agent and this, the page itself. Scripts' fetch()/XHR are not
+	 * verifiable and keep their own Accept, as sub-resources do. */
+	if (fetch_get_verifiable(parent_fetch)) {
+		bool has_accept = false;
+		for (i = 0; headers[i] != NULL; i++) {
+			if (strncasecmp(headers[i], "Accept:", 7) == 0)
+				has_accept = true;
+		}
+		if (!has_accept) {
+			APPEND(fetch->headers, "Accept: text/html,"
+			       "application/xhtml+xml,application/xml;q=0.9,"
+			       "*/*;q=0.8");
+			APPEND(fetch->headers, "Upgrade-Insecure-Requests: 1");
+		}
+	}
+
 	return fetch;
 
 #undef APPEND
