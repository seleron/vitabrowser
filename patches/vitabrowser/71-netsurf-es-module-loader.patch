+/** Keep an inline module for the end of the parse (in document order). */
+static void html_queue_inline_module(html_content *c, const char *name,
+		const char *src, size_t len)
+{
+	struct html_inline_module *m, **tail;
+
+	m = calloc(1, sizeof(*m));
+	if (m == NULL)
+		return;
+	m->name = strdup(name);
+	m->source = malloc(len + 1);
+	if (m->name == NULL || m->source == NULL) {
+		free(m->name);
+		free(m->source);
+		free(m);
+		return;
+	}
+	memcpy(m->source, src, len);
+	m->source[len] = '\0';
+	m->len = len;
+	for (tail = &c->inline_modules; *tail != NULL; tail = &(*tail)->next)
+		;
+	*tail = m;
+}
+
+/** Run the inline modules the parse deferred, after the deferred scripts. */
+static bool html_run_inline_modules(html_content *c)
+{
+	struct html_inline_module *m;
+	bool ran = false;
+
+	while ((m = c->inline_modules) != NULL && c->js_thread != NULL) {
+		c->inline_modules = m->next;
+		js_exec_module(c->js_thread, (const unsigned char *)m->source,
+				m->len, m->name);
+		free(m->name);
+		free(m->source);
+		free(m);
+		ran = true;
+	}
+	return ran;
+}
