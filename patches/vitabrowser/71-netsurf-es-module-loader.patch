+/**
+ * Fetch several URLs with GET, in parallel, and wait for all of them.
+ *
+ * For callers that must have a set of sources synchronously -- an ES module
+ * graph is linked in one go, and QuickJS asks for each import while it
+ * links. Runs its own transfers beside the fetchers' (same user agent, CA
+ * bundle, name lookups and timeouts), so it may be called while other
+ * fetches are in progress; the browser does nothing else meanwhile.
+ *
+ * \param urls     absolute URLs
+ * \param n        how many
+ * \param referer  the Referer to send, or NULL
+ * \param res      n results, filled in; the caller frees each data
+ * \return how many were fetched with a 2xx status
+ */
+unsigned int fetch_get_blocking(const char *const *urls, unsigned int n,
+		const char *referer, struct fetch_blocking_body *res);
