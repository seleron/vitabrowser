+
+/* ---- fetch_get_blocking(): a set of bodies, synchronously ------------- */
+
+/** Transfers fetch_get_blocking() runs at once. */
+#define BLOCKING_PARALLEL 6
+/** How long it waits for all of them. */
+#define BLOCKING_TIMEOUT_S 120
+
+static size_t
+fetch_blocking_write(char *data, size_t size, size_t nmemb, void *p)
+{
+	struct fetch_blocking_body *b = p;
+	size_t n = size * nmemb;
+	char *m = realloc(b->data, b->len + n + 1);
+
+	if (m == NULL)
+		return 0;	/* ends the transfer with an error */
+	memcpy(m + b->len, data, n);
+	b->len += n;
+	m[b->len] = '\0';
+	b->data = m;
+	return n;
+}
+
+/**
+ * Start transfer i on multi, or report that its host is still being looked
+ * up (WITH_CURL_ASYNC_RESOLVE: curl may not look names up itself).
+ *
+ * 
+eturn 1 started, 0 not yet, -1 failed
+ */
+static int
+fetch_blocking_start(CURLM *multi, const char *url, const char *referer,
+		struct fetch_blocking_body *res, unsigned int i,
+		struct curl_slist **resolve, CURL **handle)
+{
+	CURL *e;
+#ifdef WITH_CURL_ASYNC_RESOLVE
+	char addr[64], entry[400];
+	nsurl *nu;
+	lwc_string *host, *port_s;
+	long port;
+	enum fetch_curl_resolve_result r;
+
+	if (nsurl_create(url, &nu) != NSERROR_OK)
+		return -1;
+	host = nsurl_get_component(nu, NSURL_HOST);
+	if (host == NULL) {
+		nsurl_unref(nu);
+		return -1;
+	}
+	r = fetch_curl_resolve(lwc_string_data(host), addr, sizeof(addr));
+	if (r == FETCH_CURL_RESOLVE_READY && addr[0] != '\0') {
+		port_s = nsurl_get_component(nu, NSURL_PORT);
+		if (port_s != NULL) {
+			port = strtol(lwc_string_data(port_s), NULL, 10);
+			lwc_string_unref(port_s);
+		} else {
+			port = (nsurl_get_scheme_type(nu) ==
+					NSURL_SCHEME_HTTPS) ? 443 : 80;
+		}
+		snprintf(entry, sizeof(entry), "%s:%ld:%s",
+			 lwc_string_data(host), port, addr);
+		*resolve = curl_slist_append(NULL, entry);
+	}
+	lwc_string_unref(host);
+	nsurl_unref(nu);
+	if (r == FETCH_CURL_RESOLVE_PENDING)
+		return 0;
+	if (r == FETCH_CURL_RESOLVE_FAILED ||
+	    (addr[0] != '\0' && *resolve == NULL))
+		return -1;
+#else
+	(void)resolve;
+#endif
+	e = curl_easy_duphandle(fetch_blank_curl);
+	if (e == NULL)
+		return -1;
+	curl_easy_setopt(e, CURLOPT_URL, url);
+	curl_easy_setopt(e, CURLOPT_PRIVATE, (void *)(uintptr_t)i);
+	curl_easy_setopt(e, CURLOPT_WRITEFUNCTION, fetch_blocking_write);
+	curl_easy_setopt(e, CURLOPT_WRITEDATA, &res[i]);
+	curl_easy_setopt(e, CURLOPT_HEADERFUNCTION, NULL);
+	curl_easy_setopt(e, CURLOPT_HEADERDATA, NULL);
+	curl_easy_setopt(e, CURLOPT_NOPROGRESS, 1L);
+	curl_easy_setopt(e, CURLOPT_FOLLOWLOCATION, 1L);
+	curl_easy_setopt(e, CURLOPT_MAXREDIRS, 5L);
+	curl_easy_setopt(e, CURLOPT_TIMEOUT, (long)BLOCKING_TIMEOUT_S);
+	if (referer != NULL)
+		curl_easy_setopt(e, CURLOPT_REFERER, referer);
+	if (*resolve != NULL)
+		curl_easy_setopt(e, CURLOPT_RESOLVE, *resolve);
+	if (curl_multi_add_handle(multi, e) != CURLM_OK) {
+		curl_easy_cleanup(e);
+		return -1;
+	}
+	*handle = e;
+	return 1;
+}
+
+/**
+ * A file: URL, read directly (the Vita's bundled pages live on app0:, where
+ * the file fetcher, not curl, is what knows the paths).
+ *
+ * \return true if url was a file: URL (res filled in either way)
+ */
+static bool fetch_blocking_file(const char *url, struct fetch_blocking_body *res)
+{
+	nsurl *nu;
+	char *path = NULL;
+	FILE *fp;
+	long len;
+
+	if (strncasecmp(url, "file:", 5) != 0)
+		return false;
+	if (nsurl_create(url, &nu) != NSERROR_OK)
+		return true;
+	if (guit->file->nsurl_to_path(nu, &path) == NSERROR_OK &&
+	    (fp = fopen(path, "rb")) != NULL) {
+		if (fseek(fp, 0, SEEK_END) == 0 && (len = ftell(fp)) >= 0 &&
+		    fseek(fp, 0, SEEK_SET) == 0 &&
+		    (res->data = malloc((size_t)len + 1)) != NULL) {
+			if (fread(res->data, 1, (size_t)len, fp) == (size_t)len) {
+				res->data[len] = '\0';
+				res->len = (size_t)len;
+				res->status = 200;
+			} else {
+				free(res->data);
+				res->data = NULL;
+			}
+		}
+		fclose(fp);
+	}
+	free(path);
+	nsurl_unref(nu);
+	return true;
+}
+
+/* exported interface documented in content/fetch.h */
+unsigned int fetch_get_blocking(const char *const *urls, unsigned int n,
+		const char *referer, struct fetch_blocking_body *res)
+{
+	CURLM *multi;
+	struct curl_slist **resolve;
+	CURL **handle;
+	unsigned char *state;	/* 0 waiting, 1 running, 2 done */
+	unsigned int i, active = 0, left = n, ok = 0;
+	uint64_t t0, now;
+	int running, queued;
+	CURLMsg *msg;
+
+	for (i = 0; i < n; i++) {
+		res[i].data = NULL;
+		res[i].len = 0;
+		res[i].status = 0;
+	}
+	multi = curl_multi_init();
+	resolve = calloc(n, sizeof(*resolve));
+	handle = calloc(n, sizeof(*handle));
+	state = calloc(n, 1);
+	if (multi == NULL || resolve == NULL || handle == NULL ||
+	    state == NULL) {
+		if (multi != NULL)
+			curl_multi_cleanup(multi);
+		free(resolve);
+		free(handle);
+		free(state);
+		return 0;
+	}
+	nsu_getmonotonic_ms(&t0);
+	while (left > 0) {
+		/* Start what may start: at most BLOCKING_PARALLEL at once. */
+		for (i = 0; i < n && active < BLOCKING_PARALLEL; i++) {
+			int r;
+			if (state[i] != 0)
+				continue;
+			if (fetch_blocking_file(urls[i], &res[i])) {
+				if (res[i].status == 200)
+					ok++;
+				state[i] = 2;
+				left--;
+				continue;
+			}
+			r = fetch_blocking_start(multi, urls[i], referer, res,
+					i, &resolve[i], &handle[i]);
+			if (r == 1) {
+				state[i] = 1;
+				active++;
+			} else if (r < 0) {
+				state[i] = 2;
+				left--;
+			}
+		}
+		curl_multi_perform(multi, &running);
+		while ((msg = curl_multi_info_read(multi, &queued)) != NULL) {
+			void *priv = NULL;
+			if (msg->msg != CURLMSG_DONE)
+				continue;
+			curl_easy_getinfo(msg->easy_handle, CURLINFO_PRIVATE,
+					&priv);
+			i = (unsigned int)(uintptr_t)priv;
+			if (msg->data.result == CURLE_OK) {
+				curl_easy_getinfo(msg->easy_handle,
+						CURLINFO_RESPONSE_CODE,
+						&res[i].status);
+			} else {
+				NSLOG(netsurf, INFO, "%s: %s", urls[i],
+				      curl_easy_strerror(msg->data.result));
+			}
+			if (res[i].status >= 200 && res[i].status < 300)
+				ok++;
+			curl_multi_remove_handle(multi, msg->easy_handle);
+			curl_easy_cleanup(msg->easy_handle);
+			handle[i] = NULL;
+			state[i] = 2;
+			active--;
+			left--;
+		}
+		nsu_getmonotonic_ms(&now);
+		if (now - t0 > BLOCKING_TIMEOUT_S * 1000) {
+			NSLOG(netsurf, WARNING, "gave up on %u of %u", left, n);
+			break;
+		}
+		/* Waits for traffic, or 50 ms (a lookup in progress). */
+		if (left > 0)
+			curl_multi_poll(multi, NULL, 0, 50, NULL);
+	}
+	/* Anything unfinished (the time limit): its handle is still on. */
+	for (i = 0; i < n; i++) {
+		if (handle[i] != NULL) {
+			curl_multi_remove_handle(multi, handle[i]);
+			curl_easy_cleanup(handle[i]);
+		}
+		if (state[i] != 2) {
+			free(res[i].data);
+			res[i].data = NULL;
+			res[i].len = 0;
+			res[i].status = 0;
+		}
+		curl_slist_free_all(resolve[i]);
+	}
+	curl_multi_cleanup(multi);
+	free(resolve);
+	free(handle);
+	free(state);
+	return ok;
+}
