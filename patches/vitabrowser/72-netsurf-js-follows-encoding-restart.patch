+/* VitaBrowser: the HTML handler replaced the thread's document -- a
+ * <meta charset> past the first 1024 bytes makes it restart the parse
+ * into a new one (html_process_encoding_change) -- so the realm, wired to
+ * the first by js_newthread, would go on seeing the abandoned document:
+ * claude.ai's app found no #root, because its document ended at the meta.
+ * Re-wire the realm exactly as js_newthread does. */
+nserror js_thread_rebind_document(struct jsthread *thread)
+{
+	html_content *htmlc;
+
+	if (thread == NULL || thread->heap == NULL || thread->doc_priv == NULL ||
+			thread->ctx == NULL || thread->ctx != thread->heap->ctx)
+		return NSERROR_BAD_PARAMETER;
+	htmlc = (html_content *)thread->doc_priv;
+	qjs_set_document(thread->heap, htmlc->document);
+	qjs_dom_install(thread->heap->ctx);
+	MS_LOG("qjs: thread document re-wired (encoding change)");
+	return NSERROR_OK;
+}
+
