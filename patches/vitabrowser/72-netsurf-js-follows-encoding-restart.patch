# netsurf: scripts follow the document across an encoding restart
# Generated 2026-09-24
#
# A <meta charset> beyond the first 1024 bytes (claude.ai's is at byte
# 1185) is found mid-parse; html_process_encoding_change then destroys the
# document and parses the page again into a new one. The page's JS realm,
# wired to the first document by js_newthread, went on answering from the
# abandoned one -- a <head> cut off at that meta, no <body> -- so claude.ai's
# app threw "Root element #root not found". The HTML handler now calls the
# new js_thread_rebind_document() after the switch; the QuickJS bridge
# re-wires the realm as js_newthread does (Duktape and "none" do nothing).

diff --git a/content/handlers/html/html.c b/content/handlers/html/html.c
index ca690b8..943aa56 100644
--- a/content/handlers/html/html.c
+++ b/content/handlers/html/html.c
@@ -2218,6 +2218,12 @@ html_process_encoding_change(struct content *c,
 
 	}
 
+	/* VitaBrowser: scripts must see the new document, not the one just
+	 * abandoned (js_thread_rebind_document). */
+	if (html->js_thread != NULL) {
+		js_thread_rebind_document(html->js_thread);
+	}
+
 	source_data = content__get_source_data(c, &source_size);
 
 	/* fixes506: don't feed a NULL/empty buffer to the parser. After
