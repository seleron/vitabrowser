index 5b219df..c4039c5 100644
--- a/content/handlers/javascript/quickjs/macsurf_qjs.c
+++ b/content/handlers/javascript/quickjs/macsurf_qjs.c
@@ -15826,6 +15826,26 @@ nserror js_newthread(struct jsheap *heap, void *win_priv, void *doc_priv,
