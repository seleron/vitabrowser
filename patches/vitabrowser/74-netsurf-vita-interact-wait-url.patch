# netsurf (Vita frontend): interaction steps wait for their URL
# Generated 2026-09-24
#
# Hardware run 15: steps 18-19 (submit IN-form, then open a typed URL) failed
# on the device only: the form's submit navigates from a script, and the old
# page had settled -- so the step was checked -- before the new page
# started. A URL step (C_URL, C_REMOTE) now also waits, up to its 20 s
# timeout, until the URL is the one expected.

diff --git a/frontends/vita/interact.c b/frontends/vita/interact.c
index 4660d03..b95a4d3 100644
--- a/frontends/vita/interact.c
+++ b/frontends/vita/interact.c
@@ -385,6 +385,15 @@ bool vita_interact_step(struct gui_window *gw, struct vita_input *in)
 		    (!host->settled(gw) &&
 		     now - run.started_ms < STEP_TIMEOUT_MS))
 			return true;
+		/* A URL step waits for its URL, too: on the Vita a script's
+		 * form submit can navigate after the old page has settled
+		 * (hardware run 15, steps 18-19). */
+		if ((s->check == C_URL || s->check == C_REMOTE) &&
+		    now - run.started_ms < STEP_TIMEOUT_MS) {
+			char scratch[300];
+			if (!url_ends(gw, s->expect, scratch, sizeof(scratch)))
+				return true;
+		}
 		if (!host->settled(gw))
 			vita_diag_log("interact: %u did not settle in %u ms",
 				      run.step + 1, STEP_TIMEOUT_MS);
