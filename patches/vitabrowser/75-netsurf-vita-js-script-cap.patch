# netsurf (MacSurf bridge): run classic scripts up to 8 MB on the Vita
# Generated 2026-09-24
#
# MacSurf skips any classic script over 256 KB (MACSURF_JS_MAX_BYTES, sized
# for Mac OS 9's memory), logging only "js skip". YouTube's mobile app is one
# 1.6 MB bundle, so its page stayed an empty shell -- the black-and-white
# page of hardware run 15. The Vita's JS heap is 128 MB (patch 71): the
# ceiling is 8 MB there. With it, m.youtube.com runs its app and draws its
# loading skeleton in the simulator.

diff --git a/content/handlers/javascript/quickjs/macos9.h b/content/handlers/javascript/quickjs/macos9.h
index f4d9470..898359a 100644
--- a/content/handlers/javascript/quickjs/macos9.h
+++ b/content/handlers/javascript/quickjs/macos9.h
@@ -92,6 +92,13 @@ void macsurf_profile_accum_js(long us);
  */
 #define MACSURF_WINDOW_SERVICES 1
 
+/** The largest classic script run, bytes. MacSurf's 256 KB ceiling (for
+ * the Mac's memory) skipped YouTube's 1.6 MB bundle outright, leaving its
+ * page an empty black shell; the Vita's JS heap is 128 MB. */
+#ifndef MACSURF_JS_MAX_BYTES
+#define MACSURF_JS_MAX_BYTES (8UL * 1024UL * 1024UL)
+#endif
+
 /** navigator.platform. */
 #ifndef MACSURF_JS_PLATFORM
 #define MACSURF_JS_PLATFORM "PlayStation Vita"
