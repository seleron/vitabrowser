# netsurf: custom properties inherit (select.c)
# Generated 2026-09-24
#
# MacSurf's libcss carries each element's custom properties in an
# environment and can seed it from the parent's (fixes1268c), but the
# caller has to hand the parent's in and take the element's out around
# css_select_style -- which MacSurf's cssh_select.c does and our select.c
# did not. A --variable therefore reached only the element that declared
# it: every :root theme variable (claude.ai, YouTube, Wikipedia) resolved
# to nothing, so backgrounds, colours and fonts from var() were lost.

diff --git a/content/handlers/css/select.c b/content/handlers/css/select.c
index a5a6baf..3fe31eb 100644
--- a/content/handlers/css/select.c
+++ b/content/handlers/css/select.c
@@ -285,9 +285,22 @@ css_select_results *nscss_get_style(nscss_select_ctx *ctx, dom_node *n,
 	int pseudo_element;
 	css_error error;
 
-	/* Select style for node */
+	/* Select style for node. MacSurf (cssh_select.c fixes1268c): hand
+	 * libcss the parent's custom properties so this element inherits
+	 * them, then take back the element's own set for its children.
+	 * VitaBrowser's select.c had lost this, so a --variable reached only
+	 * the element declaring it: every :root theme variable (claude.ai,
+	 * YouTube, Wikipedia) resolved to nothing. */
+	css_select_ctx_set_parent_custom_env(ctx->ctx, ctx->parent_custom_env);
 	error = css_select_style(ctx->ctx, n, unit_len_ctx, media, inline_style,
 			&selection_handler, ctx, &styles);
+	if (ctx->produced_custom_env != NULL) {
+		css_custom_env_unref(ctx->produced_custom_env);
+		ctx->produced_custom_env = NULL;
+	}
+	if (error == CSS_OK)
+		ctx->produced_custom_env =
+			css_select_ctx_take_custom_env(ctx->ctx);
 
 	if (error != CSS_OK || styles == NULL) {
 		/* Failed selecting partial style -- bail out */
