# netsurf: rgba() backgrounds draw at their alpha
# Generated 2026-09-24
#
# NetSurf's colour type has no alpha, so rgba(0,0,0,.6) painted solid
# black: YouTube's consent scrim hid the page and the dialog. The
# background painters (block and inline) now fold the CSS colour's alpha
# into the fill's opacity, which the Vita plotter blends by (25/50/75/100%
# buckets, as for opacity).

diff --git a/content/handlers/html/redraw.c b/content/handlers/html/redraw.c
index e668414..2c61bb5 100644
--- a/content/handlers/html/redraw.c
+++ b/content/handlers/html/redraw.c
@@ -1653,6 +1653,22 @@ static bool html_redraw_background(int x, int y, struct box *box, float scale,
 	                        macos9_animation_register_rect(x, y, rw, rh);
 	                }
 	        }
+	        /* VitaBrowser: an rgba()/transparent-ish background colour
+	         * is drawn at its alpha: the colour NetSurf hands on has no
+	         * alpha, so it goes into the opacity the plotter blends by
+	         * (YouTube's consent scrim, rgba(0,0,0,.6), drew solid black). */
+	        {
+	                css_color bgc_a = 0;
+	                if (css_computed_background_color(background->style,
+	                                &bgc_a) == CSS_BACKGROUND_COLOR_COLOR) {
+	                        unsigned int alpha = (bgc_a >> 24) & 0xff;
+	                        if (alpha > 0 && alpha < 255) {
+	                                pstyle_fill_bg.opacity = (plot_style_fixed)
+	                                        ((int64_t)pstyle_fill_bg.opacity *
+	                                         alpha / 255);
+	                        }
+	                }
+	        }
 	        /* fixes71 -- -macsurf-transform packed value to the plotter.
 	         * fixes73 -- scale companion in transform_b. */
 	        {
@@ -2459,6 +2475,22 @@ static bool html_redraw_inline_background(int x, int y, struct box *box,
 	                                        b.x1 - b.x0, b.y1 - b.y0);
 	                }
 	        }
+	        /* VitaBrowser: an rgba()/transparent-ish background colour
+	         * is drawn at its alpha: the colour NetSurf hands on has no
+	         * alpha, so it goes into the opacity the plotter blends by
+	         * (YouTube's consent scrim, rgba(0,0,0,.6), drew solid black). */
+	        {
+	                css_color bgc_a = 0;
+	                if (css_computed_background_color(box->style,
+	                                &bgc_a) == CSS_BACKGROUND_COLOR_COLOR) {
+	                        unsigned int alpha = (bgc_a >> 24) & 0xff;
+	                        if (alpha > 0 && alpha < 255) {
+	                                pstyle_fill_bg.opacity = (plot_style_fixed)
+	                                        ((int64_t)pstyle_fill_bg.opacity *
+	                                         alpha / 255);
+	                        }
+	                }
+	        }
 	        /* fixes71 -- -macsurf-transform mirror for inline path.
 	         * fixes73 -- scale companion in transform_b. */
 	        {
