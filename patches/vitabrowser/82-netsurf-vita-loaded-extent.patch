# netsurf (Vita frontend): the loaded page's size, and what sticks out
# Generated 2026-09-24
#
# The "document after" extent is mid-layout: Wikipedia logged 1011 px there
# and settles at 960. Once a page stops loading, log.txt now records
# "page X: loaded, extent WxH", and when that is wider than the screen, the
# innermost boxes past its edge ("wide box: tag#id.class x a..b") -- the
# device's own answer to a sideways-scrolling page. tools/run-live-sites.sh
# reports the loaded extent.

diff --git a/frontends/vita/main.c b/frontends/vita/main.c
index b33ede3..b3072e9 100644
--- a/frontends/vita/main.c
+++ b/frontends/vita/main.c
@@ -960,6 +960,22 @@ static void watch_load(struct gui_window *gw)
 			      "(see netsurf.log for the engine's side)",
 			      page_name(vita_page), age);
 	}
+	/* Once loaded: its final size (the size at "document after" is
+	 * mid-layout), and when wider than the screen, what sticks out. */
+	{
+		static unsigned int loaded_nav = ~0u;
+		if (vita_stats.content_ms != 0 && !vita_window_loading(gw) &&
+		    loaded_nav != vita_stats.nav_ms) {
+			loaded_nav = vita_stats.nav_ms;
+			vita_diag_log("page %s: loaded, extent %dx%d%s",
+				      page_name(vita_page), w, h,
+				      w > VITA_SCREEN_WIDTH ?
+				      ", wider than the screen" : "");
+			if (w > VITA_SCREEN_WIDTH)
+				vita_window_log_wide_boxes(gw,
+						VITA_SCREEN_WIDTH);
+		}
+	}
 	if ((vita_stats.content_ms == 0 || vita_window_loading(gw)) &&
 	    age < VITA_STATUS_LOG_MS && now - vita_stats.status_ms >= 1000) {
 		vita_stats.status_ms = now;
