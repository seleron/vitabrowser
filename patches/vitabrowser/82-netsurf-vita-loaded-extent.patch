+/** A box's element as "tag#id.class" (for the log). */
+static void wide_box_name(struct box *b, char *out, size_t max)
+{
+	dom_string *s = NULL;
+	size_t n = 0;
+
+	out[0] = '\0';
+	while (b != NULL && b->node == NULL)
+		b = b->parent;
+	if (b == NULL)
+		return;
+	if (dom_node_get_node_name(b->node, &s) == DOM_NO_ERR && s != NULL) {
+		n = (size_t)snprintf(out, max, "%s", dom_string_data(s));
+		dom_string_unref(s);
+	}
+	s = NULL;
+	if (n < max && dom_element_get_attribute(b->node, corestring_dom_id,
+			&s) == DOM_NO_ERR && s != NULL) {
+		n += (size_t)snprintf(out + n, max - n, "#%s",
+				dom_string_data(s));
+		dom_string_unref(s);
+	}
+	s = NULL;
+	if (n < max && dom_element_get_attribute(b->node,
+			corestring_dom_class, &s) == DOM_NO_ERR && s != NULL) {
+		snprintf(out + n, max - n, ".%.60s", dom_string_data(s));
+		dom_string_unref(s);
+	}
+}
+
+/** Log the innermost boxes whose border edge passes limit; how many. */
+static unsigned int wide_boxes(struct box *b, int limit, unsigned int left)
+{
+	unsigned int logged = 0;
+	struct box *c;
+	int x, y, right;
+
+	for (c = b->children; c != NULL && logged < left; c = c->next)
+		logged += wide_boxes(c, limit, left - logged);
+	if (logged > 0 || b->type == BOX_INLINE_END)
+		return logged;
+	box_coords(b, &x, &y);
+	right = x + b->padding[LEFT] + b->width + b->padding[RIGHT] +
+		b->border[LEFT].width + b->border[RIGHT].width;
+	if (right > limit && b->width != UNKNOWN_WIDTH && b->width >= 0) {
+		char name[128];
+		wide_box_name(b, name, sizeof(name));
+		vita_diag_log("wide box: %s x %d..%d, y %d (type %d)",
+			      name[0] ? name : "(anonymous)", x, right, y,
+			      (int)b->type);
+		return 1;
+	}
+	return 0;
+}
+
+/* exported interface documented in vita/window.h */
+void vita_window_log_wide_boxes(struct gui_window *gw, int limit)
+{
+	struct hlcache_handle *h;
+	struct box *root;
+
+	if (gw == NULL || gw->bw == NULL)
+		return;
+	h = browser_window_get_content(gw->bw);
+	if (h == NULL || content_get_type(h) != CONTENT_HTML)
+		return;
+	root = html_get_box_tree(h);
+	if (root != NULL)
+		wide_boxes(root, limit, 5);
+}
+
 /* exported interface documented in vita/window.h */
