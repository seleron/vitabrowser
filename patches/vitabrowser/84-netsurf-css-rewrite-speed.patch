+/* VitaBrowser: the last few rewrites, by content. A page's <style>
+ * blocks are made into fresh sheets on every reformat (hardware run 16:
+ * the same 42 KB of claude.ai's inline CSS rewritten again and again, 362
+ * ms each time on the Vita); the same text gets the same rewrite. */
+#define REWRITE_CACHE_SLOTS 16
+#define REWRITE_CACHE_MAX (512 * 1024)
+static struct {
+	uint64_t hash;
+	size_t in_len, out_len;
+	char *out;	/* NULL: the rewrite changed nothing */
+	bool used;
+	unsigned int age;
+} rewrite_cache[REWRITE_CACHE_SLOTS];
+static unsigned int rewrite_clock;
+
+static uint64_t rewrite_hash(const char *d, size_t n)
+{
+	uint64_t h = 1469598103934665603ULL;	/* FNV-1a */
+	size_t i;
+	for (i = 0; i < n; i++) {
+		h ^= (unsigned char)d[i];
+		h *= 1099511628211ULL;
+	}
+	return h;
+}
+
+/**
+ * Rewrite a sheet (css_rewrite.c), from the cache when the same text was
+ * rewritten lately.
+ *
+ * \return the rewritten text (malloc()ed) or NULL for "use the original"
+ */
+static char *nscss_rewrite_cached(const char *d, size_t n, size_t *out_len)
+{
+	uint64_t h;
+	unsigned int i, victim = 0;
+	char *rw;
+
+	if (n > REWRITE_CACHE_MAX)
+		return macsurf_css_rewrite(d, n, out_len);
+	h = rewrite_hash(d, n);
+	for (i = 0; i < REWRITE_CACHE_SLOTS; i++) {
+		if (rewrite_cache[i].used && rewrite_cache[i].hash == h &&
+		    rewrite_cache[i].in_len == n) {
+			rewrite_cache[i].age = ++rewrite_clock;
+			if (rewrite_cache[i].out == NULL)
+				return NULL;
+			rw = malloc(rewrite_cache[i].out_len + 1);
+			if (rw == NULL)
+				return NULL;
+			memcpy(rw, rewrite_cache[i].out,
+			       rewrite_cache[i].out_len + 1);
+			*out_len = rewrite_cache[i].out_len;
+			return rw;
+		}
+		if (!rewrite_cache[i].used ||
+		    rewrite_cache[i].age < rewrite_cache[victim].age)
+			victim = i;
+		if (!rewrite_cache[i].used)
+			break;
+	}
+	rw = macsurf_css_rewrite(d, n, out_len);
+	free(rewrite_cache[victim].out);
+	rewrite_cache[victim].out = NULL;
+	rewrite_cache[victim].used = true;
+	rewrite_cache[victim].hash = h;
+	rewrite_cache[victim].in_len = n;
+	rewrite_cache[victim].age = ++rewrite_clock;
+	if (rw != NULL) {
+		rewrite_cache[victim].out = malloc(*out_len + 1);
+		if (rewrite_cache[victim].out != NULL) {
+			memcpy(rewrite_cache[victim].out, rw, *out_len + 1);
+			rewrite_cache[victim].out_len = *out_len;
+		} else {
+			rewrite_cache[victim].used = false;
+		}
+	}
+	return rw;
+}
