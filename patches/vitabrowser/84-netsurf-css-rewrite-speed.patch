+/* ---- VitaBrowser: skip a pass whose trigger text is absent ------------
+ * Each pass scans the whole sheet (claude.ai's is 1.4 MB) whether or not
+ * it has anything to do; on the Vita the chain took 12.6 s for that sheet
+ * (hardware run 16). A pass now runs only when one of its property or
+ * function names occurs in the text (case-insensitively), found with
+ * memchr; the pass itself decides the rest, exactly as before. */
+static bool macsurf__has_ci(const char *d, size_t n, const char *key)
+{
+	size_t k = strlen(key), pass;
+	for (pass = 0; pass < 2; pass++) {
+		char c0 = pass == 0 ? (char)tolower((unsigned char)key[0]) :
+				(char)toupper((unsigned char)key[0]);
+		const char *p = d, *end = d + n;
+		if (pass == 1 && c0 == (char)tolower((unsigned char)key[0]))
+			break;	/* no case for this character */
+		while (p + k <= end &&
+		       (p = memchr(p, c0, (size_t)(end - p) - k + 1)) != NULL) {
+			if (strncasecmp(p + 1, key + 1, k - 1) == 0)
+				return true;
+			p++;
+		}
+	}
+	return false;
+}
+
+static bool macsurf__has_any_ci(const char *d, size_t n, const char *const *keys)
+{
+	for (; *keys != NULL; keys++)
+		if (macsurf__has_ci(d, n, *keys))
+			return true;
+	return false;
+}
