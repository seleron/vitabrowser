# netsurf (Vita frontend): browse at ARM 444 MHz; the engine log can be off
# Generated 2026-09-24
#
# - The browsing profile left the ARM at its boot 333 MHz. A page is CPU
#   work -- CSS, layout, JavaScript, TLS -- so the ARM now runs at 444 and
#   the bus at 222, pass D's clocks, which the autotest has run every
#   hardware run since run 4.
# - ux0:data/VitaBrowser/enginelog.cfg containing "off" (or
#   VITA_ENGINE_LOG=off in the simulator) skips the engine log.

diff --git a/frontends/vita/diag.c b/frontends/vita/diag.c
index e767be8..deb8d4e 100644
--- a/frontends/vita/diag.c
+++ b/frontends/vita/diag.c
@@ -643,6 +643,26 @@ void vita_diag_engine_log_init(void)
 	int argc = 3;
 	nserror ret;
 
+	/* VitaBrowser: the engine log can be switched off -- it formats and
+	 * writes thousands of lines a page (VITA_DIAG_DIR enginelog.cfg
+	 * "off", or VITA_ENGINE_LOG=off in the simulator). */
+	{
+		char word[16] = "";
+		FILE *cfg = fopen(VITA_DIAG_DIR "enginelog.cfg", "r");
+		const char *env = getenv("VITA_ENGINE_LOG");
+		if (cfg != NULL) {
+			if (fgets(word, sizeof(word), cfg) == NULL)
+				word[0] = '\0';
+			fclose(cfg);
+		}
+		if (env != NULL)
+			snprintf(word, sizeof(word), "%s", env);
+		if (strncmp(word, "off", 3) == 0) {
+			vita_diag_log("engine log: off (enginelog.cfg)");
+			return;
+		}
+	}
+
 	{
 		/* Start afresh once the file has grown past a cap: the old
 		 * one is kept, once, as netsurf.old.log. */
diff --git a/frontends/vita/main.c b/frontends/vita/main.c
index b3072e9..1e4fea3 100644
--- a/frontends/vita/main.c
+++ b/frontends/vita/main.c
@@ -223,8 +223,13 @@ static const struct autotest_pass vita_passes[] = {
 #define VITA_PASS_COUNT (sizeof(vita_passes) / sizeof(vita_passes[0]))
 
 /** The browsing profile, applied at start-up and after the autotest:
- * CPU clipping and the GPU at 222 MHz; the ARM stays as booted. */
+ * CPU clipping, the ARM at 444 MHz and bus at 222 (pass D's clocks), the
+ * GPU at 222 MHz. The ARM booted at 333: a web page is CPU work -- CSS,
+ * layout, JavaScript, TLS handshakes -- so this is a third more of all of
+ * it (hardware run 16: real sites took 15-25 s to load). */
 #define VITA_RUN_CLIP VITA_CLIP_CPU
+#define VITA_RUN_ARM 444
+#define VITA_RUN_BUS 222
 #define VITA_RUN_GPU 222
 #define VITA_RUN_XBAR 166
 
@@ -513,7 +518,8 @@ static void apply_pass(unsigned int i)
 static void apply_run_profile(void)
 {
 	vita_plot_clip_mode = VITA_RUN_CLIP;
-	vita_diag_set_clocks("run", 0, 0, VITA_RUN_GPU, VITA_RUN_XBAR);
+	vita_diag_set_clocks("run", VITA_RUN_ARM, VITA_RUN_BUS, VITA_RUN_GPU,
+			     VITA_RUN_XBAR);
 }
 
 /** Log one page's timed frames and add them to the pass totals. */
