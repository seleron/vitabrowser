+/* ---- VitaBrowser: compiled modules kept on the memory card -----------
+ * claude.ai's app is 66 modules, 19 MB: on the Vita (hardware run 16)
+ * 13 s to download and 82 s to compile and run. Each module's bytecode
+ * goes to MACSURF_JSCACHE_DIR with its static imports; on a later visit a
+ * module whose file name carries a content hash (Vite's
+ * "index-DKU2AWSS.js": the text cannot change under that name) is neither
+ * fetched nor parsed, and any other is fetched and its bytecode reused if
+ * the text is the same. Files carry the build's stamp: another build's
+ * bytecode is ignored. */
+static uint32_t g_mod_compiled, g_mod_from_cache;
+static double g_mod_compile_us, g_mod_read_us;
+
+/* Scripts this large are compiled without keeping their functions'
+ * source text (patches/quickjs/02): QuickJS keeps one copy per function,
+ * nested ones included, so a big bundle's text sits in the heap several
+ * times over. toString of those functions gives "[native code]". */
+#define QJS_STRIP_SOURCE_MIN (128u * 1024u)
+
+#ifdef MACSURF_JSCACHE_DIR
+#define QJS_JSCACHE_MAX (96ul * 1024ul * 1024ul)
+static const char qjs_jscache_stamp[32] = "VBQ2 " __DATE__ " " __TIME__;
+
+static uint32_t qjs_fnv32(const char *s, size_t n)
+{
+	uint32_t h = 2166136261u;
+	size_t i;
+	for (i = 0; i < n; i++) {
+		h ^= (unsigned char)s[i];
+		h *= 16777619u;
+	}
+	return h;
+}
+
+static void qjs_jscache_path(const char *url, char *out, size_t max)
+{
+	size_t n = strlen(url);
+	snprintf(out, max, "%s%08lx%08lx.qbc", MACSURF_JSCACHE_DIR,
+		 (unsigned long)qjs_fnv32(url, n),
+		 (unsigned long)qjs_fnv32(url, n / 2 + 1));
+}
+
+/* A file name with a content hash before .js/.mjs: "name-AbC12xYz.js". */
+static bool qjs_url_immutable(const char *url)
+{
+	const char *q = strchr(url, '?'), *end, *p;
+	size_t run = 0;
+	bool upper_or_digit = false;
+	end = q != NULL ? q : url + strlen(url);
+	if (end - url > 3 && strncmp(end - 3, ".js", 3) == 0)
+		end -= 3;
+	else if (end - url > 4 && strncmp(end - 4, ".mjs", 4) == 0)
+		end -= 4;
+	else
+		return false;
+	for (p = end; p > url && (isalnum((unsigned char)p[-1]) ||
+			p[-1] == '_' || p[-1] == '-'); p--) {
+		if (p[-1] == '-' && run >= 8)
+			break;
+		run++;
+		if (isupper((unsigned char)p[-1]) ||
+				isdigit((unsigned char)p[-1]))
+			upper_or_digit = true;
+	}
+	return run >= 8 && upper_or_digit && p > url && p[-1] == '-';
+}
+
+/* Read url's cache file into e (bytecode and imports); its source's
+ * length and hash come back for comparison. */
+static bool qjs_jscache_load(const char *url, struct module_entry *e,
+		uint32_t *srclen, uint32_t *srchash)
+{
+	char path[256], stamp[32];
+	uint32_t hdr[3];
+	FILE *fp;
+	long size;
+	char *imports = NULL;
+	uint8_t *bc = NULL;
+	size_t bclen;
+
+	qjs_jscache_path(url, path, sizeof(path));
+	fp = fopen(path, "rb");
+	if (fp == NULL)
+		return false;
+	if (fread(stamp, 1, 32, fp) != 32 ||
+			memcmp(stamp, qjs_jscache_stamp, 32) != 0 ||
+			fread(hdr, sizeof(uint32_t), 3, fp) != 3 ||
+			fseek(fp, 0, SEEK_END) != 0 || (size = ftell(fp)) < 0 ||
+			(size_t)size < 32 + 12 + hdr[2]) {
+		fclose(fp);
+		return false;
+	}
+	bclen = (size_t)size - 32 - 12 - hdr[2];
+	imports = (char *)malloc(hdr[2] + 1);
+	bc = (uint8_t *)malloc(bclen ? bclen : 1);
+	if (imports == NULL || bc == NULL || fseek(fp, 32 + 12, SEEK_SET) != 0 ||
+			fread(imports, 1, hdr[2], fp) != hdr[2] ||
+			fread(bc, 1, bclen, fp) != bclen) {
+		free(imports);
+		free(bc);
+		fclose(fp);
+		return false;
+	}
+	fclose(fp);
+	imports[hdr[2]] = '\0';
+	free(e->bc);
+	free(e->imports);
+	e->bc = bc;
+	e->bc_len = bclen;
+	e->imports = imports;
+	e->imports_len = hdr[2];
+	*srclen = hdr[0];
+	*srchash = hdr[1];
+	return true;
+}
+
+static void qjs_jscache_store(const char *url, const char *src,
+		size_t srclen, const char *imports, size_t imports_len,
+		const uint8_t *bc, size_t bclen)
+{
+	static bool made;
+	char path[256];
+	uint32_t hdr[3];
+	FILE *fp;
+
+	if (!made) {
+		/* Once a session: past QJS_JSCACHE_MAX on the card, start the
+		 * cache afresh (one claude.ai visit leaves ~40 MB). */
+		DIR *d;
+		struct dirent *de;
+		struct stat st;
+		unsigned long total = 0;
+		char f[sizeof(MACSURF_JSCACHE_DIR) + 260];
+		mkdir(MACSURF_JSCACHE_DIR, 0777);
+		made = true;
+		d = opendir(MACSURF_JSCACHE_DIR);
+		while (d != NULL && (de = readdir(d)) != NULL) {
+			snprintf(f, sizeof(f), "%s%s", MACSURF_JSCACHE_DIR,
+				 de->d_name);
+			if (strstr(de->d_name, ".qbc") != NULL &&
+			    stat(f, &st) == 0)
+				total += (unsigned long)st.st_size;
+		}
+		if (d != NULL)
+			closedir(d);
+		if (total > QJS_JSCACHE_MAX) {
+			d = opendir(MACSURF_JSCACHE_DIR);
+			while (d != NULL && (de = readdir(d)) != NULL) {
+				if (strstr(de->d_name, ".qbc") == NULL)
+					continue;
+				snprintf(f, sizeof(f), "%s%s",
+					 MACSURF_JSCACHE_DIR, de->d_name);
+				remove(f);
+			}
+			if (d != NULL)
+				closedir(d);
+			macsurf_debug_log_writef("LIFE module cache: %lu KiB, "
+				"cleared", total / 1024);
+		}
+	}
+	qjs_jscache_path(url, path, sizeof(path));
+	fp = fopen(path, "wb");
+	if (fp == NULL)
+		return;
+	hdr[0] = (uint32_t)srclen;
+	hdr[1] = qjs_fnv32(src, srclen);
+	hdr[2] = (uint32_t)imports_len;
+	if (fwrite(qjs_jscache_stamp, 1, 32, fp) != 32 ||
+			fwrite(hdr, sizeof(uint32_t), 3, fp) != 3 ||
+			fwrite(imports, 1, imports_len, fp) != imports_len ||
+			fwrite(bc, 1, bclen, fp) != bclen) {
+		fclose(fp);
+		remove(path);
+		return;
+	}
+	fclose(fp);
+}
+#endif
