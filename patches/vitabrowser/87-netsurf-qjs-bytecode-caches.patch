+/* Add url (copied) to next[] unless the registry or next has it. */
+static unsigned int qjs_module_add_next(struct module_registry *reg,
+	const char *url, char **next, unsigned int n, unsigned int max)
+{
+	unsigned int m;
+	if (n >= max || qjs_module_find(reg, url) != NULL)
+		return n;
+	for (m = 0; m < n; m++)
+		if (strcmp(next[m], url) == 0)
+			return n;
+	next[n] = strdup(url);
+	return next[n] != NULL ? n + 1 : n;
+}
