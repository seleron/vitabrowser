+/* VitaBrowser: bytecode for the scripts every realm evaluates. A realm
+ * is built for each page (fixes532), and building one parses the same
+ * setup scripts -- the bridge's ~40 and vita_polyfill.js -- every time:
+ * 14 ms on a desktop, most of a second on the Vita (hardware run 16:
+ * bundled test pages took 1.3 s each). The first evaluation of a text
+ * compiles it and keeps the bytecode (JS_WriteObject, runtime-independent),
+ * later ones read that back, which skips the parser. Short texts -- event
+ * dispatch snippets built per call -- are evaluated as before. */
+#define QJS_BC_CACHE_SLOTS 96
+#define QJS_BC_CACHE_MIN 256
+static struct {
+	uint32_t hash;
+	size_t len;
+	uint8_t *bc;
+	size_t bc_len;
+} qjs_bc_cache[QJS_BC_CACHE_SLOTS];
+static unsigned int qjs_bc_cache_n;
+
+static uint32_t qjs_bc_hash(const char *s, size_t n)
+{
+	uint32_t h = 2166136261u;	/* FNV-1a */
+	size_t i;
+	for (i = 0; i < n; i++) {
+		h ^= (unsigned char)s[i];
+		h *= 16777619u;
+	}
+	return h;
+}
+
+static JSValue qjs_eval_cached(JSContext *ctx, const char *src, size_t len,
+		const char *name)
+{
+	uint32_t h;
+	unsigned int i;
+	JSValue fn;
+	uint8_t *bc;
+	size_t bc_len = 0;
+
+	if (len < QJS_BC_CACHE_MIN)
+		return JS_Eval(ctx, src, len, name, JS_EVAL_TYPE_GLOBAL);
+	h = qjs_bc_hash(src, len);
+	for (i = 0; i < qjs_bc_cache_n; i++) {
+		if (qjs_bc_cache[i].hash == h && qjs_bc_cache[i].len == len) {
+			fn = JS_ReadObject(ctx, qjs_bc_cache[i].bc,
+					qjs_bc_cache[i].bc_len,
+					JS_READ_OBJ_BYTECODE);
+			if (JS_IsException(fn)) {
+				JS_FreeValue(ctx, JS_GetException(ctx));
+				return JS_Eval(ctx, src, len, name,
+						JS_EVAL_TYPE_GLOBAL);
+			}
+			return JS_EvalFunction(ctx, fn);
+		}
+	}
+	fn = JS_Eval(ctx, src, len, name,
+			JS_EVAL_TYPE_GLOBAL | JS_EVAL_FLAG_COMPILE_ONLY);
+	if (JS_IsException(fn))
+		return fn;
+	if (qjs_bc_cache_n < QJS_BC_CACHE_SLOTS) {
+		bc = JS_WriteObject(ctx, &bc_len, fn, JS_WRITE_OBJ_BYTECODE);
+		if (bc != NULL) {
+			uint8_t *keep = (uint8_t *)malloc(bc_len);
+			if (keep != NULL) {
+				memcpy(keep, bc, bc_len);
+				qjs_bc_cache[qjs_bc_cache_n].hash = h;
+				qjs_bc_cache[qjs_bc_cache_n].len = len;
+				qjs_bc_cache[qjs_bc_cache_n].bc = keep;
+				qjs_bc_cache[qjs_bc_cache_n].bc_len = bc_len;
+				qjs_bc_cache_n++;
+			}
+			js_free(ctx, bc);
+		}
+	}
+	return JS_EvalFunction(ctx, fn);
+}
