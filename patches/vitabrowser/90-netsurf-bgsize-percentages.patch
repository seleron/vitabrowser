# netsurf: background-size percentage axes resolve against the box
# Companion to 89-libcss-bgsize-percentages.patch (Hermes, 2026-09-25;
# revised by Claude the same morning).
# libcss stores a percentage axis as code c = -(1000 + P), P = 0..31000
# (BG_SIZE_IS_PCT / BG_SIZE_PCT). All three background-size readers in
# redraw.c resolve it:
#   - html_redraw_bg_tile_size (block + table-cell images): percent of the
#     positioning area. The area is already device px, so a percent is NOT
#     multiplied by scale again (Hermes's first version was, which made
#     percent tiles wrong at any zoom other than 1x). Percent on one axis
#     with auto on the other keeps the image's aspect.
#   - html_redraw_paint_gradient_tiled: tiles at the percent of the box;
#     auto on the other axis = the whole box (a gradient has no intrinsic
#     size). Before, any negative code painted one rect. Adds the
#     bgsz_tiling label the percent branch jumps to.
#   - inline backgrounds (fixes828 path): same as the block helper.
# Existing px/auto/cover/contain paths are unchanged.
diff --git a/content/handlers/html/redraw.c b/content/handlers/html/redraw.c
index 2c61bb5..2c9b604 100644
--- a/content/handlers/html/redraw.c
+++ b/content/handlers/html/redraw.c
@@ -325,6 +325,10 @@ static void macsurf_gradient_unpack(int32_t packed_signed,
  */
 #define MACOS9_GRAD_TILE_MAX 4096
 
+/* VitaBrowser (patch 89): background-size percentage axis codes. */
+#define BG_SIZE_IS_PCT(c) ((c) <= -1000)
+#define BG_SIZE_PCT(c) ((int)(-(c)) - 1000)
+
 static nserror html_redraw_paint_gradient_tiled(
 		const struct redraw_context *ctx,
 		const plot_style_t *pstyle,
@@ -381,6 +385,21 @@ static nserror html_redraw_paint_gradient_tiled(
 	wc = (int16_t)((bgsz >> 16) & 0xFFFF);
 	hc = (int16_t)(bgsz & 0xFFFF);
 
+	/* VitaBrowser (patch 90): a percentage axis tiles at that percent of
+	 * the box; a gradient has no intrinsic size, so auto on the other axis
+	 * means the whole box. */
+	if (BG_SIZE_IS_PCT(wc) || BG_SIZE_IS_PCT(hc)) {
+		int bw = r->x1 - r->x0;
+		int bh = r->y1 - r->y0;
+		tile_w = BG_SIZE_IS_PCT(wc) ? (bw * BG_SIZE_PCT(wc)) / 100 :
+				(wc > 0 ? (int)wc : bw);
+		tile_h = BG_SIZE_IS_PCT(hc) ? (bh * BG_SIZE_PCT(hc)) / 100 :
+				(hc > 0 ? (int)hc : bh);
+		if (tile_w < 1) tile_w = 1;
+		if (tile_h < 1) tile_h = 1;
+		goto bgsz_tiling;
+	}
+
 	/* cover / contain don't tile (they scale to fit). */
 	if (wc < 0 || hc < 0) {
 		#ifdef __MACOS9__
@@ -406,6 +425,7 @@ static nserror html_redraw_paint_gradient_tiled(
 		return ctx->plot->rectangle(ctx, &draw_style, r);
 	}
 
+bgsz_tiling:
 	box_w = r->x1 - r->x0;
 	box_h = r->y1 - r->y0;
 	if (box_w <= 0 || box_h <= 0) {
@@ -1477,6 +1497,32 @@ static void html_redraw_bg_tile_size(const css_computed_style *style,
 	wc = (int16_t)((bgsz >> 16) & 0xFFFF);
 	hc = (int16_t)(bgsz & 0xFFFF);
 
+	/* VitaBrowser (patches 89/90): a percentage axis is stored by libcss
+	 * as code c = -(1000 + P), P = 0..31000 (BG_SIZE_PCT below). It
+	 * resolves against the positioning area, which is already in device
+	 * px -- so, unlike an explicit length, it is NOT multiplied by scale.
+	 * A percent on one axis with auto on the other keeps the image's
+	 * aspect. The cover/contain/explicit/auto logic below is unchanged. */
+	if (BG_SIZE_IS_PCT(wc) || BG_SIZE_IS_PCT(hc)) {
+		int pw = -1;
+		int ph = -1;
+		if (BG_SIZE_IS_PCT(wc))
+			pw = (area_w * BG_SIZE_PCT(wc)) / 100;
+		else if (wc > 0)
+			pw = (int)((float)wc * scale);
+		if (BG_SIZE_IS_PCT(hc))
+			ph = (area_h * BG_SIZE_PCT(hc)) / 100;
+		else if (hc > 0)
+			ph = (int)((float)hc * scale);
+		if (pw < 0)
+			pw = (ph * nat_w) / nat_h;
+		if (ph < 0)
+			ph = (pw * nat_h) / nat_w;
+		*tile_w = pw < 1 ? 1 : pw;
+		*tile_h = ph < 1 ? 1 : ph;
+		return;
+	}
+
 	if (wc == -1 || hc == -1) {
 		/* cover: scale to the MAX ratio so the image covers the area */
 		if (nat_w * area_h > nat_h * area_w) {
@@ -2913,6 +2959,33 @@ static bool html_redraw_inline_background(int x, int y, struct box *box,
 							tile_h = (nat_h *
 								box_w) / nat_w;
 						}
+					} else if (BG_SIZE_IS_PCT(wc) ||
+							BG_SIZE_IS_PCT(hc)) {
+						/* patch 90: percent of the box
+						 * (device px, no scale); auto
+						 * keeps the image's aspect. */
+						tile_w = -1;
+						tile_h = -1;
+						if (BG_SIZE_IS_PCT(wc))
+							tile_w = (box_w *
+								BG_SIZE_PCT(wc)) / 100;
+						else if (wc > 0)
+							tile_w = (int)(
+							(float)wc * scale);
+						if (BG_SIZE_IS_PCT(hc))
+							tile_h = (box_h *
+								BG_SIZE_PCT(hc)) / 100;
+						else if (hc > 0)
+							tile_h = (int)(
+							(float)hc * scale);
+						if (tile_w < 0)
+							tile_w = (tile_h * nat_w) /
+								nat_h;
+						if (tile_h < 0)
+							tile_h = (tile_w * nat_h) /
+								nat_w;
+						if (tile_w < 1) tile_w = 1;
+						if (tile_h < 1) tile_h = 1;
 					} else {
 						/* per-axis explicit or auto */
 						if (wc > 0) {
