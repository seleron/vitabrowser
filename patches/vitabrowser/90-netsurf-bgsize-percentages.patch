# netsurf: background-size percentage axes resolve against the box
# Generated 2026-09-25 (Hermes, while Claude was rate-limited)
#
# Companion to 89-libcss-bgsize-percentages.patch.
# html_redraw_bg_tile_size() is the single consumer for background-size
# (both the drawImage tile loop and the plot path call it). A percentage
# axis (code -1100..-1000, P = -code - 1000) is resolved against the
# drawn area into an explicit px length before the existing
# cover/contain/explicit/auto logic runs, so that logic is untouched.
# Sub-pixel results clamp to 1px; >32767px clamps to 32767.
#
# Verified: full clean build green (173 applied, libcss ok, netsurf ok,
# nsmonkey 13.9MB) + 131/131 test-vita-renderer.sh checks pass.
--- /tmp/bgsize-pre2/redraw.c	2026-09-25 00:53:44.372896855 +0100
+++ netsurf/content/handlers/html/redraw.c	2026-09-25 02:48:29.954127308 +0100
@@ -1477,6 +1477,22 @@
 	wc = (int16_t)((bgsz >> 16) & 0xFFFF);
 	hc = (int16_t)(bgsz & 0xFFFF);
 
+	/* VitaBrowser V2: a percentage axis (code c in -1100..-1000, i.e.
+	 * percentage P = -c - 1000) resolves against the drawn area, becoming an
+	 * explicit px length -- the cover/contain/explicit/auto logic below is
+	 * unchanged. The code range avoids the px (1..32767), auto (0), cover
+	 * (-1) and contain (-2) values; the test c < -300 keeps that simple. */
+	if (wc < -300) {
+		int pct = (int)(-wc) - 1000;
+		int p = (area_w * pct) / 100;
+		wc = (int16_t)(p < 1 ? 1 : (p > 32767 ? 32767 : p));
+	}
+	if (hc < -300) {
+		int pct = (int)(-hc) - 1000;
+		int p = (area_h * pct) / 100;
+		hc = (int16_t)(p < 1 ? 1 : (p > 32767 ? 32767 : p));
+	}
+
 	if (wc == -1 || hc == -1) {
 		/* cover: scale to the MAX ratio so the image covers the area */
 		if (nat_w * area_h > nat_h * area_w) {
