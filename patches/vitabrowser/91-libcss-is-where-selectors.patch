+/**
+ * VitaBrowser: does one complex selector match \a node as its subject?
+ * match_selector_chain() without the cascade and without the reject cache
+ * (which is keyed to the rule being matched, not to an argument of it).
+ */
+static css_error match_chain_at(css_select_ctx *ctx,
+		const css_selector *selector, css_select_state *state,
+		void *node, bool *match)
+{
+	const css_selector *s = selector;
+	void *n = node;
+	bool rejected_by_cache;
+	css_error error;
+
+	*match = false;
+
+	/* The rule hash checks a top-level subject's element name; nothing
+	 * has checked this one's. */
+	if (selector->data.qname.name != ctx->str.universal) {
+		error = state->handler->node_has_name(state->pw, node,
+				&selector->data.qname, match);
+		if (error != CSS_OK || *match == false)
+			return error;
+	}
+
+	error = match_details(ctx, node, &s->data, state, match, NULL);
+	if (error != CSS_OK || *match == false)
+		return error;
+
+	while (s->data.comb != CSS_COMBINATOR_NONE) {
+		void *next_node = NULL;
+
+		if (s->combinator->data.qname.name != ctx->str.universal)
+			error = match_named_combinator(ctx, s->data.comb,
+					s->combinator, state, n, &next_node);
+		else
+			error = match_universal_combinator(ctx, s->data.comb,
+					s->combinator, state, n, false,
+					&rejected_by_cache, &next_node);
+		if (error != CSS_OK)
+			return error;
+
+		if (next_node == NULL) {
+			*match = false;
+			return CSS_OK;
+		}
+
+		s = s->combinator;
+		n = next_node;
+	}
+
+	*match = true;
+	return CSS_OK;
+}
+
+/**
+ * VitaBrowser: :is() / :where() -- \a node matches when any argument does.
+ */
+css_error match_selector_list(css_select_ctx *ctx, void *node,
+		const css_selector_sellist *list, css_select_state *state,
+		bool *match)
+{
+	uint32_t i;
+	css_error error;
+
+	*match = false;
+
+	for (i = 0; i < list->count; i++) {
+		error = match_chain_at(ctx, list->sel[i], state, node, match);
+		if (error != CSS_OK || *match)
+			return error;
+	}
+
+	return CSS_OK;
+}
