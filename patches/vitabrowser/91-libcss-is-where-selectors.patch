+/**
+ * VitaBrowser: parse the argument of :is() / :where(), up to and including
+ * its closing ')'. The argument is a forgiving selector list: an
+ * alternative that does not parse (:host, a pseudo-element, anything this
+ * libcss lacks) is dropped instead of invalidating the rule.
+ *
+ * \param c       Parsing context
+ * \param vector  Vector of tokens to process
+ * \param ctx     Pointer to vector iteration context, just past the '('
+ * \param is_is   true for :is() (specificity = max of the arguments),
+ *                false for :where() (specificity 0)
+ * \param result  Pointer to location to receive the list
+ * \return CSS_OK on success, CSS_INVALID if the ')' is missing,
+ *         CSS_NOMEM on memory exhaustion
+ */
+css_error parseSelectorArgList(css_language *c,
+		const parserutils_vector *vector, int32_t *ctx, bool is_is,
+		css_selector_sellist **result)
+{
+	parserutils_vector *alt = NULL;
+	css_selector_sellist *list;
+	uint32_t cap = 4;
+	int depth = 1;
+	css_error error = CSS_OK;
+
+	list = malloc(sizeof(*list) + (cap - 1) * sizeof(css_selector *));
+	if (list == NULL)
+		return CSS_NOMEM;
+	list->count = 0;
+	list->specificity = 0;
+
+	if (parserutils_vector_create(sizeof(css_token), 16, &alt) !=
+			PARSERUTILS_OK) {
+		free(list);
+		return CSS_NOMEM;
+	}
+
+	while (depth > 0) {
+		const css_token *token = parserutils_vector_iterate(vector, ctx);
+		bool end = false;
+
+		if (token == NULL) {
+			error = CSS_INVALID;
+			break;
+		}
+
+		if (token->type == CSS_TOKEN_FUNCTION || tokenIsChar(token, '('))
+			depth++;
+		else if (tokenIsChar(token, ')'))
+			end = (--depth == 0);
+		else if (depth == 1 && tokenIsChar(token, ','))
+			end = true;
+
+		if (end == false) {
+			if (parserutils_vector_append(alt, (void *) token) !=
+					PARSERUTILS_OK) {
+				error = CSS_NOMEM;
+				break;
+			}
+			continue;
+		}
+
+		/* One alternative is complete: parse it on its own. */
+		{
+			css_selector *sel = NULL;
+			const css_selector_detail *d;
+			int32_t actx = 0;
+			bool ok;
+
+			consumeWhitespace(alt, &actx);
+			ok = parserutils_vector_peek(alt, actx) != NULL &&
+				parseSelector(c, alt, &actx, &sel) == CSS_OK &&
+				parserutils_vector_peek(alt, actx) == NULL;
+
+			/* Pseudo-elements are not valid in :is() */
+			for (d = ok ? &sel->data : NULL; d != NULL;
+					d = d->next ? d + 1 : NULL) {
+				if (d->type == CSS_SELECTOR_PSEUDO_ELEMENT)
+					ok = false;
+			}
+
+			if (ok && list->count == cap) {
+				css_selector_sellist *grown = realloc(list,
+						sizeof(*list) + (cap * 2 - 1) *
+						sizeof(css_selector *));
+				if (grown == NULL) {
+					css__stylesheet_selector_destroy(
+							c->sheet, sel);
+					error = CSS_NOMEM;
+					break;
+				}
+				list = grown;
+				cap *= 2;
+			}
+
+			if (ok) {
+				list->sel[list->count++] = sel;
+				if (is_is && sel->specificity >
+						list->specificity)
+					list->specificity = sel->specificity;
+			} else if (sel != NULL) {
+				css__stylesheet_selector_destroy(c->sheet, sel);
+			}
+
+			parserutils_vector_clear(alt);
+		}
+	}
+
+	parserutils_vector_destroy(alt);
+
+	if (error != CSS_OK) {
+		css__stylesheet_sellist_destroy(c->sheet, list);
+		return error;
+	}
+
+	*result = list;
+	return CSS_OK;
+}
