# netsurf: CSS rewrite -- inset on big sheets; integer calc() results
#
# Found on claude.ai's login buttons (the fill is an absolute span with
# 'inset-0' and '-z-[1]'):
#
# - The inset expander (and the 2-value logical-shorthand expander) grew
#   their buffer only when writing an expansion. Plain copies did
#   'if (out_pos + 1 >= cap) goto grow_fail', and grow_fail drops the whole
#   pass. Once the expansions used up the fixed 256-byte headroom, copying
#   the tail of the sheet hit it: claude.ai's 1.4 MB sheet kept every
#   'inset:' unexpanded, so libcss saw none of them. macsurf__rw_room()
#   grows instead. Small sheets never hit this, which is why test pages
#   with 'inset: 0' worked.
# - The calc() folder printed every result as "%.4f". "-1.0000" is not an
#   <integer>, so 'z-index: calc(1 * -1)' (Tailwind's -z-[N]) was dropped.
#   Whole-number results now print as integers.
diff --git a/content/handlers/css/css_rewrite.c b/content/handlers/css/css_rewrite.c
index 8ac580a..98e65b2 100644
--- a/content/handlers/css/css_rewrite.c
+++ b/content/handlers/css/css_rewrite.c
@@ -2645,8 +2645,18 @@ macsurf__rewrite_calc_aspect_impl(const char *data, size_t in_size)
 			result = result / c;
 		}
 
-		rlen = (size_t)sprintf(rep, result_is_pct ? "%.4f%%" : "%.4f",
-				result);
+		/* VitaBrowser: a whole-number result prints as an integer.
+		 * "-1.0000" is not an <integer>, so `z-index: calc(1 * -1)`
+		 * (Tailwind's -z-[1]) was dropped and read as auto. */
+		if (result == (double)(long)result &&
+				result > -1e9 && result < 1e9)
+			rlen = (size_t)sprintf(rep,
+					result_is_pct ? "%ld%%" : "%ld",
+					(long)result);
+		else
+			rlen = (size_t)sprintf(rep,
+					result_is_pct ? "%.4f%%" : "%.4f",
+					result);
 		/* Replace calc(...) [length = close_pos - i + 1] with rep,
 		 * pad remainder with spaces. */
 		{
@@ -3725,6 +3735,28 @@ macsurf__rewrite_modern_compat(const char *data, size_t in_size,
 }
 
 
+/* VitaBrowser: make room for `need` more bytes at out_pos, growing the
+ * buffer. The inset and logical-shorthand passes used to give up instead
+ * (goto grow_fail -> the whole pass returns NULL) once their expansions
+ * had used up the fixed headroom: claude.ai's 1.4 MB sheet lost every
+ * `inset:` that way. */
+static bool
+macsurf__rw_room(char **out, size_t *cap, size_t out_pos, size_t need)
+{
+	char *grown;
+	size_t newcap;
+
+	if (out_pos + need < *cap)
+		return true;
+	newcap = *cap * 2 + need + 256;
+	grown = (char *)realloc(*out, newcap);
+	if (grown == NULL)
+		return false;
+	*out = grown;
+	*cap = newcap;
+	return true;
+}
