# netsurf (vita): up to 32 network pages, and say when any are dropped
#
# load_net_pages() stopped reading nettest.txt at 16 pages without a word.
# Adding two local test pages (CSS-is-where, CSS-rewrite-bigsheet) pushed
# the simulator's list past 16, so JS-module and JS-module-http silently
# stopped running and their check read "module did not run". 32 pages cost
# about 10 KB of static memory; lines past the limit are now logged.
diff --git a/frontends/vita/main.c b/frontends/vita/main.c
index 1e4fea3..d94eb66 100644
--- a/frontends/vita/main.c
+++ b/frontends/vita/main.c
@@ -134,7 +134,7 @@ static const char *const vita_local_pages[] = {
  * reach them too. The defaults, or ux0:data/VitaBrowser/nettest.txt with
  * one "name url" per line (the simulator points them at a local server).
  */
-#define VITA_NET_PAGES_MAX 16
+#define VITA_NET_PAGES_MAX 32
 static const char *const vita_net_defaults[][2] = {
 	{ "NET-http-example", "http://example.com/" },
 	{ "NET-https-example", "https://example.com/" },
@@ -159,11 +159,18 @@ static void load_net_pages(void)
 
 	vita_net_count = 0;
 	if (fp != NULL) {
-		while (vita_net_count < VITA_NET_PAGES_MAX &&
-		       fgets(line, sizeof(line), fp) != NULL) {
+		unsigned int dropped = 0;
+
+		while (fgets(line, sizeof(line), fp) != NULL) {
 			if (line[0] == '#' ||
 			    sscanf(line, "%47s %255s", name, url) != 2)
 				continue;
+			/* Say so rather than silently testing fewer pages
+			 * (the sim's list outgrew 16 once). */
+			if (vita_net_count == VITA_NET_PAGES_MAX) {
+				dropped++;
+				continue;
+			}
 			snprintf(vita_net_names[vita_net_count], sizeof(name),
 				 "%s", name);
 			snprintf(vita_net_urls[vita_net_count], sizeof(url),
@@ -171,6 +178,9 @@ static void load_net_pages(void)
 			vita_net_count++;
 		}
 		fclose(fp);
+		if (dropped > 0)
+			vita_diag_log("nettest.txt: %u pages ignored (max %u)",
+				      dropped, (unsigned int)VITA_NET_PAGES_MAX);
 	} else {
 		for (i = 0; i < sizeof(vita_net_defaults) /
 			     sizeof(vita_net_defaults[0]); i++) {
