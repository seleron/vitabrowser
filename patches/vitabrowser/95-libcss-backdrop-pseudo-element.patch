index 5751c37..655a3c1 100644
--- a/src/parse/propstrings.h
+++ b/src/parse/propstrings.h
@@ -164,7 +164,7 @@ enum {
 	SLICE, CLONE,
 	SMOOTH, HIGH_QUALITY, CRISP_EDGES, PIXELATED,
 	WAVY, FROM_FONT,
-	MARKER, PLACEHOLDER, FILE_SELECTOR_BUTTON,
+	MARKER, PLACEHOLDER, FILE_SELECTOR_BUTTON, BACKDROP,
 	IS_FN, WHERE_FN, HAS_FN,
 	START, END,
 	MANUAL, INTER_WORD, INTER_CHARACTER, LAST, FORCE_END, ALLOW_END,
