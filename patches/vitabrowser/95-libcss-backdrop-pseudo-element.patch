# libcss: ::backdrop is a known pseudo-element (never matches)
#
# An unknown pseudo-element makes the whole selector list invalid, so
# Tailwind v4's "*,:before,:after,::backdrop{--tw-shadow:0 0 #0000;...}"
# (the initial values of every --tw-* variable, for browsers without
# @property) was dropped, and every box-shadow / ring / transform built
# from those variables failed to resolve. Like ::placeholder (fixes359),
# ::backdrop now parses; select.c's pseudo-element match falls through to
# no-match for it.
diff --git a/src/parse/language.c b/src/parse/language.c
index 599affa..28b9db2 100644
--- a/src/parse/language.c
+++ b/src/parse/language.c
@@ -1404,7 +1404,11 @@ css_error parsePseudo(css_language *c, const parserutils_vector *vector,
 		{ AFTER, CSS_SELECTOR_PSEUDO_ELEMENT },
 		{ MARKER, CSS_SELECTOR_PSEUDO_ELEMENT },              /* fixes358 (#70) */
 		{ PLACEHOLDER, CSS_SELECTOR_PSEUDO_ELEMENT },         /* fixes359 (#71) */
-		{ FILE_SELECTOR_BUTTON, CSS_SELECTOR_PSEUDO_ELEMENT } /* fixes359 (#71) */
+		{ FILE_SELECTOR_BUTTON, CSS_SELECTOR_PSEUDO_ELEMENT }, /* fixes359 (#71) */
+		/* VitaBrowser: known, never matches (select.c falls through to
+		 * no-match). Unknown, it invalidated Tailwind v4's
+		 * "*,:before,:after,::backdrop{--tw-*:...}" list whole. */
+		{ BACKDROP, CSS_SELECTOR_PSEUDO_ELEMENT }
 	};
 	css_selector_detail_value detail_value;
 	css_selector_detail_value_type value_type =
diff --git a/src/parse/propstrings.c b/src/parse/propstrings.c
index 3caa52c..7809a18 100644
--- a/src/parse/propstrings.c
+++ b/src/parse/propstrings.c
@@ -570,6 +570,7 @@ const stringmap_entry stringmap[LAST_KNOWN] = {
 	SMAP("marker"),
 	SMAP("placeholder"),
 	SMAP("file-selector-button"),
+	SMAP("backdrop"),	/* VitaBrowser: never matches */
 	SMAP("is"),
 	SMAP("where"),
 	SMAP("has"),
