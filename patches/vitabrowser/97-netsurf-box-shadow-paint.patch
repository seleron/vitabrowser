+/**
+ * VitaBrowser (patch 97): paint a box's shadows from the full box-shadow
+ * list (css_computed_box_shadow_full). Called twice per box: outer shadows
+ * (inset == false) before the background, outside the border box; inset
+ * shadows after it, inside the padding box. The list's first shadow is on
+ * top, so it is painted last.
+ *
+ * Approximations: blur widens the shadow by half the blur radius and fades
+ * it by 2 / (2 + blur); border-radius is ignored. A 1px ring
+ * ("inset 0 0 0 1px c", Tailwind's ring and shadow-field) is exact.
+ */
+static bool html_redraw_box_shadows(const struct redraw_context *ctx,
+		const css_computed_style *style, float scale, bool inset,
+		const struct rect *border_box, const struct rect *padding_box)
+{
+	const int32_t *full;
+	plot_style_fixed element_op = (plot_style_fixed)PLOT_STYLE_SCALE;
+	css_fixed op_fixed = 0;
+	int i;
+
+	if (style == NULL)
+		return true;
+	full = css_computed_box_shadow_full(style);
+	if (full == NULL)
+		return true;
+	if (css_computed_opacity(style, &op_fixed) == CSS_OPACITY_SET)
+		element_op = (plot_style_fixed)op_fixed;
+
+	for (i = full[0] - 1; i >= 0; i--) {
+		const int32_t *s = full + 1 + CSS_BOX_SHADOW_FIELDS * i;
+		bool is_inset = (s[4] & CSS_BOX_SHADOW_FLAG_INSET) != 0;
+		uint32_t argb = (uint32_t)s[5];
+		unsigned int alpha;
+		int blur = s[2] > 0 ? s[2] : 0;
+		int hx, vy, grow;
+		struct rect o, h;
+		plot_style_t ps;
+
+		if (is_inset != inset)
+			continue;
+		if (s[4] & CSS_BOX_SHADOW_FLAG_CURRENT) {
+			css_color cc = 0;
+			css_computed_color(style, &cc);
+			argb = (uint32_t)cc;
+		}
+		alpha = ((argb >> 24) & 0xff) * 2 / (2 + (unsigned int)blur);
+		if (alpha == 0)
+			continue;
+
+		hx = (int)((float)s[0] * scale);
+		vy = (int)((float)s[1] * scale);
+		grow = (int)((float)(s[3] + blur / 2) * scale);
+
+		memset(&ps, 0, sizeof(ps));
+		ps.fill_type = PLOT_OP_TYPE_SOLID;
+		/* NetSurf colour: R in the low byte. */
+		ps.fill_colour = (colour)(((argb >> 16) & 0xff) |
+				(argb & 0xff00) | ((argb & 0xff) << 16));
+		ps.opacity = (plot_style_fixed)((int64_t)element_op * alpha / 255);
+
+		if (!inset) {
+			o = *border_box;
+			o.x0 += hx - grow;
+			o.x1 += hx + grow;
+			o.y0 += vy - grow;
+			o.y1 += vy + grow;
+			h = *border_box;
+		} else {
+			o = *padding_box;
+			h = *padding_box;
+			h.x0 += hx + grow;
+			h.x1 += hx - grow;
+			h.y0 += vy + grow;
+			h.y1 += vy - grow;
+		}
+		if (!html_redraw_rect_minus(ctx, &ps, o, h))
+			return false;
+	}
+	return true;
+}
