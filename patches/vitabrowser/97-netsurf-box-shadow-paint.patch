+/* VitaBrowser (patch 97): paint the part of `o` outside `h` (device px) as
+ * up to four rectangles. */
+static bool html_redraw_rect_minus(const struct redraw_context *ctx,
+		const plot_style_t *ps, struct rect o, struct rect h)
+{
+	struct rect b;
+
+	if (o.x0 >= o.x1 || o.y0 >= o.y1)
+		return true;
+	if (h.x0 < o.x0) h.x0 = o.x0;
+	if (h.y0 < o.y0) h.y0 = o.y0;
+	if (h.x1 > o.x1) h.x1 = o.x1;
+	if (h.y1 > o.y1) h.y1 = o.y1;
+	if (h.x0 >= h.x1 || h.y0 >= h.y1)
+		return ctx->plot->rectangle(ctx, ps, &o) == NSERROR_OK;
+
+	b = o;
+	b.y1 = h.y0;
+	if (b.y0 < b.y1 && ctx->plot->rectangle(ctx, ps, &b) != NSERROR_OK)
+		return false;
+	b = o;
+	b.y0 = h.y1;
+	if (b.y0 < b.y1 && ctx->plot->rectangle(ctx, ps, &b) != NSERROR_OK)
+		return false;
+	b.y0 = h.y0;
+	b.y1 = h.y1;
+	b.x0 = o.x0;
+	b.x1 = h.x0;
+	if (b.x0 < b.x1 && ctx->plot->rectangle(ctx, ps, &b) != NSERROR_OK)
+		return false;
+	b.x0 = h.x1;
+	b.x1 = o.x1;
+	if (b.x0 < b.x1 && ctx->plot->rectangle(ctx, ps, &b) != NSERROR_OK)
+		return false;
+	return true;
+}
