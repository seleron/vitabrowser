+
+static float vb_linear_of(float c)
+{
+	int i = (int)(c * 255.0f + 0.5f);
+	if (i < 0) i = 0;
+	if (i > 255) i = 255;
+	return vb_srgb_to_linear[i];
+}
+
+/** Linear light -> sRGB 8-bit channel: the nearest table entry. */
+static int vb_srgb_of_linear(float l)
+{
+	int lo = 0, hi = 255;
+	if (l <= 0.0f) return 0;
+	if (l >= 1.0f) return 255;
+	while (hi - lo > 1) {
+		int mid = (lo + hi) / 2;
+		if (vb_srgb_to_linear[mid] <= l) lo = mid; else hi = mid;
+	}
+	return (l - vb_srgb_to_linear[lo] < vb_srgb_to_linear[hi] - l) ?
+			lo : hi;
+}
+
+static float vb_cbrt(float x)
+{
+	float y;
+	int i;
+	bool neg = x < 0.0f;
+	if (neg) x = -x;
+	if (x == 0.0f) return 0.0f;
+	y = x > 1.0f ? x / 3.0f + 0.5f : 0.5f + x / 2.0f;
+	for (i = 0; i < 12; i++)
+		y = y - (y * y * y - x) / (3.0f * y * y);
+	return neg ? -y : y;
+}
+
+/** Colour spaces color-mix() interpolates in. */
+enum vb_space { VB_SRGB, VB_LINEAR, VB_OKLAB };
+
+static void vb_to_space(uint32_t argb, enum vb_space sp, float out[3])
+{
+	float r = ((argb >> 16) & 0xff) / 255.0f;
+	float g = ((argb >> 8) & 0xff) / 255.0f;
+	float b = (argb & 0xff) / 255.0f;
+
+	if (sp == VB_SRGB) {
+		out[0] = r; out[1] = g; out[2] = b;
+		return;
+	}
+	r = vb_linear_of(r); g = vb_linear_of(g); b = vb_linear_of(b);
+	if (sp == VB_LINEAR) {
+		out[0] = r; out[1] = g; out[2] = b;
+		return;
+	}
+	{
+		float l = vb_cbrt(0.4122214708f * r + 0.5363325363f * g +
+				0.0514459929f * b);
+		float m = vb_cbrt(0.2119034982f * r + 0.6806995451f * g +
+				0.1073969566f * b);
+		float s = vb_cbrt(0.0883024619f * r + 0.2817188376f * g +
+				0.6299787005f * b);
+		out[0] = 0.2104542553f * l + 0.7936177850f * m -
+				0.0040720468f * s;
+		out[1] = 1.9779984951f * l - 2.4285922050f * m +
+				0.4505937099f * s;
+		out[2] = 0.0259040371f * l + 0.7827717662f * m -
+				0.8086757660f * s;
+	}
+}
+
+static uint32_t vb_from_space(const float in[3], enum vb_space sp,
+		float alpha)
+{
+	int r, g, b, a;
+
+	if (sp == VB_SRGB) {
+		float c[3];
+		int k;
+		for (k = 0; k < 3; k++)
+			c[k] = in[k] < 0.0f ? 0.0f : (in[k] > 1.0f ? 1.0f : in[k]);
+		r = (int)(c[0] * 255.0f + 0.5f);
+		g = (int)(c[1] * 255.0f + 0.5f);
+		b = (int)(c[2] * 255.0f + 0.5f);
+	} else {
+		float lr = in[0], lg = in[1], lb = in[2];
+		if (sp == VB_OKLAB) {
+			float l = in[0] + 0.3963377774f * in[1] +
+					0.2158037573f * in[2];
+			float m = in[0] - 0.1055613458f * in[1] -
+					0.0638541728f * in[2];
+			float s = in[0] - 0.0894841775f * in[1] -
+					1.2914855480f * in[2];
+			l = l * l * l; m = m * m * m; s = s * s * s;
+			lr = 4.0767416621f * l - 3.3077115913f * m +
+					0.2309699292f * s;
+			lg = -1.2684380046f * l + 2.6097574011f * m -
+					0.3413193965f * s;
+			lb = -0.0041960863f * l - 0.7034186147f * m +
+					1.7076147010f * s;
+		}
+		r = vb_srgb_of_linear(lr);
+		g = vb_srgb_of_linear(lg);
+		b = vb_srgb_of_linear(lb);
+	}
+	a = (int)(alpha * 255.0f + 0.5f);
+	if (a < 0) a = 0;
+	if (a > 255) a = 255;
+	return ((uint32_t)a << 24) | ((uint32_t)r << 16) |
+			((uint32_t)g << 8) | (uint32_t)b;
+}
+
+static bool vb_name_is(lwc_string *s, const char *lit)
+{
+	size_t n = lwc_string_length(s), i;
+	const char *d = lwc_string_data(s);
+	for (i = 0; i < n; i++) {
+		char x = d[i];
+		if (lit[i] == '\0') return false;
+		if (x >= 'A' && x <= 'Z') x = (char)(x - 'A' + 'a');
+		if (x != lit[i]) return false;
+	}
+	return lit[n] == '\0';
+}
+
+/** Read a number or percentage token as a float (percent / 100 when
+ * \a pct_scale is 1). \return false for other tokens. */
+static bool vb_read_number(const css_token *t, float pct_scale, float *out,
+		bool *was_pct)
+{
+	size_t consumed = 0;
+	css_fixed v;
+
+	if (t == NULL || (t->type != CSS_TOKEN_NUMBER &&
+			t->type != CSS_TOKEN_PERCENTAGE))
+		return false;
+	v = css__number_from_lwc_string(t->idata, false, &consumed);
+	if (consumed != lwc_string_length(t->idata))
+		return false;
+	*out = FIXTOFLT(v);
+	if (t->type == CSS_TOKEN_PERCENTAGE)
+		*out = *out / 100.0f * pct_scale;
+	if (was_pct != NULL)
+		*was_pct = (t->type == CSS_TOKEN_PERCENTAGE);
+	return true;
+}
+
+/** A nested colour for color-mix() / "from": a real colour value
+ * (currentColor cannot be resolved while parsing). */
+static bool vb_nested_colour(css_language *c, const parserutils_vector *vector,
+		int32_t *ctx, uint32_t *argb)
+{
+	uint16_t value = 0;
+	if (css__parse_colour_specifier(c, vector, ctx, &value, argb) !=
+			CSS_OK)
+		return false;
+	if (value == COLOR_CURRENT_COLOR)
+		return false;
+	if (value == COLOR_TRANSPARENT)
+		*argb = 0;
+	return true;
+}
+
+/** Is the next token (after whitespace) the ident "from"? */
+static bool vb_is_relative(const parserutils_vector *vector, int32_t ctx)
+{
+	const css_token *t;
+	consumeWhitespace(vector, &ctx);
+	t = parserutils_vector_peek(vector, ctx);
+	return t != NULL && t->type == CSS_TOKEN_IDENT &&
+			vb_name_is(t->idata, "from");
+}
+
+/**
+ * rgb(from C r g b [/ A]) and hsl(from C h s l [/ A]), after the
+ * FUNCTION token. Channels: the channel's own keyword keeps it; rgb()
+ * also takes numbers / percentages. Anything else (calc() on channels)
+ * is unsupported and invalid. Alpha: a number, a percentage, "alpha"
+ * (keep) or none (0).
+ */
+static bool vb_parse_relative(css_language *c, const parserutils_vector *vector,
+		int32_t *ctx, bool hsl, uint32_t *result)
+{
+	static const char *const names_rgb[3] = { "r", "g", "b" };
+	static const char *const names_hsl[3] = { "h", "s", "l" };
+	const char *const *names = hsl ? names_hsl : names_rgb;
+	const css_token *t;
+	uint32_t base;
+	int ch[3];
+	float alpha;
+	int k;
+
+	consumeWhitespace(vector, ctx);
+	parserutils_vector_iterate(vector, ctx);	/* "from" */
+	consumeWhitespace(vector, ctx);
+	if (!vb_nested_colour(c, vector, ctx, &base))
+		return false;
+	ch[0] = (base >> 16) & 0xff;
+	ch[1] = (base >> 8) & 0xff;
+	ch[2] = base & 0xff;
+	alpha = ((base >> 24) & 0xff) / 255.0f;
+
+	for (k = 0; k < 3; k++) {
+		float v;
+		consumeWhitespace(vector, ctx);
+		t = parserutils_vector_iterate(vector, ctx);
+		if (t == NULL)
+			return false;
+		if (t->type == CSS_TOKEN_IDENT && vb_name_is(t->idata, names[k]))
+			continue;
+		if (!hsl && vb_read_number(t, 255.0f, &v, NULL)) {
+			if (v < 0.0f) v = 0.0f;
+			if (v > 255.0f) v = 255.0f;
+			ch[k] = (int)(v + 0.5f);
+			continue;
+		}
+		return false;
+	}
+
+	consumeWhitespace(vector, ctx);
+	t = parserutils_vector_iterate(vector, ctx);
+	if (t != NULL && tokenIsChar(t, '/')) {
+		float v;
+		consumeWhitespace(vector, ctx);
+		t = parserutils_vector_iterate(vector, ctx);
+		if (t != NULL && t->type == CSS_TOKEN_IDENT &&
+				vb_name_is(t->idata, "alpha")) {
+			/* keep */
+		} else if (t != NULL && t->type == CSS_TOKEN_IDENT &&
+				vb_name_is(t->idata, "none")) {
+			alpha = 0.0f;
+		} else if (vb_read_number(t, 1.0f, &v, NULL)) {
+			alpha = v < 0.0f ? 0.0f : (v > 1.0f ? 1.0f : v);
+		} else {
+			return false;
+		}
+		consumeWhitespace(vector, ctx);
+		t = parserutils_vector_iterate(vector, ctx);
+	}
+	if (t == NULL || !tokenIsChar(t, ')'))
+		return false;
+
+	*result = ((uint32_t)(int)(alpha * 255.0f + 0.5f) << 24) |
+			((uint32_t)ch[0] << 16) | ((uint32_t)ch[1] << 8) |
+			(uint32_t)ch[2];
+	return true;
+}
+
+/**
+ * color-mix(in SPACE [HUE-METHOD hue], C1 [P1], C2 [P2]), after the
+ * FUNCTION token. Premultiplied interpolation per CSS Color 5. Spaces:
+ * srgb (and hsl/hwb, approximated as srgb), srgb-linear / xyz*, and
+ * oklab (also lab, lch and oklch, approximated as oklab: lch-style hue
+ * arcs are not followed).
+ */
+static bool vb_parse_color_mix(css_language *c, const parserutils_vector *vector,
+		int32_t *ctx, uint32_t *result)
+{
+	const css_token *t;
+	enum vb_space sp;
+	uint32_t col[2];
+	float pct[2];
+	bool have_pct[2] = { false, false };
+	float v1[3], v2[3], out[3], a1, a2, p1, p2, sum, alpha, mult = 1.0f;
+	int k;
+
+	consumeWhitespace(vector, ctx);
+	t = parserutils_vector_iterate(vector, ctx);
+	if (t == NULL || t->type != CSS_TOKEN_IDENT || !vb_name_is(t->idata, "in"))
+		return false;
+	consumeWhitespace(vector, ctx);
+	t = parserutils_vector_iterate(vector, ctx);
+	if (t == NULL || t->type != CSS_TOKEN_IDENT)
+		return false;
+	if (vb_name_is(t->idata, "srgb") || vb_name_is(t->idata, "hsl") ||
+			vb_name_is(t->idata, "hwb"))
+		sp = VB_SRGB;
+	else if (vb_name_is(t->idata, "srgb-linear") ||
+			vb_name_is(t->idata, "xyz") ||
+			vb_name_is(t->idata, "xyz-d65") ||
+			vb_name_is(t->idata, "xyz-d50"))
+		sp = VB_LINEAR;
+	else if (vb_name_is(t->idata, "oklab") || vb_name_is(t->idata, "lab") ||
+			vb_name_is(t->idata, "oklch") ||
+			vb_name_is(t->idata, "lch"))
+		sp = VB_OKLAB;
+	else
+		return false;
+
+	/* optional "<shorter|longer|increasing|decreasing> hue" */
+	consumeWhitespace(vector, ctx);
+	t = parserutils_vector_peek(vector, *ctx);
+	if (t != NULL && t->type == CSS_TOKEN_IDENT) {
+		parserutils_vector_iterate(vector, ctx);
+		consumeWhitespace(vector, ctx);
+		t = parserutils_vector_iterate(vector, ctx);
+		if (t == NULL || t->type != CSS_TOKEN_IDENT ||
+				!vb_name_is(t->idata, "hue"))
+			return false;
+		consumeWhitespace(vector, ctx);
+	}
+	t = parserutils_vector_iterate(vector, ctx);
+	if (t == NULL || !tokenIsChar(t, ','))
+		return false;
+
+	for (k = 0; k < 2; k++) {
+		consumeWhitespace(vector, ctx);
+		t = parserutils_vector_peek(vector, *ctx);
+		if (t != NULL && t->type == CSS_TOKEN_PERCENTAGE) {
+			if (!vb_read_number(t, 1.0f, &pct[k], NULL))
+				return false;
+			have_pct[k] = true;
+			parserutils_vector_iterate(vector, ctx);
+			consumeWhitespace(vector, ctx);
+		}
+		if (!vb_nested_colour(c, vector, ctx, &col[k]))
+			return false;
+		consumeWhitespace(vector, ctx);
+		t = parserutils_vector_peek(vector, *ctx);
+		if (!have_pct[k] && t != NULL &&
+				t->type == CSS_TOKEN_PERCENTAGE) {
+			if (!vb_read_number(t, 1.0f, &pct[k], NULL))
+				return false;
+			have_pct[k] = true;
+			parserutils_vector_iterate(vector, ctx);
+			consumeWhitespace(vector, ctx);
+		}
+		t = parserutils_vector_iterate(vector, ctx);
+		if (t == NULL || !tokenIsChar(t, k == 0 ? ',' : ')'))
+			return false;
+	}
+
+	/* Percentages (CSS Color 5, 12.1). */
+	if (!have_pct[0] && !have_pct[1]) {
+		p1 = p2 = 0.5f;
+	} else if (!have_pct[1]) {
+		p1 = pct[0];
+		p2 = 1.0f - p1;
+	} else if (!have_pct[0]) {
+		p2 = pct[1];
+		p1 = 1.0f - p2;
+	} else {
+		p1 = pct[0];
+		p2 = pct[1];
+	}
+	if (p1 < 0.0f || p2 < 0.0f)
+		return false;
+	sum = p1 + p2;
+	if (sum <= 0.0f)
+		return false;
+	if (sum < 1.0f)
+		mult = sum;
