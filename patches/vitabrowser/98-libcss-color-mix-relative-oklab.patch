# libcss: color-mix(), relative rgb()/hsl() "from" colours, oklab()
#
# Tailwind v4 writes most translucent colours with these (claude.ai's
# sheet: 734 color-mix(), 104 "from" colours, oklab(0% none none/.1));
# libcss rejected them, dropping the declaration (claude.ai's button
# ring colour is hsl(from var(--cds-neutral-900) h s l / 10%)).
#
# - rgb(from C r g b [/ A]), hsl(from C h s l [/ A]): channel keywords
#   keep the base colour's channel; rgb() also takes numbers and
#   percentages. calc() on channels is unsupported (invalid, as before).
# - color-mix(in SPACE [METHOD hue], C1 [P1], C2 [P2]): CSS Color 5
#   percentages and premultiplied interpolation, in srgb, srgb-linear/xyz
#   or oklab (lab, lch and oklch approximated as oklab).
# - oklab(L a b [/ A]) with none.
# No libm: an sRGB->linear table (inverted by binary search) and Newton
# cube roots. currentColor inside these is unresolvable at parse time and
# stays invalid.
diff --git a/src/parse/properties/utils.c b/src/parse/properties/utils.c
index 5bb0451..a2af507 100644
--- a/src/parse/properties/utils.c
+++ b/src/parse/properties/utils.c
@@ -928,6 +928,467 @@ static bool parse_hwb(
 	return true;
 }
 
+/* ------------------------------------------------------------------ *
+ * VitaBrowser (patch 98): color-mix(), relative rgb()/hsl() "from"
+ * colours, and oklab(). Tailwind v4 writes most of its translucent
+ * colours with them (claude.ai: 734 color-mix, 104 "from" colours).
+ * No libm: sRGB <-> linear goes through a table, cube roots through
+ * Newton steps.
+ * ------------------------------------------------------------------ */
+
