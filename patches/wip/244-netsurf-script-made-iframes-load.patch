+/** VitaBrowser patch 244: at most this many windows for script-made
+ * frames per page (each is a page and a realm: the Vita's memory). */
+#define SCRIPT_FRAMES_MAX 8
+
+/** Is node shown by one of bw's iframe windows already? */
+static bool browser_window_has_iframe_node(struct browser_window *bw,
+					   struct dom_node *node)
+{
+	int i;
+
+	for (i = 0; i < bw->iframe_count; i++)
+		if (bw->iframes[i]->iframe_node == node)
+			return true;
+	return false;
+}
+
+/**
+ * VitaBrowser patch 244: a window for an iframe element with no box -- a
+ * display:none frame, which browsers load all the same (hCaptcha's
+ * invisible checkbox frame). It gets a browser's default iframe size.
+ */
+static nserror
+browser_window_iframe_setup_boxless(struct browser_window *bw,
+				    struct browser_window *window,
+				    struct dom_node *node, const char *key)
+{
+	browser_window_initialise_common(BW_CREATE_NONE, window, NULL);
+	window->browser_window_type = BROWSER_WINDOW_IFRAME;
+	window->scrolling = BW_SCROLLING_AUTO;
+	window->border = false;
+	window->no_resize = true;
+	window->scale = bw->scale;
+	window->box = NULL;
+	window->parent = bw;
+	window->iframe_node = dom_node_ref(node);
+#ifdef WITH_QUICKJS
+	js_link_frame_heaps(window->jsheap, bw->jsheap, key);
+#else
+	(void) key;
+#endif
+	browser_window_set_position(window, 0, 0);
+	browser_window_set_dimensions(window, 300, 150);
+	return NSERROR_OK;
+}
+
+/** Add window to bw's iframe windows; false (window freed) on failure. */
+static bool browser_window_iframe_add(struct browser_window *bw,
+				      struct browser_window *window)
+{
+	struct browser_window **grown = realloc(bw->iframes,
+			(bw->iframe_count + 1) * sizeof(*grown));
+
+	if (grown == NULL) {
+		browser_window_iframe_free(window);
+		return false;
+	}
+	bw->iframes = grown;
+	bw->iframes[bw->iframe_count++] = window;
+	return true;
+}
+
+/**
+ * VitaBrowser patch 244: does iframe record cur have no window yet, and is
+ * it one to load? The windows made when the page was ready cover every
+ * iframe the parser found; a record without one is an iframe a script
+ * inserted (the box tree was rebuilt with it). Only cross-origin ones are
+ * loaded here: a same-origin or blank script-made frame keeps patch 143's
+ * window in the page's own realm (google's sign-in evaluates into it), and
+ * loading it again in a realm of its own would run it twice.
+ */
+static bool
+browser_window_iframe_is_new(struct browser_window *bw,
+			     struct content_html_iframe *cur)
+{
+	int i;
+
+	if (cur->box == NULL || cur->box->node == NULL || cur->url == NULL)
+		return false;
+	for (i = 0; i < bw->iframe_count; i++)
+		if (bw->iframes[i]->iframe_node == cur->box->node)
+			return false;
+	return !nsurl_compare(cur->url,
+			hlcache_handle_get_url(bw->current_content),
+			NSURL_SCHEME | NSURL_HOST | NSURL_PORT);
+}
+
+/**
+ * VitaBrowser patch 244: make and load windows for iframes a script added
+ * (scheduled from browser_window_recalculate_iframes: not navigating from
+ * inside the reformat that found them).
+ */
+static void browser_window_sync_iframes(void *p)
+{
+	struct browser_window *bw = p;
+	struct content_html_iframe *cur;
+	static unsigned int seq;
+	unsigned int made = 0;
+	int i;
+
+	if (bw->current_content == NULL ||
+	    content_get_type(bw->current_content) != CONTENT_HTML)
+		return;
+	for (i = 0; i < bw->iframe_count; i++)
+		if (bw->iframes[i]->script_made)
+			made++;
+	/* iframe records (frames with a box) */
+	for (cur = html_get_iframe(bw->current_content); cur != NULL;
+	     cur = cur->next) {
+		struct browser_window *window;
+		char key[32];
+
+		if (!browser_window_iframe_is_new(bw, cur))
+			continue;
+		if (made >= SCRIPT_FRAMES_MAX)
+			break;
+		window = calloc(1, sizeof(*window));
+		if (window == NULL)
+			return;
+		snprintf(key, sizeof(key), "vbframe-%u", ++seq);
+		if (browser_window_iframe_setup(bw, window, cur,
+				cur->name != NULL && *cur->name != '\0' ?
+				cur->name : key) != NSERROR_OK) {
+			browser_window_iframe_free(window);
+			return;
+		}
+		window->script_made = true;
+		if (!browser_window_iframe_add(bw, window))
+			return;
+		made++;
+		NSLOG(netsurf, INFO, "script-made iframe %s as %s",
+		      nsurl_access(cur->url), key);
+		browser_window_navigate(window, cur->url,
+				hlcache_handle_get_url(bw->current_content),
+				BW_NAVIGATE_UNVERIFIABLE, NULL, NULL,
+				bw->current_content);
+	}
+	/* iframe elements with no record: display:none frames */
+	{
+		dom_document *doc = html_get_document(bw->current_content);
+		nsurl *base = html_get_base_url(bw->current_content);
+		dom_string *tag = NULL, *srcname = NULL, *namename = NULL;
+		dom_nodelist *list = NULL;
+		uint32_t n = 0, k;
+
+		if (doc == NULL || base == NULL ||
+		    dom_string_create((const uint8_t *)"iframe", 6, &tag) !=
+				DOM_NO_ERR ||
+		    dom_string_create((const uint8_t *)"src", 3, &srcname) !=
+				DOM_NO_ERR ||
+		    dom_string_create((const uint8_t *)"name", 4, &namename) !=
+				DOM_NO_ERR ||
+		    dom_document_get_elements_by_tag_name(doc, tag, &list) !=
+				DOM_NO_ERR || list == NULL ||
+		    dom_nodelist_get_length(list, &n) != DOM_NO_ERR)
+			n = 0;
+		for (k = 0; k < n && made < SCRIPT_FRAMES_MAX; k++) {
+			dom_node *node = NULL;
+			dom_string *src = NULL, *name = NULL;
+			nsurl *url = NULL;
+			struct browser_window *window;
+			char key[32];
+
+			if (dom_nodelist_item(list, k, &node) != DOM_NO_ERR ||
+			    node == NULL)
+				continue;
+			if (browser_window_has_iframe_node(bw, node))
+				goto next;
+			for (cur = html_get_iframe(bw->current_content);
+			     cur != NULL; cur = cur->next)
+				if (cur->box != NULL && cur->box->node == node)
+					break;
+			if (cur != NULL)
+				goto next;	/* has a record: handled above */
+			if (dom_element_get_attribute((dom_element *)node,
+					srcname, &src) != DOM_NO_ERR ||
+			    src == NULL || dom_string_length(src) == 0 ||
+			    nsurl_join(base, dom_string_data(src), &url) !=
+					NSERROR_OK)
+				goto next;
+			if (nsurl_compare(url,
+					hlcache_handle_get_url(bw->current_content),
+					NSURL_SCHEME | NSURL_HOST | NSURL_PORT))
+				goto next;	/* same origin: patch 143's */
+			{
+				lwc_string *scheme = nsurl_get_component(url,
+						NSURL_SCHEME);
+				bool http = scheme != NULL &&
+					(lwc_string_length(scheme) == 4 ||
+					 lwc_string_length(scheme) == 5) &&
+					strncmp(lwc_string_data(scheme), "http",
+						4) == 0;
+				if (scheme != NULL)
+					lwc_string_unref(scheme);
+				if (!http)
+					goto next;
+			}
+			window = calloc(1, sizeof(*window));
+			if (window == NULL)
+				goto next;
+			snprintf(key, sizeof(key), "vbframe-%u", ++seq);
+			dom_element_get_attribute((dom_element *)node,
+					namename, &name);
+			if (name != NULL && dom_string_length(name) > 0) {
+				window->name = strdup(dom_string_data(name));
+			}
+			browser_window_iframe_setup_boxless(bw, window, node,
+				window->name != NULL ? window->name : key);
+			window->script_made = true;
+			if (browser_window_iframe_add(bw, window)) {
+				made++;
+				NSLOG(netsurf, INFO, "script-made iframe "
+				      "(no box) %s as %s", nsurl_access(url),
+				      key);
+				browser_window_navigate(window, url,
+					hlcache_handle_get_url(bw->current_content),
+					BW_NAVIGATE_UNVERIFIABLE, NULL, NULL,
+					bw->current_content);
+			}
+		next:
+			if (url != NULL)
+				nsurl_unref(url);
+			if (src != NULL)
+				dom_string_unref(src);
+			if (name != NULL)
+				dom_string_unref(name);
+			dom_node_unref(node);
+		}
+		if (list != NULL)
+			dom_nodelist_unref(list);
+		if (tag != NULL)
+			dom_string_unref(tag);
+		if (srcname != NULL)
+			dom_string_unref(srcname);
+		if (namename != NULL)
+			dom_string_unref(namename);
+	}
+	browser_window_update_extent(bw);
+}
