+/* exported interface documented in html/html.h (patch 244) */
+void html_iframe_loaded(struct hlcache_handle *parent, struct dom_node *node)
+{
+	struct content *c = hlcache_handle_get_content(parent);
+	html_content *htmlc;
+
+	if (c == NULL || node == NULL ||
+	    content_get_type(parent) != CONTENT_HTML)
+		return;
+	htmlc = (html_content *) c;
+#ifdef WITH_QUICKJS
+	if (htmlc->js_thread != NULL && !htmlc->aborted)
+		js_fire_script_load(htmlc->js_thread, node, 1);
+#else
+	(void) htmlc;
+#endif
+}
+
+/* VitaBrowser patch 244: box construction recorded an iframe after the
+ * page was ready -- one a script inserted. The window re-links its iframe
+ * windows, and makes and loads one for a new cross-origin frame, on
+ * CONTENT_MSG_REFORMAT (browser_window_recalculate_iframes); a local
+ * rebuild broadcasts none, so ask for the notification. */
+void html_iframe_added_late(html_content *htmlc)
+{
+	htmlc->iframe_sync_wanted = true;
+	guit->misc->schedule(0, html_relayout_notify, htmlc);
+}
+
+/* exported interface documented in html/html.h (patch 244) */
+bool html_iframe_sync_wanted(struct hlcache_handle *h)
+{
+	struct content *c = hlcache_handle_get_content(h);
+	html_content *htmlc;
+	bool wanted;
+
+	if (c == NULL || content_get_type(h) != CONTENT_HTML)
+		return false;
+	htmlc = (html_content *) c;
+	wanted = htmlc->iframe_sync_wanted;
+	htmlc->iframe_sync_wanted = false;
+	return wanted;
+}
