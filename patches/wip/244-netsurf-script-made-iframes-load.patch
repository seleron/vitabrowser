+/**
+ * Set up one iframe window for iframe record cur of bw's content
+ * (VitaBrowser patch 244: shared by the windows made when the page is ready
+ * and those made for iframes a script adds later). key names the frame's
+ * realm for the cross-realm bridge: the iframe's name, else a page-unique
+ * key.
+ */
+static nserror
+browser_window_iframe_setup(struct browser_window *bw,
+			    struct browser_window *window,
+			    struct content_html_iframe *cur,
+			    const char *key)
+{
+	struct rect rect;
+
+	/* Initialise common parts */
+	browser_window_initialise_common(BW_CREATE_NONE, window, NULL);
+
+	/* window characteristics */
+	window->browser_window_type = BROWSER_WINDOW_IFRAME;
+	window->scrolling = cur->scrolling;
+	window->border = cur->border;
+	window->border_colour = cur->border_colour;
+	window->no_resize = true;
+	window->margin_width = cur->margin_width;
+	window->margin_height = cur->margin_height;
+	window->scale = bw->scale;
+	if (cur->name != NULL) {
+		window->name = strdup(cur->name);
+		if (window->name == NULL)
+			return NSERROR_NOMEM;
+	}
+
+	/* linking: the box, and the element it is for (patch 244) */
+	window->box = cur->box;
+	window->parent = bw;
+	window->box->iframe = window;
+	window->iframe_node = NULL;
+	if (cur->box->node != NULL)
+		window->iframe_node = dom_node_ref(cur->box->node);
+
+	/* Cross-realm frame bridge: link this iframe realm to its
+	 * parent's realm (window.parent / postMessage).  Degrades
+	 * gracefully if the parent has no JS heap. */
+#ifdef WITH_QUICKJS
+	js_link_frame_heaps(window->jsheap, bw->jsheap, key);
+#else
+	(void) key;
+#endif
+
+	/* iframe dimensions */
+	box_bounds(window->box, &rect);
+
+	browser_window_set_position(window, rect.x0, rect.y0);
+	browser_window_set_dimensions(window, rect.x1 - rect.x0,
+			rect.y1 - rect.y0);
+	return NSERROR_OK;
+}
+
+/** One iframe window, freed (patch 244: each is allocated on its own). */
+static void browser_window_iframe_free(struct browser_window *window)
+{
+	if (window->box != NULL) {
+		window->box->iframe = NULL;
+		window->box = NULL;
+	}
+	browser_window_destroy_internal(window);
+	if (window->iframe_node != NULL) {
+		dom_node_unref(window->iframe_node);
+		window->iframe_node = NULL;
+	}
+	free(window);
+}
