+/* VitaBrowser patch 244: __vitaIframeKey(iframeElement) -- the frame key
+ * the iframe's own window was linked to this realm with (its name, or the
+ * "vbframe-N" a script-made frame gets), so contentWindow.postMessage
+ * reaches that realm whatever the frame's position among the others; null
+ * while the frame has no window yet. */
+static JSValue
+qjs_xrealm_iframe_key(JSContext *ctx, JSValueConst this_val,
+		int argc, JSValueConst *argv)
+{
+	struct content *c;
+	struct browser_window *bw;
+	dom_node *n;
+	int i;
+	(void)this_val;
+	if (argc < 1 || !JS_IsObject(argv[0]))
+		return JS_NULL;
+	n = qjs_get_node(argv[0]);
+	c = qjs_get_content_for_ctx(ctx);
+	if (n == NULL || c == NULL || (c->handler == NULL || c->handler->type() != CONTENT_HTML))
+		return JS_NULL;
+	/* by the element each iframe window shows: a display:none frame
+	 * has no box to go through (hCaptcha's checkbox frame) */
+	bw = ((struct html_content *)c)->bw;
+	for (i = 0; bw != NULL && i < bw->iframe_count; i++) {
+		struct browser_window *w = bw->iframes[i];
+		if (w->iframe_node == n && w->jsheap != NULL &&
+		    w->jsheap->frame_key != NULL &&
+		    *w->jsheap->frame_key != '\0')
+			return JS_NewString(ctx, w->jsheap->frame_key);
+	}
+	return JS_NULL;
+}
