+	    content->base.status != CONTENT_STATUS_DONE) {
 		/* Don't create iframe discriptors for invisible iframes
 		 * TODO: handle hidden iframes at browser_window generation
-		 * time instead? */
+		 * time instead?
+		 * VitaBrowser patch 244: once the page is ready an iframe is
+		 * one a script made, and browsers load hidden frames --
+		 * hCaptcha's challenge frames are visibility:hidden. (Parsed
+		 * hidden frames stay skipped, as before: memory.) */
 		return true;
 	}
 
